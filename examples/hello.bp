// hello.bp — the smallest runnable botopink program.
//
// The CLI is project-based, so drop this file into a throwaway project:
//
//   botopink new demo            # scaffolds botopink.json + src/main.bp
//   cp examples/hello.bp demo/src/main.bp
//   cd demo && botopink run      # → hello, botopink
fn main() {
    @print("hello, botopink");
}

//// Calling the result of a call — `adder(3)(4)`. Front 15's R2 made a chain
//// link chain from every receiver, so this parses, and 01 types it: the callee
//// travels in `calleeExpr`, inference types that expression and applies it. What
//// is left is the backends' — none of them reads `calleeExpr` yet.
////
//// Written as the language means it, not as the compiler takes it: the second
//// test is the work-around the rest of the suite uses (`test/closure_capture.bp`
//// binds `f` for exactly this reason) and is here so that a fix has both shapes
//// to pass.

fn adder(n: i32) -> fn(x: i32) -> i32 { return { x -> x + n }; }

fn pick(which: bool) -> fn(x: i32) -> i32 { return { x -> if (which) { x } else { 0 - x } }; }

test "calling the result of a call" { assert adder(3)(4) == 7; }

test "calling the result of a call, with the binding the suite works around it with" {
    val f = adder(3);
    assert f(4) == 7;
}

test "calling the result of a call whose result is chosen at run time" { assert pick(false)(5) == 0 - 5; }

//// `language-gaps.md` row 28 — a lambda literal is a `case` arm's value:
//// `A(x) -> { item -> f(item) }` is the lambda, not a block, and the value the
//// `case` answers is applied after it. A `test/` cell: beam answers
//// `{badfun, ok}` for a lambda that a `case` arm produces (`03-beam`'s row).

type Mode {
    Mark(suffix: string),
    Same,
}

fn mark(x: string, suffix: string) -> string {
    return x + suffix;
}

fn pick(m: Mode) -> fn(item: string) -> string {
    val g = case m {
        Mark(suffix) {
            { item -> mark(item, suffix) };
        }
        Same {
            { item -> item };
        }
    };
    return g;
}

test "a lambda literal is the value of a case arm" {
    assert pick(Mode.Mark(suffix: "?"))("a") == "a?";
    assert pick(Mode.Same)("b") == "b";
}

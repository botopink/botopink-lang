//// Front 19 of 1.0.10-beta (C-27), decisions 87 and 88 — the `use` activation.
//// A hook is `fn <noun>(…) -> @Context<Owner, R>` (no `use` prefix in its name);
//// `val x = use <noun>(…)` binds `R` inside a `#[@context]` body whose return
//// type is the owner (a component, `-> Element`) or implements
//// `@Context<Owner, _>` (a custom hook). The owner type is declared here: the
//// suite depends on no library. `use f(x)` lowers to `f(x)` on every backend,
//// so the value a test observes is the hook body's own — the first-render value.

type Element(count: i32, name: string) implement @Context<Element, Element>
type State(value: i32, name: string) implement @Context<Element, State>

// `state` yields its initial value.
fn state(initial: i32) -> @Context<Element, State> {
    return State(value: initial, name: "state");
}

// A hook whose `R` is a tuple.
fn pair(a: i32, b: i32) -> @Context<Element, #(i32, i32)> {
    return #(a, b);
}

// A void-ish hook activated as a bare statement.
fn effect(cb: fn() -> i32) -> @Context<Element, i32> {
    return cb();
}

// A custom hook by the rule: a noun, no `use` prefix, composing another hook.
// Its return implements `@Context<Element, _>`, so every `use` in it agrees on
// `Element`, and `#[@context]` is what lets its body activate `state`.
#[@context]
fn counter(start: i32) -> @Context<Element, State> {
    val s = use state(start * 2);
    return s;
}

#[@context]
fn Widget(n: i32) -> Element {
    val c = use state(n);
    return Element(count: c.value + 1, name: c.name);
}

#[@context]
fn Fields() -> Element {
    val {value, name} = use state(5);
    return Element(count: value, name: name);
}

#[@context]
fn Composed() -> Element {
    val k = use counter(10);
    return Element(count: k.value, name: k.name);
}

#[@context]
fn Positional() -> Element {
    val #(x, y) = use pair(3, 4);
    return Element(count: x + y, name: "pair");
}

#[@context]
fn Effectful() -> Element {
    use effect({ -> return 9; });
    val c = use state(1);
    return Element(count: c.value, name: "effect");
}

// Without `use` the call is an ordinary call — no `#[@context]` needed.
fn Plain() -> Element {
    val c = state(7);
    return Element(count: c.value, name: "plain");
}

test "val c = use state(n) binds R, the hook's yield" {
    val e = Widget(41);
    assert e.count == 42;
    assert e.name == "state";
}

test "val {a, b} = use … destructures R by field name" {
    val e = Fields();
    assert e.count == 5;
    assert e.name == "state";
}

test "a custom hook composes hooks under the same owner" {
    assert Composed().count == 20;
    assert Composed().name == "state";
}

test "val #(a, b) = use … destructures a tuple R positionally" {
    assert Positional().count == 7;
}

test "a bare use statement activates a void hook" {
    assert Effectful().count == 1;
}

test "the un-activated call is an ordinary call" {
    assert Plain().count == 7;
}

//// Front 19 of 1.0.10-beta, decisions 89 and 90 — a wrapper effect activates on
//// its own. `contextInfoFromReturn` looks through `@Future<T>` to `T`'s owner, so
//// `#[@future] fn Page() -> @Future<Element>` owns `Element` and may write `use`
//// without `#[@context]` — which R5 forbids spelling next to `#[@future]` anyway.
//// `use f(x)` lowers to `f(x)`, so the value the body reads is the hook's own
//// first-render value. A `test` body is not a `#[@future]` body, so the resolved
//// element is not observable from here (see `test/effect_future.bp`); what this
//// cell pins is that the pair typechecks, produces a value on both backends, and
//// that the `#[@context]` form of the same hook still activates.

type Element(count: i32) implement @Context<Element, Element>
type Request(code: i32) implement @Context<Element, Request>

// A hook anchored at `Element`: the owner a `use` in either body agrees on.
fn request() -> @Context<Element, Request> {
    return Request(code: 7);
}

// Decision 90 — the wrapper effect is the only annotation on this fn.
#[@future]
fn Page() -> @Future<Element> {
    val r = use request();
    return Element(count: r.code + 1);
}

// The activation composes with the effect's own body operations.
#[@future]
fn rendered() -> @Future<i32> {
    val e = await Page();
    return e.count;
}

// Decision 88 is untouched where there is no wrapper effect.
#[@context]
fn Widget() -> Element {
    val r = use request();
    return Element(count: r.code);
}

test "a #[@future] body activates a hook without #[@context]" {
    val f = Page();
    assert f != null;
}

test "the activated future chains through await" {
    val f = rendered();
    assert f != null;
}

test "#[@context] on a plain owner return still activates" {
    assert Widget().count == 7;
}

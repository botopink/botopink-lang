//// Decision 8 §10 — `loop (xs) { x -> … }` over an array: the empty
//// collection, outer vars reassigned inside, nested loops, and a loop as an
//// expression collecting `break` values.

test "§10 loop over an array visits every element in order" {
    var out = "";
    loop (["a", "b", "c"]) { s -> out = out + s; };
    assert out == "abc";
}

test "§10 loop over an empty array runs no iteration" {
    val empty: i32[] = [];
    var n = 0;
    loop (empty) { x -> n = n + 1; };
    assert n == 0;
}

test "§10 an outer var reassigned inside survives the loop" {
    var total = 0;
    var last = 0;
    loop ([4, 5, 6]) { x ->
        total = total + x;
        last = x;
    };
    assert total == 15;
    assert last == 6;
}

test "§10 nested loops" {
    var pairs = 0;
    loop ([1, 2, 3]) { a ->
        loop ([1, 2]) { b ->
            pairs = pairs + a * b;
        };
    };
    assert pairs == 18;
}

test "§10 a loop as an expression collects its break values" {
    val doubled = loop ([1, 2, 3]) { x -> break x * 2; };
    assert doubled.length == 3;
    assert doubled.join(",") == "2,4,6";
}

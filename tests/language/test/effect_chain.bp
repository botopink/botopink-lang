//// Decision 95 of 1.0.10-beta — the two rows of the chain that need a target
//// able to consume a future or an iterator, so they run here (commonJS and
//// erlang) rather than in `run/effect_chain.bp`, which every backend runs.
////
////   `#[@future]`    ⊃ `@Result`   — `try` and `await` in one body
////   `#[@iterator]`  ⊃ `@Result`   — `try` and `yield` in one body
////
//// What each pins is that the body type-checks with BOTH capabilities in it and
//// that the value it produces is the one the chain implies — a `try` that
//// reaches its Ok branch inside an effect body that was refused the capability
//// before this front.

#[@result]
fn parse(n: i32) -> @Result<i32, string> {
    if (n < 0) { throw "negative"; };
    return n;
}

#[@future]
fn fetch(n: i32) -> @Future<i32> {
    return n * 2;
}

// `#[@future]` ⊃ `@Result`: `try` and `await` in one body.
#[@future]
fn load(n: i32) -> @Future<i32> {
    val v = try parse(n);
    val w = await fetch(v);
    return w + 1;
}

// `#[@iterator]` ⊃ `@Result`: `try` and `yield` in one body.
#[@iterator]
fn upTo(n: i32) -> @Iterator<i32> {
    val limit = try parse(n);
    var i = 0;
    loop (i < limit) { yield i; i = i + 1; };
}

test "§95 a #[@future] body holds the `try` its level grants" {
    val f = load(3);
    assert f != null;
}

test "§95 a #[@iterator] body holds the `try` its level grants" {
    var acc = "";
    loop (upTo(3)) { x -> acc = acc + x.toString(); };
    assert acc == "012";
}

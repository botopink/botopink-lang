//// Decisions 120 and 121 of 1.0.10-beta — the two rows of the chain that need
//// a target able to consume a Task or an iterator, so they run here (commonJS
//// and erlang) rather than in `run/effect_chain.bp`, which every backend runs.
////
////   `-> @Task<@Result<…>>`       — `try` (its value is a `@Result`) and `await`
////   `-> @Iterator<@Result<…>>`   — `try` (its item is a `@Result`) and `yield`
////
//// What each pins is that the body type-checks with BOTH capabilities in it and
//// that the value it produces is the one the chain implies.

fn parse(n: i32) -> @Result<i32, string> {
    if (n < 0) { throw "negative"; };
    return n;
}

fn fetch(n: i32) -> @Task<i32> {
    return n * 2;
}

// `@Task<@Result<…>>`: `try` and `await` in one body.
fn load(n: i32) -> @Task<@Result<i32, string>> {
    val v = try parse(n);
    val w = await fetch(v);
    return w + 1;
}

// `@Iterator<@Result<…>>`: `try` and `yield` in one body.
fn upTo(n: i32) -> @Iterator<@Result<i32, string>> {
    val limit = try parse(n);
    var i = 0;
    while (i < limit) { yield i; i = i + 1; };
}

test "decision 121 a Task body holds the `try` its @Result value grants" {
    val f = load(3);
    assert f != null;
}

test "decision 121 an iterator body holds the `try` its @Result item grants" {
    var acc = "";
    for (upTo(3)) { r -> acc = acc + (try r catch 0).toString(); };
    assert acc == "012";
}

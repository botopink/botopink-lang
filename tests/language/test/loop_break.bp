//// Decision 8 §10 — `loop { … break; }` runs until a break; a break leaves only
//// the innermost loop.

test "§10 an unconditioned loop stops at break" {
    var n = 0;
    loop {
        n = n + 1;
        if (n == 5) { break; };
    };
    assert n == 5;
}

test "§10 break leaves only the inner loop" {
    var outer = 0;
    var inner = 0;
    loop (outer < 3) {
        outer = outer + 1;
        loop {
            inner = inner + 1;
            break;
        };
    };
    assert outer == 3;
    assert inner == 3;
}

test "§10 break inside a condition loop" {
    var i = 0;
    loop (i < 100) {
        if (i == 7) { break; };
        i = i + 1;
    };
    assert i == 7;
}

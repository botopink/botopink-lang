//// Decision 8 §10 — `loop (a..b) { i -> … }` and the indexed form
//// `loop (xs, start..) { x, i -> … }`.

test "§10 loop over a range" {
    var sum = 0;
    loop (0..4) { i -> sum = sum + i; };
    assert sum == 6;
}

test "§10 an empty range runs no iteration" {
    var n = 0;
    loop (3..3) { i -> n = n + 1; };
    assert n == 0;
}

test "§10 the indexed form honours the start of the range" {
    var weighted = 0;
    loop ([10, 20, 30], 1..) { x, i -> weighted = weighted + x * i; };
    assert weighted == 140;
}

test "§10 the indexed form from 0" {
    var first = "";
    var count = 0;
    loop (["x", "y"], 0..) { s, i ->
        if (i == 0) { first = s; };
        count = count + 1;
    };
    assert first == "x";
    assert count == 2;
}

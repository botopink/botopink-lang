//// Decisions 434, 435 — a host function a decorator reaches with an
//// `@External.Erlang` cell alone runs at comptime on every target: the wasm
//// runtime runs the cell's beam-to-wasm translation (`<<($0)/binary, "!">>`,
//// the measured subset), so the four targets print the same.

#[@External.Node("""($0 + "!")""")]
#[@External.Erlang("""<<($0)/binary, "!">>""")]
declare fn bang(value: string) -> string;

fn sized(comptime decl: @Decl) {
    @emit("pub fn summary() -> string { return \"" + bang(decl.name) + "\"; }");
}

#[sized]
type Point(x: i32, y: i32)

pub fn main() {
    @print(summary());
}

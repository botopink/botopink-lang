//// Decision 207 — an inline parameter type is not exported: the module that
//// declares `link` builds it from a call's labels (`home()`), and a call from
//// another module that writes the fields is refused by name, at the call.

pub mod ui;
import {link, home} from "ui";

pub fn main() {
    @print(home());
    @print(link(href: "/a", label: "A"));
}

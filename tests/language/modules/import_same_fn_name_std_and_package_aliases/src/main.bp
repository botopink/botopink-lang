//// A package and std both declare `pub fn lt` and `pub fn reverse`. An import
//// that names its source — a std module, a package — says which declaration
//// it means, and a module that needs both imports each under an alias: four
//// names, four declarations, and each call reaches its own. Without the
//// aliases the second import is `import-name-collision`
//// (`import_same_name_twice_unaliased`).

import {collections.lt as stdLt, collections.reverse as stdReverse, collections.toInt} from "std";
import {lt as kitLt, reverse as kitReverse} from "kit";

pub fn main() {
    @print(kitLt(1, 2));
    @print(toInt(stdLt()));
    @print(kitReverse(1, 2, 3));
    @print(toInt(stdReverse(stdLt())));
}

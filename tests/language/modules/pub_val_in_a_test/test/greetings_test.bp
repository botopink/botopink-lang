//// onze finding F1 — a `pub val` imported from a sibling is read by a test.
//// Decision 140 made the read work under `botopink run`; the erlang test
//// runner loaded its siblings only for an imported fn, type or std module,
//// so the read died `{error,undef}`.

import {greeting, sizes} from "greetings";

test "a pub val imported from a sibling is read by a test" {
    assert greeting == "hi";
    assert sizes.length == 3;
}

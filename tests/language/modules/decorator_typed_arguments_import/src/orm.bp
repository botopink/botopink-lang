import {types.Type} from "std";

pub type Order { Asc, Desc }

pub fn index<T>(comptime decl: @Decl<T>, comptime ..fields: Type.Field<T>[]) {
    decl.setMeta("columns", fields.map({ f -> f.name }).join(","));
}

pub fn sorted<T>(
    comptime decl: @Decl<T>,
    comptime by: Type.Field<T>,
    comptime order: Order = .Asc,
) {
    val dir = if (order == Order.Desc) " desc" else " asc";
    decl.setMeta("sort", by.name + dir);
}

//// Front 12 step 4.2 — a local dependency. `deps/shapesdsl/` is a second
//// project inside this cell, named by the manifest's object-form dependency
//// `"shapesdsl": { "path": "deps/shapesdsl" }` (decisions 75/76, `aa80e30b`) —
//// resolved from disk, relative to this project, with no network and nothing
//// special in the runner. What one project cannot express and this pair does:
////
////   * `pub default mod` / `pub default fn` — the package-default DSL: the lib's
////     `root.bp` names the handle, `shapesdsl.bp` holds the handler, and
////     `import shapesdsl, {…} from "shapesdsl"` binds the handle so that
////     `shapesdsl "…"` expands at compile time;
////   * a `.d.bp` shipped through the lib's `files` — `shapes.d.bp` declares the
////     `Rect` record this program constructs;
////   * `@ExprCustom` / `q.custom` — the handler returns the carrier: the `code`
////     half runs (an `area(…)` call built from the template's text), the `ast`
////     half is a `CustomNode` tree for the tooling and changes nothing at run time.

import shapesdsl, {area, Rect} from "shapesdsl";

pub fn main() {
    val r = Rect(w: 2, h: 3);
    @print(area(r.w, r.h));
    val fromDsl = shapesdsl "4, 5";
    @print(fromDsl);
}

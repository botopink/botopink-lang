//// `web/check` — names each annotation of the declaration it annotates by
//// what `Decorator.same` answers: `web` for `web/markers`'s `serverOnly`,
//// `check` for itself, `other` for anything else — however the annotation
//// spells the name.

import {markers.serverOnly};

pub fn check(comptime decl: @Decl) {
    var out: string[] = [];
    decl.annotations.forEach({ a ->
        val which = if (a.decorator.same(serverOnly))
            "web"
        else if (a.decorator.same(check))
            "check"
        else
            "other";
        out.push(a.name + "=" + which);
    });
    decl.setMeta("ids", out.join(" "));
}

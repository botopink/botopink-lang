mod sql;
import {sql.query, sql.repository, sql.Query};

#[repository]
behavior Users {
    #[query "select * from users where id = ${id} limit 1"]
    fn find(self: Self, id: i32) -> string;
}

#[query "delete from s where u = ${u}"]
fn logout(u: string) -> string {
    return u;
}

pub fn main() {
    @print(@typeInfo(Users).meta.repository.statements);
    @print(@typeInfo(logout).meta(Query)!.sql);
}

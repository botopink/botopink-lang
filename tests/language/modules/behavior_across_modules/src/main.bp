//// A `behavior` reached through `import` is the same type it is in its own
//// module. Three shapes, each refused before with `expected behavior Request
//// { … }, got …`:
////
////   * an imported fn-type alias whose body names `Request` and `Out`, used
////     by a module that imports neither (this one) — the alias's names now
////     resolve as in its own module;
////   * an implementer imported beside the behavior, passed to a parameter
////     typed by it (`pages.bp`);
////   * the same implementer held in a `val` annotated with it (`pages.bp`).
//// On all four targets; wasm trapped at the method called through the
//// behavior-typed value until it read the type from the value's header.

pub mod web;
pub mod ssr;
pub mod pages;
import {ssr.PageRenderer, ssr.render};
import {web.home};
import {pages.about, pages.held};

pub fn main() {
    val renderer: PageRenderer = { req, out -> req.path() + " " + out.tag };
    @print(render(renderer, home()));
    @print(about());
    @print(held());
}

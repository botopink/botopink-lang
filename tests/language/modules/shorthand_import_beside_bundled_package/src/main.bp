//// Decision 170 — the shorthand import (`import {splitPath};`, no `from`)
//// names the sibling that exports it: it resolves among the importing
//// package's own modules and never reaches a bundled package, which is
//// reached only by naming it. The bundled `routing` (loaded here by the
//// second import) declares `pub fn splitPath` in its internal module
//// `routing/match`; the shorthand used to be `ambiguous-import-use` between
//// it and the project's own `config`. wasm is not a target: `routing`
//// reaches host functions with no wasm binding.

pub mod config;
import {splitPath};
import {splitPath as routeSplit} from "routing";

pub fn main() {
    @print(splitPath("a").at(0) ?? "");
    @print(routeSplit("/x/y").length);
}

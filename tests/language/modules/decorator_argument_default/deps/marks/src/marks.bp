//// A dependency's decorator whose trailing parameters declare a default.

pub fn mark(
    comptime decl: @Decl,
    comptime label: string,
    comptime loud: bool = false,
    comptime times: i32 = -1,
    comptime tail: string = ".",
) {
    val shown = if (loud) label.toUpper() else label;
    @emit(
        "pub fn "
            + decl.name
            + "Mark() -> string { return \""
            + shown
            + ":"
            + times.toString()
            + tail
            + "\"; }",
    );
}

//// Decision 95 of 1.0.10-beta — the effects are a chain: `@Context` ⊃ `@Future`
//// ⊃ `@Result`, `@FutureGenerator` ⊃ `@Future`, `@Iterator` ⊃ `@Result`, and an
//// annotation grants every body operation at or below its own level. The two
//// rows here are the ones every backend runs: `#[@result]`, the base, holding
//// the `try` it grants, and `#[@context]`, the top, holding `use` and the `try`
//// it reaches two levels down. `test/effect_chain.bp` carries the `#[@future]`
//// and `#[@iterator]` rows, which need a target that can consume a future or an
//// iterator (commonJS and erlang).
////
//// One row of the table is deliberately in NEITHER cell: `await` inside a
//// `#[@context]` body. It is legal — the comptime cell `chain: #[@context]
//// implements @Future implements @Result` pins that — and it RUNS on erlang,
//// wasm and beam, but commonJS lowers `#[@context]` to a plain `function` and
//// the emitted `await` is a JS SyntaxError. The legality is front 20's, the
//// `async function` keyword is the backend's, so the row is a handoff rather
//// than a capability left refused.
////
//// `#[@generator]` is absent for the other reason: question 97 leaves it
//// infallible, and `reject/try_in_generator.bp` asserts that refusal.

type Element(count: i32) implement @Context<Element, Element>

fn state(initial: i32) -> @Context<Element, i32> {
    return initial;
}

#[@result]
fn parse(n: i32) -> @Result<i32, string> {
    if (n < 0) { throw "negative"; };
    return n;
}

// `#[@result]` — the base of the chain. It answers `try`.
#[@result]
fn doubled(n: i32) -> @Result<i32, string> {
    val v = try parse(n);
    return v * 2;
}

// `#[@context]` ⊃ `@Future` ⊃ `@Result`: `use` and `try` in one body.
#[@context]
fn Widget(n: i32) -> Element {
    val c = use state(1);
    val v = try parse(n);
    return Element(count: c + v);
}

pub fn main() {
    @print(try doubled(21) catch 0);
    @print(try doubled(0 - 1) catch 7);
    @print(Widget(41).count);
}

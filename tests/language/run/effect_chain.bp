//// Decision 95 of 1.0.10-beta — the effects are a chain: `@Component` ⊃ `@Future`
//// ⊃ `@Result` (decision 128), `@FutureGenerator` ⊃ `@Future`, `@ResultGenerator` ⊃
//// `@Result`, and an annotation grants every body operation at or below its own
//// level. The two rows here are the ones every backend runs: `#[@result]`, the
//// base, holding the `try` it grants, and `#[@use]`, the top, holding `use` and
//// the `try` it reaches three levels down. `test/effect_chain.bp` carries the
//// `#[@future]` and `#[@resultGenerator]` rows, which need a target that can
//// consume a future or a generator (commonJS and erlang).
////
//// `run/effect_context_await.bp` carries `await` inside a `#[@use]` body. A
//// `#[@use]` body is an `async function` on commonJS (decision 104), so its
//// caller reads a promise there and the value elsewhere: `Widget` prints its
//// own count from inside the body, after `main`'s two lines.
////
//// `#[@generator]` is absent for the other reason: decision 103 keeps it
//// infallible, and `reject/try_in_generator.bp` asserts that refusal.

type Element(count: i32) implement @Context<Element>

#[@use]
fn state(initial: i32) -> @Component<Element, i32> {
    return initial;
}

#[@result]
fn parse(n: i32) -> @Result<i32, string> {
    if (n < 0) { throw "negative"; };
    return n;
}

// `#[@result]` — the base of the chain. It answers `try`.
#[@result]
fn doubled(n: i32) -> @Result<i32, string> {
    val v = try parse(n);
    return v * 2;
}

// `#[@use]` — `@Component` ⊃ `@Future` ⊃ `@Result`: `use` and `try` in one body.
#[@use]
fn Widget(n: i32) -> @Component<Element, Element> {
    val c = use state(1);
    val v = try parse(n);
    @print(c + v);
    return Element(count: c + v);
}

pub fn main() {
    @print(try doubled(21) catch 0);
    @print(try doubled(0 - 1) catch 7);
    Widget(41);
}

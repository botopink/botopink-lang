//// Decision 264 — an `i64` product past `2^63 − 1` aborts on every target:
//// erlang and beam answered the bignum, commonJS a rounded double. commonJS
//// computes a product past 2^53 in `BigInt` (decision 319) and aborts at the
//// same bound as the others.

fn mul(a: i64, b: i64) -> i64 {
    return a * b;
}

pub fn main() {
    @print(mul(4194304, 2147483647));
    @print(mul(4294967296, 4294967296));
    @print("unreachable");
}

//// Decision 103 of 1.0.10-beta — a generator's prefix is the level it extends.
//// `@ResultGenerator<T, E>` extends `@Result`, so its body answers `try`; and
//// a loop over it is a `try` in the body that ITERATES it (`Error(e)` has to
//// go somewhere, and the place is that body's error channel), so `digits` is
//// `#[@result]`. `@Generator<T>` is infallible: `total` is a plain `fn` and
//// iterates it with no level at all — that is what the infallible wrapper
//// buys. `reject/for_fallible_generator_plain_fn.bp` is the refusal.

#[@result]
fn parse(n: i32) -> @Result<i32, string> {
    if (n < 0) { throw "negative"; };
    return n;
}

// `#[@resultGenerator]` ⊃ `@Result`: `try` and `yield` in one body.
#[@resultGenerator]
fn upto(n: i32) -> @ResultGenerator<i32, string> {
    val limit = try parse(n);
    var i = 0;
    while (i < limit) { yield i; i = i + 1; };
}

// The iterating body needs `try`'s level: `#[@result]`.
#[@result]
fn digits(n: i32) -> @Result<string, string> {
    var acc = "";
    for (upto(n)) { x -> acc = acc + x.toString(); };
    return acc;
}

#[@generator]
fn nums(n: i32) -> @Generator<i32> {
    var i = 0;
    while (i < n) { yield i; i = i + 1; };
}

// A plain `fn` iterates an infallible generator.
fn total(n: i32) -> i32 {
    var acc = 0;
    for (nums(n)) { x -> acc = acc + x; };
    return acc;
}

pub fn main() {
    @print(try digits(4) catch "error");
    @print(total(4));
}

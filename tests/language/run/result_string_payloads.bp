//// A `@Result`'s payload keeps its type through a `case`: a string in `Ok` or
//// in `Error` prints as text, a record payload's string fields read as text, a
//// record nested in a record payload too, an array of strings joins — whether
//// the `@Result` comes from a call, a parameter, an annotated `val`, a `for`
//// element or a record field (`try` on the field included). Every value is
//// distinct, so a string printed as its heap address (what wasm answered for
//// each of these shapes, pre-existing at `82e32e36`) is a wrong line at exit 0.

type User(name: string, age: i32)
type Failure(code: i32, reason: string)
type Envelope(label: string, user: User)

fn find(id: i32) -> @Result<User, Failure> {
    if (id < 0) { throw Failure(code: 404, reason: "no user " + id.toString()); };
    return User(name: "ana", age: id);
}

fn check(n: i32) -> @Result<i32, string> {
    if (n < 0) { throw "negative " + n.toString(); };
    return n;
}

fn wrap(id: i32) -> @Result<Envelope, string> {
    if (id < 0) { throw "no envelope"; };
    return Envelope(label: "box", user: User(name: "bia", age: id));
}

fn names() -> @Result<string[], string> {
    return ["x", "y"];
}

fn describe(r: @Result<i32, string>) -> string {
    return case r {
        Ok(v) -> "ok " + v.toString();
        Error(e) -> "error " + e;
    };
}

fn each(rs: @Result<i32, string>[]) {
    for (rs) { x -> case x { Ok(v) -> @print(v.toString()); Error(e) -> @print(e); }; };
}

pub fn main() {
    case find(7) { Ok(u) -> @print(u.name + " " + u.age.toString()); Error(f) -> @print(f.reason); };
    case find(-1) { Ok(u) -> @print(u.name); Error(f) -> @print(f.code.toString() + " " + f.reason); };
    case wrap(3) { Ok(env) -> @print(env.label + " " + env.user.name); Error(e) -> @print(e); };
    case wrap(-3) { Ok(env) -> @print(env.label); Error(e) -> @print(e); };
    case names() { Ok(ns) -> @print(ns.join("+")); Error(e) -> @print(e); };
    val r: @Result<i32, string> = check(-5);
    case r { Ok(v) -> @print(v.toString()); Error(e) -> @print(e); };
    @print(describe(check(-6)));
    each([check(1), check(-7)]);
    jobs();
}

type Job(title: string, outcome: @Result<i32, string>)

fn attempt(j: Job) -> @Result<string, string> {
    val n = try j.outcome;
    return j.title + " " + n.toString();
}

fn jobs() {
    val done = Job(title: "build", outcome: check(2));
    val failed = Job(title: "test", outcome: check(-8));
    case done.outcome { Ok(v) -> @print(done.title + " " + v.toString()); Error(e) -> @print(e); };
    case failed.outcome { Ok(v) -> @print(v.toString()); Error(e) -> @print(failed.title + ": " + e); };
    case attempt(done) { Ok(s) -> @print(s); Error(e) -> @print(e); };
    case attempt(failed) { Ok(s) -> @print(s); Error(e) -> @print("attempt: " + e); };
}

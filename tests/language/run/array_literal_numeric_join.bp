//// Decision 150 (D5, decision 8 §3.2) — elements that agree join: `[1.0, 2.5]`
//// and `[16d, 0.5, 3d]` are `f64[]` (decision 247 — an integer literal
//// never re-spells into a float; `[1, 2.5]` is refused, its own cell); a
//// `null` element makes the element optional, `[1, null]` is `?i32[]`.

fn total(xs: f64[]) -> f64 {
    var sum = 0.0;
    xs.forEach({ x ->
        sum = sum + x;
    });
    return sum;
}

pub fn main() {
    val ys = [1.0, 2.5];
    ys.forEach({ y -> @print(y * 2.0) });
    val hs = [16d, 0.5, 3d];
    @print(total(hs));
    val zs = [1, null];
    @print(zs.length);
    val ns = [null, 7, 8];
    @print(ns.at(1) ?? null ?? 0);
}

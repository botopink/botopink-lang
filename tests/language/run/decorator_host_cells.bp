//// Decisions 341, 434 — a decorator body calls a host function, and the
//// function travels into the decorator module; comptime runs on the wasm
//// runtime for every target, which answers `bang` by the beam-to-wasm
//// translation of its `@External.Erlang` cell (the first of its sources
//// present). A std host function travels the same way, reached through its
//// namespace (`hash.contentHash`) or a leaf import (`contentHash`), and
//// answers std-wasm's text. One comptime answer, so the four targets print
//// the same. Before decision 341, every such call was `call to undefined
//// function bang/1` in the decorator module.

import {hash} from "std";
import {hash.contentHash as digest} from "std";

#[@External.Node("""($0 + "!")""")]
#[@External.Erlang("""<<($0)/binary, "!">>""")]
#[@External.Wasm("fn:bangBody")]
declare fn bang(value: string) -> string;

fn bangBody(value: string) -> string {
    return value + "!";
}

fn tagged(name: string) -> string {
    return bang(name) + " " + hash.contentHash(name);
}

fn labelled(comptime decl: @Decl) {
    @emit(
        "pub fn label() -> string { return \""
            + tagged(decl.name)
            + " "
            + digest("héllo €")
            + "\"; }",
    );
}

#[labelled]
type Point(x: i32, y: i32)

pub fn main() {
    @print(label());
    @print(bang("run") + " " + hash.contentHash("Point"));
}

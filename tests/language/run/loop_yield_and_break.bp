//// Decision 8 §10 and decision 55 — `yield` and `break` in a collection loop's
//// body, each one **alone**. These are the two shapes all four backends already
//// agree on, and they are the baseline the three cells beside this one measure
//// against: `run/loop_yield_then_break_value.bp`,
//// `run/loop_break_value_then_yield.bp`, `run/loop_yield_then_bare_break.bp`.
////
//// The result is read as `length` + `join(",")` rather than printed as an array
//// on purpose: `@print` of an array is decision 8 §7's separator row, which two
//// backends still get wrong, and a §7 row must not hide a §10 one.

pub fn main() {
    val yielded = loop ([10, 20, 30]) { x -> yield x * 2; };
    @print(yielded.length);
    @print(yielded.join(","));

    val broken = loop ([10, 20, 30]) { x -> if (x == 20) { break x; }; };
    @print(broken.length);
    @print(broken.join(","));
}

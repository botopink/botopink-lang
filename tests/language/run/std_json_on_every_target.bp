//// `std/json` on all four targets (`01-compiler/05-wasm` step 5): the
//// writers (`quote`, `array`, `object`), `unquote`, the reader `decode` with
//// its accessors, and the host round-trip `parse` / `stringify` over
//// documents every host writes alike. On wasm `parse` / `stringify` have no
//// binding yet (`decisions-pending.md` 05w-j), so STD-001 refuses the import
//// (`.wasm.expect`).

import {json} from "std";

pub fn main() {
    @print(json.quote("a\"b\\c\n\u{1}é🎉/"));
    @print(json.unquote(" \"x\\u00e9\\ud83c\\udf89\\n\" ").unwrapOr("?"));
    @print(json.unquote("nope").isError());
    @print(json.array(["1", json.quote("two"), "null"]));
    @print(json.object([#("k", "1"), #("é", json.array([]))]));
    val doc = json.decode(
        "{\"name\": \"bp\", \"tags\": [\"a\", true, null, -1.5e2], \"n\": {}}",
    );
    val v = doc.unwrapOr(json.Json.Null);
    @print(v.kindName());
    @print(v.field("name").unwrapOr(json.Json.Null).str());
    @print(
        v
            .field("tags")
            .unwrapOr(json.Json.Null)
            .items()
            .map({ t -> t.kindName() })
            .join(","),
    );
    @print(v.members().map({ m -> m._0 }).join(","));
    @print(json.decode("{\"a\":1,\"a\":2}").isError());
    @print(json.decode("[1,]").isError());
    @print(json.parse("[1, \"a\", true, null]").unwrapOr("?"));
    @print(json.parse("{bad").isError());
    @print(json.stringify("\"é\"").unwrapOr("?"));
}

//// 01-std step 2 — `import {testing.asserts} from "std"` builds and runs on
//// commonJS, erlang and beam, where the module's pure assertions answer. The
//// module's host-backed assertions (`deepEquals`, `matches`, `throws`,
//// `throwsWith`) reach private cells with Node and Erlang templates only, and
//// a function whose body calls a host function with no binding for the target
//// is refused called or not (decision 146): on wasm the module does not
//// build, and the import that links it is refused (`.wasm.expect`), naming
//// the cell. wasm used to drop those functions and refuse only a call of one.

import {testing.asserts} from "std";

pub fn main() {
    @print(asserts.errorText(asserts.isTrue(false)));
    @print(asserts.errorText(asserts.equals(1, 1)).length);
    @print(asserts.errorText(asserts.approxEquals(1.0, 1.5, 0.1)));
    @print(asserts.errorText(asserts.approxEquals(1.5, 1.0, 0.1)));
    @print(asserts.errorText(asserts.approxEquals(1.0, 1.05, 0.1)).length);
    @print(asserts.errorText(asserts.contains("abc", "z")));
    @print(asserts.errorText(asserts.lengthIs([1, 2], 3)));
}

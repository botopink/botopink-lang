//// `std/math` on all four targets (decision 238, `01-compiler/05-wasm` step 5):
//// wasm binds `abs`, `floor`, `trunc`, `sqrt`, `minF` and `maxF` to one
//// instruction each (`op:`) and every other host cell to a private botopink
//// body (`fn:`) — `round` too, because `f64.nearest` rounds a half to even.
//// Each line compares with the value `Math.*` answers, so the one `.out` is
//// every target's: the targets print a float differently (`3` / `3.0`), and a
//// truth value the same way.

import {math} from "std";

pub fn main() {
    @print(math.abs(0.0 - 5.5) == 5.5);
    @print(math.floor(3.7) == 3.0 && math.ceil(3.2) == 4.0);
    @print(
        math.trunc(0.0 - 2.9) < 0.0 - 1.5 && math.trunc(0.0 - 2.9) > 0.0 - 2.5,
    );
    @print(math.round(2.5) > 2.5 && math.round(2.5) < 3.5);
    @print(math.round(0.49999999999999994) < 0.5);
    @print(math.minF(1.5, 2.5) == 1.5 && math.maxF(1.5, 2.5) == 2.5);
    @print(math.sqrt(2.0) == 1.4142135623730951);
    @print(math.hypot(3.0, 4.0) == 5.0);
    @print(math.exp(1.0) == 2.718281828459045);
    @print(math.ln(10.0) == 2.302585092994046);
    @print(math.log2(8.0) == 3.0 && math.log10(1000.0) == 3.0);
    @print(
        math.pow(2.0, 10.0) == 1024.0
            && math.pow(2.0, 0.5) == 1.4142135623730951,
    );
    @print(math.pow(1.5, 7.3) == 19.295951155032366);
    @print(
        math.sin(1.0) == 0.8414709848078965
            && math.cos(1.0) == 0.5403023058681398,
    );
    @print(math.tan(1.0) == 1.5574077246549023);
    @print(
        math.asin(0.5) == 0.5235987755982989
            && math.acos(0.5) == 1.0471975511965979,
    );
    @print(
        math.atan(1.0) == 0.7853981633974483
            && math.atan2(1.0, 0.0 - 1.0) == 2.356194490192345,
    );
    @print(
        math.sinh(1.0) == 1.1752011936438014
            && math.cosh(1.0) == 1.5430806348152437,
    );
    @print(math.tanh(0.5) == 0.46211715726000974);
}

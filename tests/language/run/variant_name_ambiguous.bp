//// The other half of `run/variant_name_collision.bp`: the spelling that has
//// no answer.
////
//// `Circle` is a variant of `Shape` and a variant of `Hole`, and `.Circle`
//// written as a call argument says which of the two only if something at the
//// site does — and nothing here does. Decision 21's atom carries the enum, so
//// there is no tag to render: `main__t__shape__v__circle` is a value no `case`
//// over `Hole` can match, which is exactly what erlang did before this —
//// `{case_clause, main__t__shape__v__circle}` at run time, from a program that
//// compiled without a word. Decision 67: refuse rather than guess.
////
//// `.targets` is `erlang` alone, and neither omission is this cell's shape:
////   * commonJS cannot run a leading-dot variant AT ALL, collision or none —
////     measured with `Shape` deleted, `holeOf(.Circle)` emits
////     `holeOf(Circle)` and node answers `ReferenceError: Circle is not
////     defined`. That is `00 · 04-js`'s row, not this one's.
////   * wasm places the variant correctly from the expected type and prints
////     `hole-circle`, so there is nothing for it to refuse.
//// beam shares the erlang lowering but not this emitter's refusal path.

pub type Shape {
    Circle,
    Square,
}

pub type Hole {
    Circle,
    Slot,
}

pub fn holeOf(h: Hole) -> string {
    return case h {
        Hole.Circle { "hole-circle" }
        Hole.Slot { "hole-slot" }
    };
}

pub fn shapeOf(s: Shape) -> string {
    return case s {
        Shape.Circle { "shape-circle" }
        Shape.Square { "shape-square" }
    };
}

pub fn main() {
    @print(holeOf(.Circle));
    @print(shapeOf(Shape.Circle));
}

//// Front 17 step 4 — `#[@BeamMemory.ProcessDict]`, the default said out loud:
//// the `var` is one value per BEAM process. `main` writes `5`; a process
//// `async.allOf` spawns afterwards reads the declaration's `0`, and its own
//// write never reaches `main`. On commonJS and wasm the execution context is
//// the whole program, so the cell is the BEAM's (`.targets`); decision 43 makes
//// the annotation a no-op there, which `test/beam_memory_noop` pins.

import { async } from "std";

#[@BeamMemory.ProcessDict]
var scratch: i32 = 0;

#[@future]
fn elsewhere() -> @Future<i32> {
    val before = scratch;
    scratch = 99;
    return before;
}

#[@future]
pub fn main() -> @Future<void> {
    scratch = 5;
    val seen = await async.allOf([{ -> elsewhere() }]);
    @print(seen);
    @print(scratch);
}

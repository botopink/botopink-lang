//// A METHOD parameter's default fills a call that leaves it out — on a call's
//// result, on a local, and not when the call writes it.

type Jar(n: i32) {
    pub fn put(self: Self, name: string, value: string = "dflt") -> string { return name + "=" + value; }
}

fn cookies() -> Jar { return Jar(n: 1); }

pub fn main() {
    @print(cookies().put("x"));
    val jar = Jar(n: 2);
    @print(jar.put("y"));
    @print(jar.put("z", "v"));
}

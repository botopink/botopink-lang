//// A host-backed method — `declare fn` with `#[@External.<Target>(…)]`
//// written INSIDE a `type` body — is a method of the type on every backend
//// that has a host: `m.plus(4)` is an ordinary method call, the binding's `$0`
//// is the receiver and `$1…` the arguments after it (decision 5's markers).
//// Pinned: a template naming `$0` and `$1` (and `$2`), a bodied method calling
//// a host one on `self`, the plain `(module, symbol)` form (the host function
//// takes the receiver first), `inline = true` on the erlang binding, and an
//// enum's host method (commonJS's enum method is a static taking `self`).
////
//// wasm has no host, so it refuses the program where the first host method
//// is called — `external_method_local.wasm.expect`, the diagnostic a
//// module-level host function gets, naming `Type.method`.

pub type Meter(base: i32) {
    #[@External.Node("""($0.base + $1)"""),
      @External.Erlang("""(element(2, $0) + $1)""")]
    pub declare fn plus(self: Self, n: i32) -> i32;

    #[@External.Node("""[$0.base, $1, $2].join("-")"""),
      @External.Erlang("""iolist_to_binary(lists:join(<<"-">>, [integer_to_binary(element(2, $0)), integer_to_binary($1), $2]))""")]
    pub declare fn label(self: Self, n: i32, tail: string) -> string;

    #[@External.Node("""($0.base * $1)"""),
      @External.Erlang("""(element(2, $0) * $1)""", inline = true)]
    pub declare fn times(self: Self, n: i32) -> i32;

    pub fn twice(self: Self) -> i32 {
        return self.plus(self.base);
    }
}

// The `(module, symbol)` form: the host function is handed the receiver.
pub type Word(text: string) {
    #[@External.Node("Array", "isArray"),
      @External.Erlang("erlang", "is_list")]
    pub declare fn isList(self: Self) -> bool;
}

pub type Level {
    Low,
    High,

    #[@External.Node("""($0.tag === "High" ? $1 * 10 : $1)"""),
      @External.Erlang("""case $0 of 'language_tests@main@@Level__v__high' -> $1 * 10; _ -> $1 end""")]
    pub declare fn scale(self: Self, n: i32) -> i32;
}

pub fn main() {
    val m = Meter(base: 3);
    @print(m.plus(4));
    @print(m.twice());
    @print(m.label(5, "x"));
    @print(m.times(7));
    @print(Word(text: "w").isList());
    @print(Level.High.scale(2));
    @print(Level.Low.scale(2));
}

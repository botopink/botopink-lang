//// Decision 216 (2) — `decl.setMeta(key, value)`: a decorator records a
//// compile-time fact about the declaration it annotates, read back by
//// reflection as `@typeInfo(X).meta.<decorator>.<key>`. Each decorator has its
//// own namespace of keys, a function carries meta like a type does, and a
//// read is a string constant — it never becomes run-time code of the
//// decorator. `@typeInfo(X).name` answers the declaration's own name.

fn entity(comptime decl: @Decl, table: string) {
    var names: string[] = [];
    decl.fields.forEach({ f -> names.push(f.name) });
    decl.setMeta("table", table);
    decl.setMeta("columns", names.join(","));
}

fn audited(comptime decl: @Decl) {
    decl.setMeta("table", "audit_" + decl.name);
}

fn route(comptime decl: @Decl, path: string) {
    decl.setMeta("path", path);
}

#[entity("cities")]
#[audited]
type City(name: string, size: i32)

#[route("/about")]
fn about() -> string {
    return "about us";
}

pub fn main() {
    @print(@typeInfo(City).meta.entity.table);
    @print(@typeInfo(City).meta.entity.columns);
    @print(@typeInfo(City).meta.audited.table);
    @print(@typeInfo(City).name);
    val path: string = @typeInfo(about).meta.route.path;
    @print(path + " -> " + about());
    @print(@typeInfo(City).meta.entity.table.length);
}

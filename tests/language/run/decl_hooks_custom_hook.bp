//// Decision 277 — a hook written in botopink has a node of its own: `Page`
//// `use`s `user`, and `user` `use`s `session` — three nodes, each holding
//// only the `use` written in it.

type Element(text: string) implement @Renderable

// Renders `decl.hooks` into one meta string `main` prints: each node as
// `fn(uses: […], calls: […])`, a `use` over a function value as `null`.
fn graph(comptime decl: @Decl) {
    var nodes: string[] = [];
    decl.hooks.forEach({ n ->
        var uses: string[] = [];
        n.uses.forEach({ u ->
            val h = u.hook;
            uses.push(if (h == null) "null" else h.name + "@" + u.at);
        });
        var calls: string[] = [];
        n.calls.forEach({ c -> calls.push(c.callee.name + "@" + c.at) });
        nodes.push(
            n.function.name
                + "(uses: ["
                + uses.join(", ")
                + "], calls: ["
                + calls.join(", ")
                + "])",
        );
    });
    decl.setMeta("nodes", nodes.join(" "));
}

fn session() -> @Component<string> {
    return "alice";
}

fn user() -> @Component<string> {
    val s = use session();
    return "user " + s;
}

#[graph]
fn Page() -> @Component<Element> {
    val u = use user();
    return Element(text: u);
}

pub fn main() {
    @print(@typeInfo(Page).meta.graph.nodes);
}

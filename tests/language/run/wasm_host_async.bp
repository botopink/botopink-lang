//// Front 140 step 5 (decisions 392–394) — `@Task` on wasm behaves as a Promise,
//// under wasmtime (`wasi`: `wasi:clocks/monotonic-clock` + `wasi:io/poll`) and
//// under node (`browser`: the loader's `setTimeout`, the JS event loop), and the
//// answers equal commonJS's and erlang's. `delay`, `race`, `raceOf` and
//// `spawnAll` are declared here with the bindings std carries on Node and the
//// BEAM and decision 393's adapters on wasm (std's own wasm bindings are
//// `02/97` step 17's). `raceOf` answers the first thunk to SETTLE: the block
//// that awaits 30 ms loses to the 10 ms delay (392 (1)); `race` over started
//// tasks answers the first to settle — element zero here too, since erlang's
//// eager tasks answer element zero; `spawnAll` keeps the order of the input.
//// Every line is printed from one task chain: the order of effects between
//// concurrent tasks is no target's contract (335 (2)).

#[@External.Node("""((__ms, __v) => new Promise((__r) => { const __end = performance.now() + __ms; const __tick = () => { const __left = __end - performance.now(); if (__left > 0) { setTimeout(__tick, Math.ceil(__left)); } else { __r(__v); } }; setTimeout(__tick, __ms); }))($0, $1)""")]
#[@External.Erlang("""(fun(__M, __V) -> timer:sleep(__M), __V end)($0, $1)""")]
#[@External.Wasm("wasi:delay")]
declare fn delay<T>(millis: i32, value: T) -> @Task<T>;

#[@External.Node("""((__fs) => __fs.length === 0 ? Promise.reject(new Error('async.race: empty task list')) : Promise.race(__fs))($0)""")]
#[@External.Erlang("""(fun(__Fs) -> case __Fs of [] -> erlang:error(<<"async.race: empty task list">>); _ -> hd(__Fs) end end)($0)""")]
#[@External.Wasm("wasi:race")]
declare fn race<T>(tasks: Array<@Task<T>>) -> @Task<T>;

#[@External.Node("""((__ts) => __ts.length === 0 ? Promise.reject(new Error('async.raceOf: empty task list')) : Promise.race(__ts.map((__f) => (__f)())))($0)""")]
#[@External.Erlang("""(fun(__Ts) -> case __Ts of [] -> erlang:error(<<"async.raceOf: empty task list">>); _ -> __Me = self(), BpRef = erlang:make_ref(), lists:foreach(fun(__I) -> erlang:spawn(fun() -> __Me ! {BpRef, try {ok, (lists:nth(__I, __Ts))()} catch __C:__E -> {error, __C, __E} end} end) end, lists:seq(1, length(__Ts))), case (receive {BpRef, __W} -> __W end) of {ok, __V} -> __V; {error, __C2, __E2} -> erlang:raise(__C2, __E2, []) end end end)($0)""")]
#[@External.Wasm("wasi:race_of")]
declare fn raceOf<T>(tasks: Array<fn() -> @Task<T>>) -> @Task<T>;

#[@External.Node("""Promise.all(($0).map((__f) => (__f)()))""")]
#[@External.Erlang("""(fun(__Ts) -> __Me = self(), BpRef = erlang:make_ref(), lists:foreach(fun(__I) -> erlang:spawn(fun() -> __Me ! {BpRef, __I, try {ok, (lists:nth(__I, __Ts))()} catch __C:__E -> {crash, __C, __E} end} end) end, lists:seq(1, length(__Ts))), [case (receive {BpRef, BpJ, __X} -> __X end) of {ok, __V} -> __V; {crash, __C2, __E2} -> erlang:raise(__C2, __E2, []) end || BpJ <- lists:seq(1, length(__Ts))] end)($0)""")]
#[@External.Wasm("wasi:spawn_all")]
declare fn spawnAll<T>(tasks: Array<fn() -> @Task<T>>) -> @Task<Array<T>>;

fn run() -> @Task<void> {
    val first = await raceOf(
        [
            { ->
                async {
                    await delay(30, 0);
                    "a";
                };
            },
            { -> delay(10, "b") },
        ],
    );
    @print("raceOf " + first);
    val r = await race([delay(5, "x"), delay(60, "y")]);
    @print("race " + r);
    val all = await spawnAll(
        [
            { -> delay(20, "one") },
            { -> delay(5, "two") },
            { -> delay(1, "three") },
        ],
    );
    @print("spawnAll " + all.join(","));
    val n = await delay(0, 7);
    @print(n + 1);
}

pub fn main() {
    run();
}

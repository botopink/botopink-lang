//// `val assert` over a RECORD's constructor pattern binds the record's fields
//// by position when the subject is one, and takes the handler's value when it
//// is not (decision 8 §9).
////
//// The gaps this pins: commonJS destructured the binders by their own names —
//// `const { n, a } = _assert0`, fields the record does not have — and printed
//// `null null`; erlang tested the bare `'Person'` tag, which no constructor
//// builds (a record is `{'<pkg>@<path>@@Person', …}`, decision 109), so the
//// pattern never matched. beam did the same and bound the names in the
//// matching arm only, so `erlc +from_asm` refused the module
//// (`{unassigned, {y, 2}}`): the names are bound from the value either path
//// answers. wasm tested nothing and bound nothing (`unbound identifier n`), and
//// the checker left the binders untyped, so `a.toString()` had no lowering
//// there; each binder takes the field it stands at, by label when one is
//// written.

type Person(name: string, age: i32)

fn describe(p: Person | i32) -> string {
    val assert Person(n, a) = p catch Person(name: "none", age: 0);
    return n + " " + a.toString();
}

fn byLabel(p: Person | i32) -> string {
    val assert Person(age: years, name: who) = p catch Person(name: "none", age: 0);
    return who + " is " + years.toString();
}

pub fn main() {
    @print(describe(Person(name: "ann", age: 3)));
    @print(describe(7));
    @print(byLabel(Person(name: "bo", age: 9)));
    @print(byLabel(1));
}

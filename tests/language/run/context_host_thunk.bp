//// Decision 374 — a `@Component` function value handed to a host function
//// captures the context map where it is written. A lambda that is an
//// argument of a host call takes no hidden map: its body reads the map of
//// the body it is written in, as a closure reads a local, so the host's own
//// call keeps every provider above — `hostNow` calls its thunk at once
//// (jhonstart's `__jhTryComponent`), `hostEach` with an argument of the
//// host's (the lambda's own parameter kept), and a declared component named
//// as the argument (`hostNow(Plain)`) is wrapped the same way. `hostStash`
//// keeps its thunk, and `main` calls it twice after every component has
//// returned (a `Suspense` fill, a retry): both calls read the map captured
//// where the lambda was written.

import {context.Context, context.provide, context.context} from "std";

type Theme(mode: string)

type Element(text: string) implement @Renderable

pub val ThemeContext = Context<Theme>();

#[@External.Node("""($0)()""")]
#[@External.Erlang("""($0)()""")]
declare fn hostNow(f: fn() -> @Component<Element>) -> @Task<Element>;

#[@External.Node("""($0)($1)""")]
#[@External.Erlang("""($0)($1)""")]
declare fn hostEach(
    f: fn(i: i32) -> @Component<Element>,
    i: i32,
) -> @Task<Element>;

#[@External.Node("""(globalThis.__bpCtxStash = $0, undefined)""")]
#[@External.Erlang("""persistent_term:put(bp_ctx_stash, $0)""")]
declare fn hostStash(f: fn() -> @Component<Element>) -> void;

#[@External.Node("""globalThis.__bpCtxStash""")]
#[@External.Erlang("""persistent_term:get(bp_ctx_stash)""")]
declare fn hostStashed() -> fn() -> @Task<Element>;

fn Label(prefix: string) -> @Component<Element> {
    val t = use context(ThemeContext);
    return Element(text: prefix + t.mode);
}

fn Plain() -> @Component<Element> {
    val t = use context(ThemeContext);
    return Element(text: "named:" + t.mode);
}

fn Page() -> @Component<Element> {
    use provide(ThemeContext, Theme(mode: "dark"));
    val now = await hostNow({ -> Label("now:") });
    val named = await hostNow(Plain);
    val each = await hostEach({ i -> Label("each" + i.toString() + ":") }, 2);
    hostStash({ -> Label("later:") });
    return Element(text: now.text + " " + named.text + " " + each.text);
}

fn Root() -> @Component<Element> {
    use provide(ThemeContext, Theme(mode: "light"));
    val p = Page();
    return Element(text: p.text);
}

pub fn main() -> @Task<void> {
    val r = await Root();
    @print(r.text);
    val later = hostStashed();
    val first = await later();
    val second = await later();
    @print(first.text + " " + second.text);
}

//// Decision 95 — `@Component` ⊃ `@Future` ⊃ `@Result`, so `await` is legal in a
//// `#[@use]` body; `run/effect_chain.bp` carries `use` and `try`. Both shapes of
//// decision 128's one wrapper are here: a hook (`-> @Component<Element, i32>`) and
//// a component (`-> @Component<Element, Element>`).
////
//// Every value is printed from INSIDE the body. commonJS emits every `#[@use]`
//// body as an `async function` (decision 104) and hands its CALLER a promise,
//// while erlang, wasm and beam hand it the value, so a `@print` at the call
//// site would compare a promise with `41`. What every target agrees on is the
//// body: it runs, in order, with the awaited value in hand. On commonJS each
//// body resumes after its first `await` (`use` awaits too); `Plain` and `page`
//// resume one turn in and `Widget` two, which is the order the eager targets
//// print them in as well.

type Element(count: i32) implement @Context<Element>

fn state(initial: i32) -> @Component<Element, i32> {
    return initial;
}

fn answer(n: i32) -> @Task<i32> {
    return n;
}

// The explicit wrapper: `await` two levels down the chain.
fn page(n: i32) -> @Component<Element, i32> {
    val v = await answer(n);
    @print(v);
    return v;
}

// The component shape — `use` and `await` in one body.
fn Widget(n: i32) -> @Component<Element, Element> {
    val c = use state(1);
    val v = await answer(n);
    @print(c + v);
    return Element(count: c + v);
}

// A component with no `await` of its own: its `use` is the suspension on
// commonJS (decision 104), so it prints from inside too.
fn Plain(n: i32) -> @Component<Element, Element> {
    val c = use state(1);
    @print(c + n);
    return Element(count: c + n);
}

pub fn main() {
    Plain(40);
    page(41);
    Widget(41);
}

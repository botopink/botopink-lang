//// Decisions 120 and 121 of 1.0.10-beta (front 24 step E5, § Cells "`@Task` and
//// failure", JS run) — on commonJS a `@Task` return is an `async function`, and
//// a `throw` in a `@Task<@Result<…>>` body does NOT reject its Promise: the
//// Promise resolves with the `Error` value. The observer is host code: it
//// attaches both callbacks to the Promise the call answered, hands a resolved
//// value back to botopink (`report` reads it with `case`, so the cell does not
//// depend on the runtime shape of `@Result`), and prints `rejected` on a
//// rejection. A Promise that rejected would print `rejected` where the cell
//// expects `resolved Error negative`.
////
//// `.targets` is `commonJS`: the claim is about a JavaScript Promise; erlang,
//// beam and wasm run a Task eagerly and have no rejection to avoid.

fn check(n: i32) -> @Task<@Result<i32, string>> {
    if (n < 0) { throw "negative"; };
    return n;
}

fn report(r: @Result<i32, string>) {
    case r {
        Ok(v) -> @print("resolved Ok " + v.toString());
        Error(e) -> @print("resolved Error " + e);
    };
}

#[@External.Node("""$0.then((__r) => $1(__r), (__e) => console.log('rejected'))""")]
declare fn observe(t: @Task<@Result<i32, string>>, onResolve: fn(r: @Result<i32, string>) -> void);

pub fn main() {
    observe(check(1), report);
    observe(check(-1), report);
}

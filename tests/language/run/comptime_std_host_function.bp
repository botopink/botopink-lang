//// 01-compiler/14 step 8 (T19, with step 6's host cells) — a `comptime`
//// calls std's `hash.contentHash`, a host function: the comptime module
//// carries it with its runtime's cell (decision 341) — the Erlang one on the
//// BEAM runtime, `contentHashBody` (its `@External.Wasm("fn:…")`) on the wat
//// runtime — and the value is lifted into the program, the same string the
//// program computes when it runs. It used to be refused: the block called
//// `.contentHash(…)`, which nothing in the comptime module provided.

import {hash} from "std";
import {hash.contentHash} from "std";

fn className(rules: string) -> string {
    return "e_" + hash.contentHash(rules);
}

pub fn main() {
    val atBuild = comptime hash.contentHash("hello");
    @print(atBuild);
    val leaf = comptime contentHash("héllo €");
    @print(leaf);
    val built = comptime className(".x{padding:4px}");
    @print(built);
    @print(built == className(".x{padding:4px}"));
}

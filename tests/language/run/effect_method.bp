//// An effect annotation on a METHOD is the method's, exactly as it is a free
//// `fn`'s — decision 8 §9 names no exception for a receiver. commonJS read the
//// effect off `ast.FnDecl.effect`, which a method has not, so `#[@resultGenerator] fn
//// each(self: Self) -> @ResultGenerator<i32>` emitted as a plain method whose
//// `loop … yield` lowered to a value-dropping `.map()`, and `loop (b.each())`
//// died with `TypeError: b.each is not a function or its return value is not
//// iterable` where erlang printed the elements.
////
//// Three declaration sites, because they are three different emitters: a
//// method in a record's own body, a method in a record's `implement` block,
//// and a method in an enum's body. The fourth — a `behavior`'s `default fn` —
//// is deliberately absent and cannot be written: the checker refuses
//// `effect-on-behavior-method-forbidden`, "behavior methods are declarative;
//// they express the effect through the return wrapper alone".
////
//// Each row asserts the VALUE, digit by digit, so an iterator that yields the
//// right elements in the wrong order is a failure too.
////
//// A `#[@future]` method prints from INSIDE its own body on purpose: commonJS
//// answers a Promise where erlang answers the value, which is the accepted
//// shape of a suspending effect on that backend and not this cell's claim.

type Box(items: Array<i32>) {
    #[@resultGenerator]
    fn each(self: Self) -> @ResultGenerator<i32> {
        loop (self.items) { x ->
            yield x;
        };
    }
}

type Tally(seed: i32) implement Tally {
    #[@resultGenerator]
    fn upto(self: Self, n: i32) -> @ResultGenerator<i32> {
        var i = self.seed;
        loop (i < n) {
            yield i;
            i = i + 1;
        };
    }

    #[@future]
    fn total(self: Self, n: i32) -> @Future<i32> {
        var acc = self.seed;
        var i = 0;
        loop (i < n) {
            acc = acc + i;
            i = i + 1;
        };
        @print(acc);
        return acc;
    }
}

type Shape {
    Rect(width: i32, height: i32),
    Dot,

    #[@resultGenerator]
    fn counts(self: Self, n: i32) -> @ResultGenerator<i32> {
        var i = 0;
        loop (i < n) {
            yield i;
            i = i + 1;
        };
    }
}

// A loop over a `@ResultGenerator` is a `try` in the body that iterates it
// (decision 103), so the consumer carries `#[@result]`.
#[@result]
fn digits(xs: @ResultGenerator<i32>) -> @Result<i32, string> {
    var acc = 0;
    loop (xs) { v ->
        acc = acc * 10 + v;
    };
    return acc;
}

pub fn main() {
    // A method in the record's own body.
    @print(try digits(Box(items: [1, 2, 3]).each()) catch 0);

    // A method in an `implement` block.
    @print(try digits(Tally(seed: 4).upto(7)) catch 0);

    // A method in an enum's body.
    @print(try digits(Shape.Rect(width: 5, height: 2).counts(3)) catch 0);

    // `#[@future]` on a method: the body runs and prints its own answer.
    Tally(seed: 10).total(4);
}

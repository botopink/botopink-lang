//// Decision 105 — inside a `#[@future]` fn a `iter loop` may not
//// `await`: `@Iterator<T>` has no suspension to honour. For `await` in the
//// body one writes `stream loop { … }`.

fn fetch(n: i32) -> @Task<i32> { return n; }

fn feed() -> @Task<i32> {
    val g = iter loop {
        val v = await fetch(1);
        break v;
    };
    return 1;
}

pub fn main() { @print(1); }

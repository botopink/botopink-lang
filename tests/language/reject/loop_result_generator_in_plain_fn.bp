//// Decision 103 of 1.0.10-beta — a loop over a fallible generator is a `try`
//// in the body that iterates it: `Error(e)` propagates on that body's error
//// channel, so a plain `fn` (no channel) is refused at the loop, naming the
//// level it would need (decision 67 — located, no flag). `@Generator<T>` is
//// the infallible wrapper a plain `fn` may iterate (`run/generator_levels.bp`).

#[@resultGenerator]
fn upto(n: i32) -> @ResultGenerator<i32, string> {
    yield n;
}

fn total(n: i32) -> i32 {
    var acc = 0;
    loop (upto(n)) { x -> acc = acc + x; };
    return acc;
}

pub fn main() { @print(total(3)); }

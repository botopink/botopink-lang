//// Decisions 118, 122 and 127 of 1.0.10-beta (front 24, § Cells "Migration";
//// guide.md § 9, row `#[@resultGenerator]` + `@ResultGenerator<T, E>`) —
//// `#[@resultGenerator]` is refused at the annotation over the new
//// `@Iterator<@Result<T, E>>` return. The new form is
//// `run/iterator_result_items.bp`.

#[@resultGenerator]
fn upto(n: i32) -> @Iterator<@Result<i32, string>> {
    if (n < 0) { throw "negative"; };
    var i = 0;
    while (i < n) { yield i; i = i + 1; };
}

pub fn main() { for (upto(2)) { r -> @print(r.unwrapOr(0)); }; }

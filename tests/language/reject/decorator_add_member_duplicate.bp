//// Decision 216 (1) — a decorator cannot replace or shadow a member the type
//// already has: a second `size` is refused at the annotation, naming it.

fn sized(comptime decl: @Decl) {
    decl.addMember("pub fn size(self: Self) -> i32 { return 0; }");
}

#[sized]
type Box(n: i32) {
    pub fn size(self: Self) -> i32 {
        return self.n;
    }
}

pub fn main() {
    @print(Box(n: 1).size());
}

//// Decisions 122 and 127 of 1.0.10-beta (front 24, § Cells "Migration";
//// guide.md § 9, row `#[@generator]` + `@Generator<T>`) — `@Generator<T>` is
//// `effect-type-removed`, fix-it `@Iterator<T>`. The new form is
//// `run/iterator_fibonacci.bp`.

fn nums(n: i32) -> @Generator<i32> {
    var i = 0;
    while (i < n) { yield i; i = i + 1; };
}

pub fn main() { for (nums(2)) { x -> @print(x); }; }

//// R5 stands (decision 104 does not amend it): one effect annotation per fn,
//// so `#[@use]` is refused. The chain is what makes one enough — the
//// server component that awaits and uses is `fn … -> @Component<Element, Element>`
//// (`test/use_future_context.bp`).
////
//// The `.expect` claims the message only: R5's caret points at the body's `{`
//// rather than at the second annotation, and that drift is already owned by
//// `reject/two_effect_markers.bp`'s row in `expected-failures.txt` (01 step 8).

type Element(count: i32) implement @Context<Element>
fn state(initial: i32) -> @Component<Element, i32> { return initial; }

fn Page() -> @Task<Element> {
    val n = use state(0);
    return Element(count: n);
}

pub fn main() { @print(0); }

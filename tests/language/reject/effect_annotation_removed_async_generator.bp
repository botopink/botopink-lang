//// Decision 127 of 1.0.10-beta (front 24, § Cells "Migration"; guide.md § 9,
//// row `#[@iterator]` / `#[@asyncGenerator]` / `@AsyncIterator`) — the
//// `#[@asyncGenerator]` of the pre-103 surface stays gone. Measured at compiler
//// `82e32e36`: accepted in silence. The cell asks for `effect-annotation-removed`
//// (the family's code; decision 127 names none for the older names — reported
//// as a choice). The new form is `run/stream_pages.bp`.

#[@asyncGenerator]
fn ticks(n: i32) -> @Stream<@Result<i32, string>> {
    if (n < 0) { throw "negative"; };
    var i = 0;
    while (i < n) { yield i; i = i + 1; };
}

pub fn main() { ticks(2); }

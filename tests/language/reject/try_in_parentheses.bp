//// 1.0.10-beta decision 136 — a group exists to become an operand, so `try`
//// inside parentheses is the operand form: `(try r).toString()` is refused at
//// the `try`. Bind it first: `val n = try r; n.toString()`.

fn parse(n: i32) -> @Result<i32, string> {
    if (n < 0) { throw "negative"; }
    return n;
}

fn show(n: i32) -> @Result<string, string> {
    return (try parse(n)).toString();
}

pub fn main() {
    @print(show(2).unwrapOr(""));
}

//// Decision 356 — a `val` owns no type: `decl.addMember` from a decorator
//// on a `val` is refused at the annotation, as on a function.

fn helper(comptime decl: @Decl) {
    decl.addMember("pub fn extra() -> i32 { return 1; }");
}

#[helper]
pub val limit = 2;

pub fn main() {
    @print(limit);
}

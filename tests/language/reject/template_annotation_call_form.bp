//// Decision 311 — `#[f(…)]` naming a template function is refused at the
//// annotation, naming the template form `#[f "…"]`.

type Query(sql: string)

fn sql(comptime q: @Expr<string>, comptime decl: @Decl) -> @Expr<string> {
    decl.setMeta(Query(sql: q.text()));
    return q.build("\"\"");
}

#[sql("select 1")]
fn one() -> i32 {
    return 1;
}

pub fn main() {
    @print(one().toString());
}

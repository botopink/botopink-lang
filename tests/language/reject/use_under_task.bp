//// Decisions 118, 120 and 128 of 1.0.10-beta (front 24, § Cells "Chain and
//// `use`"; guide.md § 4.5 `Page`) — the chain grants downwards only:
//// `@Component ⊃ @Task`, so a `@Task` return grants `await` and not `use`.
//// `use-without-context-effect`, at the `use`.

pub type ElementBase {}
type Element(count: i32) implement @Context<ElementBase>

fn state(initial: i32) -> @Component<ElementBase, i32> { return initial; }

fn Page() -> @Task<Element> {
    val c = use state(0);
    return Element(count: c);
}

pub fn main() { Page(); }

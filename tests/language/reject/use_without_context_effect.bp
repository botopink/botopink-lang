//// Decision 88 — a body activates a hook only under `#[@context]`. The return
//// type implements `@Context` (it is the owner type), so the diagnostic names
//// the annotation rather than the type; a bare `-> Element` without the
//// annotation is an ordinary fn.

type Element(count: i32) implement @Context<Element, Element>
fn state(initial: i32) -> @Context<Element, i32> { return initial; }

fn Widget() -> Element {
    val c = use state(0);
    return Element(count: c);
}

pub fn main() { @print(Widget().count); }

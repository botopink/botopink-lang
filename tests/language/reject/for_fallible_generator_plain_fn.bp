//// Decision 103 — `for` over a fallible generator is an implicit `try` at
//// every item and needs a body that grants `try`. A plain fn with a return
//// type grants none: the refusal names the level it would need.

fn upto(n: i32) -> @Iterator<i32> {
    var i = 0;
    while (i < n) { yield i; i = i + 1; };
}

fn digits(xs: @Iterator<i32>) -> i32 {
    var acc = 0;
    for (xs) { v -> acc = acc * 10 + v; };
    return acc;
}

pub fn main() { @print(digits(upto(3))); }

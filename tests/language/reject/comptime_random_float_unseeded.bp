//// Decisions 451 (3), 456 — `random.float()` is an unseeded draw and has a
//// `std:random.float` cell: at comptime it is refused, located, with the
//// seeded stream's message — a build has no entropy — never as a host
//// function with no cell (`comptime-host-cell-unavailable`).

import {io} from "std";

pub fn main() {
    val atBuild = comptime io.random.float();
    @print(atBuild);
}

//// Decision 361 — a prelude is a module, and a module takes no annotation
//// (315): `#[bpp.stylePrelude]` marks the marker `val` the prelude module
//// declares, and on a function it is refused at the annotation.

import {bpp} from "std";

#[bpp.stylePrelude]
pub fn prelude() -> i32 {
    return 1;
}

pub fn main() {
    @print(prelude());
}

//// 1.0.11 front 14 step 1 — a decorator body (untyped) calling a method no
//// primitive type and no host function answers is refused by the compiler
//// itself, before any comptime runtime runs: the message names the call in the
//// body by line and column, the caret is the annotation that ran the body.

fn check(comptime decl: @Decl) {
    val n = decl.name;
    val x = n.frobnicate(1, 2);
}

#[check]
type A(x: i32)

pub fn main() {
    @print(A(x: 1).x);
}

//// 01-compiler/01-checker row "a partially returning `@block`" (decision 2) —
//// every path of an `@block` used as a value leaves through `return`: here the
//// false path runs off the end, its tail `4` no value, so the block is
//// `block-tail-value` at the block. The parent binary checked it and printed
//// `null` on commonJS, `4` on erlang, `0` on wasm on the fall-through path.

fn pick(c: bool) -> i32 {
    val a = @block{
        if (c) return 3;
        4;
    };
    return a;
}

pub fn main() {
    @print(pick(false));
}

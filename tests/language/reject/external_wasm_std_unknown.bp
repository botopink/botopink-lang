//// Decision 440 (3) — `std:<module>.<function>` names a function std-wasm
//// implements. A name it lacks is refused at the annotation, on every
//// target: the one cell serves the wasm codegen and the comptime alike.

#[@External.Node("Math", "floor")]
#[@External.Wasm("std:math.floorOf")]
declare fn floorOf(x: f64) -> f64;

pub fn main() {
    @print(floorOf(2.5));
}

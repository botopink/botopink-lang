//// Decision 95 — the top of the chain still cannot yield. `#[@use]` grants
//// `use`, `await` and `try`, and `yield` is not below any of them; the same
//// missing star context that accepted `reject/yield_in_result.bp` accepted
//// this one.
////
//// A `yield` inside a `for (…) { … }` body is the same construct — decision
//// 105: it feeds the nearest generator scope, and a body the chain grants no
//// `yield` has none.

type Element(count: i32) implement @Context<Element>

fn Bad(n: i32) -> @Component<Element, Element> {
    yield n;
}

pub fn main() { @print(1); }

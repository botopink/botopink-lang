//// Decision 280 (1), example 1 — a function argument is a reference, checked
//// where it is written: a misspelt name is the ordinary unbound-name error at
//// the argument, not a string the body meets later.

import {types.Type} from "std";

pub type Code { Custom, Mismatch }

fn check<T>(
    comptime decl: @Decl<T>,
    comptime message: string,
    comptime rule: ?fn(v: T) -> bool = null,
    comptime at: ?Type.Field<T> = null,
    comptime code: Code = .Custom,
) {
    decl.setMeta("message", message);
}

type Account(password: string, confirm: string)

fn passwordsMatch(a: Account) -> bool {
    return a.password == a.confirm;
}

#[check("passwords differ", passwordMatch)]
type Signup(password: string, confirm: string)

pub fn main() {
    @print("unreached");
}

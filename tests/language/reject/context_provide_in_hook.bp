//// Decision 354 (2) — a provider gives its value to what a COMPONENT renders
//// below it. A hook (`@Component<R>` whose `R` does not implement
//// `@Renderable`) renders nothing: `use provide(…)` in its body is refused at
//// the `use`.

import {context.Context, context.provide, context.context} from "std";

type Theme(mode: string)

type Element(text: string) implement @Renderable

pub val ThemeContext = Context<Theme>();

fn themed() -> @Component<i32> {
    use provide(ThemeContext, Theme(mode: "dark"));
    return 1;
}

pub fn main() {
    themed();
}

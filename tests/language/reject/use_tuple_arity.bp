//// Front 19 step 3 of 1.0.10-beta — `val #(…) = use …` binds each name to the
//// element of the hook's `R` at its position, so the pattern's arity is the
//// tuple's: one name against a tuple of two is refused at the binding, with
//// no flag (decision 67).

type Element(count: i32) implement @Context<Element>

#[@use]
fn optimistic(base: i32, f: fn(current: i32, action: i32) -> i32) -> @Use<Element, #(i32, fn(action: i32) -> i32)> {
    val push = { action -> f(base, action) };
    return #(base, push);
}

#[@use]
fn Liked() -> @Component<Element> {
    val #(shown) = use optimistic(12, { c, a -> c + a });
    return Element(count: shown);
}

pub fn main() { @print(Liked().count); }

//// Decisions 122 and 127 of 1.0.10-beta (front 24, § Cells "Migration";
//// guide.md § 9, row `#[@resultGenerator]` + `@ResultGenerator<T, E>`) —
//// `@ResultGenerator<T, E>` is `effect-type-removed`, fix-it
//// `@Iterator<@Result<T, E>>`. The new form is `run/iterator_result_items.bp`.

fn upto(n: i32) -> @ResultGenerator<i32, string> {
    var i = 0;
    while (i < n) { yield i; i = i + 1; };
}

pub fn main() { upto(2); }

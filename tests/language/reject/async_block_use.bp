//// Decision 124 of 1.0.10-beta (front 24, § Cells "`async { }`") — the block is
//// closed: its body starts a new capability context, like a closure, so inside
//// a `@Component` function an `async { }` may not `use`. Refused at the `use`
//// with the code a closure's `use` gets (`reject/use_in_closure.bp`).

pub type ElementBase {}
type Element(count: i32) implement @Context<ElementBase>

fn state(initial: i32) -> @Component<ElementBase, i32> { return initial; }

fn Widget() -> @Component<ElementBase, Element> {
    val t = async { return use state(1); };
    return Element(count: 1);
}

pub fn main() { Widget(); }

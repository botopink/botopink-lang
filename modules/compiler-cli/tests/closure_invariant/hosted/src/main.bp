//// The consumer that binds a BEAM host of its own (erlang and beam only):
//// its program loads the `.erl` sidecar it ships, `shelf`'s modules do not
//// change for it.

import {items.Queue, items.describe} from "shelf";

#[@external(.Erlang("hosted_greeter:hello($0)"))]
declare fn hello(name: string) -> string;

pub fn main() {
    @print(hello(describe(Queue(label: "hosted", size: 1))));
}

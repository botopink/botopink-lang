// test-tooling fixture (mixed pass/fail): one passing test, one failing
// `assert cond, "msg"` and one `try` on an `Error`. The runner must (a) surface
// the custom message and the error string in the FAIL lines, (b) name the
// package-relative file (`src/main.bp:<line>`) in each, (c) still run the
// passing test, and (d) exit non-zero. The harness (../../test_tooling.sh)
// asserts all four. The failing assert also shows the runner catches a thrown
// assertion gracefully rather than crashing.

fn double(n: i32) -> i32 {
  return n * 2;
}

fn failing() -> @Result<i32, string> {
  throw "went wrong";
}

test "this one passes" {
  assert double(2) == 4;
}

test "this one fails with a custom message" {
  assert double(2) == 5, "double(2) should be five";
}

test "t: fails" {
  try failing();
}

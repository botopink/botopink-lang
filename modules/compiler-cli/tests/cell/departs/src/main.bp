//// `magnitude` is bound for node and for the BEAM, not for wasm: three
//// targets print, and wasm departs — it refuses the call, located.

import {compiler, io.terminal.print} from "std";

#[compiler.external(.JavaScript("""Math.abs($0)"""), .Erlang("erlang:abs($0)"))]
declare fn magnitude(n: i32) -> i32;

pub fn main() -> void {
    print(magnitude(0 - 7));
}

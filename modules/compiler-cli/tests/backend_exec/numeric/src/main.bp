// The wasm core module's `--invoke main` fixture (../../backend_exec.sh):
// `main()` returns 55, which `wasmtime --invoke main` prints from the
// component's core module. What the program answers on every target is the
// conformance cell `conformance/modules/tail/run/src/cases/tail_recursive_sum`.

fn sumTo(n: i32, acc: i32) -> i32 {
    if (n == 0) return acc;
    return sumTo(n - 1, acc + n);
}

pub fn main() -> i32 {
    return sumTo(10, 0);
}

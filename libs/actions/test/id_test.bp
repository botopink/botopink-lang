//// actions: the action id — one derivation, one grammar. Every expected id is
//// a literal: HMAC-SHA256 computed outside botopink, its first 24 hex digits.

import {testing.asserts} from "std";
import {id.deriveActionId, id.isActionId};

test "actions: deriveActionId answers the known ids" {
    val secret = "front-24-secret-0123456789abcdef-xyz";
    try asserts.equals(
        deriveActionId(secret, "app@posts", "createPost", "build-1"),
        "a_1f7ded7ad117eb73ab9a64cb",
    );
    try asserts.equals(
        deriveActionId(secret, "app@posts", "createPost", "build-2"),
        "a_951418c3db66e2d87d663354",
    );
    try asserts.equals(
        deriveActionId(secret, "app@drafts", "createPost", "build-1"),
        "a_63647b0b25484f747af69779",
    );
    try asserts.equals(
        deriveActionId("secret", "m", "n", "b"),
        "a_ccf78b4ab7f4c87e5ff12b67",
    );
    try asserts.equals(
        deriveActionId("", "", "", ""),
        "a_f4353572c2223967241d00d9",
    );
    try asserts.equals(
        deriveActionId("k", "jhonstart@forms", "save", ""),
        "a_0174bcda47d0e03827622866",
    );
}

test "actions: a derived id is an action id" {
    assert isActionId(
        deriveActionId("s", "app@posts", "createPost", "build-1"),
    );
    assert isActionId(deriveActionId("", "", "", ""));
}

test "actions: isActionId accepts a_ and 24 lowercase hex digits" {
    assert isActionId("a_1f7ded7ad117eb73ab9a64cb");
    assert isActionId("a_000000000000000000000000");
    assert isActionId("a_ffffffffffffffffffffffff");
}

test "actions: isActionId refuses 23 and 25 digits, uppercase and the empty suffix" {
    assert isActionId("a_1f7ded7ad117eb73ab9a64c") == false;
    assert isActionId("a_1f7ded7ad117eb73ab9a64cb0") == false;
    assert isActionId("a_1F7DED7AD117EB73AB9A64CB") == false;
    assert isActionId("a_1f7ded7ad117eb73ab9a64cB") == false;
    assert isActionId("a_") == false;
    assert isActionId("") == false;
}

test "actions: isActionId refuses another prefix and a non-hex digit" {
    assert isActionId("b_1f7ded7ad117eb73ab9a64cb") == false;
    assert isActionId("A_1f7ded7ad117eb73ab9a64cb") == false;
    assert isActionId("a-1f7ded7ad117eb73ab9a64cb") == false;
    assert isActionId("a_1f7ded7ad117eb73ab9a64cg") == false;
    assert isActionId("a_1f7ded7ad117eb73ab9a64/b") == false;
    assert isActionId("a_1f7ded7ad117eb73ab9a6 cb") == false;
    assert isActionId("a_9f2c1b7e") == false;
    assert isActionId("a_1") == false;
    assert isActionId("a_<script>") == false;
}

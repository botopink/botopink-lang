//// actions/id — the action id: one derivation and one grammar.
////
//// An id is `a_` followed by the first 24 hex digits of
//// `hash.hmacSha256(secret, module + "." + name + ":" + buildId)`: stable for a
//// build, not guessable from the name. The server derives it with
//// `deriveActionId`; whoever only carries an id (a form) checks its shape with
//// `isActionId`, the same grammar the derivation writes. The secret is a
//// parameter — this package reads no configuration.
////
//// `deriveActionId`, not `actionId`: a framework exports an `actionId` of its
//// own (decision 163, `103-a`).

import {hash} from "std";

// The id of action `name` declared in `module`, for the build `buildId`.
// std's `hmacSha256` answers lowercase hex on both targets, so the id is
// always an `isActionId`.
pub fn deriveActionId(
    secret: string,
    module: string,
    name: string,
    buildId: string,
) -> string {
    val mac = hash.hmacSha256(secret, module + "." + name + ":" + buildId);
    return "a_" + mac.slice(0, 24);
}

// True when `id` is `a_` followed by exactly 24 lowercase hex digits.
pub fn isActionId(id: string) -> bool {
    var ok = id.length() == 26 && id.startsWith("a_");
    var i = 2;
    while (i < 26) {
        if ("0123456789abcdef".contains(id.at(i).unwrapOr("x")) == false)
            ok = false;
        i = i + 1;
    }
    return ok;
}

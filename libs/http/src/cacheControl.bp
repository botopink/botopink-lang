//// http/cacheControl — a `Cache-Control` response value, built (RFC 9111
//// § 5.2.2).
////
//// Start from `directives()` (nothing set), add with the `with*` functions,
//// write with `render`. `render` writes the directives in ONE order —
//// `public` / `private`, `no-store`, `no-cache`, `max-age`, `s-maxage`,
//// `must-revalidate`, `proxy-revalidate`, `no-transform`, `immutable` (RFC
//// 8246) — joined by `, `, so two builders that set the same directives
//// write the same bytes. Contradictions raise rather than reach a cache:
//// `public` with `private`, a negative age, `immutable` without a
//// `max-age` to be immutable for, `no-store` with anything that keeps a copy
//// (`public`, `max-age`, `s-maxage`, `immutable`).

pub type CacheDirectives(
    scope: string,
    maxAge: ?i32,
    sharedMaxAge: ?i32,
    noStore: bool,
    noCache: bool,
    mustRevalidate: bool,
    proxyRevalidate: bool,
    noTransform: bool,
    immutable: bool,
)

pub fn directives() -> CacheDirectives {
    return CacheDirectives(
        scope: "",
        maxAge: null,
        sharedMaxAge: null,
        noStore: false,
        noCache: false,
        mustRevalidate: false,
        proxyRevalidate: false,
        noTransform: false,
        immutable: false,
    );
}

fn problem(what: string) -> string {
    return "http.cacheControl: " + what;
}

fn withScope(d: CacheDirectives, scope: string) -> CacheDirectives {
    if ((d.scope != "") && (d.scope != scope))
        @panic(problem("a response is public or private, not both"));
    return CacheDirectives(
        scope: scope,
        maxAge: d.maxAge,
        sharedMaxAge: d.sharedMaxAge,
        noStore: d.noStore,
        noCache: d.noCache,
        mustRevalidate: d.mustRevalidate,
        proxyRevalidate: d.proxyRevalidate,
        noTransform: d.noTransform,
        immutable: d.immutable,
    );
}

pub fn withPublic(d: CacheDirectives) -> CacheDirectives {
    return withScope(d, "public");
}

pub fn withPrivate(d: CacheDirectives) -> CacheDirectives {
    return withScope(d, "private");
}

fn demandAge(seconds: i32, name: string) -> i32 {
    if (seconds < 0)
        @panic(problem(name + " is a number of seconds, 0 or more"));
    return seconds;
}

pub fn withMaxAge(d: CacheDirectives, seconds: i32) -> CacheDirectives {
    return CacheDirectives(
        scope: d.scope,
        maxAge: demandAge(seconds, "max-age"),
        sharedMaxAge: d.sharedMaxAge,
        noStore: d.noStore,
        noCache: d.noCache,
        mustRevalidate: d.mustRevalidate,
        proxyRevalidate: d.proxyRevalidate,
        noTransform: d.noTransform,
        immutable: d.immutable,
    );
}

pub fn withSharedMaxAge(d: CacheDirectives, seconds: i32) -> CacheDirectives {
    return CacheDirectives(
        scope: d.scope,
        maxAge: d.maxAge,
        sharedMaxAge: demandAge(seconds, "s-maxage"),
        noStore: d.noStore,
        noCache: d.noCache,
        mustRevalidate: d.mustRevalidate,
        proxyRevalidate: d.proxyRevalidate,
        noTransform: d.noTransform,
        immutable: d.immutable,
    );
}

// The boolean directives, by flag. Internal: the five `with*` below name one
// each.
fn withFlags(
    d: CacheDirectives,
    noStore: bool,
    noCache: bool,
    mustRevalidate: bool,
    proxyRevalidate: bool,
    noTransform: bool,
    immutable: bool,
) -> CacheDirectives {
    return CacheDirectives(
        scope: d.scope,
        maxAge: d.maxAge,
        sharedMaxAge: d.sharedMaxAge,
        noStore: d.noStore || noStore,
        noCache: d.noCache || noCache,
        mustRevalidate: d.mustRevalidate || mustRevalidate,
        proxyRevalidate: d.proxyRevalidate || proxyRevalidate,
        noTransform: d.noTransform || noTransform,
        immutable: d.immutable || immutable,
    );
}

pub fn withNoStore(d: CacheDirectives) -> CacheDirectives {
    return withFlags(d, true, false, false, false, false, false);
}

pub fn withNoCache(d: CacheDirectives) -> CacheDirectives {
    return withFlags(d, false, true, false, false, false, false);
}

pub fn withMustRevalidate(d: CacheDirectives) -> CacheDirectives {
    return withFlags(d, false, false, true, false, false, false);
}

pub fn withProxyRevalidate(d: CacheDirectives) -> CacheDirectives {
    return withFlags(d, false, false, false, true, false, false);
}

pub fn withNoTransform(d: CacheDirectives) -> CacheDirectives {
    return withFlags(d, false, false, false, false, true, false);
}

pub fn withImmutable(d: CacheDirectives) -> CacheDirectives {
    return withFlags(d, false, false, false, false, false, true);
}

// The field value; `""` when nothing is set (send no header).
pub fn render(d: CacheDirectives) -> string {
    val keeps = (d.scope == "public")
        || (d.maxAge != null)
        || (d.sharedMaxAge != null)
        || d.immutable;
    if (d.noStore && keeps)
        @panic(
            problem(
                "no-store forbids storing - it takes no public, max-age, s-maxage or immutable",
            ),
        );
    if (d.immutable && (d.maxAge == null))
        @panic(problem("immutable needs a max-age to be immutable for"));
    var parts: Array<string> = [];
    if (d.scope != "") parts.push(d.scope);
    if (d.noStore) parts.push("no-store");
    if (d.noCache) parts.push("no-cache");
    val maxAge: ?i32 = d.maxAge;
    if (maxAge != null) parts.push("max-age=" + (maxAge ?? 0).toString());
    val shared: ?i32 = d.sharedMaxAge;
    if (shared != null) parts.push("s-maxage=" + (shared ?? 0).toString());
    if (d.mustRevalidate) parts.push("must-revalidate");
    if (d.proxyRevalidate) parts.push("proxy-revalidate");
    if (d.noTransform) parts.push("no-transform");
    if (d.immutable) parts.push("immutable");
    return parts.join(", ");
}

// The policy of a static file: `no-cache` (store, but revalidate every use)
// for an age of 0 or less, else `public, max-age=<age>` with `, immutable`
// when the file's name changes with its content.
pub fn staticFile(maxAge: i32, immutable: bool) -> string {
    if (maxAge <= 0) return render(withNoCache(directives()));
    val cached = withMaxAge(withPublic(directives()), maxAge);
    return render(if (immutable) withImmutable(cached) else cached);
}

//// http/byteRange — a `Range: bytes=…` request against a representation
//// size (RFC 9110 § 14).
////
//// One range only. The answer is the status the server sends:
////
//// - 206 with `first`..`last` (inclusive, `last` clamped to `size - 1`) for a
////   satisfiable `first-last`, `first-` or `-suffix`;
//// - 416 when the one range is syntactically valid but starts at or past the
////   end (`first >= size`), or is the suffix `-0`, or the representation is
////   empty;
//// - 200 — ignore the header and send the whole representation — for no
////   header, a unit other than `bytes` (§ 14.2: a range unit the server does
////   not understand is ignored), a range set of more than one range (§ 14.2
////   lets a server ignore `Range`; a multipart/byteranges body is not built),
////   and anything that does not parse: whitespace inside the range, a sign,
////   `last < first`, a number beyond 2^53 - 1.
////
//// Sizes and offsets are `i64` — a file larger than 2 GiB is an ordinary
//// file.

import {isDigits, sub, wide} from "lexical";

pub type ByteRange(status: i32, first: i64, last: i64)

fn whole() -> ByteRange {
    return ByteRange(status: 200, first: wide(0 - 1), last: wide(0 - 1));
}

fn unsatisfiable() -> ByteRange {
    return ByteRange(status: 416, first: wide(0 - 1), last: wide(0 - 1));
}

// The value of a run of digits, or -1 when it is not one or is beyond 2^53 - 1.
fn offsetOf(digits: string) -> i64 {
    if (isDigits(digits) == false) return wide(0 - 1);
    return case digits.parseInt() {
        Ok(n) -> n;
        Error(_) -> wide(0 - 1);
    };
}

fn minOf(a: i64, b: i64) -> i64 {
    return if (a < b) a else b;
}

fn maxOf(a: i64, b: i64) -> i64 {
    return if (a > b) a else b;
}

pub fn parseRange(header: string, size: i64) -> ByteRange {
    val h = header.trim();
    if (h.toLower().startsWith("bytes=") == false) return whole();
    val spec = sub(h, 6, h.length());
    if (spec.indexOf(",") >= 0) return whole();
    val dash = spec.indexOf("-");
    if (dash < 0) return whole();
    val a = sub(spec, 0, dash);
    val b = sub(spec, dash + 1, spec.length());
    val zero = wide(0);
    val one = wide(1);
    if (a == "") {
        val n = offsetOf(b);
        if (n < zero) return whole();
        if ((n == zero) || (size == zero)) return unsatisfiable();
        return ByteRange(
            status: 206,
            first: maxOf(zero, size - n),
            last: size - one,
        );
    }
    val first = offsetOf(a);
    if (first < zero) return whole();
    val last = if (b == "") size - one else offsetOf(b);
    if ((b != "") && (last < zero)) return whole();
    if ((b != "") && (last < first)) return whole();
    if (first >= size) return unsatisfiable();
    return ByteRange(status: 206, first: first, last: minOf(last, size - one));
}

// The `Content-Range` of an answer: `bytes 0-499/1234` for 206,
// `bytes */1234` for 416, `""` for 200.
pub fn contentRange(r: ByteRange, size: i64) -> string {
    return if (r.status == 206)
        "bytes "
            + r.first.toString()
            + "-"
            + r.last.toString()
            + "/"
            + size.toString()
    else if (r.status == 416)
        "bytes */" + size.toString()
    else
        "";
}

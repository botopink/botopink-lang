//// http/mime — the one extension → media-type table.
////
//// By extension, case-insensitively, never by sniffing the bytes. A text type
//// carries `; charset=utf-8`, every other type none. An unknown extension is
//// `application/octet-stream` — the type that asks a browser to download
//// rather than render, so an unlisted file is never executed as a guess.

import {lexical.sub};

// The extension `pathOrExt` names, lowercase and without the dot: the text
// after the last `.` of its last `/` segment (`a/b.min.JS` → `js`,
// `.png` → `png`), or the whole segment when it has no `.` (`png` → `png`,
// `README` → `readme`).
pub fn extensionOf(pathOrExt: string) -> string {
    val pieces = pathOrExt.split("/");
    val name = pieces.at(pieces.length - 1).unwrapOr("");
    val parts = name.split(".");
    return parts.at(parts.length - 1).unwrapOr("").toLower();
}

fn mediaTypeOf(ext: string) -> string {
    return if ((ext == "html") || (ext == "htm"))
        "text/html"
    else if (ext == "css")
        "text/css"
    else if ((ext == "js") || (ext == "mjs"))
        "text/javascript"
    else if (ext == "txt")
        "text/plain"
    else if ((ext == "json") || (ext == "map"))
        "application/json"
    else if (ext == "xml")
        "application/xml"
    else if (ext == "svg")
        "image/svg+xml"
    else if (ext == "png")
        "image/png"
    else if ((ext == "jpg") || (ext == "jpeg"))
        "image/jpeg"
    else if (ext == "gif")
        "image/gif"
    else if (ext == "webp")
        "image/webp"
    else if (ext == "avif")
        "image/avif"
    else if (ext == "ico")
        "image/x-icon"
    else if (ext == "woff")
        "font/woff"
    else if (ext == "woff2")
        "font/woff2"
    else if (ext == "wasm")
        "application/wasm"
    else if (ext == "pdf")
        "application/pdf"
    else
        "application/octet-stream";
}

// The `Content-Type` of a path or an extension: `index.html` →
// `text/html; charset=utf-8`, `logo.PNG` → `image/png`, `x.bin` →
// `application/octet-stream`.
pub fn contentTypeOf(pathOrExt: string) -> string {
    val media = mediaTypeOf(extensionOf(pathOrExt));
    return if (isText(media)) media + "; charset=utf-8" else media;
}

// True for a `text/*` media type (parameters and case ignored) — the types
// that carry a charset.
pub fn isText(mediaType: string) -> bool {
    val semi = mediaType.indexOf(";");
    val base = if (semi < 0) mediaType else sub(mediaType, 0, semi);
    return base.trim().toLower().startsWith("text/");
}

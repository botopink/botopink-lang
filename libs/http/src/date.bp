//// http/date — HTTP-date (RFC 9110 § 5.6.7), in epoch milliseconds.
////
//// `formatHttpDate` writes the one form a sender generates, IMF-fixdate
//// (`Sun, 06 Nov 1994 08:49:37 GMT`), over std's UTC `clock.toCivil`.
//// `parseHttpDate` reads the three forms a recipient accepts — IMF-fixdate,
//// the obsolete RFC 850 form (`Sunday, 06-Nov-94 08:49:37 GMT`) and asctime
//// (`Sun Nov  6 08:49:37 1994`) — exactly as the grammar spells them:
//// case-sensitive names, fixed widths and single spaces, `GMT`, a real
//// calendar day, and a day name that agrees with the date. Anything else is
//// an `Error` naming the text; a validator a server cannot read is ignored by
//// its caller, never guessed at. The epoch is computed in botopink (a
//// days-from-civil count, no bitwise operator), so both targets answer the
//// same instant.

import {io.clock} from "std";
import {lexical.charOf, lexical.sub, lexical.isDigits, lexical.digitsValue, lexical.padded, lexical.idiv, lexical.wide};

fn dayNames() -> Array<string> {
    return ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
}

fn longDayNames() -> Array<string> {
    return [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
    ];
}

fn monthNames() -> Array<string> {
    return [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec",
    ];
}

// ── writing ─────────────────────────────────────────────────────────────────

// IMF-fixdate of an epoch reading, truncated to the second. A year outside
// 0000–9999 has no four-digit spelling and raises.
pub fn formatHttpDate(epochMillis: i64) -> string {
    val c = clock.toCivil(epochMillis);
    if ((c.year < 0) || (c.year > 9999))
        @panic(
            "http.date: year "
                + c.year.toString()
                + " has no IMF-fixdate spelling",
        );
    return [
        dayNames().at(c.weekday - 1).unwrapOr(""),
        ", ",
        padded(c.day, 2),
        " ",
        monthNames().at(c.month - 1).unwrapOr(""),
        " ",
        padded(c.year, 4),
        " ",
        padded(c.hour, 2),
        ":",
        padded(c.minute, 2),
        ":",
        padded(c.second, 2),
        " GMT",
    ].join("");
}

// ── the calendar ────────────────────────────────────────────────────────────

fn isLeap(y: i32) -> bool {
    return ((y % 4 == 0) && (y % 100 != 0)) || (y % 400 == 0);
}

fn daysInMonth(y: i32, m: i32) -> i32 {
    if (m == 2) return if (isLeap(y)) 29 else 28;
    return if ((m == 4) || (m == 6) || (m == 9) || (m == 11)) 30 else 31;
}

// Days from 1970-01-01 to the civil date (H. Hinnant's days_from_civil),
// for a year of 0 or more.
fn daysFromCivil(y: i32, m: i32, d: i32) -> i32 {
    val ya = if (m <= 2) y - 1 else y;
    val era = if (ya >= 0) idiv(ya, 400) else idiv(ya - 399, 400);
    val yoe = ya - era * 400;
    val mp = if (m > 2) m - 3 else m + 9;
    val doy = idiv(153 * mp + 2, 5) + d - 1;
    val doe = yoe * 365 + idiv(yoe, 4) - idiv(yoe, 100) + doy;
    return era * 146097 + doe - 719468;
}

// ISO weekday (Monday = 1) of a day count from the epoch (a Thursday).
fn weekdayOf(days: i32) -> i32 {
    return ((days % 7) + 7 + 3) % 7 + 1;
}

// ── reading ─────────────────────────────────────────────────────────────────

// The pieces of one parsed form; `problem` is `""` when they are well-formed.
type Fields(
    dayName: string,
    long: bool,
    year: i32,
    month: i32,
    day: i32,
    time: string,
    problem: string,
)

fn bad(what: string) -> Fields {
    return Fields(
        dayName: "",
        long: false,
        year: 0,
        month: 0,
        day: 0,
        time: "",
        problem: what,
    );
}

fn monthOf(name: string) -> i32 {
    return monthNames().indexOf(name) + 1;
}

fn twoDigits(s: string) -> i32 {
    return if (isDigits(s) && (s.length() == 2)) digitsValue(s) else 0 - 1;
}

fn oneDigit(s: string) -> i32 {
    return if (isDigits(s) && (s.length() == 1)) digitsValue(s) else 0 - 1;
}

// `Sun, 06 Nov 1994 08:49:37 GMT`
fn imfFixdate(t: string) -> Fields {
    if (t.length() != 29) return bad("is not an IMF-fixdate");
    val shapeOk = (charOf(t, 3) == ",")
        && (charOf(t, 4) == " ")
        && (charOf(t, 7) == " ")
        && (charOf(t, 11) == " ")
        && (charOf(t, 16) == " ")
        && (sub(t, 25, 29) == " GMT");
    val year = sub(t, 12, 16);
    if ((shapeOk == false) || (isDigits(year) == false))
        return bad("is not an IMF-fixdate");
    return Fields(
        dayName: sub(t, 0, 3),
        long: false,
        year: digitsValue(year),
        month: monthOf(sub(t, 8, 11)),
        day: twoDigits(sub(t, 5, 7)),
        time: sub(t, 17, 25),
        problem: "",
    );
}

// `Sunday, 06-Nov-94 08:49:37 GMT` — the two-digit year read by RFC 9110
// § 5.6.7: in the century of `nowYear`, or the one before when that is more
// than 50 years ahead of `nowYear`.
fn rfc850(t: string, nowYear: i32) -> Fields {
    val comma = t.indexOf(", ");
    if (comma < 0) return bad("is not an RFC 850 date");
    val rest = sub(t, comma + 2, t.length());
    val shapeOk = (rest.length() == 22)
        && (charOf(rest, 2) == "-")
        && (charOf(rest, 6) == "-")
        && (charOf(rest, 9) == " ")
        && (sub(rest, 18, 22) == " GMT");
    val yy = twoDigits(sub(rest, 7, 9));
    if ((shapeOk == false) || (yy < 0)) return bad("is not an RFC 850 date");
    val inCentury = nowYear - nowYear % 100 + yy;
    val year = if (inCentury > nowYear + 50) inCentury - 100 else inCentury;
    return Fields(
        dayName: sub(t, 0, comma),
        long: true,
        year: year,
        month: monthOf(sub(rest, 3, 6)),
        day: twoDigits(sub(rest, 0, 2)),
        time: sub(rest, 10, 18),
        problem: "",
    );
}

// `Sun Nov  6 08:49:37 1994` — the day is two digits or a space and one.
fn asctime(t: string) -> Fields {
    if (t.length() != 24) return bad("is not an asctime date");
    val shapeOk = (charOf(t, 3) == " ")
        && (charOf(t, 7) == " ")
        && (charOf(t, 10) == " ")
        && (charOf(t, 19) == " ");
    val dayText = sub(t, 8, 10);
    val day = if (charOf(dayText, 0) == " ")
        oneDigit(charOf(dayText, 1))
    else
        twoDigits(dayText);
    val year = sub(t, 20, 24);
    if ((shapeOk == false) || (isDigits(year) == false))
        return bad("is not an asctime date");
    return Fields(
        dayName: sub(t, 0, 3),
        long: false,
        year: digitsValue(year),
        month: monthOf(sub(t, 4, 7)),
        day: day,
        time: sub(t, 11, 19),
        problem: "",
    );
}

fn formOf(t: string, nowYear: i32) -> Fields {
    return if (charOf(t, 3) == ",")
        imfFixdate(t)
    else if (charOf(t, 3) == " ")
        asctime(t)
    else
        rfc850(t, nowYear);
}

fn problemText(text: string, what: string) -> string {
    return "http.parseHttpDate: \"" + text + "\" " + what;
}

// The epoch milliseconds an HTTP-date names. `nowMillis` is only read for an
// RFC 850 date's two-digit year, so the function stays pure — a caller passes
// `clock.nowMillis()`.
pub fn parseHttpDate(text: string, nowMillis: i64) -> @Result<i64, string> {
    val t = text.trim();
    val f = formOf(t, clock.toCivil(nowMillis).year);
    if (f.problem != "") throw problemText(text, f.problem);
    val time = f.time;
    val timeOk = (charOf(time, 2) == ":") && (charOf(time, 5) == ":");
    val h = twoDigits(sub(time, 0, 2));
    val mi = twoDigits(sub(time, 3, 5));
    val s = twoDigits(sub(time, 6, 8));
    val clockOk = timeOk
        && (h >= 0)
        && (h <= 23)
        && (mi >= 0)
        && (mi <= 59)
        && (s >= 0)
        && (s <= 60);
    if (clockOk == false) throw problemText(text, "has no valid time of day");
    if (f.month < 1) throw problemText(text, "has no valid month name");
    val dayOk = (f.day >= 1) && (f.day <= daysInMonth(f.year, f.month));
    if (dayOk == false)
        throw problemText(text, "names a day its month does not have");
    val days = daysFromCivil(f.year, f.month, f.day);
    val names = if (f.long) longDayNames() else dayNames();
    val expected = names.at(weekdayOf(days) - 1).unwrapOr("");
    if (f.dayName != expected)
        throw problemText(text, "names the wrong day of the week");
    val seconds = wide(days) * wide(86400) + wide(h * 3600 + mi * 60 + s);
    return seconds * wide(1000);
}

//// routing/pattern — the `:param` path grammar (decision 116 rule 9).
////
//// A pattern is `/`-separated segments, each one of: a literal, `:param`
//// (captures exactly one path segment) or a trailing `:param*` (captures the
//// rest of the path, including nothing). Every other form — a glob `*`, a
//// character class `[`, a group `(`, `?`, `{` — is refused by name with
//// `patternProblem`, not given a guessed meaning; `:param*` anywhere but last
//// is refused too. A pattern and a path match when every literal is equal and
//// the segment counts agree (a `:param*` absorbs the surplus). Captured values
//// are the raw path text — decoding is the caller's.
////
//// The empty pattern parses to no segments and matches only `/`; a caller
//// whose "no pattern" means "every path" says so itself.

pub type PatternSegment {
    Literal(text: string),
    Param(name: string),
    Rest(name: string),
}

fn charOf(s: string, i: i32) -> string {
    return s.at(i).unwrapOr("");
}

fn sub(s: string, begin: i32, end: i32) -> string {
    var out = "";
    var i = begin;
    val stop = if (end > s.length()) s.length() else end;
    while (i < stop) {
        out = out + charOf(s, i);
        i = i + 1;
    };
    return out;
}

fn segments(path: string) -> string[] {
    var out: string[] = [];
    for (path.split("/")) { s ->
        if (s != "") out.push(s);
    };
    return out;
}

pub fn patternProblem(pattern: string, segment: string) -> string {
    return "routing: the pattern `"
        + pattern
        + "` uses `"
        + segment
        + "`, which the `:param` grammar does not have - a pattern is literal segments, `:param` and a trailing `:param*`; a glob, a character class, a group, `?` and `{` are refused";
}

fn isRest(seg: string) -> bool {
    return (seg.startsWith(":") && seg.endsWith("*"));
}

// True when `seg` is none of: a literal free of `*([?{`, `:name`, `:name*`.
fn unsupported(seg: string) -> bool {
    val body = if (isRest(seg))
        sub(seg, 1, seg.length() - 1)
    else if (seg.startsWith(":"))
        sub(seg, 1, seg.length())
    else
        seg;
    val special = (body.contains("*") || body.contains("("))
        || ((body.contains("[") || body.contains("?"))
            || (body.contains("{") || body.contains(":")));
    return special || body == "";
}

// The first refusal for `pattern`, `""` when it parses.
fn problemOf(pattern: string) -> string {
    val segs = segments(pattern);
    var problem = "";
    var i = 0;
    while (i < segs.length) {
        val seg = segs.at(i).unwrapOr("");
        if (problem == "")
            if (unsupported(seg))
                problem = patternProblem(pattern, seg)
            else if ((isRest(seg) && i != segs.length - 1))
                problem = "routing: the pattern `"
                    + pattern
                    + "` has `"
                    + seg
                    + "` before its last segment - a `:param*` captures the rest of the path and must be last";
        i = i + 1;
    };
    return problem;
}

fn segmentOf(seg: string) -> PatternSegment {
    if (isRest(seg))
        return PatternSegment.Rest(name: sub(seg, 1, seg.length() - 1))
    else if (seg.startsWith(":"))
        return PatternSegment.Param(name: sub(seg, 1, seg.length()))
    else
        return PatternSegment.Literal(text: seg);
}

pub fn parsePattern(pattern: string) -> @Result<Array<PatternSegment>, string> {
    val problem = problemOf(pattern);
    if (problem != "") throw problem;
    return segments(pattern).map({ seg -> segmentOf(seg) });
}

// `L`, `P` or `R`, and the literal text or the parameter name.
fn kindOf(p: PatternSegment) -> string {
    return case p {
        Literal(text) -> "L";
        Param(name) -> "P";
        Rest(name) -> "R";
    };
}

fn textOf(p: PatternSegment) -> string {
    return case p {
        Literal(text) -> text;
        Param(name) -> name;
        Rest(name) -> name;
    };
}

fn segAt(xs: Array<PatternSegment>, i: i32) -> PatternSegment {
    return xs.at(i).unwrapOr(PatternSegment.Literal(text: ""));
}

// The captures, in pattern order, when `path` matches; `null` otherwise.
pub fn matchPattern(
    pattern: Array<PatternSegment>,
    path: string,
) -> ?Array<#(string, string)> {
    val want = segments(path);
    var captures: Array<#(string, string)> = [];
    var ok = true;
    var tail = false;
    var i = 0;
    while (i < pattern.length) {
        val p = segAt(pattern, i);
        val kind = kindOf(p);
        val text = textOf(p);
        val got = want.at(i).unwrapOr("");
        val present = i < want.length;
        if (kind == "L") {
            if ((present == false || got != text)) ok = false;
        } else if (kind == "P") {
            if (present) captures.push(#(text, got)) else ok = false;
        } else {
            tail = true;
            val rest = if (present)
                want.slice(i, want.length).join("/")
            else
                "";
            captures.push(#(text, rest));
        };
        i = i + 1;
    };
    if (tail) {
        if (want.length < pattern.length - 1) ok = false;
    } else if (want.length != pattern.length) ok = false;
    if (ok) return captures else return null;
}

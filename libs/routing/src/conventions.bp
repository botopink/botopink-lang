//// routing/conventions — the app-file conventions: which file names in an app
//// tree are routing files, their kinds and wire letters, and the two conflicts
//// a tree can hold on its own.
////
//// Eight kinds, in the order they wrap a page, outermost first (decision 171):
//// `layout`, `template`, `error`, `loading`, `not-found`, `page`, then `default`
//// and `route`. A kind's file is `<kind>.bp`; its wire letter is `kindLetter`,
//// the inverse of `table.kindLabel` (decision 172).
////
//// Pure: `classify` takes the one path it is handed (decision 173) and never
//// reads a disk — walking the tree is the caller's.
////
//// LANGUAGE NOTES (measured): `String.slice` answers a byte range on erlang and
//// a UTF-16 range on commonJS, so every substring goes through the private
//// `charOf` / `sub` pair; every refusal text is ASCII.

import {segment.parseSegment, segment.kindName, segment.pathProblem, segment.parsePath, segment.patternOf, segment.slotOf};

// One routing file of an app tree: `authoredPath` is the path as handed in
// (what a diagnostic names); `segment` the app-relative directory, groups and
// slots kept (`(marketing)/about`, `""` for the root); `kind` one of
// `fileKinds()`.
pub type ConventionFile(
    authoredPath: string,
    segment: string,
    kind: string,
)

// The eight kinds, in wrap order (decision 171).
pub fn fileKinds() -> string[] {
    return [
        "layout",
        "template",
        "error",
        "loading",
        "not-found",
        "page",
        "default",
        "route",
    ];
}

// The kind of the file named `file` (`page.bp` → `page`), `null` when the name
// is not a convention.
pub fn kindOf(file: string) -> ?string {
    var found = "";
    for (fileKinds()) { k ->
        if (file == k + ".bp") found = k;
    }
    if (found == "") return null else return found;
}

// The route-table letter of a kind (`page` → `P`), `""` for anything else. The
// inverse of `table.kindLabel`.
pub fn kindLetter(kind: string) -> string {
    if (kind == "layout")
        return "L"
    else if (kind == "template")
        return "T"
    else if (kind == "page")
        return "P"
    else if (kind == "default")
        return "D"
    else if (kind == "route")
        return "R"
    else if (kind == "loading")
        return "S"
    else if (kind == "error")
        return "E"
    else if (kind == "not-found")
        return "N"
    else
        return "";
}

// The routing file at `path` under `appDir`, `null` when `path` is not one:
// outside `appDir`, not named after a convention, or inside a private `_folder`
// (which opts out with everything below it). The app directory is compared part
// by part — over ASCII exactly `path.startsWith(appDir + "/")`.
pub fn classify(appDir: string, path: string) -> ?ConventionFile {
    val base = appDir.split("/");
    val parts = path.split("/");
    var inside = parts.length > base.length;
    var i = 0;
    while (i < base.length) {
        if (base.at(i).unwrapOr("") != parts.at(i).unwrapOr("")) inside = false;
        i = i + 1;
    }
    if (inside == false) return null else {
        val file = parts.at(parts.length - 1).unwrapOr("");
        val kind = kindOf(file);
        var dirs: string[] = [];
        var hidden = false;
        var j = base.length;
        while (j < parts.length - 1) {
            val d = parts.at(j).unwrapOr("");
            if (d.startsWith("_")) hidden = true;
            dirs.push(d);
            j = j + 1;
        }
        if ((kind == null || hidden))
            return null
        else
            return ConventionFile(
                authoredPath: path,
                segment: dirs.join("/"),
                kind: kind ?? "",
            );
    }
}

// The refusals a tree's classified files hold on their own, in order: every
// segment holding both a `page` and a `route` (a segment is a page or an
// endpoint), then every URL two root route groups both claim with a `page`
// (two root layouts whose subtrees match one URL). A segment `pathProblem`
// refuses is skipped — that refusal is the caller's, one step up.
pub fn conventionConflicts(entries: Array<ConventionFile>) -> string[] {
    var problems: string[] = [];
    for (segmentsOf(entries)) { seg ->
        if ((holds(entries, seg, "page") && holds(entries, seg, "route")))
            problems.push(
                "routing: `"
                    + seg
                    + "` holds both page.bp and route.bp - a segment is a page or an endpoint, never both",
            );
    }
    var keys: string[] = [];
    var groups: string[] = [];
    for (segmentsOf(entries)) { seg ->
        if (holds(entries, seg, "page")) {
            val parsed = parsePath(seg);
            val pattern = patternOf(parsed);
            val key = pattern + "|" + slotOf(parsed);
            val group = rootGroupOf(seg);
            val prior = keys.indexOf(key);
            if (prior >= 0) {
                val priorGroup = groups.at(prior).unwrapOr("");
                if (priorGroup != group)
                    problems.push(
                        "routing: `"
                            + pattern
                            + "` is claimed by both `"
                            + priorGroup
                            + "` and `"
                            + group
                            + "` - two root layouts whose subtrees match one URL",
                    );
            }
            keys.push(key);
            groups.push(group);
        }
    }
    return problems;
}

// ── private ─────────────────────────────────────────────────────────────────

// The distinct registrable segments of `entries`, in first-seen order.
fn segmentsOf(entries: Array<ConventionFile>) -> string[] {
    var out: string[] = [];
    for (entries) { e ->
        if ((out.indexOf(e.segment) < 0 && pathProblem(e.segment) == ""))
            out.push(e.segment);
    }
    return out;
}

fn holds(entries: Array<ConventionFile>, seg: string, kind: string) -> bool {
    var found = false;
    for (entries) { e ->
        if ((e.segment == seg && e.kind == kind)) found = true;
    }
    return found;
}

// The top-level `(group)` a segment sits under, `""` when it sits under none.
fn rootGroupOf(seg: string) -> string {
    var head = "";
    var seen = false;
    for (seg.split("/")) { raw ->
        if ((seen == false && raw != "")) {
            head = raw;
            seen = true;
        }
    }
    if (kindName(parseSegment(head).kind) == "Group")
        return head
    else
        return "";
}

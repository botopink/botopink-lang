//// routing: the matcher — precedence, capture, the layout chain — on both
//// targets (moved with the matcher, decision 115).

import {parsePath, patternOf} from "segment";
import {RouteEntry} from "table";
import {matchPath, layoutChain, splitPath, attempt, paramOf} from "match";

// ── step 4: the matcher ─────────────────────────────────────────────────────

fn blogTable() -> RouteEntry[] {
    return [
        RouteEntry(kind: "L", pattern: "/", slot: "", verb: ""),
        RouteEntry(kind: "L", pattern: "/blog", slot: "", verb: ""),
        RouteEntry(kind: "L", pattern: "/blog/[slug]", slot: "", verb: ""),
        RouteEntry(kind: "P", pattern: "/blog/[slug]", slot: "", verb: ""),
    ];
}

test "routing: a dynamic segment binds its parameter" {
    val m = matchPath(blogTable(), "/blog/hello");
    var slug = "";
    var pattern = "";
    if (m) {
        hit ->
        slug = paramOf(hit, "slug");
        pattern = hit.entry.pattern;
    };
    assert pattern == "/blog/[slug]";
    assert slug == "hello";
}

test "routing: a catch-all binds the remainder and fills rest" {
    val table = [RouteEntry(kind: "P", pattern: "/shop/[...slug]", slot: "", verb: "")];
    val m = matchPath(table, "/shop/a/b");
    var slug = "";
    var rest: string[] = [];
    if (m) {
        hit ->
        slug = paramOf(hit, "slug");
        rest = hit.rest;
    };
    assert slug == "a/b";
    assert rest.length == 2;
    assert rest.at(0).unwrapOr("") == "a";
    assert rest.at(1).unwrapOr("") == "b";
}

test "routing: a required catch-all does not match its own bare prefix" {
    val table = [RouteEntry(kind: "P", pattern: "/shop/[...slug]", slot: "", verb: "")];
    var matched = true;
    if (matchPath(table, "/shop")) {
        _ ->
        matched = true;
    } else matched = false;
    assert matched.negate();
}

test "routing: an optional catch-all matches with and without a remainder" {
    val table = [RouteEntry(kind: "P", pattern: "/docs/[[...slug]]", slot: "", verb: "")];
    var bareRest = 0 - 1;
    if (matchPath(table, "/docs")) {
        hit ->
        bareRest = hit.rest.length;
    };
    assert bareRest == 0;
    var deep: string[] = [];
    if (matchPath(table, "/docs/a/b")) {
        hit ->
        deep = hit.rest;
    };
    assert deep.length == 2;
    assert deep.join("/") == "a/b";
}

test "routing: a static entry beats a dynamic one for the same URL" {
    val table = [
        RouteEntry(kind: "P", pattern: "/blog/[slug]", slot: "", verb: ""),
        RouteEntry(kind: "P", pattern: "/blog/new", slot: "", verb: ""),
    ];
    var pattern = "";
    if (matchPath(table, "/blog/new")) {
        hit ->
        pattern = hit.entry.pattern;
    };
    assert pattern == "/blog/new";
    var other = "";
    if (matchPath(table, "/blog/x")) {
        hit ->
        other = hit.entry.pattern;
    };
    assert other == "/blog/[slug]";
}

test "routing: a dynamic segment beats a catch-all at the same depth" {
    val table = [
        RouteEntry(kind: "P", pattern: "/shop/[...rest]", slot: "", verb: ""),
        RouteEntry(kind: "P", pattern: "/shop/[id]", slot: "", verb: ""),
    ];
    var pattern = "";
    if (matchPath(table, "/shop/7")) {
        hit ->
        pattern = hit.entry.pattern;
    };
    assert pattern == "/shop/[id]";
}

test "routing: registration order decides between two equal scores" {
    val table = [
        RouteEntry(kind: "P", pattern: "/x/[a]", slot: "", verb: ""),
        RouteEntry(kind: "P", pattern: "/x/[b]", slot: "", verb: ""),
    ];
    var name = "";
    if (matchPath(table, "/x/1")) {
        hit ->
        name = hit.entry.pattern;
    };
    assert name == "/x/[a]";
}

test "routing: a layout alone does not make a route public" {
    val table = [
        RouteEntry(kind: "L", pattern: "/", slot: "", verb: ""),
        RouteEntry(kind: "L", pattern: "/settings", slot: "", verb: ""),
    ];
    var matched = true;
    if (matchPath(table, "/settings")) {
        _ ->
        matched = true;
    } else matched = false;
    assert matched.negate();
    val withPage = [
        RouteEntry(kind: "L", pattern: "/settings", slot: "", verb: ""),
        RouteEntry(kind: "R", pattern: "/settings", slot: "", verb: "POST"),
    ];
    var kind = "";
    if (matchPath(withPage, "/settings")) {
        hit ->
        kind = hit.entry.kind;
    };
    assert kind == "R";
}

test "routing: a slot entry is not a candidate for a plain URL match" {
    val table = [
        RouteEntry(kind: "P", pattern: "/dashboard", slot: "team", verb: ""),
    ];
    var matched = true;
    if (matchPath(table, "/dashboard")) {
        _ ->
        matched = true;
    } else matched = false;
    assert matched.negate();
}

test "routing: the layout chain is root-first and skips what has no layout" {
    val chain = layoutChain(blogTable(), "/blog/[slug]");
    assert chain.length == 3;
    assert chain
        .at(0)
        .unwrapOr(RouteEntry(kind: "", pattern: "", slot: "", verb: "")).pattern == "/";
    assert chain
        .at(1)
        .unwrapOr(RouteEntry(kind: "", pattern: "", slot: "", verb: "")).pattern == "/blog";
    assert chain
        .at(2)
        .unwrapOr(RouteEntry(kind: "", pattern: "", slot: "", verb: "")).pattern == "/blog/[slug]";
    val sparse = [
        RouteEntry(kind: "L", pattern: "/", slot: "", verb: ""),
        RouteEntry(kind: "L", pattern: "/blog/[slug]", slot: "", verb: ""),
    ];
    assert layoutChain(sparse, "/blog/[slug]").length == 2;
}

test "routing: a group never reaches the chain because it is not in a pattern" {
    val pattern = patternOf(parsePath("(marketing)/about"));
    val table = [
        RouteEntry(kind: "L", pattern: "/", slot: "", verb: ""),
        RouteEntry(kind: "L", pattern: patternOf(parsePath("(marketing)")), slot: "", verb: ""),
        RouteEntry(kind: "P", pattern: pattern, slot: "", verb: ""),
    ];
    assert pattern == "/about";
    val chain = layoutChain(table, pattern);
    assert chain.length == 2;
    assert chain
        .at(0)
        .unwrapOr(RouteEntry(kind: "", pattern: "", slot: "", verb: "")).pattern == "/";
    assert chain
        .at(1)
        .unwrapOr(RouteEntry(kind: "", pattern: "", slot: "", verb: "")).pattern == "/";
    var found = "";
    if (matchPath(table, "/about")) {
        hit ->
        found = hit.entry.pattern;
    };
    assert found == "/about";
}

test "routing: a match carries its own layout chain" {
    var depth = 0;
    if (matchPath(blogTable(), "/blog/hello")) {
        hit ->
        depth = hit.chain.length;
    };
    assert depth == 3;
}

test "routing: splitPath and attempt are total on odd input" {
    assert splitPath("///").length == 0;
    assert splitPath("/a//b/").length == 2;
    assert attempt("/blog/[slug]", "/blog").ok.negate();
    assert attempt("/blog", "/blog/x").ok.negate();
    assert attempt("/", "/").ok;
}

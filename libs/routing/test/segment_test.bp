//// routing: the segment grammar, on both targets (moved with the matcher,
//// decision 115). Every expected text is a literal.

import {testing.asserts} from "std";
import {segment.parseSegment, segment.parsePath, segment.patternOf, segment.slotOf, segment.pathProblem, segment.kindName, segment.trimSlashes, segment.paramNamesOf, segment.fillPattern, segment.toColonPattern};

// ── step 1: the segment grammar ─────────────────────────────────────────────

test "routing: a static folder is a static segment" {
    val s = parseSegment("blog");
    assert kindName(s.kind) == "Static";
    assert s.name == "blog";
    assert s.raw == "blog";
}

test "routing: [slug] is a dynamic segment" {
    val s = parseSegment("[slug]");
    assert kindName(s.kind) == "Dynamic";
    assert s.name == "slug";
    assert s.raw == "[slug]";
}

test "routing: the catch-all and the optional catch-all are told apart" {
    val required = parseSegment("[...slug]");
    val optional = parseSegment("[[...slug]]");
    assert kindName(required.kind) == "CatchAll";
    assert required.name == "slug";
    assert kindName(optional.kind) == "OptionalCatchAll";
    assert optional.name == "slug";
    assert kindName(optional.kind) != kindName(required.kind);
    assert optional.raw != required.raw;
}

test "routing: a group, a slot and a private folder" {
    val g = parseSegment("(marketing)");
    assert kindName(g.kind) == "Group";
    assert g.name == "marketing";
    val s = parseSegment("@team");
    assert kindName(s.kind) == "Slot";
    assert s.name == "team";
    val p = parseSegment("_components");
    assert kindName(p.kind) == "Private";
    assert p.name == "components";
}

test "routing: a group contributes no URL segment" {
    assert patternOf(parsePath("(marketing)/about")) == "/about";
    assert patternOf(parsePath("")) == "/";
    assert patternOf(parsePath("blog")) == "/blog";
    assert patternOf(parsePath("blog/[slug]")) == "/blog/[slug]";
}

test "routing: a slot contributes no URL segment and names itself" {
    val segs = parsePath("dashboard/@team/settings");
    assert patternOf(segs) == "/dashboard/settings";
    assert slotOf(segs) == "team";
    assert slotOf(parsePath("dashboard/settings")) == "";
}

test "routing: a private folder may not appear on a registered path" {
    val problem = pathProblem("blog/_drafts/[slug]");
    assert problem != "";
    assert problem.contains("_drafts");
    assert pathProblem("blog/[slug]") == "";
}

test "routing: a `|` or a newline in a segment is refused by name" {
    val bar = pathProblem("blog/a|b");
    assert bar != "";
    assert bar.contains("a|b");
    val nl = pathProblem("blog/a\nb");
    assert nl != "";
    assert nl.contains("newline");
}

test "routing: a leading or trailing slash is not a segment" {
    assert trimSlashes("/blog/") == "blog";
    assert patternOf(parsePath("/blog/[slug]/")) == "/blog/[slug]";
}

test "routing: parsePath halts on a private folder, naming it" {
    try asserts.throwsWith({ ->
        parsePath("blog/_drafts/[slug]");
        0;
    }, "routing: `_drafts` in `blog/_drafts/[slug]` is a private folder");
}

test "routing: parsePath halts on a `|` in a segment, naming the segment" {
    try asserts.throwsWith({ ->
        parsePath("blog/a|b");
        0;
    }, "routing: segment `a|b` in `blog/a|b` holds a `|`");
}

// ── step 2: the segment helpers (front 102) ─────────────────────────────────

fn filled(pattern: string, bindings: Array<#(string, string)>) -> string {
    val r = fillPattern(pattern, bindings);
    val text = case r {
        Ok(p) -> p;
        Error(e) -> "<refused> " + e;
    };
    return text;
}

test "routing: paramNamesOf names a path's capturing segments in order" {
    try asserts.equals(paramNamesOf("blog/[slug]").join(","), "slug");
    try asserts.equals(
        paramNamesOf("shop/[cat]/[...rest]").join(","),
        "cat,rest",
    );
    try asserts.equals(paramNamesOf("docs/[[...path]]").join(","), "path");
    try asserts.equals(paramNamesOf("(group)/@slot/[id]/edit").join(","), "id");
    try asserts.equals(paramNamesOf("about").length, 0);
    try asserts.equals(paramNamesOf("").length, 0);
}

test "routing: paramNamesOf reads through parseSegment" {
    try asserts.equals(paramNamesOf("[a.b]").join(","), "a.b");
    try asserts.equals(paramNamesOf("blog/[x").length, 0);
}

test "routing: fillPattern fills every capturing segment" {
    try asserts.equals(
        filled("/blog/[slug]", [#("slug", "hello")]),
        "/blog/hello",
    );
    try asserts.equals(
        filled("/(marketing)/@team/[id]/edit", [#("id", "7")]),
        "/7/edit",
    );
    try asserts.equals(
        filled("/docs/[...path]", [#("path", "a/b/c")]),
        "/docs/a/b/c",
    );
    try asserts.equals(
        filled("/shop/[cat]/[[...rest]]", [#("cat", "toys"), #("rest", "x/y")]),
        "/shop/toys/x/y",
    );
    try asserts.equals(filled("/about", []), "/about");
    try asserts.equals(filled("/", []), "/");
}

test "routing: fillPattern accepts a missing or empty optional catch-all" {
    try asserts.equals(filled("/docs/[[...path]]", []), "/docs");
    try asserts.equals(filled("/docs/[[...path]]", [#("path", "")]), "/docs");
}

test "routing: fillPattern refuses a missing [x]" {
    try asserts.equals(
        filled("/blog/[slug]", []),
        "<refused> routing: a binding row for `/blog/[slug]` binds no `slug`",
    );
    try asserts.equals(
        filled("/docs/[...path]", []),
        "<refused> routing: a binding row for `/docs/[...path]` binds no `path`",
    );
}

test "routing: fillPattern refuses a slash, an empty value, an extra and a twice-bound name" {
    try asserts.equals(
        filled("/blog/[slug]", [#("slug", "a/b")]),
        "<refused> routing: `slug` of `/blog/[slug]` is bound to `a/b`, which holds a `/` - only a catch-all segment spans several",
    );
    try asserts.equals(
        filled("/blog/[slug]", [#("slug", "")]),
        "<refused> routing: `slug` of `/blog/[slug]` is bound to the empty string",
    );
    try asserts.equals(
        filled("/docs/[...path]", [#("path", "")]),
        "<refused> routing: `path` of `/docs/[...path]` is bound to the empty string",
    );
    try asserts.equals(
        filled("/blog/[slug]", [#("slug", "a"), #("extra", "b")]),
        "<refused> routing: a binding row for `/blog/[slug]` binds `extra`, which the pattern does not have",
    );
    try asserts.equals(
        filled("/blog/[slug]", [#("slug", "a"), #("slug", "b")]),
        "<refused> routing: a binding row for `/blog/[slug]` binds `slug` twice",
    );
}

test "routing: toColonPattern replaces only the outer bracket pair" {
    try asserts.equals(toColonPattern("[id]/[...rest]"), ":id/:...rest");
    try asserts.equals(toColonPattern("/posts/[id]"), "/posts/:id");
    try asserts.equals(toColonPattern("/docs/[[...path]]"), "/docs/:[...path]");
    try asserts.equals(toColonPattern("/about"), "/about");
    try asserts.equals(toColonPattern("/"), "/");
    try asserts.equals(toColonPattern(""), "");
    try asserts.equals(toColonPattern("/a/[x/b"), "/a/[x/b");
}

//// log — the five levels.
////
//// FIVE LEVELS, ranked: trace 0 · debug 1 · info 2 · warn 3 · error 4. A
//// spelling read from configuration ranks through `rankOf`, which also knows
//// `off` (5) — a threshold, never the level of a record. The mapping onto
//// OTP's eight severities is stated, not inferred (`otpLevel`): Trace and
//// Debug both become `debug`, so a sink that filters must filter on the rank
//// before the host call, as `LogSink.enabled` does.
////
//// Moved from rakun-logging's `levels.bp` (decision 195); the level
//// resolver over rakun's properties and groups stays rakun's.

pub type Level {
    Trace,
    Debug,
    Info,
    Warn,
    Error,
}

// The lowercase name: `trace`, `debug`, `info`, `warn`, `error`.
pub fn levelName(level: Level) -> string {
    val name = case level {
        Level.Trace -> "trace";
        Level.Debug -> "debug";
        Level.Info -> "info";
        Level.Warn -> "warn";
        Level.Error -> "error";
    };
    return name;
}

// Ranks: trace 0 · debug 1 · info 2 · warn 3 · error 4.
pub fn levelRank(level: Level) -> i32 {
    val rank = case level {
        Level.Trace -> 0;
        Level.Debug -> 1;
        Level.Info -> 2;
        Level.Warn -> 3;
        Level.Error -> 4;
    };
    return rank;
}

// The OTP `logger` severity a level is written at.
pub fn otpLevel(level: Level) -> string {
    val name = case level {
        Level.Trace -> "debug";
        Level.Debug -> "debug";
        Level.Info -> "info";
        Level.Warn -> "warning";
        Level.Error -> "error";
    };
    return name;
}

// The spellings `rankOf` accepts, for a diagnostic that lists them.
pub fn validLevels() -> string {
    return "trace, debug, info, warn, error, off";
}

// The rank a spelling names, `-1` for one that is not a level. `warning` is
// accepted as OTP's name for `warn`, `off` is 5, case and surrounding
// whitespace do not matter.
pub fn rankOf(raw: string) -> i32 {
    val v = raw.trim().toLower();
    if (v == "trace") return 0;
    if (v == "debug") return 1;
    if (v == "info") return 2;
    if (v == "warn" || v == "warning") return 3;
    if (v == "error") return 4;
    if (v == "off") return 5;
    return -1;
}

// The uppercase name of a rank, as the renderers write it; `OFF` for any rank
// that is not one of the five.
pub fn rankName(rank: i32) -> string {
    if (rank == 0) return "TRACE";
    if (rank == 1) return "DEBUG";
    if (rank == 2) return "INFO";
    if (rank == 3) return "WARN";
    if (rank == 4) return "ERROR";
    return "OFF";
}

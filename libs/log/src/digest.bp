//// log — the error digest: one scheme, one implementation (decision 194).
////
//// THE RULE: the digest is the only part of a server error that crosses to
//// the client. `Logger.logError` writes ONE error record holding the full
//// message, the class, the module and the frames, and answers the digest;
//// `clientErrorBody(digest)` is the whole payload a renderer may send.
////
//// THE SCHEME: the first 16 hex characters of std's `hash.strongHash` (SHA-256)
//// over `module|errorClass|message|topFrames`, where `topFrames` is the first
//// three whitespace-separated frames with line numbers (`:<digits>`) stripped.
//// Not in the input: the timestamp, the request id, the node, any argument
//// value — the digest names a FAULT, not an occurrence, so a thousand hits of
//// one bug are one digest on every node and every target of the build, and it
//// changes when the code does. Argument values travel as record FIELDS, which
//// the digest never reads.
////
//// Moved from rakun-logging's `digest.bp`; no library computes a digest any
//// other way.

import {hash, json} from "std";

fn isDigit(c: string) -> bool {
    return c != "" && "0123456789".indexOf(c) >= 0;
}

// `:<digits>` removed wherever it appears: `invoice.bp:42` → `invoice.bp`.
// A `:` not followed by a digit is kept.
pub fn stripLineNumbers(frame: string) -> string {
    val cs: string[] = frame.chars();
    var out = "";
    var i = 0;
    val n = cs.length;
    while (i < n) {
        val c = cs.at(i) ?? "";
        val next = cs.at(i + 1) ?? "";
        if (c == ":" && isDigit(next)) {
            var j = i + 1;
            while (j < n && isDigit(cs.at(j) ?? "")) {
                j = j + 1;
            }
            i = j;
        } else {
            out = out + c;
            i = i + 1;
        }
    }
    return out;
}

// The first three frames of `frames` (split on spaces, tabs and newlines),
// each with its line numbers stripped, joined by one space.
pub fn topFramesOf(frames: string) -> string {
    var kept: string[] = [];
    for (frames.replaceAll("\n", " ").replaceAll("\t", " ").split(" ")) { f ->
        val t = f.trim();
        if (t != "" && kept.length < 3) kept.push(stripLineNumbers(t));
    }
    return kept.join(" ");
}

// The text the digest hashes.
pub fn digestInput(
    module: string,
    errorClass: string,
    message: string,
    topFrames: string,
) -> string {
    return module
        + "|"
        + errorClass
        + "|"
        + message
        + "|"
        + topFramesOf(topFrames);
}

// 16 lowercase hex characters naming the fault.
pub fn errorDigest(
    module: string,
    errorClass: string,
    message: string,
    topFrames: string,
) -> string {
    return hash
        .strongHash(digestInput(module, errorClass, message, topFrames))
        .slice(0, 16);
}

// The payload a renderer hands the client for a server error: the digest and
// nothing else — `{"digest":"<digest>"}`.
pub fn clientErrorBody(digest: string) -> string {
    return "{\"digest\":" + json.quote(digest) + "}";
}

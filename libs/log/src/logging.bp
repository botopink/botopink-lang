//// log — the `Logger`.
////
//// One type, five levels, over the sink in force (`sink.bp`). The level check
//// is the sink's `enabled`, asked HERE before the record is built: a record
//// below the sink's threshold is dropped without its message being rendered
//// or the host being called. `isEnabled` exists so an expensive message is not
//// BUILT for a level that is off, and `lazily(level, build)` is the same guard
//// with the builder passed in. Every write answers what the sink's `write`
//// answered, 0 for a dropped record.
////
//// Fields are a list, never interpolated into the sentence: a structured log
//// whose values live inside the message is an unstructured log.
////
//// `logError` is the one way a fault reaches the log (decisions 194, 195): it
//// writes ONE error record — the full message, `error.module`, `error.type`,
//// `error.stack_trace` and the caller's fields, under `error.digest` — and
//// answers the digest, so the digest a fallback shows is the one on the log
//// line. jhonstart's error boundary calls it; there is no render hook.
////
//// The record's facts: `millis` from std `clock.nowMillis`, `pid` the OS
//// process id, `node` the host name, `thread` `main`; `app` and `trace` are
//// empty — a sink that knows an application name or a correlation id writes
//// its own record.

import {io.clock, io.os} from "std";
import {io.process as host} from "std";
import {Level} from "levels";
import {LogRecord} from "formats";
import {currentSink} from "sink";
import {errorDigest} from "digest";

fn none() -> Array<#(string, string)> {
    val empty: Array<#(string, string)> = [];
    return empty;
}

fn emitRecord(
    name: string,
    level: Level,
    message: string,
    fields: Array<#(string, string)>,
    digest: string,
) -> i32 {
    val sink = currentSink();
    val enabled = sink.enabled;
    if (enabled(name, level) == false) return 0;
    val rec = LogRecord(
        millis: clock.nowMillis(),
        level: level,
        logger: name,
        message: message,
        fields: fields,
        trace: "",
        digest: digest,
        pid: host.pid().toString(),
        node: os.hostname(),
        thread: "main",
        app: "",
    );
    val write = sink.write;
    return write(rec);
}

fn enabledFor(name: string, level: Level) -> bool {
    val sink = currentSink();
    val enabled = sink.enabled;
    return enabled(name, level);
}

pub type Logger(
    name: string,
) {
    pub fn trace(self: Self, message: string) -> i32 {
        return emitRecord(self.name, Level.Trace, message, none(), "");
    }

    pub fn traceWith(
        self: Self,
        message: string,
        fields: Array<#(string, string)>,
    ) -> i32 {
        return emitRecord(self.name, Level.Trace, message, fields, "");
    }

    pub fn debug(self: Self, message: string) -> i32 {
        return emitRecord(self.name, Level.Debug, message, none(), "");
    }

    pub fn debugWith(
        self: Self,
        message: string,
        fields: Array<#(string, string)>,
    ) -> i32 {
        return emitRecord(self.name, Level.Debug, message, fields, "");
    }

    pub fn info(self: Self, message: string) -> i32 {
        return emitRecord(self.name, Level.Info, message, none(), "");
    }

    pub fn infoWith(
        self: Self,
        message: string,
        fields: Array<#(string, string)>,
    ) -> i32 {
        return emitRecord(self.name, Level.Info, message, fields, "");
    }

    pub fn warn(self: Self, message: string) -> i32 {
        return emitRecord(self.name, Level.Warn, message, none(), "");
    }

    pub fn warnWith(
        self: Self,
        message: string,
        fields: Array<#(string, string)>,
    ) -> i32 {
        return emitRecord(self.name, Level.Warn, message, fields, "");
    }

    pub fn error(self: Self, message: string) -> i32 {
        return emitRecord(self.name, Level.Error, message, none(), "");
    }

    pub fn errorWith(
        self: Self,
        message: string,
        fields: Array<#(string, string)>,
    ) -> i32 {
        return emitRecord(self.name, Level.Error, message, fields, "");
    }

    pub fn log(
        self: Self,
        level: Level,
        message: string,
        fields: Array<#(string, string)>,
    ) -> i32 {
        return emitRecord(self.name, level, message, fields, "");
    }

    pub fn isEnabled(self: Self, level: Level) -> bool {
        return enabledFor(self.name, level);
    }

    // `build` runs only when `level` is on for this logger.
    pub fn lazily(self: Self, level: Level, build: fn() -> string) -> i32 {
        if (enabledFor(self.name, level) == false) return 0;
        return emitRecord(self.name, level, build(), none(), "");
    }

    // Write one error record for the fault and answer its digest
    // (`errorDigest(module, errorClass, message, topFrames)`). The record holds
    // the full message and the frames as written; `fields` follow
    // `error.module`, `error.type` and `error.stack_trace`, and the digest never
    // reads them. The digest is answered whether or not the sink takes errors.
    pub fn logError(
        self: Self,
        module: string,
        errorClass: string,
        message: string,
        topFrames: string,
        fields: Array<#(string, string)>,
    ) -> string {
        val digest = errorDigest(module, errorClass, message, topFrames);
        var all: Array<#(string, string)> = [
            #("error.module", module),
            #("error.type", errorClass),
            #("error.stack_trace", topFrames),
        ];
        for (fields) { f ->
            all.push(f);
        }
        val _w = emitRecord(self.name, Level.Error, message, all, digest);
        return digest;
    }
}

//// std's `Type` (decisions 307, 308) — the derived types: a compile-time
//// function answers a NEW record type, bound by a module-level `val` and
//// named after it (`pub val RecipePatch = Type.partial(Recipe);`), nominal,
//// usable in every type position, exported and imported like any type, and
//// annotatable (`#[validated] pub val RecipePatch = Type.partial(Recipe);`);
//// the source fields' markers come with them. A plain alias
//// (`type Id = i32`) stays transparent.
////
//// Every function here runs only at compile time and takes every parameter
//// `comptime`, so a call needs no `comptime` keyword. The bodies are the
//// compiler's: bodyless, without `#[@External.<Target>]`, because no target
//// runs them — the checker answers the call (`01-checker` step 28 keys its
//// resolver on these declarations).
////
//// `Type` is a namespace type (decision 329): no field list, no value, every
//// function associated. `Field<T>` is declared in its body, so it is its
//// associated type `Type.Field<T>` (decision 330 (7)).
////
//// Still to be declared here, blocked on the language spelling it: `pick`
//// and `omit` take the fields as a variadic
//// (`comptime ..fields: Type.Field<T>[]`, decision 267 — front 134 step 4).

pub type Type {
    // The field of `T` (decision 308): its name, its type as the source
    // spells it and its annotations. Its values are the fields of `T`'s
    // declaration; nobody constructs one (`.title` names it). The reflection
    // record `decl.fields` hands out is still `builtins.d.bp`'s `Field` until
    // `134` step 2 makes it `Type.Field<unknown>`.
    pub type Field<T>(
        name: string,
        typeName: string,
        annotations: DeclAnnotation[],
    )

    // The field key of `T`: `Type.Field<T>`, one value per field of `T`'s
    // declaration (`.title`), never a second enum.
    pub declare fn keys<T>(comptime source: type T) -> type;

    // Every field `F` of `T` made `?F`.
    pub declare fn partial<T>(comptime source: type T) -> type;

    // Every field `?F` of `T` made `F` — every `?` goes: `required` does not
    // know what was optional before a `partial`.
    pub declare fn required<T>(comptime source: type T) -> type;

    // The fields of `first`, then those of `second`; a field on both sides is
    // an error (`omit` it first: nothing overrides silently).
    pub declare fn merge<A, B>(
        comptime first: type A,
        comptime second: type B,
    ) -> type;
}

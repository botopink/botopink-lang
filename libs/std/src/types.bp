//// std's `Type` (decisions 307, 308) — the derived types: a compile-time
//// function answers a NEW record type, bound by a module-level `val` and
//// named after it (`pub val RecipePatch = Type.partial(Recipe);`), nominal,
//// usable in every type position, exported and imported like any type, and
//// annotatable (`#[validated] pub val RecipePatch = Type.partial(Recipe);`);
//// the source fields' markers come with them. A plain alias
//// (`type Id = i32`) stays transparent.
////
//// Every function here runs only at compile time and takes every parameter
//// `comptime x: T`, so a call needs no `comptime`
//// keyword. The bodies are the
//// compiler's: bodyless, without `#[compiler.external(.<Target>)]`, because no target
//// runs them — the compiler answers `partial`, `required`, `pick`, `omit` and
//// `merge` with the record declaration they derive, keyed on this `Type`
//// (`comptime/derived_types.zig`).
////
//// `Type` is a namespace type (decision 329): no field list, no value, every
//// function associated. `Field<T>` is declared in its body, so it is its
//// associated type `Type.Field<T>` (decision 330 (7)). `pick` and `omit`
//// take the fields as a variadic (`comptime ..fields: Type.Field<T>[]`,
//// decision 267): `Type.pick(Recipe, .title, .servings)`.

import {compiler.DeclAnnotation};

pub type Type {
    // The field of `T` (decisions 308, 599): its name, its type as the source
    // spells it and its annotations. A build-time value only: `.title` names
    // it where a `Type.Field<T>` is expected in a decorator's argument or in
    // `pick` / `omit`, checked against `T`'s fields; there is no run-time key.
    // The reflection record `decl.fields` hands out is still
    // `primitives.bp`'s `Field` until `134` step 2 makes it
    // `Type.Field<unknown>`.
    pub type Field<T>(
        name: string,
        typeName: string,
        annotations: DeclAnnotation[],
    )

    // Every field `F` of `T` made `?F`.
    pub declare fn partial<T>(comptime source: type<T>) -> anytype;

    // Every field `?F` of `T` made `F` — every `?` goes: `required` does not
    // know what was optional before a `partial`.
    pub declare fn required<T>(comptime source: type<T>) -> anytype;

    // The fields of `first`, then those of `second`; a field on both sides is
    // an error (`omit` it first: nothing overrides silently).
    pub declare fn merge<A, B>(
        comptime first: type<A>,
        comptime second: type<B>,
    ) -> anytype;

    // The fields of `T` named in `fields`, in the order `T` declares them.
    pub declare fn pick<T>(
        comptime source: type<T>,
        comptime ..fields: Type.Field<T>[],
    ) -> anytype;

    // The fields of `T` but those named in `fields`.
    pub declare fn omit<T>(
        comptime source: type<T>,
        comptime ..fields: Type.Field<T>[],
    ) -> anytype;
}

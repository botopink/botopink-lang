//// std/async — combinators over `@Future<T>`.
////
//// THE ERLANG DIVERGENCE, AT THE TOP RATHER THAN IN A FOOTNOTE.
//// `@Future<T>` lowers EAGERLY on the erlang backend: a `#[@future]` fn is a
//// plain function, `await` is identity, and a future is therefore a value that
//// has already run (`codegen/erlang.zig` — the `#[@future] / #[@futureGenerator]
//// — eager lowering` arm; `libs/std/src/http.bp:16-18` says the same for
//// `http.fetch`). By the time an `Array<@Future<T>>` reaches a combinator on
//// erlang, every element has already finished, in list order, serially.
////
//// So this module has TWO surfaces and they do not make the same promise.
////
////   TASK SURFACE — `allOf`, `settleOf`, `raceOf`, `timeout`.
////   Takes `Array<fn() -> @Future<T>>`: UNSTARTED tasks. Because nothing has
////   run when the combinator receives them, the erlang cell can `spawn` one
////   process per task and gather the replies by index, and the commonJS cell
////   can call each thunk and hand the Promises to `Promise.allSettled`. Real
////   concurrency on BOTH targets. This is the surface a server front uses.
////
////   FUTURE SURFACE — `all`, `allSettled`, `race`.
////   Takes `Array<@Future<T>>`, for parity with the JavaScript the client half
////   is written against. Concurrent on commonJS. On erlang it is honest rather
////   than concurrent: the futures resolved before the call, so `all` is a map,
////   `allSettled` wraps every element `Ok`, and `race` answers ELEMENT ZERO
////   rather than the fastest. Both behaviours are asserted by the tests at the
////   foot of this file, so a backend change that makes erlang lazy reds a test
////   and forces this docblock to be rewritten instead of silently making it a
////   lie.
////
//// NO COMBINATOR HERE HIDES A FAILURE (decision 67).
////   * `allOf`/`all` do not stop at the first failure the way `Promise.all`
////     does: every task is settled, and the rejection names EVERY one that
////     failed — `async.allOf: 2 of 3 tasks failed: [0] down; [2] boom` — so a
////     page that lost three dependencies is not told about one. The counting
////     and the joining are in the `unwrapAll` cell below, not in prose.
////   * `settleOf`/`allSettled` never fail and keep one slot per input, in
////     input order, so the caller decides.
////   * `raceOf`/`race` answer the first task to ANSWER — including when that
////     answer is a failure, which is re-raised rather than swallowed. A LOSER's
////     failure IS dropped; that is what racing means, it is the one loss in the
////     module, and `async: raceOf ---- a loser failure is dropped, on purpose`
////     is the cell that says so.
////
//// NO CANCELLATION. `raceOf`'s losers and `timeout`'s expired task keep
//// running to completion; there is no cancellation surface in the language
//// (see § Language gaps in the front's README).
////
//// DO NOT RUN `botopink format` ON THIS FILE. The formatter wraps the two
//// `declare fn`s whose signature is over eighty columns (`settleOf`,
//// `allSettled`) and closes the wrapped parameter list with a TRAILING COMMA,
//// and a trailing comma after a parameter whose type ends in a fn type is a
//// parse error: a `declare fn` whose wrapped parameter list ends
//// `t: fn() -> T,` reds with `this token cannot appear here`, and with a
//// generic return type it reds `generic-arg-skip-forbidden` instead.
//// Formatting this file therefore produces a file that no longer compiles.
//// `libs/std` is not one of the canonical trees
//// `scripts/format-check.sh` holds (it is red today for two other reasons), so
//// nothing runs the formatter over it; the defect is the parser's, and it is
//// written up in the front's report.
////
//// Reference:
////   Promise.all       — https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Promise/all
////   Promise.allSettled— https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Promise/allSettled
////   Erlang processes  — https://www.erlang.org/doc/system/ref_man_processes.html

// ── instruments ──────────────────────────────────────────────────────────────

// Which backend is running. The future surface's erlang behaviour differs from
// its commonJS behaviour by design, and a test that asserts one of the two has
// to know which it is looking at. Private: the divergence is this module's to
// document, not a consumer's to branch on.
#[@External.Node("""'commonJS'""")]
#[@External.Erlang("""<<"erlang">>""")]
declare fn hostTarget() -> string;

// The host's monotonic clock in milliseconds. `std/time` has the same cell, but
// a std module cannot import another std module (language gap), so this file
// carries its own. Private — `time.monotonicMillis()` is the public spelling.
#[@External.Node("""Math.floor(performance.now())""")]
#[@External.Erlang("erlang:monotonic_time(1000)")]
declare fn monoMillis() -> i64;

// Answer `value` after at least `millis` milliseconds. The instrument every
// ordering and elapsed-time assertion in this file is built on: without a
// future of known duration there is no way to tell a concurrent `allOf` from a
// sequential map.
#[@future]
#[@External.Node("""new Promise(__r => setTimeout(() => __r($1), $0))""")]
#[@External.Erlang("""(fun(__M, __V) -> timer:sleep(__M), __V end)($0, $1)""")]
pub declare fn delay<T>(millis: i32, value: T) -> @Future<T>;

// A future that fails with `message`. The second instrument: `settleOf` and
// `timeout` cannot be tested without one, and a test that reaches an
// unreachable host to get a failure is a test that fails on a laptop with no
// network.
#[@future]
#[@External.Node("""Promise.reject(new Error($0))""")]
#[@External.Erlang("""erlang:error($0)""")]
pub declare fn failed<T>(message: string) -> @Future<T>;

// ── reading a settled element ────────────────────────────────────────────────

// The `Error` payload of a settled element, or `""` for `Ok`. `@Result` carries
// `isOk`/`isError`/`unwrapOr` as builtins but no way to read the error side, so
// without this a `settleOf` caller can see THAT a widget failed and never WHY —
// the shape decision 67 refuses.
pub fn errorText<T>(settled: @Result<T, string>) -> string {
    val text = case settled {
        Ok(_v) -> "";
        Error(e) -> e;
    };
    return text;
}

// ── the task surface ─────────────────────────────────────────────────────────

// Run every task concurrently and answer one `@Result` per task, in the ORDER
// OF THE INPUT rather than the order they finished. NEVER fails: a page renders
// the widgets that answered and omits the ones that did not.
//
// Node: each thunk is called, the Promises go to `Promise.allSettled`, and each
// outcome is normalised to the `{ ok: V } | { error: Msg }` runtime shape of
// `@Result`.
// Erlang: `spawn` one process per task, each tagged `{Ref, I, Outcome}` with a
// `make_ref()` unique to THIS call — without the ref a later combinator in the
// same process would receive a loser's leftover reply — and gather by index, so
// a task that finishes first does not take another task's slot. A task that
// never answers blocks the gather; that is what `timeout` is for.
#[@future]
#[@External.Node("""((__ts) => Promise.allSettled(__ts.map((__f) => (__f)())).then((__rs) => __rs.map((__r) => __r.status === 'fulfilled' ? { ok: __r.value } : { error: (__r.reason && __r.reason.message) ? __r.reason.message : String(__r.reason) })))($0)""")]
#[@External.Erlang("""(fun(__Ts) -> __Me = self(), BpRef = erlang:make_ref(), lists:foreach(fun(__I) -> erlang:spawn(fun() -> __Me ! {BpRef, __I, try {ok, (lists:nth(__I, __Ts))()} catch __C:__E -> {error, (fun(__Y) -> if is_binary(__Y) -> __Y; true -> iolist_to_binary(io_lib:format("~p", [__Y])) end end)(__E)} end} end) end, lists:seq(1, length(__Ts))), [receive {BpRef, BpJ, __X} -> __X end || BpJ <- lists:seq(1, length(__Ts))] end)($0)""")]
pub declare fn settleOf<T>(tasks: Array<fn() -> @Future<T>>) -> @Future<@Result<T, string>[]>;

// Settled elements to values, or ONE failure that names every element that
// failed. `who` is the calling combinator's name, so the message reads
// `async.allOf: …` or `async.all: …`. Private — the shared failure-reporting
// rule of `allOf` and `all`, written once per target.
#[@External.Node("""((__rs, __who) => { const __b = []; for (let __i = 0; __i < __rs.length; __i = __i + 1) { if (__rs[__i].error !== undefined) { __b.push('[' + __i + '] ' + __rs[__i].error); } } if (__b.length > 0) { throw new Error(__who + ': ' + __b.length + ' of ' + __rs.length + ' tasks failed: ' + __b.join('; ')); } return __rs.map((__r) => __r.ok); })($0, $1)""")]
#[@External.Erlang("""(fun(__Rs, __Who) -> __B = [iolist_to_binary([<<"[">>, integer_to_binary(__K - 1), <<"] ">>, element(2, lists:nth(__K, __Rs))]) || __K <- lists:seq(1, length(__Rs)), element(1, lists:nth(__K, __Rs)) =:= error], case __B of [] -> [__V || {ok, __V} <- __Rs]; _ -> erlang:error(iolist_to_binary([__Who, <<": ">>, integer_to_binary(length(__B)), <<" of ">>, integer_to_binary(length(__Rs)), <<" tasks failed: ">>, lists:join(<<"; ">>, __B)])) end end)($0, $1)""")]
declare fn unwrapAll<T>(settled: @Result<T, string>[], who: string) -> Array<T>;

// Run every task concurrently and answer their values in the ORDER OF THE
// INPUT. Fails the whole call if ANY task fails — the right default for a page
// that cannot render without all of its data — and the failure names every task
// that failed, not only the first (`Promise.all` reports one and hides the
// rest; this does not).
//
// `allOf([])` answers `[]`.
#[@future]
pub fn allOf<T>(tasks: Array<fn() -> @Future<T>>) -> @Future<Array<T>> {
    val settled = await settleOf(tasks);
    return unwrapAll(settled, "async.allOf");
}

// The first task to ANSWER, not the first in the list. When that answer is a
// failure the failure is re-raised — `raceOf` does not wait for a later task to
// succeed. The LOSERS keep running and their outcomes are discarded, including
// a loser's failure: there is no cancellation surface in botopink, and a race
// that reported the loser would not be a race.
//
// `raceOf([])` fails with `async.raceOf: empty task list` rather than blocking
// forever.
#[@future]
#[@External.Node("""((__ts) => __ts.length === 0 ? Promise.reject(new Error('async.raceOf: empty task list')) : Promise.race(__ts.map((__f) => (__f)())))($0)""")]
#[@External.Erlang("""(fun(__Ts) -> case __Ts of [] -> erlang:error(<<"async.raceOf: empty task list">>); _ -> __Me = self(), BpRef = erlang:make_ref(), lists:foreach(fun(__I) -> erlang:spawn(fun() -> __Me ! {BpRef, try {ok, (lists:nth(__I, __Ts))()} catch __C:__E -> {error, __C, __E} end} end) end, lists:seq(1, length(__Ts))), case (receive {BpRef, __W} -> __W end) of {ok, __V} -> __V; {error, __C2, __E2} -> erlang:raise(__C2, __E2, []) end end end)($0)""")]
pub declare fn raceOf<T>(tasks: Array<fn() -> @Future<T>>) -> @Future<T>;

// One task, wrapped so that its failure is a value rather than a rejection.
// Private: it is `settleOf` for a single task, and the only piece `timeout`
// needs that `raceOf` and `delay` do not already give it.
#[@future]
#[@External.Node("""Promise.resolve().then(() => ($0)()).then((__v) => ({ ok: __v }), (__e) => ({ error: (__e && __e.message) ? __e.message : String(__e) }))""")]
#[@External.Erlang("""(fun(__T) -> try {ok, __T()} catch __C:__E -> {error, (fun(__Y) -> if is_binary(__Y) -> __Y; true -> iolist_to_binary(io_lib:format("~p", [__Y])) end end)(__E)} end end)($0)""")]
declare fn attempt<T>(task: fn() -> @Future<T>) -> @Future<@Result<T, string>>;

// A future that fails after `millis`. Pure composition of the two instruments —
// `delay` then `failed` — so `timeout` needs no host cell of its own.
#[@future]
fn failAfter<T>(millis: i32) -> @Future<T> {
    await delay(millis, 0);
    return await failed("timeout");
}

// `Ok(value)` when the task answered inside the budget, `Error("timeout")` when
// it did not, and `Error(<the task's own message>)` when the task failed inside
// the budget — three outcomes, none of them hidden. The task KEEPS RUNNING; the
// caller stops waiting. Expressed over `raceOf` + `delay` + `failed`.
#[@future]
pub fn timeout<T>(task: fn() -> @Future<T>, millis: i32) -> @Future<@Result<T, string>> {
    return await attempt({ ->
        raceOf([
            { -> task() },
            { -> failAfter(millis) },
        ])
    });
}

// ── the future surface ───────────────────────────────────────────────────────

// One `@Result` per input future, in input order. Never fails.
//
// commonJS: `Promise.allSettled` — real concurrency, a rejected future is an
// `Error` element.
// ERLANG: the futures resolved BEFORE this call, in list order, so every
// element is wrapped `Ok` and there is nothing left to be concurrent about. A
// future that was going to fail already raised at its construction site and
// never reached here. Use `settleOf` on the server.
#[@future]
#[@External.Node("""Promise.allSettled($0).then((__rs) => __rs.map((__r) => __r.status === 'fulfilled' ? { ok: __r.value } : { error: (__r.reason && __r.reason.message) ? __r.reason.message : String(__r.reason) }))""")]
#[@External.Erlang("""[{ok, __V} || __V <- $0]""")]
pub declare fn allSettled<T>(futures: Array<@Future<T>>) -> @Future<@Result<T, string>[]>;

// The values of every input future, in input order; fails naming EVERY future
// that failed.
//
// commonJS: concurrent. ERLANG: the futures already resolved in list order, so
// the result is correct and the concurrency is absent. Use `allOf` on the
// server.
#[@future]
pub fn all<T>(futures: Array<@Future<T>>) -> @Future<Array<T>> {
    val settled = await allSettled(futures);
    return unwrapAll(settled, "async.all");
}

// commonJS: the FASTEST future to settle, `Promise.race`.
// ERLANG: ELEMENT ZERO. Every future resolved before the call, so there is no
// timing left to measure and this answers the first element of the list. That
// is not a bug to be fixed here and no server front may depend on it — use
// `raceOf`, whose tasks are unstarted when it receives them. Both behaviours
// are pinned by `async: race ---- commonJS fastest, erlang element zero`.
//
// `race([])` fails with `async.race: empty future list` on both targets.
#[@future]
#[@External.Node("""((__fs) => __fs.length === 0 ? Promise.reject(new Error('async.race: empty future list')) : Promise.race(__fs))($0)""")]
#[@External.Erlang("""(fun(__Fs) -> case __Fs of [] -> erlang:error(<<"async.race: empty future list">>); _ -> hd(__Fs) end end)($0)""")]
pub declare fn race<T>(futures: Array<@Future<T>>) -> @Future<T>;

// ── tests ────────────────────────────────────────────────────────────────────
// Inline, the way every std module does it, run by `botopink test` and
// `botopink test --target erlang` from `libs/std/`. Three kinds of assertion:
// results and order (deterministic on both targets), ELAPSED TIME (the only
// assertion that can tell a concurrent combinator from a sequential map, and
// therefore the one that has to exist — wall clock, budget at roughly double
// the longest task), and DOCUMENTED DIVERGENCE (the future surface's erlang
// behaviour asserted as itself, so a backend change that makes erlang lazy reds
// a test instead of silently making the docblock a lie).
//
// `async` is not snapshotted (`01-std/test-snap.md`): an elapsed-time budget is
// a `<`, never a recorded literal.

type Probe(id: i32, label: string)

// ── delay and failed ─────────────────────────────────────────────────────────

test "async: delay ---- answers its value" {
    val v = await delay(20, "x");
    assert v == "x";
}

test "async: delay ---- takes at least the requested time" {
    val start = monoMillis();
    val v = await delay(20, "x");
    val elapsed = monoMillis() - start;
    assert v == "x";
    assert elapsed >= 20;
}

test "async: delay ---- binds T to a record as well as to a string" {
    val p = await delay(5, Probe(id: 7, label: "seven"));
    assert p.id == 7;
    assert p.label == "seven";
}

test "async: failed ---- is an Error element inside settleOf, not a dead suite" {
    val settled = await settleOf([
        { -> delay(5, "up") },
        { -> failed("down") },
    ]);
    assert settled.length == 2;
    val absent = errorProbe();
    val second = settled.at(1).unwrapOr(absent);
    assert second.isError();
    assert errorText(second) == "down";
}

// A settled element to stand in for the `?T` fallback of `.at(i)`. `Array.at`
// answers an optional and `unwrapOr` needs a value of the element type, which
// here is itself a `@Result`; this is the cheapest way to spell one.
#[@result]
fn errorProbe() -> @Result<string, string> {
    throw "async: no element";
}

// ── allOf ────────────────────────────────────────────────────────────────────

test "async: allOf ---- answers input order, not completion order" {
    val values = await allOf([
        { -> delay(60, "a") },
        { -> delay(20, "b") },
        { -> delay(40, "c") },
    ]);
    assert values.join(",") == "a,b,c";
}

test "async: allOf ---- runs its tasks concurrently" {
    val start = monoMillis();
    val values = await allOf([
        { -> delay(60, "a") },
        { -> delay(60, "b") },
        { -> delay(60, "c") },
    ]);
    val elapsed = monoMillis() - start;
    assert values.length == 3;
    assert elapsed < 120;
}

test "async: allOf ---- of no tasks answers no values" {
    val values = await allOf([]);
    assert values.length == 0;
}

test "async: allOf ---- a failing task fails the whole call" {
    val res = await attempt({ ->
        allOf([
            { -> delay(5, "a") },
            { -> failed("down") },
        ])
    });
    assert res.isError();
    assert errorText(res).contains("1 of 2 tasks failed");
    assert errorText(res).contains("[1] down");
}

test "async: allOf ---- names every failure, not only the first" {
    val res = await attempt({ ->
        allOf([
            { -> failed("one") },
            { -> delay(5, "a") },
            { -> failed("three") },
            { -> failed("four") },
        ])
    });
    assert res.isError();
    val msg = errorText(res);
    assert msg.contains("async.allOf: 3 of 4 tasks failed");
    assert msg.contains("[0] one");
    assert msg.contains("[2] three");
    assert msg.contains("[3] four");
}

// ── settleOf ─────────────────────────────────────────────────────────────────

test "async: settleOf ---- one slot per input, in input order" {
    val settled = await settleOf([
        { -> delay(40, "slow") },
        { -> failed("broken") },
        { -> delay(5, "fast") },
    ]);
    assert settled.length == 3;
    val absent = errorProbe();
    assert errorText(settled.at(0).unwrapOr(absent)) == "";
    assert errorText(settled.at(1).unwrapOr(absent)) == "broken";
    assert settled.at(2).unwrapOr(absent).unwrapOr("") == "fast";
}

test "async: settleOf ---- never propagates a failure to its caller" {
    val settled = await settleOf([
        { -> failed("a") },
        { -> failed("b") },
    ]);
    assert settled.length == 2;
    val absent = errorProbe();
    assert errorText(settled.at(0).unwrapOr(absent)) == "a";
    assert errorText(settled.at(1).unwrapOr(absent)) == "b";
}

test "async: settleOf ---- runs its tasks concurrently" {
    val start = monoMillis();
    val settled = await settleOf([
        { -> delay(60, "a") },
        { -> delay(60, "b") },
        { -> delay(60, "c") },
    ]);
    val elapsed = monoMillis() - start;
    assert settled.length == 3;
    assert elapsed < 120;
}

// ── raceOf ───────────────────────────────────────────────────────────────────

test "async: raceOf ---- answers the fastest task, not the first" {
    val first = await raceOf([
        { -> delay(80, "slow") },
        { -> delay(10, "fast") },
    ]);
    assert first == "fast";
}

test "async: raceOf ---- of no tasks fails instead of blocking forever" {
    val res = await attempt({ -> raceOf([]) });
    assert res.isError();
    assert errorText(res).contains("async.raceOf: empty task list");
}

test "async: raceOf ---- a fast failure is raised, not swallowed" {
    val res = await attempt({ ->
        raceOf([
            { -> delay(80, "slow") },
            { -> failed("fast failure") },
        ])
    });
    assert res.isError();
    assert errorText(res).contains("fast failure");
}

test "async: raceOf ---- a loser failure is dropped, on purpose" {
    // The ONE place in this module where an error is not reported: the slow
    // task fails at 80 ms, the fast one answered at 10 ms, and the call says
    // nothing about the loser. There is no cancellation surface, so the loser
    // runs to completion and its failure goes nowhere. Asserted rather than
    // only written down.
    val first = await raceOf([
        { -> failAfter(80) },
        { -> delay(10, "winner") },
    ]);
    assert first == "winner";
}

// ── the future surface ───────────────────────────────────────────────────────

test "async: all ---- answers input order on both targets" {
    val values = await all([delay(40, "a"), delay(10, "b"), delay(25, "c")]);
    assert values.join(",") == "a,b,c";
}

test "async: all ---- of no futures answers no values" {
    val values = await all([]);
    assert values.length == 0;
}

test "async: allSettled ---- one Result per input and never fails" {
    val settled = await allSettled([delay(10, "a"), delay(5, "b")]);
    assert settled.length == 2;
    val absent = errorProbe();
    assert settled.at(0).unwrapOr(absent).unwrapOr("") == "a";
    assert settled.at(1).unwrapOr(absent).unwrapOr("") == "b";
}

test "async: race ---- fastest on commonJS, element zero on erlang" {
    // The divergence, written as a test rather than as prose. `@Future<T>` is
    // eager on erlang: both futures have resolved by the time `race` is called,
    // in list order, so `race` answers the FIRST element and the 10 ms future
    // never had a chance to win. On commonJS the Promises are live and the
    // fastest wins. If a backend change ever makes erlang lazy, this reds.
    val first = await race([delay(80, "zero"), delay(10, "one")]);
    if (hostTarget() == "erlang") {
        assert first == "zero";
    } else {
        assert first == "one";
    };
}

test "async: race ---- of no futures fails on both targets" {
    val res = await attempt({ -> race([]) });
    assert res.isError();
    assert errorText(res).contains("async.race: empty future list");
}

// ── timeout ──────────────────────────────────────────────────────────────────

test "async: timeout ---- a fast task under a wide budget answers Ok" {
    val answered = await timeout({ -> delay(10, "in time") }, 100);
    assert answered.isOk();
    assert answered.unwrapOr("") == "in time";
}

test "async: timeout ---- a slow task under a narrow budget answers Error timeout" {
    val start = monoMillis();
    val answered = await timeout({ -> delay(200, "too late") }, 50);
    val elapsed = monoMillis() - start;
    assert answered.isError();
    assert errorText(answered) == "timeout";
    assert elapsed < 150;
}

test "async: timeout ---- a task that fails inside the budget keeps its own message" {
    val answered = await timeout({ -> failed("upstream down") }, 100);
    assert answered.isError();
    assert errorText(answered) == "upstream down";
}

test "async: timeout ---- an expired task cannot corrupt a later answer" {
    // The expired task finishes at 120 ms, long after `timeout` stopped waiting
    // at 30 ms, and lands in the same host process. The erlang cells tag every
    // reply with a `make_ref()` unique to their own call for exactly this: the
    // `allOf` below must read its own replies, not the ghost of a task nobody
    // is waiting for any more.
    val answered = await timeout({ -> delay(120, "late") }, 30);
    assert answered.isError();
    val values = await allOf([
        { -> delay(150, "a") },
        { -> delay(5, "b") },
    ]);
    assert values.join(",") == "a,b";
}

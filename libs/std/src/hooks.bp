//// Hooks (decisions 755, 816, 818) — what a component's body keeps between
//// its renders.
////
//// `use memo({ -> make })` answers the value `make` computed on the first
//// render of the cell it stands in, kept while that cell stands and never
//// recomputed — no dependency list:
////
////     import {hooks.memo} from "std";
////
////     component fn Page(dark: bool) -> Component<Element> {
////         val c = use memo({ -> createContext(Theme(dark: dark)) });
////         use provide(c);
////         …
////     }
////
//// A hook's state lives in the render's tree (decision 816): `use memo` is a
//// call of the body, numbered with the body's other calls, and takes a child
//// cell of the body's cell at its place (818 (1)); its slot is that cell's.
//// A cell is kept from one render to the next while the same place of its
//// parent is met — the same written call, the same item count or key
//// (819, 820) —, so a parent's re-render keeps it and a branch that stops
//// rendering it drops it. Two runs over one `Scope` root share the tree; a
//// fresh root starts empty.
////
//// The work is the compiler's (`comptime/context_lower.zig`): `use memo(f)`
//// is lowered where it is written to std's `context.memoIn(<the body's
//// cell>, <the call's number>, f)`, so `memo` itself is never called and its
//// body panics.

import {failure.panic};

// The value `make` computed on the first render of this hook's cell, kept
// while the cell stands (decisions 755, 816, 818 (1)).
pub component fn memo<T>(make: fn() -> T) -> Component<T> {
    panic("`use memo` is lowered where it is written; this body never runs");
}

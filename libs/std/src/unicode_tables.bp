// The primary composite of `first` followed by `second` — the code point
// whose canonical mapping is the pair and which is not excluded from
// composition —, or 0 when there is none.
pub fn primaryComposite(first: i32, second: i32) -> i32 {
    return case first {
        60...72 -> primaryComposite0(first, second);
        73...82 -> primaryComposite1(first, second);
        83...97 -> primaryComposite2(first, second);
        98...107 -> primaryComposite3(first, second);
        108...117 -> primaryComposite4(first, second);
        118...230 -> primaryComposite5(first, second);
        231...438 -> primaryComposite6(first, second);
        439...952 -> primaryComposite7(first, second);
        953...1077 -> primaryComposite8(first, second);
        1078...6971 -> primaryComposite9(first, second);
        6972...7971 -> primaryComposite10(first, second);
        7972...8040 -> primaryComposite11(first, second);
        8041...12362 -> primaryComposite12(first, second);
        12363...70470 -> primaryComposite13(first, second);
        70471...93545 -> primaryComposite14(first, second);
        _ -> 0;
    };
}


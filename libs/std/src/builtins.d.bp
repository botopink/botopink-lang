//// Gleam-inspired `io` module (`import {io} from "std";`).
//// Host-backed I/O primitives — declaration-only, no pure implementation.
//// Each target backend supplies the concrete symbol via `#[External.<Target>(...)]`.

// On erlang and beam, `@print`, `@println` and `@debug` lower to the
// `'__bp_print'/1` helper the backend emits once per module (it prints a
// binary with `~ts` and any other value with `~p`); the codegen intercepts the
// call before any `@External.Erlang` template, so the templates below only
// name that helper.
#[External.Node("console.log($args)")]
#[External.Erlang("'__bp_print'([$args])")]
pub declare fn print(..values: unknown[]);

#[External.Node("console.log($args)")]
#[External.Erlang("'__bp_print'([$args])")]
pub declare fn println(..values: unknown[]);

#[External.Node("console.debug($args)")]
#[External.Erlang("'__bp_print'([$args])")]
pub declare fn debug(..values: unknown[]);

// ── result type ──────────────────────────────────────────────────────────────

// `Result<R, E>`'s methods are resolved by type inference and lowered inline
// by every codegen backend (there is no run-time dispatch table): bodyless,
// because the compiler is the body. The compiler's rows are
// `comptime/builtins.zig` `methods`, held to these declarations by its drift
// test.
pub type Result<R, E> {
    Ok(result: R),
    Error(error: E),

    // Apply `transform` to the Ok payload; an Error is propagated untouched.
    declare fn map<R2>(
        self: Self<R, E>,
        transform: fn(value: R) -> R2,
    ) -> Result<R2, E>;

    // Like `map` but `transform` itself returns a Result (no nesting).
    declare fn flatMap<R2>(
        self: Self<R, E>,
        transform: fn(value: R) -> Result<R2, E>,
    ) -> Result<R2, E>;

    // The Ok payload, or `fallback` when the receiver is an Error.
    declare fn unwrapOr(self: Self<R, E>, fallback: R) -> R;

    // True when the receiver is `Ok`.
    declare fn isOk(self: Self<R, E>) -> bool;

    // True when the receiver is `Error`.
    declare fn isError(self: Self<R, E>) -> bool;
}

// A `Result` value is constructed by `return`/`throw` inside a body whose
// return carries `@Result<R, E>` (decision 118); the runtime shape is `{ ok: V } | { error: E }`
// (JS) / `{ok, V} | {error, E}` (erlang/beam).

// ── option type ──────────────────────────────────────────────────────────────

// The optional type is `?T` — the ONLY spelling. Optional is not a concrete
// named type: `Option<T>` / `Optional<T>` annotations are rejected with a
// pointed diagnostic. One representation: a value, or absent.
//
// `?T` has no methods (decision 330): its whole surface is TypeScript's
// operators, typed and lowered by the compiler (no declaration here):
//
//   a ?? b        `a` unless it is null, then `b`
//   a?.f          a member read through the optional (`a?.f()` a method)
//   a?.[i]        an index through the optional
//   f?.(args)     a call of the function an optional holds
//   a!            the value, or an abort naming the expression and its place
//                 (`value is null — a! at src/main.bp:3:13`)
//
// An operator over a value that is never null is a compile error; `?.`
// flattens (a member answering `?U` read through `?.` is `?U`); `??` beside
// `&&` / `||` takes parentheses. `map`, `flatMap` and `unwrapOr` belong to
// `@Result` alone.

// ── the effect wrappers (decisions 118–128) ─────────────────────────────────
//
// The return type IS the annotation (decision 118): a function gains a
// capability by writing one of these wrappers, literally, as its return type,
// and by nothing else. An alias to a wrapper (`type Job<T> = @Task<T>`) types
// the function but activates nothing.
//
//   -> @Result<T, E>       throw · try            (the one fallible wrapper)
//   -> @Task<T>            await
//   -> @Component<R>       use · await            Component ⊃ Task
//   -> @Iterator<T>        yield · break v
//   -> @Stream<T>          yield · break v · await   Stream ⊃ Task
//
// Only `@Result` fails (decision 121). `@Task`, `@Component`, `@Iterator` and
// `@Stream` never fail; when something can, the failure goes INSIDE the value
// — `@Task<@Result<T, E>>`, `@Iterator<@Result<T, E>>` — and `throw` / `try`
// are legal wherever a layer of the return is a `@Result`.
//
// The chain is on the declarations below, as `extends` clauses (a `behavior`
// carries `extends`, not the `implement` a `type` writes, and `extends` cannot
// carry type arguments), so the full clauses are:
//
//   Component<R>      extends Task<R>
//   Stream<T>         extends Task<YieldStep<T>>
//   Iterator<T>       — NO clause: it neither awaits nor fails.
//
// The compiler reads this order from `comptime/effect_chain.zig`, which
// restates it and carries tests that read THIS FILE and fail if the two
// drift: the file is not parsed into the type env (the whole `.d.bp` is
// documentation, and `comptime.zig`'s embedded mirrors exist for the same
// reason), so the drift gate is what keeps one declaration.
//
// `return` in an effect body (decision 119) wraps through every layer:
// `return v` with `v: U` in `-> @Task<@Result<U, E>>` is a Task holding
// `Ok(v)`; a value already of a layer's type passes through. `throw e` in a
// body whose return carries `@Result<U, E>` is that layer's `Error(e)` — it
// never rejects a Task (decision 120).

// `Task<T>` — a value that has not arrived yet; `await` unwraps it. A Task
// never fails: `await t` on a `@Task<@Result<U, E>>` answers the `@Result`,
// and `try await t` propagates its error. A function with no await channel
// consumes a Task through its own functions.
pub behavior Task<T> {
    fn map<R>(self: Self<T>, transform: fn(value: T) -> R) -> Task<R>;
    fn then<R>(self: Self<T>, next: fn(value: T) -> Task<R>) -> Task<R>;
}

// ── sequences (decisions 122, 123, 125) ──────────────────────────────────────
//
// One step for both sequences: `Yield(value)` emits, `Done` ends. There is no
// error step — an item that can fail is a `@Result` — and no completion
// channel: `break v` in a sequence body emits `v` as the last item and ends
// (≡ `yield v; break;`), and a bare `break` outside any loop ends it.
//
// A function returning `@Iterator` / `@Stream` IS an iterator when its body
// yields (`yield` or `break v`, in its own scope); without one it is an
// ordinary function returning a ready iterator (a factory, decision 123). A
// loop prefixed `iter` / `stream` is an iterator in the middle of a function
// (decision 125). A type that wants to be iterated exposes an ordinary method
// answering an iterator and the consumer calls it — `for (grid.iter())`;
// there is no iterable behavior.
//
// A `for` over an `@Iterator<X>` hands over each `X` — a `@Result` when `X` is
// one; there is no implicit `try` (decision 122).

pub type YieldStep<T> {
    Yield(value: T),
    Done,
}

// `Iterator<T>` — a synchronous sequence; iterated by `for` in any function.
pub behavior Iterator<T> {
    fn next(self: Self<T>) -> YieldStep<T>;
}

// `Stream<T>` — an asynchronous sequence: finding the next item may need to
// wait. Iterated by `for await`, which needs an await channel.
pub behavior Stream<T> extends Task {
    fn next(self: Self<T>) -> Task<YieldStep<T>>;
}

// ── display (decision 8 §7, decision 27) ─────────────────────────────────────
//
// `@print` consults a value's own `Display` implementation before it falls back
// to the per-type formatter: a type that says how it reads says it here, once,
// and every backend's §7 formatter reads the same declaration. It is ambient —
// a type writes `implement Display` with no import, exactly as any other
// builtin behavior — because `@print` has to find it without the author having
// asked for it.

pub behavior Display {
    fn display(self: Self) -> string;
}

// ── index / slice (decision 63, amended) ─────────────────────────────────────
//
// An index expression has NO typing rule of its own: `xs[0]` IS `xs.at(0)`,
// `d["k"]` IS `d.at("k")`, `xs[0..2]` IS `xs.slice(0, 2)` and `xs[1..]` IS
// `xs.slice(1, null)`. The type of the expression is whatever the method
// answers, so indexing stops being a privilege of the three built-in
// collections: a library's own `Matrix`, `Row` or `Buffer` becomes indexable by
// answering `at` / `slice`, with no compiler change.
//
// Both are ambient — a type says it indexes with no import, exactly as it says
// how it reads with `Display` above — because the syntax has to find the method
// without the author having asked for it.
//
// `slice` takes two arguments rather than one range because there is no `Range`
// type in the language: `start..end` is an AST node, not a value, so an open end
// travels as `null` in the second argument.
//
// A TUPLE is deliberately not covered. `t[0]` needs a *constant* index and
// answers a type *per position*, which `at(key: K) -> ?V` cannot express with a
// single `V`; the tuple stays a checker special case.
//
// `libs/std` answers both: `Dict<K, V>` carries `Index<K, V>` on its
// declaration; `Array<T>` (`Index<i32, T>`, `Slice<T[]>`) and `string`
// (`Index<i32, string>`, `Slice<string>`) answer them from the primitive
// registry in `primitives.bp`, which is a `behavior` and cannot spell an
// `implement` clause today — the conformance is named in a comment there.

pub behavior Index<K, V> {
    fn at(self: Self<K, V>, key: K) -> ?V;
}

pub behavior Slice<V> {
    fn slice(self: Self<V>, start: i32, end: ?i32) -> V;
}

// ── components and hooks — decisions 104, 128 and 354 ───────────────────────
//
// The wrapper of `use` is one: `Component<R>`, returning `R` (decision 354 —
// the base parameter of 128 is gone). A component is the `@Component<R>`
// whose `R` implements the marker `Renderable` (`type Element(…) implement
// @Renderable`); any other `R` makes the function a hook. A component is
// called (`Card()`), never `use`d; `use f()` takes a hook, so hooks compose.
// `throw` / `try` in a `@Component` body follow decision 121: legal only when
// `R` is a `@Result`.
//
// What a body reads from above it is a context: std's `context` module
// declares `Context<T>` and the two hooks `provide(ctx, value)` and
// `context(ctx) -> T` (`use` only, inside a render tree — never in a
// decorator body, a template body or a `comptime { … }`). Every `@Component`
// function takes a hidden context map; `provide` makes the children's map and
// `context` looks it up, `context-unbound` at run time when no provider is
// above.

pub behavior Renderable {}

pub behavior Component<R> extends Task {}

// ── annotation marker ────────────────────────────────────────────────────────
//
// Any `type` whose `implement` clause lists `Annotation` may
// be used as a builtin-style annotation: `#[MyMarker(field: value, …)]` on a
// declaration is checked as a constructor call to the type — the same arity,
// named-arg, default-value rules that govern any fn parameter list. For an
// enum, each variant is a separate annotation key
// (`#[External.Erlang("template")]` uses the `Erlang` variant's params).
//
// `checkAnnotation(self, decl: Decl)` runs at comptime over the annotated
// declaration: implementers use it to enforce placement rules (e.g. "this
// marker is valid only on `declare fn`") or to surface diagnostics. The
// default is a no-op so a marker may carry no policy; the type IS the
// annotation, and its codegen-side meaning is what readers (lib/framework
// code) make of it.

pub behavior Annotation {
    default fn checkAnnotation(self: Self, comptime decl: Decl) {}
}

// ── External — host-backed lowering ──────────────────────────────────────────
//
// One variant per target. The single `template` string is interpreted by the
// codegen renderer (`comptime/primOpTemplate.zig`): if it contains `$`, it's a
// template with positional markers over the declared parameters (`$0` is `self`
// on a method, then `$1`, … — decision 5; `$stringify(…)` is no marker and is
// refused, `template-stringify-marker`, decision 239);
// otherwise it's a bare host symbol (`"mod:sym"`/`"propertyName"`) the backend
// wraps as `mod:sym(args, self)` or `recv.propertyName(args)`.
//
// Usage:
//
//   #[External.Erlang("lists:member($1, $0)"),
//     External.Node("$0.includes($1)")]
//   fn contains(self: Array<T>, x: T) -> bool
//
// The `inline` flag opts a `(target, method)` pair out of the dispatch table
// so the backend's hand-coded shape keeps emitting (used only for arms whose
// lowering escapes the template grammar — list-cons / BIF aliases / etc.).
//
// F9 — it is declared on `Erlang` and `Beam` and NOWHERE ELSE, because those
// are the two emitters that read it: each has a `hasExternalInline` that skips
// the dispatch entry when the flag is set, reading the annotation's LAST
// argument. `Node` declared it too and no JS path ever consulted it, so
// `#[@External.Node("charAt", inline = true)]` was a switch that silently did
// nothing — a configuration that looks like it bypasses the dispatch table and
// does not, which decision 67 refuses in exactly those words. `Wasm` and
// `Typescript` do not gain it for the same reason. The checker holds this
// block to its word (`comptime/infer.zig` `external_variants`, kept in step
// with the declaration below by a drift test): `inline` written on `Node`,
// `Wasm` or `Typescript`, written anywhere but last, or given a value that is
// not a bool is refused at the annotation
// (`tests/language/reject/external_inline_unread`). A backend that grows a
// hand-coded shape worth opting out of adds the parameter here, the table row
// and the `hasExternalInline` that honours it, in one change.
//
// F9, the other half — `External` is not `Target`, because `Target` is a value
// a program holds and compares (`Target.Node`) while `External.<T>` is an
// annotation whose every variant carries a payload the compiler reads (the
// template, and on two of them the flag), and one enum cannot be both a value
// and an annotation with per-variant parameters. The names coincide because
// there are five backends; that is the only thing they share.

pub type External implement Annotation {
    Erlang(template: string, inline: bool = false),
    Node(template: string),
    Beam(template: string, inline: bool = false),
    Wasm(template: string),
    Typescript(template: string),
}

// ── builtin functions (decision 252) ────────────────────────────────────────
//
// Every `@name(…)` a program can call is declared here (or, for the two with a
// literal default, in the sibling `builtins_fns.d.bp`): bodyless, because the
// compiler IS the body, and without `#[@External.<Target>]` unless a host
// supplies it. The compiler's own table of what it implements is
// `modules/compiler-core/src/comptime/builtins.zig`; a unit test there parses
// both files and fails, naming the builtin, when a builtin is implemented and
// not declared, declared and not implemented, or declared with another
// signature. A call is checked against the declaration (its arity and its
// argument types — `builtin-arguments` names the declaration), except where a
// builtin's own rule refuses first (`@src`, `@typeInfo`,
// `@comptimeError`).
//
// A builtin marked COMPTIME-ONLY is evaluated while the program is checked or
// while a decorator / template body runs, and never reaches run time.

// `@trap()` stops the program at once, with no message.
pub declare fn trap() -> noreturn;

// `@block { … }` — a block that is an expression: its value is what its
// `return`s carry (they target the block, not the enclosing fn). A tail
// expression is not its value: an `@block` used as a value with no valued
// `return` is refused (`block-tail-value`).
pub declare fn block<T>(body: fn() -> T) -> T;

// `@field(obj, "name")` — the field `name` of `obj`, the name known at
// compile time: typed as that field when `obj` is a known non-generic record,
// otherwise left open. COMPTIME-ONLY name.
pub declare fn field<T, F>(obj: T, comptime name: string) -> F;

// `@src()` — the place it is written, as a `SourceLocation` (decision 73;
// the section below). COMPTIME-ONLY: rewritten into the constructor call.
pub declare fn src() -> SourceLocation;

// `@module()` — declared, and refused at every call (`builtin-not-lowered`):
// no target lowers a module value.
pub declare fn module() -> module;

// `@typeInfo(T)` — the reflection of the declaration `T` (decisions 216, 248,
// 253): `@typeInfo(City).name` and `@typeInfo(City).meta.<decorator>.<key>`
// are string constants (the only members read today). COMPTIME-ONLY: no
// run-time code. The program's catalogue is the static `@TypeInfo.all` of the
// answer's type (below).
pub declare fn typeInfo<T>(comptime _: type) -> TypeInfo<T>;

// `@TypeOf(value)` — the type of `value`, as the expression's type.
// COMPTIME-ONLY.
pub declare fn TypeOf<T>(value: T) -> T;

// `@makeRecord(fields)` — a record type built from field descriptors, its
// type open to inference. COMPTIME-ONLY.
pub declare fn makeRecord<R>(fields: RecordField[]) -> R;

// `@RecordKeys(T)` — the field names of the record type `T`. COMPTIME-ONLY.
pub declare fn RecordKeys(comptime _: type) -> string[];

// `@comptimeError(message)` — fails the check with `comptime error:
// <message>` at the call. COMPTIME-ONLY.
pub declare fn comptimeError(comptime message: string) -> noreturn;

// Contribute generated top-level declarations to the program from a decorator
// body. `@emit("pub val userServiceSingleton = …")` parses `source` as botopink
// declarations and splices them into the annotated declaration's module, so a
// decorator can build wiring (singletons, a DI graph, a router table) as
// ordinary code. May be called any number of times; each call appends.
// COMPTIME-ONLY.
pub declare fn emit(source: string);

// `@compilerError(message)` — a decorator or template body rejects the
// declaration it runs over with `message`. COMPTIME-ONLY.
pub declare fn compilerError(message: string) -> noreturn;

// `@expr(value)` lifts a comptime value as code, `@code(text)` parses
// generated source text; both only inside a template function
// (`-> @Expr<…>`). COMPTIME-ONLY.
pub declare fn expr<T>(comptime value: T) -> Expr<T>;

pub declare fn code<T>(text: string) -> Expr<T>;

// `todo` and `panic` live in the sibling `builtins_fns.d.bp` so the compiler's
// `registerStdlib` can parse them into the global env (each has a trailing
// literal default that `expandTrailingDefaults` injects at the call site).

// ── target enum ──────────────────────────────────────────────────────────────

pub type Target { Node, Typescript, Erlang, Beam, Wasm }

// ── effect return rules (the checker's side of the wrappers above) ─────────
//
// §1 — auto-wrap. The compiler intercepts `return v;` in a body whose return
// carries `@Result<U, E>` and lowers it to `Ok(v)` (a value already a
// `@Result` passes through); `throw e;` lowers to `Error(e)` — returned from a
// `@Result` / `@Task` / `@Component` body, and emitted as the last item of an
// `@Iterator` / `@Stream` body (`throw e` ≡ `break Error(e)`). Manual
// `Result.Ok(…)` / `Result.Error(…)` construction as a `return` / `throw`
// operand is rejected (R11/R12) — the variants are built by the sigils.
//
// §1C — `use`. The body of a `-> @Component<R>` fn may `use` hooks — each
// one's operand a hook, never a component — and `await` (`Component`
// extends `Task`); `yield` is not legal there.
//
// §1G — default generic parameters. A generic parameter may carry a
// default type (`<T, U = string>`). Defaults must occupy the trailing
// positions of the list — once a parameter declares a default, every
// following parameter must too. `struct Container<T = i32, U>` is
// rejected at parse time (R16 / RG1). Omitted trailing args resolve to
// their declared defaults; missing required args (RG3) and skipped
// middle args (RG4) are rejected.
//
// ── Host — raw-infra backed functions ────────────────────────────────────
//
// Marks a function whose real body lives in the wat backend's raw-infra
// prelude (unreachable, fd_write, bump allocator — operations bp can't
// express). The wat backend skips `#[@Host]` fns during codegen; the prelude
// in `codegen/wat/wat_prelude.zig` is what supplies such bodies. Nothing in
// the tree carries `#[@Host]` today: a `#[@Host]` fn with no matching prelude
// entry emits nothing and is not diagnosed.
//
// Usage:
//   #[@Host] pub fn failRaw(message: i32, param: i32, span: i32) {}
pub type Host implement Annotation {
    /// The function body is provided by the host's raw-infra WAT block.
    host,
}

// ── Expr template model (std.syntax) ─────────────────────────────────────────
// Data model for `Expr` templates. Interfaces are pure behaviour contracts, so
// the companion types are top-level declarations (siblings of `Expr<E>`), not
// nested members.

pub type Span(
    start: i32,
    end: i32,
    line: i32,
)

// One segment of a template: raw text, or a `${…}` interpolation hole whose
// expression was already type-checked in the caller's scope (string holes —
// interpolation follows the language's `+` coercion).
pub type Part {
    Text(text: string, span: Span),
    Interp(hole: Expr<string>, span: Span),
}

// What kind of top-level declaration a scope lookup resolved to.
pub type BindingKind {
    Fn,
    Val,
    Record_,
    Enum,
    Interface,
}

// A name resolved in an expression's origin scope (V1: the caller module's
// top-level declarations + imports — function locals are not visible).
pub type Binding(
    name: string,
    kind: BindingKind,
)

// Where an expression was written: the declaration position in the origin file.
// `file` is the module path ("" for main); `line`/`col` point at the template
// literal's opening quote (1-based).
pub type Source(
    file: string,
    line: i32,
    col: i32,
)

// Everything a second-layer language (a DSL compiler running inside a template
// function) needs about its input in one object: where the template was
// declared, its raw text, and its shape. The origin scope is reached via
// `lookup`/`bindings`; the segmented view via `parts`.
//
// F1 — this record is `ExprContext`, not `Context`: `Context<T>` is std's
// context object (decision 354). `q.context()` still reads `context`, because
// a method names the receiver's own input rather than a type.
pub type ExprContext(
    source: Source,
    text: string,
    multiline: bool,
)

// ── ExprCustom carrier (expr-custom) ─────────────────────────────────────────
// A node of ANY embedded sub-language, in one canonical shape the core and the
// tooling understand WITHOUT knowing the language. A second-layer language (an
// `Expr` template that lexes/parses its own DSL) converts its private AST into
// `CustomNode`s at the boundary; the core never branches on the contents.
// `kind`/`label` are opaque tags the lib picks; `span` indexes the
// `Expr<string>` source text; `ref` optionally ties a node (a queried
// collection, a column, …) to a caller-scope symbol via a `lookup` result.
pub type CustomNode(
    kind: string, // lib-chosen tag: "select" / "field" / "predicate" / "literal" …
    span: Span, // offsets into the template's source text
    label: string, // tooling token category: "keyword"/"property"/"string"/"number"/"operator"
    ref: ?Binding, // optional association to an origin-scope symbol
    children: CustomNode[],
)

// What `@ExprCustom<T>` carries: the executable expression plus the reference
// tree. The `code` half travels the ordinary `Expr<T>` expansion path (spliced,
// lowered to every backend — runtime behaviour is unchanged); the `ast` half is
// stored by call-location and is reference-only (the language server reads it).
pub type ExprCustom<T>(
    code: Expr<T>, // the botopink expression that actually runs
    ast: CustomNode, // the sub-language tree, reference only
)

pub behavior Expr<E> {
    fn text(self: Self<E>) -> string;
    fn parts(self: Self<E>) -> Part[];
    fn source(self: Self<E>) -> Source;
    fn context(self: Self<E>) -> ExprContext;
    fn lookup(self: Self<E>, name: string) -> ?Binding;
    fn bindings(self: Self<E>) -> Binding[];
    fn build<R>(self: Self<E>, source: string) -> Expr<R>;
    // Pack a reference tree + the executable code into the custom return — a
    // template fn opts into tooling visibility by returning `ExprCustom<T>`.
    fn custom<R>(
        self: Self<E>,
        ast: CustomNode,
        code: Expr<R>,
    ) -> ExprCustom<R>;
    fn fail(self: Self<E>, message: string);
    fn failAt(self: Self<E>, span: Span, message: string);
}

// ── Source location (`@src()`) ───────────────────────────────────────────────
// The place a `@src()` is written, as a value (1.0.10-beta decision 73). The
// builtin is evaluated at compile time: the checker rewrites `@src()` into the
// ordinary constructor call `SourceLocation(file: "…", line: N, column: C,
// fnName: "…")` with four literals, so every backend lowers it through its
// record-constructor path and nothing runs at run time.
//
//   file    — the source file relative to the root of the package it belongs
//             to, forward slashes, extension included (`src/emilia.bp`,
//             `test/color_test.bp`); `main.bp` in the compiler's own harness.
//   line    — 1-based line of the `@` character.
//   column  — 1-based column of the `@` character (what a diagnostic prints).
//   fnName  — the enclosing fn's name; `Type.method` inside a method; the test
//             name inside `test "…" { }` (`test_<idx>` for an anonymous
//             block); `""` at module level. A lambda does not change it.
//
// `@src()` takes no arguments and no trailing lambda — `@src(x)` is
// `error[src-takes-no-arguments]`. It is a value like any other, so
// `@src().line` reads a field in place. `std/asserts` and `std/snapshots`
// are written against the caller's `@src()`: a helper never takes its own.
//
// The declaration the checker registers is the one in `comptime.zig`'s
// `decl_reflection_src`; keep the two in sync.
pub type SourceLocation(
    file: string,
    line: i32,
    column: i32,
    fnName: string,
)

// ── Decl reflection model (annotation processors) ────────────────────────────
// Read-only reflection of the declaration a decorator is attached to. A decorator
// is an ordinary comptime function whose first parameter is `comptime _: Decl`;
// when `#[d(args)]` is applied, the core serializes the annotated declaration into
// a `Decl` handle and runs the body, exactly like an `Expr` template capture.
// The lib (rakun, …) — never the core — gives the marker meaning: validate
// placement/arguments via `fail`/`failAt`, and (later) contribute generated
// wiring. The core only provides the protocol (recognize → reflect → invoke).

// Which kind of top-level declaration the annotation sits on.
pub type DeclKind {
    Type,
    Behavior,
    Fn,
    Method,
    Field,
    // Decision 356 — a module-level `val`: `name`, `returnType` its declared
    // type as written (`""` when none); `setMeta` is legal, `addMember` /
    // `addType` are refused (a `val` owns no type).
    Val,
}

// One annotation entry on a reflected declaration (`#[name(args…)]`). `args`
// holds the raw argument lexemes in source order; `decorator` is the
// decorator the name names, resolved where the annotation is written — an
// alias (`#[srv]` after `import {serverOnly as srv}`) and a namespace
// (`#[web.route]`) give the declaration's identity, never the spelling
// (decision 277).
pub type DeclAnnotation(
    name: string,
    args: string[],
    decorator: Decorator,
)

// Every type name below (`Param.typeName`, `Field.typeName`,
// `Method.returnType`, `Decl.returnType`) is the type as the source spells it:
// `string`, `Array<string>`, `string[]`, `?i32`, `fn(i32) -> i32`,
// `#(string, string)`, `@Task<Element>` — never a bare head, never empty for a
// written type (a missing return type is `""`).

// One parameter of a reflected method/fn.
pub type Param(
    name: string,
    typeName: string,
)

// One field of a reflected record/struct, with its own annotations.
pub type Field(
    name: string,
    typeName: string,
    annotations: DeclAnnotation[],
)

// One method of a reflected record/struct/enum, with its own annotations.
pub type Method(
    name: string,
    params: Param[],
    returnType: string,
    annotations: DeclAnnotation[],
)

// The reflection handle, `@Decl<T>` (decision 280 (2)): `T` is the annotated
// declaration's type — the type itself, a field's type, a function's type —,
// bound when the decorator's signature names it (`fn index<T>(comptime decl:
// @Decl<T>, comptime ..fields: Type.Field<T>[])`), through a pattern too
// (`@Decl<fn(e: E) -> unknown>` binds `E`); a declaration that does not fit
// is refused at the annotation. `@Decl` is `@Decl<unknown>`. Every parameter
// after it is `comptime`.
// `kind`/`name`/`fields`/`variants`/`methods`/`returnType`/
// `annotations` are read-only data (serialized like a template's capture);
// `variants` lists an enum-shaped `type`'s variant and section names and is
// empty otherwise — `kind == DeclKind.Type && variants.length == 0` is a record;
// `fail`/`failAt` emit a scoped diagnostic at the annotated declaration, reusing
// the template diagnostic surface.
pub behavior Decl<T> {
    val kind: DeclKind;
    val name: string;
    val fields: Field[];
    val variants: string[];
    val methods: Method[];
    val returnType: string;
    val annotations: DeclAnnotation[];
    // Decision 277 — a function's hook graph: its own node, then the node of
    // every function reachable through its `use`s and calls of `@Component`
    // functions, breadth-first in body order, each function once. Empty for
    // any other declaration.
    val hooks: HookNode[];

    fn fail(self: Self, message: string);
    fn failAt(self: Self, span: Span, message: string);

    // Decision 216 (1) — give the annotated type a member, written as it would
    // be in the type's body: one `fn`, an associated fn or a method
    // (`decl.addMember("pub fn fromRow(r: Row) -> Self { … }")`). It is
    // ordinary run-time code of the type and travels with it to every
    // importer. From a field's or a method's decorator it joins the type that
    // owns the field or method; from a function's or a `val`'s it is refused
    // (`decorator-member-without-type`), and so is a name the type already
    // has (`decorator-member-duplicate`) or a source that is not one `fn`
    // (`decorator-member-not-one-fn`).
    fn addMember(self: Self, source: string);

    // Decision 216 (2) — record a comptime fact about the annotated
    // declaration, under this decorator's own name: `decl.setMeta("table",
    // "cities")` in `#[entity]` is read anywhere the declaration is reached as
    // `@typeInfo(City).meta.entity.table`, a string constant. It never becomes
    // run-time code. Set from a `type`'s, a `behavior`'s, a `fn`'s or a
    // `val`'s (decision 356) decorator (a field's or a method's is
    // `decorator-meta-on-member`), each key once (`decorator-meta-duplicate`).
    fn setMeta(self: Self, key: string, value: string);

    // Decision 216 (3) — declare a type that belongs to the annotated one,
    // named through it: `decl.addType("Columns", "(id: string)")` on `City`
    // is `City.Columns` — written in type positions, constructed as
    // `City.Columns(id: "x")`, its variants reached as `City.Size.Large` for
    // an enum shape (`"{ Small, Large }"`) — and imported with its owner.
    // `source` is the shape as it follows the name in a declaration. From a
    // field's or a method's decorator it belongs to the owning type; from a
    // function's or a `val`'s it is refused (`decorator-type-without-owner`), as are a
    // name that is not a type name (`decorator-type-name`), one the owner
    // already answers (`decorator-type-duplicate`) and a source that is not
    // the shape of one type (`decorator-type-not-one-type`).
    fn addType(self: Self, name: string, source: string);
}

// Decision 216 (4) — what `@TypeInfo.all(with: d)` answers: one `Declared`
// per declaration of the program carrying the decorator `d`, by module path
// then declaration order. `meta` is what `d` set on it (`decl.setMeta`);
// `value` is the function itself, or for a type a thunk calling the
// associated fn the query names (`@TypeInfo.all(with: d, member: "m")`),
// typed `unknown` (decision 254), or the `val` itself for a `val` (decision
// 356). `returnTypeName` is a function's declared return type as the source
// spells it (`"Clock"`), a `val`'s declared type (`""` when none), `""` for a
// type (decision 256). The compiler's mirror is `comptime.zig`
// `decl_reflection_src`.
pub type DeclaredMeta(
    key: string,
    value: string,
)

pub type Declared<T>(
    name: string,
    module: string,
    meta: DeclaredMeta[],
    returnTypeName: string,
    value: T,
)

// ── Hooks (decision 277) ────────────────────────────────────────────────────
// What `decl.hooks` lists. A `HookNode` holds only what is written in one
// function (`function`): each `use h(…)` (`HookUse`) and each call of a
// `@Component` function (`HookCall`), the calls a template builds from tags
// included, both in body order. `at` is `"<module>:<line>:<column>"` (the
// entry module is `main`). A cycle is an edge back to a listed node; a host
// function and std's `provide` / `context` get no node. In a decorator body a
// `Declared`'s `value` is `null` — no function of the program runs while it
// compiles — and its `meta` is every entry the declaration's decorators set,
// keyed `<decorator>.<key>`.
//
// `HookUse.hook` is the hook's declaration, `null` for a `use` over a function
// value; `annotations` are the hook's own; `typeArgs` the `use`'s explicit
// type arguments (`use params<BlogParams>()` → `[BlogParams]`, a record's
// fields as the checker spells them); `context` the context object a
// `use provide(C, …)` / `use context(C)` names (decision 354 (4)), `null` for
// any other hook.
pub type HookUse(
    hook: ?Declared<unknown>,
    annotations: DeclAnnotation[],
    at: string,
    typeArgs: TypeInfo<unknown>[],
    context: ?Declared<unknown>,
)

pub type HookCall(
    callee: Declared<unknown>,
    at: string,
)

pub type HookNode(
    function: Declared<unknown>,
    uses: HookUse[],
    calls: HookCall[],
)

// ── Decorator (decision 268) ────────────────────────────────────────────────
// The type of a decorator's NAME. A name has type `Decorator` when it names a
// function whose first parameter is `comptime _: @Decl` (a decorator with
// further arguments included) and which has a body; nothing else is
// assignable to it — no literal, no ordinary function, no value of another
// type — and it cannot be constructed or written as a value. A `Decorator[]`
// is an array literal of such names. The checker gives a name the type where
// a `Decorator` is expected (`infer.zig` `decoratorArgumentType`).
pub behavior Decorator {}

// ── TypeInfo (decisions 216, 248, 253, 254, 268) ─────────────────────────────
// What `@typeInfo(T)` answers. Its members are read at compile time:
// `name` and `meta.<decorator>.<key>` today, as string constants
// (`typeinfo-unknown-member` refuses the others until they are answered).
// `all` is the program's catalogue, a STATIC method called as
// `@TypeInfo.all(with: d)` or `@TypeInfo.all(with: [a, b], member: "m")`:
// every declaration carrying one of the listed decorators, always as
// `Declared<unknown>[]` (decision 254), whatever the program declares — a use
// narrows `value` with `is`. `with:` is held to its type like any argument
// (decision 252): anything but a decorator's name, or an array of them, is
// the ordinary mismatch at the argument. The catalogue's own rule keeps the
// arguments' shape (`typeinfo-all-arguments`: labelled, `member:` a string
// literal, no spread, no decorator listed twice).
// COMPTIME-ONLY: the answer is built while the program is checked.
// The compiler's mirror is `comptime.zig` `type_info_src`.
pub type TypeInfo<T>(
    name: string,
    module: string,
    fields: Field[],
    methods: Method[],
    meta: DeclaredMeta[],
) {
    declare fn all(
        with: Decorator | Decorator[],
        member: ?string = null,
    ) -> Declared<unknown>[];
}

// One field descriptor `@makeRecord` builds a record type from.
pub type RecordField(
    name: string,
    typeName: string,
)

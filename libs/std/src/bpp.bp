//// std/bpp — the contract between the toolchain and a framework that unfolds
//// `.bpp` files (decision 361). An application names one package in its
//// manifest, `"bpp": "jhonstart"`, and the toolchain finds four roles in that
//// package by these annotations — nothing else about the package is known to
//// it:
////
////   `#[bpp.html]`         the template function the markup unfolds onto
////                         (exactly one in the package);
////   `#[bpp.style]`        the template function the style section unfolds
////                         onto (at most one);
////   `#[bpp.htmlPrelude]`  the marker `val` of the markup's prelude module
////                         (at most one): that module's imports are what a
////                         `.bpp` file resolves without importing (270);
////   `#[bpp.stylePrelude]` the same for the style section (at most one).
////
//// A module takes no annotation (315), so a prelude is marked by a `val` it
//// declares — `#[bpp.htmlPrelude] pub val prelude = bpp.Prelude();` — whose
//// value is the empty record `Prelude`. Each annotation is a decorator in
//// 302's shape and checks only where it sits: a template function answering
//// `@ExprCustom<R>` (275 reads `R` from it) for the two template roles, a
//// `val` for the two prelude roles. How many of each a package carries, and
//// what else a prelude module declares, is the toolchain's check
//// (`compiler-cli`, front 116).
////
//// A root module (decision 106): pure, no import.

// The value of a prelude module's marker `val`.
pub type Prelude()

// The markup's unfold target: the template function `html """…"""` a `.bpp`
// file's markup becomes.
pub fn html(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Fn)
        decl.fail(
            "#[bpp.html] annotates the template function a .bpp file's markup unfolds onto — `"
                + decl.name
                + "` is not a function",
        );
    if (!decl.returnType.startsWith("@ExprCustom<"))
        decl.fail(
            "#[bpp.html] annotates a template function answering `@ExprCustom<R>` — `"
                + decl.name
                + "` answers `"
                + decl.returnType
                + "`",
        );
}

// The style section's unfold target: the template function the section
// between `--- style ---` and `---` becomes (`use <style> """…""";`).
pub fn style(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Fn)
        decl.fail(
            "#[bpp.style] annotates the template function a .bpp file's style section unfolds onto — `"
                + decl.name
                + "` is not a function",
        );
    if (!decl.returnType.startsWith("@ExprCustom<"))
        decl.fail(
            "#[bpp.style] annotates a template function answering `@ExprCustom<R>` — `"
                + decl.name
                + "` answers `"
                + decl.returnType
                + "`",
        );
}

// The markup's prelude: the marker `val` of the module whose imports a
// `.bpp` file's markup and header resolve through.
pub fn htmlPrelude(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Val)
        decl.fail(
            "#[bpp.htmlPrelude] annotates the marker `val` of a prelude module (`pub val prelude = bpp.Prelude();`) — `"
                + decl.name
                + "` is not a val",
        );
}

// The style section's prelude: the marker `val` of the module whose imports
// a `.bpp` file's style section resolves through.
pub fn stylePrelude(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Val)
        decl.fail(
            "#[bpp.stylePrelude] annotates the marker `val` of a prelude module (`pub val prelude = bpp.Prelude();`) — `"
                + decl.name
                + "` is not a val",
        );
}

test "bpp: a prelude marker's value is the empty record" {
    val marker = Prelude();
    assert marker == Prelude();
}

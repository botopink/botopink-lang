//// std/io/clock (was std/time) — wall-clock primitives, cross-backend.
////
//// Reference:
////   Node.js  — https://nodejs.org/api/  (the `Date` global, the
////              `Date.now()` static method in particular)
////   Erlang   — https://www.erlang.org/doc/man/erlang.html#system_time-1
////              (`erlang:system_time(Unit)` — `Unit` may be an integer
////              divisor `1`, `1000`, `1000000`, `1000000000`)
////
//// `nowMillis()` returns Unix epoch milliseconds on every backend. The
//// implementation lowers to `Date.now(1000)` on Node — `Date.now/0`
//// silently ignores the extra arg (JS variadic) — and to
//// `erlang:system_time(1000)` on Erlang, where the integer `1000`
//// selects the millisecond unit. The split exists because the bare-symbol
//// `#[@External.<Target>]` form cannot inject a literal atom-style unit on the
//// Erlang side without a richer template (tracked under
//// prim-op-annotation); the integer divisor form is universal and
//// keeps the call signature 1-arg. The `#[@External.<Target>]`
//// annotation form (typed-enum) is the canonical surface.
////
//// `monotonicMillis()` returns the host's monotonic clock in
//// milliseconds — `performance.now()` on Node (DOM high-res timestamp,
//// floating point but assignable to the `i64` return on a backend that
//// has no integer-only clock without a chained `Math.floor`), and
//// `erlang:monotonic_time(1000)` on Erlang (integer divisor selects
//// milliseconds, matching the `nowMillis()` shape).
////
//// `measureMillis<T>(body)` composes `nowMillis()` calls — pure
//// botopink, no host call beyond what `nowMillis()` already lowers.
////
//// `sleep(ms)` blocks the caller (1.0.10-beta front 01): `Atomics.wait`
//// on Node, `timer:sleep/1` on Erlang. It is synchronous on purpose — the
//// `@Task` spelling (`delay`) lives in `std/async`.
////
//// Front 01 also adds the calendar half below the readings: `parseIso8601`
//// (RFC 3339, offset required), `toCivil` (UTC breakdown, ISO weekday),
//// `offsetMinutes` (host timezone), the `Duration` builders and
//// `deadline`/`isExpired`. Front 23 moves the file to `io/clock.bp`.
////
//// `formatIso8601(epochMillis)` renders an RFC-3339 / ISO-8601 string
//// for an epoch-milliseconds reading. Node uses `new Date($0).toISOString()`
//// (chained host call, §A2-wired); Erlang gates the divisor down to
//// whole seconds and supplies `[{unit, second}]` to
//// `calendar:system_time_to_rfc3339/2`. The cross-backend output agrees
//// modulo the fractional-second suffix — Node always renders `.000` for
//// integer-millisecond inputs, Erlang's BIF omits the fractional part
//// when `unit=second`. Callers that need byte-identical output across
//// backends should strip the `.000` suffix.

// Internal: read the host's current millisecond clock. The `unit`
// argument is `1000` for millis; Node `Date.now` ignores it, Erlang
// `erlang:system_time/1` uses it as the divisor selector.
#[external(.Node("Date.now($0)"), .Erlang("erlang:system_time($0)"))]
declare fn systemTimeWithUnit(unit: i32) -> i64;

// Milliseconds since the Unix epoch. Monotonic across reasonable clock
// drift on every backend; not adjusted for leap seconds.
pub fn nowMillis() -> i64 {
    return systemTimeWithUnit(1000);
}

// Internal: read the host's monotonic clock. `unit` is `1000` for
// millis on Erlang (`erlang:monotonic_time/1` uses the divisor selector);
// Node uses the §A2 commonJS template form (`performance.now($0)`)
// to keep the receiver bound — the legacy
// `#[@External.Node("performance", "now")]` form aliased `const x =
// performance.now` and stripped `this`, reding with `Value of "this"
// must be of type Performance` at the first call site. The template
// renders inline at every call to `monotonicTimeWithUnit(N)`.
// The answer is an `i64`: `performance.now()` is a fractional millisecond
// count, truncated to its whole milliseconds (decision 319's canonical form).
#[external(.Node("Math.floor(performance.now($0))"), .Erlang("erlang:monotonic_time($0)"))]
declare fn monotonicTimeWithUnit(unit: i32) -> i64;

// Monotonic milliseconds — the host's monotonic clock, suitable for
// elapsed-time measurements (use `nowMillis()` for the wall clock).
// Two consecutive `monotonicMillis()` reads on the same backend are
// non-decreasing; the relative scale matches `nowMillis()` (millisecond
// units). On Node the absolute origin is the Unix epoch (`Date.now()`)
// until §A2 wires `performance.now()`; on Erlang it is the host's
// monotonic origin (`erlang:monotonic_time/1`).
pub fn monotonicMillis() -> i64 {
    return monotonicTimeWithUnit(1000);
}

// Render `epochMillis` as an ISO-8601 / RFC-3339 timestamp string.
// Node: `new Date($0).toISOString()` (renders `YYYY-MM-DDTHH:MM:SS.sssZ`).
// Erlang: `calendar:system_time_to_rfc3339/2` with the `second` unit and
// the `Z` offset — the i64 millis floored to whole seconds before
// the BIF runs; the resulting binary lacks the millisecond fraction Node always
// emits. The `Z` offset keeps `calendar` from reading the host's local time,
// which ERTS refuses before 1902.
// Its domain is RFC 3339's (decision 497): past it the call aborts,
// naming the value, on every target (`checkRfc3339Domain`).
#[external(
    .Node("""(new Date($0).toISOString())"""),
    .Erlang("""(fun(__M) -> list_to_binary(calendar:system_time_to_rfc3339((__M - (((__M rem 1000) + 1000) rem 1000)) div 1000, [{unit, second}, {offset, "Z"}])) end)($0)"""),
)]
declare fn formatIso8601Host(epochMillis: i64) -> string;

pub fn formatIso8601(epochMillis: i64) -> string {
    checkRfc3339Domain("formatIso8601", epochMillis);
    return formatIso8601Host(epochMillis);
}

// The domain of `formatIso8601`, `toCivil` and `offsetMinutes` (decision
// 497): the epochs RFC 3339 writes, 0000-01-01T00:00:00Z …
// 9999-12-31T23:59:59.999Z, the same on every target. ECMAScript's `Date`
// holds a wider range and Erlang's `calendar` a different one, so the bound
// is checked here, before the host is reached.
fn earliestRfc3339Millis() -> i64 {
    return -62167219200000l;
}

fn latestRfc3339Millis() -> i64 {
    return 253402300799999l;
}

// Internal: abort when `epochMillis` is past RFC 3339's domain, naming the
// function and the value.
fn checkRfc3339Domain(what: string, epochMillis: i64) -> void {
    if (epochMillis < earliestRfc3339Millis()
        || epochMillis > latestRfc3339Millis())
        @panic(
            [
                "clock.",
                what,
                ": ",
                epochMillis.toString(),
                " is past RFC 3339's range, -62167219200000 to 253402300799999",
            ].join(""),
        );
}

// Measure how long `body` takes to evaluate, in milliseconds. Returns
// the body's result paired with the elapsed time. Uses `nowMillis()`
// (the wall clock) rather than `monotonicMillis()` for cross-backend
// f64/i64 unifier symmetry — both readings are i64-typed, so the
// difference stays in the integer arithmetic path on every target.
pub fn measureMillis<T>(body: fn() -> T) -> #(T, i64) {
    val start = nowMillis();
    val result = body();
    val elapsed = nowMillis() - start;
    return #(result, elapsed);
}

// ── 1.0.10-beta front 01 additions ──────────────────────────────────────────
//
// Parsing, the civil breakdown, the host timezone offset, durations,
// deadlines and `sleep`. The readings above are not edited.

// A UTC calendar breakdown of an epoch reading. `month` is 1–12, `day`
// 1–31, `weekday` ISO-8601 (Monday = 1 … Sunday = 7).
pub type Civil(
    year: i32,
    month: i32,
    day: i32,
    hour: i32,
    minute: i32,
    second: i32,
    weekday: i32,
)

// A span of time in milliseconds. Built by `millis`/`seconds`/`minutes`/
// `hours`, combined by `add`, read back by `toMillis`.
pub type Duration(millis: i64)

import {failure, failure.HostError};

// Parse an RFC 3339 timestamp (`2024-02-29T12:34:56Z`,
// `2024-02-29T12:34:56.789+02:00`) into epoch milliseconds. The date, the
// time AND the offset are required — a timestamp without an offset has no
// single instant, so it is an `Error`, not a guess at the host timezone.
// Node: `Date.parse` accepts far more than RFC 3339 (`"2024"`, `"Feb 1"`),
// so the template checks the RFC 3339 shape first, then parses; a shape or a
// date it refuses is its raise.
// Erlang: `calendar:rfc3339_to_system_time/2` in milliseconds; it raises on
// a malformed string.
// Both run under `result: true` (decisions 431, 490); `parseIso8601` makes
// the host's raise `ClockError.NotRfc3339` (decision 486).
#[external(
    .Node("""(() => { const __s = String($0); const __t = /^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt ][0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$/.test(__s) ? Date.parse(__s) : NaN; if (Number.isNaN(__t)) throw new Error('not an RFC 3339 timestamp'); return __t })()""", result: true),
    .Erlang("""calendar:rfc3339_to_system_time(binary_to_list($0), [{unit, millisecond}])""", result: true),
)]
declare fn parseIso8601Host(s: string) -> @Result<i64, HostError>;

// What `parseIso8601` refuses (decision 486).
pub type ClockError {
    NotRfc3339,
}

pub fn parseIso8601(s: string) -> @Result<i64, ClockError> {
    case parseIso8601Host(s) {
        Ok(v) -> return v;
        Error(_) -> throw ClockError.NotRfc3339;
    }
}

// The UTC civil breakdown of `epochMillis`.
// Node: the `getUTC*` readers of a `Date`; `getUTCDay` counts Sunday = 0,
// rotated to ISO (Monday = 1).
// Erlang: `calendar:system_time_to_universal_time/2` + `day_of_the_week/3`
// (already Monday = 1).
#[external(
    .Node("""(() => { const __d = new Date($0); return { year: __d.getUTCFullYear(), month: __d.getUTCMonth() + 1, day: __d.getUTCDate(), hour: __d.getUTCHours(), minute: __d.getUTCMinutes(), second: __d.getUTCSeconds(), weekday: ((__d.getUTCDay() + 6) % 7) + 1 } })()"""),
    .Erlang("""(fun(__M) -> {{__Y, __Mo, __D}, {__H, __Mi, __S}} = calendar:system_time_to_universal_time(__M, millisecond), #{year => __Y, month => __Mo, day => __D, hour => __H, minute => __Mi, second => __S, weekday => calendar:day_of_the_week(__Y, __Mo, __D)} end)($0)"""),
)]
declare fn toCivilHost(epochMillis: i64) -> Civil;

pub fn toCivil(epochMillis: i64) -> Civil {
    checkRfc3339Domain("toCivil", epochMillis);
    return toCivilHost(epochMillis);
}

// The host timezone's offset from UTC at `epochMillis`, in minutes EAST of
// UTC (`+02:00` is `120`) — the sign RFC 3339 writes. Node's
// `getTimezoneOffset` counts minutes WEST, so the template negates it.
// Erlang: local minus universal time of the same instant. ERTS reads no
// local time before 1902 (`universaltime_to_localtime` is a `badarg`), so an
// earlier instant is read at 1902-01-01T00:00:00Z — the zone's offset there,
// its local mean time in most zones.
#[external(
    .Node("""(0 - new Date($0).getTimezoneOffset())"""),
    .Erlang("""(fun(__M) -> __U = calendar:system_time_to_universal_time(erlang:max(__M, -2145916800000), millisecond), __L = calendar:universal_time_to_local_time(__U), (calendar:datetime_to_gregorian_seconds(__L) - calendar:datetime_to_gregorian_seconds(__U)) div 60 end)($0)"""),
)]
declare fn offsetMinutesHost(epochMillis: i64) -> i32;

pub fn offsetMinutes(epochMillis: i64) -> i32 {
    checkRfc3339Domain("offsetMinutes", epochMillis);
    return offsetMinutesHost(epochMillis);
}

// Internal: an `i32` read as an `i64` — std's `toI64()` (decision 319), which
// every `i32` fits, so no host cell is crossed.
fn wide(n: i32) -> i64 {
    return n.toI64();
}

pub fn millis(n: i32) -> Duration {
    return Duration(millis: wide(n));
}

pub fn seconds(n: i32) -> Duration {
    return Duration(millis: wide(n) * wide(1000));
}

pub fn minutes(n: i32) -> Duration {
    return Duration(millis: wide(n) * wide(60000));
}

pub fn hours(n: i32) -> Duration {
    return Duration(millis: wide(n) * wide(3600000));
}

pub fn add(a: Duration, b: Duration) -> Duration {
    return Duration(millis: a.millis + b.millis);
}

pub fn toMillis(d: Duration) -> i64 {
    return d.millis;
}

// ── 1.0.11-beta front 97: a duration written as text ────────────────────────

// Internal: the largest millisecond count `parseDuration` answers — 2^53 - 1
// (decision 498). A duration is handed on as a timer delay or a JSON number,
// both `f64`, which stop counting by one past 2^53; an `i64` itself is exact
// past it on every target (decision 319).
fn largestExactMillis() -> i64 {
    return 9007199254740991;
}

// Internal: the unit `text` ends in — `ms` before `s`, since `5ms` ends in
// both — and `""` when it ends in none of the five.
fn durationUnit(text: string) -> string {
    return if (text.endsWith("ms"))
        "ms"
    else if (text.endsWith("s"))
        "s"
    else if (text.endsWith("m"))
        "m"
    else if (text.endsWith("h"))
        "h"
    else if (text.endsWith("d"))
        "d"
    else
        "";
}

// Internal: the milliseconds of one `unit` of `durationUnit`.
fn unitMillis(unit: string) -> i64 {
    return if (unit == "ms")
        wide(1)
    else if (unit == "s")
        wide(1000)
    else if (unit == "m")
        wide(60000)
    else if (unit == "h")
        wide(3600000)
    else
        wide(86400000);
}

fn durationProblem(text: string, what: string) -> string {
    return ["clock.parseDuration: \"", text, "\" ", what].join("");
}

// Internal: the count `digits` spells — digits `0`–`9` only, no sign — or
// `-1` when it is not that and `-2` when it is but is beyond 2^53 - 1.
fn durationCount(digits: string) -> i64 {
    val signed = digits.startsWith("+") || digits.startsWith("-");
    if (signed) return wide(0 - 1);
    return case digits.parseInt() {
        Ok(n) -> n;
        Error(reason) -> wide(
            if (reason.endsWith("is out of range")) 0 - 2 else 0 - 1,
        );
    };
}

// The milliseconds a duration spells: digits, then ONE unit — `ms`, `s`, `m`
// (minutes), `h` or `d` — and nothing else: `"30s"` is `30000`, `"250ms"` is
// `250`, `"0s"` is `0`. Refused, as an `Error` naming the text: no unit
// (`"30"`), a fraction (`"1.5s"`), a sign, whitespace anywhere (`"30 s"`), an
// uppercase unit (`"30S"`), two units (`"1h30m"`), the empty string — the
// stricter of the two parsers this replaces — and a duration beyond
// 2^53 - 1 milliseconds, which a timer delay or a JSON number (an `f64`)
// would not hold exactly (decision 498).
pub fn parseDuration(text: string) -> @Result<i64, string> {
    val unit = durationUnit(text);
    val digits = text.slice(0, text.length() - unit.length());
    val count = if (unit == "") wide(0 - 1) else durationCount(digits);
    if (count == wide(0 - 1))
        throw durationProblem(
            text,
            "is not a duration: digits, then one unit of ms, s, m, h or d",
        );
    if (count == wide(0 - 2)) throw durationProblem(text, "is out of range");
    // Compared before multiplying: a count as long as `i64` allows would
    // overflow the product, which aborts the program, never answers.
    if (count > largestExactMillis() / unitMillis(unit))
        throw durationProblem(text, "is out of range");
    return count * unitMillis(unit);
}

// Block the caller for `ms` milliseconds.
// Node: `Atomics.wait` on a scratch `SharedArrayBuffer` — a synchronous
// sleep that parks the thread instead of spinning (the value never
// changes, so the wait always times out).
// Erlang: `timer:sleep/1` — parks the calling process only.
#[external(
    .Node("""(Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, Number($0)), undefined)"""),
    .Erlang("""(fun(__T) -> timer:sleep(__T), undefined end)($0)"""),
)]
pub declare fn sleep(ms: i32) -> void;

// The epoch reading `d` from now. A deadline is an absolute wall-clock
// value, so it survives being handed to another process (a cache entry, a
// session).
pub fn deadline(d: Duration) -> i64 {
    return nowMillis() + d.millis;
}

// True once the wall clock has passed `at`.
pub fn isExpired(at: i64) -> bool {
    return nowMillis() > at;
}

// ── tests ────────────────────────────────────────────────────────────────────

test "clock.nowMillis returns a positive epoch reading" {
    val t = nowMillis();
    assert t > 0;
}

test "clock.nowMillis is monotonic within a single tick window" {
    val t1 = nowMillis();
    val t2 = nowMillis();
    assert t2 >= t1;
}

test "clock.monotonicMillis is non-decreasing across two reads" {
    val a = monotonicMillis();
    val b = monotonicMillis();
    assert b >= a;
}

test "clock.measureMillis returns body result and non-negative elapsed" {
    val pair = measureMillis({ ->
        42
    });
    assert pair._0 == 42;
    assert pair._1 >= 0;
}

test "clock.formatIso8601 renders an ISO-8601 prefix for the current time" {
    val s = formatIso8601(nowMillis());
    assert s.startsWith("20") || s.startsWith("21");
    assert s.contains("T");
}

test "clock.parseIso8601 reads back formatIso8601 to the whole second" {
    val t = nowMillis();
    val whole = t - (t % wide(1000));
    // Erlang renders whole seconds, Node keeps the milliseconds: the read-back
    // lies between the truncated and the exact reading on both.
    val back = parseIso8601(formatIso8601(t)).unwrapOr(wide(0));
    assert back >= whole;
    assert back <= t;
    assert parseIso8601(formatIso8601(whole)).unwrapOr(wide(0)) == whole;
}

test "clock.parseIso8601 reads a fixed timestamp with fraction and offset" {
    assert parseIso8601("1970-01-01T00:00:01Z").unwrapOr(wide(0)) == 1000;
    assert parseIso8601("2024-02-29T12:34:56.789Z").unwrapOr(wide(0))
        == 1709210096789;
    assert parseIso8601("2024-02-29T14:34:56+02:00").unwrapOr(wide(0))
        == 1709210096000;
}

test "clock.parseIso8601 refuses what is not an RFC 3339 timestamp" {
    assert parseIso8601("not a date").isError();
    assert parseIso8601("2024").isError();
    assert parseIso8601("2024-02-29T12:34:56").isError();
}

test "clock.toCivil breaks a fixed reading into the same UTC fields" {
    // 2024-02-29T12:34:56.789Z was a Thursday (ISO weekday 4).
    val c = toCivil(parseIso8601("2024-02-29T12:34:56.789Z").unwrapOr(wide(0)));
    assert c.year == 2024;
    assert c.month == 2;
    assert c.day == 29;
    assert c.hour == 12;
    assert c.minute == 34;
    assert c.second == 56;
    assert c.weekday == 4;
    // 1970-01-04 was a Sunday: ISO weekday 7, not 0.
    assert toCivil(wide(259200000)).weekday == 7;
}

test "clock.offsetMinutes is a whole quarter-hour within the UTC offset range" {
    val off = offsetMinutes(nowMillis());
    assert off >= -720;
    assert off <= 840;
    assert off % 15 == 0;
}

test "clock.Duration builders agree and add" {
    assert toMillis(seconds(2)) == 2000;
    assert toMillis(minutes(1)) == toMillis(seconds(60));
    assert toMillis(hours(1)) == 3600000;
    assert toMillis(add(millis(250), seconds(1))) == 1250;
}

// The `Error` of `parseDuration(text)`, `""` when it parsed.
fn durationRefusal(text: string) -> string {
    return case parseDuration(text) {
        Ok(_) -> "";
        Error(reason) -> reason;
    };
}

test "clock.parseDuration reads digits and one unit as milliseconds" {
    assert parseDuration("30s").unwrapOr(wide(0 - 1)) == 30000;
    assert parseDuration("250ms").unwrapOr(wide(0 - 1)) == 250;
    assert parseDuration("5m").unwrapOr(wide(0 - 1)) == 300000;
    assert parseDuration("2h").unwrapOr(wide(0 - 1)) == 7200000;
    assert parseDuration("1d").unwrapOr(wide(0 - 1)) == 86400000;
    assert parseDuration("0s").unwrapOr(wide(0 - 1)) == 0;
    assert parseDuration("007s").unwrapOr(wide(0 - 1)) == 7000;
    assert parseDuration("30s").isOk();
    assert parseDuration("90m").unwrapOr(wide(0)) == toMillis(minutes(90));
}

test "clock.parseDuration refuses anything but digits and one unit, naming the text" {
    val why = "is not a duration: digits, then one unit of ms, s, m, h or d";
    assert durationRefusal("1.5s") == durationProblem("1.5s", why);
    assert durationRefusal("30") == durationProblem("30", why);
    assert durationRefusal("30 s") == durationProblem("30 s", why);
    assert durationRefusal("30S") == durationProblem("30S", why);
    assert durationRefusal("") == durationProblem("", why);
    assert durationRefusal("s") == durationProblem("s", why);
    assert durationRefusal("ms") == durationProblem("ms", why);
    assert durationRefusal("-30s") == durationProblem("-30s", why);
    assert durationRefusal("+30s") == durationProblem("+30s", why);
    assert durationRefusal(" 30s") == durationProblem(" 30s", why);
    assert durationRefusal("30s ") == durationProblem("30s ", why);
    assert durationRefusal("1h30m") == durationProblem("1h30m", why);
    assert durationRefusal("30sec") == durationProblem("30sec", why);
    assert durationRefusal("PT30S") == durationProblem("PT30S", why);
    assert durationRefusal("1e3s") == durationProblem("1e3s", why);
    assert durationRefusal("30s") == "";
    assert durationRefusal("30")
        == "clock.parseDuration: \"30\" is not a duration: digits, then one unit of ms, s, m, h or d";
}

test "clock.parseDuration refuses a duration an f64 would not hold exactly" {
    assert parseDuration("9007199254740991ms").unwrapOr(wide(0))
        == largestExactMillis();
    assert parseDuration("104249991d").unwrapOr(wide(0))
        == wide(104249991) * wide(86400000);
    assert durationRefusal("9007199254740992ms")
        == "clock.parseDuration: \"9007199254740992ms\" is out of range";
    assert durationRefusal("9007199254741s")
        == "clock.parseDuration: \"9007199254741s\" is out of range";
    assert durationRefusal("104249992d")
        == "clock.parseDuration: \"104249992d\" is out of range";
    assert durationRefusal("99999999999999999999999999h")
        == "clock.parseDuration: \"99999999999999999999999999h\" is out of range";
}

test "clock.deadline is in the future and isExpired reads the wall clock" {
    assert isExpired(deadline(seconds(60))).negate();
    assert isExpired(wide(0));
}

test "clock.sleep waits at least the asked monotonic milliseconds" {
    val before = monotonicMillis();
    sleep(20);
    val after = monotonicMillis();
    assert after - before >= 20;
}

                var tt = r;
                w = n * 6.07710050630396597660e-11;
                r = tt - w;
                w = n * 2.02226624879595063154e-21 - ((tt - r) - w);
                y0 = r - w;
                if (j - exponentField(y0) > 49.0) {
                    tt = r;
                    w = n * 2.02226624871116645580e-21;
                    r = tt - w;
                    w = n * 8.47842766036889956997e-32 - ((tt - r) - w);
                    y0 = r - w;
                }
            }
        }
        y1 = (r - y0) - w;
        if (neg) {
            y0 = -1.0 * y0;
            y1 = -1.0 * y1;
            n = -1.0 * n;

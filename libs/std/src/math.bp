// fdlibm's `__kernel_tan`: tan(x + y) for `iy` 1, -1/tan(x + y) for -1.
fn kernelTan(x0: f64, y0: f64, iy: f64) -> f64 {
    val neg = signBit(x0);
    val ix = highWord(x0);
    if (ix < 1043333120.0) {
        if (isZero(ix) && isZero(lowWord(x0)) && iy == -1.0)
            return 1.0 / abs(x0);
        if (iy == 1.0) return x0;
        val w0 = x0 + y0;
        val z0 = withLowZero(w0);
        val v0 = y0 - (z0 - x0);
        val a0 = -1.0 / w0;
        val t0 = withLowZero(a0);
        val s0 = 1.0 + t0 * z0;
        return t0 + a0 * (s0 + t0 * v0);
    }
    var x = x0;
    var y = y0;
    val big = ix >= 1072010280.0;
    if (big) {
        if (neg) {
            x = -1.0 * x;
            y = -1.0 * y;
        }
        val zb = 7.85398163397448278999e-01 - x;
        val wb = 3.06161699786838301793e-17 - y;
        x = zb + wb;
        y = 0.0;
    }
    val z = x * x;
    val w = z * z;
    var r = 1.33333333333201242699e-01
        + w
            * (2.18694882948595424599e-02
                + w
                    * (3.59207910759131235356e-03
                        + w
                            * (5.88041240820264096874e-04
                                + w
                                    * (7.81794442939557092300e-05
                                        + w * -1.85586374855275456654e-05))));
    val v = z
        * (5.39682539762260521377e-02
            + w
                * (8.86323982359930005737e-03
                    + w
                        * (1.45620945432529025516e-03
                            + w
                                * (2.46463134818469906812e-04
                                    + w
                                        * (7.14072491382608190305e-05
                                            + w
                                                * 2.59073051863633712884e-05)))));
    val s = z * x;
    r = y + z * (s * (r + v) + y);
    r = r + 3.33333333333334091986e-01 * s;
    val ww = x + r;
    if (big) {

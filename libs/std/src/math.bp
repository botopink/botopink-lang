// ── pow ──────────────────────────────────────────────────────────────────────
// glibc's `pow` (`sysdeps/ieee754/dbl-64/e_pow.c`, the algorithm since glibc
// 2.28, from Arm's optimized-routines) as x86-64 glibc runs it: the
// `__ieee754_pow_fma` build, whose compiler fused each `a * b + c` it could
// into one rounding. Every target runs this body (decision 259), so a pow is
// the same bits everywhere and Linux's `Math.pow` and `math:pow` bit for bit:
// `pow(158.42161580281933, 2.853827476501465)` is `1896229.4525711867`.
// log|x| is carried in double-double from a 128-entry table (`powInvc`,
// `powLogc`, `powLogctail` — glibc's `__pow_log_data`), e^(y·log|x|) from the
// 128 values of 2^(j/128) (`expHead`, `expTail` — `__exp_data`); the tables
// are glibc 2.44's, read from its libm. glibc's word operations are exact
// arithmetic here and each fused multiply-add is computed exactly
// (`fusedMultiplyAdd`). The special values are glibc's, after ECMA-262's two
// (`pow(x, NaN)` and `pow(±1, ±Infinity)` are NaN, where C answers 1), so
// commonJS answers what `Math.pow` answered.

// a + b − s exactly, for s the rounded sum (Knuth's two-sum).
fn sumError(a: f64, b: f64, s: f64) -> f64 {
    val bb = s - a;
    return (a - (s - bb)) + (b - bb);
}

// a·b − p exactly, for p the rounded product (Dekker's two-product).
fn productError(a: f64, b: f64, p: f64) -> f64 {
    val ca = 134217729.0 * a;
    val ah = ca - (ca - a);
    val al = a - ah;
    val cb = 134217729.0 * b;
    val bh = cb - (cb - b);
    val bl = b - bh;
    return ((ah * bh - p) + ah * bl + al * bh) + al * bl;
}

// The power of two of s's leading bit, for a normal s ≠ 0 (Rump, Zimmermann,
// Boldo and Melquiond's `ufp`: φ = 2^52 + 1, ψ = 1 − 2^-53).
fn unitInFirstPlace(s: f64) -> f64 {
    val q = 4503599627370497.0 * s;
    val r = 0.9999999999999999 * q;
    return abs(q - r);
}

// a + b rounded to odd: the exact sum when it is a double, else the one of
// its two neighbours whose last significand bit is 1.
fn sumRoundedToOdd(a: f64, b: f64) -> f64 {
    val s = a + b;
    val err = sumError(a, b, s);
    if (isZero(err)) return s;
    val f = unitInFirstPlace(s);
    val ulp = f * 2.220446049250313e-16;
    val mag = abs(s);
    val m = mag / ulp;
    if (m - 2.0 * floor(m * 0.5) == 1.0) return s;
    val away = (err > 0.0) == (s > 0.0);
    val stepped = if (away)
        mag + ulp
    else if (mag == f)
        mag - ulp * 0.5
    else
        mag - ulp;
    return if (s > 0.0) stepped else -1.0 * stepped;
}

// fma(a, b, c): a·b + c rounded once (Boldo and Melquiond's emulation — the
// exact product, a two-sum, one sum rounded to odd, one rounding to nearest).
fn fusedMultiplyAdd(a: f64, b: f64, c: f64) -> f64 {
    val uh = a * b;
    val ul = productError(a, b, uh);
    val th = c + uh;
    val tl = sumError(c, uh, th);
    return th + sumRoundedToOdd(tl, ul);
}

// 0 when `y` is not a whole number, 1 when it is odd, 2 when it is even
// (glibc's `checkint`).
fn wholeKind(y: f64) -> f64 {
    if (floor(y) != y) return 0.0;
    if (abs(y) >= 9007199254740992.0) return 2.0;
    val half = y * 0.5;
    return if (floor(half) == half) 2.0 else 1.0;
}

fn powBody(x: f64, y: f64) -> f64 {
    if (y != y) return y;
    val ax = abs(x);
    val ay = abs(y);
    val inf = 1.7976931348623157e308;
    if (ay > inf && ax == 1.0) return y - y;
    if (isZero(y) || x == 1.0) return 1.0;
    if (x != x) return x + y;
    if (ay > inf) return if ((ax < 1.0) == (y > 0.0)) 0.0 else ay;
    val odd = wholeKind(y) == 1.0;
    val nx = signBit(x);
    if (isZero(ax) || ax > inf) {
        // ±0 and ±Infinity: x², negated for an odd power of a negative x
        val x2 = if (nx && odd) -1.0 * (x * x) else x * x;
        return if (y < 0.0) 1.0 / x2 else x2;
    }
    if (nx && isZero(wholeKind(y))) return (x - x) / (x - x);
    if (ay < 2.710505431213761e-20 || ay >= 9.223372036854776e18) {
        if (ax == 1.0) return 1.0;
        if (ay < 2.710505431213761e-20)
            return if (ax > 1.0) 1.0 + y else 1.0 - y;
        return if ((ax > 1.0) == (y > 0.0))
            timesHuge(1.0, 1.0e300)
        else
            timesHuge(1.0, 1.0e-300);
    }
    // log|x| = k·ln2 + log c + log1p(z/c − 1), |x| = 2^k·z with z in
    // [0x1.69555p-1, 0x1.69555p0) and c near the middle of z's subinterval
    val sub = ax < 2.2250738585072014e-308;
    val xs = if (sub) ax * 4503599627370496.0 else ax;
    val e = exponentOf(xs);
    val m = xs * twoTo(0.0 - e);
    val big = m >= 1.4114580154418945;
    val z = if (big) m * 0.5 else m;
    val kz = if (big) e + 1.0 else e;
    val k = if (sub) kz - 52.0 else kz;
    val i = if (z < 1.0)
        floor((z - 0.7057290077209473) * 256.0)
    else
        floor((z - 1.0) * 128.0 + 75.3333740234375);
    val invc = powInvc(i);
    val logc = powLogc(i);
    val zc = z * invc;
    val r = (zc - 1.0) + productError(z, invc, zc);
    val t1 = k * 0.6931471805598903 + logc;
    val t2 = t1 + r;
    val lo1 = fusedMultiplyAdd(k, 5.497923018708371e-14, powLogctail(i));
    val lo2 = t1 - t2 + r;
    val ar = -0.5 * r;
    val ar2 = r * ar;
    val ar3 = r * ar2;
    val lhi = t2 + ar2;
    val lo3 = productError(ar, r, ar2);
    val lo4 = t2 - lhi + ar2;
    val q = fusedMultiplyAdd(
        ar2,
        fusedMultiplyAdd(
            ar2,
            fusedMultiplyAdd(r, 1.0000415263675542, -1.142909628459501),
            fusedMultiplyAdd(r, -0.6666666663487739, 0.7999999995323976),
        ),
        fusedMultiplyAdd(r, 0.5000000000000007, -0.6666666666666679),
    );
    val llo = fusedMultiplyAdd(ar3, q, lo1 + lo2 + lo3 + lo4);
    val l = lhi + llo;
    val ltail = lhi - l + llo;
    // e^(y·log|x|), y·log|x| carried as ehi + elo
    val ehi = y * l;
    val elo = fusedMultiplyAdd(y, ltail, productError(y, l, ehi));
    return powExp(ehi, elo, nx && odd);
}


// n mod 4 in 0..3 (fdlibm's `n & 3`).
fn quadrantOf(n: f64) -> f64 {
    return n - 4.0 * floor(n * 0.25);
}

fn sinBody(x: f64) -> f64 {
    val ix = highWord(x);
    if (ix <= 1072243195.0) return kernelSin(x, 0.0, 0.0);
    if (ix >= 2146435072.0) return x - x;
    val q = quadrantOf(remPio2(x, 0.0));
    val y0 = remPio2(x, 1.0);
    val y1 = remPio2(x, 2.0);
    return if (q < 0.5)
        kernelSin(y0, y1, 1.0)
    else if (q < 1.5)
        kernelCos(y0, y1)
    else if (q < 2.5)
        -1.0 * kernelSin(y0, y1, 1.0)
    else
        -1.0 * kernelCos(y0, y1);
}

fn cosBody(x: f64) -> f64 {
    val ix = highWord(x);
    if (ix <= 1072243195.0) return kernelCos(x, 0.0);
    if (ix >= 2146435072.0) return x - x;
    val q = quadrantOf(remPio2(x, 0.0));
    val y0 = remPio2(x, 1.0);
    val y1 = remPio2(x, 2.0);
    return if (q < 0.5)
        kernelCos(y0, y1)
    else if (q < 1.5)
        -1.0 * kernelSin(y0, y1, 1.0)
    else if (q < 2.5)
        -1.0 * kernelCos(y0, y1)
    else
        kernelSin(y0, y1, 1.0);
}

fn tanBody(x: f64) -> f64 {
    val ix = highWord(x);
    if (ix <= 1072243195.0) return kernelTan(x, 0.0, 1.0);
    if (ix >= 2146435072.0) return x - x;
    val odd = quadrantOf(remPio2(x, 0.0))
        - 2.0 * floor(quadrantOf(remPio2(x, 0.0)) * 0.5);
    return kernelTan(remPio2(x, 1.0), remPio2(x, 2.0), 1.0 - 2.0 * odd);
}

fn asinPoly(t: f64) -> f64 {
    val p = t
        * (1.66666666666666657415e-01
            + t
                * (-3.25565818622400915405e-01
                    + t
                        * (2.01212532134862925881e-01
                            + t
                                * (-4.00555345006794114027e-02
                                    + t
                                        * (7.91534994289814532176e-04
                                            + t
                                                * 3.47933107596021167570e-05)))));
    val q = 1.0
        + t
            * (-2.40339491173441421878e+00
                + t
                    * (2.02094576023350569471e+00
                        + t
                            * (-6.88283971605453293030e-01
                                + t * 7.70381505559019352791e-02)));
    return p / q;

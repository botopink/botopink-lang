// ── the bodies (decisions 238, 263) ────────────────────────────────────────
// Each transcendental's `fn:` binding names one of these private bodies:
// erlang, beam and wasm run them, so a transcendental answers the same bits
// on every target and every OS — not the platform libm OTP's `math:*` calls,
// which differs by an ulp between glibc and Apple's (`tan(1.0)`, `asin(0.5)`).
// commonJS keeps `Math.*`, because they are a port of the fdlibm code (Sun
// Microsystems, 1993) Node's V8 answers `Math.*` with
// (`deps/v8/src/base/ieee754.cc`): the same operations in the same order, so
// every target's answer is the commonJS answer bit for bit. `pow` is the one
// commonJS runs too (below). fdlibm reads and writes the two 32-bit words of
// a double; botopink has no bit operation, so the words are read and written
// with arithmetic that is exact (`highWord`, `lowWord`, `fromWords`,
// `withLowZero`). One part is not ported: the reduction of a trigonometric
// argument beyond 2^19·π/2 (`__kernel_rem_pio2`), which panics rather than
// answer a wrong value. wasm has an instruction for `abs`, `floor`, `trunc`,
// `sqrt`, `minF` and `maxF` (`op:`), which every target leaves to its host:
// IEEE 754 makes them exact.

// `Math.round`: V8's `Float64RoundUp(x)`, less one when that is more than a
// half above `x` — a half rounds UP (`round(2.5)` is 3, `round(-2.5)` is -2)
// and `-0.4` answers `-0`. `f64.nearest` rounds a half to even, which is why
// this is not an `op:`.
fn roundHalfUp(x: f64) -> f64 {
    val up = -1.0 * floor(-1.0 * x);
    return if (up - 0.5 > x) up - 1.0 else up;
}

// `s · h · h`: an overflow to ±Infinity (`h` = 1e300) or an underflow to ±0
// (`h` = 1e-300) as fdlibm writes them, with `h` a parameter so no target
// folds the product at compile time.
fn timesHuge(s: f64, h: f64) -> f64 {
    return s * h * h;
}

// 2^k for a whole k in -1074..1023 — every step exact.
fn twoTo(k: f64) -> f64 {
    var r = 1.0;
    var n = k;
    while (n >= 32.0) {
        r = r * 4294967296.0;
        n = n - 32.0;
    }
    while (n >= 1.0) {
        r = r * 2.0;
        n = n - 1.0;
    }
    while (n <= -32.0) {
        r = r * 2.3283064365386963e-10;
        n = n + 32.0;
    }
    while (n <= -1.0) {
        r = r * 0.5;
        n = n + 1.0;
    }
    return r;
}

// e with 2^e ≤ ax < 2^(e+1), for a positive finite ax.
fn exponentOf(ax: f64) -> f64 {
    var v = ax;
    var e = 0.0;
    while (v >= 4294967296.0) {
        v = v * 2.3283064365386963e-10;
        e = e + 32.0;
    }
    while (v >= 2.0) {
        v = v * 0.5;
        e = e + 1.0;
    }
    while (v < 2.3283064365386963e-10) {
        v = v * 4294967296.0;
        e = e - 32.0;
    }
    while (v < 1.0) {
        v = v * 2.0;
        e = e - 1.0;
    }
    return e;
}

// The 52-bit significand of a subnormal |x| as a whole number.
fn subnormalBits(ax: f64) -> f64 {
    return (ax * twoTo(1000.0)) * twoTo(74.0);
}

// fdlibm's `hx & 0x7fffffff`: the high 32-bit word of |x| as a whole number.
fn highWord(x: f64) -> f64 {
    if (x != x) return 2146959360.0;
    val ax = abs(x);
    if (isZero(ax)) return 0.0;
    if (ax > 1.7976931348623157e308) return 2146435072.0;
    val e = exponentOf(ax);
    if (e < -1022.0) return floor(subnormalBits(ax) / 4294967296.0);
    val m = ax * twoTo(0.0 - e);
    return (e + 1023.0) * 1048576.0 + floor((m - 1.0) * 1048576.0);
}

// fdlibm's low word: the low 32 bits of |x|'s significand.
fn lowWord(x: f64) -> f64 {
    val ax = abs(x);
    if (x != x || isZero(ax) || ax > 1.7976931348623157e308) return 0.0;
    val e = exponentOf(ax);
    val bits = if (e < -1022.0)
        subnormalBits(ax)
    else
        (ax * twoTo(0.0 - e) - 1.0) * 4503599627370496.0;
    return bits - floor(bits / 4294967296.0) * 4294967296.0;
}

// The positive double whose words are `hw` (below the sign) and `lw`.
fn fromWords(hw: f64, lw: f64) -> f64 {
    val ef = floor(hw / 1048576.0);
    val frac = (hw - ef * 1048576.0) * 4294967296.0 + lw;
    if (isZero(ef)) return (frac * twoTo(-1000.0)) * twoTo(-74.0);
    return (1.0 + frac / 4503599627370496.0) * twoTo(ef - 1023.0);
}

// fdlibm's `SET_LOW_WORD(x, 0)`.
fn withLowZero(x: f64) -> f64 {
    val v = fromWords(highWord(x), 0.0);
    return if (signBit(x)) -1.0 * v else v;
}

// Whether `v` carries a minus sign — `-0.0` included (fdlibm's `hx < 0`).
// commonJS and wasm compare `-0.0` equal to `0.0` and tell the two apart by
// `1 / v`; erlang and beam compare them unequal (`=:=`) and have no `1 / 0`.
fn signBit(v: f64) -> bool {
    if (v < 0.0) return true;
    if (v > 0.0) return false;
    if (v == 0.0 && v == -0.0) return 1.0 / v < 0.0;
    return v == -0.0;
}

// Whether `v` is `0.0` or `-0.0` — on every target: `v == 0.0` is false for
// `-0.0` on erlang and beam (`=:=`).
fn isZero(v: f64) -> bool {
    return v >= 0.0 && v <= 0.0;
}

// The exponent field of x's high word (`(hx >> 20) & 0x7ff`).
fn exponentField(x: f64) -> f64 {
    return floor(highWord(x) / 1048576.0);
}

// ── exp, expm1 ───────────────────────────────────────────────────────────────

fn expBody(x: f64) -> f64 {
    val hx = highWord(x);
    val neg = signBit(x);
    if (hx >= 1082535490.0) {
        if (hx >= 2146435072.0) {
            if (x != x) return x + x;
            return if (neg) 0.0 else x;
        }
        if (x > 7.09782712893383973096e+02) return timesHuge(1.0, 1.0e300);
        if (x < -7.45133219101941108420e+02)
            return timesHuge(1.0, 9.33263618503218878990e-302);
    }
    var hi = 0.0;
    var lo = 0.0;
    var k = 0.0;
    var r = x;
    if (hx > 1071001154.0) {
        if (hx < 1072734898.0) {
            if (x == 1.0) return 2.718281828459045;
            if (neg) {
                hi = x + 6.93147180369123816490e-01;
                lo = -1.90821492927058770002e-10;
                k = -1.0;
            } else {
                hi = x - 6.93147180369123816490e-01;
                lo = 1.90821492927058770002e-10;
                k = 1.0;
            }
        } else {
            val half = if (neg) -0.5 else 0.5;
            k = trunc(1.44269504088896338700e+00 * x + half);
            hi = x - k * 6.93147180369123816490e-01;
            lo = k * 1.90821492927058770002e-10;
        }
        r = hi - lo;
    } else if (hx < 1043333120.0) return 1.0 + x;
    val t = r * r;
    val twopk = if (k >= -1021.0) twoTo(k) else twoTo(k + 1000.0);
    val c = r
        - t
            * (1.66666666666666019037e-01
                + t
                    * (-2.77777777770155933842e-03
                        + t
                            * (6.61375632143793436117e-05
                                + t
                                    * (-1.65339022054652515390e-06
                                        + t * 4.13813679705723846039e-08))));
    if (isZero(k)) return 1.0 - ((r * c) / (c - 2.0) - r);
    val y = 1.0 - ((lo - (r * c) / (2.0 - c)) - hi);
    if (k >= -1021.0) {
        if (k == 1024.0) return y * 2.0 * 8.988465674311579539e307;
        return y * twopk;
    }
    return y * twopk * 9.33263618503218878990e-302;
}

fn expm1Body(x: f64) -> f64 {
    val hx = highWord(x);
    val neg = signBit(x);
    if (hx >= 1078159482.0) {
        if (hx >= 1082535490.0) {
            if (hx >= 2146435072.0) {
                if (x != x) return x + x;
                return if (neg) -1.0 else x;
            }
            if (x > 7.09782712893383973096e+02) return timesHuge(1.0, 1.0e300);
        }
        if (neg && x + 1.0e-300 < 0.0) return 1.0e-300 - 1.0;
    }
    var k = 0.0;
    var r = x;
    var c = 0.0;
    if (hx > 1071001154.0) {
        var hi = 0.0;
        var lo = 0.0;
        if (hx < 1072734898.0) {
            if (!neg) {
                hi = x - 6.93147180369123816490e-01;
                lo = 1.90821492927058770002e-10;
                k = 1.0;
            } else {
                hi = x + 6.93147180369123816490e-01;
                lo = -1.90821492927058770002e-10;
                k = -1.0;
            }
        } else {
            val half = if (neg) -0.5 else 0.5;
            k = trunc(1.44269504088896338700e+00 * x + half);
            hi = x - k * 6.93147180369123816490e-01;
            lo = k * 1.90821492927058770002e-10;
        }
        r = hi - lo;
        c = (hi - r) - lo;
    } else if (hx < 1016070144.0) return x;
    val hfx = 0.5 * r;
    val hxs = r * hfx;
    val r1 = 1.0
        + hxs
            * (-3.33333333333331316428e-02
                + hxs
                    * (1.58730158725481460165e-03
                        + hxs
                            * (-7.93650757867487942473e-05
                                + hxs
                                    * (4.00821782732936239552e-06
                                        + hxs * -2.01099218183624371326e-07))));
    val t = 3.0 - r1 * hfx;
    var e = hxs * ((r1 - t) / (6.0 - r * t));
    if (isZero(k)) return r - (r * e - hxs);
    val twopk = twoTo(k);
    e = r * (e - c) - c;
    e = e - hxs;
    if (k == -1.0) return 0.5 * (r - e) - 0.5;
    if (k == 1.0)
        return if (r < -0.25) -2.0 * (e - (r + 0.5)) else 1.0 + 2.0 * (r - e);
    if (k <= -2.0 || k > 56.0) {
        val y = 1.0 - (e - r);
        val scaled = if (k == 1024.0)
            y * 2.0 * 8.98846567431158e+307
        else
            y * twopk;
        return scaled - 1.0;
    }
    if (k < 20.0) {
        val t2 = fromWords(1072693248.0 - twoTo(21.0 - k), 0.0);
        return (t2 - (e - r)) * twopk;
    }
    val t3 = fromWords((1023.0 - k) * 1048576.0, 0.0);
    return ((r - (e + t3)) + 1.0) * twopk;
}

// ── logarithms ───────────────────────────────────────────────────────────────

// fdlibm's answer for what is not a positive finite number.
fn logSpecial(x: f64) -> f64 {
    if (x != x || x > 1.7976931348623157e308) return x + x;
    if (x < 0.0) return (x - x) / (x - x);
    return -1.0 / (x * x);
}

// `x` with its exponent set to 0 (or -1, when the mantissa's high bits pass
// √2's — fdlibm's `(hx + 0x95f64) & 0x100000`), and how much the exponent
// moved: `logScaled(x, 0)` answers the scaled `x`, `logScaled(x, 1)` the `k`.
fn logScaled(x: f64, which: f64) -> f64 {
    var k = 0.0;
    var v = x;
    if (x < 2.2250738585072014e-308) {
        k = -54.0;
        v = x * 1.80143985094819840000e+16;
    }
    val hw = highWord(v);
    val ef = floor(hw / 1048576.0);
    val m20 = hw - ef * 1048576.0;
    val up = m20 + 614244.0 >= 1048576.0;
    val carry = if (up) 1.0 else 0.0;
    k = k + ef - 1023.0 + carry;
    if (which > 0.5) return k;
    val field = if (up) 1071644672.0 else 1072693248.0;
    return fromWords(field + m20, lowWord(v));
}

// The high mantissa bits (`hx & 0xfffff`) the scaled `x` came from.
fn logMantissaBits(x: f64) -> f64 {
    val v = if (x < 2.2250738585072014e-308)
        x * 1.80143985094819840000e+16
    else
        x;
    val hw = highWord(v);
    return hw - floor(hw / 1048576.0) * 1048576.0;
}

fn lnBody(x: f64) -> f64 {
    if (x != x || x <= 0.0 || x > 1.7976931348623157e308) return logSpecial(x);
    val k = logScaled(x, 1.0);
    val f = logScaled(x, 0.0) - 1.0;
    val m20 = logMantissaBits(x);
    val ln2Hi = 6.93147180369123816490e-01;
    val ln2Lo = 1.90821492927058770002e-10;
    if (m20 >= 1048574.0 || isZero(m20)) {
        if (isZero(f)) return if (isZero(k)) 0.0 else k * ln2Hi + k * ln2Lo;
        val rr = f * f * (0.5 - 0.33333333333333333 * f);
        return if (isZero(k)) f - rr else k * ln2Hi - ((rr - k * ln2Lo) - f);
    }
    val s = f / (2.0 + f);
    val z = s * s;
    val w = z * z;
    val t1 = w
        * (3.999999999940941908e-01
            + w * (2.222219843214978396e-01 + w * 1.531383769920937332e-01));
    val t2 = z
        * (6.666666666666735130e-01
            + w
                * (2.857142874366239149e-01
                    + w
                        * (1.818357216161805012e-01
                            + w * 1.479819860511658591e-01)));
    val rr = t2 + t1;
    if (m20 >= 398458.0 && m20 <= 440401.0) {
        val hfsq = 0.5 * f * f;
        return if (isZero(k))
            f - (hfsq - s * (hfsq + rr))
        else
            k * ln2Hi - ((hfsq - (s * (hfsq + rr) + k * ln2Lo)) - f);
    }
    return if (isZero(k))
        f - s * (f - rr)
    else
        k * ln2Hi - ((s * (f - rr) - k * ln2Lo) - f);
}

// fdlibm's `k_log1p(f)`.
fn logOnePlusTail(f: f64) -> f64 {
    val s = f / (2.0 + f);
    val z = s * s;
    val w = z * z;
    val t1 = w
        * (3.999999999940941908e-01
            + w * (2.222219843214978396e-01 + w * 1.531383769920937332e-01));
    val t2 = z
        * (6.666666666666735130e-01
            + w
                * (2.857142874366239149e-01
                    + w
                        * (1.818357216161805012e-01
                            + w * 1.479819860511658591e-01)));
    val hfsq = 0.5 * f * f;
    return s * (hfsq + (t2 + t1));
}

fn log2Body(x: f64) -> f64 {
    if (x != x || x <= 0.0 || x > 1.7976931348623157e308) return logSpecial(x);
    if (x == 1.0) return 0.0;
    val y = logScaled(x, 1.0);
    val f = logScaled(x, 0.0) - 1.0;
    val hfsq = 0.5 * f * f;
    val r = logOnePlusTail(f);
    val hi = withLowZero(f - hfsq);
    val lo = (f - hi) - hfsq + r;
    val valHi = hi * 1.44269504072144627571e+00;
    val valLo = (lo + hi) * 1.67517131648865118353e-10
        + lo * 1.44269504072144627571e+00;
    val w = y + valHi;
    return (valLo + ((y - w) + valHi)) + w;
}

fn log10Body(x: f64) -> f64 {
    if (x != x || x <= 0.0 || x > 1.7976931348623157e308) return logSpecial(x);
    if (x == 1.0) return 0.0;
    var k = 0.0;
    var v = x;
    if (x < 2.2250738585072014e-308) {
        k = -54.0;
        v = x * 1.80143985094819840000e+16;
    }
    val hw = highWord(v);
    val ef = floor(hw / 1048576.0);
    k = k + ef - 1023.0;
    val i = if (k < 0.0) 1.0 else 0.0;

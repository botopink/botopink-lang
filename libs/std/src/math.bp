//// std/math — math functions and constants (cross-backend).
////
//// Reference:
////   Node.js  — https://nodejs.org/api/  (the `Math` global)
////   Erlang   — https://www.erlang.org/doc/apps/stdlib/math.html
////
//// Surface mirrors the intersection of `Math.*` (JS) and `math:*` (Erlang).
//// `floor`/`ceil`/`trunc`/`round` return `f64` (both Node and Erlang return
//// floating-point on the host, and staying in `f64` keeps mixed arithmetic
//// from running into i32/i64 unification issues in pure-botopink
//// derivations). Constants live as `pub val`; every host-bound fn carries
//// `#[@External.<Target>(…)]` per backend.

// ── constants ────────────────────────────────────────────────────────────────

pub val pi: f64 = 3.141592653589793;

pub val e: f64 = 2.718281828459045;

pub val tau: f64 = 6.283185307179586;

pub val sqrt2: f64 = 1.4142135623730951;

pub val ln2: f64 = 0.6931471805599453;

pub val ln10: f64 = 2.302585092994046;

pub val log2e: f64 = 1.4426950408889634;

pub val log10e: f64 = 0.4342944819032518;

// ── arithmetic + rounding ────────────────────────────────────────────────────
// `abs` works on `f64`. Integer abs lives on the numeric tower
// (`primitives.bp` Signed). `minF`/`maxF` are the float variants — the
// generic ones live on `Number`.

#[@External.Node("Math", "abs")]
#[@External.Erlang("erlang", "abs")]
#[@External.Beam("erlang", "abs")]
#[@External.Wasm("op:f64.abs")]
pub declare fn abs(x: f64) -> f64;

#[@External.Node("Math", "floor")]
#[@External.Erlang("math", "floor")]
#[@External.Beam("math", "floor")]
#[@External.Wasm("op:f64.floor")]
pub declare fn floor(x: f64) -> f64;

#[@External.Node("Math", "round")]
#[@External.Erlang("erlang", "round")]
#[@External.Beam("erlang", "round")]
#[@External.Wasm("fn:roundHalfUp")]
pub declare fn round(x: f64) -> f64;

#[@External.Node("Math", "trunc")]
#[@External.Erlang("erlang", "trunc")]
#[@External.Beam("erlang", "trunc")]
#[@External.Wasm("op:f64.trunc")]
pub declare fn trunc(x: f64) -> f64;

// `ceil(x) = -floor(-x)` — a pure-botopink derivation that avoids the
// erlang inline-arithmetic template (no `math:ceil/1` BIF exists pre-OTP-26).
pub fn ceil(x: f64) -> f64 {
    return 0.0 - floor(0.0 - x);
}

// `sign` returns -1.0, 0.0, or 1.0 depending on the input's sign.
// Pure-botopink; sidesteps the inline-case template the spec describes.
pub fn sign(x: f64) -> f64 {
    return if (x > 0.0) 1.0 else if (x < 0.0) 0.0 - 1.0 else 0.0;
}

#[@External.Node("Math", "min")]
#[@External.Erlang("erlang", "min")]
#[@External.Beam("erlang", "min")]
#[@External.Wasm("op:f64.min")]
pub declare fn minF(a: f64, b: f64) -> f64;

#[@External.Node("Math", "max")]
#[@External.Erlang("erlang", "max")]
#[@External.Beam("erlang", "max")]
#[@External.Wasm("op:f64.max")]
pub declare fn maxF(a: f64, b: f64) -> f64;

pub fn clamp(x: f64, lo: f64, hi: f64) -> f64 {
    return maxF(lo, minF(hi, x));
}

// ── powers + roots + exp/log ─────────────────────────────────────────────────

#[@External.Node("Math", "sqrt")]
#[@External.Erlang("math", "sqrt")]
#[@External.Beam("math", "sqrt")]
#[@External.Wasm("op:f64.sqrt")]
pub declare fn sqrt(x: f64) -> f64;

#[@External.Node("fn:powBody")]
#[@External.Erlang("fn:powBody")]
#[@External.Beam("fn:powBody")]
#[@External.Wasm("fn:powBody")]
pub declare fn pow(x: f64, y: f64) -> f64;

// `cbrt(x)` via `pow(x, 1/3)`, honouring sign for negatives. Pure-botopink;
// node has `Math.cbrt` but the erlang side has no BIF — composition is uniform.
pub fn cbrt(x: f64) -> f64 {
    return if (x >= 0.0)
        pow(x, 0.3333333333333333)
    else
        0.0 - pow(0.0 - x, 0.3333333333333333);
}

#[@External.Node("Math", "exp")]
#[@External.Erlang("fn:expBody")]
#[@External.Beam("fn:expBody")]
#[@External.Wasm("fn:expBody")]
pub declare fn exp(x: f64) -> f64;

#[@External.Node("Math", "log")]
#[@External.Erlang("fn:lnBody")]
#[@External.Beam("fn:lnBody")]
#[@External.Wasm("fn:lnBody")]
pub declare fn ln(x: f64) -> f64;

#[@External.Node("Math", "log2")]
#[@External.Erlang("fn:log2Body")]
#[@External.Beam("fn:log2Body")]
#[@External.Wasm("fn:log2Body")]
pub declare fn log2(x: f64) -> f64;

#[@External.Node("Math", "log10")]
#[@External.Erlang("fn:log10Body")]
#[@External.Beam("fn:log10Body")]
#[@External.Wasm("fn:log10Body")]
pub declare fn log10(x: f64) -> f64;

// `hypot(x, y) = sqrt(x*x + y*y)` — pure-botopink composition.
pub fn hypot(x: f64, y: f64) -> f64 {
    return sqrt(x * x + y * y);
}


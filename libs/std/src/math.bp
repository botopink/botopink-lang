fn remPio2(x: f64, which: f64) -> f64 {
    val neg = signBit(x);
    val ix = highWord(x);
    var n = 0.0;
    var y0 = x;
    var y1 = 0.0;
    if (ix <= 1072243195.0) n = 0.0 else if (ix < 1073928572.0) {
        val sgn = if (neg) -1.0 else 1.0;
        var z = x - sgn * 1.57079632673412561417e+00;

    val tmp = fusedMultiplyAdd(
        r2 * r2,
        fusedMultiplyAdd(r, 0.008333335853059549, 0.0416666808410674),
        fusedMultiplyAdd(
            r2,
            fusedMultiplyAdd(r, 0.16666666666665886, 0.49999999999996786),
            expTail(j) + r,

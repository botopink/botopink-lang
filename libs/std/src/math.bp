fn kernelCos(x: f64, y: f64) -> f64 {
    val ix = highWord(x);
    if (ix < 1044381696.0) return 1.0;
    val z = x * x;
    val r = z
        * (4.16666666666666019037e-02
            + z
                * (-1.38888888888741095749e-03
                    + z
                        * (2.48015872894767294178e-05
                            + z
                                * (-2.75573143513906633035e-07
                                    + z
                                        * (2.08757232129817482790e-09
                                            + z
                                                * -1.13596475577881948265e-11)))));
    if (ix < 1070805811.0) return 1.0 - (0.5 * z - (z * r - x * y));
    val qx = if (ix > 1072234496.0) 0.28125 else fromWords(ix - 2097152.0, 0.0);
    val iz = 0.5 * z - qx;
    val a = 1.0 - qx;
    return a - (iz - (z * r - x * y));
}

fn kernelSin(x: f64, y: f64, iy: f64) -> f64 {
    if (highWord(x) < 1044381696.0) return x;
    val z = x * x;
    val v = z * x;
    val r = 8.33333333332248946124e-03
        + z
            * (-1.98412698298579493134e-04
                + z
                    * (2.75573137070700676789e-06
                        + z
                            * (-2.50507602534068634195e-08
                                + z * 1.58969099521155010221e-10)));
    if (isZero(iy)) return x + v * (-1.66666666666666324348e-01 + z * r);
    return x - ((z * (0.5 * y - v * r) - y) - v * -1.66666666666666324348e-01);

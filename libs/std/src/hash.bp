//// std/hash — every hash std has, pure functions all (decision 106): the hex
//// digests (`sha256`, `sha512`, `md5`, `hmacSha256` — was `crypto`), the
//// digests the security fronts need in the shape they are compared in
//// (base64url of the raw digest, RFC 7515; SHA-1 for the WebSocket accept
//// key, RFC 6455; a constant-time compare), and the content hashes for cache
//// keys, ETags and asset fingerprints (was `content_hash`). `crypto`'s
//// `randomBytes` reads entropy and lives in `io/random.bp`.
////
//// Reference:
////   Node.js  — https://nodejs.org/api/crypto.html
////              (`createHash`, `createHmac`, `.digest('base64' | 'base64url')`,
////               `timingSafeEqual`, `pbkdf2Sync`)
////   Erlang   — https://www.erlang.org/doc/apps/crypto/crypto.html
////              (`crypto:hash/2`, `crypto:mac/4`, `crypto:hash_equals/2`,
////               `crypto:pbkdf2_hmac/5`)
////              https://www.erlang.org/doc/apps/stdlib/base64.html
////              (`base64:encode/2` with `#{mode => urlsafe, padding => false}`)
////   RFC 4648 §5 (base64url), RFC 4231 (HMAC-SHA256), RFC 6455 §1.3
////
//// Each cell calls `crypto:hash/2` / `createHash` itself rather than a
//// sibling function — the duplication is in the template string, not in
//// behaviour.
////
//// Text in: every input is the UTF-8 bytes of a `string` (there is no
//// byte type — `language-gaps.md`), so an HMAC key is text too.

// base64url (no padding) of the raw HMAC-SHA256 of `data` under `key` —
// the JWS HS256 signature (RFC 7515 §3) and a session-cookie MAC.
#[@External.Node("""require('crypto').createHmac('sha256', $0).update($1).digest('base64url')""")]
#[@External.Erlang("""base64:encode(crypto:mac(hmac, sha256, $0, $1), #{mode => urlsafe, padding => false})""")]
pub declare fn hmacSha256Base64Url(key: string, data: string) -> string;

// Standard base64 (with padding) of the raw SHA-1 of `data` — the
// `Sec-WebSocket-Accept` value of RFC 6455 §1.3. SHA-1 is here for that
// handshake only; it is not a signature primitive.
#[@External.Node("""require('crypto').createHash('sha1').update($0).digest('base64')""")]
#[@External.Erlang("""base64:encode(crypto:hash(sha, $0))""")]
pub declare fn sha1Base64(data: string) -> string;

// base64url (no padding) of the raw SHA-256 of `data` — 43 characters.
#[@External.Node("""require('crypto').createHash('sha256').update($0).digest('base64url')""")]
#[@External.Erlang("""base64:encode(crypto:hash(sha256, $0), #{mode => urlsafe, padding => false})""")]
pub declare fn sha256Base64Url(data: string) -> string;

// `a == b` in time that depends only on the length, not on where the two
// first differ — the compare a signature check must use (`==` on two
// signature strings is a byte-at-a-time timing oracle on both backends).
// Different lengths answer `false` without throwing: `timingSafeEqual` and
// `crypto:hash_equals/2` both raise on a length mismatch, so each template
// checks the byte length first (the length of a MAC is not secret).
#[@External.Node("""(() => { const __a = Buffer.from($0, 'utf8'); const __b = Buffer.from($1, 'utf8'); return __a.length === __b.length && require('crypto').timingSafeEqual(__a, __b) })()""")]
#[@External.Erlang("""(fun(__A, __B) -> byte_size(__A) =:= byte_size(__B) andalso crypto:hash_equals(__A, __B) end)($0, $1)""")]
pub declare fn equalsConstantTime(a: string, b: string) -> bool;

// ── 1.0.11-beta front 97: PBKDF2 ─────────────────────────────────────────────

// The cell behind `pbkdf2Sha256`: base64url (no padding) of the derived key.
// Node: `crypto.pbkdf2Sync(password, salt, iterations, length, 'sha256')`.
// Erlang: `crypto:pbkdf2_hmac(sha256, Password, Salt, Iterations, Length)`.
#[@External.Node("""require('crypto').pbkdf2Sync($0, $1, $2, $3, 'sha256').toString('base64url')""")]
#[@External.Erlang("""base64:encode(crypto:pbkdf2_hmac(sha256, $0, $1, $2, $3), #{mode => urlsafe, padding => false})""")]
declare fn pbkdf2Derive(
    password: string,
    salt: string,
    iterations: i32,
    length: i32,
) -> string;

// PBKDF2-HMAC-SHA256 (RFC 8018 §5.2): `length` BYTES of key derived from
// `password` over `salt` in `iterations` rounds, as unpadded base64url — the
// shape a stored password hash is compared in (`equalsConstantTime`).
// `password` and `salt` are TEXT, their UTF-8 bytes (decision 175; there is no
// byte type): a salt that is itself base64 is derived over its characters,
// not over the bytes it encodes. The same answer on both targets for every
// input — the published vectors are the tests.
//
// `iterations` and `length` are at least 1; anything else is a programming
// error, a panic with one text on both targets (each host raises its own
// otherwise), never an empty key.
pub fn pbkdf2Sha256(
    password: string,
    salt: string,
    iterations: i32,
    length: i32,
) -> string {
    val refused = iterations < 1 || length < 1;
    if (refused)
        @panic("hash.pbkdf2Sha256: iterations and length must be at least 1");
    return pbkdf2Derive(password, salt, iterations, length);
}

// Internal, test scaffolding: the text a body panics with, `""` when it
// answered. The shape of `testing.asserts`' own cell — a root module does not
// import the harness.
#[@External.Node("""(() => { try { ($0)(); return '' } catch (__e) { return __e && __e.message ? __e.message : String(__e) } })()""")]
#[@External.Erlang("""(fun(__B) -> try __B(), <<>> catch error:{panic, __M} -> unicode:characters_to_binary(__M); __C:__E -> iolist_to_binary(io_lib:format("~p:~p", [__C, __E])) end end)($0)""")]
declare fn panicText(body: fn() -> string) -> string;

// ── tests ────────────────────────────────────────────────────────────────────

test "hash.hmacSha256Base64Url matches the published HMAC-SHA256 vector" {
    // HMAC-SHA256("key", "The quick brown fox jumps over the lazy dog") is
    // f7bc83f4…2d1a3cd8 in hex; this is the same 32 bytes as base64url.
    val mac = hmacSha256Base64Url(
        "key",
        "The quick brown fox jumps over the lazy dog",
    );
    assert mac == "97yD9DBThCSxMpjmqm-xQ-9NWaFJRhdZl0edvC0aPNg";
    assert mac.length == 43;
}

test "hash.sha1Base64 reproduces the RFC 6455 accept key" {
    val accept = sha1Base64(
        "dGhlIHNhbXBsZSBub25jZQ==258EAFA5-E914-47DA-95CA-C5AB0DC85B11",
    );
    assert accept == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=";
}

test "hash.pbkdf2Sha256 matches RFC 6070's inputs under SHA-256" {
    // RFC 6070's own vectors are PBKDF2-HMAC-SHA1; these are its inputs under
    // SHA-256 — hex 120fb6cf…0be17b, ae4d0c95…474c43, c5e478d5…98134a and
    // 348c89db…ac47e9, written here as the base64url this function answers.
    assert pbkdf2Sha256("password", "salt", 1, 32)
        == "Eg-2z_z4syxD5yJSVsT4N6hlSMkszDVICAWYfLcL4Xs";
    assert pbkdf2Sha256("password", "salt", 2, 32)
        == "rk0Mla9rRtMtCt_5KPBt0CowP47zwlHf1uLYWpVHTEM";
    assert pbkdf2Sha256("password", "salt", 4096, 32)
        == "xeR41ZKIyEGqUw22hFxMjZYok6ABzk4RpJY4c6qYE0o";
    assert pbkdf2Sha256(
        "passwordPASSWORDpassword",
        "saltSALTsaltSALTsaltSALTsaltSALTsalt",
        4096,
        40,
    )
        == "NIyJ28vTKy8y2BS4EW6EzysXNH68GAAYHE4qH7jdU-HGNVGMfaxH6Q";
}

test "hash.pbkdf2Sha256 matches RFC 7914's PBKDF2-HMAC-SHA-256 vectors" {
    // RFC 7914 §11: hex 55ac046e…a19783 and 4ddcd8f6…f33c8d.
    assert pbkdf2Sha256("passwd", "salt", 1, 64)
        == "VawEblbjCJ_sFpHCJUS2BflBhSFt3gRl5oudV8INrLxJypzM8Xm2RZkWZLOdd-8xfHG4RbHjC9UJESBB06GXgw";
    assert pbkdf2Sha256("Password", "NaCl", 80000, 64)
        == "TdzY9guYviGDDO5e8icB-WQaRBjQTAQUrv8Ih2s0q1ah1CWhIlgzVJrbhBtRybMXaicr3ruh0HhHj2Kzl_M8jQ";
}

test "hash.pbkdf2Sha256 answers the asked number of bytes" {
    // 20 bytes are 27 base64url characters, 1 byte is 2, 16 are 22: a shorter
    // key is the prefix of the longer one's first block.
    assert pbkdf2Sha256("password", "salt", 1, 20)
        == "Eg-2z_z4syxD5yJSVsT4N6hlSMk";
    assert pbkdf2Sha256("password", "salt", 1, 1) == "Eg";
    assert pbkdf2Sha256("", "", 1, 16) == "984LZT0tcqQQjPWr6RL_3Q";
}

test "hash.pbkdf2Sha256 reads the salt as text and depends on every argument" {
    val base = pbkdf2Sha256("password", "c2FsdA", 1, 32);
    assert base != pbkdf2Sha256("password", "salt", 1, 32);
    assert base != pbkdf2Sha256("Password", "c2FsdA", 1, 32);
    assert base != pbkdf2Sha256("password", "c2FsdA", 2, 32);
    assert base == pbkdf2Sha256("password", "c2FsdA", 1, 32);
    assert equalsConstantTime(base, pbkdf2Sha256("password", "c2FsdA", 1, 32));
}

test "hash.pbkdf2Sha256 panics on a non-positive iteration count or length" {
    val wanted = "hash.pbkdf2Sha256: iterations and length must be at least 1";
    assert panicText({ -> pbkdf2Sha256("password", "salt", 0, 32) }) == wanted;
    assert panicText({ -> pbkdf2Sha256("password", "salt", 1, 0) }) == wanted;
    assert panicText({ -> pbkdf2Sha256("password", "salt", 0 - 1, 32) })
        == wanted;
    assert panicText({ -> pbkdf2Sha256("password", "salt", 1, 1) }) == "";
}

test "hash.sha256Base64Url of the empty string is the published digest" {
    assert sha256Base64Url("") == "47DEQpj8HBSa-_TImW-5JCeuQeRkm5NMpJWZG3hSuFU";
    assert sha256Base64Url("hello world")
        == "uU0nuZNNPgilLlLX2n2r-sSE7-N6U4DukIj3rOLvzek";
}

test "hash.equalsConstantTime compares a 43-character signature" {
    val sig = hmacSha256Base64Url("secret", "header.payload");
    assert sig.length == 43;
    assert equalsConstantTime(sig, sig);
    assert equalsConstantTime(
        sig,
        hmacSha256Base64Url("secret", "header.payload"),
    );
}

test "hash.equalsConstantTime is false for a different value and never throws" {
    assert equalsConstantTime("abcd", "abce").negate();
    assert equalsConstantTime("abc", "abcd").negate();
    assert equalsConstantTime("", "a").negate();
    assert equalsConstantTime("", "");
}

// ── hex digests (was `crypto`) ───────────────────────────────────────────────

#[@External.Node("""require('crypto').createHash('sha256').update($0).digest('hex')""")]
#[@External.Erlang("""list_to_binary([io_lib:format("~2.16.0b", [__B]) || __B <- binary_to_list(crypto:hash(sha256, $0))])""")]
pub declare fn sha256(data: string) -> string;

#[@External.Node("""require('crypto').createHash('sha512').update($0).digest('hex')""")]
#[@External.Erlang("""list_to_binary([io_lib:format("~2.16.0b", [__B]) || __B <- binary_to_list(crypto:hash(sha512, $0))])""")]
pub declare fn sha512(data: string) -> string;

#[@External.Node("""require('crypto').createHash('md5').update($0).digest('hex')""")]
#[@External.Erlang("""list_to_binary([io_lib:format("~2.16.0b", [__B]) || __B <- binary_to_list(crypto:hash(md5, $0))])""")]
pub declare fn md5(data: string) -> string;

// HMAC-SHA256. `key` is the secret material; `data` is the message.
// Both lower to the host's keyed-hash primitive — Node's
// `crypto.createHmac('sha256', key).update(data).digest('hex')` and
// Erlang's `crypto:mac(hmac, sha256, key, data)`.
#[@External.Node("""require('crypto').createHmac('sha256', $0).update($1).digest('hex')""")]
#[@External.Erlang("""list_to_binary([io_lib:format("~2.16.0b", [__B]) || __B <- binary_to_list(crypto:mac(hmac, sha256, $0, $1))])""")]
pub declare fn hmacSha256(key: string, data: string) -> string;

// ── tests ────────────────────────────────────────────────────────────────────

test "hash.sha256 matches the canonical 'hello world' vector" {
    val h = sha256("hello world");
    assert h
        == "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9";
}

test "hash.sha256 of empty string is the well-known zero-length digest" {
    val h = sha256("");
    assert h
        == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
}

test "hash.md5 of 'hello' matches the canonical digest" {
    val h = md5("hello");
    assert h == "5d41402abc4b2a76b9719d911017c592";
}

test "hash.sha512 of empty is the zero-length sha512 digest" {
    val h = sha512("");
    assert h.length == 128;
}

test "hash.hmacSha256 produces a 64-hex-char digest" {
    val h = hmacSha256("secret", "message");
    assert h.length == 64;
}

// ── content hashes (was `content_hash`) ──────────────────────────────────────
// Stable hashes for cache keys, ETags and asset fingerprints (1.0.10-beta
// `01-std` front 03).
//
// Reference:
//   RFC 9110 § 8.8.3 — https://www.rfc-editor.org/rfc/rfc9110#field.etag
//   Next.js caching  — https://nextjs.org/docs/app/getting-started/caching
//   Erlang           — https://www.erlang.org/doc/apps/crypto/crypto.html#hash/2
//
// `strongHash` carries its own SHA-256 cell rather than calling `sha256`
// above; the truncation lives in the template.
//
// TWO hashes, and the choice is not a matter of taste. `contentHash` is a
// djb2 fold rendered as lowercase hex: fast, stable across both targets,
// and TRIVIAL TO COLLIDE ON PURPOSE. Use it when a collision costs a wrong
// cache hit you control — an asset filename, an internal fingerprint.
// `strongHash` is SHA-256 truncated to 32 hex characters. Use it whenever
// the hashed value came from outside: a request header, a client-supplied
// tag, a key that spans a user boundary.
//
// The `contentHash` templates are lifted verbatim from
// `repository/emilia/modules/emilia/src/emilia.bp` (`hashHex`), where they
// were tuned until both targets agreed byte-for-byte; only the `__`-prefixed
// variable names differ. Astral characters diverge (one codepoint on
// Erlang, two UTF-16 units in JS) — the same caveat emilia carries.
// `emilia.hashHex` is therefore a duplicate of `contentHash` now; collapsing
// it onto std is a later, `emilia`-owned change — this milestone is additive
// only.

#[@External.Node("""(function(__S){ var __H = 5381; for (var __I = 0; __I < __S.length; __I++) { __H = (Math.imul(__H, 33) + __S.charCodeAt(__I)) >>> 0; } return __H.toString(16); })($0)""")]
#[@External.Erlang("""(fun(__S) -> __H = lists:foldl(fun(__C, __A) -> (__A * 33 + __C) band 16#FFFFFFFF end, 5381, unicode:characters_to_list(__S)), list_to_binary(string:lowercase(integer_to_list(__H, 16))) end)($0)""")]
pub declare fn contentHash(value: string) -> string;

#[@External.Node("""require('crypto').createHash('sha256').update($0).digest('hex').slice(0, 32)""")]
#[@External.Erlang("""binary:part(string:lowercase(binary:encode_hex(crypto:hash(sha256, $0))), 0, 32)""")]
pub declare fn strongHash(value: string) -> string;

// ── cache keys — framed, never joined ────────────────────────────────────────

// A key over several parts. Each part is length-prefixed, so no two different
// part lists can collide: ["user:1", "profile"] and ["user", "1:profile"] frame
// to `6:user:1|7:profile` and `4:user|9:1:profile` and therefore hash to
// different keys. A cache that collides across a user boundary serves one user
// another user's page, so the framing is the whole reason this function exists
// instead of a `join`.
pub fn cacheKey(parts: string[]) -> string {
    return contentHash(frame(parts));
}

// The same framing over the strong hash, for keys built from input the caller
// did not choose.
pub fn strongCacheKey(parts: string[]) -> string {
    return strongHash(frame(parts));
}

// `<length>:<part>` per part, `|` between parts. The one place a multi-part
// key is rendered, so no function in this module joins parts unframed.
fn frame(parts: string[]) -> string {
    return parts.map({ p -> p.length().toString() + ":" + p }).join("|");
}

// ── ETags (RFC 9110 § 8.8.3) ─────────────────────────────────────────────────

// A strong ETag, quoted as RFC 9110 requires. The quotes are part of the value:
// a caller who has to remember to add them is a caller who will forget.
pub fn etag(body: string) -> string {
    return "\"" + contentHash(body) + "\"";
}

pub fn weakEtag(body: string) -> string {
    return "W/\"" + contentHash(body) + "\"";
}

// The 304 decision. Handles the three shapes a handler actually receives: an
// exact match, the `*` wildcard, and a comma-separated candidate list. The
// membership test is `indexOf`, not `Array.contains`: `contains` is a
// `default fn`, which a consumer's embedded copy of this module emits
// verbatim on commonJS (`libs/std/AGENTS.md` § Conventions).
pub fn matches(body: string, ifNoneMatch: string) -> bool {
    val header = ifNoneMatch.trim();
    val wildcard = header == "*";
    val current = etag(body);
    val weak = weakEtag(body);
    val candidates = header.split(",").map({ c -> c.trim() });
    val exact = candidates.indexOf(current) != -1;
    val loose = candidates.indexOf(weak) != -1;
    val hit = if (exact) true else loose;
    return if (wildcard) true else hit;
}

// ── fingerprints ─────────────────────────────────────────────────────────────

// `app.js` → `app.<hash>.js`. The extension stays last: a browser and a CDN
// both dispatch on it, and a hash appended after it breaks both. A leading
// dot (`.gitignore`) is not an extension boundary, and a name without an
// extension gains no trailing dot (`LICENSE` → `LICENSE.<hash>`).
//
// The extension is measured as the last `.`-separated piece. It was written
// that way when Erlang's `lastIndexOf` answered a BYTE offset while
// `length`/`slice` counted characters; the four agree now (decision 169), and
// the piece measure stays because it is the same cut.
pub fn fingerprint(fileName: string, contents: string) -> string {
    val hash = contentHash(contents);
    val pieces = fileName.split(".");
    val tail = pieces.at(pieces.length - 1);
    val extLen = if (tail != null) tail.length() + 1 else 0;
    val hasExt = if (pieces.length > 1) extLen < fileName.length() else false;
    val cut = fileName.length() - extLen;
    val stem = if (hasExt) fileName.slice(0, cut) else fileName;
    val ext = if (hasExt) fileName.slice(cut, fileName.length()) else "";
    return stem + "." + hash + ext;
}

// ── tests ────────────────────────────────────────────────────────────────────
//
// Every expected hex below is a LITERAL, not a second call: a literal is the
// only form that catches the two targets drifting apart.

test "hash.contentHash of 'hello' is the pinned djb2 hex on both targets" {
    assert contentHash("hello") == "f923099";
}

test "hash.contentHash is stable within a process" {
    val a = contentHash("hello");
    val b = contentHash("hello");
    assert a == b;
}

test "hash.contentHash differs between 'hello' and 'world'" {
    assert contentHash("world") == "10a7356d";
    assert contentHash("hello") != contentHash("world");
}

test "hash.contentHash of the empty string is djb2's seed, not empty" {
    assert contentHash("") == "1505";
}

test "hash.strongHash of the empty string is the truncated empty SHA-256" {
    val h = strongHash("");
    assert h == "e3b0c44298fc1c149afbf4c8996fb924";
    assert h.length == 32;
}

test "hash.strongHash of 'hello' is the pinned truncated SHA-256" {
    assert strongHash("hello") == "2cf24dba5fb0a30e26e83b2ac5b9e29e";
}

test "hash.cacheKey framing does not collide across part boundaries" {
    val a = cacheKey(["user:1", "profile"]);
    val b = cacheKey(["user", "1:profile"]);
    assert a != b;
    // `6:user:1|7:profile` and `4:user|9:1:profile`, pinned on both targets.
    assert a == "62d9003d";
    assert b == "8aac687d";
}

test "hash.cacheKey distinguishes a trailing empty part" {
    assert cacheKey(["a"]) != cacheKey(["a", ""]);
    assert cacheKey(["a"]) == "b878b31";
    assert cacheKey(["a", ""]) == "7e7c9f77";
}

test "hash.cacheKey of no parts is the hash of the empty frame" {
    assert cacheKey([]) == "1505";
}

test "hash.strongCacheKey frames like cacheKey over the strong hash" {
    assert strongCacheKey(["user:1", "profile"])
        != strongCacheKey(["user", "1:profile"]);
    assert strongCacheKey(["user:1", "profile"])
        == strongHash("6:user:1|7:profile");
    assert strongCacheKey(["user:1", "profile"]).length == 32;
}

test "hash.etag is quoted and carries exactly one hash" {
    val e = etag("<p>hi</p>");
    assert e == "\"3ad52bb9\"";
    assert e.startsWith("\"");
    assert e.endsWith("\"");
    assert weakEtag("<p>hi</p>") == "W/\"3ad52bb9\"";
}

test "hash.matches answers the exact ETag and refuses a moved one" {
    val body = "<p>hi</p>";
    assert matches(body, etag(body));
    assert matches(body, weakEtag(body));
    assert matches(body, etag(body + "x")) == false;
}

test "hash.matches answers the wildcard for any body" {
    assert matches("<p>hi</p>", "*");
    assert matches("", "*");
}

test "hash.matches splits and trims a candidate list" {
    val body = "<p>hi</p>";
    assert matches(body, "\"aaa\", " + etag(body));
    assert matches(body, "\"aaa\", \"bbb\"") == false;
}

test "hash.matches of an empty header is false" {
    assert matches("<p>hi</p>", "") == false;
}

test "hash.fingerprint keeps the extension last" {
    assert fingerprint("app.js", "body{}") == "app.f48a1b4b.js";
    assert fingerprint("a.b.css", "body{}") == "a.b.f48a1b4b.css";
}

test "hash.fingerprint of a name without an extension adds no trailing dot" {
    assert fingerprint("LICENSE", "body{}") == "LICENSE.f48a1b4b";
}

test "hash.fingerprint does not treat a leading dot as an extension" {
    assert fingerprint(".gitignore", "body{}") == ".gitignore.f48a1b4b";
}

test "hash.fingerprint answers a different name for different contents" {
    assert fingerprint("app.js", "body{x}") == "app.85cd8483.js";
    assert fingerprint("app.js", "body{}") != fingerprint("app.js", "body{x}");
}

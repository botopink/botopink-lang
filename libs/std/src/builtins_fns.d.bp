//// Parseable fn-decl slice of `builtins.d.bp`: the builtin fns that carry a
//// trailing literal default and therefore need a real `FnDecl` entry in
//// `env.stdlibFnDecls` so call-site default injection
//// (`expandTrailingDefaults`) can read the `.default` Expr and inject it
//// into the call's args before dispatch. Each annotated `declare fn` lands
//// as a `FnDecl` (parser.zig line ~319: an annotated `declare fn` is the
//// FFI form, not a delegate); `parseFnDecl` reads the `default` value off
//// each Param.
////
//// Every other builtin fn is declared in `builtins.d.bp` (decision 252); the
//// compiler's table (`comptime/builtins.zig`) is held to both files by a unit
//// test. None of those carries a trailing default, so none needs this path.

#[@External.Erlang("erlang:error({todo, $0})")]
#[@External.Node("(() => { throw new Error($0) })()")]
pub declare fn todo(message: string = "not implemented") -> noreturn;

#[@External.Erlang("erlang:error({panic, $0})")]
#[@External.Node("(() => { throw new Error($0) })()")]
pub declare fn panic(message: string = "panic") -> noreturn;

//// Primitive controller — the central interface registry for botopink's
//// primitive types. Declarations only (no bodies): the type checker consumes
//// the signatures, and `#[@External.<Target>(...)]` tells each codegen
//// backend how to lower the operation (host symbol per target). Pure-logic
//// operations carry no `@External.*` — the compiler synthesises them.
////
//// Naming convention: camelCase (the legacy snake_case surface is normalised
//// here). Method receivers are `self: Self`; free combinators live in the
//// `Function` interface as associated functions.

// ── numeric tower ─────────────────────────────────────────────────────────────
// Capability interfaces shared by every numeric width. `Self` abstracts the
// concrete type, so one signature serves all widths; concrete types inherit via
// `extends` and carry no duplicated members. Declared (host-backed) methods use
// `#[@External.Erlang(…), @External.Node(…)]`; pure-logic ops carry none.

behavior Number {
    #[@External.Erlang("erlang", "min")]
    #[@External.Node("Math", "min")]
    fn min(self: Self, other: Self) -> Self;

    #[@External.Erlang("erlang", "max")]
    #[@External.Node("Math", "max")]
    fn max(self: Self, other: Self) -> Self;

    default fn clamp(self: Self, lo: Self, hi: Self) -> Self {
        return self.max(lo).min(hi);
    }
}

behavior Integer extends Number {
    #[@External.Erlang("erlang", "integer_to_binary")]
    #[@External.Node("toString")]
    fn toString(self: Self) -> string;

    default fn isEven(self: Self) -> bool {
        return self % 2 == 0;
    }

    default fn isOdd(self: Self) -> bool {
        return self % 2 != 0;
    }
}

behavior Signed extends Integer {
    #[@External.Erlang("erlang", "abs")]
    #[@External.Node("Math", "abs")]
    fn abs(self: Self) -> Self;
}

behavior Float extends Number {
    // `float_to_binary/1` prints scientific notation (`1.50000000000000000000e+00`);
    // `short` is the shortest text that reads back as the same float (`1.5`).
    #[@External.Erlang("float_to_binary($0, [short])")]
    #[@External.Node("toString")]
    fn toString(self: Self) -> string;

    #[@External.Erlang("erlang", "abs")]
    #[@External.Node("Math", "abs")]
    fn abs(self: Self) -> Self;

    #[@External.Erlang("math", "floor")]
    #[@External.Node("Math", "floor")]
    fn floor(self: Self) -> Self;

    #[@External.Erlang("math", "ceil")]
    #[@External.Node("Math", "ceil")]
    fn ceil(self: Self) -> Self;

    // OTP has no `math:round/1`; `floor(x + 0.5)` is `Math.round` (ties round
    // up) and keeps the float type `Self` promises.
    #[@External.Erlang("math:floor($0 + 0.5)")]
    #[@External.Node("Math", "round")]
    fn round(self: Self) -> Self;

    #[@External.Erlang("math", "sqrt")]
    #[@External.Node("Math", "sqrt")]
    fn squareRoot(self: Self) -> Self;
}

// Concrete primitive widths — thin markers binding each type to its capabilities.
behavior I32 extends Signed {}

behavior I64 extends Signed {}

behavior U32 extends Integer {}

behavior U64 extends Integer {}

behavior F32 extends Float {}

behavior F64 extends Float {}

// ── boolean ───────────────────────────────────────────────────────────────────

behavior Bool {
    #[@External.Erlang("erlang", "atom_to_binary")]
    #[@External.Node("toString")]
    fn toString(self: Self) -> string;

    #[@External.Erlang("(not $0)")]
    default fn negate(self: Self) -> bool {
        return !self;
    }

    default fn nor(self: Self, other: bool) -> bool {
        return !(self || other);
    }

    default fn nand(self: Self, other: bool) -> bool {
        return !(self && other);
    }

    default fn exclusiveOr(self: Self, other: bool) -> bool {
        return self != other;
    }

    default fn exclusiveNor(self: Self, other: bool) -> bool {
        return self == other;
    }
}

// ── string ────────────────────────────────────────────────────────────────────
// `string` answers `Index<i32, string>` (`at`) and `Slice<string>` (`slice`) —
// the two ambient behaviors of `builtins.d.bp` that make `s[1]` and `s[1..3]`
// legal (decision 63, amended). The conformance is written here as a comment
// and not as an `implement` clause because a `behavior` declaration carries no
// `implement` clause in the grammar; see `libs/std/AGENTS.md`.

behavior String {
    #[@External.Erlang("string", "length")]
    #[@External.Node("length")]
    fn length(self: Self) -> i32;

    // `string:split/3` answers the whole string for an empty separator, while
    // JS `split("")` answers one element per character. The erlang form
    // matches the empty separator first and cuts the binary into UTF-8
    // codepoints (`"".split("")` answers `[]`, as on JS).
    #[@External.Erlang("""(fun(__S, <<>>) -> [<<__C/utf8>> || <<__C/utf8>> <= __S]; (__S, __X) -> string:split(__S, __X, all) end)($0, $1)""")]
    #[@External.Node("split")]
    fn split(self: Self, sep: string) -> string[];

    #[@External.Erlang("string", "uppercase")]
    #[@External.Beam("""    {call_ext, 1, {extfunc, string, uppercase, 1}}.""")]
    #[@External.Node("toUpperCase")]
    fn toUpper(self: Self) -> string;

    #[@External.Erlang("string", "lowercase")]
    #[@External.Beam("""    {call_ext, 1, {extfunc, string, lowercase, 1}}.""")]
    #[@External.Node("toLowerCase")]
    fn toLower(self: Self) -> string;

    #[@External.Erlang("(string:find($0, $1) =/= nomatch)")]
    #[@External.Node("includes")]
    fn contains(self: Self, sub: string) -> bool;

    #[@External.Erlang("(string:prefix($0, $1) =/= nomatch)")]
    #[@External.Node("startsWith")]
    fn startsWith(self: Self, prefix: string) -> bool;

    // OTP has no `string:suffix/2`. Both erlang forms compare the last
    // `byte_size(suffix)` bytes with the suffix. The BEAM body cannot branch, so
    // it clamps the start offset to 0 arithmetically (`(D + abs(D)) div 2`);
    // when the suffix is longer than the string the part is the whole string,
    // whose size differs, so the comparison is false.
    #[@External.Erlang("""(fun(__S, __X) -> __N = byte_size(__S), __M = byte_size(__X), (__M =< __N) andalso (binary:part(__S, __N - __M, __M) =:= __X) end)($0, $1)""")]
    #[@External.Beam("""    {gc_bif, byte_size, {f, 0}, 2, [$0], {x, 2}}.
    {gc_bif, byte_size, {f, 0}, 3, [$1], {x, 3}}.
    {gc_bif, '-', {f, 0}, 4, [{x, 2}, {x, 3}], {x, 3}}.
    {gc_bif, abs, {f, 0}, 4, [{x, 3}], {x, 4}}.
    {gc_bif, '+', {f, 0}, 5, [{x, 3}, {x, 4}], {x, 3}}.
    {gc_bif, 'div', {f, 0}, 4, [{x, 3}, {integer, 2}], {x, 3}}.
    {gc_bif, '-', {f, 0}, 4, [{x, 2}, {x, 3}], {x, 2}}.
    {gc_bif, binary_part, {f, 0}, 4, [$0, {x, 3}, {x, 2}], {x, 0}}.
    {bif, '=:=', {f, 0}, [{x, 0}, $1], {x, 0}}.""")]
    #[@External.Node("endsWith")]
    fn endsWith(self: Self, suffix: string) -> bool;

    #[@External.Erlang("string", "trim")]
    #[@External.Beam("""    {call_ext, 1, {extfunc, string, trim, 1}}.""")]
    #[@External.Node("trim")]
    fn trim(self: Self) -> string;

    // `string:trim/1` strips both ends; `/2` takes the direction.
    #[@External.Erlang("string:trim($0, leading)")]
    #[@External.Node("trimStart")]
    fn trimStart(self: Self) -> string;

    #[@External.Erlang("string:trim($0, trailing)")]
    #[@External.Node("trimEnd")]
    fn trimEnd(self: Self) -> string;

    // Replaces the first occurrence, like JS `replace` with a string pattern.
    // `string:replace/3` returns an iolist, so it is flattened to a binary.
    #[@External.Erlang("iolist_to_binary(string:replace($0, $1, $2))")]
    #[@External.Node("replace")]
    fn replace(self: Self, pattern: string, with: string) -> string;

    // `Slice<string>.slice` — `end` is `?i32` so an open-ended `s[1..]` can
    // pass `null` in the second argument (there is no `Range` type to pass).
    default fn slice(self: Self, start: i32, end: ?i32 = null) -> string {
        if (end != null) return stringSlice1(self, start, end) else return stringSlice0(
            self,
            start
        );
    }

    // `Index<i32, string>.at` — the reader `s[1]` rewrites to. It was spelled
    // `charAt` until decision 63's amendment gave the index expression one
    // method name across every indexable type; the JS template still names
    // native `charAt`, which is the host symbol, not the language's.
    //
    // `string:slice/2` returns the rest of the string, not one character.
    // Node's native `charAt` returns `""` out of range where the signature
    // says `?string`; a helper that returns `null` needs the commonJS helper
    // mechanism (F8 js-bridges) — a template here would patch the global
    // `String.prototype.charAt`.
    #[@External.Erlang("""(fun(__S, __I) -> case (__I >= 0) andalso (__I < string:length(__S)) of true -> string:slice(__S, __I, 1); false -> undefined end end)($0, $1)""")]
    #[@External.Node("charAt")]
    fn at(self: Self, index: i32) -> ?string;

    // `string:str/2` takes charlists and rejects binaries (`function_clause`).
    // `binary:match/2` rejects an empty pattern, which JS finds at 0.
    #[@External.Erlang("""(fun(__S, __X) -> case __X of <<>> -> 0; _ -> case binary:match(__S, __X) of nomatch -> -1; {__P, _} -> __P end end end)($0, $1)""")]
    #[@External.Node("indexOf")]
    fn indexOf(self: Self, sub: string) -> i32;

    #[@External.Node("toString")]
    default fn toString(self: Self) -> string {
        return self;
    }

    // ── std-tail F7.string_ext additions ────────────────────────────────────
    // Each is wired to the Node prototype method on commonJS plus an Erlang
    // shape that mirrors the semantic. `string:pad/3` is BIF on OTP 27+; we
    // gate behind `binary_to_list`/`list_to_binary` to keep the shape simple.

    #[@External.Erlang("(fun(__S, __L, __P) -> __N = max(__L - byte_size(__S), 0), __PadBin = case __P of <<>> -> <<>>; _ -> list_to_binary(lists:duplicate(__N, binary:first(__P))) end, <<__PadBin/binary, __S/binary>> end)($0, $1, $2)")]
    #[@External.Node("padStart")]
    fn padStart(self: Self, length: i32, pad: string) -> string;

    #[@External.Erlang("(fun(__S, __L, __P) -> __N = max(__L - byte_size(__S), 0), __PadBin = case __P of <<>> -> <<>>; _ -> list_to_binary(lists:duplicate(__N, binary:first(__P))) end, <<__S/binary, __PadBin/binary>> end)($0, $1, $2)")]
    #[@External.Node("padEnd")]
    fn padEnd(self: Self, length: i32, pad: string) -> string;

    #[@External.Erlang("binary:copy($0, $1)")]
    #[@External.Node("repeat")]
    fn repeat(self: Self, times: i32) -> string;

    #[@External.Erlang("(fun(__S, __P, __R) -> binary:replace(__S, __P, __R, [global]) end)($0, $1, $2)")]
    #[@External.Node("replaceAll")]
    fn replaceAll(self: Self, pattern: string, with: string) -> string;

    #[@External.Erlang("[<<__C/utf8>> || __C <- unicode:characters_to_list($0, utf8)]")]
    #[@External.Node("(Array.from($0))")]
    fn chars(self: Self) -> string[];

    #[@External.Erlang("""binary:split($0, [<<"\r\n">>, <<"\n">>], [global])""")]
    #[@External.Node("""$0.split(/\r?\n/)""")]
    fn lines(self: Self) -> string[];

    #[@External.Erlang("""[__W || __W <- binary:split($0, [<<" ">>, <<"\t">>, <<"\n">>, <<"\r">>], [global]), __W =/= <<>>]""")]
    #[@External.Node("""$0.split(/[ \t\n\r]+/).filter(__w => __w.length > 0)""")]
    fn words(self: Self) -> string[];

    // A template on a behavior method becomes a PROTOTYPE PATCH on commonJS
    // (`String.prototype.charCodeAt = …`), so it must not name the method it
    // patches: `$0.charCodeAt($1)` called the patch it had just installed and
    // every `.charCodeAt(…)` in the program blew the stack, in any module that
    // installed the `String` prelude for some other member (one `s.slice(…)`
    // is enough). Native `codePointAt` is not a member of this behavior, so no
    // patch ever replaces it, and it is what the `?? -1` was written for:
    // out of range it answers `undefined`, where `charCodeAt` answers `NaN`,
    // which `??` does not catch and `| 0` turned into `0`. It also answers the
    // CODE POINT, which is what the erlang form above answers.
    #[@External.Erlang("(fun(__S, __I) -> case unicode:characters_to_list(__S, utf8) of __L when length(__L) > __I, __I >= 0 -> lists:nth(__I + 1, __L); _ -> -1 end end)($0, $1)")]
    #[@External.Node("(($0.codePointAt($1) ?? -1) | 0)")]
    fn charCodeAt(self: Self, index: i32) -> i32;

    #[@External.Erlang("(fun(__S, __Sub) -> __L = byte_size(__S), __SL = byte_size(__Sub), __Find = fun __F(__I) -> case __I < 0 of true -> -1; false -> case binary:part(__S, __I, min(__SL, __L - __I)) =:= __Sub of true -> __I; false -> __F(__I - 1) end end end, __Find(__L - __SL) end)($0, $1)")]
    #[@External.Node("lastIndexOf")]
    fn lastIndexOf(self: Self, sub: string) -> i32;
}

// ── string slice arity dispatch ──────────────────────────────────────────────
// Host helpers behind `default fn slice`. commonJS patches
// `String.prototype.slice` with that body, so the Node templates must not call
// `.slice` (it would call the patch itself): they normalise the bounds the way
// native `slice` does and cut with `substring`. Markers are positional on every
// target: `$0` is the string, `$1` the start (decision 5).

#[@External.Erlang("string:slice($0, $1)")]
#[@External.Node("""((__s, __a) => { const __n = __s.length; const __b = __a < 0 ? Math.max(__n + __a, 0) : Math.min(__a, __n); return __s.substring(__b); })($0, $1)""")]
declare fn stringSlice0(self: string, start: i32) -> string;

#[@External.Erlang("string:slice($0, $1, (($2) - ($1)))")]
#[@External.Node("""((__s, __a, __e) => { const __n = __s.length; const __b = __a < 0 ? Math.max(__n + __a, 0) : Math.min(__a, __n); const __f = __e < 0 ? Math.max(__n + __e, 0) : Math.min(__e, __n); return __s.substring(__b, Math.max(__b, __f)); })($0, $1, $2)""")]
declare fn stringSlice1(self: string, start: i32, end: ?i32) -> string;

// ── function combinators ──────────────────────────────────────────────────────

// Pure higher-order combinators for function values. Associated functions
// (no `self` receiver): `Function.identity(x)`, `Function.compose(f, g)`, …
// Pure botopink — `default` bodies, no host backing.
behavior Function {
    default fn identity<A>(x: A) -> A {
        return x;
    }

    default fn compose<A, B, C>(
        f: fn(a: A) -> B,
        g: fn(b: B) -> C,
    ) -> fn(A) -> C {
        return { a -> g(f(a)) };
    }

    default fn flip<A, B, C>(f: fn(a: A, b: B) -> C) -> fn(B, A) -> C {
        return { b, a -> f(a, b) };
    }

    default fn constant<A, B>(x: A) -> fn(B) -> A {
        return { ignored -> x };
    }
}

// A pair IS a 2-tuple `#(A, B)` — structural, so no own record type. Associated
// functions (no `self` receiver) over tuples: `Pair.of(a, b)`, `Pair.first(p)`, …
// Pure botopink — `default` bodies, no host backing.
behavior Pair<A, B> {
    // NOTE: named `of` (not `new`) — `new` is a reserved keyword.
    default fn of(first: A, second: B) -> #(A, B) {
        return #(first, second);
    }

    default fn first(p: #(A, B)) -> A {
        return p._0;
    }

    default fn second(p: #(A, B)) -> B {
        return p._1;
    }

    default fn swap(p: #(A, B)) -> #(B, A) {
        return #(p._1, p._0);
    }

    default fn mapFirst<C>(
        p: #(A, B),
        transform: fn(value: A) -> C,
    ) -> #(C, B) {
        return #(transform(p._0), p._1);
    }

    default fn mapSecond<C>(
        p: #(A, B),
        transform: fn(value: B) -> C,
    ) -> #(A, C) {
        return #(p._0, transform(p._1));
    }
}

// ── array (eager collection) ──────────────────────────────────────
// The eager indexed collection — implements the lazy `Iterator<T>` (`next`)
// and adds `length`/index + host-backed ops, with derived `default fn`.

// NOTE: conceptually `Array<T>` is an `Iterator<T>` (it provides `next`), but the
// parser puts generics after `extends` (`behavior N extends B <T>`), so a
// generic-extends-generic clause doesn't parse yet — kept standalone for now.
//
// `Array<T>` answers `Index<i32, T>` (`at`) and `Slice<T[]>` (`slice`) — the two
// ambient behaviors of `builtins.d.bp` that make `xs[0]` and `xs[0..2]` legal
// (decision 63, amended). Written as a comment for the same reason as `String`
// above: a `behavior` declaration carries no `implement` clause.
behavior Array<T> {
    // intrinsic length (builtin).
    val length: i32;

    // ── host-backed primitives ──
    // `Index<i32, T>.at` — the reader `xs[0]` rewrites to.
    #[@External.Erlang("(fun(__L, __I) -> case ((__I >= 0) andalso (__I < length(__L))) of true -> lists:nth(__I + 1, __L); false -> undefined end end)($0, $1)")]
    #[@External.Node("at")]
    fn at(self: Self, index: i32) -> ?T;

    #[@External.Erlang("($0 ++ [$1])")]
    #[@External.Node("push")]
    fn push(self: Self, item: T);

    #[@External.Erlang("lists", "last")]
    #[@External.Node("pop")]
    fn pop(self: Self) -> ?T;

    // `Slice<T[]>.slice` — `end` is `?i32` so an open-ended `xs[1..]` can pass
    // `null` in the second argument (there is no `Range` type to pass).
    default fn slice(self: Self, start: i32, end: ?i32 = null) -> Self {
        if (end != null) return arraySlice1(self, start, end) else return arraySlice0(
            self,
            start
        );
    }

    #[@External.Erlang("""iolist_to_binary(lists:join($1, lists:map(fun(__E) -> if is_binary(__E) -> __E; is_integer(__E) -> integer_to_binary(__E); is_list(__E) -> __E; true -> $stringify(__E) end end, $0)))""")]
    #[@External.Node("join")]
    fn join(self: Self, sep: string) -> string;

    // `reverse` ANSWERS a reversed array and leaves the receiver alone, on
    // every target. Native `Array.prototype.reverse` reverses in place and
    // answers the same array, so on commonJS alone `val rev = xs.reverse();`
    // also reversed `xs` — every fold that read the receiver again after
    // reversing it answered one thing there and another on erlang and wasm,
    // at exit 0. `toReversed` is the §A4 rename to the engine's own copying
    // reader (ES2023; node 20, which is the floor CI installs), so the answer
    // is the same shape with no prototype patch and no helper.
    #[@External.Erlang("lists", "reverse")]
    #[@External.Beam("""    {call_ext, 1, {extfunc, lists, reverse, 1}}.""")]
    #[@External.Node("toReversed")]
    fn reverse(self: Self) -> Self;

    #[@External.Erlang("(fun(__L, __X) -> __Find = fun __F(__I, [__H | __T]) -> case (__H =:= __X) of true -> __I; false -> __F(__I + 1, __T) end; __F(_, []) -> -1 end, __Find(0, __L) end)($0, $1)")]
    #[@External.Node("indexOf")]
    fn indexOf(self: Self, item: T) -> i32;

    #[@External.Erlang("lists", "foreach(action, self)")]
    #[@External.Node("forEach")]
    fn forEach(self: Self, action: fn(item: T));

    #[@External.Erlang("lists", "map(transform, self)")]
    #[@External.Node("map")]
    fn map<U>(self: Self, transform: fn(item: T) -> U) -> Array<U>;

    #[@External.Erlang("lists", "filter(pred, self)")]
    #[@External.Node("filter")]
    fn filter(self: Self, pred: fn(item: T) -> bool) -> Self;

    // `zip` pairs the receiver's items with `other`'s by index, truncating to
    // the shorter array. Template form: erlang uses `lists:zipwith` with a
    // tuple constructor; node uses an inline `.map` with index lookup +
    // truncation. wat deferred — no native zip primitive (logged as a known
    // gap; falls through to the inline allow-list as today).
    #[@External.Erlang("lists:zipwith(fun(__X, __Y) -> {__X, __Y} end, lists:sublist($0, length($1)), lists:sublist($1, length($0)))")]
    #[@External.Node("$0.map((__x, __i) => [__x, ($1)[__i]]).slice(0, Math.min($0.length, ($1).length))")]
    fn zip<U>(self: Self, other: Array<U>) -> Array<#(T, U)>;

    // ── producers (associated — no receiver) ──
    // Pure botopink (no host backing): the host `lists:seq`/`duplicate` have the
    // wrong semantics (`seq` is end-inclusive; `duplicate` swaps the args), so
    // these recurse with an array-literal spread `[head, ..tail]`, giving
    // identical end-exclusive `[start, stop)` / `times`-copy results on every
    // backend. `head` is bound to a `val` first so the BEAM backend spills it to a
    // stack slot — an x-register would be clobbered by the recursive call. (No
    // comments inside the bodies: the commonJS if-expr emits as a one-line IIFE,
    // where a `//` would swallow the rest of the block.)
    default fn range(start: i32, stop: i32) -> Array<i32> {
        return if (start >= stop) [] else {
            val head = start;
            [head, ..(Array.range(start + 1, stop))];
        };
    }

    default fn repeat<E>(value: E, times: i32) -> Array<E> {
        return if (times <= 0) [] else {
            val head = value;
            [head, ..(Array.repeat(value, times - 1))];
        };
    }

    // ── derived ops (default implementations over the primitives) ──
    #[@External.Erlang("($0 =:= [])")]
    default fn isEmpty(self: Self) -> bool {
        return self.length == 0;
    }

    #[@External.Erlang("lists:member($1, $0)")]
    default fn contains(self: Self, x: T) -> bool {
        return self.indexOf(x) != -1;
    }

    default fn first(self: Self) -> ?T {
        return self.at(0);
    }

    default fn rest(self: Self) -> Self {
        return self.slice(1, self.length);
    }

    default fn take(self: Self, n: i32) -> Self {
        return self.slice(0, n);
    }

    default fn drop(self: Self, n: i32) -> Self {
        return self.slice(n, self.length);
    }

    default fn fold<A>(
        self: Self,
        initial: A,
        f: fn(acc: A, item: T) -> A,
    ) -> A {
        var acc = initial;
        self.forEach({ x ->
            acc = f(acc, x);
        });
        return acc;
    }

    #[@External.Node("find")]
    default fn find(self: Self, pred: fn(item: T) -> bool) -> ?T {
        return self.filter(pred).at(0);
    }

    default fn count(self: Self, pred: fn(item: T) -> bool) -> i32 {
        return self.filter(pred).length;
    }

    default fn all(self: Self, pred: fn(item: T) -> bool) -> bool {
        return self.filter(pred).length == self.length;
    }

    default fn any(self: Self, pred: fn(item: T) -> bool) -> bool {
        return self.filter(pred).length != 0;
    }

    #[@External.Erlang("($0 ++ $1)")]
    #[@External.Node("concat")]
    default fn append(self: Self, other: Self) -> Self {
        var out = self.slice(0, self.length);
        other.forEach({ y -> out.push(y) });
        return out;
    }

    #[@External.Erlang("[$1 | $0]")]
    default fn prepend(self: Self, item: T) -> Self {
        var out = [item];
        self.forEach({ x -> out.push(x) });
        return out;
    }

    // NOTE: nested trailing lambdas don't parse yet (catalogued gap) — the inner
    // copy goes through `append` rather than a nested `forEach`.
    default fn flatten<E>(self: Self) -> Array<E> {
        var out = [];
        self.forEach({ inner ->
            out = out.append(inner);
        });
        return out;
    }

    #[@External.Node("flatMap")]
    default fn flatMap<U>(self: Self, transform: fn(item: T) -> U) -> Array<U> {
        return self.map(transform).flatten();
    }

    default fn toList(self: Self) -> Self {
        return self;
    }

    // ── std-tail F7.array_ext additions ──────────────────────────────────────
    // `some`/`every`/`flat` aliases over the existing `any`/`all`/`flatten`
    // (different camelCase name, identical semantics — chosen to mirror the
    // Node Array prototype). The originals stay so existing callers don't
    // break.
    default fn some(self: Self, pred: fn(item: T) -> bool) -> bool {
        return self.any(pred);
    }

    default fn every(self: Self, pred: fn(item: T) -> bool) -> bool {
        return self.all(pred);
    }

    default fn flat<E>(self: Self) -> Array<E> {
        return self.flatten();
    }

    // First index where `pred` holds, or -1 when no element matches. Pure
    // botopink — recurses over indices through a fold that captures the
    // first hit (`-1` is preserved once set).
    default fn findIndex(self: Self, pred: fn(item: T) -> bool) -> i32 {
        var out = -1;
        var i = 0;
        self.forEach({ x ->
            if (out == -1) if (pred(x)) out = i;
            i = i + 1;
        });
        return out;
    }

    // Build a fresh array of `length` copies of `value` — equivalent to
    // `Array.repeat(value, self.length)`, but the receiver-method form
    // matches the JS prototype signature callers expect.
    default fn fill<E>(self: Self, value: E) -> Array<E> {
        return Array.repeat(value, self.length);
    }

    // Partition the array into consecutive chunks of `n` elements; the last
    // chunk may be shorter when `self.length` is not divisible by `n`.
    // Negative or zero `n` returns an empty array (no infinite loop).
    default fn chunked(self: Self, n: i32) -> Array<Self> {
        var out = [];
        if (n <= 0) return out;
        val len = self.length;
        for (0..len) { k ->
            if (k % n == 0) out = out.append([self.slice(k, k + n)]);
        };
        return out;
    }

    // Sliding window of length `n` over the array. Returns one window per
    // valid start offset (`self.length - n + 1` windows). Negative or zero
    // `n`, or `n > self.length`, returns an empty array.
    default fn sliding(self: Self, n: i32) -> Array<Self> {
        var out = [];
        if (n <= 0) return out;
        val windows = self.length - n + 1;
        if (windows <= 0) return out;
        for (0..windows) { k ->
            out = out.append([self.slice(k, k + n)]);
        };
        return out;
    }

    // Drop consecutive duplicates. Matches the Node Array convention —
    // non-consecutive de-dup is `xs.fold([], …)` (left to callers since it
    // needs an equality predicate that interacts with generic `T`).
    default fn unique(self: Self) -> Self {
        var out = [];
        var seenLast = false;
        var prev = self.at(0);
        self.forEach({ x ->
            if (seenLast) {
                if (prev.unwrapOr(x) != x) {
                    out = out.append([x]);
                    prev = self.at(out.length);
                };
            } else {
                out = out.append([x]);
                seenLast = true;
                prev = self.at(0);
            };
        });
        return out;
    }
}

// ── array slice arity dispatch ───────────────────────────────────────────────
// Same shape as the string pair above: commonJS patches `Array.prototype.slice`
// with `default fn slice`, so the Node templates copy the normalised range
// without calling `.slice`.

#[@External.Erlang("lists:nthtail($1, $0)")]
#[@External.Node("""((__xs, __a) => { const __n = __xs.length; const __b = __a < 0 ? Math.max(__n + __a, 0) : Math.min(__a, __n); return Array.from({ length: __n - __b }, (_, __i) => __xs[__b + __i]); })($0, $1)""")]
declare fn arraySlice0<T>(self: Array<T>, start: i32) -> Array<T>;

#[@External.Erlang("lists:sublist($0, ($1) + 1, (($2) - ($1)))")]
#[@External.Node("""((__xs, __a, __e) => { const __n = __xs.length; const __b = __a < 0 ? Math.max(__n + __a, 0) : Math.min(__a, __n); const __f = __e < 0 ? Math.max(__n + __e, 0) : Math.min(__e, __n); return Array.from({ length: Math.max(__f - __b, 0) }, (_, __i) => __xs[__b + __i]); })($0, $1, $2)""")]
declare fn arraySlice1<T>(self: Array<T>, start: i32, end: ?i32) -> Array<T>;

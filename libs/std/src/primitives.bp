//// Primitive controller — the central interface registry for botopink's
//// primitive types. Declarations only (no bodies): the type checker consumes
//// the signatures, and `#[compiler.external(.<Target>(...))]` tells each codegen
//// backend how to lower the operation (host symbol per target). Pure-logic
//// operations carry no `@External.*` — the compiler synthesises them.
////
//// Naming convention: camelCase (the legacy snake_case surface is normalised
//// here). Method receivers are `self: Self`; the function combinators are
//// std's `functions` module (decision 738).

import {compiler};

// ── numeric tower ─────────────────────────────────────────────────────────────
// Contracts shared by the numeric widths. `Self` abstracts the concrete type,
// so one signature serves all widths; a contract carries no host code, and
// each width declares the members it runs on the host itself.

// The contracts of the numeric types: signatures and `default fn` bodies in
// botopink, and no host code (decision 617 (2)). A width's host code lives on
// the width's own type below (617 (3)), `Self` written as the width.
behavior Number {
    fn min(self: Self, other: Self) -> Self;

    fn max(self: Self, other: Self) -> Self;

    default fn clamp(self: Self, lo: Self, hi: Self) -> Self {
        return self.max(lo).min(hi);
    }
}

behavior Integer extends Number {
    fn toString(self: Self) -> string;

    default fn isEven(self: Self) -> bool {
        return self % 2 == 0;
    }

    default fn isOdd(self: Self) -> bool {
        return self % 2 != 0;
    }

    // ── conversions (decision 319) ───────────────────────────────────────
    // Explicit and exact: the value when the target type holds it, else an
    // abort naming the value and the type — never a wrap, a saturation or a
    // rounding. One form per target type, whatever the receiver's width.

    fn toI32(self: Self) -> i32;

    fn toI64(self: Self) -> i64;

    fn toU32(self: Self) -> u32;

    fn toU64(self: Self) -> u64;

    // The `f64` equal to the integer; an integer between two `f64`s (past
    // 2^53 an `f64` counts by two, then by four, …) aborts.
    fn toF64(self: Self) -> f64;
}

behavior Signed extends Integer {
    // Each signed width declares its own `abs` (decision 496): it aborts past
    // the width's bound, as unary `-` does.
    fn abs(self: Self) -> Self;
}

behavior Float extends Number {
    fn toString(self: Self) -> string;

    fn abs(self: Self) -> Self;

    fn floor(self: Self) -> Self;

    fn ceil(self: Self) -> Self;

    // Ties round up, as `Math.round` does, and the answer keeps the float type.
    fn round(self: Self) -> Self;

    fn squareRoot(self: Self) -> Self;
}

// The primitive widths are types (decision 617 (1)): each names the contract
// it implements, and a method on a width is found through that `implement`
// clause and the contracts' `extends` — the checker and every backend read it
// here. A width has no field list: the language gives its values. Each width
// declares the members its contracts leave to it, with their host code
// (617 (3)).
//
// commonJS holds an `i64` / `u64` past ±(2^53 − 1) as a `BigInt` (decision
// 319), and the emitter patches these methods on `BigInt.prototype` as well as
// on `Number.prototype`. A Node form here therefore takes a `number` or a
// `BigInt` and answers the canonical one. `Math.*` throws a `TypeError` on a
// `BigInt`, so `min` / `max` / `abs` are written out with `<` (exact across
// the two kinds), answering an operand as it came, and keep `Math.*`'s
// answers on numbers: a `NaN` operand is `NaN`, `-0` is below `0`. The integer
// conversions' erlang forms raise as an overflowing operator does
// (`{integer_overflow, What}`); their Node forms take a `number` or a
// `BigInt` and answer the canonical form (a `BigInt` only past ±(2^53 − 1)).
// `isEven` / `isOdd` run the contract's algorithm in botopink on erlang and
// wasm (`body:`, decision 610), and a form that reads a `BigInt` on commonJS.

pub type i32 implement Signed {
    #[compiler.external(
        .Erlang("erlang:min($0, $1)"),
        .JavaScript("""((__a, __b) => (__a !== __a || __b !== __b) ? NaN : (__b < __a || (__b === __a && Object.is(__b, -0))) ? __b : __a)($0, $1)"""),
    )]
    pub declare fn min(self: Self, other: Self) -> Self;

    #[compiler.external(
        .Erlang("erlang:max($0, $1)"),
        .JavaScript("""((__a, __b) => (__a !== __a || __b !== __b) ? NaN : (__b > __a || (__b === __a && Object.is(__a, -0))) ? __b : __a)($0, $1)"""),
    )]
    pub declare fn max(self: Self, other: Self) -> Self;

    #[compiler.external(.Erlang("erlang:integer_to_binary($0)"), .JavaScript("toString"))]
    pub declare fn toString(self: Self) -> string;

    #[compiler.external(
        .JavaScript("""((__a) => typeof __a === "bigint" ? __a % 2n === 0n : __a % 2 === 0)($0)"""),
        .Erlang(body: i32IsEvenBody),
        .Wasm(body: i32IsEvenBody),
    )]
    pub declare fn isEven(self: Self) -> bool;

    #[compiler.external(
        .JavaScript("""((__a) => typeof __a === "bigint" ? __a % 2n !== 0n : __a % 2 !== 0)($0)"""),
        .Erlang(body: i32IsOddBody),
        .Wasm(body: i32IsOddBody),
    )]
    pub declare fn isOdd(self: Self) -> bool;

    #[compiler.external(
        .Erlang("""(fun(__V) when __V >= -2147483648, __V =< 2147483647 -> __V; (__V) -> erlang:error({integer_overflow, <<"toI32: ", (integer_to_binary(__V))/binary, " does not fit i32">>}) end)($0)"""),
        .JavaScript("""((__v) => { if (__v >= -2147483648 && __v <= 2147483647) { return Number(__v); } throw new Error("integer overflow: toI32: " + __v + " does not fit i32"); })($0)"""),
    )]
    pub declare fn toI32(self: Self) -> i32;

    #[compiler.external(
        .Erlang("""(fun(__V) when __V >= -9223372036854775807 - 1, __V =< 9223372036854775807 -> __V; (__V) -> erlang:error({integer_overflow, <<"toI64: ", (integer_to_binary(__V))/binary, " does not fit i64">>}) end)($0)"""),
        .JavaScript("""((__v) => { if (__v >= -9223372036854775808n && __v <= 9223372036854775807n) { return (__v >= -9007199254740991n && __v <= 9007199254740991n) ? Number(__v) : __v; } throw new Error("integer overflow: toI64: " + __v + " does not fit i64"); })($0)"""),
    )]
    pub declare fn toI64(self: Self) -> i64;

    #[compiler.external(
        .Erlang("""(fun(__V) when __V >= 0, __V =< 4294967295 -> __V; (__V) -> erlang:error({integer_overflow, <<"toU32: ", (integer_to_binary(__V))/binary, " does not fit u32">>}) end)($0)"""),
        .JavaScript("""((__v) => { if (__v >= 0 && __v <= 4294967295) { return Number(__v); } throw new Error("integer overflow: toU32: " + __v + " does not fit u32"); })($0)"""),
    )]
    pub declare fn toU32(self: Self) -> u32;

    #[compiler.external(
        .Erlang("""(fun(__V) when __V >= 0, __V < (1 bsl 64) -> __V; (__V) -> erlang:error({integer_overflow, <<"toU64: ", (integer_to_binary(__V))/binary, " does not fit u64">>}) end)($0)"""),
        .JavaScript("""((__v) => { if (__v >= 0 && __v <= 18446744073709551615n) { return __v; } throw new Error("integer overflow: toU64: " + __v + " does not fit u64"); })($0)"""),
    )]
    pub declare fn toU64(self: Self) -> u64;

    #[compiler.external(
        .Erlang("""(fun(__V) -> __F = float(__V), case trunc(__F) =:= __V of true -> __F; false -> erlang:error({integer_overflow, <<"toF64: ", (integer_to_binary(__V))/binary, " has no exact f64">>}) end end)($0)"""),
        .JavaScript("""((__v) => { const __f = Number(__v); if (typeof __v !== "bigint" || BigInt(__f) === __v) { return __f; } throw new Error("integer overflow: toF64: " + __v + " has no exact f64"); })($0)"""),
    )]
    pub declare fn toF64(self: Self) -> f64;

    // `abs` aborts past `i32` as unary `-` does (decision 496): the lowest
    // `i32` has no positive counterpart in `i32`.
    #[compiler.external(
        .Erlang("""(fun(__V) when __V =/= -2147483648 -> erlang:abs(__V); (_) -> erlang:error({integer_overflow, <<"integer overflow: abs on i32">>}) end)($0)"""),
        .JavaScript("""((__a) => { if (__a === -2147483648) { throw Object.defineProperty(new Error("integer overflow: abs on i32"), "__bp_panic", { value: true }); } return (__a < 0 || Object.is(__a, -0)) ? -__a : __a; })($0)"""),
    )]
    pub declare fn abs(self: Self) -> Self;
}

pub type i64 implement Signed {
    #[compiler.external(
        .Erlang("erlang:min($0, $1)"),
        .JavaScript("""((__a, __b) => (__a !== __a || __b !== __b) ? NaN : (__b < __a || (__b === __a && Object.is(__b, -0))) ? __b : __a)($0, $1)"""),

    // (`String.prototype.charCodeAt = …`), so it must not name the method it
    // patches: `$0.charCodeAt($1)` called the patch it had just installed and
    // every `.charCodeAt(…)` in the program blew the stack, in any module that
    // installed the `string` prelude for some other member (one `s.slice(…)`
    // is enough). Native `codePointAt` is not a member of this type, so no
    // patch ever replaces it, and it is what the `?? -1` was written for:
    // out of range it answers `undefined`, where `charCodeAt` answers `NaN`,
    // which `??` does not catch and `| 0` turned into `0`. It also answers the
    // CODE POINT, which is what the erlang form above answers.
    #[compiler.external(
        .Erlang("(fun(__S, __I) -> case unicode:characters_to_list(__S, utf8) of __L when length(__L) > __I, __I >= 0 -> lists:nth(__I + 1, __L); _ -> -1 end end)($0, $1)"),
        .JavaScript("""((__s, __i) => { if (/[\u{D800}-\u{DFFF}\u{10000}-\u{10FFFF}]/u.test(__s)) { const __c = __i >= 0 ? Array.from(__s)[__i] : undefined; return __c === undefined ? -1 : __c.codePointAt(0); } return (__s.codePointAt(__i) ?? -1) | 0; })($0, $1)"""),
        .Wasm(std: "text.charCodeAt"),
    )]
    pub declare fn charCodeAt(self: Self, index: i32) -> i32;

    // The last match is found over the bytes and answered in `indexOf`'s unit
    // (decisions 169, 320): the codepoints of the text before it.
    #[compiler.external(
        .Erlang("(fun(__S, __Sub) -> __L = byte_size(__S), __SL = byte_size(__Sub), __Find = fun __F(__I) -> case __I < 0 of true -> -1; false -> case binary:part(__S, __I, min(__SL, __L - __I)) =:= __Sub of true -> erlang:length(unicode:characters_to_list(binary:part(__S, 0, __I))); false -> __F(__I - 1) end end end, __Find(__L - __SL) end)($0, $1)"),
        .JavaScript("lastIndexOf"),
        .Wasm(std: "text.lastIndexOf"),
    )]
    pub declare fn lastIndexOf(self: Self, sub: string) -> i32;

    // The integer a decimal numeral spells: an optional `+` or `-`, then the
    // digits `0`–`9` and nothing else — the WHOLE string, so whitespace, a
    // fraction, an exponent, `0x2A` and the empty string are an `Error` naming
    // the input. Which strings are numerals is decided here, in botopink, so
    // every target refuses the same inputs; the host cell converts digits it
    // is never asked to judge. The answer is any `i64`, exact on every
    // target: a numeral past −2^63 … 2^63 − 1 is an `Error` on every target
    // (decision 176 as amended by 319; commonJS answers a `BigInt` past
    // ±(2^53 − 1)).
    //
    // The body calls a method on `self` only, and free cells for the rest —
    // see `libs/std/AGENTS.md` § String numerals for the three emitter gaps
    // that shape it.
    pub fn parseInt(self: Self) -> Result<i64, string> {
        val signed = self.startsWith("-") || self.startsWith("+");
        val digits = if (signed) stringSlice0(self, 1) else self;
        return if (stringIsDigits(digits))
            stringToInteger(self)
        else
            stringIntegerRefused(self);
    }

    // The `f64` nearest to a decimal numeral: an optional `+` or `-`, digits,
    // an optional `.` with digits on BOTH sides, an optional exponent (`e` or
    // `E`, an optional sign, digits) — the whole string. `.5`, `1.`, `1e`,
    // `NaN`, `Infinity`, `0x10`, whitespace and the empty string are an
    // `Error` naming the input, decided in botopink; the host cell converts
    // the numeral rewritten as `<digits>.<digits>e<exponent>` (the one form
    // both hosts read), correctly rounded on both. A numeral too large for an
    // `f64` is an `Error`; one too small to tell from zero is `0.0`.
    pub fn parseFloat(self: Self) -> Result<f64, string> {
        val signed = self.startsWith("-") || self.startsWith("+");
        val start = if (signed) 1 else 0;
        val lowerAt = self.indexOf("e");
        val exponentAt = if (lowerAt < 0) self.indexOf("E") else lowerAt;
        val mantissa = if (exponentAt < 0)
            stringSlice0(self, start)
        else
            stringSlice1(self, start, exponentAt);
        val pointAt = self.indexOf(".");
        val pointed = pointAt >= 0 && (exponentAt < 0 || pointAt < exponentAt);
        val whole = if (pointed)
            stringSlice1(self, start, pointAt)
        else
            mantissa;
        val fraction = if (pointed == false)
            "0"
        else if (exponentAt < 0)
            stringSlice0(self, pointAt + 1)
        else
            stringSlice1(self, pointAt + 1, exponentAt);
        val exponent = if (exponentAt < 0)
            "0"
        else
            stringSlice0(self, exponentAt + 1);
        val exponentMark = if (exponentAt < 0)
            ""
        else
            stringSlice1(self, exponentAt + 1, exponentAt + 2);
        val exponentSigned = exponentMark == "-" || exponentMark == "+";
        val exponentDigits = if (exponentSigned)
            stringSlice0(self, exponentAt + 2)
        else
            exponent;
        val wellFormed = stringIsDigits(whole)
            && stringIsDigits(fraction)
            && stringIsDigits(exponentDigits);
        return if (wellFormed)
            stringToFloat(self, whole, fraction, exponent)
        else
            stringFloatRefused(self);
    }
}

fn stringToStringBody(value: string) -> string {
    return value;
}

// ── string slice arity dispatch ──────────────────────────────────────────────
// Host helpers behind `default fn slice`; wasm's are std-wasm's
// (`text.sliceFrom`, `text.sliceBetween`, a `null` end open). commonJS patches
// `String.prototype.slice` with that body, so the Node templates must not call
// `.slice` (it would call the patch itself): they normalise the bounds the way
// native `slice` does and cut with `substring`. Markers are positional on every
// target: `$0` is the string, `$1` the start (decision 5). The erlang forms
// count codepoints (decision 320) over the decoded codepoint list — never
// `string:slice/3`, whose unit is the grapheme cluster — and normalise the
// bounds as the Node forms do.

#[compiler.external(
    .Erlang("""(fun(__S, __A) -> __L = unicode:characters_to_list(__S), __N = erlang:length(__L), __B = case __A < 0 of true -> erlang:max(__N + __A, 0); false -> erlang:min(__A, __N) end, unicode:characters_to_binary(lists:nthtail(__B, __L)) end)($0, $1)"""),
    .JavaScript("""((__s, __a) => { if (__a == null) __a = 0; if (/[\u{D800}-\u{DFFF}\u{10000}-\u{10FFFF}]/u.test(__s)) { const __c = Array.from(__s); const __m = __c.length; const __d = __a < 0 ? Math.max(__m + __a, 0) : Math.min(__a, __m); return Array.from({ length: __m - __d }, (_, __i) => __c[__d + __i]).join(""); } const __n = __s.length; const __b = __a < 0 ? Math.max(__n + __a, 0) : Math.min(__a, __n); return __s.substring(__b); })($0, $1)"""),
    .Wasm(std: "text.sliceFrom"),
)]
declare fn stringSlice0(s: string, start: i32) -> string;

#[compiler.external(
    .Erlang("""(fun(__S, __A, __E) -> __L = unicode:characters_to_list(__S), __N = erlang:length(__L), __B = case __A < 0 of true -> erlang:max(__N + __A, 0); false -> erlang:min(__A, __N) end, __F = case __E < 0 of true -> erlang:max(__N + __E, 0); false -> erlang:min(__E, __N) end, unicode:characters_to_binary(lists:sublist(__L, __B + 1, erlang:max(__F - __B, 0))) end)($0, $1, $2)"""),
    .JavaScript("""((__s, __a, __e) => { if (__a == null) __a = 0; if (/[\u{D800}-\u{DFFF}\u{10000}-\u{10FFFF}]/u.test(__s)) { const __c = Array.from(__s); const __m = __c.length; const __d = __a < 0 ? Math.max(__m + __a, 0) : Math.min(__a, __m); const __g = __e < 0 ? Math.max(__m + __e, 0) : Math.min(__e, __m); return Array.from({ length: Math.max(__g - __d, 0) }, (_, __i) => __c[__d + __i]).join(""); } const __n = __s.length; const __b = __a < 0 ? Math.max(__n + __a, 0) : Math.min(__a, __n); const __f = __e < 0 ? Math.max(__n + __e, 0) : Math.min(__e, __n); return __s.substring(__b, Math.max(__b, __f)); })($0, $1, $2)"""),
    .Wasm(std: "text.sliceBetween"),
)]
declare fn stringSlice1(s: string, start: i32, end: ?i32) -> string;

// ── bytes slice arity dispatch ───────────────────────────────────────────────
// The string pair's shape, over bytes: commonJS patches
// `Uint8Array.prototype.slice` with `bytes`' `default fn slice`, so the Node
// templates cut with `subarray` and copy. wasm lowers `slice` itself.

#[compiler.external(
    .Erlang("""(fun(__B, __A) -> __N = byte_size(__B), __S = case __A < 0 of true -> erlang:max(__N + __A, 0); false -> erlang:min(__A, __N) end, binary:part(__B, __S, __N - __S) end)($0, $1)"""),
    .JavaScript("""((__b, __a) => { if (__a == null) __a = 0; const __n = __b.length; const __s = __a < 0 ? Math.max(__n + __a, 0) : Math.min(__a, __n); return new Uint8Array(__b.subarray(__s, __n)); })($0, $1)"""),
)]
declare fn bytesSlice0(b: bytes, start: i32) -> bytes;

#[compiler.external(
    .Erlang("""(fun(__B, __A, __E) -> __N = byte_size(__B), __S = case __A < 0 of true -> erlang:max(__N + __A, 0); false -> erlang:min(__A, __N) end, __F = case __E < 0 of true -> erlang:max(__N + __E, 0); false -> erlang:min(__E, __N) end, binary:part(__B, __S, erlang:max(__F - __S, 0)) end)($0, $1, $2)"""),
    .JavaScript("""((__b, __a, __e) => { if (__a == null) __a = 0; const __n = __b.length; const __s = __a < 0 ? Math.max(__n + __a, 0) : Math.min(__a, __n); const __f = __e < 0 ? Math.max(__n + __e, 0) : Math.min(__e, __n); return new Uint8Array(__b.subarray(__s, Math.max(__s, __f))); })($0, $1, $2)"""),
)]
declare fn bytesSlice1(b: bytes, start: i32, end: ?i32) -> bytes;

// ── string numerals ──────────────────────────────────────────────────────────
// Host helpers behind `default fn parseInt` / `parseFloat`. The methods decide
// in botopink which strings are numerals; these convert, and build the
// `Result` and its text — a `default fn` body of this file is emitted as
// written on commonJS, where `Ok(…)` / `Error(…)` name nothing. wasm's and
// the comptime runtime's are std-wasm's (`number.*`).

// True when `s` is one or more of the digits `0`–`9` and nothing else.
#[compiler.external(
    .Erlang("""(fun(__S) -> (__S =/= <<>>) andalso lists:all(fun(__C) -> (__C >= 48) andalso (__C =< 57) end, binary_to_list(__S)) end)($0)"""),
    .JavaScript("""(/^[0-9]+$/.test($0))"""),
    .Wasm(std: "number.isDigits"),
)]
declare fn stringIsDigits(s: string) -> bool;

// The integer `<sign><digits>` spells; the out-of-range `Error`, naming the
// numeral, past the `i64` range. The Node form reads the digits as a `BigInt`
// and answers 319's canonical form (a `number` within ±(2^53 − 1)).
#[compiler.external(
    .Erlang("""(fun(__S) -> __N = binary_to_integer(__S), case (__N >= -9223372036854775807 - 1) andalso (__N =< 9223372036854775807) of true -> {ok, __N}; false -> {error, <<"parseInt: ", 34, __S/binary, 34, " is out of range">>} end end)($0)"""),
    .JavaScript("""((__s) => { const __n = BigInt(__s); return (__n >= -9223372036854775808n && __n <= 9223372036854775807n) ? { ok: (__n >= -9007199254740991n && __n <= 9007199254740991n) ? Number(__n) : __n } : { error: 'parseInt: "' + __s + '" is out of range' } })($0)"""),
    .Wasm(std: "number.toInteger"),
)]
declare fn stringToInteger(numeral: string) -> Result<i64, string>;

// The `f64` the numeral `text` spells, read from its accepted pieces as
// `<sign><whole>.<fraction>e<exponent>`; the overflow `Error`, naming `text`,
// when it does not fit. `string:to_float/1` answers `{error, no_float}` on an
// overflow and `0.0` on an underflow, which is what `Number` does with `Infinity` and `0`.
#[compiler.external(
    .Erlang("""(fun(__T, __W, __F, __X) -> __Sign = case __T of <<45, _/binary>> -> <<45>>; _ -> <<>> end, case string:to_float(binary_to_list(<<__Sign/binary, __W/binary, 46, __F/binary, 101, __X/binary>>)) of {__N, []} -> {ok, __N}; _ -> {error, <<"parseFloat: ", 34, __T/binary, 34, " overflows f64">>} end end)($0, $1, $2, $3)"""),
    .JavaScript("""((__t, __w, __f, __x) => { const __n = Number((__t.startsWith('-') ? '-' : '') + __w + '.' + __f + 'e' + __x); return Number.isFinite(__n) ? { ok: __n } : { error: 'parseFloat: "' + __t + '" overflows f64' } })($0, $1, $2, $3)"""),
    .Wasm(std: "number.toFloat"),
)]
declare fn stringToFloat(
    text: string,
    whole: string,
    fraction: string,
    exponent: string,
) -> Result<f64, string>;

// The `Error` of a text that is no numeral, one per `Result` the numerals
// answer: `Error(…)` is no constructor (decision 208), so the host builds it.
#[compiler.external(
    .Erlang("""{error, <<"parseInt: ", 34, ($0)/binary, 34, " is not an integer">>}"""),
    .JavaScript("""({ error: 'parseInt: "' + $0 + '" is not an integer' })"""),
    .Wasm(std: "number.integerRefused"),
)]
declare fn stringIntegerRefused(text: string) -> Result<i64, string>;

#[compiler.external(
    .Erlang("""{error, <<"parseFloat: ", 34, ($0)/binary, 34, " is not a number">>}"""),
    .JavaScript("""({ error: 'parseFloat: "' + $0 + '" is not a number' })"""),
    .Wasm(std: "number.floatRefused"),
)]
declare fn stringFloatRefused(text: string) -> Result<f64, string>;

// ── array (eager collection) ──────────────────────────────────────
// The eager indexed collection — implements the lazy `Iter<T>` (`next`)
// and adds `length`/index + host-backed ops, with derived methods in botopink.

// NOTE: conceptually `array<T>` is an `Iter<T>` (it provides `next`), but the
// parser puts generics after `extends` (`behavior N extends B <T>`), so a
// generic-extends-generic clause doesn't parse yet — kept standalone for now.
//
// `array<T>` answers `Index<i32, T>` (`at`) and `Slice<T[]>` (`slice`) — the two
// ambient behaviors of the compiler section below that make `xs[0]` and `xs[0..2]` legal
// (decision 63, amended). Written as a comment for the same reason as
// `string`'s above. `length` is a property the language gives its values: a
// primitive type's body declares it `pub val length: i32;` (decisions 873, 887).
pub type array<T> {
    // intrinsic length (builtin).
    pub val length: i32;

    // ── host-backed primitives ──
    // `Index<i32, T>.at` — the reader `xs[0]` rewrites to.
    // A negative index counts from the end (decision 139): `xs.at(-1)` is
    // the last element, `xs.at(-xs.length)` the first, and past either end
    // is absent.
    #[compiler.external(
        .Erlang("(fun(__L, __I) -> __N = length(__L), __J = case __I < 0 of true -> __I + __N; false -> __I end, case ((__J >= 0) andalso (__J < __N)) of true -> lists:nth(__J + 1, __L); false -> undefined end end)($0, $1)"),
        .JavaScript("at"),
    )]
    pub declare fn at(self: Self<T>, index: i32) -> ?T;

    #[compiler.external(.Erlang("($0 ++ [$1])"), .JavaScript("push"))]
    pub declare fn push(self: Self<T>, item: T) -> void;

    #[compiler.external(.Erlang("lists:last($0)"), .JavaScript("pop"))]
    pub declare fn pop(self: Self<T>) -> ?T;

    // `Slice<T[]>.slice` — `end` is `?i32` so an open-ended `xs[1..]` can pass
    // `null` in the second argument (there is no `Range` type to pass).
    pub fn slice(self: Self<T>, start: i32, end: ?i32 = null) -> Self<T> {
        if (end != null)
            return arraySlice1(self, start, end)
        else
            return arraySlice0(self, start);
    }

    #[compiler.external(
        .Erlang("""iolist_to_binary(lists:join($1, lists:map(fun(__E) -> if is_binary(__E) -> __E; is_integer(__E) -> integer_to_binary(__E); is_list(__E) -> __E; true -> iolist_to_binary(io_lib:format("~p", [__E])) end end, $0)))"""),
        .JavaScript("join"),
    )]
    pub declare fn join(self: Self<T>, sep: string) -> string;

    // `reverse` ANSWERS a reversed array and leaves the receiver alone, on
    // every target. Native `Array.prototype.reverse` reverses in place and
    // answers the same array, so on commonJS alone `val rev = xs.reverse();`
    // also reversed `xs` — every fold that read the receiver again after
    // reversing it answered one thing there and another on erlang and wasm,
    // at exit 0. `toReversed` is the §A4 rename to the engine's own copying
    // reader (ES2023; node 20, which is the floor CI installs), so the answer
    // is the same shape with no prototype patch and no helper.
    #[compiler.external(.Erlang("lists:reverse($0)"), .JavaScript("toReversed"))]
    pub declare fn reverse(self: Self<T>) -> Self<T>;

    #[compiler.external(
        .Erlang("(fun(__L, __X) -> __Find = fun __F(__I, [__H | __T]) -> case (__H =:= __X) of true -> __I; false -> __F(__I + 1, __T) end; __F(_, []) -> -1 end, __Find(0, __L) end)($0, $1)"),
        .JavaScript("indexOf"),
    )]
    pub declare fn indexOf(self: Self<T>, item: T) -> i32;

    // The last index of `item`, `-1` when absent — `indexOf` from the other
    // end, with `indexOf`'s equality on every target. erlang and node answer
    // natively; the other targets search the reversed copy.
    #[compiler.external(
        .Erlang("(fun(__L, __X) -> __Find = fun __F(__I, [__H | __T], __Last) -> __F(__I + 1, __T, case (__H =:= __X) of true -> __I; false -> __Last end); __F(_, [], __Last) -> __Last end, __Find(0, __L, -1) end)($0, $1)"),
        .JavaScript("lastIndexOf"),
        .Wasm(body: arrayLastIndexOfBody),
    )]
    pub declare fn lastIndexOf(self: Self<T>, item: T) -> i32;

    #[compiler.external(.Erlang("lists:foreach($1, $0)"), .JavaScript("forEach"))]
    pub declare fn forEach(self: Self<T>, action: fn(item: T)) -> void;

    #[compiler.external(.Erlang("lists:map($1, $0)"), .JavaScript("map"))]
    pub declare fn map<U>(self: Self<T>, transform: fn(item: T) -> U) -> array<U>;

    #[compiler.external(.Erlang("lists:filter($1, $0)"), .JavaScript("filter"))]
    pub declare fn filter(self: Self<T>, pred: fn(item: T) -> bool) -> Self<T>;

    // `zip` pairs the receiver's items with `other`'s by index, truncating to
    // the shorter array. Template form: erlang uses `lists:zipwith` with a
    // tuple constructor; node uses an inline `.map` with index lookup +
    // truncation. wat deferred — no native zip primitive (logged as a known
    // gap; falls through to the inline allow-list as today).
    #[compiler.external(
        .Erlang("lists:zipwith(fun(__X, __Y) -> {__X, __Y} end, lists:sublist($0, length($1)), lists:sublist($1, length($0)))"),
        .JavaScript("$0.map((__x, __i) => [__x, ($1)[__i]]).slice(0, Math.min($0.length, ($1).length))"),
    )]
    pub declare fn zip<U>(self: Self<T>, other: array<U>) -> array<#(T, U)>;

    // ── producers (associated — no receiver) ──
    // Pure botopink (no host backing): the host `lists:seq`/`duplicate` have the
    // wrong semantics (`seq` is end-inclusive; `duplicate` swaps the args), so
    // these build the result by doubling — the half is built once, then appended
    // to itself — giving identical end-exclusive `[start, stop)` / `times`-copy
    // results on every backend in O(log n) calls and O(n) allocated elements
    // (a `[head, ..tail]` recursion copies the tail per element: O(n) calls,
    // O(n²) elements). Each half is bound to a `val` first so the BEAM backend
    // spills it to a stack slot — an x-register would be clobbered by the
    // recursive call. (No comments inside the bodies: the commonJS if-expr emits
    // as a one-line IIFE, where a `//` would swallow the rest of the block.)
    #[compiler.external(
        .JavaScript("((__a, __b) => Array.from({ length: Math.max(0, __b - __a) }, (_, __i) => __a + __i))($0, $1)"),
        .Erlang(body: arrayRangeBody),
        .Wasm(body: arrayRangeBody),
    )]
    pub declare fn range(start: i32, stop: i32) -> array<i32>;

    #[compiler.external(
        .JavaScript("((__v, __n) => Array.from({ length: Math.max(0, __n) }, () => __v))($0, $1)"),
        .Erlang(body: arrayRepeatBody),
        .Wasm(body: arrayRepeatBody),
    )]
    pub declare fn repeat<E>(value: E, times: i32) -> array<E>;

    // ── derived ops (default implementations over the primitives) ──
    #[compiler.external(.Erlang("($0 =:= [])"), .JavaScript(body: arrayIsEmptyBody), .Wasm(body: arrayIsEmptyBody))]
    pub declare fn isEmpty(self: Self<T>) -> bool;

    #[compiler.external(.Erlang("lists:member($1, $0)"), .JavaScript(body: arrayContainsBody), .Wasm(body: arrayContainsBody))]
    pub declare fn contains(self: Self<T>, x: T) -> bool;

    pub fn first(self: Self<T>) -> ?T {
        return self.at(0);
    }

    pub fn rest(self: Self<T>) -> Self<T> {
        return self.slice(1, self.length);
    }

    pub fn take(self: Self<T>, n: i32) -> Self<T> {
        return self.slice(0, n);
    }

    pub fn drop(self: Self<T>, n: i32) -> Self<T> {
        return self.slice(n, self.length);
    }

    pub fn fold<A>(
        self: Self<T>,
        initial: A,
        f: fn(acc: A, item: T) -> A,
    ) -> A {
        var acc = initial;
        self.forEach({ x ->
            acc = f(acc, x);
        });
        return acc;
    }

    #[compiler.external(.JavaScript("find"), .Erlang(body: arrayFindBody), .Wasm(body: arrayFindBody))]
    pub declare fn find(self: Self<T>, pred: fn(item: T) -> bool) -> ?T;

    pub fn count(self: Self<T>, pred: fn(item: T) -> bool) -> i32 {
        return self.filter(pred).length;
    }

    pub fn all(self: Self<T>, pred: fn(item: T) -> bool) -> bool {
        return self.filter(pred).length == self.length;
    }

    pub fn any(self: Self<T>, pred: fn(item: T) -> bool) -> bool {
        return self.filter(pred).length != 0;
    }

    #[compiler.external(.Erlang("($0 ++ $1)"), .JavaScript("concat"), .Wasm(body: arrayAppendBody))]
    pub declare fn append(self: Self<T>, other: Self<T>) -> Self<T>;

    #[compiler.external(.Erlang("[$1 | $0]"), .JavaScript(body: arrayPrependBody), .Wasm(body: arrayPrependBody))]
    pub declare fn prepend(self: Self<T>, item: T) -> Self<T>;

    // NOTE: nested trailing lambdas don't parse yet (catalogued gap) — the inner
    // copy goes through `append` rather than a nested `forEach`.
    pub fn flatten<E>(self: Self<array<E>>) -> array<E> {
        var out: E[] = [];
        self.forEach({ inner ->
            out = out.append(inner);
        });
        return out;
    }

    #[compiler.external(.JavaScript("flatMap"), .Erlang(body: arrayFlatMapBody), .Wasm(body: arrayFlatMapBody))]
    pub declare fn flatMap<U>(self: Self<T>, transform: fn(item: T) -> U) -> array<U>;

    pub fn toList(self: Self<T>) -> Self<T> {
        return self;
    }

    // ── std-tail F7.array_ext additions ──────────────────────────────────────
    // `some`/`every`/`flat` aliases over the existing `any`/`all`/`flatten`
    // (different camelCase name, identical semantics — chosen to mirror the
    // Node Array prototype). The originals stay so existing callers don't
    // break.
    pub fn some(self: Self<T>, pred: fn(item: T) -> bool) -> bool {
        return self.any(pred);
    }

    pub fn every(self: Self<T>, pred: fn(item: T) -> bool) -> bool {
        return self.all(pred);
    }

    pub fn flat<E>(self: Self<array<E>>) -> array<E> {
        return self.flatten();
    }

    // First index where `pred` holds, or -1 when no element matches. Pure
    // botopink — recurses over indices through a fold that captures the
    // first hit (`-1` is preserved once set).
    pub fn findIndex(self: Self<T>, pred: fn(item: T) -> bool) -> i32 {
        var out = -1;
        var i = 0;
        self.forEach({ x ->
            if (out == -1) if (pred(x)) out = i;
            i = i + 1;
        });
        return out;
    }

    // Build a fresh array of `length` copies of `value` — equivalent to
    // `array.repeat(value, self.length)`, but the receiver-method form
    // matches the JS prototype signature callers expect.
    pub fn fill<E>(self: Self<T>, value: E) -> array<E> {
        return array.repeat(value, self.length);
    }

    // Partition the array into consecutive chunks of `n` elements; the last
    // chunk may be shorter when `self.length` is not divisible by `n`.
    // Negative or zero `n` returns an empty array (no infinite loop).
    pub fn chunked(self: Self<T>, n: i32) -> array<Self<T>> {
        var out: array<Self<T>> = [];
        if (n <= 0) return out;
        val len = self.length;
        for (0..len) { k ->
            if (k % n == 0) out = out.append([self.slice(k, k + n)]);
        }
        return out;
    }

    // Sliding window of length `n` over the array. Returns one window per
    // valid start offset (`self.length - n + 1` windows). Negative or zero
    // `n`, or `n > self.length`, returns an empty array.
    pub fn sliding(self: Self<T>, n: i32) -> array<Self<T>> {
        var out: array<Self<T>> = [];
        if (n <= 0) return out;
        val windows = self.length - n + 1;
        if (windows <= 0) return out;
        for (0..windows) { k ->
            out = out.append([self.slice(k, k + n)]);
        }
        return out;
    }

    // Every duplicate dropped, each value kept at its first occurrence, in
    // order (decision 217): `[1, 2, 1, 3, 2].unique()` is `[1, 2, 3]` on every
    // target. Values compare with `==` (decision 210), so records by value —
    // not `contains`, which answers the host's identity on commonJS.
    pub fn unique(self: Self<T>) -> Self<T> {
        var out: T[] = [];
        self.forEach({ x ->
            if (!out.any({ y -> y == x })) out = out.append([x])
        });
        return out;
    }
}

fn arrayLastIndexOfBody<T>(value: array<T>, item: T) -> i32 {
    val fromEnd = value.reverse().indexOf(item);
    return if (fromEnd == -1) -1 else value.length - 1 - fromEnd;
}

fn arrayRangeBody(start: i32, stop: i32) -> array<i32> {
    return if (stop - start <= 0) [] else if (stop - start == 1) [start] else {
        val count = stop - start;
        val low = array.range(start, start + count / 2);
        val high = array.range(start + count / 2, stop);
        low.append(high);
    };
}

fn arrayRepeatBody<E>(value: E, times: i32) -> array<E> {
    return if (times <= 0) [] else {
        val half = array.repeat(value, times / 2);
        if (times % 2 == 0)
            half.append(half)
        else
            half.append(half).append([value]);
    };
}

fn arrayIsEmptyBody<T>(value: array<T>) -> bool {
    return value.length == 0;
}

fn arrayContainsBody<T>(value: array<T>, x: T) -> bool {
    return value.indexOf(x) != -1;
}

fn arrayFindBody<T>(value: array<T>, pred: fn(item: T) -> bool) -> ?T {
    return value.filter(pred).at(0);
}

fn arrayAppendBody<T>(value: array<T>, other: array<T>) -> array<T> {
    var out = value.slice(0, value.length);
    other.forEach({ y -> out.push(y) });
    return out;
}

fn arrayPrependBody<T>(value: array<T>, item: T) -> array<T> {
    var out = [item];
    value.forEach({ x -> out.push(x) });
    return out;
}

fn arrayFlatMapBody<T, U>(value: array<T>, transform: fn(item: T) -> U) -> array<U> {
    return value.map(transform).flatten();
}

// ── array slice arity dispatch ───────────────────────────────────────────────
// Same shape as the string pair above: commonJS patches `Array.prototype.slice`
// with `default fn slice`, so the Node templates copy the normalised range
// without calling `.slice`. The patch is global — host code (a sidecar, Node
// itself) calls `.slice()` with no start and gets the whole array, as native
// `slice` answers: a missing start is 0.

#[compiler.external(
    .Erlang("lists:nthtail($1, $0)"),
    .JavaScript("""((__xs, __a) => { const __n = __xs.length; if (__a == null) __a = 0; const __b = __a < 0 ? Math.max(__n + __a, 0) : Math.min(__a, __n); return Array.from({ length: __n - __b }, (_, __i) => __xs[__b + __i]); })($0, $1)"""),
)]
declare fn arraySlice0<T>(xs: array<T>, start: i32) -> array<T>;

#[compiler.external(
    .Erlang("lists:sublist($0, ($1) + 1, (($2) - ($1)))"),
    .JavaScript("""((__xs, __a, __e) => { const __n = __xs.length; if (__a == null) __a = 0; const __b = __a < 0 ? Math.max(__n + __a, 0) : Math.min(__a, __n); const __f = __e < 0 ? Math.max(__n + __e, 0) : Math.min(__e, __n); return Array.from({ length: Math.max(__f - __b, 0) }, (_, __i) => __xs[__b + __i]); })($0, $1, $2)"""),
)]
declare fn arraySlice1<T>(xs: array<T>, start: i32, end: ?i32) -> array<T>;

// ── the wasm bodies (front 164 s3) ───────────────────────────────────────────
// The `string` methods that take a botopink body on `--target wasm`
// (decisions 565, 566), each a private `text<Name>OnWasm` over three byte
// leaves of the `.wat` text module. Nothing binds them yet: a method's wasm
// cell stays `std: "text.<name>"` until its `fn:` cell lands (s3 P1-d, after
// s2 P5). They are this file's own: inferred with the prelude, then kept out
// of a program's scope (`comptime.zig` `hidePreludeBodies`); the wasm codegen
// adopts a body from the prelude when a `fn:` cell names it. Each answers
// what std-wasm's `modules/std-wasm/src/text.zig` answers, byte for byte:
// indices count code points (a byte starts one when it is no `10xxxxxx`
// continuation byte), searches compare bytes, `trim` strips space, tab, LF,
// CR, VT and FF only (decision 441), `padStart` / `padEnd` count and cycle
// the pad in bytes.

#[compiler.external(.Wasm(std: "text.byteLength"))]
declare fn stringByteLength(s: string) -> i32;

#[compiler.external(.Wasm(std: "text.byteAt"))]
declare fn stringByteAt(s: string, i: i32) -> i32;

#[compiler.external(.Wasm(std: "text.byteSlice"))]
declare fn stringByteSlice(s: string, a: i32, b: i32) -> string;

fn textIsLead(b: i32) -> bool {
    return b < 128 || b >= 192;
}

fn textIsWhite(b: i32) -> bool {
    return b == 32 || (b >= 9 && b <= 13);
}

fn textIsWordSpace(b: i32) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

// Whether `sub` is the bytes of `s` starting at byte `at`.
fn textMatchAt(s: string, at: i32, sub: string) -> bool {
    val m = stringByteLength(sub);
    if (at < 0 || at + m > stringByteLength(s)) return false;
    var j = 0;
    while (j < m) {
        if (stringByteAt(s, at + j) != stringByteAt(sub, j)) return false;
        j = j + 1;
    }
    return true;
}

// The first byte offset of `sub` in `s` from byte `origin` on, `-1` when
// absent (an empty `sub` is at `origin`).
fn textFindFrom(s: string, sub: string, origin: i32) -> i32 {
    val last = stringByteLength(s) - stringByteLength(sub);
    var i = origin;
    while (i <= last) {
        if (textMatchAt(s, i, sub)) return i;
        i = i + 1;
    }
    return -1;
}

// The code points that start before byte `end`.
fn textCodepointsBefore(s: string, end: i32) -> i32 {
    var k = 0;
    var p = 0;
    while (p < end) {
        if (textIsLead(stringByteAt(s, p))) k = k + 1;
        p = p + 1;
    }
    return k;
}

// The byte offset where code point `index` starts, the byte length when `s`
// has `index` code points or fewer.
fn textCodepointStart(s: string, index: i32) -> i32 {
    val n = stringByteLength(s);
    var k = 0;
    var p = 0;
    while (p < n) {
        if (textIsLead(stringByteAt(s, p))) {
            if (k == index) return p;
            k = k + 1;
        }
        p = p + 1;
    }
    return n;
}

fn textCharsOnWasm(s: string) -> string[] {
    val n = stringByteLength(s);
    var out: string[] = [];
    var p = 0;
    while (p < n) {
        var e = p + 1;
        while (e < n && !textIsLead(stringByteAt(s, e))) {
            e = e + 1;
        }
        out.push(stringByteSlice(s, p, e));
        p = e;
    }
    return out;
}

// Cut at every `sep` (bytes compared); an empty `sep` cuts before every code
// point, and then `""` has no piece.
fn textSplitOnWasm(s: string, sep: string) -> string[] {
    if (stringByteLength(sep) == 0) return textCharsOnWasm(s);
    val m = stringByteLength(sep);
    var out: string[] = [];
    var pos = 0;
    var at = textFindFrom(s, sep, 0);
    while (at >= 0) {
        out.push(stringByteSlice(s, pos, at));
        pos = at + m;
        at = textFindFrom(s, sep, pos);
    }
    out.push(stringByteSlice(s, pos, stringByteLength(s)));
    return out;
}

// Cut at every `\n`, a `\r` right before it dropped with it; the last piece
// keeps a trailing `\r`, and `""` is one empty line.
fn textLinesOnWasm(s: string) -> string[] {
    val n = stringByteLength(s);
    var out: string[] = [];
    var pos = 0;
    var i = 0;
    while (i < n) {
        if (stringByteAt(s, i) == 10) {
            val e = if (i > pos && stringByteAt(s, i - 1) == 13) i - 1 else i;
            out.push(stringByteSlice(s, pos, e));
            pos = i + 1;
        }
        i = i + 1;
    }
    out.push(stringByteSlice(s, pos, n));
    return out;
}

// The maximal runs of bytes that are no space, tab, LF or CR.
fn textWordsOnWasm(s: string) -> string[] {
    val n = stringByteLength(s);
    var out: string[] = [];
    var i = 0;
    while (i < n) {
        if (textIsWordSpace(stringByteAt(s, i))) i = i + 1 else {
            val start = i;
            while (i < n && !textIsWordSpace(stringByteAt(s, i))) {
                i = i + 1;
            }
            out.push(stringByteSlice(s, start, i));
        }
    }
    return out;
}

fn textContainsOnWasm(s: string, sub: string) -> bool {
    return textFindFrom(s, sub, 0) >= 0;
}

fn textStartsWithOnWasm(s: string, prefix: string) -> bool {
    return textMatchAt(s, 0, prefix);
}

fn textEndsWithOnWasm(s: string, suffix: string) -> bool {
    return textMatchAt(s, stringByteLength(s)
        - stringByteLength(suffix), suffix);
}

// A code point index, `-1` when absent (`0` for an empty `sub`).
fn textIndexOfOnWasm(s: string, sub: string) -> i32 {
    val off = textFindFrom(s, sub, 0);
    if (off < 0) return -1;
    return textCodepointsBefore(s, off);
}

// A code point index, `-1` when absent (the length for an empty `sub`).
fn textLastIndexOfOnWasm(s: string, sub: string) -> i32 {
    var i = stringByteLength(s) - stringByteLength(sub);
    while (i >= 0) {
        if (textMatchAt(s, i, sub)) return textCodepointsBefore(s, i);
        i = i - 1;
    }
    return -1;
}

// A negative `index` counts from the end (decision 139); outside is absent.
fn textAtOnWasm(s: string, index: i32) -> ?string {
    val n = textCodepointsBefore(s, stringByteLength(s));
    val j = if (index < 0) index + n else index;
    if (j < 0 || j >= n) return null;
    return stringByteSlice(s, textCodepointStart(s, j), textCodepointStart(s, j
        + 1));
}

fn textTrimStartOnWasm(s: string) -> string {
    val n = stringByteLength(s);
    var a = 0;
    while (a < n && textIsWhite(stringByteAt(s, a))) {
        a = a + 1;
    }
    return stringByteSlice(s, a, n);
}

fn textTrimEndOnWasm(s: string) -> string {
    var b = stringByteLength(s);
    while (b > 0 && textIsWhite(stringByteAt(s, b - 1))) {
        b = b - 1;
    }
    return stringByteSlice(s, 0, b);
}

fn textTrimOnWasm(s: string) -> string {
    val n = stringByteLength(s);
    var a = 0;
    while (a < n && textIsWhite(stringByteAt(s, a))) {
        a = a + 1;
    }
    var b = n;
    while (b > a && textIsWhite(stringByteAt(s, b - 1))) {
        b = b - 1;
    }
    return stringByteSlice(s, a, b);
}

// A `times` below 1 is the empty string.
fn textRepeatOnWasm(s: string, times: i32) -> string {
    var out = "";
    var piece = s;
    var left = times;
    while (left > 0) {
        if (left % 2 == 1) out = out + piece;
        left = left / 2;
        if (left > 0) piece = piece + piece;
    }
    return out;
}

// `width` is a byte count: the gap is `width` minus the bytes of `s`, filled
// with the bytes of `pad` cycled (a cut may fall inside a code point); `s`
// itself when it is already as long or `pad` is empty.
fn textPadded(s: string, width: i32, pad: string, start: bool) -> string {
    val n = stringByteLength(s);
    val p = stringByteLength(pad);
    if (width <= n || p == 0) return s;
    val gap = width - n;
    val fill = stringByteSlice(textRepeatOnWasm(pad, (gap + p - 1)
        / p), 0, gap);
    return if (start) fill + s else s + fill;
}

fn textPadStartOnWasm(s: string, width: i32, pad: string) -> string {
    return textPadded(s, width, pad, true);
}

fn textPadEndOnWasm(s: string, width: i32, pad: string) -> string {
    return textPadded(s, width, pad, false);
}

// An empty `pattern` matches before every byte and at the end, as
// JavaScript's does over its units: `replace` puts `with` in front,
// `replaceAll` around every byte.
fn textReplaced(s: string, pattern: string, with: string, all: bool) -> string {
    val n = stringByteLength(s);
    val m = stringByteLength(pattern);
    if (m == 0) {
        if (!all) return with + s;
        var spread = with;
        var i = 0;
        while (i < n) {
            spread = spread + stringByteSlice(s, i, i + 1) + with;
            i = i + 1;
        }
        return spread;
    }
    var out = "";
    var pos = 0;
    var at = textFindFrom(s, pattern, 0);
    while (at >= 0) {
        out = out + stringByteSlice(s, pos, at) + with;
        pos = at + m;
        at = if (all) textFindFrom(s, pattern, pos) else -1;
    }
    return out + stringByteSlice(s, pos, n);
}

fn textReplaceOnWasm(s: string, pattern: string, with: string) -> string {
    return textReplaced(s, pattern, with, false);
}

fn textReplaceAllOnWasm(s: string, pattern: string, with: string) -> string {
    return textReplaced(s, pattern, with, true);
}

// ── the compiler's declarations (decisions 575, 606) ─────────────────────────
//
// The prelude's types and behaviors that a compiler rule reads, the builtin
// functions still called `@name(…)`, and the reflection records. They are the
// prelude's — a program names them with no import — but the compiler, not the
// checker, gives them their meaning today: this section is not inferred with
// the one above (`comptime.zig` `registerStdlib`); `registerBuiltinDecls`,
// the ambient behaviors, the backends' prelude and the drift tests read it
// (`comptime/stdlib/prelude.zig` `builtins`), and each type the compiler
// registers itself is held to its declaration here (`comptime/builtins.zig`).
// B-139's rest writes them as the prelude's own declarations, with bodies.

// `print` is `io/terminal.bp`'s, `panic` `failure.bp`'s (decision 606 (2)); the
// compiler reads their cells from those declarations. `println`, `debug` and `todo`
// are gone: `print(…)`, `panic("not implemented")`.

// ── result type ──────────────────────────────────────────────────────────────

// `Result<R, E>`'s methods are resolved by type inference and lowered inline
// by every codegen backend (there is no run-time dispatch table): bodyless,
// because the compiler is the body. The compiler's rows are
// `comptime/builtins.zig` `methods`, held to these declarations by its drift
// test.
pub type Result<R, E> {
    Ok(result: R),
    Error(error: E),

    // Apply `transform` to the Ok payload; an Error is propagated untouched.
    pub declare fn map<R2>(
        self: Self<R, E>,
        transform: fn(value: R) -> R2,
    ) -> Result<R2, E>;

    // Like `map` but `transform` itself returns a Result (no nesting).
    pub declare fn flatMap<R2>(
        self: Self<R, E>,
        transform: fn(value: R) -> Result<R2, E>,
    ) -> Result<R2, E>;

    // The Ok payload, or `fallback` when the receiver is an Error.
    pub declare fn unwrapOr(self: Self<R, E>, fallback: R) -> R;

    // True when the receiver is `Ok`.
    pub declare fn isOk(self: Self<R, E>) -> bool;

    // True when the receiver is `Error`.
    pub declare fn isError(self: Self<R, E>) -> bool;
}

// A `Result` value is constructed by `return`/`throw` inside a body whose
// return carries `Result<R, E>` (decision 118); the runtime shape is `{ ok: V } | { error: E }`
// (JS) / `{ok, V} | {error, E}` (erlang/beam).

// ── option type ──────────────────────────────────────────────────────────────

// The optional type is `?T` — the ONLY spelling. Optional is not a concrete
// named type: `Option<T>` / `Optional<T>` annotations are rejected with a
// pointed diagnostic. One representation: a value, or absent.
//
// `?T` has no methods (decision 330): its whole surface is TypeScript's
// operators, typed and lowered by the compiler (no declaration here):
//
//   a ?? b        `a` unless it is null, then `b`
//   a?.f          a member read through the optional (`a?.f()` a method)
//   a?.[i]        an index through the optional
//   f?.(args)     a call of the function an optional holds
//   a!            the value, or an abort naming the expression and its place
//                 (`value is null — a! at src/main.bp:3:13`)
//
// An operator over a value that is never null is a compile error; `?.`
// flattens (a member answering `?U` read through `?.` is `?U`); `??` beside
// `&&` / `||` takes parentheses. `map`, `flatMap` and `unwrapOr` belong to
// `Result` alone.

// ── the effect wrappers (decisions 118–128) ─────────────────────────────────
//
// The return type IS the annotation (decision 118): a function gains a
// capability by writing one of these wrappers, literally, as its return type,
// and by nothing else. An alias to a wrapper (`type Job<T> = Async<T>`) types
// the function but activates nothing.
//
//   -> Result<T, E>       throw · try            (the one fallible wrapper)
//   -> Async<T>            await
//   -> Component<R>       use · await
//   -> Iter<T>        yield · break v
//   -> AsyncIter<T>          yield · break v · await   AsyncIter ⊃ Async
//
// Only `Result` fails (decision 121). `Async`, `Component`, `Iter` and
// `AsyncIter` never fail; when something can, the failure goes INSIDE the value
// — `Async<Result<T, E>>`, `Iter<Result<T, E>>` — and `throw` / `try`
// are legal wherever a layer of the return is a `Result`.
//
// The chain is on the declarations below, as `extends` clauses (a `behavior`
// carries `extends`, not the `implement` a `type` writes, and `extends` cannot
// carry type arguments), so the full clauses are:
//
//   AsyncIter<T>         extends Async<YieldStep<T>>
//   Iter<T>       — NO clause: it neither awaits nor fails.
//
// The compiler reads this order from `comptime/effect_chain.zig`, which
// restates it and carries tests that read THIS FILE and fail if the two
// drift: the file is not parsed into the type env (the whole `.d.bp` is
// documentation, and `comptime.zig`'s embedded mirrors exist for the same
// reason), so the drift gate is what keeps one declaration.
//
// `return` in an effect body (decision 119) wraps through every layer:
// `return v` with `v: U` in `-> Async<Result<U, E>>` is a Async holding
// `Ok(v)`; a value already of a layer's type passes through. `throw e` in a
// body whose return carries `Result<U, E>` is that layer's `Error(e)`.

// `Async<T>` — a value that has not arrived yet; `await` unwraps it. A
// `Async<T>` never fails; `Async<Result<U, E>>` is the task that fails with
// `E` (decision 432 — on commonJS its Promise rejects with `E` and resolves
// with the bare `U`): `await t` answers the `Result`, and `try await t`
// propagates its error. A function with no await channel consumes a Async
// through its own functions. A task has no methods (decision 523): its value
// is read by `await`, a failure by `try await … catch` or `case` on `await`'s
// `Result`, and every composition — map, bind, recover, map the error — is an
// `async { … }` block (`async { (try await t catch 0) * 2 }`).
pub behavior Async<T> {}

// ── sequences (decisions 122, 123, 125) ──────────────────────────────────────
//
// One step for both sequences: `Yield(value)` emits, `Done` ends. There is no
// error step — an item that can fail is a `Result` — and no completion
// channel: `break v` in a sequence body emits `v` as the last item and ends
// (≡ `yield v; break;`), and a bare `break` outside any loop ends it.
//
// A function returning `Iter` / `AsyncIter` IS an iterator when its body
// yields (`yield` or `break v`, in its own scope); without one it is an
// ordinary function returning a ready iterator (a factory, decision 123). A
// loop prefixed `iter` / `stream` is an iterator in the middle of a function
// (decision 125). A type that wants to be iterated exposes an ordinary method
// answering an iterator and the consumer calls it — `for (grid.iter())`;
// there is no iterable behavior.
//
// A `for` over an `Iter<X>` hands over each `X` — a `Result` when `X` is
// one; there is no implicit `try` (decision 122).

pub type YieldStep<T> {
    Yield(value: T),
    Done,
}

// `Iter<T>` — a synchronous sequence; iterated by `for` in any function.
pub behavior Iter<T> {
    fn next(self: Self<T>) -> YieldStep<T>;
}

// `AsyncIter<T>` — an asynchronous sequence: finding the next item may need to
// wait. Iterated by `for await`, which needs an await channel.
pub behavior AsyncIter<T> extends Async {
    fn next(self: Self<T>) -> Async<YieldStep<T>>;
}

// ── display (decision 8 §7, decision 27) ─────────────────────────────────────
//
// `terminal.print` consults a value's own `Display` implementation before it falls back
// to the per-type formatter: a type that says how it reads says it here, once,
// and every backend's §7 formatter reads the same declaration. It is ambient —
// a type writes `implement Display` with no import, exactly as any other
// builtin behavior — because `terminal.print` has to find it without the author having
// asked for it.

pub behavior Display {
    fn display(self: Self) -> string;
}

// ── closeable (decisions 539 (6), 540) ───────────────────────────────────────
//
// Anything with something to give back after use (a file, a socket): closed by
// the writer with `defer` — nothing checks that it is, and the compiler names
// no std type and holds no error tied to one. A plain behavior for generic
// code, ambient as `Display` is: `io.fs`'s `File` writes `implement Closeable`
// and a program takes `c: Closeable` with no import; an `implement Closeable`
// is checked against this declaration as a module's own behavior is
// (`comptime.zig` `isAmbientBehavior`).

pub behavior Closeable {
    fn close(self: Self) -> void;
}

// ── index / slice (decision 63, amended) ─────────────────────────────────────
//
// An index expression has NO typing rule of its own: `xs[0]` IS `xs.at(0)`,
// `d["k"]` IS `d.at("k")`, `xs[0..2]` IS `xs.slice(0, 2)` and `xs[1..]` IS
// `xs.slice(1, null)`. The type of the expression is whatever the method
// answers, so indexing stops being a privilege of the three built-in
// collections: a library's own `Matrix`, `Row` or `Buffer` becomes indexable by
// answering `at` / `slice`, with no compiler change.
//
// Both are ambient — a type says it indexes with no import, exactly as it says
// how it reads with `Display` above — because the syntax has to find the method
// without the author having asked for it. A program names them as a type too
// (`fn f(m: Index<string, i32>)`), and an `implement` of one is checked against
// the declaration below (`comptime.zig` `isAmbientBehavior`).
//
// `slice` takes two arguments rather than one range because there is no `Range`
// type in the language: `start..end` is an AST node, not a value, so an open end
// travels as `null` in the second argument.
//
// A TUPLE is deliberately not covered. `t[0]` needs a *constant* index and
// answers a type *per position*, which `at(key: K) -> ?V` cannot express with a
// single `V`; the tuple stays a checker special case.
//
// `libs/std` answers both: `Dict<K, V>` carries `Index<K, V>` on its
// declaration; `array<T>` (`Index<i32, T>`, `Slice<T[]>`) and `string`
// (`Index<i32, string>`, `Slice<string>`) answer them from the primitive
// types in `primitives.bp`, whose `implement` clause names the contract their
// methods are found through — the conformance is named in a comment there.

pub behavior Index<K, V> {
    fn at(self: Self<K, V>, key: K) -> ?V;
}

pub behavior Slice<V> {
    fn slice(self: Self<V>, start: i32, end: ?i32) -> V;
}

// ── components and hooks — decisions 104, 128, 354, 809, 815, 819 and 826 ─────
//
// A component is three names (decisions 809 (1), 815 (1), 819 (1), 826): the
// function that runs, `Composition<T>`; the behavior a type implements,
// `Composable<T>`; and their union, `Component<T>`, the type every program
// writes and none declares or implements. All three are the prelude's,
// written bare everywhere (826 (1)); `Scope` and `Place` are std's `context`
// module's. The checker reads `Component` nominally and opens it into its two
// members only at an `is` / `case` (810, 826 (4)); `Composition<T>` is its
// function type.
//
// `use` is written in a body marked `component` (decision 553); a component
// is called (`Card()`), which only makes it (decision 791 (1)), and inside a
// component body `use Card()` resolves it with a child cell of the body's
// (791 (3), 812 (1)); `use f()` takes a hook too, so hooks compose — a hook
// and a component are one thing (804 (3)). `throw` / `try` in a `Component`
// body follow decision 121: legal only when `R` is a `Result`.
//
// What a body reads from above it is a context: std's `context` module
// declares `Context<T>` and the hooks `provide(ctx)` and `context(ctx) -> T`
// (`use` only, inside a render tree — never in a decorator body, a template
// body or a `comptime { … }`). std's `context.resolve(c, scope, key)` runs a
// component (809 (6)), and a root runs with `await run(App())` (822, 825).

// The function a component is at run time: it opens its cell under `scope`
// at `key` and answers its value, or the task of a body that awaits.
pub type Composition<T> = fn(scope: Scope, key: Place) -> T | Async<T>;

// What a type implements to be a component: `compose` answers the function
// that runs. Only std's `resolve` calls it (804 (1), 815 (3)).
pub behavior Composable<T> {
    fn compose(self: Self<T>) -> Composition<T>;
}

// A component: a `Composition` or a `Composable`. A type is used as `Result`
// and `Async` are; nothing implements it (809 (1)).
pub type Component<T> = Composition<T> | Composable<T>;

// ── annotation marker ────────────────────────────────────────────────────────
//
// Any `type` whose `implement` clause lists `Annotation` may
// be used as a builtin-style annotation: `#[MyMarker(field: value, …)]` on a
// declaration is checked as a constructor call to the type — the same arity,
// named-arg, default-value rules that govern any fn parameter list. For an
// enum, each variant is a separate annotation key
// (`#[Shape.Circle(radius: 2)]` uses the `Circle` variant's params).
//
// `checkAnnotation(self, decl: Decl)` runs at comptime over the annotated
// declaration: implementers use it to enforce placement rules (e.g. "this
// marker is valid only on `declare fn`") or to surface diagnostics. The
// default is a no-op so a marker may carry no policy; the type IS the
// annotation, and its codegen-side meaning is what readers (lib/framework
// code) make of it.

pub behavior Annotation {
    default fn checkAnnotation(self: Self, syntax decl: unknown) -> void {}
}

// ── builtin functions (decision 252) ────────────────────────────────────────
//
// Every `@name(…)` the compiler still reads is declared here (`print` and `panic`
// are `io/terminal.bp`'s and `failure.bp`'s, decision 606 (2)): bodyless, because the
// compiler IS the body, and without `#[external(…)]` unless a host
// supplies it. The compiler's own table of what it implements is
// `modules/compiler-core/src/comptime/builtins.zig`; a unit test there parses
// both files and fails, naming the builtin, when a builtin is implemented and
// not declared, declared and not implemented, or declared with another
// signature. A call is checked against the declaration (its arity and its
// argument types — `builtin-arguments` names the declaration), except where a
// builtin's own rule refuses first (`@src`, `compiler.typeInfo`,
// `@comptimeError`).
//
// A builtin marked COMPTIME-ONLY is evaluated while the program is checked or
// while a decorator / template body runs, and never reaches run time.

// `@trap()` stops the program at once, with no message.
pub declare fn trap() -> noreturn;

// `@field(obj, "name")` — the field `name` of `obj`, the name known at
// compile time: typed as that field when `obj` is a known non-generic record,
// otherwise left open. COMPTIME-ONLY name.
pub declare fn field<T, F>(obj: T, comptime name: string) -> F;

// `@src()` — the place it is written, as a `SourceLocation` (decision 73;
// the section below). COMPTIME-ONLY: rewritten into the constructor call.
pub declare fn src() -> SourceLocation;

// `@embed("path")` — the file at `path` as an `Asset` (decision 519; the
// section below). A `Build` builtin: the path is known at build — a literal, a
// constant, a `comptime` parameter's value — and the call is computed where it
// is written; the artifact carries the bytes on every target.
pub declare fn embed(comptime path: string) -> Asset;

// `@module()` — declared, and refused at every call (`builtin-not-lowered`):
// no target lowers a module value.
pub declare fn module() -> module;

// `compiler.typeInfo(T)` — the reflection of the declaration `T` (decisions 216, 248,
// 253): `compiler.typeInfo(City).name` and `compiler.typeInfo(City).meta.<decorator>.<key>`
// are string constants (the only members read today). COMPTIME-ONLY: no
// run-time code. The program's catalogue is the static `@TypeInfo.all` of the
// answer's type (below).
pub declare fn typeInfo<T>(comptime _: anytype) -> TypeInfo<T>;

// `@TypeOf(value)` — the type of `value`, as the expression's type.
// COMPTIME-ONLY.
pub declare fn TypeOf<T>(value: T) -> T;

// `@makeRecord(fields)` — a record type built from field descriptors, its
// type open to inference. COMPTIME-ONLY.
pub declare fn makeRecord<R>(fields: RecordField[]) -> R;

// `@RecordKeys(T)` — the field names of the record type `T`. COMPTIME-ONLY.
pub declare fn RecordKeys(comptime _: anytype) -> string[];

// `@comptimeError(message)` — fails the check with `comptime error:
// <message>` at the call. COMPTIME-ONLY.
pub declare fn comptimeError(comptime message: string) -> noreturn;

// Contribute generated top-level declarations to the program from a decorator
// body. `@emit("pub val userServiceSingleton = …")` parses `source` as botopink
// declarations and splices them into the annotated declaration's module, so a
// decorator can build wiring (singletons, a DI graph, a router table) as
// ordinary code. May be called any number of times; each call appends.
// COMPTIME-ONLY.
pub declare fn emit(source: string) -> void;

// `@compilerError(message)` — a decorator or template body rejects the
// declaration it runs over with `message`. COMPTIME-ONLY.
pub declare fn compilerError(message: string) -> noreturn;

// `@expr(value)` lifts a comptime value as code — the compiler's own: a
// `-> syntax T` template's `return e` is read as it (decision 575 (4)), and a
// written `@expr` is refused. `@code(text)` parses generated source text;
// only inside a template function. COMPTIME-ONLY.
pub declare fn expr<T>(comptime value: T) -> __Expr<T>;

pub declare fn code<T>(text: string) -> __Expr<T>;

// ── target enum ──────────────────────────────────────────────────────────────

pub type Target { Node, Typescript, Erlang, Beam, Wasm }

// ── effect return rules (the checker's side of the wrappers above) ─────────
//
// §1 — auto-wrap. The compiler intercepts `return v;` in a body whose return
// carries `Result<U, E>` and lowers it to `Ok(v)` (a value already a
// `Result` passes through); `throw e;` lowers to `Error(e)` — returned from a
// `Result` / `Async` / `Component` body, and emitted as the last item of an
// `Iter` / `AsyncIter` body (`throw e` ≡ `break Error(e)`). Manual
// `Result.Ok(…)` / `Result.Error(…)` construction as a `return` / `throw`
// operand is rejected (R11/R12) — the variants are built by the sigils.
//
// §1C — `use`. The body of a `-> Component<R>` fn may `use` hooks — each
// one's operand a hook, never a component — and `await` (`Component`
// extends `Async`); `yield` is not legal there.
//
// §1G — default generic parameters. A generic parameter may carry a
// default type (`<T, U = string>`). Defaults must occupy the trailing
// positions of the list — once a parameter declares a default, every
// following parameter must too. `struct Container<T = i32, U>` is
// rejected at parse time (R16 / RG1). Omitted trailing args resolve to
// their declared defaults; missing required args (RG3) and skipped
// middle args (RG4) are rejected.
//
// ── Expr template model (std.syntax) ─────────────────────────────────────────
// Data model for `Expr` templates. Interfaces are pure behaviour contracts, so
// the companion types are top-level declarations (siblings of `Expr<E>`), not
// nested members.

pub type __Span(
    start: i32,
    end: i32,
    line: i32,
)

// Where an expression was written: the declaration position in the origin file.
// `file` is the file relative to the package root, as diagnostics print it
// (`src/main.bp`), never the module path; `line`/`col` point at the template
// literal's opening quote (1-based).
pub type __Source(
    file: string,
    line: i32,
    col: i32,
)

// Everything a second-layer language (a DSL compiler running inside a template
// function) needs about its input in one object: where the template was
// declared, its raw text, and its shape. The origin scope is reached via
// `lookup`/`bindings`.
//
// F1 — this record is `ExprContext`, not `Context`: `Context<T>` is std's
// context object (decision 354). `q.context()` still reads `context`, because
// a method names the receiver's own input rather than a type.
pub type __ExprContext(
    source: __Source,
    text: string,
    multiline: bool,
)

// ── ExprCustom carrier (expr-custom) ─────────────────────────────────────────
// A node of ANY embedded sub-language, in one canonical shape the core and the
// tooling understand WITHOUT knowing the language. A second-layer language (an
// `Expr` template that lexes/parses its own DSL) converts its private AST into
// `CustomNode`s at the boundary; the core never branches on the contents.
// `kind`/`label` are opaque tags the lib picks; `span` indexes the
// `Expr<string>` source text; `ref` optionally ties a node (a queried
// collection, a column, …) to a caller-scope declaration via a `lookup` result.
pub type __CustomNode(
    kind: string, // lib-chosen tag: "select" / "field" / "predicate" / "literal" …
    span: __Span, // offsets into the template's source text
    label: string, // tooling token category: "keyword"/"property"/"string"/"number"/"operator"
    ref: ?__Decl, // optional association to an origin-scope declaration (a handle, decision 576 (5))
    children: __CustomNode[],
)

// ── Source location (`@src()`) ───────────────────────────────────────────────
// The place a `@src()` is written, as a value (1.0.10-beta decision 73). The
// builtin is evaluated at compile time: the checker rewrites `@src()` into the
// ordinary constructor call `SourceLocation(file: "…", line: N, column: C,
// fnName: "…")` with four literals, so every backend lowers it through its
// record-constructor path and nothing runs at run time.
//
//   file    — the source file relative to the root of the package it belongs
//             to, forward slashes, extension included (`src/emilia.bp`,
//             `test/color_test.bp`); `main.bp` in the compiler's own harness.
//   line    — 1-based line of the `@` character.
//   column  — 1-based column of the `@` character (what a diagnostic prints).
//   fnName  — the enclosing fn's name; `Type.method` inside a method; the test
//             name inside `test "…" { }` (`test_<idx>` for an anonymous
//             block); `""` at module level. A lambda does not change it.
//
// `@src()` takes no arguments and no trailing lambda — `@src(x)` is
// `error[src-takes-no-arguments]`. It is a value like any other, so
// `@src().line` reads a field in place. `std/asserts` and the `snap` library
// are written against the caller's `@src()`: a helper never takes its own.
//
// The declaration the checker registers is the one in `comptime.zig`'s
// `decl_reflection_src`; keep the two in sync.
pub type SourceLocation(
    file: string,
    line: i32,
    column: i32,
    fnName: string,
)

// ── Embedded file (`@embed`) ───────────────────────────────────────────────────
// A file of the package read at build (decision 519), as a value. The checker
// rewrites `@embed("assets/logo.png")` into the constructor call
// `Asset(path: "…", bytes: <the bytes>, size: N, hash: "…")`, so every backend
// lowers it through its record path and the artifact carries the bytes — an
// Erlang binary, a JS `Uint8Array`, a wasm data segment; the program never
// reads the file at run time.
//
//   path    — the path as written, relative to the `botopink.json` of the
//             package that wrote it (a path passed through a `comptime`
//             parameter: the caller's package). No absolute path, no `..`.
//   bytes   — the file's bytes (`bytes`, decision 346).
//   size    — the number of bytes (`i64`, decision 538).
//   hash    — the SHA-256 of the bytes, 64 lowercase hex digits.
//
// `open()` — the `File` of std's `io.fs` over the bytes (decision 538), no `Result`:
// the call is rewritten into `fs.openAsset(a)`, so the module imports `io.fs`
// (`embed-open-needs-fs`). No `declare fn` here: `File` is std's type.
//
// `text()` — the bytes as UTF-8 text, computed at build: bytes that are not
// UTF-8 are a located build error (`embed-text-not-utf8`), and an `Asset`
// whose bytes are not known where the call is checked (a parameter, a
// function's answer) is refused (`embed-text-not-at-build`).
//
// The declaration the checker registers is the one in `comptime.zig`'s
// `decl_reflection_src`; keep the two in sync.
pub type Asset(
    path: string,
    bytes: bytes,
    size: i64,
    hash: string,
) {
    pub declare fn text(self: Self) -> string;
}

// ── Decl reflection model (annotation processors) ────────────────────────────
// Read-only reflection of the declaration a decorator is attached to. A decorator
// is an ordinary comptime function whose first parameter is `comptime _: Decl`;
// when `#[d(args)]` is applied, the core serializes the annotated declaration into
// a `Decl` handle and runs the body, exactly like an `Expr` template capture.
// The lib (rakun, …) — never the core — gives the marker meaning: validate
// placement/arguments via `fail`/`failAt`, and (later) contribute generated
// wiring. The core only provides the protocol (recognize → reflect → invoke).

// Which kind of top-level declaration the annotation sits on.
pub type __DeclKind {
    Type,
    Behavior,
    Fn,
    Method,
    Field,
    // Decision 356 — a module-level `val`: `name`, `returnType` its declared
    // type as written (`""` when none); `setMeta` is legal, `addMember` /
    // `addType` are refused (a `val` owns no type).
    Val,
    // Decision 302 — a tag a template function hands its annotation
    // (`q.tagDecl(…)`, `q.annotate(…)` on `Expr<E>`): `Element` a native tag
    // (`<div>`), `Component` a component tag (`<Card>`, `decl.component` the
    // component's own `@Decl`). `name` is the tag's name, `decl.attr(n)` a
    // static attribute; the channel is typed meta (`setMeta` / `addMeta`),
    // and `addMember` / `addType` are refused.
    Element,
    Component,
}

// One annotation entry on a reflected declaration (`#[name(args…)]`). `args`
// holds the raw argument lexemes in source order; `decorator` is the
// decorator the name names, resolved where the annotation is written — an
// alias (`#[srv]` after `import {serverOnly as srv}`) and a namespace
// (`#[web.route]`) give the declaration's identity, never the spelling
// (decision 277).
pub type __Decl__Annotation(
    name: string,
    args: string[],
    decorator: Decorator,
)

// Every type name below (`Param.typeName`, `Field.typeName`,
// `Method.returnType`, `Decl.returnType`) is the type as the source spells it:
// `string`, `array<string>`, `string[]`, `?i32`, `fn(i32) -> i32`,
// `#(string, string)`, `Async<Element>` — never a bare head, never empty for a
// written type (a missing return type is `""`).

// One parameter of a reflected method/fn.
pub type __Decl__Param(
    name: string,
    typeName: string,
)

// One field of a reflected record/struct, with its own annotations.
pub type __Decl__Field(
    name: string,
    typeName: string,
    annotations: __Decl__Annotation[],
)

// One method of a reflected record/struct/enum, with its own annotations.
// Question s29-b — a method's decorators run before its owner's, and the
// owner's body reads the typed meta they recorded on the entry: `m.meta(T)`
// (`?T`) / `m.metaAll(T)` (`T[]`), `T` the record written by its declared
// name; the checker answers the call (`infer.zig` `inferMethodMetaRead`).
pub type __Decl__Method(
    name: string,
    params: __Decl__Param[],
    returnType: string,
    annotations: __Decl__Annotation[],
)

// One constructible variant of a reflected enum (decision 848): its payload
// fields as `fields` answers them (empty for a unit variant), its own
// annotations, and the enclosing sections' names joined by `.` (`Color.Warm`),
// `null` at the top level. A section is no entry; its wrapper constructor
// (`Token.Color`) is, with its one field.
pub type __Decl__Variant(
    name: string,
    fields: __Decl__Field[],
    annotations: __Decl__Annotation[],
    section: ?string,
)

// Decision 216 (4) — what `@TypeInfo.all(with: d)` answers: one `Declared`
// per declaration of the program carrying the decorator `d`, by module path
// then declaration order. `meta` is what `d` set on it (`decl.setMeta`);
// `typedMeta` carries every typed meta value of the declaration
// (decision 298), read `d.meta(T)` / `d.metaAll(T)` — in the program, not in a
// decorator's or a template's body (`typeinfo-meta-at-build`);
// `value` is the function itself, or for a type a thunk calling the
// associated fn the query names (`@TypeInfo.all(with: d, member: "m")`),
// typed `unknown` (decision 254), or the `val` itself for a `val` (decision
// 356). `returnTypeName` is a function's declared return type as the source
// spells it (`"Clock"`), a `val`'s declared type (`""` when none), `""` for a
// type (decision 256). The compiler's mirror is `comptime.zig`
// `decl_reflection_src`.
pub type DeclaredMeta(
    key: string,
    value: string,
)

// Decision 298 — one typed meta value an entry carries: `key` the record
// type's identity, `value` a thunk building it. Read through `d.meta(T)` /
// `d.metaAll(T)`, which the checker answers (`infer.zig`
// `inferDeclaredMetaRead`); never written by a program.
pub type DeclaredTypedMeta(
    key: string,
    value: unknown,
)

pub type Declared<T>(
    name: string,
    module: string,
    meta: DeclaredMeta[],
    returnTypeName: string,
    value: T,
    typedMeta: DeclaredTypedMeta[],
)

// ── Hooks (decision 277) ────────────────────────────────────────────────────
// What `decl.hooks` lists. A `HookNode` holds only what is written in one
// function (`function`): each `use h(…)` (`HookUse`) and each edge to a
// `Component` (`HookCall`), both in body order — a call of a `Component`
// function (the calls a template builds from tags included) and, decision
// 389, such a function named as a value (`itens.map(Card)`, a `val`, a record
// field, any call's argument: a component value is rendered wherever its
// lambda lands, 388). A component value the checker cannot follow — a
// function value called, a method, what generic code answers — is a
// `HookCall` with `callee: null`; its reader decides on the safe side. `at` is `"<module>:<line>:<column>"` (the
// entry module is `main`). A cycle is an edge back to a listed node; a host
// function and std's `provide` / `context` get no node. In a decorator body a
// `Declared`'s `value` is `null` — no function of the program runs while it
// compiles — and its `meta` is every entry the declaration's decorators set,
// keyed `<decorator>.<key>`.
//
// `HookNode.async` (decision 375) is `true` when the function's body writes
// `await` or `async { … }`, `use`s an asynchronous hook or calls an
// asynchronous component (a written `await` or not), calls a host function
// answering `Async` (or `Component`, which extends it), or calls what the
// checker cannot follow — a function value or a method answering
// `Component<R>`, a `use` with `hook: null`; a cycle is asynchronous when any
// node in it is. On commonJS a synchronous component's lambda (388) is a
// plain arrow that awaits nothing, and a call of one is not awaited.
//
// `HookUse.hook` is the hook's declaration, `null` for a `use` over a function
// value; `annotations` are the hook's own; `typeArgs` the `use`'s explicit
// type arguments (`use params<BlogParams>()` → `[BlogParams]`, a record's
// fields as the checker spells them); `context` the context value a
// `use context(ctx)` names, or the declaration of the default of the type a
// `use provide(…)` gives (decisions 354 (4), 723), `null` for any other hook.
pub type HookUse(
    hook: ?Declared<unknown>,
    annotations: __Decl__Annotation[],
    at: string,
    typeArgs: TypeInfo<unknown>[],
    context: ?Declared<unknown>,
)

pub type HookCall(
    callee: ?Declared<unknown>,
    at: string,
)

// `HookNode.stage` (decision 376) is when the function can run: `Build` when
// it reads what exists only while the program compiles (a `comptime`
// `@Decl` / `@Expr<T>` parameter) or calls a `Build` function; `Run` when it calls a host function std or its
// library does not declare `#[compiler.stage(.Any)]`, or a `Run` function; `Any`
// otherwise. A `comptime` in the body is computed at build and gives none.
pub type Stage { Build, Run, Any }

pub type __HookNode(
    function: Declared<unknown>,
    uses: HookUse[],
    calls: HookCall[],
    async: bool,
    stage: Stage,
)

// ── Decorator (decision 268) ────────────────────────────────────────────────
// The type of a decorator's NAME. A name has type `Decorator` when it names a
// function whose first parameter is `comptime _: @Decl` (a decorator with
// further arguments included) and which has a body; nothing else is
// assignable to it — no literal, no ordinary function, no value of another
// type — and it cannot be constructed or written as a value. A `Decorator[]`
// is an array literal of such names. The checker gives a name the type where
// a `Decorator` is expected (`infer.zig` `decoratorArgumentType`).
//
// Decision 371 — `a.decorator.same(serverOnly)` compares two decorators by
// their declaration, never by the name written: an alias (`#[srv]` after
// `import {serverOnly as srv}`) and a namespace (`markers.serverOnly`) are
// resolved where each is written, and a same-named decorator of another
// module or package is another declaration (`false`). `is` stays a keyword;
// `==` on two `Decorator`s has no meaning.
pub behavior Decorator {
    fn same(self: Self, other: Decorator) -> bool;
}

// ── TypeInfo (decisions 216, 248, 253, 254, 268) ─────────────────────────────
// What `compiler.typeInfo(T)` answers. Its members are read at compile time:
// `name` and `meta.<decorator>.<key>` today, as string constants
// (`typeinfo-unknown-member` refuses the others until they are answered).
// Decision 298 — `compiler.typeInfo(X).meta(T)` (`?T`) and `.metaAll(T)` (`T[]`)
// answer the typed meta values the declaration's decorators recorded of the
// record type `T` (`decl.setMeta(v)` / `decl.addMeta(v)`), written back as
// their constructors in the read's place: `meta(T)` over several values is
// `typeinfo-meta-several`; a value with `@Expr<T>` fields is read in the
// annotation's module (`typeinfo-meta-expr-elsewhere`, question `130-s8-b`).
// `all` is the program's catalogue, a STATIC method called as
// `@TypeInfo.all(with: d)` or `@TypeInfo.all(with: [a, b], member: "m")`:
// every declaration carrying one of the listed decorators, always as
// `Declared<unknown>[]` (decision 254), whatever the program declares — a use
// narrows `value` with `is`. `with:` is held to its type like any argument
// (decision 252): anything but a decorator's name, or an array of them, is
// the ordinary mismatch at the argument. The catalogue's own rule keeps the
// arguments' shape (`typeinfo-all-arguments`: labelled, `member:` a string
// literal, no spread, no decorator listed twice).
// COMPTIME-ONLY: the answer is built while the program is checked.
// The compiler's mirror is `comptime.zig` `type_info_src`.
pub type TypeInfo<T>(
    name: string,
    module: string,
    fields: __Decl__Field[],
    methods: __Decl__Method[],
    meta: DeclaredMeta[],
) {
    pub declare fn all(
        with: Decorator | Decorator[],
        member: ?string = null,
    ) -> Declared<unknown>[];
}

// One field descriptor `@makeRecord` builds a record type from.
pub type RecordField(
    name: string,
    typeName: string,
)

// The float widths. `toString`: `float_to_binary/1` prints scientific notation
// (`1.50000000000000000000e+00`); `short` is the shortest text that reads back
// as the same float (`1.5`). On wasm, std-wasm's text (decisions 440, 441): the
// erlang target's, and the one a wasm program writes for a float anywhere —
// `terminal.print`, `"${x}"`. commonJS writes the same text through its
// `__bp_f64` helper (a float receiver's `toString()` is lowered there, not by
// this binding). `abs` is patched on `Number.prototype` as the integers' is:
// the same form. OTP has no `math:round/1`; `floor(x + 0.5)` is `Math.round`
// (ties round up) and keeps the float type `Self` promises.
pub type f32 implement Float {
    #[compiler.external(
        .Erlang("erlang:min($0, $1)"),
        .JavaScript("""((__a, __b) => (__a !== __a || __b !== __b) ? NaN : (__b < __a || (__b === __a && Object.is(__b, -0))) ? __b : __a)($0, $1)"""),
    )]
    pub declare fn min(self: Self, other: Self) -> Self;

    #[compiler.external(
        .Erlang("erlang:max($0, $1)"),
        .JavaScript("""((__a, __b) => (__a !== __a || __b !== __b) ? NaN : (__b > __a || (__b === __a && Object.is(__a, -0))) ? __b : __a)($0, $1)"""),
    )]
    pub declare fn max(self: Self, other: Self) -> Self;

    #[compiler.external(
        .Erlang("float_to_binary($0, [short])"),
        .JavaScript("toString"),
        .Wasm(std: "number.floatToString"),
    )]
    pub declare fn toString(self: Self) -> string;

    #[compiler.external(
        .Erlang("erlang:abs($0)"),
        .JavaScript("""((__a) => (__a < 0 || Object.is(__a, -0)) ? -__a : __a)($0)"""),
    )]
    pub declare fn abs(self: Self) -> Self;


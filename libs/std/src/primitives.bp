    pub declare fn toUpper(self: Self) -> string;

    #[compiler.external(.Erlang("string:lowercase($0)"), .JavaScript("toLowerCase"), .Wasm(std: "text.toLower"))]
    pub declare fn toLower(self: Self) -> string;

    #[compiler.external(
        .Erlang("(string:find($0, $1) =/= nomatch)"),
        .JavaScript("includes"),
        .Wasm(std: "text.contains"),
    )]
    pub declare fn contains(self: Self, sub: string) -> bool;

    #[compiler.external(
        .Erlang("(string:prefix($0, $1) =/= nomatch)"),
        .JavaScript("startsWith"),
        .Wasm(std: "text.startsWith"),
    )]
    pub declare fn startsWith(self: Self, prefix: string) -> bool;

    // OTP has no `string:suffix/2`: the last `byte_size(suffix)` bytes are
    // compared with the suffix.
    #[compiler.external(
        .Erlang("""(fun(__S, __X) -> __N = byte_size(__S), __M = byte_size(__X), (__M =< __N) andalso (binary:part(__S, __N - __M, __M) =:= __X) end)($0, $1)"""),
        .JavaScript("endsWith"),
        .Wasm(std: "text.endsWith"),
    )]
    pub declare fn endsWith(self: Self, suffix: string) -> bool;

    // std-wasm's set on every target (441, 521): space, tab, LF, CR, VT, FF —
    // a no-break space stays; commonJS trims through its helper, not this one.
    #[compiler.external(.Erlang("string:trim($0)"), .JavaScript("trim"), .Wasm(std: "text.trim"))]
    pub declare fn trim(self: Self) -> string;

    // `string:trim/1` strips both ends; `/2` takes the direction.
    #[compiler.external(
        .Erlang("string:trim($0, leading)"),
        .JavaScript("trimStart"),
        .Wasm(std: "text.trimStart"),

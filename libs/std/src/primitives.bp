// The botopink bodies of the widths' `isEven` / `isOdd` (`body:`, decision 610).
fn i32IsEvenBody(value: i32) -> bool {
    return value % 2 == 0;
}

fn i32IsOddBody(value: i32) -> bool {
    return value % 2 != 0;
}

fn i64IsEvenBody(value: i64) -> bool {
    return value % 2 == 0;
}

fn i64IsOddBody(value: i64) -> bool {
    return value % 2 != 0;
}

fn u32IsEvenBody(value: u32) -> bool {
    return value % 2 == 0;
}

fn u32IsOddBody(value: u32) -> bool {
    return value % 2 != 0;
}

fn u64IsEvenBody(value: u64) -> bool {
    return value % 2 == 0;
}

fn u64IsOddBody(value: u64) -> bool {
    return value % 2 != 0;
}

// ── bigint (decision 332) ─────────────────────────────────────────────────────
// An integer of any size, its literal suffixed `n` (`123…890n`): `+ - * / %`,
// unary `-`, `+=`, the comparisons and `==` over two `bigint`s, never an
// overflow; `/` truncates toward zero, `%` takes the dividend's sign, `/` or
// `%` by zero aborts. erlang and beam hold the VM's own integer, commonJS a
// `BigInt` (always a `BigInt`, never 319's hybrid), wasm its runtime library.
// Not a width of the tower above: a `bigint` mixes with no other integer type,
// and crossing is written — `bigint.of(n)` / `bigint.parse(text)` in, `toI64()`
// / `toF64()` out. The two associated functions are host primitives of
// decision 262's form (`string.fromCodepoint`'s), written through the type's
// own name. commonJS patches the methods on `BigInt.prototype`, which the
// tower patches too (an `i64` past 2^53 is a `BigInt`): each Node form here is
// the tower's own text, so the two patches are one function whichever runs
// last.
pub type bigint {
    // `bigint.of(n)` — the `bigint` equal to `n`.
    #[compiler.external(.Erlang("$0"), .JavaScript("BigInt($0)"))]
    pub declare fn of(n: i64) -> bigint;

    // `bigint.parse(text)` — the integer a decimal numeral spells: an optional
    // `+` or `-`, then the digits `0`–`9` and nothing else, of any length (the
    // numerals `string.parseInt()` reads, with no range); anything else is an
    // `Error` naming the input.
    #[compiler.external(
        .Erlang("""(fun(__S) -> __D = case __S of <<"-", __R/binary>> -> __R; <<"+", __R/binary>> -> __R; _ -> __S end, case (__D =/= <<>>) andalso lists:all(fun(__C) -> (__C >= 48) andalso (__C =< 57) end, binary_to_list(__D)) of true -> {ok, binary_to_integer(__S)}; false -> {error, <<"bigint.parse: ", 34, __S/binary, 34, " is not an integer">>} end end)($0)"""),
        .JavaScript("""((__s) => /^[+-]?[0-9]+$/.test(__s) ? { ok: BigInt(__s) } : { error: 'bigint.parse: "' + __s + '" is not an integer' })($0)"""),
    )]
    pub declare fn parse(text: string) -> Result<bigint, string>;

    #[compiler.external(.Erlang("erlang:integer_to_binary($0)"), .JavaScript("toString"))]
    pub declare fn toString(self: Self) -> string;

    // The `i64` equal to the value; past −2^63 … 2^63 − 1 an abort naming
    // the value (decision 264's text, as `toI64` of the integer widths).
    #[compiler.external(
        .Erlang("""(fun(__V) when __V >= -9223372036854775807 - 1, __V =< 9223372036854775807 -> __V; (__V) -> erlang:error({integer_overflow, <<"toI64: ", (integer_to_binary(__V))/binary, " does not fit i64">>}) end)($0)"""),
        .JavaScript("""((__v) => { if (__v >= -9223372036854775808n && __v <= 9223372036854775807n) { return (__v >= -9007199254740991n && __v <= 9007199254740991n) ? Number(__v) : __v; } throw new Error("integer overflow: toI64: " + __v + " does not fit i64"); })($0)"""),
    )]
    pub declare fn toI64(self: Self) -> i64;

    // The `f64` equal to the value; one between two `f64`s aborts, never
    // rounds (decision 319's conversions).
    #[compiler.external(
        .Erlang("""(fun(__V) -> case abs(__V) =< ((1 bsl 1024) - (1 bsl 971)) of true -> __F = float(__V), case trunc(__F) =:= __V of true -> __F; false -> erlang:error({integer_overflow, <<"toF64: ", (integer_to_binary(__V))/binary, " has no exact f64">>}) end; false -> erlang:error({integer_overflow, <<"toF64: ", (integer_to_binary(__V))/binary, " has no exact f64">>}) end end)($0)"""),
        .JavaScript("""((__v) => { const __f = Number(__v); if (typeof __v !== "bigint" || BigInt(__f) === __v) { return __f; } throw new Error("integer overflow: toF64: " + __v + " has no exact f64"); })($0)"""),
    )]
    pub declare fn toF64(self: Self) -> f64;
}

// ── bytes (decision 346) ──────────────────────────────────────────────────────
// An immutable sequence of bytes: an Erlang binary on erlang and beam, a
// `Uint8Array` on commonJS, on wasm a buffer laid out as a string is (the
// address of its `u32` length, the bytes behind it). No literal is `bytes`,
// and nothing converts between `bytes` and `string` but the two calls below:
// `bytes.fromUtf8(s)` in, `b.toUtf8()` out — an `Error` on bytes that are not
// UTF-8. A binary payload (an upload, a download, an image, a socket read) is
// `bytes` where it enters, and a host cell takes and answers it as the
// target holds it. `bytes` never widens to `unknown` and no `is` tests it:
// erlang holds it and a `string` alike. `==` compares the bytes. commonJS
// patches the methods on `Uint8Array.prototype`; `length` is the native
// property, and `slice`'s Node templates cut with `subarray` (the patch
// replaces native `slice`). Every index counts bytes. The associated function
// is decision 262's form, written through the type's own name.
pub type bytes {
    // `bytes.fromUtf8(s)` — the UTF-8 bytes of `s`.
    #[compiler.external(.Erlang("$0"), .JavaScript("""(new TextEncoder().encode($0))"""))]
    pub declare fn fromUtf8(s: string) -> bytes;

    // The text the bytes spell in UTF-8; anything else (a byte no UTF-8
    // sequence starts with, a sequence cut short, an overlong form, a
    // surrogate, a code point past U+10FFFF) is an `Error`. A byte order mark
    // is kept as U+FEFF.
    #[compiler.external(
        .Erlang("""(fun(__B) -> case unicode:characters_to_binary(__B) of __S when is_binary(__S) -> {ok, __S}; _ -> {error, <<"bytes.toUtf8: not valid UTF-8">>} end end)($0)"""),
        .JavaScript("""((__b) => require('buffer').isUtf8(__b) ? { ok: new TextDecoder("utf-8", { ignoreBOM: true }).decode(__b) } : { error: "bytes.toUtf8: not valid UTF-8" })($0)"""),
    )]
    pub declare fn toUtf8(self: Self) -> Result<string, string>;

    // The number of bytes.
    #[compiler.external(.Erlang("byte_size($0)"), .JavaScript("length"))]
    pub declare fn length(self: Self) -> i32;

    // The bytes of `self`, then those of `other`.
    #[compiler.external(
        .Erlang("<<($0)/binary, ($1)/binary>>"),
        .JavaScript("""((__a, __b) => { const __r = new Uint8Array(__a.length + __b.length); __r.set(__a, 0); __r.set(__b, __a.length); return __r; })($0, $1)"""),
    )]
    pub declare fn concat(self: Self, other: bytes) -> bytes;

    // `Slice<bytes>.slice` — `string`'s bounds (decision 139): a negative
    // index counts from the end, both are clamped to the length, an end
    // before the start is empty, and an absent end is the length — `b[1..]`.
    pub fn slice(self: Self, start: i32, end: ?i32 = null) -> bytes {
        if (end != null)
            return bytesSlice1(self, start, end)
        else
            return bytesSlice0(self, start);
    }
}

// ── boolean ───────────────────────────────────────────────────────────────────

pub type bool {
    #[compiler.external(.Erlang("erlang:atom_to_binary($0)"), .JavaScript("toString"))]
    pub declare fn toString(self: Self) -> string;

    #[compiler.external(.Erlang("(not $0)"), .JavaScript(body: boolNegateBody), .Wasm(body: boolNegateBody))]
    pub declare fn negate(self: Self) -> bool;

    pub fn nor(self: Self, other: bool) -> bool {
        return !(self || other);
    }

    pub fn nand(self: Self, other: bool) -> bool {
        return !(self && other);
    }

    pub fn exclusiveOr(self: Self, other: bool) -> bool {
        return self != other;
    }

    pub fn exclusiveNor(self: Self, other: bool) -> bool {
        return self == other;
    }
}

// The botopink bodies of the members of `bool`, `string` and `array<T>` that
// run on the host on one target and in botopink on the others (`body:`,
// decision 610; 617 (3)).
fn boolNegateBody(value: bool) -> bool {
    return !value;
}

// ── string ────────────────────────────────────────────────────────────────────
// `string` answers `Index<i32, string>` (`at`) and `Slice<string>` (`slice`) —
// the two ambient behaviors of the compiler section below that make `s[1]` and `s[1..3]`
// legal (decision 63, amended). The conformance is written here as a comment
// and not as an `implement` clause: a primitive type's `implement` clause names
// the contract its methods are found through (617 (1)), and `Index` / `Slice`
// are ambient behaviors the checker reads by rule; see `libs/std/AGENTS.md`.
//
// The primitive types are written lowercase and hold their own methods and
// statics (decision 641): `string.fromCodepoint(65)` is `string`'s static, as
// `array.range(0, 3)` is `array`'s and `bytes.fromUtf8(s)` `bytes`'. A member
// is a `declare fn` with its host cells, or a `fn` with its botopink body; a
// member one target runs on the host and another in botopink names a private
// body (`body:`, decision 610).


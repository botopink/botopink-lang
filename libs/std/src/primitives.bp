//// Primitive controller — the central interface registry for botopink's
//// primitive types. Declarations only (no bodies): the type checker consumes
//// the signatures, and `#[@External.<Target>(...)]` tells each codegen
//// backend how to lower the operation (host symbol per target). Pure-logic
//// operations carry no `@External.*` — the compiler synthesises them.
////
//// Naming convention: camelCase (the legacy snake_case surface is normalised
//// here). Method receivers are `self: Self`; free combinators live in the
//// `Function` interface as associated functions.

// ── numeric tower ─────────────────────────────────────────────────────────────
// Capability interfaces shared by every numeric width. `Self` abstracts the
// concrete type, so one signature serves all widths; concrete types inherit via
// `extends` and carry no duplicated members. Declared (host-backed) methods use
// `#[@External.Erlang(…), @External.Node(…)]`; pure-logic ops carry none.

// commonJS holds an `i64` / `u64` past ±(2^53 − 1) as a `BigInt` (decision 319),
// and the emitter patches these methods on `BigInt.prototype` as well as on
// `Number.prototype`. A Node form here therefore takes a `number` or a
// `BigInt` and answers the canonical one. `Math.*` throws a `TypeError` on a
// `BigInt`, so `min` / `max` / `abs` are written out with `<` (exact across
// the two kinds), answering an operand as it came, and keep `Math.*`'s
// answers on numbers: a `NaN` operand is `NaN`, `-0` is below `0`.
behavior Number {
    #[@External.Erlang("erlang", "min")]
    #[@External.Node("""((__a, __b) => (__a !== __a || __b !== __b) ? NaN : (__b < __a || (__b === __a && Object.is(__b, -0))) ? __b : __a)($0, $1)""")]
    fn min(self: Self, other: Self) -> Self;

    #[@External.Erlang("erlang", "max")]
    #[@External.Node("""((__a, __b) => (__a !== __a || __b !== __b) ? NaN : (__b > __a || (__b === __a && Object.is(__a, -0))) ? __b : __a)($0, $1)""")]
    fn max(self: Self, other: Self) -> Self;

    default fn clamp(self: Self, lo: Self, hi: Self) -> Self {
        return self.max(lo).min(hi);
    }
}

behavior Integer extends Number {
    #[@External.Erlang("erlang", "integer_to_binary")]
    #[@External.Node("toString")]
    fn toString(self: Self) -> string;

    #[@External.Node("""((__a) => typeof __a === "bigint" ? __a % 2n === 0n : __a % 2 === 0)($0)""")]
    default fn isEven(self: Self) -> bool {
        return self % 2 == 0;
    }

    #[@External.Node("""((__a) => typeof __a === "bigint" ? __a % 2n !== 0n : __a % 2 !== 0)($0)""")]
    default fn isOdd(self: Self) -> bool {
        return self % 2 != 0;
    }

    // ── conversions (decision 319) ───────────────────────────────────────
    // Explicit and exact: the value when the target type holds it, else an
    // abort naming the value and the type — never a wrap, a saturation or a
    // rounding. One form per target type, whatever the receiver's width. The
    // erlang forms raise as an overflowing operator does
    // (`{integer_overflow, What}`); the Node forms take a `number` or a
    // `BigInt` and answer the canonical form (a `BigInt` only past
    // ±(2^53 − 1)).

    #[@External.Erlang("""(fun(__V) when __V >= -2147483648, __V =< 2147483647 -> __V; (__V) -> erlang:error({integer_overflow, <<"toI32: ", (integer_to_binary(__V))/binary, " does not fit i32">>}) end)($0)""")]
    #[@External.Node("""((__v) => { if (__v >= -2147483648 && __v <= 2147483647) { return Number(__v); } throw new Error("integer overflow: toI32: " + __v + " does not fit i32"); })($0)""")]
    fn toI32(self: Self) -> i32;

    #[@External.Erlang("""(fun(__V) when __V >= -(1 bsl 63), __V < (1 bsl 63) -> __V; (__V) -> erlang:error({integer_overflow, <<"toI64: ", (integer_to_binary(__V))/binary, " does not fit i64">>}) end)($0)""")]
    #[@External.Node("""((__v) => { if (__v >= -9223372036854775808n && __v <= 9223372036854775807n) { return (__v >= -9007199254740991n && __v <= 9007199254740991n) ? Number(__v) : __v; } throw new Error("integer overflow: toI64: " + __v + " does not fit i64"); })($0)""")]
    fn toI64(self: Self) -> i64;

    #[@External.Erlang("""(fun(__V) when __V >= 0, __V =< 4294967295 -> __V; (__V) -> erlang:error({integer_overflow, <<"toU32: ", (integer_to_binary(__V))/binary, " does not fit u32">>}) end)($0)""")]
    #[@External.Node("""((__v) => { if (__v >= 0 && __v <= 4294967295) { return Number(__v); } throw new Error("integer overflow: toU32: " + __v + " does not fit u32"); })($0)""")]
    fn toU32(self: Self) -> u32;

    #[@External.Erlang("""(fun(__V) when __V >= 0, __V < (1 bsl 64) -> __V; (__V) -> erlang:error({integer_overflow, <<"toU64: ", (integer_to_binary(__V))/binary, " does not fit u64">>}) end)($0)""")]
    #[@External.Node("""((__v) => { if (__v >= 0 && __v <= 18446744073709551615n) { return __v; } throw new Error("integer overflow: toU64: " + __v + " does not fit u64"); })($0)""")]
    fn toU64(self: Self) -> u64;

    // The `f64` equal to the integer; an integer between two `f64`s (past
    // 2^53 an `f64` counts by two, then by four, …) aborts.
    #[@External.Erlang("""(fun(__V) -> __F = float(__V), case trunc(__F) =:= __V of true -> __F; false -> erlang:error({integer_overflow, <<"toF64: ", (integer_to_binary(__V))/binary, " has no exact f64">>}) end end)($0)""")]
    #[@External.Node("""((__v) => { const __f = Number(__v); if (typeof __v !== "bigint" || BigInt(__f) === __v) { return __f; } throw new Error("integer overflow: toF64: " + __v + " has no exact f64"); })($0)""")]
    fn toF64(self: Self) -> f64;
}

behavior Signed extends Integer {
    #[@External.Erlang("erlang", "abs")]
    #[@External.Node("""((__a) => (__a < 0 || Object.is(__a, -0)) ? -__a : __a)($0)""")]
    fn abs(self: Self) -> Self;
}

behavior Float extends Number {
    // `float_to_binary/1` prints scientific notation (`1.50000000000000000000e+00`);
    // `short` is the shortest text that reads back as the same float (`1.5`).
    #[@External.Erlang("float_to_binary($0, [short])")]
    #[@External.Node("toString")]
    fn toString(self: Self) -> string;

    // Patched on `Number.prototype` as `Signed`'s `abs` is: the same form.
    #[@External.Erlang("erlang", "abs")]
    #[@External.Node("""((__a) => (__a < 0 || Object.is(__a, -0)) ? -__a : __a)($0)""")]
    fn abs(self: Self) -> Self;

    #[@External.Erlang("math", "floor")]
    #[@External.Node("Math", "floor")]
    fn floor(self: Self) -> Self;

    #[@External.Erlang("math", "ceil")]
    #[@External.Node("Math", "ceil")]
    fn ceil(self: Self) -> Self;

    // OTP has no `math:round/1`; `floor(x + 0.5)` is `Math.round` (ties round
    // up) and keeps the float type `Self` promises.
    #[@External.Erlang("math:floor($0 + 0.5)")]
    #[@External.Node("Math", "round")]
    fn round(self: Self) -> Self;

    #[@External.Erlang("math", "sqrt")]
    #[@External.Node("Math", "sqrt")]
    fn squareRoot(self: Self) -> Self;
}

// Concrete primitive widths — thin markers binding each type to its capabilities.
behavior I32 extends Signed {}

behavior I64 extends Signed {}

behavior U32 extends Integer {}

behavior U64 extends Integer {}

behavior F32 extends Float {}

behavior F64 extends Float {}

// ── bigint (decision 332) ─────────────────────────────────────────────────────
// An integer of any size, its literal suffixed `n` (`123…890n`): `+ - * / %`,
// unary `-`, `+=`, the comparisons and `==` over two `bigint`s, never an
// overflow; `/` truncates toward zero, `%` takes the dividend's sign, `/` or
// `%` by zero aborts. erlang and beam hold the VM's own integer, commonJS a
// `BigInt` (always a `BigInt`, never 319's hybrid), wasm its runtime library.
// Not a width of the tower above: a `bigint` mixes with no other integer type,
// and crossing is written — `bigint.of(n)` / `bigint.parse(text)` in, `toI64()`
// / `toF64()` out. The two associated functions are host primitives of
// decision 262's form (`String.fromCodepoint`'s), written through the type's
// own name. commonJS patches the methods on `BigInt.prototype`, which the
// tower patches too (an `i64` past 2^53 is a `BigInt`): each Node form here is
// the tower's own text, so the two patches are one function whichever runs
// last.
behavior BigInt {
    // `bigint.of(n)` — the `bigint` equal to `n`.
    #[@External.Erlang("$0")]
    #[@External.Node("BigInt($0)")]
    fn of(n: i64) -> bigint;

    // `bigint.parse(text)` — the integer a decimal numeral spells: an optional
    // `+` or `-`, then the digits `0`–`9` and nothing else, of any length (the
    // numerals `string.parseInt()` reads, with no range); anything else is an
    // `Error` naming the input.
    #[@External.Erlang("""(fun(__S) -> __D = case __S of <<"-", __R/binary>> -> __R; <<"+", __R/binary>> -> __R; _ -> __S end, case (__D =/= <<>>) andalso lists:all(fun(__C) -> (__C >= 48) andalso (__C =< 57) end, binary_to_list(__D)) of true -> {ok, binary_to_integer(__S)}; false -> {error, <<"bigint.parse: ", 34, __S/binary, 34, " is not an integer">>} end end)($0)""")]
    #[@External.Node("""((__s) => /^[+-]?[0-9]+$/.test(__s) ? { ok: BigInt(__s) } : { error: 'bigint.parse: "' + __s + '" is not an integer' })($0)""")]
    fn parse(text: string) -> @Result<bigint, string>;

    #[@External.Erlang("erlang", "integer_to_binary")]
    #[@External.Node("toString")]
    fn toString(self: Self) -> string;

    // The `i64` equal to the value; past −2^63 … 2^63 − 1 an abort naming
    // the value (decision 264's text, as `Integer.toI64`).
    #[@External.Erlang("""(fun(__V) when __V >= -(1 bsl 63), __V < (1 bsl 63) -> __V; (__V) -> erlang:error({integer_overflow, <<"toI64: ", (integer_to_binary(__V))/binary, " does not fit i64">>}) end)($0)""")]
    #[@External.Node("""((__v) => { if (__v >= -9223372036854775808n && __v <= 9223372036854775807n) { return (__v >= -9007199254740991n && __v <= 9007199254740991n) ? Number(__v) : __v; } throw new Error("integer overflow: toI64: " + __v + " does not fit i64"); })($0)""")]
    fn toI64(self: Self) -> i64;

    // The `f64` equal to the value; one between two `f64`s aborts, never
    // rounds (decision 319's conversions).
    #[@External.Erlang("""(fun(__V) -> __F = try float(__V) catch error:badarg -> erlang:error({integer_overflow, <<"toF64: ", (integer_to_binary(__V))/binary, " has no exact f64">>}) end, case trunc(__F) =:= __V of true -> __F; false -> erlang:error({integer_overflow, <<"toF64: ", (integer_to_binary(__V))/binary, " has no exact f64">>}) end end)($0)""")]
    #[@External.Node("""((__v) => { const __f = Number(__v); if (typeof __v !== "bigint" || BigInt(__f) === __v) { return __f; } throw new Error("integer overflow: toF64: " + __v + " has no exact f64"); })($0)""")]
    fn toF64(self: Self) -> f64;
}

// ── boolean ───────────────────────────────────────────────────────────────────

behavior Bool {
    #[@External.Erlang("erlang", "atom_to_binary")]
    #[@External.Node("toString")]
    fn toString(self: Self) -> string;

    #[@External.Erlang("(not $0)")]
    default fn negate(self: Self) -> bool {
        return !self;
    }

    default fn nor(self: Self, other: bool) -> bool {
        return !(self || other);
    }

    default fn nand(self: Self, other: bool) -> bool {
        return !(self && other);
    }

    default fn exclusiveOr(self: Self, other: bool) -> bool {
        return self != other;
    }

    default fn exclusiveNor(self: Self, other: bool) -> bool {
        return self == other;
    }
}

// ── string ────────────────────────────────────────────────────────────────────
// `string` answers `Index<i32, string>` (`at`) and `Slice<string>` (`slice`) —
// the two ambient behaviors of `builtins.d.bp` that make `s[1]` and `s[1..3]`
// legal (decision 63, amended). The conformance is written here as a comment
// and not as an `implement` clause because a `behavior` declaration carries no
// `implement` clause in the grammar; see `libs/std/AGENTS.md`.

behavior String {
    // Codepoints on every target (decision 320): erlang's `string:length/1`
    // counts grapheme clusters (`"e\u{301}"` is one there), so the erlang
    // form counts the binary's decoded codepoints.
    #[@External.Erlang("erlang:length(unicode:characters_to_list($0))")]
    #[@External.Node("length")]
    fn length(self: Self) -> i32;

    // `string:split/3` answers the whole string for an empty separator, while
    // JS `split("")` answers one element per character. The erlang form
    // matches the empty separator first and cuts the binary into UTF-8
    // codepoints (`"".split("")` answers `[]`, as on JS).
    #[@External.Erlang("""(fun(__S, <<>>) -> [<<__C/utf8>> || <<__C/utf8>> <= __S]; (__S, __X) -> string:split(__S, __X, all) end)($0, $1)""")]
    #[@External.Node("split")]
    fn split(self: Self, sep: string) -> string[];

    #[@External.Erlang("string", "uppercase")]
    #[@External.Beam("""    {call_ext, 1, {extfunc, string, uppercase, 1}}.""")]
    #[@External.Node("toUpperCase")]
    fn toUpper(self: Self) -> string;

    #[@External.Erlang("string", "lowercase")]
    #[@External.Beam("""    {call_ext, 1, {extfunc, string, lowercase, 1}}.""")]
    #[@External.Node("toLowerCase")]
    fn toLower(self: Self) -> string;

    #[@External.Erlang("(string:find($0, $1) =/= nomatch)")]
    #[@External.Node("includes")]
    fn contains(self: Self, sub: string) -> bool;

    #[@External.Erlang("(string:prefix($0, $1) =/= nomatch)")]
    #[@External.Node("startsWith")]
    fn startsWith(self: Self, prefix: string) -> bool;

    // OTP has no `string:suffix/2`. Both erlang forms compare the last
    // `byte_size(suffix)` bytes with the suffix. The BEAM body cannot branch, so
    // it clamps the start offset to 0 arithmetically (`(D + abs(D)) div 2`);
    // when the suffix is longer than the string the part is the whole string,
    // whose size differs, so the comparison is false.
    #[@External.Erlang("""(fun(__S, __X) -> __N = byte_size(__S), __M = byte_size(__X), (__M =< __N) andalso (binary:part(__S, __N - __M, __M) =:= __X) end)($0, $1)""")]
    #[@External.Beam("""    {gc_bif, byte_size, {f, 0}, 2, [$0], {x, 2}}.
    {gc_bif, byte_size, {f, 0}, 3, [$1], {x, 3}}.
    {gc_bif, '-', {f, 0}, 4, [{x, 2}, {x, 3}], {x, 3}}.
    {gc_bif, abs, {f, 0}, 4, [{x, 3}], {x, 4}}.
    {gc_bif, '+', {f, 0}, 5, [{x, 3}, {x, 4}], {x, 3}}.
    {gc_bif, 'div', {f, 0}, 4, [{x, 3}, {integer, 2}], {x, 3}}.
    {gc_bif, '-', {f, 0}, 4, [{x, 2}, {x, 3}], {x, 2}}.
    {gc_bif, binary_part, {f, 0}, 4, [$0, {x, 3}, {x, 2}], {x, 0}}.
    {bif, '=:=', {f, 0}, [{x, 0}, $1], {x, 0}}.""")]
    #[@External.Node("endsWith")]
    fn endsWith(self: Self, suffix: string) -> bool;

    #[@External.Erlang("string", "trim")]
    #[@External.Beam("""    {call_ext, 1, {extfunc, string, trim, 1}}.""")]
    #[@External.Node("trim")]
    fn trim(self: Self) -> string;

    // `string:trim/1` strips both ends; `/2` takes the direction.
    #[@External.Erlang("string:trim($0, leading)")]
    #[@External.Node("trimStart")]
    fn trimStart(self: Self) -> string;

    #[@External.Erlang("string:trim($0, trailing)")]
    #[@External.Node("trimEnd")]
    fn trimEnd(self: Self) -> string;

    // Replaces the first occurrence, like JS `replace` with a string pattern.
    // `string:replace/3` returns an iolist, so it is flattened to a binary.
    #[@External.Erlang("iolist_to_binary(string:replace($0, $1, $2))")]
    #[@External.Node("replace")]
    fn replace(self: Self, pattern: string, with: string) -> string;

    // `Slice<string>.slice` — `end` is `?i32` so an open-ended `s[1..]` can
    // pass `null` in the second argument (there is no `Range` type to pass).
    default fn slice(self: Self, start: i32, end: ?i32 = null) -> string {
        if (end != null)
            return stringSlice1(self, start, end)
        else
            return stringSlice0(self, start);
    }

    // `Index<i32, string>.at` — the reader `s[1]` rewrites to. It was spelled
    // `charAt` until decision 63's amendment gave the index expression one
    // method name across every indexable type; the JS template still names
    // native `charAt`, which is the host symbol, not the language's.
    //
    // `string:slice/2` returns the rest of the string, not one character.
    // Node's native `charAt` returns `""` out of range where the signature
    // says `?string`; a helper that returns `null` needs the commonJS helper
    // mechanism (F8 js-bridges) — a template here would patch the global
    // `String.prototype.charAt`.
    // A negative index counts from the end (decision 139): `-1` is the last
    // character, and past either end is absent.
    //
    // The index counts codepoints (decision 320), so the erlang form reads the
    // decoded codepoint list, never `string:slice/3`'s grapheme clusters.
    #[@External.Erlang("""(fun(__S, __I) -> __L = unicode:characters_to_list(__S), __N = erlang:length(__L), __J = case __I < 0 of true -> __I + __N; false -> __I end, case (__J >= 0) andalso (__J < __N) of true -> unicode:characters_to_binary([lists:nth(__J + 1, __L)]); false -> undefined end end)($0, $1)""")]
    #[@External.Node("charAt")]
    fn at(self: Self, index: i32) -> ?string;

    // `string:str/2` takes charlists and rejects binaries (`function_clause`).
    // `binary:match/2` rejects an empty pattern, which JS finds at 0.
    // The answer is an index in the unit `at`, `slice` and `length` count in
    // on every target (decisions 169, 320) — the codepoints of the text
    // before the match, not the match's byte offset — so `s.at(s.indexOf(x))`
    // reads the character the search found.
    #[@External.Erlang("""(fun(__S, __X) -> case __X of <<>> -> 0; _ -> case binary:match(__S, __X) of nomatch -> -1; {__P, _} -> erlang:length(unicode:characters_to_list(binary:part(__S, 0, __P))) end end end)($0, $1)""")]
    #[@External.Node("indexOf")]
    fn indexOf(self: Self, sub: string) -> i32;

    #[@External.Node("toString")]
    default fn toString(self: Self) -> string {
        return self;
    }

    // `String.fromCodepoint(cp)` — the one-character string of the Unicode
    // scalar value `cp` (decision 262), an associated host primitive (no
    // `self`): each backend renders the template at the call. A `cp` that is
    // no scalar value — negative, a surrogate (U+D800..U+DFFF) or past
    // U+10FFFF — aborts the program on every target: erlang's `/utf8`
    // segment raises `badarg` for all three, the Node cell throws a
    // `RangeError` for all three (native `String.fromCodePoint` answers a lone
    // surrogate), and wasm's `$__str_from_cp` traps.
    #[@External.Erlang("<<($0)/utf8>>")]
    #[@External.Node("""((__c) => { if (!(__c >= 0 && __c <= 1114111) || (__c >= 55296 && __c <= 57343)) throw new RangeError('String.fromCodepoint: ' + __c + ' is not a Unicode scalar value'); return String.fromCodePoint(__c); })($0)""")]
    fn fromCodepoint(cp: i32) -> string;

    // ── std-tail F7.string_ext additions ────────────────────────────────────
    // Each is wired to the Node prototype method on commonJS plus an Erlang
    // shape that mirrors the semantic. `string:pad/3` is BIF on OTP 27+; we
    // gate behind `binary_to_list`/`list_to_binary` to keep the shape simple.

    #[@External.Erlang("(fun(__S, __L, __P) -> __N = max(__L - byte_size(__S), 0), __PadBin = case __P of <<>> -> <<>>; _ -> list_to_binary(lists:duplicate(__N, binary:first(__P))) end, <<__PadBin/binary, __S/binary>> end)($0, $1, $2)")]
    #[@External.Node("padStart")]
    fn padStart(self: Self, length: i32, pad: string) -> string;

    #[@External.Erlang("(fun(__S, __L, __P) -> __N = max(__L - byte_size(__S), 0), __PadBin = case __P of <<>> -> <<>>; _ -> list_to_binary(lists:duplicate(__N, binary:first(__P))) end, <<__S/binary, __PadBin/binary>> end)($0, $1, $2)")]
    #[@External.Node("padEnd")]
    fn padEnd(self: Self, length: i32, pad: string) -> string;

    #[@External.Erlang("binary:copy($0, $1)")]
    #[@External.Node("repeat")]
    fn repeat(self: Self, times: i32) -> string;

    #[@External.Erlang("(fun(__S, __P, __R) -> binary:replace(__S, __P, __R, [global]) end)($0, $1, $2)")]
    #[@External.Node("replaceAll")]
    fn replaceAll(self: Self, pattern: string, with: string) -> string;

    #[@External.Erlang("[<<__C/utf8>> || __C <- unicode:characters_to_list($0, utf8)]")]
    #[@External.Node("(Array.from($0))")]
    fn chars(self: Self) -> string[];

    #[@External.Erlang("""binary:split($0, [<<"\r\n">>, <<"\n">>], [global])""")]
    #[@External.Node("""$0.split(/\r?\n/)""")]
    fn lines(self: Self) -> string[];

    #[@External.Erlang("""[__W || __W <- binary:split($0, [<<" ">>, <<"\t">>, <<"\n">>, <<"\r">>], [global]), __W =/= <<>>]""")]
    #[@External.Node("""$0.split(/[ \t\n\r]+/).filter(__w => __w.length > 0)""")]
    fn words(self: Self) -> string[];

    // `\r\n` -> `\n`: the text as a unix host writes it. A lone `\r` stays.
    #[@External.Erlang("""binary:replace($0, <<"\r\n">>, <<"\n">>, [global])""")]
    #[@External.Node("""$0.replaceAll("\r\n", "\n")""")]
    fn normalizeNewlines(self: Self) -> string;

    // The text without its trailing `\n` characters - only newlines, not
    // spaces or tabs (`trimEnd` takes all whitespace): whitespace inside or
    // before them is kept. `"a\n\n"` is `"a"`, `"a \n"` is `"a "`.
    #[@External.Erlang("""re:replace($0, "\\n+\\z", "", [{return, binary}])""")]
    #[@External.Node("""$0.replace(/\n+$/, "")""")]
    fn trimTrailingNewlines(self: Self) -> string;

    // The 1-based number of the first line (lines split on `\n`) where the
    // two texts differ, `0` when they are equal. A text that is a prefix of
    // the other, in whole lines, differs at the line after its last.
    #[@External.Erlang("""(fun(__A, __B) -> (fun __F([__H | __T1], [__H | __T2], __N) -> __F(__T1, __T2, __N + 1); __F([], [], _) -> 0; __F(_, _, __N) -> __N + 1 end)(binary:split(__A, <<"\n">>, [global]), binary:split(__B, <<"\n">>, [global]), 0) end)($0, $1)""")]
    #[@External.Node("""((__a, __b) => { const __x = __a.split("\n"), __y = __b.split("\n"); let __i = 0; while (__i < __x.length && __i < __y.length && __x[__i] === __y[__i]) __i++; return (__i === __x.length && __i === __y.length) ? 0 : __i + 1 })($0, $1)""")]
    fn firstDifferingLine(self: Self, other: string) -> i32;

    // A template on a behavior method becomes a PROTOTYPE PATCH on commonJS
    // (`String.prototype.charCodeAt = …`), so it must not name the method it
    // patches: `$0.charCodeAt($1)` called the patch it had just installed and
    // every `.charCodeAt(…)` in the program blew the stack, in any module that
    // installed the `String` prelude for some other member (one `s.slice(…)`
    // is enough). Native `codePointAt` is not a member of this behavior, so no
    // patch ever replaces it, and it is what the `?? -1` was written for:
    // out of range it answers `undefined`, where `charCodeAt` answers `NaN`,
    // which `??` does not catch and `| 0` turned into `0`. It also answers the
    // CODE POINT, which is what the erlang form above answers.
    #[@External.Erlang("(fun(__S, __I) -> case unicode:characters_to_list(__S, utf8) of __L when length(__L) > __I, __I >= 0 -> lists:nth(__I + 1, __L); _ -> -1 end end)($0, $1)")]
    #[@External.Node("""((__s, __i) => { if (/[\u{D800}-\u{DFFF}\u{10000}-\u{10FFFF}]/u.test(__s)) { const __c = __i >= 0 ? Array.from(__s)[__i] : undefined; return __c === undefined ? -1 : __c.codePointAt(0); } return (__s.codePointAt(__i) ?? -1) | 0; })($0, $1)""")]
    fn charCodeAt(self: Self, index: i32) -> i32;

    // The last match is found over the bytes and answered in `indexOf`'s unit
    // (decisions 169, 320): the codepoints of the text before it.
    #[@External.Erlang("(fun(__S, __Sub) -> __L = byte_size(__S), __SL = byte_size(__Sub), __Find = fun __F(__I) -> case __I < 0 of true -> -1; false -> case binary:part(__S, __I, min(__SL, __L - __I)) =:= __Sub of true -> erlang:length(unicode:characters_to_list(binary:part(__S, 0, __I))); false -> __F(__I - 1) end end end, __Find(__L - __SL) end)($0, $1)")]
    #[@External.Node("lastIndexOf")]
    fn lastIndexOf(self: Self, sub: string) -> i32;

    // The integer a decimal numeral spells: an optional `+` or `-`, then the
    // digits `0`–`9` and nothing else — the WHOLE string, so whitespace, a
    // fraction, an exponent, `0x2A` and the empty string are an `Error` naming
    // the input. Which strings are numerals is decided here, in botopink, so
    // every target refuses the same inputs; the host cell converts digits it
    // is never asked to judge. The answer is any `i64`, exact on every
    // target: a numeral past −2^63 … 2^63 − 1 is an `Error` on every target
    // (decision 176 as amended by 319; commonJS answers a `BigInt` past
    // ±(2^53 − 1)).
    //
    // The body calls a method on `self` only, and free cells for the rest —
    // see `libs/std/AGENTS.md` § String numerals for the three emitter gaps
    // that shape it.
    default fn parseInt(self: Self) -> @Result<i64, string> {
        val signed = self.startsWith("-") || self.startsWith("+");
        val digits = if (signed) stringSlice0(self, 1) else self;
        return if (stringIsDigits(digits))
            stringToInteger(self)
        else
            stringNumeralRefused("parseInt: \"", self, "\" is not an integer");
    }

    // The `f64` nearest to a decimal numeral: an optional `+` or `-`, digits,
    // an optional `.` with digits on BOTH sides, an optional exponent (`e` or
    // `E`, an optional sign, digits) — the whole string. `.5`, `1.`, `1e`,
    // `NaN`, `Infinity`, `0x10`, whitespace and the empty string are an
    // `Error` naming the input, decided in botopink; the host cell converts
    // the numeral rewritten as `<digits>.<digits>e<exponent>` (the one form
    // both hosts read), correctly rounded on both. A numeral too large for an
    // `f64` is an `Error`; one too small to tell from zero is `0.0`.
    default fn parseFloat(self: Self) -> @Result<f64, string> {
        val signed = self.startsWith("-") || self.startsWith("+");
        val start = if (signed) 1 else 0;
        val lowerAt = self.indexOf("e");
        val exponentAt = if (lowerAt < 0) self.indexOf("E") else lowerAt;
        val mantissa = if (exponentAt < 0)
            stringSlice0(self, start)
        else
            stringSlice1(self, start, exponentAt);
        val pointAt = self.indexOf(".");
        val pointed = pointAt >= 0 && (exponentAt < 0 || pointAt < exponentAt);
        val whole = if (pointed)
            stringSlice1(self, start, pointAt)
        else
            mantissa;
        val fraction = if (pointed == false)
            "0"
        else if (exponentAt < 0)
            stringSlice0(self, pointAt + 1)
        else
            stringSlice1(self, pointAt + 1, exponentAt);
        val exponent = if (exponentAt < 0)
            "0"
        else
            stringSlice0(self, exponentAt + 1);
        val exponentMark = if (exponentAt < 0)
            ""
        else
            stringSlice1(self, exponentAt + 1, exponentAt + 2);
        val exponentSigned = exponentMark == "-" || exponentMark == "+";
        val exponentDigits = if (exponentSigned)
            stringSlice0(self, exponentAt + 2)
        else
            exponent;
        val wellFormed = stringIsDigits(whole)
            && stringIsDigits(fraction)
            && stringIsDigits(exponentDigits);
        return if (wellFormed)
            stringToFloat(self, whole, fraction, exponent)
        else
            stringNumeralRefused("parseFloat: \"", self, "\" is not a number");
    }
}

// ── string slice arity dispatch ──────────────────────────────────────────────
// Host helpers behind `default fn slice`. commonJS patches
// `String.prototype.slice` with that body, so the Node templates must not call
// `.slice` (it would call the patch itself): they normalise the bounds the way
// native `slice` does and cut with `substring`. Markers are positional on every
// target: `$0` is the string, `$1` the start (decision 5). The erlang forms
// count codepoints (decision 320) over the decoded codepoint list — never
// `string:slice/3`, whose unit is the grapheme cluster — and normalise the
// bounds as the Node forms do.

#[@External.Erlang("""(fun(__S, __A) -> __L = unicode:characters_to_list(__S), __N = erlang:length(__L), __B = case __A < 0 of true -> erlang:max(__N + __A, 0); false -> erlang:min(__A, __N) end, unicode:characters_to_binary(lists:nthtail(__B, __L)) end)($0, $1)""")]
#[@External.Node("""((__s, __a) => { if (__a == null) __a = 0; if (/[\u{D800}-\u{DFFF}\u{10000}-\u{10FFFF}]/u.test(__s)) { const __c = Array.from(__s); const __m = __c.length; const __d = __a < 0 ? Math.max(__m + __a, 0) : Math.min(__a, __m); return Array.from({ length: __m - __d }, (_, __i) => __c[__d + __i]).join(""); } const __n = __s.length; const __b = __a < 0 ? Math.max(__n + __a, 0) : Math.min(__a, __n); return __s.substring(__b); })($0, $1)""")]
declare fn stringSlice0(s: string, start: i32) -> string;

#[@External.Erlang("""(fun(__S, __A, __E) -> __L = unicode:characters_to_list(__S), __N = erlang:length(__L), __B = case __A < 0 of true -> erlang:max(__N + __A, 0); false -> erlang:min(__A, __N) end, __F = case __E < 0 of true -> erlang:max(__N + __E, 0); false -> erlang:min(__E, __N) end, unicode:characters_to_binary(lists:sublist(__L, __B + 1, erlang:max(__F - __B, 0))) end)($0, $1, $2)""")]
#[@External.Node("""((__s, __a, __e) => { if (__a == null) __a = 0; if (/[\u{D800}-\u{DFFF}\u{10000}-\u{10FFFF}]/u.test(__s)) { const __c = Array.from(__s); const __m = __c.length; const __d = __a < 0 ? Math.max(__m + __a, 0) : Math.min(__a, __m); const __g = __e < 0 ? Math.max(__m + __e, 0) : Math.min(__e, __m); return Array.from({ length: Math.max(__g - __d, 0) }, (_, __i) => __c[__d + __i]).join(""); } const __n = __s.length; const __b = __a < 0 ? Math.max(__n + __a, 0) : Math.min(__a, __n); const __f = __e < 0 ? Math.max(__n + __e, 0) : Math.min(__e, __n); return __s.substring(__b, Math.max(__b, __f)); })($0, $1, $2)""")]
declare fn stringSlice1(s: string, start: i32, end: ?i32) -> string;

// ── string numerals ──────────────────────────────────────────────────────────
// Host helpers behind `default fn parseInt` / `parseFloat`. The methods decide
// in botopink which strings are numerals; these convert, and build the
// `@Result` and its text — a `default fn` body of this file is emitted as
// written on commonJS, where `Ok(…)` / `Error(…)` name nothing.

// True when `s` is one or more of the digits `0`–`9` and nothing else.
#[@External.Erlang("""(fun(__S) -> (__S =/= <<>>) andalso lists:all(fun(__C) -> (__C >= 48) andalso (__C =< 57) end, binary_to_list(__S)) end)($0)""")]
#[@External.Node("""(/^[0-9]+$/.test($0))""")]
declare fn stringIsDigits(s: string) -> bool;

// The integer `<sign><digits>` spells; the out-of-range `Error`, naming the
// numeral, past the `i64` range. The Node form reads the digits as a `BigInt`
// and answers 319's canonical form (a `number` within ±(2^53 − 1)).
#[@External.Erlang("""(fun(__S) -> __N = binary_to_integer(__S), case (__N >= -(1 bsl 63)) andalso (__N < (1 bsl 63)) of true -> {ok, __N}; false -> {error, <<"parseInt: ", 34, __S/binary, 34, " is out of range">>} end end)($0)""")]
#[@External.Node("""((__s) => { const __n = BigInt(__s); return (__n >= -9223372036854775808n && __n <= 9223372036854775807n) ? { ok: (__n >= -9007199254740991n && __n <= 9007199254740991n) ? Number(__n) : __n } : { error: 'parseInt: "' + __s + '" is out of range' } })($0)""")]
declare fn stringToInteger(numeral: string) -> @Result<i64, string>;

// The `f64` the numeral `text` spells, read from its accepted pieces as
// `<sign><whole>.<fraction>e<exponent>`; the overflow `Error`, naming `text`,
// when it does not fit. `binary_to_float/1` raises on an overflow and answers
// `0.0` on an underflow, which is what `Number` does with `Infinity` and `0`.
#[@External.Erlang("""(fun(__T, __W, __F, __X) -> __Sign = case __T of <<45, _/binary>> -> <<45>>; _ -> <<>> end, try {ok, binary_to_float(<<__Sign/binary, __W/binary, 46, __F/binary, 101, __X/binary>>)} catch _:_ -> {error, <<"parseFloat: ", 34, __T/binary, 34, " overflows f64">>} end end)($0, $1, $2, $3)""")]
#[@External.Node("""((__t, __w, __f, __x) => { const __n = Number((__t.startsWith('-') ? '-' : '') + __w + '.' + __f + 'e' + __x); return Number.isFinite(__n) ? { ok: __n } : { error: 'parseFloat: "' + __t + '" overflows f64' } })($0, $1, $2, $3)""")]
declare fn stringToFloat(
    text: string,
    whole: string,
    fraction: string,
    exponent: string,
) -> @Result<f64, string>;

// `Error(<before><text><after>)`.
#[@External.Erlang("""{error, <<($0)/binary, ($1)/binary, ($2)/binary>>}""")]
#[@External.Node("""({ error: $0 + $1 + $2 })""")]
declare fn stringNumeralRefused<T>(
    before: string,
    text: string,
    after: string,
) -> @Result<T, string>;

// ── function combinators ──────────────────────────────────────────────────────

// Pure higher-order combinators for function values. Associated functions
// (no `self` receiver): `Function.identity(x)`, `Function.compose(f, g)`, …
// Pure botopink — `default` bodies, no host backing.
behavior Function {
    default fn identity<A>(x: A) -> A {
        return x;
    }

    default fn compose<A, B, C>(
        f: fn(a: A) -> B,
        g: fn(b: B) -> C,
    ) -> fn(A) -> C {
        return { a -> g(f(a)) };
    }

    default fn flip<A, B, C>(f: fn(a: A, b: B) -> C) -> fn(B, A) -> C {
        return { b, a -> f(a, b) };
    }

    default fn constant<A, B>(x: A) -> fn(B) -> A {
        return { ignored -> x };
    }
}

// A pair IS a 2-tuple `#(A, B)` — structural, so no own record type. Associated
// functions (no `self` receiver) over tuples: `Pair.of(a, b)`, `Pair.first(p)`, …
// Pure botopink — `default` bodies, no host backing.
behavior Pair<A, B> {
    // NOTE: named `of` (not `new`) — `new` is a reserved keyword.
    default fn of(first: A, second: B) -> #(A, B) {
        return #(first, second);
    }

    default fn first(p: #(A, B)) -> A {
        return p._0;
    }

    default fn second(p: #(A, B)) -> B {
        return p._1;
    }

    default fn swap(p: #(A, B)) -> #(B, A) {
        return #(p._1, p._0);
    }

    default fn mapFirst<C>(
        p: #(A, B),
        transform: fn(value: A) -> C,
    ) -> #(C, B) {
        return #(transform(p._0), p._1);
    }

    default fn mapSecond<C>(
        p: #(A, B),
        transform: fn(value: B) -> C,
    ) -> #(A, C) {
        return #(p._0, transform(p._1));
    }
}

// ── array (eager collection) ──────────────────────────────────────
// The eager indexed collection — implements the lazy `Iterator<T>` (`next`)
// and adds `length`/index + host-backed ops, with derived `default fn`.

// NOTE: conceptually `Array<T>` is an `Iterator<T>` (it provides `next`), but the
// parser puts generics after `extends` (`behavior N extends B <T>`), so a
// generic-extends-generic clause doesn't parse yet — kept standalone for now.
//
// `Array<T>` answers `Index<i32, T>` (`at`) and `Slice<T[]>` (`slice`) — the two
// ambient behaviors of `builtins.d.bp` that make `xs[0]` and `xs[0..2]` legal
// (decision 63, amended). Written as a comment for the same reason as `String`
// above: a `behavior` declaration carries no `implement` clause.
behavior Array<T> {
    // intrinsic length (builtin).
    val length: i32;

    // ── host-backed primitives ──
    // `Index<i32, T>.at` — the reader `xs[0]` rewrites to.
    // A negative index counts from the end (decision 139): `xs.at(-1)` is
    // the last element, `xs.at(-xs.length)` the first, and past either end
    // is absent.
    #[@External.Erlang("(fun(__L, __I) -> __N = length(__L), __J = case __I < 0 of true -> __I + __N; false -> __I end, case ((__J >= 0) andalso (__J < __N)) of true -> lists:nth(__J + 1, __L); false -> undefined end end)($0, $1)")]
    #[@External.Node("at")]
    fn at(self: Self<T>, index: i32) -> ?T;

    #[@External.Erlang("($0 ++ [$1])")]
    #[@External.Node("push")]
    fn push(self: Self<T>, item: T);

    #[@External.Erlang("lists", "last")]
    #[@External.Node("pop")]
    fn pop(self: Self<T>) -> ?T;

    // `Slice<T[]>.slice` — `end` is `?i32` so an open-ended `xs[1..]` can pass
    // `null` in the second argument (there is no `Range` type to pass).
    default fn slice(self: Self<T>, start: i32, end: ?i32 = null) -> Self<T> {
        if (end != null)
            return arraySlice1(self, start, end)
        else
            return arraySlice0(self, start);
    }

    #[@External.Erlang("""iolist_to_binary(lists:join($1, lists:map(fun(__E) -> if is_binary(__E) -> __E; is_integer(__E) -> integer_to_binary(__E); is_list(__E) -> __E; true -> iolist_to_binary(io_lib:format("~p", [__E])) end end, $0)))""")]
    #[@External.Node("join")]
    fn join(self: Self<T>, sep: string) -> string;

    // `reverse` ANSWERS a reversed array and leaves the receiver alone, on
    // every target. Native `Array.prototype.reverse` reverses in place and
    // answers the same array, so on commonJS alone `val rev = xs.reverse();`
    // also reversed `xs` — every fold that read the receiver again after
    // reversing it answered one thing there and another on erlang and wasm,
    // at exit 0. `toReversed` is the §A4 rename to the engine's own copying
    // reader (ES2023; node 20, which is the floor CI installs), so the answer
    // is the same shape with no prototype patch and no helper.
    #[@External.Erlang("lists", "reverse")]
    #[@External.Beam("""    {call_ext, 1, {extfunc, lists, reverse, 1}}.""")]
    #[@External.Node("toReversed")]
    fn reverse(self: Self<T>) -> Self<T>;

    #[@External.Erlang("(fun(__L, __X) -> __Find = fun __F(__I, [__H | __T]) -> case (__H =:= __X) of true -> __I; false -> __F(__I + 1, __T) end; __F(_, []) -> -1 end, __Find(0, __L) end)($0, $1)")]
    #[@External.Node("indexOf")]
    fn indexOf(self: Self<T>, item: T) -> i32;

    // The last index of `item`, `-1` when absent — `indexOf` from the other
    // end, with `indexOf`'s equality on every target. erlang and node answer
    // natively; the other targets search the reversed copy.
    #[@External.Erlang("(fun(__L, __X) -> __Find = fun __F(__I, [__H | __T], __Last) -> __F(__I + 1, __T, case (__H =:= __X) of true -> __I; false -> __Last end); __F(_, [], __Last) -> __Last end, __Find(0, __L, -1) end)($0, $1)")]
    #[@External.Node("lastIndexOf")]
    default fn lastIndexOf(self: Self<T>, item: T) -> i32 {
        val fromEnd = self.reverse().indexOf(item);
        return if (fromEnd == -1) -1 else self.length - 1 - fromEnd;
    }

    #[@External.Erlang("lists", "foreach(action, self)")]
    #[@External.Node("forEach")]
    fn forEach(self: Self<T>, action: fn(item: T));

    #[@External.Erlang("lists", "map(transform, self)")]
    #[@External.Node("map")]
    fn map<U>(self: Self<T>, transform: fn(item: T) -> U) -> Array<U>;

    #[@External.Erlang("lists", "filter(pred, self)")]
    #[@External.Node("filter")]
    fn filter(self: Self<T>, pred: fn(item: T) -> bool) -> Self<T>;

    // `zip` pairs the receiver's items with `other`'s by index, truncating to
    // the shorter array. Template form: erlang uses `lists:zipwith` with a
    // tuple constructor; node uses an inline `.map` with index lookup +
    // truncation. wat deferred — no native zip primitive (logged as a known
    // gap; falls through to the inline allow-list as today).
    #[@External.Erlang("lists:zipwith(fun(__X, __Y) -> {__X, __Y} end, lists:sublist($0, length($1)), lists:sublist($1, length($0)))")]
    #[@External.Node("$0.map((__x, __i) => [__x, ($1)[__i]]).slice(0, Math.min($0.length, ($1).length))")]
    fn zip<U>(self: Self<T>, other: Array<U>) -> Array<#(T, U)>;

    // ── producers (associated — no receiver) ──
    // Pure botopink (no host backing): the host `lists:seq`/`duplicate` have the
    // wrong semantics (`seq` is end-inclusive; `duplicate` swaps the args), so
    // these recurse with an array-literal spread `[head, ..tail]`, giving
    // identical end-exclusive `[start, stop)` / `times`-copy results on every
    // backend. `head` is bound to a `val` first so the BEAM backend spills it to a
    // stack slot — an x-register would be clobbered by the recursive call. (No
    // comments inside the bodies: the commonJS if-expr emits as a one-line IIFE,
    // where a `//` would swallow the rest of the block.)
    default fn range(start: i32, stop: i32) -> Array<i32> {
        return if (start >= stop) [] else {
            val head = start;
            [head, ..(Array.range(start + 1, stop))];
        };
    }

    default fn repeat<E>(value: E, times: i32) -> Array<E> {
        return if (times <= 0) [] else {
            val head = value;
            [head, ..(Array.repeat(value, times - 1))];
        };
    }

    // ── derived ops (default implementations over the primitives) ──
    #[@External.Erlang("($0 =:= [])")]
    default fn isEmpty(self: Self<T>) -> bool {
        return self.length == 0;
    }

    #[@External.Erlang("lists:member($1, $0)")]
    default fn contains(self: Self<T>, x: T) -> bool {
        return self.indexOf(x) != -1;
    }

    default fn first(self: Self<T>) -> ?T {
        return self.at(0);
    }

    default fn rest(self: Self<T>) -> Self<T> {
        return self.slice(1, self.length);
    }

    default fn take(self: Self<T>, n: i32) -> Self<T> {
        return self.slice(0, n);
    }

    default fn drop(self: Self<T>, n: i32) -> Self<T> {
        return self.slice(n, self.length);
    }

    default fn fold<A>(
        self: Self<T>,
        initial: A,
        f: fn(acc: A, item: T) -> A,
    ) -> A {
        var acc = initial;
        self.forEach({ x ->
            acc = f(acc, x);
        });
        return acc;
    }

    #[@External.Node("find")]
    default fn find(self: Self<T>, pred: fn(item: T) -> bool) -> ?T {
        return self.filter(pred).at(0);
    }

    default fn count(self: Self<T>, pred: fn(item: T) -> bool) -> i32 {
        return self.filter(pred).length;
    }

    default fn all(self: Self<T>, pred: fn(item: T) -> bool) -> bool {
        return self.filter(pred).length == self.length;
    }

    default fn any(self: Self<T>, pred: fn(item: T) -> bool) -> bool {
        return self.filter(pred).length != 0;
    }

    #[@External.Erlang("($0 ++ $1)")]
    #[@External.Node("concat")]
    default fn append(self: Self<T>, other: Self<T>) -> Self<T> {
        var out = self.slice(0, self.length);
        other.forEach({ y -> out.push(y) });
        return out;
    }

    #[@External.Erlang("[$1 | $0]")]
    default fn prepend(self: Self<T>, item: T) -> Self<T> {
        var out = [item];
        self.forEach({ x -> out.push(x) });
        return out;
    }

    // NOTE: nested trailing lambdas don't parse yet (catalogued gap) — the inner
    // copy goes through `append` rather than a nested `forEach`.
    default fn flatten<E>(self: Self<T>) -> Array<E> {
        var out: E[] = [];
        self.forEach({ inner ->
            out = out.append(inner);
        });
        return out;
    }

    #[@External.Node("flatMap")]
    default fn flatMap<U>(
        self: Self<T>,
        transform: fn(item: T) -> U,
    ) -> Array<U> {
        return self.map(transform).flatten();
    }

    default fn toList(self: Self<T>) -> Self<T> {
        return self;
    }

    // ── std-tail F7.array_ext additions ──────────────────────────────────────
    // `some`/`every`/`flat` aliases over the existing `any`/`all`/`flatten`
    // (different camelCase name, identical semantics — chosen to mirror the
    // Node Array prototype). The originals stay so existing callers don't
    // break.
    default fn some(self: Self<T>, pred: fn(item: T) -> bool) -> bool {
        return self.any(pred);
    }

    default fn every(self: Self<T>, pred: fn(item: T) -> bool) -> bool {
        return self.all(pred);
    }

    default fn flat<E>(self: Self<T>) -> Array<E> {
        return self.flatten();
    }

    // First index where `pred` holds, or -1 when no element matches. Pure
    // botopink — recurses over indices through a fold that captures the
    // first hit (`-1` is preserved once set).
    default fn findIndex(self: Self<T>, pred: fn(item: T) -> bool) -> i32 {
        var out = -1;
        var i = 0;
        self.forEach({ x ->
            if (out == -1) if (pred(x)) out = i;
            i = i + 1;
        });
        return out;
    }

    // Build a fresh array of `length` copies of `value` — equivalent to
    // `Array.repeat(value, self.length)`, but the receiver-method form
    // matches the JS prototype signature callers expect.
    default fn fill<E>(self: Self<T>, value: E) -> Array<E> {
        return Array.repeat(value, self.length);
    }

    // Partition the array into consecutive chunks of `n` elements; the last
    // chunk may be shorter when `self.length` is not divisible by `n`.
    // Negative or zero `n` returns an empty array (no infinite loop).
    default fn chunked(self: Self<T>, n: i32) -> Array<Self<T>> {
        var out: Array<Self<T>> = [];
        if (n <= 0) return out;
        val len = self.length;
        for (0..len) { k ->
            if (k % n == 0) out = out.append([self.slice(k, k + n)]);
        }
        return out;
    }

    // Sliding window of length `n` over the array. Returns one window per
    // valid start offset (`self.length - n + 1` windows). Negative or zero
    // `n`, or `n > self.length`, returns an empty array.
    default fn sliding(self: Self<T>, n: i32) -> Array<Self<T>> {
        var out: Array<Self<T>> = [];
        if (n <= 0) return out;
        val windows = self.length - n + 1;
        if (windows <= 0) return out;
        for (0..windows) { k ->
            out = out.append([self.slice(k, k + n)]);
        }
        return out;
    }

    // Every duplicate dropped, each value kept at its first occurrence, in
    // order (decision 217): `[1, 2, 1, 3, 2].unique()` is `[1, 2, 3]` on every
    // target. Values compare with `==` (decision 210), so records by value —
    // not `contains`, which answers the host's identity on commonJS.
    default fn unique(self: Self<T>) -> Self<T> {
        var out: T[] = [];
        self.forEach({ x ->
            if (!out.any({ y -> y == x })) out = out.append([x]);
        });
        return out;
    }
}

// ── array slice arity dispatch ───────────────────────────────────────────────
// Same shape as the string pair above: commonJS patches `Array.prototype.slice`
// with `default fn slice`, so the Node templates copy the normalised range
// without calling `.slice`. The patch is global — host code (a sidecar, Node
// itself) calls `.slice()` with no start and gets the whole array, as native
// `slice` answers: a missing start is 0.

#[@External.Erlang("lists:nthtail($1, $0)")]
#[@External.Node("""((__xs, __a) => { const __n = __xs.length; if (__a == null) __a = 0; const __b = __a < 0 ? Math.max(__n + __a, 0) : Math.min(__a, __n); return Array.from({ length: __n - __b }, (_, __i) => __xs[__b + __i]); })($0, $1)""")]
declare fn arraySlice0<T>(xs: Array<T>, start: i32) -> Array<T>;

#[@External.Erlang("lists:sublist($0, ($1) + 1, (($2) - ($1)))")]
#[@External.Node("""((__xs, __a, __e) => { const __n = __xs.length; if (__a == null) __a = 0; const __b = __a < 0 ? Math.max(__n + __a, 0) : Math.min(__a, __n); const __f = __e < 0 ? Math.max(__n + __e, 0) : Math.min(__e, __n); return Array.from({ length: Math.max(__f - __b, 0) }, (_, __i) => __xs[__b + __i]); })($0, $1, $2)""")]
declare fn arraySlice1<T>(xs: Array<T>, start: i32, end: ?i32) -> Array<T>;

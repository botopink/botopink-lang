//// std/erlang — auto-imported Erlang BIF catalog (shadow-detection
//// metadata, also callable when explicitly imported).
////
//// Each decl uses `@External.Erlang("erlang", "<symbol>")`. The erlang
//// codegen (`codegen/erlang.zig`) walks this module via the std
//// `pkg_modules` table, extracts the (symbol, arity) pairs from every
//// annotation whose first arg is `"erlang"`, and emits
//// `-compile({no_auto_import,[fn/arity, …]}).` in the generated module
//// prelude when a user-defined fn shadows one.
////
//// Why a dedicated `std/erlang` module (not `builtins.d.bp`)? These
//// host-symbol wrappers are not essential to the language surface — the
//// majority of botopink programs never name them. Keeping them in their
//// own module avoids polluting the global env (consumers `import { …}
//// from "std/erlang"` only when needed).
////
//// Why only some BIFs (~30)? The shadow-directive matters only when a
//// botopink fn (camelCase) lowers to an erlang symbol that matches a
//// BIF — i.e., when the BIF name is a single word (`abs`, `length`,
//// `max`, …). Snake-case BIFs (`integer_to_binary`, `atom_to_list`, …)
//// can't be shadowed by camelCase user fns; they live as primitive
//// methods on `primitives.bp` and don't need a shadow entry here.
////
//// Adding a BIF: add one `#[@External.Erlang("erlang", "<name>")] pub
//// declare fn <camelCase>(…) -> unknown;`. Symbol + param count drive the
//// shadow entry — name in botopink is doc-only for callers.

#[@External.Erlang("erlang", "abs")]
pub declare fn abs(n: unknown) -> unknown;

#[@External.Erlang("erlang", "alias")]
pub declare fn alias() -> unknown;

#[@External.Erlang("erlang", "apply")]
pub declare fn apply(fun: unknown, args: unknown) -> unknown;

#[@External.Erlang("erlang", "apply")]
pub declare fn applyMfa(m: unknown, f: unknown, a: unknown) -> unknown;

#[@External.Erlang("erlang", "element")]
pub declare fn element(n: unknown, tuple: unknown) -> unknown;

#[@External.Erlang("erlang", "error")]
pub declare fn error(reason: unknown) -> unknown;

#[@External.Erlang("erlang", "error")]
pub declare fn errorWithArgs(reason: unknown, args: unknown) -> unknown;

#[@External.Erlang("erlang", "error")]
pub declare fn errorWithArgsAndOptions(
    reason: unknown,
    args: unknown,
    options: unknown,
) -> unknown;

#[@External.Erlang("erlang", "exit")]
pub declare fn exit(reason: unknown) -> unknown;

#[@External.Erlang("erlang", "exit")]
pub declare fn exitProcess(pid: unknown, reason: unknown) -> unknown;

#[@External.Erlang("erlang", "float")]
pub declare fn float(n: unknown) -> unknown;

#[@External.Erlang("erlang", "get")]
pub declare fn erlangGet() -> unknown;

#[@External.Erlang("erlang", "get")]
pub declare fn erlangGetByKey(key: unknown) -> unknown;

#[@External.Erlang("erlang", "halt")]
pub declare fn halt() -> unknown;

#[@External.Erlang("erlang", "halt")]
pub declare fn haltWithStatus(status: unknown) -> unknown;

#[@External.Erlang("erlang", "halt")]
pub declare fn haltWithStatusAndOptions(
    status: unknown,
    options: unknown,
) -> unknown;

#[@External.Erlang("erlang", "hd")]
pub declare fn hd(list: unknown) -> unknown;

#[@External.Erlang("erlang", "length")]
pub declare fn length(list: unknown) -> unknown;

#[@External.Erlang("erlang", "link")]
pub declare fn link(pid: unknown) -> unknown;

#[@External.Erlang("erlang", "max")]
pub declare fn max(a: unknown, b: unknown) -> unknown;

#[@External.Erlang("erlang", "min")]
pub declare fn min(a: unknown, b: unknown) -> unknown;

#[@External.Erlang("erlang", "monitor")]
pub declare fn monitor(kind: unknown, item: unknown) -> unknown;

#[@External.Erlang("erlang", "monitor")]
pub declare fn monitorWithOptions(
    kind: unknown,
    item: unknown,
    options: unknown,
) -> unknown;

#[@External.Erlang("erlang", "node")]
pub declare fn node() -> unknown;

#[@External.Erlang("erlang", "nodes")]
pub declare fn nodes() -> unknown;

#[@External.Erlang("erlang", "nodes")]
pub declare fn nodesOfType(arg: unknown) -> unknown;

#[@External.Erlang("erlang", "now")]
pub declare fn now() -> unknown;

#[@External.Erlang("erlang", "ports")]
pub declare fn ports() -> unknown;

#[@External.Erlang("erlang", "processes")]
pub declare fn processes() -> unknown;

#[@External.Erlang("erlang", "put")]
pub declare fn put(key: unknown, value: unknown) -> unknown;

#[@External.Erlang("erlang", "register")]
pub declare fn register(name: unknown, pid: unknown) -> unknown;

#[@External.Erlang("erlang", "registered")]
pub declare fn registered() -> unknown;

#[@External.Erlang("erlang", "round")]
pub declare fn round(n: unknown) -> unknown;

#[@External.Erlang("erlang", "self")]
pub declare fn self() -> unknown;

#[@External.Erlang("erlang", "send")]
pub declare fn send(dest: unknown, msg: unknown) -> unknown;

#[@External.Erlang("erlang", "send")]
pub declare fn sendWithOptions(
    dest: unknown,
    msg: unknown,
    options: unknown,
) -> unknown;

#[@External.Erlang("erlang", "size")]
pub declare fn size(term: unknown) -> unknown;

#[@External.Erlang("erlang", "spawn")]
pub declare fn spawn(fun: unknown) -> unknown;

#[@External.Erlang("erlang", "spawn")]
pub declare fn spawnOnNode(node: unknown, fun: unknown) -> unknown;

#[@External.Erlang("erlang", "spawn")]
pub declare fn spawnMfa(m: unknown, f: unknown, a: unknown) -> unknown;

#[@External.Erlang("erlang", "spawn")]
pub declare fn spawnMfaOnNode(
    node: unknown,
    m: unknown,
    f: unknown,
    a: unknown,
) -> unknown;

#[@External.Erlang("erlang", "statistics")]
pub declare fn statistics(item: unknown) -> unknown;

#[@External.Erlang("erlang", "time")]
pub declare fn time() -> unknown;

#[@External.Erlang("erlang", "tl")]
pub declare fn tl(list: unknown) -> unknown;

#[@External.Erlang("erlang", "trunc")]
pub declare fn trunc(n: unknown) -> unknown;

#[@External.Erlang("erlang", "unlink")]
pub declare fn unlink(pid: unknown) -> unknown;

#[@External.Erlang("erlang", "unregister")]
pub declare fn unregister(name: unknown) -> unknown;

#[@External.Erlang("erlang", "whereis")]
pub declare fn whereis(name: unknown) -> unknown;

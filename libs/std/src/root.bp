//// The botopink standard library — module-tree root.
////
//// This `root.bp` is the explicit tree root of the `std` package: each
//// `pub mod` below declares an importable std module (`import {…} from "std"`).
//// It is the single source of truth for the std module set — the build embeds
//// exactly the modules declared here, so adding a std module is `drop
//// libs/std/src/<name>.bp` + `pub mod <name>;` here (no build.zig edit).
////
//// Three categories (decision 106). The modules below are the PURE root —
//// same input, same output: no clock, no disk, no network, no entropy — and
//// a root module that imports from `io` is refused (`std-root-imports-io`).
//// `io/` is everything that talks to the world outside the process;
//// `testing/` is the harness (`botopink test` only). `erlang` and `beam` are
//// the target's surface, outside the criterion.
////
//// The ambient modules (`primitives.bp`, `builtins.d.bp`, `builtins_fns.d.bp`) are
//// flattened into the global type env rather than imported, so they are wired
//// separately by the build and are not declared here.

pub mod collections;
pub mod math;
pub mod path;
pub mod url;
pub mod querystring;
pub mod json;
pub mod regex;
pub mod unicode;
pub mod string_builder;
pub mod encoding;
pub mod hash;
pub mod escape;
pub mod async;
pub mod erlang;
pub mod beam;
pub mod io;
pub mod testing;

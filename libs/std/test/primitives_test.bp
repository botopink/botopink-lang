//// std — primitive interface tests (`src/primitives.bp`).
////
//// `primitives.bp` is a core file: it is flattened into the global type env
//// and never compiled as a module, so test blocks inside it never ran. They
//// live here instead — `test/` is compiled in test mode and sees the global
//// env. Run by `botopink test` from `libs/std/`.

// ── numeric, bool, string, function ──────────────────────────────────────────
// Migrated from the former int/float/bool/string/function modules. Rewritten
// in method syntax (receivers are `val`-bound — literal receivers don't parse).
// Combinators are called via the interface qualifier: `Function.identity(x)`.

test "i32 abs" {
    val neg = -5;
    val zero = 0;
    val pos = 5;
    assert neg.abs() == 5;
    assert zero.abs() == 0;
    assert pos.abs() == 5;
}

test "i32 min and max" {
    val a = 3;
    val b = 7;
    val c = -1;
    val d = 0;
    assert a.min(b) == 3;
    assert a.max(b) == 7;
    assert c.min(d) == -1;
}

test "i32 clamp" {
    val a = 3;
    val b = -1;
    val c = 10;
    assert a.clamp(0, 5) == 3;
    assert b.clamp(0, 5) == 0;
    assert c.clamp(0, 5) == 5;
}

test "i32 isEven and isOdd" {
    val four = 4;
    val three = 3;
    val seven = 7;
    val eight = 8;
    assert four.isEven();
    assert !three.isEven();
    assert seven.isOdd();
    assert !eight.isOdd();
}

test "i32 toString" {
    val n = 42;
    val z = 0;
    assert n.toString() == "42";
    assert z.toString() == "0";
}

test "f64 abs" {
    val zero = 0.0;
    val neg = -3.5;
    val pos = 2.1;
    assert zero.abs() == 0.0;
    assert neg.abs() == 3.5;
    assert pos.abs() == 2.1;
}

test "f64 min and max" {
    val a = 1.5;
    val b = 2.5;
    assert a.min(b) == 1.5;
    assert a.max(b) == 2.5;
}

test "f64 clamp" {
    val a = 3.0;
    val b = -1.0;
    val c = 9.9;
    assert a.clamp(0.0, 5.0) == 3.0;
    assert b.clamp(0.0, 5.0) == 0.0;
    assert c.clamp(0.0, 5.0) == 5.0;
}

test "f64 toString" {
    val n = 1.5;
    assert n.toString() == "1.5";
}

test "f64 round, floor and ceil" {
    val a = 2.5;
    val b = 2.4;
    assert a.round() == 3.0;
    assert b.round() == 2.0;
    assert b.floor() == 2.0;
    assert b.ceil() == 3.0;
}

test "bool negate" {
    val f = false;
    val t = true;
    assert f.negate();
    assert t.negate().negate();
}

test "bool nor" {
    val f = false;
    val t = true;
    assert f.nor(f);
    assert t.nor(f).negate();
}

test "bool nand" {
    val t = true;
    val f = false;
    assert t.nand(f);
    assert t.nand(t).negate();
}

test "bool exclusiveOr" {
    val t = true;
    val f = false;
    assert t.exclusiveOr(f);
    assert t.exclusiveOr(t).negate();
}

test "bool exclusiveNor" {
    val t = true;
    val f = false;
    assert t.exclusiveNor(t);
    assert t.exclusiveNor(f).negate();
}

test "string split and join" {
    val csv = "a,b,c";
    val parts = csv.split(",");
    assert parts.join("-") == "a-b-c";
}

test "string contains" {
    val hw = "hello world";
    val h = "hello";
    assert hw.contains("world");
    assert !h.contains("xyz");
}

test "string startsWith and endsWith" {
    val s = "foobar";
    assert s.startsWith("foo");
    assert s.endsWith("bar");
}

test "string slice" {
    val h = "hello";
    assert h.slice(1, 3) == "el";
    assert h.slice(0, 2) == "he";
}

test "string slice to an empty range" {
    val h = "hello";
    assert h.slice(0, 0) == "";
    assert h.slice(2, 5) == "llo";
}

test "string endsWith misses and the empty suffix" {
    val s = "foobar";
    val short = "ar";
    assert !s.endsWith("foo");
    assert s.endsWith("");
    assert !short.endsWith("bar");
}

test "string indexOf hit, miss and empty needle" {
    val s = "hello";
    assert s.indexOf("l") == 2;
    assert s.indexOf("z") == -1;
    assert s.indexOf("") == 0;
}

test "string trimStart and trimEnd strip one side" {
    val padded = "  hi  ";
    assert padded.trimStart() == "hi  ";
    assert padded.trimEnd() == "  hi";
}

test "string replace swaps the first occurrence" {
    val s = "banana";
    assert s.replace("a", "o") == "bonana";
}

test "string charAt in range" {
    val s = "abc";
    assert s.charAt(1).unwrapOr("none") == "b";
}

test "string split length" {
    val s = "a,b";
    val parts = s.split(",");
    assert parts.length == 2;
}

test "string split on the empty separator answers every character" {
    val s = "abc";
    val parts = s.split("");
    assert parts.length == 3;
    assert parts.join("|") == "a|b|c";
    val empty = "";
    assert empty.split("").length == 0;
}

test "string trim" {
    val padded = "  hi  ";
    assert padded.trim() == "hi";
}

test "function identity" {
    assert Function.identity(42) == 42;
    assert Function.identity("hi") == "hi";
    assert Function.identity(true);
}

test "function compose left-to-right" {
    val double = { n -> n * 2 };
    val addOne = { n -> n + 1 };
    val f = Function.compose(double, addOne);
    assert f(3) == 7;
    assert f(0) == 1;
}

test "function compose with string transform" {
    val shout = { s -> s + "!" };
    val greet = { s -> "Hello, " + s };
    val greetAndShout = Function.compose(greet, shout);
    assert greetAndShout("world") == "Hello, world!";
}

test "function flip reverses arg order" {
    val sub = { a, b -> a - b };
    val rsub = Function.flip(sub);
    assert rsub(3, 10) == 7;
}

// One binding per argument type: a `val` bound to a generic call is not
// generalised, so a single `always42` offered a `string` and then an `i32`
// fails to check (let-generalisation gap, owned by the checker front F7).
test "function constant ignores arg" {
    val always42 = Function.constant(42);
    val alsoAlways42 = Function.constant(42);
    assert always42("anything") == 42;
    assert alsoAlways42(0) == 42;
}

// ── option ────────────────────────────────────────────────────────────────────
// `?T` builtin surface (map/flatMap/unwrapOr) + optional chaining `?.`.
// Migrated from option_test.bp. No `option` module/namespace — `?` syntax only.

type User(name: string)

test "option map and unwrapOr" {
    val x: ?i32 = 3;
    val y = x.map({ n -> n * 2 });
    assert y.unwrapOr(0) == 6;
}

test "option unwrapOr on null" {
    val z: ?i32 = null;
    assert z.unwrapOr(7) == 7;
}

test "option flatMap" {
    val x: ?i32 = 3;
    val y = x.flatMap({ n -> x });
    assert y.unwrapOr(0) == 3;
}

test "optional chaining member access" {
    val u: ?User = User(name: "ana");
    val n = u?.name;
    assert n.unwrapOr("none") == "ana";
}

test "optional chaining short-circuits null" {
    val v: ?User = null;
    val n = v?.name;
    assert n.unwrapOr("none") == "none";
}

// ── result ────────────────────────────────────────────────────────────────────
// Builtin `result` namespace (no import): map/then/unwrap/isOk/isError. Producers
// follow the rule: only a `#[@result]` fn (`-> @Result<D, E>`) gets
// checked-Result treatment. Migrated from result_test.bp.

#[@result]
fn parse(n: i32) -> @Result<i32, string> {
    if (n < 0) throw "negative";
    return n;
}

test "result.isOk and isError" {
    assert result.isOk(parse(1));
    assert result.isError(parse(-1));
}

test "result.map transforms ok" {
    val r = result.map(parse(20), { x -> x * 2 + 2 });
    assert result.unwrap(r, 0) == 42;
}

test "result.map propagates error" {
    val r = result.map(parse(-1), { x -> x * 2 });
    assert result.isError(r);
    assert result.unwrap(r, 7) == 7;
}

test "result.then chains" {
    val r = result.then(parse(10), { x -> parse(x + 1) });
    assert result.unwrap(r, 0) == 11;
}

test "result.then propagates inner error" {
    val r = result.then(parse(5), { x -> parse(0 - x) });
    assert result.isError(r);
}

// ── array ─────────────────────────────────────────────────────────────────────

test "iterator fold and map" {
    val xs = [1, 2, 3, 4];
    val doubled = xs.map({ x -> x * 2 });
    assert doubled.fold(0, { acc, x -> acc + x }) == 20, "fold of doubled";
}

test "iterator filter length count" {
    val xs = [1, 2, 3, 4];
    assert xs.filter({ x -> x > 2 }).length == 2, "filter > 2";
    assert xs.count({ x -> x > 1 }) == 3, "count > 1";
}

test "iterator contains first isEmpty" {
    val xs = [1, 2, 3];
    assert xs.contains(3), "contains 3";
    assert xs.filter({ x -> x > 9 }).isEmpty(), "filtered empty";
}

test "iterator take drop reverse" {
    val xs = [1, 2, 3, 4];
    assert xs.take(2).join(",") == "1,2", "take 2";
    assert xs.drop(2).join(",") == "3,4", "drop 2";
    assert xs.reverse().join(",") == "4,3,2,1", "reverse";
}

test "iterator all any" {
    val xs = [2, 4, 6];
    assert xs.all({ x -> x > 1 }), "all > 1";
    assert xs.any({ x -> x > 5 }), "any > 5";
}

test "array take zero and drop to the end" {
    val xs = [1, 2, 3];
    assert xs.take(0).length == 0;
    assert xs.drop(1).join(",") == "2,3";
}

test "array join" {
    val xs = ["a", "b", "c"];
    assert xs.join("-") == "a-b-c";
}

test "array reverse" {
    val ns = [1, 2, 3];
    assert ns.reverse().join(",") == "3,2,1";
}

test "array indexOf and at" {
    val ns = [1, 2, 3];
    assert ns.indexOf(3) == 2;
    assert ns.at(1) == 2;
}

test "array map" {
    val ns = [1, 2, 3];
    val sq = ns.map({ x -> x * x });
    assert sq.join(",") == "1,4,9";
}

test "array filter" {
    val ns = [1, 2, 3, 4];
    val ev = ns.filter({ n -> n % 2 == 0 });
    assert ev.join(",") == "2,4";
}

test "array slice" {
    val ns = [1, 2, 3, 4];
    assert ns.slice(1, 3).join(",") == "2,3";
}

// ── F7.array_ext smoke tests ─────────────────────────────────────────────────

test "array some / every aliases over any / all" {
    val ns = [1, 2, 3, 4];
    assert ns.some({ x -> x > 3 });
    assert ns.every({ x -> x > 0 });
    assert ns.some({ x -> x > 9 }).negate();
    assert ns.every({ x -> x > 1 }).negate();
}

test "array findIndex returns first hit, -1 when no match" {
    val ns = [10, 20, 30, 40];
    assert ns.findIndex({ x -> x == 30 }) == 2;
    assert ns.findIndex({ x -> x > 100 }) == -1;
}

test "array zip pairs the prefix" {
    val a = [1, 2, 3];
    val b = ["a", "b"];
    val pairs = a.zip(b);
    assert pairs.length == 2;
}

// ── F7.string_ext smoke tests ────────────────────────────────────────────────

test "string padStart pads to length" {
    assert "5".padStart(3, "0") == "005";
}

test "string repeat duplicates" {
    assert "ab".repeat(3) == "ababab";
}

test "string replaceAll swaps every occurrence" {
    assert "banana".replaceAll("a", "X") == "bXnXnX";
}

test "string chars decomposes ASCII" {
    val cs = "abc".chars();
    assert cs.length == 3;
}

test "string lines splits on newline" {
    val ls = "a\nb\nc".lines();
    assert ls.length == 3;
}

test "string words splits on whitespace runs" {
    val ws = "a  b\tc".words();
    assert ws.length == 3;
}

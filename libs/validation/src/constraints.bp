//// validation — the constraint predicates. Moved from rakun front 14's
//// validation member (decision 116 rule 5).
////
//// EVERY FUNCTION HERE IS PLAIN BOTOPINK: string comparisons, length checks,
//// numeric bounds, `std/regex` matches and the walks of `formats.bp`. This
//// module declares no host cell; what it calls of std (`regex`, `unicode`,
//// `io.clock`) answers the same on both targets. That is the whole reason this module's target is `both —
//// boundary`: the `validate()` member `#[validated]` adds compiles for erlang and for
//// commonJS from ONE source, so the server and the client run the same
//// predicate rather than two predicates that are supposed to agree.
//// `test/parity_test.bp` is what holds that claim up.
////
//// Each predicate answers `Array<Violation>` — empty or one — which is what
//// makes "all of them run; the first failure does not stop the second" the
//// emitted validator's shape rather than an option it has.
////
//// ONE FUNCTION PER NUMERIC WIDTH. `#[minValue]` on an `i32` field and on an
//// `f64` field are different cells, because the emitter knows the field's type
//// and a single generic bound would have to unify `i32` with `f64`. See the
//// language-gap table in the front README for the i64 half: an integer literal
//// does not widen to `i64` in arithmetic, so `#[minValue]`/`#[maxValue]` are
//// refused on an `i64` field rather than emitted as something that reds.

import {report.Violation, report.violation, report.noViolation, report.oneViolation};
import {messages.Arg, messages.arg, messages.message, messages.builtInTemplate, messages.noArgs, messages.showI32, messages.showI64, messages.showF64};
import {formats.isBase64, formats.isBase64Url, formats.isCidrv4, formats.isCidrv6, formats.isCreditCard, formats.isCuid, formats.isCuid2, formats.isCurrencyCode, formats.isE164, formats.isEmailHtml5, formats.isEmailRfc5322, formats.isEmailUnicode, formats.isEmoji, formats.isGuid, formats.isHash, formats.isHex, formats.isHostname, formats.isHttpUrl, formats.isIban, formats.isIpv4, formats.isIpv6, formats.isIsoDate, formats.isIsoDatetime, formats.isIsoDatetimeLocal, formats.isIsoDatetimeOffset, formats.isIsoDatetimePrecision, formats.isIsoDuration, formats.isIsoTime, formats.isIsoTimeWith, formats.isJwt, formats.isJwtAlg, formats.isLowercase, formats.isMac, formats.isNanoid, formats.isUlid, formats.isUppercase, formats.isUrl, formats.isUuid, formats.isUuidVersion, formats.urlParts};
import {regex, io.clock, unicode, math, collections.Dict, collections.Set} from "std";

fn fail(
    field: string,
    code: string,
    value: string,
    params: Array<Arg>,
) -> Array<Violation> {
    return oneViolation(
        violation(
            field,
            code,
            message(code, builtInTemplate(code), field, value, params),
            value,
        ),
    );
}

// ── presence ────────────────────────────────────────────────────────────────

// `present` is the emitted `v.<field> != null`. `#[notNull]` is refused on a
// field whose type cannot be null at all, so this is never trivially true.
pub fn vNotNull(field: string, present: bool) -> Array<Violation> {
    if (present)
        return noViolation()
    else
        return fail(field, "notNull", "", noArgs());
}

pub fn vNotBlank(field: string, value: string) -> Array<Violation> {
    if (value.trim().length() > 0)
        return noViolation()
    else
        return fail(field, "notBlank", value, noArgs());
}

pub fn vNotEmpty(field: string, value: string) -> Array<Violation> {
    if (value.length() > 0)
        return noViolation()
    else
        return fail(field, "notEmpty", value, noArgs());
}

pub fn vNotEmptyList<T>(field: string, value: Array<T>) -> Array<Violation> {
    if (value.length > 0)
        return noViolation()
    else
        return fail(field, "notEmpty", showI32(value.length), noArgs());
}

// ── size ────────────────────────────────────────────────────────────────────
//
// Both bounds are passed because a declared parameter default is never applied
// at a call site (`docs.md:502-505`); Spring's single `@Size(min = …)` with the
// other half optional has no botopink spelling, and pretending otherwise would
// produce a decorator that silently drops an argument.

fn sizeArgs(min: i32, max: i32) -> Array<Arg> {
    return [arg("min", showI32(min)), arg("max", showI32(max))];
}

pub fn vSizeBetween(
    field: string,
    value: string,
    min: i32,
    max: i32,
) -> Array<Violation> {
    val n = value.length();
    if (n >= min && n <= max)
        return noViolation()
    else
        return fail(field, "sizeBetween", value, sizeArgs(min, max));
}

pub fn vSizeBetweenList<T>(
    field: string,
    value: Array<T>,
    min: i32,
    max: i32,
) -> Array<Violation> {
    val n = value.length;
    if (n >= min && n <= max)
        return noViolation()
    else
        return fail(field, "sizeBetween", showI32(n), sizeArgs(min, max));
}

// ── numeric bounds ──────────────────────────────────────────────────────────

pub fn vMinValueI32(field: string, value: i32, min: i32) -> Array<Violation> {
    if (value >= min)
        return noViolation()
    else
        return fail(
            field,
            "minValue",
            showI32(value),
            [arg("min", showI32(min))],
        );
}

pub fn vMaxValueI32(field: string, value: i32, max: i32) -> Array<Violation> {
    if (value <= max)
        return noViolation()
    else
        return fail(
            field,
            "maxValue",
            showI32(value),
            [arg("max", showI32(max))],
        );
}

pub fn vMinValueF64(field: string, value: f64, min: f64) -> Array<Violation> {
    if (value >= min)
        return noViolation()
    else
        return fail(
            field,
            "minValue",
            showF64(value),
            [arg("min", showF64(min))],
        );
}

pub fn vMaxValueF64(field: string, value: f64, max: f64) -> Array<Violation> {
    if (value <= max)
        return noViolation()
    else
        return fail(
            field,
            "maxValue",
            showF64(value),
            [arg("max", showF64(max))],
        );
}

// ── sign ────────────────────────────────────────────────────────────────────
//
// `0` is an `i32` literal that widens against an `i64` or an `f64` in a
// COMPARISON (it does not widen in arithmetic — see the gap table), so one cell
// per width is still what keeps the emitted call typed to the field.

pub fn vPositiveI32(field: string, value: i32) -> Array<Violation> {
    if (value > 0)
        return noViolation()
    else
        return fail(field, "positive", showI32(value), noArgs());
}

pub fn vPositiveOrZeroI32(field: string, value: i32) -> Array<Violation> {
    if (value >= 0)
        return noViolation()
    else
        return fail(field, "positiveOrZero", showI32(value), noArgs());
}

pub fn vPositiveI64(field: string, value: i64) -> Array<Violation> {
    if (value > 0)
        return noViolation()
    else
        return fail(field, "positive", showI64(value), noArgs());
}

pub fn vPositiveOrZeroI64(field: string, value: i64) -> Array<Violation> {
    if (value >= 0)
        return noViolation()
    else
        return fail(field, "positiveOrZero", showI64(value), noArgs());
}

pub fn vPositiveF64(field: string, value: f64) -> Array<Violation> {
    if (value > 0.0)
        return noViolation()
    else
        return fail(field, "positive", showF64(value), noArgs());
}

pub fn vPositiveOrZeroF64(field: string, value: f64) -> Array<Violation> {
    if (value >= 0.0)
        return noViolation()
    else
        return fail(field, "positiveOrZero", showF64(value), noArgs());
}

// ── text shapes ─────────────────────────────────────────────────────────────

// The address grammar, written in the intersection of the two regex flavours
// the two rows use — PCRE on erlang (`re:run/2`), ECMAScript on node
// (`new RegExp`). No backslash class and no lookaround: a bracket class and a
// literal `[.]` mean the same thing in both, which is what makes this pattern a
// predicate and not two predicates.
pub fn emailPattern() -> string {
    return "^[^@ ]+@[^@ .]+([.][^@ .]+)+$";
}

pub fn vEmail(field: string, value: string) -> Array<Violation> {
    if (regex.matches(emailPattern(), value))
        return noViolation()
    else
        return fail(field, "email", value, noArgs());
}

pub fn vPattern(
    field: string,
    value: string,
    pattern: string,
) -> Array<Violation> {
    if (regex.matches(pattern, value))
        return noViolation()
    else
        return fail(field, "pattern", value, [arg("regex", pattern)]);
}

// ── time ────────────────────────────────────────────────────────────────────
//
// Epoch milliseconds against `std/clock.nowMillis()` — `Date.now()` on node,
// `erlang:system_time(1000)` on the BEAM. The boundary is strict on both sides:
// `now` itself is neither past nor future, so a value equal to the clock reads
// is a violation for both markers rather than acceptable to both.

pub fn vPastDate(field: string, value: i64) -> Array<Violation> {
    if (value < clock.nowMillis())
        return noViolation()
    else
        return fail(field, "pastDate", showI64(value), noArgs());
}

pub fn vFutureDate(field: string, value: i64) -> Array<Violation> {
    if (value > clock.nowMillis())
        return noViolation()
    else
        return fail(field, "futureDate", showI64(value), noArgs());
}

// ── step 3: length, in code points and in items ─────────────────────────────
//
// A string's length is its number of CODE POINTS (`unicode.codepoints`), the
// count both targets agree on (`test/platform_test.bp`); a list's, a dict's and
// a set's is its number of items. The message carries the count, so the value
// a list reports is its size.

fn codepointLength(value: string) -> i32 {
    return unicode.codepoints(value).length;
}

fn lengthCheck(
    field: string,
    code: string,
    n: i32,
    bound: i32,
    shown: string,
) -> Array<Violation> {
    val ok = if (code == "minLength")
        n >= bound
    else if (code == "maxLength")
        n <= bound
    else
        n == bound;
    if (ok) return noViolation();
    val name = if (code == "minLength")
        "min"
    else if (code == "maxLength")
        "max"
    else
        "length";
    return fail(field, code, shown, [arg(name, showI32(bound))]);
}

pub fn vMinLength(field: string, value: string, min: i32) -> Array<Violation> {
    return lengthCheck(field, "minLength", codepointLength(value), min, value);
}

pub fn vMaxLength(field: string, value: string, max: i32) -> Array<Violation> {
    return lengthCheck(field, "maxLength", codepointLength(value), max, value);
}

pub fn vLength(field: string, value: string, length: i32) -> Array<Violation> {
    return lengthCheck(field, "length", codepointLength(value), length, value);
}

pub fn vMinLengthList<T>(
    field: string,
    value: Array<T>,
    min: i32,
) -> Array<Violation> {
    return lengthCheck(
        field,
        "minLength",
        value.length,
        min,
        showI32(value.length),
    );
}

pub fn vMaxLengthList<T>(
    field: string,
    value: Array<T>,
    max: i32,
) -> Array<Violation> {
    return lengthCheck(
        field,
        "maxLength",
        value.length,
        max,
        showI32(value.length),
    );
}

pub fn vLengthList<T>(
    field: string,
    value: Array<T>,
    length: i32,
) -> Array<Violation> {
    return lengthCheck(
        field,
        "length",
        value.length,
        length,
        showI32(value.length),
    );
}

pub fn vMinLengthDict<K, V>(
    field: string,
    value: Dict<K, V>,
    min: i32,
) -> Array<Violation> {
    return lengthCheck(
        field,
        "minLength",
        value.size(),
        min,
        showI32(value.size()),
    );
}

pub fn vMaxLengthDict<K, V>(
    field: string,
    value: Dict<K, V>,
    max: i32,
) -> Array<Violation> {
    return lengthCheck(
        field,
        "maxLength",
        value.size(),
        max,
        showI32(value.size()),
    );
}

pub fn vLengthDict<K, V>(
    field: string,
    value: Dict<K, V>,
    length: i32,
) -> Array<Violation> {
    return lengthCheck(
        field,
        "length",
        value.size(),
        length,
        showI32(value.size()),
    );
}

pub fn vMinLengthSet<T>(
    field: string,
    value: Set<T>,
    min: i32,
) -> Array<Violation> {
    return lengthCheck(
        field,
        "minLength",
        value.size(),
        min,
        showI32(value.size()),
    );
}

pub fn vMaxLengthSet<T>(
    field: string,
    value: Set<T>,
    max: i32,
) -> Array<Violation> {
    return lengthCheck(
        field,
        "maxLength",
        value.size(),
        max,
        showI32(value.size()),
    );
}

pub fn vLengthSet<T>(
    field: string,
    value: Set<T>,
    length: i32,
) -> Array<Violation> {
    return lengthCheck(
        field,
        "length",
        value.size(),
        length,
        showI32(value.size()),
    );
}

// ── step 3: text checks ─────────────────────────────────────────────────────

fn check(
    ok: bool,
    field: string,
    code: string,
    value: string,
) -> Array<Violation> {
    if (ok) return noViolation();
    return fail(field, code, value, noArgs());
}

fn checkWith(
    ok: bool,
    field: string,
    code: string,
    value: string,
    params: Array<Arg>,
) -> Array<Violation> {
    if (ok) return noViolation();
    return fail(field, code, value, params);
}

pub fn vStartsWith(
    field: string,
    value: string,
    prefix: string,
) -> Array<Violation> {
    return checkWith(
        value.startsWith(prefix),
        field,
        "startsWith",
        value,
        [arg("prefix", prefix)],
    );
}

pub fn vEndsWith(
    field: string,
    value: string,
    suffix: string,
) -> Array<Violation> {
    return checkWith(
        value.endsWith(suffix),
        field,
        "endsWith",
        value,
        [arg("suffix", suffix)],
    );
}

pub fn vIncludes(
    field: string,
    value: string,
    substring: string,
) -> Array<Violation> {
    return checkWith(
        value.contains(substring),
        field,
        "includes",
        value,
        [arg("substring", substring)],
    );
}

pub fn vUppercase(field: string, value: string) -> Array<Violation> {
    return check(isUppercase(value), field, "uppercase", value);
}

pub fn vLowercase(field: string, value: string) -> Array<Violation> {
    return check(isLowercase(value), field, "lowercase", value);
}

// ── step 3: string formats ──────────────────────────────────────────────────
//
// Each a call of `formats.bp`, where the rule is written out.

pub fn vEmailHtml5(field: string, value: string) -> Array<Violation> {
    return check(isEmailHtml5(value), field, "emailHtml5", value);
}

pub fn vEmailRfc5322(field: string, value: string) -> Array<Violation> {
    return check(isEmailRfc5322(value), field, "emailRfc5322", value);
}

pub fn vEmailUnicode(field: string, value: string) -> Array<Violation> {
    return check(isEmailUnicode(value), field, "emailUnicode", value);
}

pub fn vUuid(field: string, value: string) -> Array<Violation> {
    return check(isUuid(value), field, "uuid", value);
}

pub fn vUuidV(field: string, value: string, version: i32) -> Array<Violation> {
    return checkWith(
        isUuidVersion(value, version),
        field,
        "uuidV",
        value,
        [arg("version", showI32(version))],
    );
}

pub fn vGuid(field: string, value: string) -> Array<Violation> {
    return check(isGuid(value), field, "guid", value);
}

pub fn vUrl(field: string, value: string) -> Array<Violation> {
    return check(isUrl(value), field, "url", value);
}

// The host of a URL matches `pattern` (Zod's `hostname`); a text that is not a
// URL fails too.
pub fn vUrlHost(
    field: string,
    value: string,
    pattern: string,
) -> Array<Violation> {
    val u = urlParts(value);
    return checkWith(
        u.ok && regex.matches(pattern, u.host),
        field,
        "urlHost",
        value,
        [arg("hostname", pattern)],
    );
}

// The scheme of a URL matches `pattern` (Zod's `protocol`, without the `:`).
pub fn vUrlProtocol(
    field: string,
    value: string,
    pattern: string,
) -> Array<Violation> {
    val u = urlParts(value);
    return checkWith(
        u.ok && regex.matches(pattern, u.scheme),
        field,
        "urlProtocol",
        value,
        [arg("protocol", pattern)],
    );
}

pub fn vHttpUrl(field: string, value: string) -> Array<Violation> {
    return check(isHttpUrl(value), field, "httpUrl", value);
}

pub fn vHostname(field: string, value: string) -> Array<Violation> {
    return check(isHostname(value), field, "hostname", value);
}

pub fn vE164(field: string, value: string) -> Array<Violation> {
    return check(isE164(value), field, "e164", value);
}

pub fn vEmoji(field: string, value: string) -> Array<Violation> {
    return check(isEmoji(value), field, "emoji", value);
}

pub fn vBase64(field: string, value: string) -> Array<Violation> {

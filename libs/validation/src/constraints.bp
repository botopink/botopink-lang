}

pub fn vJwt(field: string, value: string) -> Array<Violation> {
    return check(isJwt(value), field, "jwt", value);
}

pub fn vJwtAlg(field: string, value: string, alg: string) -> Array<Violation> {
    return checkWith(
        isJwtAlg(value, alg),
        field,
        "jwtAlg",
        value,
        [arg("alg", alg)],
    );
}

pub fn vNanoid(field: string, value: string) -> Array<Violation> {
    return check(isNanoid(value), field, "nanoid", value);
}

pub fn vCuid(field: string, value: string) -> Array<Violation> {
    return check(isCuid(value), field, "cuid", value);
}

pub fn vCuid2(field: string, value: string) -> Array<Violation> {
    return check(isCuid2(value), field, "cuid2", value);
}

pub fn vUlid(field: string, value: string) -> Array<Violation> {
    return check(isUlid(value), field, "ulid", value);
}

pub fn vIpv4(field: string, value: string) -> Array<Violation> {
    return check(isIpv4(value), field, "ipv4", value);
}

pub fn vIpv6(field: string, value: string) -> Array<Violation> {
    return check(isIpv6(value), field, "ipv6", value);
}

pub fn vMac(field: string, value: string) -> Array<Violation> {
    return check(isMac(value, ":"), field, "mac", value);

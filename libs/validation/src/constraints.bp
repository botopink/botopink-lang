// Hex, Zod's default encoding.
pub fn vHash(
    field: string,
    value: string,
    algorithm: string,
) -> Array<Violation> {
    return checkWith(
        isHash(value, algorithm, "hex"),
        field,
        "hash",
        value,
        [arg("algorithm", algorithm)],
    );

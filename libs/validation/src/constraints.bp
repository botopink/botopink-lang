// ── step 3: numbers ─────────────────────────────────────────────────────────
//
// One cell per width, like `minValue`. An `f64` bound is shown as the
// application wrote it (`bound`): the two targets render a whole `f64`
// differently (`2.0` on erlang, `2` on node), and a message must not.

pub fn vGtI32(field: string, value: i32, bound: i32) -> Array<Violation> {
    return checkWith(
        value > bound,
        field,
        "gt",
        showI32(value),
        [arg("bound", showI32(bound))],
    );
}

pub fn vGtI64(field: string, value: i64, bound: i64) -> Array<Violation> {
    return checkWith(
        value > bound,
        field,
        "gt",
        showI64(value),
        [arg("bound", showI64(bound))],
    );
}

pub fn vGtF64(
    field: string,
    value: f64,
    bound: f64,
    shown: string,
) -> Array<Violation> {
    return checkWith(
        value > bound,
        field,
        "gt",
        showF64(value),
        [arg("bound", shown)],
    );
}

pub fn vLtI32(field: string, value: i32, bound: i32) -> Array<Violation> {
    return checkWith(
        value < bound,
        field,
        "lt",
        showI32(value),
        [arg("bound", showI32(bound))],
    );
}

pub fn vLtI64(field: string, value: i64, bound: i64) -> Array<Violation> {
    return checkWith(
        value < bound,
        field,
        "lt",
        showI64(value),
        [arg("bound", showI64(bound))],
    );
}

pub fn vLtF64(
    field: string,
    value: f64,
    bound: f64,
    shown: string,
) -> Array<Violation> {
    return checkWith(
        value < bound,
        field,
        "lt",
        showF64(value),
        [arg("bound", shown)],
    );
}

pub fn vNegativeI32(field: string, value: i32) -> Array<Violation> {
    return check(value < 0, field, "negative", showI32(value));
}

pub fn vNegativeI64(field: string, value: i64) -> Array<Violation> {
    return check(value < 0, field, "negative", showI64(value));
}

pub fn vNegativeF64(field: string, value: f64) -> Array<Violation> {
    return check(value < 0.0, field, "negative", showF64(value));
}

pub fn vNegativeOrZeroI32(field: string, value: i32) -> Array<Violation> {
    return check(value <= 0, field, "negativeOrZero", showI32(value));
}

pub fn vNegativeOrZeroI64(field: string, value: i64) -> Array<Violation> {
    return check(value <= 0, field, "negativeOrZero", showI64(value));
}

pub fn vNegativeOrZeroF64(field: string, value: f64) -> Array<Violation> {
    return check(value <= 0.0, field, "negativeOrZero", showF64(value));
}

pub fn vMultipleOfI32(
    field: string,
    value: i32,
    step: i32,
) -> Array<Violation> {
    return checkWith(
        step > 0 && value % step == 0,
        field,
        "multipleOf",
        showI32(value),
        [arg("step", showI32(step))],
    );
}

pub fn vMultipleOfI64(
    field: string,
    value: i64,
    step: i64,
) -> Array<Violation> {
    return checkWith(
        step > 0 && value % step == 0,
        field,
        "multipleOf",
        showI64(value),
        [arg("step", showI64(step))],
    );
}

// Zod's scaled test: `value` and `step` are scaled by 10^decimals (the step's
// decimals as written, `decimals`), and the scaled value must be a whole
// multiple of the scaled step. The scaled numbers are compared through
// `math.round`, so `0.3` is a multiple of `0.1` though `0.3 / 0.1` is not 3.
pub fn vMultipleOfF64(
    field: string,
    value: f64,
    step: f64,
    decimals: i32,
    shown: string,
) -> Array<Violation> {
    var scale = 1.0;
    var i = 0;
    while (i < decimals) {
        scale = scale * 10.0;
        i = i + 1;
    }
    val v = value * scale;
    val s = math.round(step * scale);
    val whole = math.abs(v - math.round(v)) < 0.000001;
    val q = math.round(v) / s;
    val ok = s > 0.0 && whole && math.abs(q - math.round(q)) < 0.000000001;
    return checkWith(
        ok,
        field,
        "multipleOf",
        showF64(value),
        [arg("step", shown)],
    );
}

// Zod's `z.int()`: within ±(2^53 − 1), what a JSON number holds exactly.
pub fn vSafeInt(field: string, value: i64) -> Array<Violation> {
    return check(
        value <= 9007199254740991 && value >= -9007199254740991,
        field,
        "safeInt",
        showI64(value),
    );
}

// Zod's `z.float32()`: within ±3.4028234663852886e38, the largest finite
// single-precision value.
pub fn vFloat32(field: string, value: f64) -> Array<Violation> {
    return check(
        value <= 3.4028234663852886e38 && value >= -3.4028234663852886e38,
        field,
        "float32",
        showF64(value),
    );
}

// ── step 3: date bounds ─────────────────────────────────────────────────────
//
// Epoch milliseconds against an instant written as RFC 3339 text (offset
// required — `clock.parseIso8601`), strict as `#[pastDate]` / `#[futureDate]`
// are: the bound itself is neither after nor before. The decorator refuses a
// bound that is not such a text, so the parse here does not fail.

fn instant(text: string) -> i64 {
    val never: i64 = 0;
    return try clock.parseIso8601(text) catch never;
}

pub fn vAfterIso(field: string, value: i64, bound: string) -> Array<Violation> {
    return checkWith(
        value > instant(bound),
        field,
        "afterIso",
        showI64(value),
        [arg("instant", bound)],
    );
}

pub fn vBeforeIso(
    field: string,
    value: i64,
    bound: string,
) -> Array<Violation> {
    return checkWith(
        value < instant(bound),
        field,
        "beforeIso",
        showI64(value),
        [arg("instant", bound)],
    );
}

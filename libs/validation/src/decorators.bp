//// validation — `#[validated]` and the constraint markers. Moved from rakun
//// front 14's validation member (decision 116 rule 5).
////
//// `#[validated]` on a record-shaped `type` reflects `decl.fields`, reads each
//// field's constraint annotations from `f.annotations` — the way any
//// decorator reads a field's markers — and gives the type two members
//// (`decl.addMember`, decision 216), which travel with it to every importer:
////
////     pub fn validate(self: Self) -> ValidationReport      // req.validate()
////     pub fn constraints() -> string                       // T.constraints()
////
//// THE NAMES ARE A CONTRACT, NOT A CONVENTION. A configuration binder (rakun
//// front 05) depends on them: when a configuration record carries
//// `#[validated]`, the boot path calls `bound.validate()` after binding and
//// refuses to start if the report is not valid. It never has to know what
//// constraints exist; it only has to know the member's name. If either side
//// changes the spelling the other breaks at COMPILE time rather than at run
//// time — and a type that already has a `validate` or `constraints` member is
//// refused at the annotation (`decorator-member-duplicate`).
////
//// IMPORT `validated` FROM `"validation"`, NEVER A FRAMEWORK'S PLACEMENT-ONLY
//// `#[validated]`, AND NEVER BOTH. rakun's core carries a placement-only
//// marker of the same name (front 05): it checks that the marker sits on a
//// record-shaped `type` and EMITS NOTHING. An application that imports that one
//// instead of this one gets no `validate()` member, and the failure lands at
//// the CALL SITE as an unbound variable rather than at the annotation, which is
//// a long way from the cause. Importing both names into one module is a
//// duplicate binding.
////
//// WHAT THE MEMBERS NEED IN SCOPE. They are declared in the type's own module
//// (the APPLICATION site), so the application imports the names they reference (decision 107's
//// grammar — only the leaf is bound):
////
////     import {report.ValidationReport, report.Violation} from "validation";
////     import {constraints.vNotBlank, constraints.vSizeBetween, …} from "validation";
////     import {table.constraintTableJson, spi.vConstraint} from "validation";
////
//// `ValidationReport` and `Violation` are imported even where the application
//// never spells them: the erlang backend resolves a record method's owner
//// module only when the type is imported into the calling module, and without
//// it `report.isValid()` lowers to an unqualified `isValid/1`.
////
//// THE PER-MARKER RULE IS WRITTEN OUT INLINE in `validated`, and the table
//// grammar lives in `table.bp`, reached by the EMITTED code rather than by this
//// body. A decorator body does call a bodied function of its module
//// (`test/platform_test.bp`) — `#[schema]` at the end of this file is written
//// that way.
////
//// REFUSAL BEATS A CONSTRAINT THAT COULD NEVER FAIL. Decision 67. A marker on a
//// field whose type it cannot check is a located compile error, not a row that
//// quietly always passes: `#[notBlank]` on an `i32`, `#[minValue]` on a
//// `string`, `#[pastDate]` on an `i32`, `#[notNull]` on a field that can never
//// be null. That is the failure mode this module exists to design out, and it
//// is designed out at compile time.

import {formats.isIsoDatetimeOffset};

// ── `#[validated]` ──────────────────────────────────────────────────────────

pub fn validated(comptime decl: @Decl) {
    var calls: Array<string> = [];
    var rows: Array<string> = [];
    var problem = "";
    decl.fields.forEach({ f ->
        val names = f.annotations.map({ a -> a.name });
        f.annotations.forEach({ a ->
            val declared = f.typeName;
            val nullable = declared.startsWith("?");
            val t = if (nullable)
                declared.slice(1, declared.length())
            else
                declared;
            val base = "v." + f.name;
            val zero = optionalZero(t);
            val read = if (nullable) "(" + base + " ?? " + zero + ")" else base;
            val q = "\"" + f.name + "\"";
            val raw = a.args.join(", ");
            val bare = a.args.join("|").replaceAll("\"", "");
            val n = a.name;
            val isText = t == "string";
            val isList = t.startsWith("Array<") || t.endsWith("[]");
            var call = "";
            var why = "";
            if (n == "notNull")
                if (nullable)
                    call = "vNotNull(" + q + ", " + base + " != null)"
                else
                    why = "a field of type `"
                        + declared
                        + "` can never be null, so the constraint could never fail";
            if (n == "notBlank")
                if (isText)
                    call = "vNotBlank(" + q + ", " + read + ")"
                else
                    why = "it applies to `string`, and this field is `"
                        + declared
                        + "`";
            if (n == "notEmpty")
                if (isText)
                    call = "vNotEmpty(" + q + ", " + read + ")"
                else if (isList)
                    call = "vNotEmptyList(" + q + ", " + read + ")"
                else
                    why = "it applies to `string` and `Array<T>`, and this field is `"
                        + declared
                        + "`";
            if (n == "sizeBetween")
                if (isText)
                    call = "vSizeBetween(" + q + ", " + read + ", " + raw + ")"
                else if (isList)
                    call = "vSizeBetweenList("
                        + q
                        + ", "
                        + read
                        + ", "
                        + raw
                        + ")"
                else
                    why = "it applies to `string` and `Array<T>`, and this field is `"
                        + declared
                        + "`";
            if (n == "minValue")
                if (t == "i32")
                    call = "vMinValueI32(" + q + ", " + read + ", " + raw + ")"
                else if (t == "f64")
                    call = "vMinValueF64("
                        + q
                        + ", "
                        + read
                        + ", "
                        + asF64(raw)
                        + ")"
                else
                    why = "it applies to `i32` and `f64`, and this field is `"
                        + declared
                        + "` (an integer literal does not widen to `i64`, so an `i64` bound cannot be written)";
            if (n == "maxValue")
                if (t == "i32")
                    call = "vMaxValueI32(" + q + ", " + read + ", " + raw + ")"
                else if (t == "f64")
                    call = "vMaxValueF64("
                        + q
                        + ", "
                        + read
                        + ", "
                        + asF64(raw)
                        + ")"
                else
                    why = "it applies to `i32` and `f64`, and this field is `"
                        + declared
                        + "` (an integer literal does not widen to `i64`, so an `i64` bound cannot be written)";
            if (n == "positive")
                if (t == "i32")
                    call = "vPositiveI32(" + q + ", " + read + ")"
                else if (t == "i64")
                    call = "vPositiveI64(" + q + ", " + read + ")"
                else if (t == "f64")
                    call = "vPositiveF64(" + q + ", " + read + ")"
                else
                    why = "it applies to `i32`, `i64` and `f64`, and this field is `"
                        + declared
                        + "`";
            if (n == "positiveOrZero")
                if (t == "i32")
                    call = "vPositiveOrZeroI32(" + q + ", " + read + ")"
                else if (t == "i64")
                    call = "vPositiveOrZeroI64(" + q + ", " + read + ")"
                else if (t == "f64")
                    call = "vPositiveOrZeroF64(" + q + ", " + read + ")"
                else
                    why = "it applies to `i32`, `i64` and `f64`, and this field is `"
                        + declared
                        + "`";
            if (n == "email")
                if (isText)
                    call = "vEmail(" + q + ", " + read + ")"
                else
                    why = "it applies to `string`, and this field is `"
                        + declared
                        + "`";
            if (n == "pattern")
                if (isText)
                    call = "vPattern(" + q + ", " + read + ", " + raw + ")"
                else
                    why = "it applies to `string`, and this field is `"
                        + declared
                        + "`";
            if (n == "pastDate")
                if (t == "i64")
                    call = "vPastDate(" + q + ", " + read + ")"
                else
                    why = "it applies to epoch milliseconds, which is `i64`, and this field is `"
                        + declared
                        + "`";
            if (n == "futureDate")
                if (t == "i64")
                    call = "vFutureDate(" + q + ", " + read + ")"
                else
                    why = "it applies to epoch milliseconds, which is `i64`, and this field is `"
                        + declared
                        + "`";
            if (n == "constraint")
                if (isText)
                    call = "vConstraint(" + q + ", " + raw + ", " + read + ")"
                else
                    why = "a registered constraint reads a `string`, and this field is `"
                        + declared
                        + "`";
            if (call == "" && why == "") {
                val rule = markerRule(n, t, declared, q, read, a.args, names);
                if (rule.startsWith("!"))
                    why = rule.slice(1, rule.length())
                else
                    call = rule;
            }
            if (nullable && n != "notNull" && call != "" && zero == "") {
                why = "a marker on an optional field applies to `?string`, `?i32`, `?i64` and `?f64`, and this field is `"
                    + declared
                    + "`";
                call = "";
            }
            if (why != "")
                problem = "#["
                    + n
                    + "] on field `"
                    + f.name
                    + "` of `"
                    + decl.name
                    + "`: "
                    + why;
            val suffix = if (bare == "") "" else "|" + bare;
            val guard = if (nullable && n != "notNull")
                "if (" + base + " != null) "
            else
                "";
            if (call != "")
                calls.push(
                    "    " + guard + "__vs = __vs.append(" + call + ");",
                );
            if (call != "") rows.push(f.name + "|" + n + suffix);
        });
    });
    decl.addMember(
        "pub fn validate(self: Self) -> ValidationReport {\n    val v = self;\n    var __vs: Array<Violation> = [];\n"
            + calls.join("\n")
            + "\n    return ValidationReport(violations: __vs);\n}",
    );
    decl.addMember(
        "pub fn constraints() -> string { return constraintTableJson(\""
            + decl.name
            + "\", \""
            + rows.join(";")
            + "\"); }",
    );
    if (problem != "") decl.fail(problem);
    if (decl.kind != DeclKind.Type)
        decl.fail("#[validated] must annotate a type");
    if (decl.variants.length > 0)
        decl.fail("#[validated] must annotate a type with fields, not an enum");
}

// ── the constraint markers ──────────────────────────────────────────────────
//
// Thirteen near-identical bodies: placement, and — where the marker takes an
// argument — what the argument may say. The separator check is written out in
// each one. It does not have to be: a decorator body calls a bodied function of
// its module (`test/platform_test.bp`), which is how `#[schema]` below is
// written.
//
// `#[sizeBetween]` takes BOTH bounds. A decorator parameter's default is
// applied (`test/platform_test.bp`), so a one-bound spelling is expressible;
// the two-bound form is what `#[validated]` reads today and what the constraint
// table publishes.
//
// There is no `#[future]` in this module: the name reads as the `future`
// effect annotation that decision 118 removed (a `-> @Task<…>` return replaced it),
// and a marker that looks like a removed effect is a trap. The temporal markers
// are `#[pastDate]` and `#[futureDate]`.

pub fn notNull(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[notNull] must annotate a field");
}

pub fn notBlank(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[notBlank] must annotate a field");
}

pub fn notEmpty(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[notEmpty] must annotate a field");
}

pub fn sizeBetween(comptime decl: @Decl, min: i32, max: i32) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[sizeBetween] must annotate a field");
    if (min < 0)
        decl.fail("#[sizeBetween]: the lower bound may not be negative");
    if (min > max)
        decl.fail(
            "#[sizeBetween]: the lower bound is above the upper bound, so the constraint could never hold",
        );
}

pub fn minValue(comptime decl: @Decl, min: i32) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[minValue] must annotate a field");
}

pub fn maxValue(comptime decl: @Decl, max: i32) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[maxValue] must annotate a field");
}

pub fn positive(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[positive] must annotate a field");
}

pub fn positiveOrZero(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[positiveOrZero] must annotate a field");
}

pub fn email(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[email] must annotate a field");
}

// The regex reaches the constraint TABLE as well as the predicate, and the
// table's blob separates records with `;` and fields with `|`. A pattern
// carrying either would make the table unreadable, so it is refused here
// rather than escaped there — the grammar has no escape and needs none.
pub fn pattern(comptime decl: @Decl, regex: string) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[pattern] must annotate a field");
    if (regex == "") decl.fail("#[pattern]: the pattern may not be empty");
    if (regex.indexOf(";") >= 0 || regex.indexOf("|") >= 0)
        decl.fail(
            "#[pattern]: a pattern may not contain ';' or '|' - those are the constraint table's record and field separators",
        );
    if (regex.indexOf("\"") >= 0)
        decl.fail(
            "#[pattern]: a pattern may not contain a double quote - it is the argument's own delimiter in the reflected lexeme",
        );
}

pub fn pastDate(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[pastDate] must annotate a field");
}

pub fn futureDate(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[futureDate] must annotate a field");
}

// The name of a constraint registered through the SPI. Whether anything is
// registered under it is a RUN-TIME question — registration happens at module
// load, and a decorator body has no whole-program view — so an unregistered
// name is a violation at the first validation call, coded `unknownConstraint`,
// and never a pass.
pub fn constraint(comptime decl: @Decl, name: string) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[constraint] must annotate a field");
    if (name == "") decl.fail("#[constraint]: the name may not be empty");
    if (name.indexOf(";") >= 0 || name.indexOf("|") >= 0)
        decl.fail(
            "#[constraint]: a name may not contain ';' or '|' - those are the constraint table's record and field separators",
        );
    if (name.indexOf("\"") >= 0)
        decl.fail(
            "#[constraint]: a name may not contain a double quote - it is the argument's own delimiter in the reflected lexeme",
        );
}

// ── step 3: the rules of the checks and formats ─────────────────────────────
//
// `markerRule` answers the call `#[validated]` emits for one marker of front
// 125 step 3 on a field of type `t` (the `?` of an optional field already
// taken off — `declared` is the type as written), `"!" + why` when the marker
// cannot check that type, and `""` for a name that is none of these markers.
// The predicates are `constraints.bp`'s; the emitted call names them bare, as
// the thirteen markers above do.

// The value an optional field reads as when it is null — never checked, the
// emitted call is guarded by `!= null`; `""` for a type no marker reads
// through an optional.
fn optionalZero(t: string) -> string {
    if (t == "string") return "\"\"";
    if (t == "i32" || t == "i64") return "0";
    if (t == "f64") return "0.0";
    return "";
}

fn capitalized(n: string) -> string {
    return n.slice(0, 1).toUpper() + n.slice(1, n.length());
}

fn numberSuffix(t: string) -> string {
    if (t == "i32") return "I32";
    if (t == "i64") return "I64";
    if (t == "f64") return "F64";
    return "";
}

fn collectionSuffix(t: string) -> string {
    if (t == "string") return "";
    if ((t.startsWith("Array<") && t.endsWith(">")) || t.endsWith("[]"))
        return "List";
    if (t.startsWith("Dict<")) return "Dict";
    if (t.startsWith("Set<")) return "Set";
    return "?";
}

fn isFractionLexeme(l: string) -> bool {
    return l.indexOf(".") >= 0 || l.indexOf("e") >= 0 || l.indexOf("E") >= 0;
}

// A numeric lexeme as an `f64` literal: `5` is `5.0`; `0.5` and `1e3` stay.
fn asF64(l: string) -> string {
    if (isFractionLexeme(l)) return l;
    return l + ".0";
}

// The digits after the point of a decimal lexeme (`0.05` → 2).
fn decimalsOf(l: string) -> i32 {
    val ps = l.split(".");
    if (ps.length < 2) return 0;
    return ps.slice(1, 2).join("").length();
}

fn quoted(l: string) -> string {
    return "\"" + l + "\"";
}

fn plainTextMarkers() -> string {
    return "|uppercase|lowercase|emailHtml5|emailRfc5322|emailUnicode|uuid|guid|url|httpUrl|hostname|e164|emoji|base64|base64url|hex|jwt|nanoid|cuid|cuid2|ulid|ipv4|ipv6|mac|cidrv4|cidrv6|creditCard|currencyCode|iban|isoDate|isoTime|isoDatetime|isoDatetimeOffset|isoDatetimeLocal|isoDuration|";
}

fn argTextMarkers() -> string {
    return "|startsWith|endsWith|includes|uuidV|urlHost|urlProtocol|jwtAlg|macDelimiter|hash|hashEnc|isoTimePrecision|isoDatetimePrecision|";
}

fn listed(set: string, n: string) -> bool {
    return set.indexOf("|" + n + "|") >= 0;
}

fn predicateOf(n: string) -> string {
    if (n == "base64url") return "vBase64Url";
    return "v" + capitalized(n);
}

fn refusedOn(applies: string, declared: string) -> string {
    return "!it applies to "
        + applies
        + ", and this field is `"
        + declared
        + "`";
}

fn markerRule(
    n: string,
    t: string,
    declared: string,
    q: string,
    read: string,
    args: Array<string>,
    names: Array<string>,
) -> string {
    val raw = args.join(", ");
    val first = args.slice(0, 1).join("");
    if (listed(plainTextMarkers(), n)) {
        if (t != "string") return refusedOn("`string`", declared);
        return predicateOf(n) + "(" + q + ", " + read + ")";
    }
    if (listed(argTextMarkers(), n)) {
        if (t != "string") return refusedOn("`string`", declared);
        if (n == "isoDatetimePrecision") {
            val shapes = names.filter({ m ->
                m == "isoDatetime"
                    || m == "isoDatetimeOffset"
                    || m == "isoDatetimeLocal";
            });
            if (shapes.length == 0)
                return "!it fixes the precision only - add #[isoDatetime], #[isoDatetimeOffset] or #[isoDatetimeLocal] to say which zones the field takes";
        }
        return predicateOf(n) + "(" + q + ", " + read + ", " + raw + ")";
    }
    if (n == "minLength" || n == "maxLength" || n == "length") {
        val kind = collectionSuffix(t);
        if (kind == "?")
            return refusedOn(
                "`string`, `Array<T>`, `Dict<K, V>` and `Set<T>`",
                declared,
            );
        return predicateOf(n) + kind + "(" + q + ", " + read + ", " + raw + ")";
    }
    if (n == "gt" || n == "lt" || n == "multipleOf") {
        val width = numberSuffix(t);
        if (width == "") return refusedOn("`i32`, `i64` and `f64`", declared);
        if (width != "F64" && isFractionLexeme(first))
            return "!the bound `"
                + first
                + "` is not a whole number, and this field is `"
                + declared
                + "`";
        if (width != "F64")
            return predicateOf(n)
                + width
                + "("
                + q
                + ", "
                + read
                + ", "
                + first
                + ")";
        if (n == "multipleOf") {
            if (first.indexOf("e") >= 0 || first.indexOf("E") >= 0)
                return "!write the step as a decimal (`0.001`), not with an exponent";
            return "vMultipleOfF64("
                + q
                + ", "
                + read
                + ", "
                + asF64(first)
                + ", "
                + [decimalsOf(first)].join("")
                + ", "
                + quoted(first)
                + ")";
        }
        return predicateOf(n)
            + width
            + "("
            + q
            + ", "
            + read
            + ", "
            + asF64(first)
            + ", "
            + quoted(first)
            + ")";
    }
    if (n == "negative" || n == "negativeOrZero") {
        val width = numberSuffix(t);
        if (width == "") return refusedOn("`i32`, `i64` and `f64`", declared);
        return predicateOf(n) + width + "(" + q + ", " + read + ")";
    }
    if (n == "safeInt") {
        if (t != "i64") return refusedOn("`i64`", declared);
        return "vSafeInt(" + q + ", " + read + ")";
    }
    if (n == "float32") {
        if (t != "f64") return refusedOn("`f64`", declared);
        return "vFloat32(" + q + ", " + read + ")";
    }
    if (n == "afterIso" || n == "beforeIso") {
        if (t != "i64")
            return refusedOn("epoch milliseconds, which is `i64`", declared);
        return predicateOf(n) + "(" + q + ", " + read + ", " + raw + ")";
    }
    return "";
}

// ── step 3: the markers ─────────────────────────────────────────────────────
//
// Placement, and what each argument may say. A text argument reaches the
// constraint table, whose blob separates records with `;` and fields with `|`,
// and the reflected lexeme, delimited by `"`: none of the three may appear in
// it (`textArgProblem`). A bound that makes the check one that could never
// fail is refused (decision 67).

fn textArgProblem(marker: string, what: string, text: string) -> string {
    if (text == "")
        return "#[" + marker + "]: the " + what + " may not be empty";
    if (text.indexOf(";") >= 0 || text.indexOf("|") >= 0)
        return "#["
            + marker
            + "]: the "
            + what
            + " may not contain ';' or '|' - those are the constraint table's record and field separators";
    if (text.indexOf("\"") >= 0)
        return "#["
            + marker
            + "]: the "
            + what
            + " may not contain a double quote - it is the argument's own delimiter in the reflected lexeme";
    return "";
}

pub fn minLength(comptime decl: @Decl, comptime min: i32) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[minLength] must annotate a field");
    if (min < 1)
        decl.fail(
            "#[minLength]: a lower bound below 1 could never fail - write a bound of 1 or more",
        );
}

pub fn maxLength(comptime decl: @Decl, comptime max: i32) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[maxLength] must annotate a field");
    if (max < 0) decl.fail("#[maxLength]: the upper bound may not be negative");
}

pub fn length(comptime decl: @Decl, comptime length: i32) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[length] must annotate a field");
    if (length < 0) decl.fail("#[length]: the length may not be negative");
}

pub fn startsWith(comptime decl: @Decl, comptime prefix: string) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[startsWith] must annotate a field");
    val problem = textArgProblem("startsWith", "prefix", prefix);
    if (problem != "") decl.fail(problem);
}

pub fn endsWith(comptime decl: @Decl, comptime suffix: string) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[endsWith] must annotate a field");
    val problem = textArgProblem("endsWith", "suffix", suffix);
    if (problem != "") decl.fail(problem);
}

pub fn includes(comptime decl: @Decl, comptime substring: string) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[includes] must annotate a field");
    val problem = textArgProblem("includes", "substring", substring);
    if (problem != "") decl.fail(problem);
}

pub fn uppercase(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[uppercase] must annotate a field");
}

pub fn lowercase(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[lowercase] must annotate a field");
}

pub fn emailHtml5(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[emailHtml5] must annotate a field");
}

pub fn emailRfc5322(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[emailRfc5322] must annotate a field");
}

pub fn emailUnicode(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[emailUnicode] must annotate a field");
}

pub fn uuid(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field) decl.fail("#[uuid] must annotate a field");
}


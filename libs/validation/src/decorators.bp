// -1 is `HH:MM`, 0 whole seconds, n that many fraction digits (to 9).
pub fn isoTimePrecision(comptime decl: @Decl, comptime precision: i32) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[isoTimePrecision] must annotate a field");
    if (precision < 0 - 1 || precision > 9)
        decl.fail(
            "#[isoTimePrecision]: the precision is -1 (minutes), 0 (seconds) or 1 to 9 fraction digits",
        );
}


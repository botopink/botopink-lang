fn isHashAlgorithm(a: string) -> bool {
    return a == "md5"
        || a == "sha1"
        || a == "sha256"
        || a == "sha384"
        || a == "sha512";
}

pub fn hash(comptime decl: @Decl, comptime algorithm: string) {
    if (decl.kind != DeclKind.Field) decl.fail("#[hash] must annotate a field");
    if (isHashAlgorithm(algorithm) == false)
        decl.fail(
            "#[hash]: the algorithm is one of md5, sha1, sha256, sha384, sha512",
        );
}

pub fn hashEnc(
    comptime decl: @Decl,
    comptime algorithm: string,
    comptime encoding: string,
) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[hashEnc] must annotate a field");
    if (isHashAlgorithm(algorithm) == false)
        decl.fail(
            "#[hashEnc]: the algorithm is one of md5, sha1, sha256, sha384, sha512",
        );
    if (encoding != "hex" && encoding != "base64" && encoding != "base64url")
        decl.fail("#[hashEnc]: the encoding is one of hex, base64, base64url");
}


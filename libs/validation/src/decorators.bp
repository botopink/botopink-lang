// One character that is not a hex digit — a delimiter that were one would
// make `00` ambiguous with its neighbours.
pub fn macDelimiter(comptime decl: @Decl, comptime delimiter: string) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[macDelimiter] must annotate a field");
    val problem = textArgProblem("macDelimiter", "delimiter", delimiter);
    if (problem != "") decl.fail(problem);
    if (delimiter.length() != 1
        || "0123456789abcdefABCDEF".indexOf(delimiter) >= 0)
        decl.fail(
            "#[macDelimiter]: the delimiter is one character that is not a hex digit",
        );
}


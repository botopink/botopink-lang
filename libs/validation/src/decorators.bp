//// validation — `#[validated]` and the constraint markers. Moved from rakun
//// front 14's validation member (decision 116 rule 5).
////
//// `#[validated]` on a record-shaped `type` reflects `decl.fields`, reads each
//// field's constraint annotations from `f.annotations` — the way any
//// decorator reads a field's markers — and `@emit`s two module-level functions with deterministic names:
////
////     pub fn validate<TypeName>(v: <TypeName>) -> ValidationReport
////     pub fn constraintsOf<TypeName>() -> string
////
//// THE NAMES ARE A CONTRACT, NOT A CONVENTION. A configuration binder (rakun
//// front 05) depends on them: when a configuration record carries
//// `#[validated]`, the boot path calls `validate<TypeName>(bound)` after
//// binding and refuses to start if the report is not valid. It never has to
//// know what constraints exist; it only has to know the function's name, which
//// it builds from the type name it already has. If either side changes the
//// spelling the other breaks at COMPILE time rather than at run time.
////
//// IMPORT `validated` FROM `"validation"`, NEVER A FRAMEWORK'S PLACEMENT-ONLY
//// `#[validated]`, AND NEVER BOTH. rakun's core carries a placement-only
//// marker of the same name (front 05): it checks that the marker sits on a
//// record-shaped `type` and EMITS NOTHING. An application that imports that one
//// instead of this one gets no `validate<TypeName>`, and the failure lands at
//// the CALL SITE as an unbound variable rather than at the annotation, which is
//// a long way from the cause. Importing both names into one module is a
//// duplicate binding.
////
//// WHAT THE EMITTED CODE NEEDS IN SCOPE. The emission runs at the APPLICATION
//// site, so the application imports the names it references (decision 107's
//// grammar — only the leaf is bound):
////
////     import {report.ValidationReport, report.Violation} from "validation";
////     import {constraints.vNotBlank, constraints.vSizeBetween, …} from "validation";
////     import {table.constraintTableJson, spi.vConstraint} from "validation";
////
//// `ValidationReport` and `Violation` are imported even where the application
//// never spells them: the erlang backend resolves a record method's owner
//// module only when the type is imported into the calling module, and without
//// it `report.isValid()` lowers to an unqualified `isValid/1`.
////
//// THE PER-MARKER RULE IS WRITTEN OUT INLINE in `validated`, and the table
//// grammar lives in `table.bp`, reached by the EMITTED code rather than by this
//// body. A decorator body does call a bodied function of its module
//// (`test/platform_test.bp`) — `#[schema]` at the end of this file is written
//// that way.
////
//// REFUSAL BEATS A CONSTRAINT THAT COULD NEVER FAIL. Decision 67. A marker on a
//// field whose type it cannot check is a located compile error, not a row that
//// quietly always passes: `#[notBlank]` on an `i32`, `#[minValue]` on a
//// `string`, `#[pastDate]` on an `i32`, `#[notNull]` on a field that can never
//// be null. That is the failure mode this module exists to design out, and it
//// is designed out at compile time.

// ── `#[validated]` ──────────────────────────────────────────────────────────

pub fn validated(comptime decl: @Decl) {
    var calls: Array<string> = [];
    var rows: Array<string> = [];
    var problem = "";
    decl.fields.forEach({ f ->
        f.annotations.forEach({ a ->
            val t = f.typeName;
            val read = "v." + f.name;
            val q = "\"" + f.name + "\"";
            val raw = a.args.join(", ");
            val bare = a.args.join("|").replaceAll("\"", "");
            val n = a.name;
            val isText = t == "string";
            val isList = t.startsWith("Array<") || t.endsWith("[]");
            val nullable = t.startsWith("?");
            var call = "";
            var why = "";
            if (n == "notNull")
                if (nullable)
                    call = "vNotNull(" + q + ", " + read + " != null)"
                else
                    why = "a field of type `"
                        + t
                        + "` can never be null, so the constraint could never fail";
            if (n == "notBlank")
                if (isText)
                    call = "vNotBlank(" + q + ", " + read + ")"
                else
                    why = "it applies to `string`, and this field is `"
                        + t
                        + "`";
            if (n == "notEmpty")
                if (isText)
                    call = "vNotEmpty(" + q + ", " + read + ")"
                else if (isList)
                    call = "vNotEmptyList(" + q + ", " + read + ")"
                else
                    why = "it applies to `string` and `Array<T>`, and this field is `"
                        + t
                        + "`";
            if (n == "sizeBetween")
                if (isText)
                    call = "vSizeBetween(" + q + ", " + read + ", " + raw + ")"
                else if (isList)
                    call = "vSizeBetweenList("
                        + q
                        + ", "
                        + read
                        + ", "
                        + raw
                        + ")"
                else
                    why = "it applies to `string` and `Array<T>`, and this field is `"
                        + t
                        + "`";
            if (n == "minValue")
                if (t == "i32")
                    call = "vMinValueI32(" + q + ", " + read + ", " + raw + ")"
                else if (t == "f64")
                    call = "vMinValueF64(" + q + ", " + read + ", " + raw + ")"
                else
                    why = "it applies to `i32` and `f64`, and this field is `"
                        + t
                        + "` (an integer literal does not widen to `i64`, so an `i64` bound cannot be written)";
            if (n == "maxValue")
                if (t == "i32")
                    call = "vMaxValueI32(" + q + ", " + read + ", " + raw + ")"
                else if (t == "f64")
                    call = "vMaxValueF64(" + q + ", " + read + ", " + raw + ")"
                else
                    why = "it applies to `i32` and `f64`, and this field is `"
                        + t
                        + "` (an integer literal does not widen to `i64`, so an `i64` bound cannot be written)";
            if (n == "positive")
                if (t == "i32")
                    call = "vPositiveI32(" + q + ", " + read + ")"
                else if (t == "i64")
                    call = "vPositiveI64(" + q + ", " + read + ")"
                else if (t == "f64")
                    call = "vPositiveF64(" + q + ", " + read + ")"
                else
                    why = "it applies to `i32`, `i64` and `f64`, and this field is `"
                        + t
                        + "`";
            if (n == "positiveOrZero")
                if (t == "i32")
                    call = "vPositiveOrZeroI32(" + q + ", " + read + ")"
                else if (t == "i64")
                    call = "vPositiveOrZeroI64(" + q + ", " + read + ")"
                else if (t == "f64")
                    call = "vPositiveOrZeroF64(" + q + ", " + read + ")"
                else
                    why = "it applies to `i32`, `i64` and `f64`, and this field is `"
                        + t
                        + "`";
            if (n == "email")
                if (isText)
                    call = "vEmail(" + q + ", " + read + ")"
                else
                    why = "it applies to `string`, and this field is `"
                        + t
                        + "`";
            if (n == "pattern")
                if (isText)
                    call = "vPattern(" + q + ", " + read + ", " + raw + ")"
                else
                    why = "it applies to `string`, and this field is `"
                        + t
                        + "`";
            if (n == "pastDate")
                if (t == "i64")
                    call = "vPastDate(" + q + ", " + read + ")"
                else
                    why = "it applies to epoch milliseconds, which is `i64`, and this field is `"
                        + t
                        + "`";
            if (n == "futureDate")
                if (t == "i64")
                    call = "vFutureDate(" + q + ", " + read + ")"
                else
                    why = "it applies to epoch milliseconds, which is `i64`, and this field is `"
                        + t
                        + "`";
            if (n == "constraint")
                if (isText)
                    call = "vConstraint(" + q + ", " + raw + ", " + read + ")"
                else
                    why = "a registered constraint reads a `string`, and this field is `"
                        + t
                        + "`";
            if (why != "")
                problem = "#["
                    + n
                    + "] on field `"
                    + f.name
                    + "` of `"
                    + decl.name
                    + "`: "
                    + why;
            val suffix = if (bare == "") "" else "|" + bare;
            if (call != "") calls.push("    __vs = __vs.append(" + call + ");");
            if (call != "") rows.push(f.name + "|" + n + suffix);
        });
    });
    @emit(
        "pub fn validate"
            + decl.name
            + "(v: "
            + decl.name
            + ") -> ValidationReport {\n    var __vs: Array<Violation> = [];\n"
            + calls.join("\n")
            + "\n    return ValidationReport(violations: __vs);\n}",
    );
    @emit(
        "pub fn constraintsOf"
            + decl.name
            + "() -> string { return constraintTableJson(\""
            + decl.name
            + "\", \""
            + rows.join(";")
            + "\"); }",
    );
    if (problem != "") decl.fail(problem);
    if (decl.kind != DeclKind.Type)
        decl.fail("#[validated] must annotate a type");
    if (decl.variants.length > 0)
        decl.fail("#[validated] must annotate a type with fields, not an enum");
}

// ── the constraint markers ──────────────────────────────────────────────────
//
// Thirteen near-identical bodies: placement, and — where the marker takes an
// argument — what the argument may say. The separator check is written out in
// each one. It does not have to be: a decorator body calls a bodied function of
// its module (`test/platform_test.bp`), which is how `#[schema]` below is
// written.
//
// `#[sizeBetween]` takes BOTH bounds. A decorator parameter's default is
// applied (`test/platform_test.bp`), so a one-bound spelling is expressible;
// the two-bound form is what `#[validated]` reads today and what the constraint
// table publishes.
//
// There is no `#[future]` in this module: the name reads as the `future`
// effect annotation that decision 118 removed (a `-> @Task<…>` return replaced it),
// and a marker that looks like a removed effect is a trap. The temporal markers
// are `#[pastDate]` and `#[futureDate]`.

pub fn notNull(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[notNull] must annotate a field");
}

pub fn notBlank(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[notBlank] must annotate a field");
}

pub fn notEmpty(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[notEmpty] must annotate a field");
}

pub fn sizeBetween(comptime decl: @Decl, min: i32, max: i32) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[sizeBetween] must annotate a field");
    if (min < 0)
        decl.fail("#[sizeBetween]: the lower bound may not be negative");
    if (min > max)
        decl.fail(
            "#[sizeBetween]: the lower bound is above the upper bound, so the constraint could never hold",
        );
}

pub fn minValue(comptime decl: @Decl, min: i32) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[minValue] must annotate a field");
}

pub fn maxValue(comptime decl: @Decl, max: i32) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[maxValue] must annotate a field");
}

pub fn positive(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[positive] must annotate a field");
}

pub fn positiveOrZero(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[positiveOrZero] must annotate a field");
}

pub fn email(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[email] must annotate a field");
}

// The regex reaches the constraint TABLE as well as the predicate, and the
// table's blob separates records with `;` and fields with `|`. A pattern
// carrying either would make the table unreadable, so it is refused here
// rather than escaped there — the grammar has no escape and needs none.
pub fn pattern(comptime decl: @Decl, regex: string) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[pattern] must annotate a field");
    if (regex == "") decl.fail("#[pattern]: the pattern may not be empty");
    if (regex.indexOf(";") >= 0 || regex.indexOf("|") >= 0)
        decl.fail(
            "#[pattern]: a pattern may not contain ';' or '|' - those are the constraint table's record and field separators",
        );
    if (regex.indexOf("\"") >= 0)
        decl.fail(
            "#[pattern]: a pattern may not contain a double quote - it is the argument's own delimiter in the reflected lexeme",
        );
}

pub fn pastDate(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[pastDate] must annotate a field");
}

pub fn futureDate(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[futureDate] must annotate a field");
}

// The name of a constraint registered through the SPI. Whether anything is
// registered under it is a RUN-TIME question — registration happens at module
// load, and a decorator body has no whole-program view — so an unregistered
// name is a violation at the first validation call, coded `unknownConstraint`,
// and never a pass.
pub fn constraint(comptime decl: @Decl, name: string) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[constraint] must annotate a field");
    if (name == "") decl.fail("#[constraint]: the name may not be empty");
    if (name.indexOf(";") >= 0 || name.indexOf("|") >= 0)
        decl.fail(
            "#[constraint]: a name may not contain ';' or '|' - those are the constraint table's record and field separators",
        );
    if (name.indexOf("\"") >= 0)
        decl.fail(
            "#[constraint]: a name may not contain a double quote - it is the argument's own delimiter in the reflected lexeme",
        );
}

// ── `#[schema]` ─────────────────────────────────────────────────────────────
//
// `#[schema]` on a record-shaped `type` emits its decoder — the function from a
// `Json` document to the record that `validate<TypeName>` cannot be, because it
// takes a record that already exists:
//
//     pub fn parse<TypeName>At(input: Json, at: string) -> @Result<TypeName, ValidationReport>
//     pub fn parse<TypeName>(input: Json) -> @Result<TypeName, ValidationReport>
//     pub fn decode<TypeName>(text: string) -> @Result<TypeName, ValidationReport>
//     pub fn schemaOf<TypeName>() -> Schema<TypeName>
//
// THE NAMES ARE A CONTRACT, as `validate<TypeName>`'s are: a field whose type
// is another `#[schema]` record is decoded by calling `parse<ThatType>At`, by
// name — a decorator sees one declaration, and never needs a second.
//
// THE DECODER IS STRAIGHT-LINE CODE: one statement per field, every field
// decoded, every violation collected, the record constructed only when there
// are none. An undeclared key is a violation (`unrecognizedKey`).
//
// THE CHECKS ARE `#[validated]`'s. A type that carries constraint markers is
// also `#[validated]`, and the emitted decoder calls `validate<TypeName>` on the
// record it built — the marker table lives in one decorator. A marker on a
// `#[schema]` type that is not `#[validated]` is refused: a check nothing runs
// is the failure this module exists to design out.
//
// WHAT THE EMITTED CODE NEEDS IN SCOPE. The library is named through ONE
// namespace, and the three types the signatures spell are leaves (a type cannot
// be named through a namespace):
//
//     import {schemas, schemas.Schema, report.ValidationReport, report.Violation} from "validation";
//     import {json.Json} from "std";

fn schemaIsList(t: string) -> bool {
    return (t.startsWith("Array<") && t.endsWith(">")) || t.endsWith("[]");
}

fn schemaItemOf(t: string) -> string {
    if (t.endsWith("[]")) return t.slice(0, t.length() - 2);
    return t.slice(6, t.length() - 1);
}

fn schemaIsName(t: string) -> bool {
    if (t == "") return false;
    val allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_";
    val head = t.slice(0, 1);
    val startsUpper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".indexOf(head) >= 0;
    val strange = t.split("").filter({ c -> allowed.indexOf(c) < 0 }).length;
    return startsUpper && strange == 0;
}

fn schemaIsBuiltin(t: string) -> bool {
    return t == "string"
        || t == "i32"
        || t == "i64"
        || t == "f64"
        || t == "bool"
        || t == "Json";
}

// The type one wrapper holds: `T` of `?T`, the item of a list; `""` when `t`
// is not a wrapper.
fn schemaInner(t: string) -> string {
    if (t.startsWith("?")) return t.slice(1, t.length());
    if (schemaIsList(t)) return schemaItemOf(t);
    return "";
}

fn schemaSupported(t: string) -> bool {
    if (schemaIsBuiltin(t)) return true;
    val inner = schemaInner(t);
    if (inner != "") return schemaSupported(inner);
    return schemaIsName(t);
}

// A DECODER HANDED TO A COMBINATOR IS A FUNCTION OF THE APPLICATION'S MODULE.
// `schemas.optionalOf` and `schemas.decodeArrayOf` take the inner decoder as a
// value, and a library function cannot be that value from emitted code: a
// namespace member is resolved where it is CALLED, not where it is passed
// (`schemas.decodeString` as an argument is "unbound variable 'schemas'"). A
// lambda that calls it works in a consumer and not in a module of this package,
// where the namespace is the bare `import {schemas};` (`schemas is not defined`
// on node, `decodeString/3 undefined` on erlang) - and this library's own tests
// are such modules. So each wrapper level below the field's own gets one
// emitted function, named after the record, the field and the depth, whose body
// is the call: a plain function of the module the record is declared in.
fn schemaHelperName(owner: string, field: string, depth: i32) -> string {
    return "__decode" + owner + "_" + field + "_" + [depth].join("");
}

fn schemaRef(t: string, owner: string, field: string, depth: i32) -> string {
    if (schemaIsName(t) && schemaIsBuiltin(t) == false)
        return "parse" + t + "At";
    return schemaHelperName(owner, field, depth);
}

// The expression that decodes a value of type `t` read from `source` at `path`.
fn schemaCall(
    t: string,
    source: string,
    path: string,
    owner: string,
    field: string,
    depth: i32,
) -> string {
    val tail = "(" + source + ", " + path;
    if (t == "string") return "schemas.decodeString" + tail + ")";
    if (t == "i32") return "schemas.decodeInt" + tail + ")";
    if (t == "i64") return "schemas.decodeLong" + tail + ")";
    if (t == "f64") return "schemas.decodeFloat" + tail + ")";
    if (t == "bool") return "schemas.decodeBool" + tail + ")";
    if (t == "Json") return "schemas.decodeJson" + tail + ")";
    val inner = schemaInner(t);
    if (inner == "") return "parse" + t + "At" + tail + ")";
    val ref = schemaRef(inner, owner, field, depth + 1);
    if (t.startsWith("?"))
        return "schemas.optionalOf" + tail + ", " + ref + ")";
    return "schemas.decodeArrayOf" + tail + ", " + ref + ")";
}

// The emitted functions the wrapper levels of one field need, outermost first;
// `""` for a field with no wrapper around a builtin or another wrapper.
fn schemaHelpers(
    t: string,
    owner: string,
    field: string,
    depth: i32,
) -> string {
    val inner = schemaInner(t);
    if (inner == "") return "";
    if (schemaIsName(inner) && schemaIsBuiltin(inner) == false) return "";
    return "fn "
        + schemaHelperName(owner, field, depth + 1)
        + "(input: Json, at: string) -> @Result<"
        + inner
        + ", ValidationReport> {\n    return try "
        + schemaCall(inner, "input", "at", owner, field, depth + 1)
        + ";\n}\n"
        + schemaHelpers(inner, owner, field, depth + 1);
}

fn schemaIsMarker(name: string) -> bool {
    val markers = "|notNull|notBlank|notEmpty|sizeBetween|minValue|maxValue|positive|positiveOrZero|email|pattern|pastDate|futureDate|constraint|";
    return markers.indexOf("|" + name + "|") >= 0;
}

pub fn schema(comptime decl: @Decl) {
    var decoders: Array<string> = [];
    var gathers: Array<string> = [];
    var args: Array<string> = [];
    var known: Array<string> = [];
    var helpers: Array<string> = [];
    var problem = "";
    var marked = false;
    decl.fields.forEach({ f ->
        val source = "schemas.fieldOf(input, \"" + f.name + "\")";
        val path = "schemas.memberPath(at, \"" + f.name + "\")";
        val supported = schemaSupported(f.typeName);
        val call = if (supported)
            schemaCall(f.typeName, source, path, decl.name, f.name, 0)
        else
            "0";
        if (supported)
            helpers.push(schemaHelpers(f.typeName, decl.name, f.name, 0));
        if (supported == false)
            problem = "#[schema] on `"
                + decl.name
                + "`: field `"
                + f.name
                + "` is `"
                + f.typeName
                + "`, which this decorator does not decode - it reads string, i32, i64, f64, bool, Json, ?T, Array<T> and other #[schema] records";
        f.annotations.forEach({ a ->
            if (schemaIsMarker(a.name)) marked = true;
        });
        decoders.push("    val __r_" + f.name + " = " + call + ";");
        gathers.push(
            "    __vs = __vs.append(schemas.violationsOf(__r_" + f.name + "));",
        );
        args.push(f.name + ": try __r_" + f.name);
        known.push("\"" + f.name + "\"");
    });
    val helperText = helpers.join("");
    if (helperText != "") @emit(helperText);
    val validated = decl.annotations.filter(
        { a -> a.name == "validated" },
    ).length
        > 0;
    val checks = if (validated)
        "    val __checked = schemas.under(at, validate"
            + decl.name
            + "(__v));\n    if (__checked.violations.length > 0) { throw __checked; }\n"
    else
        "";
    @emit(
        "pub fn parse"
            + decl.name
            + "At(input: Json, at: string) -> @Result<"
            + decl.name
            + ", ValidationReport> {\n"
            + "    val __shape = schemas.objectProblems(input, at);\n"
            + "    if (__shape.length > 0) { throw ValidationReport(violations: __shape); }\n"
            + decoders.join("\n")
            + "\n    var __vs: Array<Violation> = [];\n"
            + gathers.join("\n")
            + "\n    __vs = __vs.append(schemas.unknownKeys(input, ["
            + known.join(", ")
            + "], at, \""
            + decl.name
            + "\"));\n"
            + "    if (__vs.length > 0) { throw ValidationReport(violations: __vs); }\n"
            + "    val __v = "
            + decl.name
            + "("
            + args.join(", ")
            + ");\n"
            + checks
            + "    return __v;\n}",
    );
    @emit(
        "pub fn parse"
            + decl.name
            + "(input: Json) -> @Result<"
            + decl.name
            + ", ValidationReport> {\n    return try parse"
            + decl.name
            + "At(input, \"\");\n}",
    );
    @emit(
        "pub fn decode"
            + decl.name
            + "(text: string) -> @Result<"
            + decl.name
            + ", ValidationReport> {\n    return try schemas.decodeText(text, parse"
            + decl.name
            + "At);\n}",
    );
    @emit(
        "pub fn schemaOf"
            + decl.name
            + "() -> Schema<"
            + decl.name
            + "> {\n    return schemas.of(parse"
            + decl.name
            + "At);\n}",
    );
    if (problem != "") decl.fail(problem);
    if (marked && validated == false)
        decl.fail(
            "#[schema] on `"
                + decl.name
                + "`: its fields carry constraint markers and the type is not #[validated], so nothing would run them - add #[validated]",
        );
    if (decl.kind != DeclKind.Type) decl.fail("#[schema] must annotate a type");
    if (decl.variants.length > 0)
        decl.fail("#[schema] must annotate a type with fields, not an enum");
}

//// validation — the boundary test, and the reason this front has the
//// shape it has.
////
//// ONE test, not two. The twenty inputs below run through the SAME function on
//// erlang and on commonJS and are compared against ONE expected digest, so a
//// row that answered differently reds here rather than passing its own half of
//// a two-test pair. "The reports it compares are equal, not merely both
//// non-empty" is the acceptance, and a byte-for-byte digest is the only form of
//// that claim that cannot be satisfied by accident.
////
//// The digest carries, per input: the field, the code and the RESOLVED MESSAGE
//// of every violation, in order. So it covers the predicates, the ordering, the
//// built-in templates and the interpolation in one string. The template
//// overrides are cleared first: the digest is about the two rows agreeing, not
//// about whichever property table a sibling test left behind.
////
//// A commonJS-only regression here is a release blocker, not a known red — the
//// two halves agreeing IS the deliverable.

import {decorators.validated, decorators.notBlank, decorators.notEmpty, decorators.sizeBetween, decorators.email, decorators.minValue, decorators.maxValue, decorators.pattern, decorators.positive};
import {report.ValidationReport, report.Violation};
import {table.constraintTableJson};
import {constraints.vNotBlank, constraints.vNotEmpty, constraints.vSizeBetween, constraints.vEmail, constraints.vMinValueI32, constraints.vMaxValueI32, constraints.vPattern, constraints.vPositiveI32};
import {spi.vConstraint};
import {constraints.vMinLength, constraints.vMaxLength, constraints.vLength, constraints.vStartsWith, constraints.vEndsWith, constraints.vIncludes, constraints.vUppercase, constraints.vLowercase, constraints.vEmailHtml5, constraints.vEmailRfc5322, constraints.vEmailUnicode, constraints.vUuid, constraints.vUuidV, constraints.vGuid, constraints.vUrl, constraints.vUrlHost, constraints.vUrlProtocol, constraints.vHttpUrl, constraints.vHostname, constraints.vE164, constraints.vEmoji, constraints.vBase64, constraints.vBase64Url, constraints.vHex, constraints.vJwt, constraints.vJwtAlg, constraints.vNanoid, constraints.vCuid, constraints.vCuid2, constraints.vUlid, constraints.vIpv4, constraints.vIpv6, constraints.vMac, constraints.vMacDelimiter, constraints.vCidrv4, constraints.vCidrv6, constraints.vCreditCard, constraints.vCurrencyCode, constraints.vIban, constraints.vHash, constraints.vHashEnc, constraints.vIsoDate, constraints.vIsoTime, constraints.vIsoTimePrecision, constraints.vIsoDatetime, constraints.vIsoDatetimeOffset, constraints.vIsoDatetimeLocal, constraints.vIsoDatetimePrecision, constraints.vIsoDuration, constraints.vGtI32, constraints.vGtF64, constraints.vLtI32, constraints.vLtF64, constraints.vNegativeI32, constraints.vNegativeF64, constraints.vNegativeOrZeroI32, constraints.vMultipleOfI32, constraints.vMultipleOfF64, constraints.vSafeInt, constraints.vFloat32, constraints.vAfterIso, constraints.vBeforeIso};
import {messages.setMessageSource, messages.builtInOnly};

#[validated]
pub type CreateUserRequest(
    #[notBlank] #[sizeBetween(2, 50)] name: string,
    #[notBlank] #[email] email: string,
    #[minValue(18)] #[maxValue(120)] age: i32,
    #[pattern("^[0-9]{5}-[0-9]{3}$")] postalCode: string,
)

fn input(
    name: string,
    mail: string,
    age: i32,
    postal: string,
) -> CreateUserRequest {
    return CreateUserRequest(
        name: name,
        email: mail,
        age: age,
        postalCode: postal,
    );
}

// The twenty inputs. Ten are valid in at least one field that another input
// breaks, so every predicate is exercised on both sides of its boundary.
fn inputs() -> Array<CreateUserRequest> {
    return [
        input("Ana", "ana@example.com", 30, "01310-100"),
        input("", "ana@example.com", 30, "01310-100"),
        input("   ", "ana@example.com", 30, "01310-100"),
        input("A", "ana@example.com", 30, "01310-100"),
        input("Ab", "ana@example.com", 30, "01310-100"),
        input("Ana", "", 30, "01310-100"),
        input("Ana", "ana@example", 30, "01310-100"),
        input("Ana", "@example.com", 30, "01310-100"),
        input("Ana", "an a@example.com", 30, "01310-100"),
        input("Ana", "a@b.c.dd", 30, "01310-100"),
        input("Ana", "ana@example.com", 17, "01310-100"),
        input("Ana", "ana@example.com", 18, "01310-100"),
        input("Ana", "ana@example.com", 120, "01310-100"),
        input("Ana", "ana@example.com", 121, "01310-100"),
        input("Ana", "ana@example.com", 0 - 1, "01310-100"),
        input("Ana", "ana@example.com", 30, ""),
        input("Ana", "ana@example.com", 30, "01310100"),
        input(
            "Abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "ana@example.com",
            30,
            "01310-100",
        ),
        input("", "nope", 7, "x"),
        input("   ", "", 999, "01310-1000"),
    ];
}

fn digestOne(index: i32, r: ValidationReport) -> string {
    val rows = r.violations.map(
        { v -> v.field + ":" + v.code + ":" + v.message },
    );
    return [index].join("") + "=" + rows.join("+");
}

// #[17] is a name of exactly 50 characters: the upper bound `#[sizeBetween(2,
// 50)]` admits. Together with #[4] ("Ab", exactly the lower bound) it is what
// makes the digest sensitive to a predicate whose boundary moved by one, which
// a set of inputs chosen only for variety would not be.
fn digest() -> string {
    var out: Array<string> = [];
    var i = 0;
    val all = inputs();
    while (i < all.length) {
        val one = all.at(i);
        val rep = one
            .map({ v -> v.validate() })
            .unwrapOr(ValidationReport.empty());
        out.push(digestOne(i, rep));
        i = i + 1;
    }
    return out.join(";");
}

fn cleanTemplates() -> i32 {
    return setMessageSource(builtInOnly());
}

pub fn expectedDigest() -> string {
    return "0=;"
        + "1=name:notBlank:must not be blank+name:sizeBetween:size must be between 2 and 50;"
        + "2=name:notBlank:must not be blank;"
        + "3=name:sizeBetween:size must be between 2 and 50;"
        + "4=;"
        + "5=email:notBlank:must not be blank+email:email:must be a well-formed email address;"
        + "6=email:email:must be a well-formed email address;"
        + "7=email:email:must be a well-formed email address;"
        + "8=email:email:must be a well-formed email address;"
        + "9=;"
        + "10=age:minValue:must be at least 18;"
        + "11=;"
        + "12=;"
        + "13=age:maxValue:must be at most 120;"
        + "14=age:minValue:must be at least 18;"
        + "15=postalCode:pattern:must match ^[0-9]{5}-[0-9]{3}$;"
        + "16=postalCode:pattern:must match ^[0-9]{5}-[0-9]{3}$;"
        + "17=;"
        + "18=name:notBlank:must not be blank+name:sizeBetween:size must be between 2 and 50+email:email:must be a well-formed email address+age:minValue:must be at least 18+postalCode:pattern:must match ^[0-9]{5}-[0-9]{3}$;"
        + "19=name:notBlank:must not be blank+email:notBlank:must not be blank+email:email:must be a well-formed email address+age:maxValue:must be at most 120+postalCode:pattern:must match ^[0-9]{5}-[0-9]{3}$";
}

test "validation: twenty inputs, one function, one answer on both rows" {
    val _c = cleanTemplates();
    assert digest() == expectedDigest();
}

test "validation: the table crosses byte-identically too" {
    assert CreateUserRequest.constraints()
        == "{\"type\":\"CreateUserRequest\",\"fields\":[{\"name\":\"name\",\"constraints\":[{\"code\":\"notBlank\"},{\"code\":\"sizeBetween\",\"min\":2,\"max\":50}]},{\"name\":\"email\",\"constraints\":[{\"code\":\"notBlank\"},{\"code\":\"email\"}]},{\"name\":\"age\",\"constraints\":[{\"code\":\"minValue\",\"min\":18},{\"code\":\"maxValue\",\"max\":120}]},{\"name\":\"postalCode\",\"constraints\":[{\"code\":\"pattern\",\"regex\":\"^[0-9]{5}-[0-9]{3}$\"}]}]}";
}

test "validation: the digest is not vacuous" {
    val _c = cleanTemplates();
    assert inputs().length == 20;
    assert digest().contains("notBlank");
    assert digest().contains("sizeBetween");
    assert digest().contains("email");
    assert digest().contains("minValue");
    assert digest().contains("maxValue");
    assert digest().contains("pattern");
    assert digest().contains("0=");
    assert digest().contains(";19=");
}

// ── step 3: every predicate, one accepted and one refused input ─────────────
//
// Each row runs one predicate twice — an input it accepts, then one it refuses
// — and writes the second's code and RESOLVED message (the accepted one writes
// nothing). One digest for both targets, so a predicate, a template or an
// interpolation that answered differently on one of them reds here.

fn row(name: string, ok: Array<Violation>, bad: Array<Violation>) -> string {
    val okText = ok.map({ v -> v.code }).join("+");
    val badText = bad.map({ v -> v.code + ":" + v.message }).join("+");
    return [name, "=", okText, "/", badText].join("");
}

fn formatDigest() -> string {
    val big: i64 = 9007199254740991;
    val at: i64 = 1577836800000;
    val hs = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIn0.c2ln";
    val sha = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
    val rows = [
        row(
            "minLength",
            vMinLength("f", "é😀", 2),
            vMinLength("f", "😀", 2),
        ),
        row(
            "maxLength",
            vMaxLength("f", "😀😀😀", 3),
            vMaxLength("f", "abcd", 3),
        ),
        row("length", vLength("f", "ab", 2), vLength("f", "abc", 2)),
        row(
            "startsWith",
            vStartsWith("f", "ord_1", "ord_"),
            vStartsWith("f", "1", "ord_"),
        ),
        row(
            "endsWith",
            vEndsWith("f", "a.com", ".com"),
            vEndsWith("f", "a.co", ".com"),
        ),
        row(
            "includes",
            vIncludes("f", "a---b", "---"),
            vIncludes("f", "a--b", "---"),
        ),
        row("uppercase", vUppercase("f", "ABC"), vUppercase("f", "aBC")),
        row("lowercase", vLowercase("f", "abc"), vLowercase("f", "Abc")),
        row(
            "emailHtml5",
            vEmailHtml5("f", "a@b"),
            vEmailHtml5("f", "a b@c.com"),
        ),
        row(
            "emailRfc5322",
            vEmailRfc5322("f", "a@[192.168.0.1]"),
            vEmailRfc5322("f", "a..b@example.com"),
        ),
        row(
            "emailUnicode",
            vEmailUnicode("f", "josé@exemplo.com"),
            vEmailUnicode("f", "a b@c"),
        ),
        row(
            "uuid",
            vUuid("f", "123e4567-e89b-12d3-a456-426614174000"),
            vUuid("f", "not-a-uuid"),
        ),
        row(
            "uuidV",
            vUuidV("f", "0190a5b2-7f3c-7c1e-9d2a-3b4c5d6e7f80", 7),
            vUuidV("f", "123e4567-e89b-12d3-a456-426614174000", 7),
        ),
        row(
            "guid",
            vGuid("f", "123e4567-e89b-02d3-c456-426614174000"),
            vGuid("f", "123e4567e89b02d3c456426614174000"),
        ),
        row(
            "url",
            vUrl("f", "ftp://user:pw@[::1]:21/x"),
            vUrl("f", "http://a b.com/"),
        ),
        row(
            "urlHost",
            vUrlHost("f", "https://example.com", "^example[.]com$"),
            vUrlHost("f", "https://example.org", "^example[.]com$"),
        ),
        row(
            "urlProtocol",
            vUrlProtocol("f", "https://a.com", "^https$"),
            vUrlProtocol("f", "http://a.com", "^https$"),
        ),
        row(
            "httpUrl",
            vHttpUrl("f", "https://example.com"),
            vHttpUrl("f", "http://localhost"),
        ),
        row("hostname", vHostname("f", "a-b.c.d."), vHostname("f", "a_b.com")),
        row("e164", vE164("f", "+15555555555"), vE164("f", "555-555-5555")),
        row("emoji", vEmoji("f", "👍🏽"), vEmoji("f", "😀a")),
        row("base64", vBase64("f", "SGVsbG8="), vBase64("f", "SGVsbG8")),
        row("base64url", vBase64Url("f", "a-_b"), vBase64Url("f", "a+b")),
        row("hex", vHex("f", "deadBEEF"), vHex("f", "0x12")),
        row("jwt", vJwt("f", hs), vJwt("f", "a.b")),
        row("jwtAlg", vJwtAlg("f", hs, "HS256"), vJwtAlg("f", hs, "RS256")),
        row(
            "nanoid",
            vNanoid("f", "V1StGXR8_Z5jdHi6B-myT"),
            vNanoid("f", "V1StGXR8_Z5jdHi6B-my"),
        ),
        row(
            "cuid",
            vCuid("f", "cjld2cjxh0000qzrmn831i7rn"),
            vCuid("f", "c1234-5678"),
        ),
        row(
            "cuid2",
            vCuid2("f", "tz4a98xxat96iws9zmbrgj3a"),
            vCuid2("f", "ABC"),
        ),
        row(
            "ulid",
            vUlid("f", "01ARZ3NDEKTSV4RRFFQ69G5FAV"),
            vUlid("f", "01ARZ3NDEKTSV4RRFFQ69G5FAI"),
        ),
        row("ipv4", vIpv4("f", "192.168.0.0"), vIpv4("f", "256.1.1.1")),
        row(
            "ipv6",
            vIpv6("f", "::ffff:192.168.0.1"),
            vIpv6("f", "2001:db8::85a3::1"),
        ),
        row(
            "mac",
            vMac("f", "00:1A:2B:3C:4D:5E"),
            vMac("f", "00:1A:2b:3C:4D:5E"),
        ),
        row(
            "macDelimiter",
            vMacDelimiter("f", "00-1A-2B-3C-4D-5E", "-"),
            vMacDelimiter("f", "00:1A:2B:3C:4D:5E", "-"),
        ),
        row(
            "cidrv4",
            vCidrv4("f", "192.168.0.0/24"),
            vCidrv4("f", "192.168.0.0/33"),
        ),
        row(
            "cidrv6",
            vCidrv6("f", "2001:db8::/32"),
            vCidrv6("f", "2001:db8::/129"),
        ),
        row(
            "creditCard",
            vCreditCard("f", "4111 1111 1111 1111"),
            vCreditCard("f", "4111111111111112"),
        ),
        row(
            "currencyCode",
            vCurrencyCode("f", "BRL"),
            vCurrencyCode("f", "usd"),
        ),
        row(
            "iban",
            vIban("f", "DE89370400440532013000"),
            vIban("f", "DE89 3704 0044 0532"),
        ),
        row("hash", vHash("f", sha, "sha256"), vHash("f", "abc", "sha256")),
        row(
            "hashEnc",
            vHashEnc("f", "ndTkYSaMgDT1yFZOFVxnpg", "md5", "base64url"),
            vHashEnc("f", "ndTkYSaMgDT1yFZOFVxnpg==", "md5", "base64url"),
        ),
        row("isoDate", vIsoDate("f", "2024-02-29"), vIsoDate("f", "2020-1-1")),
        row(
            "isoTime",
            vIsoTime("f", "03:15:00.9999999"),
            vIsoTime("f", "24:00"),
        ),
        row(
            "isoTimePrecision",
            vIsoTimePrecision("f", "03:15:00.123", 3),
            vIsoTimePrecision("f", "03:15:00", 3),
        ),
        row(
            "isoDatetime",
            vIsoDatetime("f", "2020-01-01T06:15:00.123Z"),
            vIsoDatetime("f", "2020-01-01T06:15:00+02:00"),
        ),
        row(
            "isoDatetimeOffset",
            vIsoDatetimeOffset("f", "2020-01-01T06:15:00+02:00"),
            vIsoDatetimeOffset("f", "2020-01-01T06:15:00"),
        ),
        row(
            "isoDatetimeLocal",
            vIsoDatetimeLocal("f", "2020-01-01T06:15:00"),
            vIsoDatetimeLocal("f", "2020-01-01T06:15:00+02:00"),
        ),
        row(
            "isoDatetimePrecision",
            vIsoDatetimePrecision("f", "2020-01-01T06:15:00Z", 0),
            vIsoDatetimePrecision("f", "2020-01-01T06:15:00.1Z", 0),
        ),
        row(
            "isoDuration",
            vIsoDuration("f", "P3Y6M4DT12H30M5S"),
            vIsoDuration("f", "P1W2D"),
        ),
        row("gtI32", vGtI32("f", 1, 0), vGtI32("f", 0, 0)),
        row(
            "gtF64",
            vGtF64("f", 0.75, 0.5, "0.5"),
            vGtF64("f", 0.5, 0.5, "0.5"),
        ),
        row("ltI32", vLtI32("f", 0 - 1, 0), vLtI32("f", 0, 0)),
        row(
            "ltF64",
            vLtF64("f", 0.25, 0.5, "0.5"),
            vLtF64("f", 0.75, 0.5, "0.5"),
        ),
        row("negativeI32", vNegativeI32("f", 0 - 1), vNegativeI32("f", 0)),
        row(
            "negativeF64",
            vNegativeF64("f", 0.0 - 0.5),
            vNegativeF64("f", 0.5),
        ),
        row(
            "negativeOrZeroI32",
            vNegativeOrZeroI32("f", 0),
            vNegativeOrZeroI32("f", 1),
        ),
        row(
            "multipleOfI32",
            vMultipleOfI32("f", 15, 5),
            vMultipleOfI32("f", 12, 5),
        ),
        row(
            "multipleOfF64",
            vMultipleOfF64("f", 0.3, 0.1, 1, "0.1"),
            vMultipleOfF64("f", 0.35, 0.1, 1, "0.1"),
        ),
        row("safeInt", vSafeInt("f", big), vSafeInt("f", big)),
        row("float32", vFloat32("f", 3.4e38), vFloat32("f", 3.5e38)),
        row(
            "afterIso",
            vAfterIso("f", at + 1, "2020-01-01T00:00:00Z"),
            vAfterIso("f", at, "2020-01-01T00:00:00Z"),
        ),
        row(
            "beforeIso",
            vBeforeIso("f", at - 1, "2020-01-01T00:00:00Z"),
            vBeforeIso("f", at, "2020-01-01T00:00:00Z"),
        ),
    ];
    return rows.join(";");
}

pub fn expectedFormatDigest() -> string {
    return [
        "minLength=/minLength:length must be at least 2",
        "maxLength=/maxLength:length must be at most 3",
        "length=/length:length must be exactly 2",
        "startsWith=/startsWith:must start with ord_",
        "endsWith=/endsWith:must end with .com",
        "includes=/includes:must include ---",
        "uppercase=/uppercase:must not contain a lowercase letter",
        "lowercase=/lowercase:must not contain an uppercase letter",
        "emailHtml5=/emailHtml5:must be a well-formed email address",
        "emailRfc5322=/emailRfc5322:must be a well-formed email address",
        "emailUnicode=/emailUnicode:must be a well-formed email address",
        "uuid=/uuid:must be a UUID",
        "uuidV=/uuidV:must be a version 7 UUID",
        "guid=/guid:must be a GUID",
        "url=/url:must be a URL with a scheme and a host",
        "urlHost=/urlHost:must be a URL whose host matches ^example[.]com$",
        "urlProtocol=/urlProtocol:must be a URL whose scheme matches ^https$",
        "httpUrl=/httpUrl:must be an http or https URL with a domain",
        "hostname=/hostname:must be a hostname",
        "e164=/e164:must be an E.164 phone number",
        "emoji=/emoji:must be emoji",
        "base64=/base64:must be base64",
        "base64url=/base64url:must be base64url",
        "hex=/hex:must be hexadecimal",
        "jwt=/jwt:must be a JWT",
        "jwtAlg=/jwtAlg:must be a JWT signed with RS256",
        "nanoid=/nanoid:must be a nanoid",
        "cuid=/cuid:must be a cuid",
        "cuid2=/cuid2:must be a cuid2",
        "ulid=/ulid:must be a ULID",
        "ipv4=/ipv4:must be an IPv4 address",
        "ipv6=/ipv6:must be an IPv6 address",
        "mac=/mac:must be a MAC address",
        "macDelimiter=/macDelimiter:must be a MAC address delimited by -",
        "cidrv4=/cidrv4:must be an IPv4 CIDR block",
        "cidrv6=/cidrv6:must be an IPv6 CIDR block",
        "creditCard=/creditCard:must be a card number",
        "currencyCode=/currencyCode:must be an ISO 4217 currency code",
        "iban=/iban:must be an IBAN",
        "hash=/hash:must be a sha256 hash",
        "hashEnc=/hashEnc:must be a md5 hash in base64url",
        "isoDate=/isoDate:must be an ISO date (YYYY-MM-DD)",
        "isoTime=/isoTime:must be an ISO time",
        "isoTimePrecision=/isoTimePrecision:must be an ISO time of precision 3",
        "isoDatetime=/isoDatetime:must be an ISO datetime in UTC",
        "isoDatetimeOffset=/isoDatetimeOffset:must be an ISO datetime",
        "isoDatetimeLocal=/isoDatetimeLocal:must be an ISO datetime",
        "isoDatetimePrecision=/isoDatetimePrecision:must be an ISO datetime of precision 0",
        "isoDuration=/isoDuration:must be an ISO 8601 duration",
        "gtI32=/gt:must be greater than 0",
        "gtF64=/gt:must be greater than 0.5",
        "ltI32=/lt:must be less than 0",
        "ltF64=/lt:must be less than 0.5",
        "negativeI32=/negative:must be less than 0",
        "negativeF64=/negative:must be less than 0",
        "negativeOrZeroI32=/negativeOrZero:must be less than or equal to 0",
        "multipleOfI32=/multipleOf:must be a multiple of 5",
        "multipleOfF64=/multipleOf:must be a multiple of 0.1",
        "safeInt=/",
        "float32=/float32:must fit a 32-bit float",
        "afterIso=/afterIso:must be after 2020-01-01T00:00:00Z",
        "beforeIso=/beforeIso:must be before 2020-01-01T00:00:00Z",
    ].join(";");
}

test "validation: every step-3 predicate, one answer on both rows" {
    val _c = cleanTemplates();
    assert formatDigest() == expectedFormatDigest();
}

test "validation: the step-3 digest is not vacuous" {
    val _c = cleanTemplates();
    val rows = formatDigest().split(";");
    assert rows.length == 62;
    assert rows.filter({ r -> r.endsWith("/") }).length == 1;
}

// The suite case of the front's example, byte for byte but for the import
// lines: a module of this package names it by path (`import {schemas};`,
// decision 206), an application by `from "validation"`.
//
// Front 125 — validation: Zod's feature set · examples/checks-and-formats-example.bp
//
// Demonstrates: step 3 — the string checks, the string formats and the numeric
// checks, as markers. A marker is a predicate (`constraints.bp`), a built-in
// message (`messages.bp`) and a table row (`table.bp`); `#[validated]` is what
// runs them, and `parse<T>` calls `validate<T>` on the record it built.
//
//   z.string().min(2).max(40)            z.email()         z.uuid()
//   z.string().startsWith("ord_")        z.url()           z.ipv4()
//   z.number().gt(0).multipleOf(5)       z.iso.date()      z.e164()
//   z.creditCard()                       z.iban()          z.hash("sha256")
//
// Upstream: ZOD_DOCUMENTATION.md §§ 4.3 (Strings), 4.4 (Formatos de String),
//           4.6 (Numbers) — https://zod.dev/api#strings
//
// Target: both. Every predicate is plain botopink — a regex in the intersection
// of PCRE and ECMAScript, or a walk — so the server and the browser run one
// predicate, not two that are supposed to agree.

import {decorators.schema, decorators.validated};
import {decorators.minLength, decorators.maxLength, decorators.startsWith, decorators.lowercase, decorators.email, decorators.uuid, decorators.url, decorators.httpUrl};
import {decorators.ipv4, decorators.e164, decorators.isoDate, decorators.isoDatetime, decorators.creditCard, decorators.iban, decorators.hash, decorators.gt, decorators.multipleOf, decorators.negative};
import {schemas};
import {schemas.Schema, report.ValidationReport, report.Violation};
import {constraints.vUuid, constraints.vMinLength, constraints.vMaxLength, constraints.vEmail, constraints.vLowercase, constraints.vE164, constraints.vHttpUrl, constraints.vIsoDate};
import {constraints.vStartsWith, constraints.vCreditCard, constraints.vIban, constraints.vGtI32, constraints.vMultipleOfI32, constraints.vNegativeF64, constraints.vIpv4, constraints.vIsoDatetime, constraints.vHash};
import {table.constraintTableJson};
import {json.Json} from "std";

#[schema]
#[validated]
pub type Customer(
    #[uuid] id: string,
    #[minLength(2)] #[maxLength(40)] name: string,
    #[email] #[lowercase] email: string,
    #[e164] phone: ?string,
    #[httpUrl] site: ?string,
    #[isoDate] birthday: string,
)

#[schema]
#[validated]
pub type Payment(
    #[startsWith("ord_")] order: string,
    #[creditCard] card: string,
    #[iban] refundTo: ?string,
    #[gt(0)] #[multipleOf(5)] cents: i32,
    #[negative] adjustment: f64,
    #[ipv4] origin: string,
    #[isoDatetime] at: string,
    #[hash("sha256")] receipt: string,
)

fn codesOf(r: @Result<Customer, ValidationReport>) -> string {
    return case r {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
}

fn payCodes(r: @Result<Payment, ValidationReport>) -> string {
    return case r {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
}

test "validation: a customer that satisfies every marker" {
    val c = try decodeCustomer(
        """{"id": "0190a5b2-7f3c-7c1e-9d2a-3b4c5d6e7f80", "name": "Ana",
            "email": "ana@example.com", "phone": "+5511999990000",
            "site": "https://example.com", "birthday": "1990-02-28"}""",
    );
    assert c.name == "Ana";
}

test "validation: each format refuses the input the reference refuses" {
    // "555-555-5555" for e164, "2020-1-1" for iso.date — ZOD_DOCUMENTATION.md § 4.4.
    val r = decodeCustomer(
        """{"id": "not-a-uuid", "name": "A", "email": "Ana@Example.com",
            "phone": "555-555-5555", "site": "ftp://example.com", "birthday": "2020-1-1"}""",
    );
    assert codesOf(r)
        == "id:uuid,name:minLength,email:lowercase,phone:e164,site:httpUrl,birthday:isoDate";
}

test "validation: an absent optional field skips its markers" {
    val r = decodeCustomer(
        """{"id": "0190a5b2-7f3c-7c1e-9d2a-3b4c5d6e7f80", "name": "Ana",
            "email": "ana@example.com", "birthday": "1990-02-28"}""",
    );
    assert codesOf(r) == "";
}

test "validation: a calendar date is checked, not only its shape" {
    val r = decodeCustomer(
        """{"id": "0190a5b2-7f3c-7c1e-9d2a-3b4c5d6e7f80", "name": "Ana",
            "email": "ana@example.com", "birthday": "2023-02-29"}""",
    );
    assert codesOf(r) == "birthday:isoDate";
}

test "validation: the checksum formats are walks, not regexes" {
    // 4111 1111 1111 1111 passes Luhn; changing the last digit does not.
    val ok = decodePayment(
        """{"order": "ord_1", "card": "4111 1111 1111 1111", "refundTo": "DE89370400440532013000",
            "cents": 1500, "adjustment": -0.5, "origin": "192.168.0.1",
            "at": "2020-01-01T06:15:00Z",
            "receipt": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}""",
    );
    assert payCodes(ok) == "";

    val bad = decodePayment(
        """{"order": "1", "card": "4111 1111 1111 1112", "refundTo": "DE89 3704 0044 0532",
            "cents": 12, "adjustment": 0.5, "origin": "256.1.1.1",
            "at": "2020-01-01T06:15:00+02:00", "receipt": "abc"}""",
    );
    assert payCodes(bad)
        == "order:startsWith,card:creditCard,refundTo:iban,cents:multipleOf,adjustment:negative,origin:ipv4,at:isoDatetime,receipt:hash";
}

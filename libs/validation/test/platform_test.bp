//// validation — what the library's design stands on, measured.
////
//// Every case here is a fact about the LANGUAGE on both targets that some
//// module of this library is written against. They are tests and not notes
//// because both kinds of statement drift: a note that said "a decorator body
//// cannot call a sibling function" outlived the compiler it was true of.
////
//// What is NOT here is what cannot be a green test — the forms the compiler
//// refuses or miscompiles. Those are in `AGENTS.md` § Language notes, each with
//// the form this library writes instead.

import {constraints};
import {report.Violation};
import {json, json.Json, unicode, url} from "std";

// ── a generic record holding a function, with a generic method ──────────────

type Box<T>(make: fn(seed: i32) -> T) {
    pub fn get(self: Self<T>, seed: i32) -> T {
        val f = self.make;
        return f(seed);
    }

    pub fn then<U>(self: Self<T>, g: fn(v: T) -> U) -> Box<U> {
        val f = self.make;
        return Box(make: { seed -> g(f(seed)) });
    }
}

fn double(n: i32) -> i32 {
    return n * 2;
}

fn label(n: i32) -> string {
    return "n=" + n.toString();
}

test "validation: a generic record carries a function and maps it" {
    val box = Box(make: double).then(label);
    assert box.get(21) == "n=42";
}

// ── a result is built by a function ─────────────────────────────────────────

fn whole(text: string) -> @Result<i32, string> {
    if (text != "7") throw "not seven";
    return 7;
}

fn through(text: string) -> @Result<i32, string> {
    val n = try whole(text);
    return n + 1;
}

fn outcome(r: @Result<i32, string>) -> string {
    return case r {
        Ok(n) -> "ok " + n.toString();
        Error(why) -> "error " + why;
    };
}

test "validation: a result comes out of return and throw, and try carries it on" {
    assert outcome(through("7")) == "ok 8";
    assert outcome(through("x")) == "error not seven";
}

// ── a union as a generic argument, and `is` at run time ─────────────────────

type Holder<T>(value: T)

fn either(flag: bool) -> i32 | string {
    if (flag) return 7;
    return "seven";
}

fn which(x: i32 | string) -> string {
    if (x is i32) return "int";
    return "text";
}

fn held(flag: bool) -> Holder<i32 | string> {
    return Holder(value: either(flag));
}

test "validation: a union is a generic argument and is tells its arms apart" {
    assert which(held(true).value) == "int";
    assert which(held(false).value) == "text";
}

// ── a generic value as an optional ──────────────────────────────────────────

// `fn some<T>(v: T) -> ?T { return v; }` is "recursive type detected". The
// optional is read out of a one-item list instead (`schemas.bp` `present`).
fn some<T>(v: T) -> ?T {
    return [v].at(0);
}

fn nothing<T>() -> ?T {
    val none: Array<T> = [];
    return none.at(0);
}

test "validation: a generic value becomes an optional through a list" {
    val a: ?string = some("x");
    val b: ?string = nothing();
    assert a == "x";
    assert b == null;
}

// ── the length of a string ──────────────────────────────────────────────────

// `"😀".length()` is 2 on commonJS (UTF-16 units) and 1 on erlang (code
// points), and `indexOf` counts bytes on erlang. The count both targets agree
// on is the number of code points.
test "validation: the portable length of a string is its code-point count" {
    val text = unicode.fromCodepoint(233) + unicode.fromCodepoint(128512) + "a";
    assert unicode.codepoints(text).length == 3;
    assert unicode.codepoints("").length == 0;
    assert unicode.codepoints("abc").length == "abc".length();
}

// ── f32 ─────────────────────────────────────────────────────────────────────

// An `f32` is written with the `f` suffix (`1.5f`; a bare `1.5` is an `f64`
// and does not fit). Both targets hold it as a double: `0.1f` reads back as
// `0.1`, not as the nearest single-precision value `0.100000001490116…`. So a
// value round-trips through an `f32` unchanged, and the single-precision range
// is a check a marker makes (`#[float32]` on an `f64`), never a rounding the
// platform does.
fn widened(x: f32) -> string {
    return [x].join("");
}

test "validation: an f32 is written 1.5f and round-trips unchanged on both targets" {
    val half: f32 = 1.5f;
    val tenth: f32 = 0.1f;
    assert widened(half) == "1.5";
    assert widened(tenth) == "0.1";
    assert tenth == 0.1f;
}

// ── url.parse against the WHATWG URL standard ───────────────────────────────

// `std/url.parse` splits at `://`, `#`, `?`, `/`, `@` and the first `:` and
// answers every input; the WHATWG parser (`new URL(…)`, what Zod's `z.url()`
// asks) normalizes and refuses. Each case is an input where the two answer
// differently, with WHATWG's answer beside it. The `#[url]` marker is written
// against these: it splits the authority and checks scheme, host and port
// itself, and does not take `url.parse`'s answer as a verdict.
fn parts(input: string) -> string {
    val u = url.parse(input);
    return [
        u.scheme,
        u.host,
        [u.port].join(""),
        u.path,
        u.query,
        u.fragment,
    ].join("|");
}

test "validation: url.parse keeps the case WHATWG lowers, and no path is not /" {
    // WHATWG: scheme `http`, host `example.com`, path `/`.
    assert parts("HTTP://Example.COM") == "HTTP|Example.COM|0|||";
    // WHATWG: path `/`.
    assert parts("http://example.com") == "http|example.com|0|||";
}

test "validation: url.parse keeps a default port WHATWG elides" {
    // WHATWG: port `""` — 80 is http's default.
    assert parts("http://a.com:80/x") == "http|a.com|80|/x||";
}

test "validation: url.parse reads a URL without an authority as one scheme" {
    // WHATWG: scheme `mailto`, path `a@b.c`.
    assert parts("mailto:a@b.c") == "mailto:a@b.c||0|||";
}

test "validation: url.parse splits a bracketed IPv6 host at its first colon" {
    // WHATWG: host `[::1]`, port 8080.
    assert parts("http://[::1]:8080/") == "http|[|18080|||";
}

test "validation: url.parse answers what WHATWG refuses" {
    // WHATWG: each one is a failure (TypeError: Invalid URL).
    assert parts("not a url") == "not a url||0|||";
    assert parts("http://") == "http||0|||";
    assert parts("http://a b.com/") == "http|a b.com|0|||";
    assert parts("http://a.com:abc/") == "http|a.com|0|||";
}

// ── decorators ──────────────────────────────────────────────────────────────

fn emittedName(n: string) -> string {
    return "made" + n;
}

// A decorator body calls a bodied function of its own module, takes a
// parameter's default, and emits code that names a module through its
// namespace.
pub fn maker(comptime decl: @Decl, suffix: string = "X") {
    @emit(
        "pub fn "
            + emittedName(decl.name)
            + suffix
            + "() -> i32 { return constraints.vNotBlank(\"f\", \"\").length; }",
    );
}

#[maker]
pub type Thing(name: string)

#[maker("Y")]
pub type Other(name: string)

test "validation: a decorator calls a sibling function and takes a default" {
    assert madeThingX() == 1;
    assert madeOtherY() == 1;
}

test "validation: a module is named through its namespace" {
    val none: Array<Violation> = constraints.vNotBlank("f", "x");
    assert none.length == 0;
}

// ── a document ──────────────────────────────────────────────────────────────

fn kind(j: Json) -> string {
    return case j {
        Null -> "null";
        Bool(_) -> "bool";
        Num(_) -> "number";
        Str(_) -> "string";
        Arr(_) -> "array";
        Obj(_) -> "object";
    };
}

test "validation: a JSON number is an f64, and a document keeps its member order" {
    val doc = try json.decode("""{"b": 1, "a": [true, null, "x", 2.5]}""");
    val names = case doc {
        Obj(members) -> members.map({ m -> m[0] }).join(",");
        _ -> "";
    };
    assert names == "b,a";
    assert kind(doc) == "object";
    assert json.decode("""{"a": 1, "a": 2}""").isError();
    assert json.decode("NaN").isError();
}

//// Decision 8 §8 — a host-backed `declare fn`: one `#[compiler.external(.<Target>)]` per
//// backend, positional `$0`/`$1` markers over the declared parameters
//// (decision 5's numbering), and the same answer from every host.

import {compiler} from "std";

// wasm refuses this suite on a host binding: `hostMax` has no `#[compiler.external(.Wasm)]` binding. Its `botopink.json` narrows `"targets"` to the three that bind it.

#[compiler.external(.JavaScript("Math.max($0, $1)"), .Erlang("erlang:max($0, $1)"))]
declare fn hostMax(a: i32, b: i32) -> i32;

#[compiler.external(.JavaScript("($0).toUpperCase()"), .Erlang("string:uppercase($0)"))]
declare fn hostUpper(s: string) -> string;

test "§8 a two-target external answers the same on every backend" {
    assert hostMax(2, 7) == 7;
}

test "§8 positional markers follow the declared parameters" {
    assert hostUpper("ab") == "AB";
}

//// Decision 33 — a declaration with no body says what it answers, even when the
//// answer is nothing. `fn f(x: string)` with neither a body nor a `-> …` is a
//// parse error that names itself (`bodyless-fn-needs-return-type`,
//// `reject/bodyless_fn_no_return_type.bp`); `-> void` is how it is written.
////
//// `declare fn …;` is a different grammar and is NOT covered here: it has never
//// required a return type, and whether it should for the same reason is the open
//// question decision 33 records rather than answers.

// wasm refuses this suite on a host binding: `hostMin` has no `#[@External.Wasm]` binding. Its `botopink.json` narrows `"targets"` to the three that bind it.

#[@external(.JavaScript("Math.min($0, $1)"), .Erlang("erlang:min($0, $1)"))]
declare fn hostMin(a: i32, b: i32) -> i32;

#[@external(.JavaScript("console.log($0)"), .Erlang("io:put_chars($0)"))]
declare fn hostWrite(s: string) -> void;

test "a bodyless fn with a value return type binds its host" {
    assert hostMin(7, 2) == 2;
}

test "a bodyless fn with -> void compiles and is callable" {
    hostWrite("");
    assert true;
}

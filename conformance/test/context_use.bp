//// Front 19 of 1.0.10-beta (C-27), decisions 87 and 88 — the `use` activation,
//// as decisions 102/104 (front 21) spell it. A hook is
//// `fn <noun>(…) -> Component<R>` (decision 128) (no `use` prefix in its name);
//// `val x = use <noun>(…)` binds `R` inside a `#[@use]` body — a component
//// (`-> Component<Element>`) or another hook (`-> Component<_>`). A
//// component is run from the root by its caller, `c.run(RenderScope.root())`
//// (a `test` body runs in a future context, so it awaits that run; decision
//// 791 (4): no `await` of a component). The owner type is declared here: the
//// suite depends on no library.

import {context.RenderScope} from "std";

type Element(count: i32, name: string) implement Renderable

type State(value: i32, name: string)

// `state` yields its initial value.
component fn state(initial: i32) -> Component<State> {
    return State(value: initial, name: "state");
}

// A hook whose `R` is a tuple.
component fn pair(a: i32, b: i32) -> Component<#(i32, i32)> {
    return #(a, b);
}

// A hook whose `R` is a tuple with a fn element — step 3 binds each name to
// its element (`shown : i32`, `push : fn(action: i32) -> i32`), so `push(shown)`
// types with no annotation on the binding.
component fn optimistic(
    base: i32,
    f: fn(current: i32, action: i32) -> i32,
) -> Component<#(i32, fn(action: i32) -> i32)> {
    val push: fn(i32) -> i32 = { action -> f(base, action) };
    return #(base, push);
}

// A void-ish hook activated as a bare statement.
component fn effect(cb: fn() -> i32) -> Component<i32> {
    return cb();
}

// A custom hook by the rule: a noun, no `use` prefix, composing another hook.
// Its wrapper anchors at `Element`, so every `use` in it agrees on `Element`,
// and `#[@use]` is what lets its body activate `state`.
component fn counter(start: i32) -> Component<State> {
    val s = use state(start * 2);
    return s;
}

component fn Widget(n: i32) -> Component<Element> {
    val c = use state(n);
    return Element(count: c.value + 1, name: c.name);
}

component fn Fields() -> Component<Element> {
    val { value, name } = use state(5);
    return Element(count: value, name: name);
}

component fn Composed() -> Component<Element> {
    val k = use counter(10);
    return Element(count: k.value, name: k.name);
}

component fn Positional() -> Component<Element> {
    val #(x, y) = use pair(3, 4);
    return Element(count: x + y, name: "pair");
}

component fn Effectful() -> Component<Element> {
    use effect({ ->
        return 9;
    });
    val c = use state(1);
    return Element(count: c.value, name: "effect");
}

component fn Liked() -> Component<Element> {
    val #(shown, push) = use optimistic(12, { c, a -> c + a });
    return Element(count: push(shown), name: "optimistic");
}

// No annotation: an ordinary function (question 92 (b)).
fn Loading() -> Element {
    return Element(count: 7, name: "plain");
}

test "val c = use state(n) binds R, the hook's yield" {
    val e = (await Widget(41).run(RenderScope.root())).value;
    assert e.count == 42;
    assert e.name == "state";
}

test "val {a, b} = use … destructures R by field name" {
    val e = (await Fields().run(RenderScope.root())).value;
    assert e.count == 5;
    assert e.name == "state";
}

test "a custom hook composes hooks under the same owner" {
    val e = (await Composed().run(RenderScope.root())).value;
    assert e.count == 20;
    assert e.name == "state";
}

test "val #(a, b) = use … destructures a tuple R positionally" {
    val e = (await Positional().run(RenderScope.root())).value;
    assert e.count == 7;
}

test "val #(a, b) = use … binds each name to its element of R" {
    val e = (await Liked().run(RenderScope.root())).value;
    assert e.count == 24;
    assert e.name == "optimistic";
}

test "a bare use statement activates a void hook" {
    val e = (await Effectful().run(RenderScope.root())).value;
    assert e.count == 1;
}

test "an unannotated fn -> Element is an ordinary function" {
    assert Loading().count == 7;
}

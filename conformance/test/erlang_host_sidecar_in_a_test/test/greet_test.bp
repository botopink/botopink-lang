//// A test module that declares a host function of its own sidecar and calls
//// it: `botopink test` ships `src/sidecars/lt_greeter.erl` beside the
//// runner, and the runner loads it before the tests run. It imports nothing,
//// so its runner loaded no sibling and the call died `{error,undef}`.
//// Narrowed to erlang and beam: commonJS has no binding for `hello`.

#[@External.Erlang("lt_greeter", "hello")]
declare fn hello(name: string) -> string;

test "a sidecar answers a test module that declares it" {
    assert hello("test") == "hello, test";
}

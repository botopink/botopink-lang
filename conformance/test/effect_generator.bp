//// Decision 8 §9 — `#[@generator]` plus `-> Iter<T>`: `yield` produces
//// the elements and `for (gen)` consumes them.

iter fn nums(n: i32) -> Iter<i32> {
    var i = 0;
    while (i < n) {
        yield i;
        i = i + 1;
    }
}

test "§9 a generator yields its elements in order" {
    var acc = "";
    for x in nums(3) {
        acc = acc + x.toString();
    }
    assert acc == "012";
}

test "§9 an empty generator runs no iteration" {
    var runs = 0;
    for x in nums(0) {
        runs = runs + 1;
    }
    assert runs == 0;
}

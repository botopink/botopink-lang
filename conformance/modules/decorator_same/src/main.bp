//// Decision 371 — `Decorator.same(other)` compares two decorators by their
//// declaration, never by the name written. `web`'s `serverOnly` under the
//// alias `srv` is `web/markers`'s; the project's own `serverOnly`, reached
//// through the namespace `local`, has the same name and is another
//// declaration of another package — `same` answers false for it.

pub mod local;

import {serverOnly as srv, check.check, Check} from "web";

#[check]
#[srv]
fn Aliased() -> string {
    return "a";
}

#[check]
#[local.serverOnly]
fn SameName() -> string {
    return "b";
}

pub fn main() {
    val aliased: string[] = @typeInfo(Aliased).meta(Check)?.ids ?? [];
    @print(aliased.join(" "));
    val sameName: string[] = @typeInfo(SameName).meta(Check)?.ids ?? [];
    @print(sameName.join(" "));
}

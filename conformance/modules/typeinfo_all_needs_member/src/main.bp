//// Decision 216 (4) — a type is no value: cataloguing types names the
//// member each entry's `value` calls (`member: "describe"`).

import {compiler, io.terminal.print} from "std";

fn component(syntax decl: unknown) {
    compiler.addMember("pub fn describe() -> string { return \""
        + compiler.name(decl)!
        + "\"; }");
}

#[component]
pub type Box(n: i32)

pub fn main() {
    print(@TypeInfo.all(with: component).length);
}

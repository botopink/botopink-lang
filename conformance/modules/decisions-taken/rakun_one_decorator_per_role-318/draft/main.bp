//// Decision 318 — One decorator per role, in rakun's own names; Spring's synonyms go.

import {comptime.beans.component, comptime.beans.provides, comptime.beans.listen, comptime.registry};
import {io.terminal.print} from "std";

pub type Clock(zone: string)

#[provides]
pub fn clock() -> Clock {
    return Clock(zone: "UTC");
}

#[component]
pub type Mailer(clock: Clock)

#[component(scope: .Request)]
pub type Orders(clock: Clock) {
    #[listen("order-events")]
    pub fn placed(self: Self, id: i32) -> void {}
}

pub fn main() -> void {
    for entry in registry.all() {
        print(entry);
    }
}

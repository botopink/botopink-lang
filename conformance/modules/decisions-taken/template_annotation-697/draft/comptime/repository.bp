//// A method decorator that records meta, and the owner's decorator that reads it.

import {compiler} from "std";

pub type Query(sql: string)

pub fn query(syntax decl: unknown, comptime sql: string) -> void {
    compiler.setMeta(Query(sql: sql));
}

pub fn repository(syntax decl: unknown) -> void {
    var out: string[] = [];
    for (compiler.methods(decl)) { m ->
        val q = compiler.meta(m, Query);
        if (q != null) out.push(compiler.name(m)! + ": " + q.sql);
    }
    val text = out.join("; ");
    compiler.addMember("queries", fn() -> string {
        return text;
    });
}

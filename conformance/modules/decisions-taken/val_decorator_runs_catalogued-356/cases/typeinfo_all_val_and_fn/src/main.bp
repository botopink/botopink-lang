//// Decision 356 — a `val` is its own kind in the catalogue: one query
//// answers one kind of value, so a decorator carried by a `val` and by a
//// function is refused at the query, naming both.

import {compiler, io.terminal.print} from "std";

fn tag(syntax decl: unknown) -> void {
    compiler.setMeta(Tag(seen: true));
}

#[tag]
pub val limit = 2;

#[tag]
pub fn twice() -> i32 {
    return 4;
}

pub fn main() -> void {
    print(@TypeInfo.all(with: tag).length);
}

// What `#[tag]` records.
type Tag(seen: bool)

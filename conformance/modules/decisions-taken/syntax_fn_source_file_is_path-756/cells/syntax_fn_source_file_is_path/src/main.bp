//// Decision 756 — `compiler.source(value).file` is the file, relative to the
//// package root, as diagnostics print it (`src/main.bp`), never the module
//// path (`main`). `where` writes the file and line of its call into the
//// run-time call it answers.

import {compiler} from "std";
import {io.terminal.print} from "std";

pub fn whereAt(file: string, line: i32) -> bool {
    print(file + ":" + line.toString());
    return true;
}

pub fn where(syntax value: unknown) -> anyvalue {
    val at = compiler.source(value);
    return compiler.build("whereAt(\"" + at.file + "\", " + at.line.toString() + ")");
}

pub fn main() -> void {
    val ok = where(1 + 2);
    print(ok.toString());
}

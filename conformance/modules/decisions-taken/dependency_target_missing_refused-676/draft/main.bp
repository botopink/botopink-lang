//// Decision 676 — Every declared dependency's `"targets"` holds every target of the package that declares it, checked at the manifest; 660's order is depth-first by the manifests and by the deepest chain, as built.

import {io.terminal} from "std";
import {link} from "kit-link";

// The package declares `kit-link` in its `botopink.json` and builds for
// commonJS and erlang; `kit-link` declares commonJS alone, so the build is
// refused at the dependency's line of the manifest, whatever target it is for.
pub fn main() -> void {
    terminal.print(link("home"));
}

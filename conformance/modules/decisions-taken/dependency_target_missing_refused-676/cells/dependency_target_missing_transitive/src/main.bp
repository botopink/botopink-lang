//// Decision 676 — the target rule holds through the whole graph: `outer`
//// declares `commonJS`, `erlang` and `beam` and depends on `inner`, which
//// declares `commonJS` and `erlang` alone; `outer`'s manifest is refused at
//// `inner`'s line, naming `beam`, on every build of this program.

import {wrap} from "outer";
import {io.terminal.print} from "std";

pub fn main() -> void {
    print(wrap());
}

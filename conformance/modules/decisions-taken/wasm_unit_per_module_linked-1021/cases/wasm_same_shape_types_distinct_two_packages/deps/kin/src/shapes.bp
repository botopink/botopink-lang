//// A `Person` of the dependency's own, at the module path and of the shape the consumer's `Person` has:
//// only the package tells the two apart.

pub type Person(name: string, age: i32)

pub fn theirs(name: string, age: i32) -> unknown {
    return Person(name: name, age: age);
}

pub fn isTheirs(v: unknown) -> bool {
    return v is Person;
}

//// Unit B: closures crossing to and from unit A (decision 1055 (4)).

import {io.terminal.print} from "std";
mod maker;
import {maker.base, maker.adder, maker.apply, maker.Scale, maker.sum11, maker.apply11};

pub fn main() -> void {
    val add2 = adder(2);
    print(add2(40));
    print(apply(fn(x: i32) -> i32 {
        return x * 3;
    }, 5));
    print([1, 2, 3].map(add2));
    val tenfold = Scale.tenfold;
    print(apply(tenfold, 4));
    print(tenfold(5));
    val withBase = fn(x: i32) -> i32 {
        return x + base;
    };
    print(apply(withBase, 1));
    print(apply11(sum11()));
    print(apply11(fn(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32, h: i32, i: i32, j: i32, k: i32) -> i32 {
        return a * k;
    }));
}

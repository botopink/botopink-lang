//// Unit A: a module `val`, a closure made here, a function calling a closure it is given, a type's method.

pub val base: i32 = 100;

pub type Scale() {
    pub fn tenfold(n: i32) -> i32 {
        return n * 10;
    }
}

pub fn adder(k: i32) -> fn(i32) -> i32 {
    return fn(x: i32) -> i32 {
        return x + k;
    };
}

pub fn apply(f: fn(i32) -> i32, v: i32) -> i32 {
    return f(v);
}

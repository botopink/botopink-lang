//// Decisions 1021 (9), 1027 — declarations of one shape stay distinct types on every target:
//// `Person` and `Vec` (one record shape), `Box<T>` and `Maybe.Some` (one payload), and this
//// package's `Person` and the `Person` its dependency `other` declares alike. `is`, a `case`
//// arm, `==` and print tell each from the other.

import {isTheirs, theirs} from "other";
import {io.terminal.print} from "std";

type Person(name: string, age: i32)

type Vec(name: string, age: i32)

type Box<T>(value: T)

type Maybe<T> {
    None,
    Some(value: T),
}

fn kind(v: unknown) -> string {
    val p = if (v is Person) "person" else "-";
    val q = if (v is Vec) "vec" else "-";
    val b = if (v is Box<unknown>) "box" else "-";
    val s = if (v is Maybe<unknown>) "maybe" else "-";
    return p + " " + q + " " + b + " " + s;
}

fn label(v: unknown) -> string {
    return case v {
        Person { x ->
            "a person"
        }
        Vec { x ->
            "a vec"
        }
        Box<unknown> { x ->
            "a box"
        }
        _ {
            "other"
        }
    };
}

pub fn main() -> void {
    val mine: unknown = Person(name: "Ana", age: 30);
    val vec: unknown = Vec(name: "Ana", age: 30);
    val other: unknown = theirs("Ana", 30);
    print(kind(mine));
    print(kind(vec));
    print(kind(Box(value: 1)));
    print(kind(Maybe.Some(value: 1)));
    print(kind(other));
    print(label(mine));
    print(label(vec));
    print(label(Box(value: 1)));
    print(label(Maybe.Some(value: 1)));
    print(label(other));
    print(isTheirs(other));
    print(isTheirs(mine));
    print(mine == vec);
    print(mine == other);
    print(mine == Person(name: "Ana", age: 30));
    print(mine);
    print(vec);
    print(other);
}

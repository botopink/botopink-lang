//// Decisions 280 (3), 308, example 6 — each `.name` of the variadic
//// `..fields: Type.Field<T>[]` is a field of the annotated type: `.nmae` is
//// refused at it. Renaming a field turns every `.name` of it red here.

import {types.Type, compiler, io.terminal.print} from "std";

fn index<T>(syntax decl: T, comptime ..fields: Type.Field<T>[]) {
    compiler.setMeta(Index(columns: fields.map({ f -> f.name })));
}

fn unique<T>(syntax decl: T, comptime field: Type.Field<T>) {
    compiler.setMeta(Unique(column: field.name));
}

#[index(.state, .nmae)]
type City(code: string, name: string, state: string)

pub fn main() {
    print(City(code: "SP", name: "São Paulo", state: "SP").name);
}

// What `#[index]` records.
type Index(columns: string[])

// What `#[unique]` records.
type Unique(column: string)

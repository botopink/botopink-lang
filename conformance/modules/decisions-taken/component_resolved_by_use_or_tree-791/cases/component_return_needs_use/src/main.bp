//// Decision 791 (1), (3) — a component body written `-> Component<View>`
//// answers `View`. `mk(1)` only makes the component's lambda, a
//// `Component<View>`, so `return mk(1)` returns the wrong type: a type
//// mismatch, whose hint names `use` (`val v = use mk(1); return v;`).

import {context.run, io.terminal.print} from "std";

type View(text: string)

component fn mk(n: i32) -> Component<View> {
    return View(text: "mk ${n}");
}

component fn Page() -> Component<View> {
    return mk(1);
}

pub async fn main() -> Async<void> {
    val r = await run(Page());
    print(r.text);
}

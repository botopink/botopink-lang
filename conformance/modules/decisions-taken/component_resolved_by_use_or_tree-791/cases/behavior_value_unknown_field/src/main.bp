//// B-162 (decisions 791, 809 (1)) — a component call only makes the
//// component, a `Component<View>`: a `Composition` or a `Composable`, with no
//// member of its own, so a field read on it is refused at the name.

import {io.terminal.print} from "std";

type View(text: string)

component fn Label() -> Component<View> {
    return View(text: "label");
}

pub fn main() -> void {
    val c = Label();
    print(c.zzz);
}

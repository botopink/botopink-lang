//// B-162 (decision 791) — a component call only makes its lambda, a value
//// typed by the behavior `Component<View>`. A field read on it names a member
//// the behavior declares or is refused at the name: `Component<R>` declares
//// `run` (and `Async` nothing), so `c.zzz` is an unknown field.

import {io.terminal.print} from "std";

type View(text: string) implement Renderable

component fn Label() -> Component<View> {
    return View(text: "label");
}

pub fn main() -> void {
    val c = Label();
    print(c.zzz);
}

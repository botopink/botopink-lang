//// Decision 791 (2), (3) — a component is resolved two ways. Inside a
//// component body `use Badge("title")` runs it under the body's cell and
//// answers its `View`; `Badge("child")` only makes the component, which the
//// body resolves as a child of its tree by hand over its own cell
//// (`resolve(child, scope, Place.none())` in a `{ scope -> … }` lambda,
//// decision 908). Both read `Page`'s `dark`. The root is run with `run`.

import {context.run, context.resolve, context.Place, context.createContext, context.provide, context.context, io.terminal.print} from "std";

type Theme(mode: string)

type View(text: string)

pub val themeContext = comptime createContext(Theme(mode: "light"));

fn textOf(r: View | Async<View>) -> string {
    if (r is View) return r.text;
    return "async";
}

component fn Badge(name: string) -> Component<View> {
    val t = use context(themeContext);
    return View(text: name + ":" + t.mode);
}

component fn Page() -> Component<View> {
    use provide(createContext(Theme(mode: "dark")));
    val title = use Badge("title");
    val child = Badge("child");
    val tree: Component<string> = { scope -> textOf(resolve(child, scope, Place.none())) };
    val kid = use tree;
    return View(text: "page " + title.text + " " + kid);
}

pub async fn main() -> Async<void> {
    print((await run(Page())).text);
}

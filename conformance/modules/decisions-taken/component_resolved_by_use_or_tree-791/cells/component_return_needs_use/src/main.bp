//// Decisions 791 (1), 809 (4) — a component body written `-> Component<View>`
//// answers `View`. `mk(1)` only makes the component, a `Component<View>`, and
//// a body answering a component resolves it before it returns: `return
//// mk(1)` answers `mk`'s `View`, with no `use`.

import {context.run, io.terminal.print} from "std";

type View(text: string)

component fn mk(n: i32) -> Component<View> {
    return View(text: "mk ${n}");
}

component fn Page() -> Component<View> {
    return mk(1);
}

pub async fn main() -> Async<void> {
    val r = await run(Page());
    print(r.text);
}

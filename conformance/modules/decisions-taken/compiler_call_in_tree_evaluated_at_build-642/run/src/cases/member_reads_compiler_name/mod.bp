//// Decision 642 — a `compiler.*` call inside a member a decorator writes is
//// evaluated at build and spliced as its answer: the member answers the
//// annotated declaration's name.

import {compiler, io.terminal.print} from "std";

fn labelled(syntax decl: unknown) {
    compiler.addMember("label", fn() -> string {
        return compiler.name(decl)!;
    });
}

#[labelled]
pub type Users(id: i32)

pub fn runCase() {
    print(Users.label());
}

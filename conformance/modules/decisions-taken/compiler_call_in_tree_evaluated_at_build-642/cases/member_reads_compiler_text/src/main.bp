//// Decision 642 (amending 575 (4)'s tree rule) — a `compiler.*` call inside a
//// member a decorator writes is evaluated at build and spliced as its answer:
//// `compiler.text(rule)` over the `syntax` parameter `rule` is the code as
//// written, `always`.

import {compiler, io.terminal.print} from "std";

fn named<T>(syntax decl: T, syntax rule: fn(v: T) -> bool) {
    compiler.addMember("ruleText", fn(self: T) -> string {
        return compiler.text(rule);
    });
}

fn always(a: Account) -> bool {
    return true;
}

#[named(always)]
pub type Account(balance: i32)

pub fn main() {
    print(Account(balance: 1).ruleText());
}

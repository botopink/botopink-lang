//// Decisions 122 and 127 of 1.0.10-beta (front 24, § Cells "Iterators" and
//// "Migration"; guide.md § 5.6 and § 9, row `Iter<T, E>`) — the iterator
//// does not fail, its items do: `Iter<T, E>` is
//// `iterator-error-param-removed`, located at the error argument, with the
//// fix-it `Iter<Result<T, E>>`. The new form is
//// `run/iterator_result_items.bp`.

import {io.terminal.print} from "std";

iter fn old(n: i32) -> Iter<i32, string> {
    yield n;
}

pub fn main() -> void { for x in old(1) { print(x); } }

//// The module's one package (decisions 789 (4), 982 (5)): each case is a package under `cases/`,
//// loaded at build by `runCase`; a refused case prints its refusals, a running one runs its `main`.

import {compiler, io.terminal.print} from "std";

fn runCase(comptime name: string) -> void {
    print("== " + name + " comptime");
    val loaded = try comptime compiler.load("cases/" + name) catch { r ->
        compiler.init({ ->
            print("== " + name);
            for (r.diagnostics) { d ->
                val bracket = d.code != "" && !d.message.startsWith(d.code + ":");
                print(if (bracket) "refused error[" + d.code + "]: " + d.message else "refused error: " + d.message);
                print("at " + d.file + ":" + d.line.toString() + ":" + d.column.toString());
                if (d.label) { l -> print("label " + l); }
            }
        });
        return;
    };
    compiler.init({ ->
        print("== " + name);
        try loaded.run() catch { f -> print("abort " + f.message) }
    });
}

comptime {
    runCase("effect_annotation_removed_async_generator");
    runCase("effect_annotation_removed_context");
    runCase("effect_annotation_removed_future");
    runCase("effect_annotation_removed_future_generator");
    runCase("effect_annotation_removed_future_generator_loop");
    runCase("effect_annotation_removed_generator");
    runCase("effect_annotation_removed_generator_loop");
    runCase("effect_annotation_removed_iterator");
    runCase("effect_annotation_removed_result");
    runCase("effect_annotation_removed_result_generator");
    runCase("effect_annotation_removed_result_generator_loop");
    runCase("effect_annotation_removed_use");
    runCase("effect_type_removed_async_iterator");
    runCase("effect_type_removed_future");
    runCase("effect_type_removed_future_generator");
    runCase("effect_type_removed_future_no_error");
    runCase("effect_type_removed_generator");
    runCase("effect_type_removed_iterable");
    runCase("effect_type_removed_iterator_step");
    runCase("effect_type_removed_result_generator");
    runCase("effect_type_removed_use");
    runCase("effect_type_removed_yield");
    runCase("iterator_error_param_removed");
    runCase("loop_await_removed");
    runCase("loop_condition_parenthesised");
}

pub fn main() -> void {}

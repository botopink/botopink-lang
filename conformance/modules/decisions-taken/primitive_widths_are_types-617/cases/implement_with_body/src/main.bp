//// Decision 575 (6) — an implementation takes the place of a body: on a
//// function that has one it is refused at the annotation.

import {compiler, io.terminal.print} from "std";

#[compiler.external(.JavaScript("Math.abs($0)"), .Erlang("erlang:abs($0)"))]
fn magnitude(x: f64) -> f64 {
    return x;
}

pub fn main() {
    print(magnitude(-2.5));
}

//// Decision 623 — `io.http`'s `fetch` has one typed surface: `fetch(req: Request) ->
//// Async<Result<Response, HttpError>>`, with `Request(method, url, headers = [], body = null)`
//// and `HttpError { NotAllowedOnHost, Network(message), Timeout }` matched by variant. A short GET
//// is the record with its defaults. The cell builds the requests and reads the errors; the
//// `fetch` call type-checks in `probe` and is never run (a cell has no network).

import {io.http, io.terminal.print} from "std";

fn probe(url: string) -> Task<Result<i32, http.HttpError>> {
    val resp = try await http.fetch(http.Request(method: .Get, url: url));
    return resp.status;
}

fn describe(e: http.HttpError) -> string {
    return case e {
        http.HttpError.NotAllowedOnHost -> "NotAllowedOnHost";
        http.HttpError.Network(message) -> "Network " + message;
        http.HttpError.Timeout -> "Timeout";
    };
}

pub fn main() {
    val get = http.Request(method: .Get, url: "https://example.com/a");
    print(get.method.verb() + " " + get.url);
    print(get.headers.length.toString());
    print(get.body == null);

    val post = http.Request(
        method: .Post,
        url: "https://example.com/b",
        headers: [http.Header(name: "content-type", value: "text/plain")],
        body: Bytes.fromUtf8("hi"),
    );
    print(post.method.verb() + " " + post.url);
    print(post.headers.length.toString());
    print(post.body != null);

    print(describe(http.HttpError.NotAllowedOnHost));
    print(describe(http.HttpError.Network(message: "refused")));
    print(describe(http.HttpError.Timeout));
}

//// Decision 567 — a type error inside an associated type a decorator declared
//// is located at the annotation on the declaration that added it, naming the
//// type by its owner's path (`City.Columns`); the `called from` line names the
//// decorator's `decl.addType` call.

import {compiler, io.terminal.print} from "std";

fn columns(syntax decl: unknown) -> void {
    compiler.addType("Columns", compiler.buildType("(id: Missing)"));
}

#[columns]
pub type City(name: string)

pub fn main() -> void {
    print(City(name: "a").name);
}

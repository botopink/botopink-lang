//// Decision 492 — every abort the program raises itself is `panic`: a
//// `@todo` and `x!` over `null` as a `panic` is (`modules/std_failure_attempt`).
//// `attempt` contains each, and the program goes on, an integer overflow
//// (decision 264) too. The cell claims the kind alone; the message of each is
//// its abort's text.

import {failure, failure.Failure, failure.panic, io.terminal.print} from "std";

fn notReady() -> i32 {
    panic("not ready");
}

fn bump(a: i32) -> i32 {
    return a + 1;
}

fn find(key: string) -> ?i32 {
    return if (key == "a") 1 else null;
}

fn show(r: Result<i32, Failure>) -> void {
    case r {
        Ok(v) -> print("Ok " + v.toString());
        Error(f) -> print("Error " + f.kind);
    }
}

pub fn runCase() -> void {
    show(failure.attempt({ -> notReady() }));
    show(failure.attempt({ -> find("a")! }));
    show(failure.attempt({ -> find("b")! }));
    show(failure.attempt({ -> bump(2147483647) }));
    show(failure.attempt({ -> bump(1) }));
    print("after");
}

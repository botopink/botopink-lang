//// Decision 926 — a method answering `Component<R>` named `use` followed by an
//// upper-case letter spells the verb twice: it is refused at its name,
//// `hook-name-use-prefix`, as a `fn` is.

import {context.Scope, io.terminal.print} from "std";

type Box(start: i32) {
    component fn useCounter(self: Self) -> Component<i32> {
        return self.start;
    }
}

pub fn main() -> void {
    print("unreachable");
}

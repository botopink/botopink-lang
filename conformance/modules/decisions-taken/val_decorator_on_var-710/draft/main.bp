//// Decision 710 — A user decorator on a module `var` is refused at the annotation (`` `#[mark]` annotates the module `var` `count`, and a decorator runs on a `val`, never on a `var` ``); `#[beamMemory(…)]` is untouched.

import {io.terminal} from "std";
import {beam.beamMemory} from "std";
import {comptime.marks.mark};

#[beamMemory(.PersistentTerm)]
var mode = "prod";

#[mark]
val limit = 10;

#[mark]
var count = 1;

pub fn main() -> void {
    terminal.print(mode, limit, count);
}

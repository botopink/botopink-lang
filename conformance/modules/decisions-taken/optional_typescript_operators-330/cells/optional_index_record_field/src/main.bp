//// Decision 330 — `xs?.[i]` over an optional array of records answers the
//// record, or nothing: a field read off it by `?.` or `!` finds the record's
//// own slot, even when another record declares a field of the same name.

import {io.terminal.print} from "std";

type Field(name: string, message: ?string)

type Label(name: string, id: i32)

fn fields(k: i32) -> ?Field[] {
    if (k == 0) return null;
    return [Field(name: "email", message: null)];
}

pub fn main() -> void {
    val some = fields(1);
    val first = some?.[0];
    print(first?.name ?? "no field");
    print(first!.name);
    print(first?.message ?? "no message");
    val none = fields(0);
    val missing = none?.[0];
    print(missing?.name ?? "no field");
    print(Label(name: "tag", id: 1).name);
}

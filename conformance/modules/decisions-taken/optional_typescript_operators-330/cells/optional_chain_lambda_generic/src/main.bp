//// Decision 330 — a `?.` chain in a lambda whose parameter a generic function
//// types (`apply<T, R>(x: T, f: fn(T) -> R)` with `T = ?Holder`), where another
//// record declares a field of the same name: the chain answers the same present
//// or absent value as it does outside the lambda, on every target.

import {io.terminal.print} from "std";

type Entry(name: string)

type Holder(entry: ?Entry)

type Owner(holder: ?Holder)

type Other(entry: string)

fn apply<T, R>(x: T, f: fn(T) -> R) -> R {
    return f(x);
}

pub fn main() -> void {
    val o = Owner(holder: Holder(entry: Entry(name: "a")));
    val e = Owner(holder: Holder(entry: null));
    print(apply(o.holder, { h -> h?.entry?.name ?? "none" }));
    print(apply(e.holder, { h -> h?.entry?.name ?? "none" }));
    print(Other(entry: "x").entry);
}

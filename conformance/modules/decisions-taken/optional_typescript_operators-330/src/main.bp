//// A module checking itself (decision 989): each case is a package under `cases/`, loaded at build,
//// run in this program and compared with its section of `snapshot/main.snap`; a difference writes
//// `snapshot/main.snap.new` and `main` answers `Error`. Nothing here accepts a candidate.

import {compiler, io.terminal.print} from "std";
import {adapter, candidate, observe, records} from "conformance-lib";

/// The snapshot, read as a build input (decision 989 (5)).
val accepted: string = @embed("snapshot/main.snap").text();

/// What each case answered, in the order the cases ran.
var answers: observe.Observed[] = [];

/// One case, expanded where it is called (decision 808 (2)): a refused load answers its
/// diagnostics, a loaded one runs and answers its output.
fn runCase(comptime name: string) -> void {
    val loaded = try comptime compiler.load("cases/" + name) catch { r ->
        compiler.init({ ->
            var refusals: records.Refusal[] = [];
            for (r.diagnostics) { d ->
                refusals.push(observe.refusalOf(d.code, d.message, d.file, d.line, d.column, d.label, adapter.frames(d)));
            }
            answers.push(observe.refusedAnswer(name, adapter.buildOutput(r.module), refusals));
        });
        return;
    };
    compiler.init({ ->
        val ran = adapter.ranOf(loaded.run());
        answers.push(observe.ranAnswer(name, adapter.buildOutput(loaded), ran.printed, ran.failed, ran.failure));
    });
}

comptime {
    runCase("optional_enum_method_call");
    runCase("optional_float_function_value");
    runCase("optional_if_null_initializer");
    runCase("optional_member_default");
    runCase("optional_method_absent_receiver");
    runCase("optional_operators");
    runCase("optional_record_method_absent_receiver");
    runCase("std_type_field_associated");
    runCase("assoc_type_named_like_member");
    runCase("bang_never_null");
    runCase("nullish_beside_logical");
    runCase("nullish_never_null");
    runCase("optional_has_no_methods");
    runCase("optional_operator_never_null");
    runCase("result_namespace_removed");
    runCase("nullish_default_namespace_call");
    runCase("nullish_optional_call_default");
    runCase("optional_array_at_record");
    runCase("optional_call_operator");
    runCase("optional_call_param_wasm");
    runCase("optional_call_plain_answers");
    runCase("optional_chain_absent_array_length");
    runCase("optional_chain_field_after_call");
    runCase("optional_chain_lambda_array_method");
    runCase("optional_chain_lambda_generic");
    runCase("optional_chain_nested_array");
    runCase("optional_chain_present_array_length");
    runCase("optional_chain_record_fields");
    runCase("optional_enum_method_absent_receiver");
    runCase("optional_index_record_field");
}

pub async fn main() -> Async<Result<void, string>> {
    return candidate.finish(accepted, answers, adapter.target(), (comptime compiler.src()).root);
}

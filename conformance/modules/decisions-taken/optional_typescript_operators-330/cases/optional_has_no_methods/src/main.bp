//// Decision 330 — `?T` has no methods: `unwrapOr` (like `map` and
//// `flatMap`) left it and stays on `Result`. `x ?? d` is the default.

import {io.terminal.print} from "std";

fn find(key: string) -> ?string {
    return if (key == "a") "found" else null;
}

pub fn main() -> void {
    print(find("b").unwrapOr("none"));
}

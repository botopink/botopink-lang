//// Decision 330 — `f?.(args)` calls the function an optional holds, and is
//// absent when the optional is, on every target.

import {io.terminal.print} from "std";

fn adder(present: bool) -> ?fn(i32) -> i32 {
    val add: fn(i32) -> i32 = { n -> n + 1 };
    return if (present) add else null;
}

pub fn main() {
    print(adder(true)?.(41) ?? 0);
    print(adder(false)?.(41) ?? -3);
}

//// Decision 330 — an `if` with a `null` arm is an optional: absent when that
//// arm is taken, the other arm's value when it is not — a present `0` or
//// `false` included — as a `val` / `var` initializer, an assignment and a
//// `return`, an `else if` chain and a float payload too, on every target.

import {io.terminal.print} from "std";

fn pick(c: bool) -> ?i32 {
    return if (c) 0 else null;
}

fn grade(n: i32) -> ?i32 {
    return if (n > 10) 2 else if (n > 5) 1 else null;
}

fn half(c: bool) -> ?f64 {
    return if (c) 0.5 else null;
}

pub fn runCase() -> void {
    val words = ["alpha", "be"];
    val n: ?i32 = if (words.length() > 5) 3 else null;
    val z: ?i32 = if (words.length() > 1) 0 else null;
    print(n ?? -1);
    print(z ?? -1);
    print(pick(false) ?? -1);
    print(pick(true) ?? -1);
    print(grade(20) ?? -1);
    print(grade(7) ?? -1);
    print(grade(1) ?? -1);
    print(half(true) ?? -1.0);
    print(half(false) ?? -1.0);
    var m: ?i32 = null;
    m = if (pick(true) != null) 0 else null;
    print(m ?? -1);
    val b: ?bool = if (words.length() > 5) false else null;
    print(b ?? true);
    print(n);
    print(z);
}

//// Decision 451 (3) — at comptime `io/random`'s seeded stream answers
//// through its `std:` cells (std-wasm's Mulberry32, the commonJS sidecar's
//// stream), on every target (decision 434 (5)): one seed, the same draws on
//// every build. The draws are lifted into the program as text.

import {io.terminal.print, io.random} from "std";

fn draws(s: i32) -> string {
    random.seed(s);
    val a = random.seededFloat();
    val b = random.seededFloat();
    random.seed(s);
    val again = random.seededFloat();
    return a.toString() + " " + b.toString() + " " + again.toString();
}

pub fn main() -> void {
    val atBuild = comptime draws(42);
    print(atBuild);
    val other = comptime draws(0 - 7);
    print(other);
}

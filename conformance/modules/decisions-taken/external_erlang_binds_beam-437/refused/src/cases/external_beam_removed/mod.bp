//// Decision 437 — `@External.Beam` is gone: the beam target reads
//// `@External.Erlang`, the same VM and the same OTP calls. Writing the old
//// variant binds no host and is a located error at the annotation, never an
//// alias.

import {compiler, io.terminal.print} from "std";

#[compiler.external(.Erlang("math:sqrt($0)"), .Beam("math", "sqrt"))]
declare fn root(x: f64) -> f64;

pub fn main() -> void {
    print(root(16.0));
}

//// Decision 806 (1), (2) — `run()` answers `Result<string, RunFailure>` and contains everything the
//// loaded package runs: a `panic` in the loaded module body is answered `.Abort` with the panic's
//// text, a `main` returning `Error(e)` is answered `.Failed` with `e`'s text, and nothing
//// propagates — the next `run()` still runs, and so does the program's `main`.

import {compiler, compiler.RunFailure, io.terminal.print} from "std";

// Decision 989 (1) — `run()` answers what the loaded package printed: each line of it is
// printed here, then, on a failure, its kind and message.
fn show(answer: Result<string, RunFailure>) -> void {
    case answer {
        Ok(text) -> shown(text);
        Error(r) {
            shown(r.output);
            case r.kind {
                .Failed -> print("failed " + r.message);
                .Abort -> print("abort " + r.message);
            }
        }
    }
}

fn shown(text: string) -> void {
    if (text != "") print(text.trimEnd());
}

// Expanded where the block calls it (decision 788): its load and its `compiler.init`
// are the block's.
fn runCase(comptime name: string) -> void {
    val loaded = comptime compiler.load("packages/" + name);
    case loaded {
        Ok(m) -> compiler.init({ ->
            print("== " + name);
            show(m.run());
            print("end " + name);
        });
        Error(refused) -> compiler.init({ -> print("refused " + refused.module.path()) });
    }
}

comptime {
    runCase("boom");
    runCase("err");
    runCase("fine");
}

pub fn main() -> void {
    print("main");
}

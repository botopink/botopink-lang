//// Decision 806 (3) — each `run()` starts clean whatever a `var` is stored in on the BEAM: an `Ets` var, an unannotated
//// `Dict` var and a `PersistentTerm` var of the loaded package start at their declaration on each run, so `hits` prints 1
//// and `counts.at("a")` 0 both times and the `PersistentTerm` var's initialiser runs at each run.

import {compiler, compiler.RunFailure, io.terminal.print} from "std";

// Decision 989 (1) — `run()` answers what the loaded package printed: each line of it is
// printed here, then, on a failure, the failure.
fn show(answer: Result<string, RunFailure>) -> void {
    case answer {
        Ok(text) -> shown(text);
        Error(f) {
            shown(f.output);
            print("abort " + f.message);
        }
    }
}

fn shown(text: string) -> void {
    if (text != "") print(text.trimEnd());
}

comptime {
    val loaded = comptime compiler.load("packages/memory");
    case loaded {
        Ok(m) -> compiler.init({ ->
            show(m.run());
            show(m.run());
        });
        Error(refused) -> print("refused");
    }
}

// The program's own `Ets` var: the annotation picks how the BEAM holds it and changes nothing elsewhere (547).
#[compiler.beamMemory(.Ets)]
var vezes: i32 = 0;

pub fn main() -> void {
    vezes = vezes + 1;
    print("main");
}

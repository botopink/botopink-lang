//// Decision 481 — `fn:` names a private fn of the module by its identifier,
//// never a string: `fn: "tanBody"` is refused at the argument, on every
//// target, naming the form to write.

import {compiler, io.terminal.print} from "std";

#[compiler.external(.JavaScript("Math.tan($0)"), .Erlang("math:tan($0)"), .Wasm(body: "tanBody"))]
pub declare fn tanOf(x: f64) -> f64;

fn tanBody(x: f64) -> f64 {
    return x;
}

pub fn main() -> void {
    print(tanOf(0.0));
}

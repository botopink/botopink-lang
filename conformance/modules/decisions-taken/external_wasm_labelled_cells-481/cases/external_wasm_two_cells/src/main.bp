//// Decision 481 — a wasm binding is one cell: an `op:` beside a `fn:` is
//// refused at the second, on every target.

import {compiler, io.terminal.print} from "std";

#[compiler.external(
    .JavaScript("Math.floor($0)"),
    .Erlang("math:floor($0)"),
    .Wasm(op: "f64.floor", body: floorBody),
)]
pub declare fn floorOf(x: f64) -> f64;

fn floorBody(x: f64) -> f64 {
    return x;
}

pub fn main() -> void {
    print(floorOf(2.7));
}

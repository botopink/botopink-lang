//// Decision 786 — `compiler.load(path)` answers `Result<compiler.Module, compiler.Refused>`:
//// the loaded file's `Module` on both sides — `name` the directory it sits in, `path` the
//// file relative to the package, no target (decision 805 (4)) — and, on a refusal, a
//// `Refused` holding that `Module` beside its `diagnostics`.

import {compiler, io.terminal.print} from "std";

fn show(m: compiler.Module) -> void {
    print("name=" + m.name);
    print("path=" + m.path);
}

pub fn main() -> void {
    // A file that compiles: `Ok(m)`.
    val fine = comptime compiler.load("src/cases/fine/mod.bp");
    print(fine.isOk());
    case fine {
        Ok(m) -> show(m);
        Error(r) -> print("never");
    }
    // A file that refuses: `Error(r)`, the same `Module` beside its refusals.
    val broken = comptime compiler.load("src/cases/broken/mod.bp");
    case broken {
        Ok(m) -> print("never");
        Error(r) {
            print(r.diagnostics.length > 0);
            print("refused " + r.module.path);
            print("refused name=" + r.module.name);
        }
    }
}

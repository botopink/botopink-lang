//// Decision 207 — a diagnostic about an inline parameter type names it by its
//// owner: a field the type does not declare is read off `the props of
//// `link``.

import {io.terminal.print} from "std";

fn link(props: type(href: string)) -> string {
    return props.label;
}

pub fn main() -> void {
    print(link(href: "/a"));
}

//// Decision 980 — a `?T` is matched by `null` and `_` alone, the value read `x!`
//// (330): a binder arm (`case x { null { … } v { … } }`) is refused
//// `case-bare-name-arm` at `v` (602), like a name alone in any other arm.

import {io.terminal.print} from "std";

pub fn main() -> void {
    val x: ?i32 = 5;
    val a = case x {
        null {
            "absent"
        }
        v {
            "present " + v.toString()
        }
    };
    print(a);
}

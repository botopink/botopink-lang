//// Decision 980 — a `?T` is matched by `null` and `_` alone: a variant pattern
//// over a `?T` (`.Some(v)`, `.None`) is a located error at the pattern, naming
//// the `null` and `_` form (980 (2)).

import {io.terminal.print} from "std";

pub fn main() -> void {
    val x: ?i32 = 5;
    val a = case x {
        .Some(v) {
            "present " + v.toString()
        }
        .None {
            "absent"
        }
    };
    print(a);
}

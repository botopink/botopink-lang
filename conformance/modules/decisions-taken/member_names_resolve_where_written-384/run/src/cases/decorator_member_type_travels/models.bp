//// `#[check]` gives `Signup` a member whose signature names `rules`'s
//// `Violation`, which this module never imports.

import {cases.decorator_member_type_travels.rules.check};

fn passwordsMatch(a: Signup) -> bool {
    return a.password == a.confirm;
}

#[check(passwordsMatch)]
pub type Signup(password: string, confirm: string)

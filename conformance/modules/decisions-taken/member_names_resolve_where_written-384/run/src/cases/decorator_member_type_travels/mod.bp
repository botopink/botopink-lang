//// Decision 384 — the member travels with its type: an importer of
//// `Signup` calls `validate()`, whose signature names `rules`'s `Violation`
//// as declared (the alias the member was checked under is the annotated
//// module's alone), and reads the violations' fields.

pub mod rules;
pub mod models;
import {cases.decorator_member_type_travels.models.Signup};
import {io.terminal.print} from "std";

pub fn runCase() -> void {
    val vs = Signup(password: "a", confirm: "b").validate();
    print(vs.length);
    for v in vs {
        print(v.field + ": " + v.message);
    }
}

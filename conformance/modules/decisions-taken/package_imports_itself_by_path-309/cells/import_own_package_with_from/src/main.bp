//// Decision 309 — inside a package, `from "<its own name>"` is refused as 206
//// refuses `from "<a module of this package>"`: at the source string, the
//// fix written. This package is `import_own_package_with_from`; its module `geometry` is imported
//// by its path inside the braces, with no `from`. No package is exempt — std
//// imports its own modules the same way (`import {path.relative};`).

pub mod geometry;
import {geometry.area} from "import_own_package_with_from";
import {io.terminal.print} from "std";

pub fn main() -> void {
    print(area(3, 4));
}

//// Decisions 723, 755 — a component that provides a value made at run time
//// makes its context with `use memo`: `val c = use memo({ ->
//// createContext(Theme(…)) }); use provide(c);`. `Label` reads it through
//// the handle it imports, `themeContext`; with no provider above it reads
//// the handle's default. The context is made on the first render of the
//// memo's cell and kept while it stands: `page` run twice over one root makes
//// it once (decision 816).

pub mod theme;

import {theme.Theme, theme.themeContext};
import {context.run, context.Scope, context.createContext, context.provide, context.context, hooks.memo, io.terminal.print} from "std";

type Element(text: string)

component fn Label() -> Component<Element> {
    val t = use context(themeContext);
    return Element(text: t.mode);
}

component fn Page(mode: string) -> Component<Element> {
    val c = use memo({ ->
        print("made " + mode);
        createContext(Theme(mode: mode))
    });
    use provide(c);
    val l = use Label();
    return Element(text: l.text);
}

pub async fn main() -> Async<void> {
    val outside = await run(Label());
    print(outside.text);
    val root = Scope.root();
    defer root.close();
    val page = Page("dark");
    val first = await run(page, root);
    print(first.text);
    val again = await run(page, root);
    print(again.text);
    val other = await run(Page("sepia"));
    print(other.text);
}

//// Decision 308 — `Type.keys(Recipe)` names `Type.Field<Recipe>`: the field
//// keys of `Recipe`, exported like any type.

import {types.Type} from "std";

pub type Recipe(title: string, description: ?string, servings: i32)

pub val RecipeKey = Type.keys(Recipe);

// Exhaustive over `Recipe`'s fields: a field added to `Recipe` makes this
// `case` an error until it has its arm.
pub fn describe(r: Recipe, key: RecipeKey) -> string {
    return case key {
        .title -> r.title;
        .description -> r.description ?? "-";
        .servings -> r.servings.toString();
    };
}

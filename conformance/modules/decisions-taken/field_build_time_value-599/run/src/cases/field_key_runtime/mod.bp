//// Decision 308 — a `Type.Field<T>` is a run-time value: stored, passed and
//// compared; `case key { .title -> … }` exhaustive over `T`'s fields (or
//// closed by `_`, alternatives with `|`); `key.name`; `RecipeKey.of(text)`
//// the key named `text` or `null`; `RecipeKey.all()` every key in declaration
//// order — through an import of the alias, on all four targets.

pub mod recipes;

import {cases.field_key_runtime.recipes.Recipe, cases.field_key_runtime.recipes.RecipeKey, cases.field_key_runtime.recipes.describe};
import {io.terminal.print} from "std";

fn isText(key: RecipeKey) -> bool {
    return case key {
        .title | .description -> true;
        _ -> false;
    };
}

pub fn runCase() {
    val r = Recipe(title: "Feijoada", description: null, servings: 6);
    // Stored and passed.
    var key: RecipeKey = .title;
    print(describe(r, key));
    key = .servings;
    print(describe(r, key));
    print(describe(r, .description));
    val keys: RecipeKey[] = [.servings, .title];
    print(keys.map({ k -> k.name }).join(","));
    // Compared.
    print(key == .servings);
    print(key == .title);
    print(keys[1] == RecipeKey.all()[0]);
    print(isText(.description));
    print(isText(key));
    // Read from outside by its name.
    val found = RecipeKey.of("description") ?? .title;
    print(found.name);
    print(RecipeKey.of("nope") == null);
    print((RecipeKey.of("servings") ?? .title) == .servings);
    // Every key, in declaration order.
    print(RecipeKey.all().map({ k -> k.name }).join(","));
    print(RecipeKey.all().map({ k -> describe(r, k) }).join(" | "));
}

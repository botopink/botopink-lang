//// Decision 864 (5) — a method takes a record parameter as a function does:
//// the labels name `R`'s fields and the method's other parameters, a spread
//// is packed into one `R(…)` at the call, and a positional argument counts
//// the other parameters only (`self` is not one).

import {io.terminal.print} from "std";

type CardProps(title: string, featured: bool = false, size: i32 = 1)

pub type Shelf(name: string) {
    pub fn add(self: Self, ..props: CardProps, suffix: string) -> string {
        val mark = if (props.featured) "*" else "";
        return "${self.name}/${props.title}${mark}:${props.size}${suffix}";
    }
}

pub fn main() -> void {
    val s = Shelf(name: "s");
    print(s.add(title: "a", suffix: "!"));
    print(s.add(title: "b", featured: true, size: 3, suffix: "?"));
    val base = CardProps(title: "c", size: 7);
    print(s.add(..base, suffix: "."));
    print(s.add("#", title: "d"));
}

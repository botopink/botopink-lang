//// Decision 864 (5) — an associated function (no `self`) takes a record
//// parameter as a function does: `T.make(title: "a")`, `T.make(..p)`.

import {io.terminal.print} from "std";

type CardProps(title: string, featured: bool = false, size: i32 = 1)

pub type Maker(tag: string) {
    pub fn label(prefix: string, ..props: CardProps) -> string {
        return "${prefix}:${props.title}:${props.size}";
    }
}

pub fn main() -> void {
    print(Maker.label("p", title: "a"));
    val base = CardProps(title: "c", size: 7);
    print(Maker.label("q", ..base));
    print(Maker.label(title: "z", prefix: "r", size: 2));
}

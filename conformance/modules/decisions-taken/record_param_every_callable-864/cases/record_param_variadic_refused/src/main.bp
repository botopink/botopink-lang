//// Decision 864 (4) — a record parameter beside a variadic is refused
//// `record-param-variadic`, on a method as on a function; at the variadic.

import {io.terminal.print} from "std";

type CardProps(title: string)

pub type Shelf(name: string) {
    pub fn add(self: Self, ..props: CardProps, ..rest: string[]) -> string {
        return props.title;
    }
}

pub fn main() -> void {
    print(Shelf(name: "s").add(title: "a"));
}

//// The module's one package (decisions 789 (4), 982 (5)): each case is a package under `cases/`,
//// loaded at build by `runCase`; a refused case prints its refusals, a running one runs its `main`.

import {compiler, io.terminal.print} from "std";

fn runCase(comptime name: string) -> void {
    print("== " + name + " comptime");
    val loaded = try comptime compiler.load("cases/" + name) catch { r ->
        compiler.init({ ->
            print("== " + name);
            for (r.diagnostics) { d ->
                val bracket = d.code != "" && !d.message.startsWith(d.code + ":");
                print(if (bracket) "refused error[" + d.code + "]: " + d.message else "refused error: " + d.message);
                print("at " + d.file + ":" + d.line.toString() + ":" + d.column.toString());
                if (d.label) { l -> print("label " + l); }
            }
        });
        return;
    };
    compiler.init({ ->
        print("== " + name);
        try loaded.run() catch { f -> print("abort " + f.message) }
    });
}

comptime {
    runCase("block_for_return_leaves_function");
    runCase("block_partial_return");
    runCase("block_reassigns_enclosing_var");
    runCase("block_return_leaves_function");
    runCase("block_tail_value");
    runCase("block_value_reassigns_enclosing_var");
    runCase("trailing_lambda_call");
    runCase("block_argument_not_function");
    runCase("block_builtin_removed");
    runCase("block_trailing_not_function");
    runCase("block_void_value_refused");
    runCase("case_arm_no_value");
    runCase("comptime_block_break_value");
    runCase("async_block_tail_case");
}

pub fn main() -> void {}

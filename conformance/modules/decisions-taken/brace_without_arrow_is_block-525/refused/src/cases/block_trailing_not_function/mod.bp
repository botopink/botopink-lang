//// Decision 525 — a trailing `{` without `->` is a block, never a closure; a
//// trailing position expects a function, so it is refused at the block with
//// the hint "missing `->`?". A trailing lambda with no parameter is written
//// `f(x) { -> … }`.

import {io.terminal.print} from "std";

pub fn main() -> void {
    val xs = [1, 2];
    xs.forEach { print("each") };
}

//// Decision 525 — a trailing lambda fills the last function-typed parameter of
//// a call, a method's or a plain function's; with no parameter it is written
//// `{ -> … }`.

import {io.terminal.print} from "std";

type Box(base: i32) {
    fn run(self: Self, f: fn() -> i32) -> i32 {
        return self.base + f();
    }
    fn through(self: Self, f: fn(i32) -> i32) -> i32 {
        return f(self.base);
    }
    fn add(self: Self, n: i32, f: fn() -> i32) -> i32 {
        return n + f();
    }
}

fn twice(f: fn() -> i32) -> i32 {
    return f() * 2;
}

fn apply(x: i32, f: fn(i32) -> i32) -> i32 {
    return f(x);
}

fn withBase(x: i32, f: fn() -> i32) -> i32 {
    return x + f();
}

pub fn runCase() -> void {
    val b = Box(base: 1);
    print(b.run { -> 10 });
    print(b.through { m -> m + 5 });
    print(b.add(2) { -> 3 });
    print(twice { -> 4 });
    print(apply(3) { k -> k * 3 });
    print(withBase(5) { -> 6 });
}

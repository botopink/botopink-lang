//// Decision 525 — a `return` in a block leaves the enclosing function: a
//// block is a scope, never a closure. From the block's own statements, from a
//// `case` arm at its end, from a nested block and from a block inside a
//// `for` body; a statement block's bare `return` ends a function answering
//// nothing. `@block`'s `return` was the block's value
//// (`modules/block_builtin_removed`).

import {io.terminal.print} from "std";

fn grade(n: i32) -> string {
    val label = {
        if (n > 5) return "high";
        "low"
    };
    return label + "!";
}

fn classify(n: i32) -> string {
    val s = {
        case n {
            0 {
                return "zero";
            }
            _ {
                "other"
            }
        }
    };
    return s + "?";
}

fn nested(n: i32) -> i32 {
    val a = {
        val b = {
            if (n < 0) return 0;
            n + 1
        };
        b * 10
    };
    return a;
}

fn skipTwo() -> i32 {
    var total = 0;
    for ([1, 2, 3]) { x ->
        val v = {
            if (x == 2) return 100 + total;
            x
        };
        total = total + v;
    }
    return total;
}

fn early() -> void {
    {
        print("inside");
        return;
    }
    print("never");
}

pub fn main() -> void {
    print(grade(9));
    print(grade(1));
    print(classify(0));
    print(classify(3));
    print(nested(4));
    print(nested(-1));
    print(skipTwo());
    early();
    print("after");
}

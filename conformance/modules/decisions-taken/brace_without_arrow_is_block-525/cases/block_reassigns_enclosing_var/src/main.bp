//// Decision 525 — a block that reassigns a `var` of the enclosing function:
//// a plain reassignment, seen after the block on every target (erlc refused
//// the module when the block was a fun, `Acc@1` unbound).

import {io.terminal.print} from "std";

pub fn main() -> void {
    var acc = 1;
    {
        acc = acc + 5;
    }
    print(acc);
}

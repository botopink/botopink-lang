//// Decision 442 — `wat_prelude` keeps only what defines a value's representation or talks to the host; everything that only computes over values is Zig, transpiled as std-wasm is (440).

import {io.random, io.terminal.print} from "std";

pub fn main() -> void {
    val text = "  Mixed Case, words  ";
    print(text.trim().toUpper());
    print(text.trim().split(", "));
    print("a-b-c".replace("-", "+"));
    print("7".padStart(3, "0"));
    print("abcabc".lastIndexOf("b"));

    print(1.5.toString());
    print((1l + 2147483647l).toString());
    print(1.0e21);

    val xs = [3, 1, 3, 2];
    print(xs.reverse());
    print(xs.unique());
    print(xs.slice(1, 3));
    print(xs.map({ x -> x.toString() }).join("|"));

    random.seed(42);
    val first = random.seededFloat();
    random.seed(42);
    print(first == random.seededFloat());
}

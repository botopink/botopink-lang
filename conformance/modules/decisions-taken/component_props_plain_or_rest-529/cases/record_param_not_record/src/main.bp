//// Decision 529 (2) — `..props: R` needs `R` a record type: the fields of an
//// enum are no parameters. Refused at the declaration, at the type.

import {io.terminal.print} from "std";

type Color {
    Red,
    Green,
}

fn paint(..props: Color) -> string {
    return "x";
}

pub fn main() -> void {
    print(paint());
}

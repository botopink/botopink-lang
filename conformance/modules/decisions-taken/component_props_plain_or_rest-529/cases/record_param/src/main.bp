//// Decision 529 (2) — `..props: R`, `R` a record type: R's fields are the
//// function's parameters from outside — a call passes them by label, a field
//// with a default may be left out — and the body reads them as the record
//// `props`. The record parameter sits beside other parameters, which a call
//// passes as it always did. A spread (`Card(..p, featured: true)`) is legal
//// into a record parameter, `p` of its type or one derived from it (359).

import {types.Type, io.terminal.print} from "std";

type CardProps(title: string, featured: bool = false, size: i32 = 1)

val CardBrief = Type.pick(CardProps, .title, .size);

fn Card(..props: CardProps, suffix: string) -> string {
    val mark = if (props.featured) "*" else "";
    return "${props.title}${mark}:${props.size}${suffix}";
}

fn Badge(count: i32, ..props: CardProps) -> string {
    return "${props.title}x${count}";
}

pub fn main() -> void {
    // The fields by label, a default left out, the other parameter by label.
    print(Card(title: "a", suffix: "!"));
    print(Card(title: "b", featured: true, size: 3, suffix: "?"));
    // The labels in any order; the other parameter by position.
    print(Badge(2, title: "c"));
    print(Badge(title: "d", count: 5));
    // A spread of the record's own type, a label after it winning.
    val base = CardProps(title: "e", size: 7);
    print(Card(..base, suffix: "."));
    print(Card(..base, featured: true, suffix: "."));
    // A spread of a derived type.
    val brief = CardBrief(title: "f", size: 9);
    print(Card(..brief, suffix: ";"));
    print(Badge(1, ..base));
}

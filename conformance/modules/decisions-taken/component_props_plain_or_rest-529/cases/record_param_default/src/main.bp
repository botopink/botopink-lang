//// Decision 529 (2) — a record parameter takes no default: the defaults are
//// its record type's fields'. Refused at the `=`.

import {io.terminal.print} from "std";

type CardProps(title: string)

fn Card(..props: CardProps = CardProps(title: "a")) -> string {
    return props.title;
}

pub fn main() {
    print(Card());
}

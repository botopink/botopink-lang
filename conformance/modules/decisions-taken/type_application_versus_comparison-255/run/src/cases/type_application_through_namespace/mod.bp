//// Decision 255 (1) through a module namespace — `collections.Dict<string,
//// i32>.empty()` and `shapes.Box<i32>.make(7)`: the type's name reached by
//// `ns.Type` takes a type application as a bare type name does, the list
//// closing on `.` after an upper-case member. The first line was
//// `unexpected ','` before (the list was read as a comparison after a
//// namespace).

import {collections, io.terminal.print} from "std";

pub mod shapes;

pub fn runCase() -> void {
    val d = collections.Dict<string, unknown>.empty();
    print(d.size());
    val e = collections.Dict<string, i32>.empty().insert("a", 1).insert("b", 2);
    print(e.size());
    print(shapes.Box<i32>.make(7).get());
    val none = shapes.Opt<string>.None;
    print(none == shapes.Opt<string>.None);
    val some = shapes.Opt<i32>.Some(3);
    val n = case some {
        Some(v) -> v;
        None -> 0;
    };
    print(n);
}

//// Decision 255 (2) — `comptime <expr>` is the block whose tail is
//// `<expr>`, so its type is the expression's: a `string` under an expected
//// `i32` is the mismatch, located at `comptime` as the block form's is.

import {io.terminal.print} from "std";

pub fn main() -> void {
    val n: i32 = comptime "text";
    print(n);
}

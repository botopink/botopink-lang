//// Decision 409 — a function expression's last expression written without
//// `;` is its value, typed (`fn(x: i32) -> i32 { x + 1 }`) or not, and so is
//// a lambda's (`{ x -> x + 1 }`).

import {io.terminal.print} from "std";

pub fn runCase() {
    val inc = fn(x: i32) -> i32 { x + 1 };
    print(inc(1));
    val half = fn(x: i32) -> i32 {
        if (x < 0) return 0;
        x / 2
    };
    print(half(9));
    print(half(-3));
    val double: fn(i32) -> i32 = fn(x) { x * 2 };
    print(double(4));
    val labels = [1, 2].map(fn(n: i32) -> string { "#" + n.toString() });
    print(labels.join(" "));
    val square: fn(i32) -> i32 = { x -> x * x };
    print(square(5));
}

//// Decision 409 — in a body answering nothing (no `-> R`, or `-> void`) a tail
//// of type `void` is accepted: a call answering nothing, written without `;`,
//// in a function, a method and a lambda.

import {io.terminal.print} from "std";

fn say(s: string) { print(s) }

fn shout(s: string) -> void { say(s + "!") }

type Logger(prefix: string) {
    fn log(self: Self, s: string) { print(self.prefix + s) }
}

pub fn runCase() {
    say("hi");
    shout("hey");
    Logger(prefix: "> ").log("done");
    [1, 2].forEach({ n -> print(n) });
}

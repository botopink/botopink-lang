//// Decisions 408, 409 — the typed member `decl.addMember(name, fn(self: T) ->
//// R { … })` answers its tail like any function expression.

import {compiler, io.terminal.print} from "std";

fn sized<T>(syntax decl: T) {
    compiler.addMember("size", fn(self: T) -> i32 { self.name.length + 1 });
}

#[sized]
pub type Account(name: string)

pub fn runCase() {
    print(Account(name: "abc").size());
}

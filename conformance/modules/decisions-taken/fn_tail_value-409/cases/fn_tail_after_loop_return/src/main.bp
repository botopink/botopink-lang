//// Decision 409 — an early `return` from inside a loop or a `case` arm leaves
//// the function; the body's last expression written without `;` is its value
//// on every other path: after a `for`, a statement `case` and a `while`.

import {io.terminal.print} from "std";

fn firstNegative(xs: i32[]) -> i32 {
    for (xs) { x ->
        if (x < 0) return x;
    }
    0
}

fn describe(n: i32) -> string {
    case n {
        0 {
            return "zero";
        }
        _ {}
    }
    "n=" + n.toString()
}

fn countdown(n: i32) -> string {
    var i = n;
    while (i > 0) {
        if (i == 2) return "stopped at 2";
        i = i - 1;
    }
    "reached " + i.toString()
}

pub fn main() -> void {
    print(firstNegative([3, -4, -5]));
    print(firstNegative([1, 2]));
    print(describe(0));
    print(describe(7));
    print(countdown(5));
    print(countdown(1));
}

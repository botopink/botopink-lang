//// The owners. Their associated types are declared here by the decorators
//// and travel with them.

import {cases.decorator_add_type_import.kit.entity, cases.decorator_add_type_import.kit.double};

#[entity]
pub type City(name: string, people: i32)

#[double]
pub behavior Greeter {
    fn greet(self: Self) -> string;
}

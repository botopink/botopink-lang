//// The module's one package (decisions 789 (4), 982 (5)): each case is a package under `cases/`,
//// loaded at build by `runCase`; a refused case prints its refusals, a running one runs its `main`.

import {compiler, io.terminal.print} from "std";

fn runCase(comptime name: string) -> void {
    print("== " + name + " comptime");
    val loaded = try comptime compiler.load("cases/" + name) catch { r ->
        compiler.init({ ->
            print("== " + name);
            for (r.diagnostics) { d ->
                val bracket = d.code != "" && !d.message.startsWith(d.code + ":");
                print(if (bracket) "refused error[" + d.code + "]: " + d.message else "refused error: " + d.message);
                print("at " + d.file + ":" + d.line.toString() + ":" + d.column.toString());
                if (d.label) { l -> print("label " + l); }
            }
        });
        return;
    };
    compiler.init({ ->
        print("== " + name);
        try loaded.run() catch { f -> print("abort " + f.message) }
    });
}

comptime {
    runCase("decorator_add_member_duplicate");
    runCase("decorator_add_member_not_one");
    runCase("decorator_add_member_on_fn");
    runCase("decorator_add_type_duplicate");
    runCase("decorator_add_type_name");
    runCase("decorator_add_type_not_one");
    runCase("decorator_add_type_without_owner");
    runCase("decorator_member_unknown");
    runCase("decorator_meta_on_member");
    runCase("typeinfo_all_arguments");
    runCase("typeinfo_all_mixed");
    runCase("typeinfo_all_needs_member");
    runCase("typeinfo_unknown_declaration");
    runCase("typeinfo_all_imported");
}

pub fn main() -> void {}

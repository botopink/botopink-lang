//// Decision 810 (2) — a value narrowed out of a union is read as the member it
//// was narrowed to: `k.tag` after `if (k is A)`, and in a `case` arm with a
//// type pattern, answers the field on every target.

import {io.terminal.print} from "std";

type A(tag: i32, label: string)

type B(size: i32)

fn byTest(k: A | B) -> void {
    if (k is A) {
        print(k.tag);
        print(k.label);
    } else print(k.size);
}

fn byCase(k: A | B) -> void {
    case k {
        A { a ->
            print(a.tag + 1);
        }
        B { b ->
            print(b.size + 1);
        }
    }
}

pub fn runCase() -> void {
    byTest(A(tag: 7, label: "seven"));
    byTest(B(size: 9));
    byCase(A(tag: 7, label: "seven"));
    byCase(B(size: 9));
}

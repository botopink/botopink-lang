//// Decision 734 — (a): `compiler.src()` in a decorator body is legal and answers the annotated declaration's location (718, 575 (3)); 403 survives as "no route from a file's location".

mod marks;
import {marks.located, marks.Declared};
import {compiler, io.terminal.print} from "std";

#[located]
pub type Invoice(total: i32)

#[located]
pub fn render(i: Invoice) -> string {
    return "total " + i.total.toString();
}

fn where(d: ?Declared) -> string {
    val at = d ?? Declared(file: "unknown", line: 0, column: 0);
    return at.file + ":" + at.line.toString() + ":" + at.column.toString();
}

pub fn main() -> void {
    print(where(comptime compiler.typeInfo(Invoice).meta(Declared)));
    print(where(comptime compiler.typeInfo(render).meta(Declared)));
    print(render(Invoice(total: 3)));
}

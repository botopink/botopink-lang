//// Decision 577 (1), 14s8-a (e) — an error in the code a template builds
//// from a `${…}` hole is located at the hole's own expression in the
//// caller's text: the text starts after the two-byte opening `` @` ``, and
//// `missing`, unbound, is refused at its first byte.

import {compiler, io.terminal.print} from "std";

fn cssValue(v: string) -> string {
    return v;
}

fn quoted(text: string) -> string {
    return "\"" + text.split("\n").join("\\n") + "\"";
}

fn css(syntax q: string) -> string {
    var code = "\"\"";
    var first = true;
    for (compiler.text(q).split("\${")) { piece ->
        if (first) {
            code = code + " + " + quoted(piece);
            first = false;
        } else {
            val close = piece.indexOf("}");
            code = code
                + " + cssValue("
                + piece.slice(0, close)
                + ") + "
                + quoted(piece.slice(close + 1));
        }
    }
    return compiler.build(code);
}

pub fn main() -> void {
    print(css @`color: ${missing};`);
}

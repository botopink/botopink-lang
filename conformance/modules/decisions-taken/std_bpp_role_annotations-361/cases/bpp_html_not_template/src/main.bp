//// Decision 361 — `#[bpp.html]` marks a template function answering
//// `@ExprCustom<R>` (275 reads `R` from it): a plain function is refused at
//// the annotation, naming what it answers.

import {bpp, io.terminal.print} from "std";

#[bpp.html]
pub fn page() -> i32 {
    return 1;
}

pub fn main() -> void {
    print(page());
}

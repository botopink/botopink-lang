//// Decision 792 (6) — `run()` called twice on one `Module` runs `main` twice, in one
//// package.

import {compiler, io.terminal.print} from "std";

comptime {
    val loaded = comptime compiler.load("src/cases/once/mod.bp");
    case loaded {
        Ok(m) -> compiler.init({ ->
            try m.run() catch { f ->
                print("abort " + f.message)
            }
            try m.run() catch { f ->
                print("abort " + f.message)
            }
        });
        Error(r) -> print("refused");
    }
}

pub fn main() {
    print("main");
}

//// Decision 792 (4), (7) — `run()` on a local alias of the captured `Module`, written directly
//// in the `compiler.init` body, runs the loaded file's `main`: `run-outside-init` names a
//// place, never a receiver.

import {compiler, io.terminal.print} from "std";

comptime {
    val loaded = comptime compiler.load("src/cases/fine/mod.bp");
    case loaded {
        Ok(m) -> compiler.init({ ->
            val m2 = m;
            try m2.run() catch { f ->
                print("abort " + f.message)
            }
        });
        Error(r) -> print("refused");
    }
}

pub fn main() -> void {
    print("main");
}

//// Decision 735 — an optional function-typed `comptime` argument is tested
//// against `null` as any `?T` is: `if (rule == null) { … }`, the function
//// type no exception. A decorator tells `#[check("…")]` on a rule function
//// from `#[check("…", rule)]` on a type by it; an ordinary function's
//// `comptime` parameter is tested the same way.

import {compiler, io.terminal.print} from "std";

fn check(syntax decl: unknown, comptime message: string, comptime rule: ?fn(v: i32) -> bool = null) -> void {
    if (rule == null)
        compiler.init({ -> print(compiler.name(decl) + ": " + message + ", by itself") })
    else
        compiler.init({ -> print(compiler.name(decl) + ": " + message + ", by a rule") });
}

fn positive(v: i32) -> bool {
    return v > 0;
}

#[check("not zero")]
pub fn nonZero(v: i32) -> bool {
    return v != 0;
}

#[check("positive", positive)]
pub type Amount(v: i32)

fn describe(comptime rule: ?fn(v: i32) -> bool) -> string {
    if (rule == null) return "no rule";
    return "a rule";
}

pub fn main() -> void {
    print(describe(null));
    print(describe(positive));
}

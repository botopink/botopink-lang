//// Decision 735 — (a): an optional function-typed `comptime` argument is tested against `null` as any `?T` is — `if (rule == null) { … }` — the function type no exception.

import {io.terminal} from "std";

fn isPositive(n: i32) -> bool {
    return n > 0;
}

// `rule` is an optional function known at build: `describe` tells "no rule"
// from a rule by comparing it with `null`, as for any `?T`.
fn describe(comptime rule: ?fn(i32) -> bool, value: i32) -> string {
    if (rule == null) return "unchecked " + value.toString();
    return if (rule!(value)) "valid" else "invalid";
}

pub fn main() -> void {
    terminal.print(describe(isPositive, 3));
    terminal.print(describe(isPositive, -1));
    terminal.print(describe(null, 5));
}

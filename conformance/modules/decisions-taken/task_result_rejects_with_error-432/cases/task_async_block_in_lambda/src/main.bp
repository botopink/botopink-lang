//// Decision 432 — an `async { }` block that throws is a failing task, and it
//// reads back as `Error(e)` at its `await` wherever the block sits: in a
//// lambda, in a nested function, in a method, or in a lambda inside a
//// method. The block is not the body of a function declared `-> Async<…>`,
//// so its failure comes from the block itself. The beam target answered `ok`
//// for the lambda's task, because the block's `throw` left the lambda as a
//// bare Erlang `throw`.

import {io.terminal.print} from "std";

type Worker(id: i32) {
    fn start(self: Self, n: i32) -> Task<Result<i32, string>> {
        return async {
            if (n < 0) throw "method " + n.toString();
            return n + 10;
        };
    }

    fn lazyStart(self: Self) -> fn(n: i32) -> Task<Result<i32, string>> {
        return { n ->
            async {
                if (n < 0) throw "method lambda";
                return n + 10;
            }
        };
    }
}

fn show(r: Result<i32, string>) {
    case r {
        Ok(v) -> print("ok", v);
        Error(e) -> print("error", e);
    }
}

fn nested() -> Task<Result<i32, string>> {
    val inner: fn() -> Task<Result<i32, string>> = { ->
        async {
            throw "nested";
        }
    };
    return inner();
}

fn run() -> Task<void> {
    val failing: fn(n: i32) -> Task<Result<i32, string>> = { n ->
        async {
            throw "inner";
        }
    };
    show(await failing(1));
    val maybe: fn(n: i32) -> Task<Result<i32, string>> = { n ->
        async {
            if (n < 0) throw "negative " + n.toString();
            return n * 2;
        }
    };
    show(await maybe(4));
    show(await maybe(-4));
    show(await nested());
    val w = Worker(id: 10);
    show(await w.start(1));
    show(await w.start(-1));
    val later = w.lazyStart();
    show(await later(2));
    show(await later(-2));
}

pub fn main() {
    run();
}

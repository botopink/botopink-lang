//// Decision 587 — `botopink format` prints an annotation whose arguments end
//// in a trailing comma one per line, the comma kept; the file is committed in
//// that layout and `botopink format` leaves it as it is.

import {compiler, io.terminal.print} from "std";

#[compiler.external(
    .Erlang("lists:reverse($0)"),
    .JavaScript("[...$0].reverse()"),
    .Wasm(body: reverseBody),
)]
declare fn backwards(xs: i32[]) -> i32[];

fn reverseBody(xs: i32[]) -> i32[] {
    return xs.reverse();
}

pub fn runCase() {
    print(backwards([1, 2, 3]));
}

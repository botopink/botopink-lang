//// Decision 316 — the call value a wrapper receives is typed by the wrapped
//// method's own signature: a method of a type with type parameters is not
//// wrapped (question B-11-b, as built) and is refused at the annotation.

import {compiler, io.terminal.print} from "std";

fn counted(syntax decl: fn(..) -> i32) {
    compiler.wrapWith({ call -> call.run() });
}

type Box<T>(items: T[]) {
    #[counted]
    fn size(self: Self<T>) -> i32 {
        return self.items.length;
    }
}

pub fn main() {
    print(Box(items: [1, 2]).size());
}

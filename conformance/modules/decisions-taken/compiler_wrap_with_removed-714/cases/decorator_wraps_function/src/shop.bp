//// A wrapped function and a wrapped method, declared here and called from
//// `main`: the importer sees the wrapped behaviour.

import {wraps.counted, wraps.cached, wraps.tagged};

var loads: i32 = 0;

/// How many times `post`'s own body ran.
pub fn postLoads() -> i32 {
    return loads;
}

#[cached]
pub fn post(id: i32) -> string {
    loads = loads + 1;
    return "post " + id.toString();
}

#[counted]
pub fn greet(name: string) -> string {
    return "hi " + name;
}

// Two wrappers compose in annotation order, the first written outermost:
// `tagged("*")` sees what `tagged("-")` answers.
#[tagged("*")]
#[tagged("-")]
pub fn title() -> string {
    return "shop";
}

pub type Shelf(label: string) {
    #[counted]
    pub fn describe(self: Self, count: i32) -> string {
        return self.label + " x" + count.toString();
    }
}

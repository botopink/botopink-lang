//// Decision 872 — 799 (4) refuses a bodied `default fn` the type already has; a required member the type has is met by the type's own method and compared with the contract's signature.

import {io.terminal.print} from "std";

behavior Shout {
    fn slice(self: Self, start: i32) -> string;

    default fn tailShout(self: Self) -> string {
        return self.slice(0) + "!";
    }
}

// `string`'s own `slice` takes an `end` too: it does not meet the
// contract's one-parameter `slice`. Refused at the block,
// `implement-signature-differs`.
StringShout implement Shout for string {};

pub fn main() -> void {
    print("a+b".tailShout());
}

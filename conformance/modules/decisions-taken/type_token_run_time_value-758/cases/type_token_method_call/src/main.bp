//// Decision 758 — a run-time type token `t: type<T>` taken by a type
//// method: the type written at the call (`c.get(Row, "x")`) binds `T` to the
//// type, never to its constructor, so `get` answers `?Row` and `all` a
//// `Row[]`, with or without an annotation, and the token is tested by
//// `e is t`.

import {io.terminal.print} from "std";

pub type Row(id: i32)

pub type Col(name: string)

pub type Cache(entries: unknown[]) {
    pub fn get<T>(self: Self, t: type<T>, key: string) -> ?T {
        for (self.entries) { e ->
            if (e is t) return e;
        }
        return null;
    }

    pub fn all<T>(self: Self, t: type<T>, key: string) -> T[] {
        var out: T[] = [];
        for (self.entries) { e ->
            if (e is t) out.push(e);
        }
        return out;
    }
}

pub fn main() -> void {
    val row: unknown = Row(id: 7);
    val col: unknown = Col(name: "c");
    val c = Cache(entries: [col, row, row]);
    val r: ?Row = c.get(Row, "y");
    print(r != null);
    val k = c.get(Col, "z");
    val kc: ?Col = k;
    print(kc != null);
    print(Cache(entries: [col]).get(Row, "w") == null);
    val rows = c.all(Row, "x");
    val typed: Row[] = rows;
    print(typed.length);
    val cols: Col[] = c.all(Col, "x");
    print(cols.length);
}

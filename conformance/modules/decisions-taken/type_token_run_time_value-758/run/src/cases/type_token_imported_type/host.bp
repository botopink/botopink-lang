// The value of `rows` that is a `S`, as the `S` the caller names (668).
pub fn findAs<S>(t: type<S>, rows: unknown[]) -> ?S {
    for r in rows {
        if (r is t) return r;
    }
    return null;
}

pub fn allAs<S>(t: type<S>, rows: unknown[]) -> S[] {
    var out: S[] = [];
    for r in rows {
        if (r is t) out.push(r);
    }
    return out;
}

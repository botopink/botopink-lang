//// Decision 758 — `t: type<T>` without `comptime` is a run-time value, the
//// type's identity: one `count` for every type, and `e is t` tested at run
//// time by the same rules as the literal `e is Users` — a record and an enum
//// by identity, a primitive by value as each target tests it. `T` is still
//// bound by the parameter, so `first` answers `?T`.

import {io.terminal.print} from "std";

pub type Users(count: i32)

pub type Orders(total: i32)

pub type Shape {
    Circle(r: i32),
    Square(side: i32),
}

pub type Registry(entries: unknown[]) {
    pub fn count<T>(self: Self, t: type<T>) -> i32 {
        var n = 0;
        for (self.entries) { e ->
            if (e is t) n = n + 1;
        }
        return n;
    }

    pub fn first<T>(self: Self, t: type<T>) -> ?T {
        for (self.entries) { e ->
            if (e is t) return e;
        }
        return null;
    }
}

fn holds<T>(v: unknown, t: type<T>) -> bool {
    return v is t;
}

pub fn runCase() {
    val order: unknown = Orders(total: 9);
    val user: unknown = Users(count: 2);
    val circle: unknown = Shape.Circle(r: 1);
    val square: unknown = Shape.Square(side: 4);
    val r = Registry(entries: [order, user, circle, user, square]);
    print(r.count(Users));
    print(r.count(Orders));
    print(r.count(Shape));
    print(r.first(Orders) != null);
    print(Registry(entries: [order]).first(Users) == null);
    val big: unknown = 300;
    val whole: unknown = 3.0;
    val text: unknown = "hi";
    print(holds(big, i32), holds(big, u8), holds(whole, i32), holds(text, string), holds(text, i32));
}

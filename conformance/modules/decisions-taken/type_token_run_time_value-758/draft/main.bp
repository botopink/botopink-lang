//// Decision 758 — A type travels in two forms, and both work: `comptime t: type<T>` is the function's specialisation (a copy per type argument, `t` the type inside it, known at build — 757), and `t: type<T>` without `comptime` is a run-time value — the type's identity (603), crossing to run time as `Field(Book, "pages")` does (631) — tested with `x is t` at run time by the same rules as the literal test `x is Users`.

import {io.terminal.print} from "std";

type Users(id: i32)

type Orders(id: i32)

type Status {
    Open,
    Closed,
}

type Registry(entries: unknown[]) {
    pub fn count<T>(self: Self, t: type<T>) -> i32 {
        var n = 0;
        for (self.entries) { e ->
            if (e is t) {
                n = n + 1;
            }
        }
        return n;
    }

    pub fn first<T>(self: Self, t: type<T>) -> ?T {
        for (self.entries) { e ->
            if (e is t) {
                return e;
            }
        }
        return null;
    }

    // `t` handed on as any value.
    pub fn summary<T>(self: Self, t: type<T>, label: string) -> string {
        return self.count(t).toString() + " of " + label;
    }
}

pub fn main() -> void {
    val r = Registry(entries: [Users(id: 1), Orders(id: 2), Users(id: 3), Status.Open]);
    print(r.count(Users));
    print(r.summary(Orders, "Orders"));
    print(r.count(Status));
    print(r.first(Users)?.id ?? 0);
}

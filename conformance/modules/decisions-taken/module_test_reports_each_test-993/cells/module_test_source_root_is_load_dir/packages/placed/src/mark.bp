import {compiler, code, io.terminal.print} from "std";

// The file and the root of the argument it is called with, as the expansion
// writes them.
pub fn where(syntax value: unknown) -> anyvalue {
    val at = compiler.source(value);
    return code @`shown(${at.file}, ${at.root})`;
}

pub fn shown(file: string, root: string) -> void {
    print(file + " in " + root);
    val here = compiler.src();
    print(here.file + " in " + here.root);
}

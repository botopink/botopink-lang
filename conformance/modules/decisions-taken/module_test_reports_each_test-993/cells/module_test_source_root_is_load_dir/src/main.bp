//// Decision 1003 — inside a loaded package a source location's `file` is relative to the package,
//// and `root` is the directory it was loaded from: `placed`'s test calls `where`, which prints its
//// argument's `compiler.source(…)` (`src/main.bp` in `packages/placed`), then `shown`'s own
//// `compiler.src()` (`src/mark.bp` in `packages/placed`).

import {compiler, compiler.RunFailure, compiler.TestReport, io.terminal.print} from "std";

fn show(answer: Result<TestReport, RunFailure>) -> void {
    case answer {
        Ok(report) {
            for report.cases { c ->
                val verdict = if (c.ok) "ok" else "FAIL";
                print(verdict + " " + c.name + " [" + c.output + "]");
            }
        }
        Error(r) -> print("error " + r.message);
    }
}

comptime {
    val loaded = comptime compiler.load("packages/placed");
    case loaded {
        Ok(m) -> compiler.init({ -> show(m.`test`()) });
        Error(refused) -> compiler.init({ ->
            for refused.diagnostics { d -> print("load refused " + d.message); }
        });
    }
}

pub fn main() -> void {
    print("main");
}

//// Decision 993 (3) — ``m.`test`()`` runs the loaded package's tests in the program's own
//// process: one `TestCase` per test — the root's in the order they are written, then each
//// `mod`'s —, each with what it printed; a test that fails (an `assert`, a `try`) or aborts
//// (a `panic`) is a case with `ok: false`, and the next test runs. Inside a test,
//// `compiler.src().file` is prefixed by the load directory. A package with no test answers
//// no case; one whose tests await answers an `Async`, awaited; a crash outside every test (the
//// package's body) is `.Abort`. Each text is printed between brackets, so its last line break
//// shows.

import {async, compiler, compiler.RunFailure, compiler.TestReport, io.terminal.print} from "std";

fn show(answer: Result<TestReport, RunFailure>) -> void {
    case answer {
        Ok(report) {
            print("cases " + report.cases.length.toString());
            for report.cases { c ->
                val verdict = if (c.ok) "ok" else "FAIL";
                print(verdict
                    + " "
                    + c.name
                    + " "
                    + c.file
                    + ":"
                    + c.line.toString()
                    + " ["
                    + c.output
                    + "] "
                    + c.message
                    + " "
                    + c.at);
            }
        }
        Error(r) -> case r.kind {
            .Abort -> print("abort " + r.message + " [" + r.output + "]");
            .Refused -> print("refused " + r.message);
            .Excluded -> print("excluded " + r.message);
            .Failed -> print("failed " + r.message);
        };
    }
}

// Expanded where the block calls it (decision 788): its load and its `compiler.init`
// are the block's.
fn testCase(comptime name: string) -> void {
    val loaded = comptime compiler.load("packages/" + name);
    case loaded {
        Ok(m) -> compiler.init({ ->
            print("== " + name);
            show(m.`test`());
        });
        Error(refused) -> compiler.init({ -> print("load refused " + refused.module.path()) });
    }
}

comptime {
    testCase("suite");
    testCase("empty");
    testCase("broken");
    // `later`'s tests await: its ``test`()`` answers an `Async`, awaited in the task the
    // init body starts.
    val later = comptime compiler.load("packages/later");
    case later {
        Ok(m) -> compiler.init({ ->
            print("== later");
            val awaited = async {
                show(await m.`test`());
            };
        });
        Error(refused) -> compiler.init({ -> print("load refused " + refused.module.path()) });
    }
}

// The program's own output: its `main` prints once the task the last init
// body started has settled.
pub async fn main() -> Async<void> {
    await async.delay(10, 0);
    print("main");
}

//// Decision 993 (3) — a loaded package whose manifest leaves the built target out answers its
//// ``test`()`` `.Excluded` there, with the refusal's text, when the target refuses it (989 (3)):
//// `named` leaves wasm out and its test reaches a host binding with no wasm cell, so on wasm
//// none of its tests runs; on commonJS, erlang and beam its test runs.

import {compiler, compiler.RunFailure, compiler.TestReport, io.terminal.print} from "std";

fn show(answer: Result<TestReport, RunFailure>) -> void {
    case answer {
        Ok(report) {
            for report.cases { c ->
                val verdict = if (c.ok) "ok" else "FAIL";
                print(verdict + " " + c.name + " [" + c.output + "]");
            }
        }
        Error(r) -> case r.kind {
            .Failed -> print("failed " + r.message);
            .Abort -> print("abort " + r.message);
            .Refused -> print("refused " + r.message);
            .Excluded -> print("excluded " + r.message);
        };
    }
}

comptime {
    val loaded = comptime compiler.load("packages/named");
    case loaded {
        Ok(m) -> compiler.init({ -> show(m.`test`()) });
        Error(refused) -> compiler.init({ -> print("load refused " + refused.module.path()) });
    }
}

pub fn main() -> void {
    print("main");
}

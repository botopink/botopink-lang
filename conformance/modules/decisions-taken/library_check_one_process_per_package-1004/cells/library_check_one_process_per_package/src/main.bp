import {compiler, compiler.Refused, compiler.RunFailure, compiler.TestReport, io.terminal.print} from "std";

//// Decision 1004 — the library check's program for one package: `conformance/run.sh` writes it per package of
//// `botopink packages --list` and runs it per target as its own process, so a package that fails the build
//// (`hard`, beside this cell), hangs (`hangs`) or whose manifest is refused (`broken`) is red alone while the
//// others answer. Here the package is `good`, found by name in this cell's `repository/`: one line per test, then
//// the summary. `async { m.`test`() }` is one `Async` whether the tests await or not (989 (2)).

fn indent(text: string) -> string {
    var out: string[] = [];
    for (text.split("\n")) { l ->
        if (l != "") out.push("    " + l);
    }
    return out.join("\n");
}

fn report(answer: Result<TestReport, RunFailure>) -> void {
    case answer {
        Ok(r) {
            var red = 0;
            for r.cases { c ->
                if (c.ok) print("ok   " + c.name) else {
                    red = red + 1;
                    print("FAIL " + c.name + " — " + c.at + ": " + c.message);
                    if (c.output != "") print(indent(c.output));
                }
            }
            print("library: "
                + r.cases.length.toString()
                + " cases — "
                + (r.cases.length - red).toString()
                + " passed, "
                + red.toString()
                + " failed");
        }
        Error(f) {
            val kind = case f.kind {
                .Failed -> "failed";
                .Abort -> "aborted";
                .Refused -> "refused";
                .Excluded -> "excluded";
            };
            print("library: " + kind + " — " + f.message);
            if (f.output != "") print(indent(f.output));
        }
    }
}

fn refused(r: Refused) -> void {
    print("library: refused at build — "
        + r.diagnostics.length.toString()
        + " diagnostics");
    for (r.diagnostics) { d ->
        print("    "
            + d.file
            + ":"
            + d.line.toString()
            + ":"
            + d.column.toString()
            + ": "
            + d.message);
    }
}

comptime {
    val loaded = comptime compiler.load(package: "good");
    case loaded {
        Ok(m) -> compiler.init({ ->
            val settled = async {
                val answer = async { m.`test`() };
                report(await answer);
            };
        });
        Error(r) -> compiler.init({ -> refused(r); });
    }
}

pub fn main() -> void {}

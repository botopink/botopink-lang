//// Decision 780 — a path of `compiler.load` that names no file of the package is a
//// refusal of the program that loads, at the argument — never an answer of the load.

import {compiler, io.terminal.print} from "std";

pub fn main() {
    try comptime compiler.load("src/cases/nothing_here.bp") catch { r ->
        print(r.diagnostics.length);
    }
}

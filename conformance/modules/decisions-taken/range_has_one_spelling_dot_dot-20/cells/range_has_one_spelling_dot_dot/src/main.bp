//// Decisions 20, 53, 105 — `...` includes its end, in a pattern, a `for`
//// and a slice; `..` stops before it.

import {io.terminal.print} from "std";

fn digit(n: i32) -> string {
    return case n {
        0...9 -> "digit";
        _ -> "other";
    };
}

pub fn main() -> void {
    print(digit(0));
    print(digit(9));
    print(digit(10));

    for i in 0..3 {
        print(i);
    }
    for i in 0...3 {
        print(i);
    }

    val xs = [10, 20, 30, 40];
    print(xs[0..2]);
    print(xs[1...2]);
    print(xs[0...0]);
    print("abcd"[1..3]);
    print("abcd"[1...3]);
}

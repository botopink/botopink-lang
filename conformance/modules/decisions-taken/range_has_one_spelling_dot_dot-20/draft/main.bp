//// Decision 20 — Is a pattern range inclusive?

import {io.terminal.print} from "std";

fn digit(n: i32) -> string {
    return case n {
        0...9 -> "digit";
        _ -> "other";
    };
}

pub fn main() -> void {
    print(digit(0));
    print(digit(9));
    print(digit(10));

    for (0..3) { i ->
        print(i);
    }
    for (0...3) { i ->
        print(i);
    }

    val xs = [10, 20, 30, 40];
    print(xs[0..2]);
    print(xs[1...2]);
}

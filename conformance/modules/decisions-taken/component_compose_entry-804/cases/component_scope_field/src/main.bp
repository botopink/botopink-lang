//// Decisions 804 (1), 388 (5) — a component holds no scope: the renderer
//// hands it to `compose` at each run. A type component's field typed
//// `RenderScope` is refused at the field.

import {context.run, io.terminal.print} from "std";

type View(text: string) implement Renderable

type Card(title: string, scope: RenderScope) implement Component<View> {
    fn compose(self: Self) -> Component<View> {
        return View(text: self.title);
    }
}

pub async fn main() -> Async<void> {
    val r = await run(Card(title: "x", scope: RenderScope.root()));
    print(r.text);
}

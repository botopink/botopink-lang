//// Decision 804 (1) — a type implementing `Component<R>` is a component
//// whose body is its `fn compose(self: Self) -> Component<R>`; one that
//// declares no `compose` is refused at the type.

import {context.run, io.terminal.print} from "std";

type View(text: string)

type Card(title: string) implement Component<View> {
    fn render(self: Self) -> Component<View> {
        return View(text: self.title);
    }
}

pub async fn main() -> Async<void> {
    val r = await run(Card(title: "x"));
    print(r.text);
}

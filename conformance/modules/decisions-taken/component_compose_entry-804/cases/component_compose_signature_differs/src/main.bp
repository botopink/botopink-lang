//// Decisions 804 (1), 800 — a type component's `compose` is the contract's
//// `fn compose(self: Self) -> Component<R>`: one written with another
//// parameter or another return is refused at the member,
//// `implement-signature-differs`, naming both signatures.

import {context.RenderScope, io.terminal.print} from "std";

type View(text: string) implement Renderable

type Card(title: string) implement Component<View> {
    fn compose(self: Self, suffix: string) -> View {
        return View(text: self.title + suffix);
    }
}

pub async fn main() -> Async<void> {
    val r = await Card(title: "x").run(RenderScope.root());
    print(r.value.text);
}

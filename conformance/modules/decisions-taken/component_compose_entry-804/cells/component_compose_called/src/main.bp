//// Decision 804 (1) — a type component's `compose` is its body, never
//// called by hand: `Card.compose()` is refused at the call, naming
//// `Card(…)`.

import {context.RenderScope, io.terminal.print} from "std";

type View(text: string)

type Card(title: string) implement Component<View> {
    fn compose(self: Self) -> Component<View> {
        return View(text: self.title);
    }
}

pub async fn main() -> Async<void> {
    val c = Card.compose();
    print("made");
}

//// Decision 375 (2), question 04s12-a's answer (1) — a behavior's `default
//// fn` and an enum's method answering `Component<R>` are marked by their own
//// bodies, as a top-level function and a type's method are: `Widget.badge`
//// awaits nothing, so its function answers its value at once (`resolve`, 809 (6)) and `Plain`,
//// which renders it, is synchronous; `Widget.later` awaits, and so is `Slow`;
//// `Tone.swatch` awaits nothing, and `Tinted` is synchronous.
////
//// commonJS only: `pending` asks the host whether a value is a `Promise`,
//// and only Node has one (`await` is the identity on erlang, beam and wasm).

import {context.run, context.resolve, context.Scope, context.Place, compiler, io.terminal.print} from "std";

type Element(text: string)

#[compiler.external(.JavaScript("""($0 instanceof Promise)"""))]
declare fn pending(v: unknown) -> bool;

async fn loadComments() -> Async<string> {
    return "2 comments";
}

behavior Widget {
    fn name(self: Self) -> string;

    default component fn badge(self: Self) -> Component<Element> {
        return Element(text: "badge " + self.name());
    }
    default component fn later(self: Self) -> Component<Element> {
        val t = await loadComments();
        return Element(text: t);
    }
}

type Box(n: string) implement Widget {
    fn name(self: Self) -> string {
        return self.n;
    }
}

type Tone {
    Warm,
    Cold,

    component fn swatch(self: Self) -> Component<Element> {
        return Element(text: "swatch");
    }
}

component fn Plain() -> Component<Element> {
    val b = Box(n: "x");
    val a = use b.badge();
    return Element(text: a.text);
}

component fn Tinted() -> Component<Element> {
    val s = use Tone.Warm.swatch();
    return Element(text: s.text);
}

component fn Slow() -> Component<Element> {
    val b = Box(n: "y");
    val a = use b.later();
    return Element(text: a.text);
}

pub async fn main() -> Async<void> {
    val b = Box(n: "z");
    print(pending(resolve(b.badge(), Scope.root(), Place.none())));
    print(pending(resolve(b.later(), Scope.root(), Place.none())));
    print(pending(resolve(Plain(), Scope.root(), Place.none())));
    print(pending(resolve(Slow(), Scope.root(), Place.none())));
    print(pending(resolve(Tinted(), Scope.root(), Place.none())));
    val p = await run(Plain());
    print(p.text);
    val q = await run(Slow());
    print(q.text);
}

//// Decision 375 (2), as 388 amends it — a component's lambda runs
//// synchronously or asynchronously as its hooks node is marked: on commonJS
//// a synchronous one is a plain arrow that answers its value at once, an
//// asynchronous one an `async` arrow answering a `Promise`, and a call or
//// `use` of a synchronous one is not awaited. `Card` `use`s the synchronous
//// hook `label` and awaits nothing, so `resolve(Card("direct"), …)` answers
//// the value itself, not a `Promise` (809 (6)). `Comments` awaits and `Post`
//// renders it: resolving `Post` answers a `Promise`. `Post` renders `Card` twice (a call
//// only makes the lambda, 791 (1)) and reads both.
////
//// commonJS only: `pending` asks the host whether a value is a `Promise`, and
//// only Node has one (`await` is the identity on erlang, beam and wasm).

import {context.run, context.resolve, context.Scope, context.Place, compiler, io.terminal.print} from "std";

type Element(text: string)

#[compiler.external(.JavaScript("""($0 instanceof Promise)"""))]
declare fn pending(v: unknown) -> bool;

async fn loadComments() -> Async<string> {
    return "2 comments";
}

component fn label() -> Component<string> {
    return "card:";
}

component fn delayed() -> Component<string> {
    val t = await loadComments();
    return t;
}

component fn Card(title: string) -> Component<Element> {
    val prefix = use label();
    return Element(text: prefix + title);
}

component fn Comments() -> Component<Element> {
    val text = use delayed();
    return Element(text: text);
}

component fn Post() -> Component<Element> {
    val a = use Card("a");
    val b = use Card("b");
    val m = use Comments();
    return Element(text: a.text + " " + b.text + " " + m.text);
}

pub async fn main() -> Async<void> {
    print(pending(resolve(Card("direct"), Scope.root(), Place.none())));
    print(pending(resolve(Post(), Scope.root(), Place.none())));
    val p = await run(Post());
    print(p.text);
    val c = await run(Card("direct"));
    print(c.text);
}

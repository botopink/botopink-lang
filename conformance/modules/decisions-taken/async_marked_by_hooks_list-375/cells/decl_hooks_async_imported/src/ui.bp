//// The library half of `decl_hooks_async_imported`: a synchronous hook, a
//// synchronous component that reads it, and a component that awaits. Its
//// nodes are published with their `async` marks when this module's analysis
//// ends.

pub type Element(text: string)

pub component fn session() -> Component<string> {
    return "alice";
}

pub component fn Avatar() -> Component<Element> {
    val s = use session();
    return Element(text: "avatar " + s);
}

async fn loadPosts() -> Async<string> {
    return "3 posts";
}

pub component fn Posts() -> Component<Element> {
    val text = await loadPosts();
    return Element(text: text);
}

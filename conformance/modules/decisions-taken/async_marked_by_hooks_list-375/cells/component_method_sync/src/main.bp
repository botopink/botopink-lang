//// Decision 375 (2), question 04s12-a's answer (1) — a method answering
//// `Component<R>` is marked by its own body as a top-level function is:
//// `Menu.render` awaits nothing, so its lambda answers its `Rendered` at once
//// and `await m.render()` in a body runs it with no `await`; `Menu.slow`
//// awaits, so its lambda answers a `Promise`. `Plain`, which renders only
//// `render`, is synchronous; `Page`, which also renders `slow`, is not.
////
//// commonJS only: `pending` asks the host whether a value is a `Promise`,
//// and only Node has one (`await` is the identity on erlang, beam and wasm).

import {context.RenderScope, compiler, io.terminal.print} from "std";

type Element(text: string) implement Renderable

#[compiler.external(.JavaScript("""($0 instanceof Promise)"""))]
declare fn pending(v: unknown) -> bool;

async fn loadComments() -> Async<string> {
    return "2 comments";
}

type Menu(title: string) {
    component fn render(self: Self) -> Component<Element> {
        return Element(text: "menu " + self.title);
    }
    component fn slow(self: Self) -> Component<Element> {
        val t = await loadComments();
        return Element(text: t);
    }
}

component fn Page() -> Component<Element> {
    val m = Menu(title: "a");
    val a = await m.render();
    val b = await m.slow();
    return Element(text: a.text + " " + b.text);
}

component fn Plain() -> Component<Element> {
    val m = Menu(title: "b");
    val a = await m.render();
    return Element(text: a.text);
}

pub async fn main() -> Async<void> {
    val m = Menu(title: "a");
    print(pending(m.render().run(RenderScope.root())));
    print(pending(m.slow().run(RenderScope.root())));
    print(pending(Plain().run(RenderScope.root())));
    val p = await Page().run(RenderScope.root());
    print(p.value.text);
    val q = await Plain().run(RenderScope.root());
    print(q.value.text);
}

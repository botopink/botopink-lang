//// Decision 738 — a pair is the tuple `#(A, B)`, taken apart by `val #(a, b) = p`:
//// an element that is an array read off a call (`xs.map(…)`) is still that array,
//// printed as one, on every target.

import {io.terminal.print} from "std";

pub fn main() -> void {
    val xs = [1, 2];
    val #(w, nums) = #("long", xs.map({ x -> x * 2 }));
    print(nums);
    print(w);
    print(nums.length());
}

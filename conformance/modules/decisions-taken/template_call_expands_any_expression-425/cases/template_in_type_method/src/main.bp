//// Decision 425 — a template call expands wherever an expression may stand:
//// in a type's method body, as in a function's.

import {compiler, io.terminal.print} from "std";

fn twice(syntax q: string) -> string {
    return compiler.build("\"" + compiler.text(q) + compiler.text(q) + "\"");
}

type Filter(minAge: i32) {
    pub fn names(self: Self) -> string {
        return twice @`ab` + self.minAge.toString();
    }
}

pub fn main() {
    print(Filter(minAge: 7).names());
}

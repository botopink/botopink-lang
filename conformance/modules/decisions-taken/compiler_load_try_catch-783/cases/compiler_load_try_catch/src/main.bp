//// Decision 783 — `compiler.load`'s refusals are a `Result`'s failure: `try comptime
//// compiler.load(…) catch { r -> … }` handles them in its region, the handler a block
//// with a binder; `try comptime compiler.load(…);` with no `catch` propagates them to
//// the enclosing function's `Result`, whose caller handles them. The failure is a
//// `compiler.Refused`, its refusals `r.diagnostics` (decision 786).

import {compiler, io.terminal.print} from "std";

// Propagated: the load's `Error(r)` is this function's.
fn checked() -> Result<void, compiler.Refused> {
    try comptime compiler.load("packages/broken");
    print("not reached");
    return;
}

// A file that compiles propagates nothing.
fn passes() -> Result<void, compiler.Refused> {
    try comptime compiler.load("packages/fine");
    print("fine loaded");
    return;
}

pub fn main() -> void {
    // Handled in the region.
    try comptime compiler.load("packages/broken") catch { r ->
        for (r.diagnostics) { d ->
            print("handled " + d.file + ":" + d.line.toString());
        }
        r.module
    }
    try checked() catch { r ->
        for (r.diagnostics) { d ->
            print("propagated " + d.file + ":" + d.line.toString());
        }
    }
    try passes() catch { r ->
        print("never");
    }
}

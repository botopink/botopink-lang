//// Decision 302 — on a tag an annotation's one channel is typed meta:
//// `@emit` is refused at the annotation the template runs, in the caller's
//// text.

pub mod tags;
import {cases.tag_annotation_emit.tags.markup, cases.tag_annotation_emit.tags.withEmit};
import {io.terminal.print} from "std";

pub fn main() -> void {
    print(markup @`<div #[withEmit]>hi</div>`);
}

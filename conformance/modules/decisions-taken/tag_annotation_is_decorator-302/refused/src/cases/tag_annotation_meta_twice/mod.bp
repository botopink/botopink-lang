//// Decision 302 — one `setMeta` of a type per tag: the second annotation
//// that records a `Hydrate` on the same `<div>` is refused at that
//// annotation, in the caller's text.

pub mod tags;
import {cases.tag_annotation_meta_twice.tags.markup, cases.tag_annotation_meta_twice.tags.hydrate};
import {io.terminal.print} from "std";

pub fn main() -> void {
    print(markup @`<div #[hydrate(1)] #[hydrate(2)]>hi</div>`);
}

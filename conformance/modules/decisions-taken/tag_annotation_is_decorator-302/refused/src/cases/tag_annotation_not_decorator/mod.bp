//// Decision 302 — the annotation a template runs over a tag resolves, in the
//// caller's scope, to a decorator: a function whose first parameter is not
//// `comptime decl: @Decl` is refused at the annotation, in the caller's text.

pub mod tags;
import {cases.tag_annotation_not_decorator.tags.markup, cases.tag_annotation_not_decorator.tags.shout};
import {io.terminal.print} from "std";

pub fn main() {
    print(markup @`<div #[shout]>hi</div>`);
}

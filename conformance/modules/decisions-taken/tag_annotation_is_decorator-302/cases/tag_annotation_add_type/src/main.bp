//// Decision 302 — on a tag an annotation's one channel is typed meta:
//// `decl.addType` is refused at the annotation the template runs, in the
//// caller's text.

pub mod tags;
import {tags.markup, tags.withType};
import {io.terminal.print} from "std";

pub fn main() -> void {
    print(markup @`<div #[withType]>hi</div>`);
}

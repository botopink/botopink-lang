//// Decision 302 — on a tag an annotation's one channel is typed meta:
//// `decl.addMember` (as `decl.addType`) is refused at the annotation the
//// template runs, in the caller's text.

pub mod tags;
import {tags.markup, tags.withMember};
import {io.terminal.print} from "std";

pub fn main() -> void {
    print(markup @`<div #[withMember]>hi</div>`);
}

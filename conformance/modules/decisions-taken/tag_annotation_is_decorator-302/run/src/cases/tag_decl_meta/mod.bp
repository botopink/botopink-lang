//// Decision 302 — a tag's annotation and a declaration's decorator are one
//// thing: `cls`, a function whose first parameter is `comptime decl: @Decl`,
//// annotates the type `Card` and, inside `markup """…"""`, a `<div>` and a
//// `<Badge>`. The template function builds the tag's `@Decl`
//// (`q.tagDecl`), runs the annotation written in its text over it
//// (`q.annotate`) and reads back, by type, the `ClassName` it recorded
//// (`d.metaAll(ClassName)`). On the element the annotation sees
//// `DeclKind.Element` and the tag's attribute (`decl.attr("id")`); on the
//// component `DeclKind.Component` and the component's function
//// (`decl.component`), resolved where the template is written.

pub mod tags;
import {cases.tag_decl_meta.tags.markup, cases.tag_decl_meta.tags.cls, cases.tag_decl_meta.tags.ClassName};
import {io.terminal.print, compiler} from "std";

#[cls("b")]
type Card(title: string)

fn Badge() -> string {
    return "badge";
}

pub fn runCase() {
    print(markup @`<div id="x" #[cls("a")]>hi</div>`);
    print(markup @`<Badge #[cls("c")]>new</Badge>`);
    print(Badge());
    for (comptime compiler.typeInfo(Card).metaAll(ClassName)) { c ->
        print("Card: " + c.names.join(" "));
    }
}

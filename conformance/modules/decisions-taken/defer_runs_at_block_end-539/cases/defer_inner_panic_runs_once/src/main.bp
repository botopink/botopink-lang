//// Decision 539 (3) — a deferred statement that panics, written on a way
//// out (`return`) inside an enclosing region, runs once, and the panic it
//// raises is the one `attempt` answers.

import {failure, failure.Failure, io.terminal.print, failure.panic} from "std";

fn inner() -> i32 {
    defer print("outer");
    defer {
        print("inner");
        panic("from defer");
    }
    return 1;
}

fn show(r: Result<i32, Failure>) -> void {
    case r {
        Ok(v) -> print("Ok " + v.toString());
        Error(f) -> print("Error " + f.kind + ": " + f.message);
    }
}

pub fn main() -> void {
    show(failure.attempt({ -> inner() }));
}

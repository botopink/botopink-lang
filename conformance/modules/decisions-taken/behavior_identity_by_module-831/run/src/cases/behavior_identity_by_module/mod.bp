//// Decision 831 — a behavior's run-time identity is its declaration, the
//// module's id and its name: two behaviors named `Shown` of two modules are
//// two, a type implementing one under an import alias carries the declared
//// behavior's mark, and a type implementing `Loud extends Shown` carries
//// `Shown`'s too — by `is` and by a `case` type pattern, on every target.

pub mod a;
pub mod b;
import {cases.behavior_identity_by_module.a.m.Shown as AShown, cases.behavior_identity_by_module.a.m.Loud, cases.behavior_identity_by_module.a.m.Ping};
import {cases.behavior_identity_by_module.b.m.Shown as BShown, cases.behavior_identity_by_module.b.m.Pong};
import {io.terminal.print} from "std";

type Echo(n: i32) implement AShown {
    fn shown(self: Self) -> string {
        return "echo";
    }
}

type Bell(n: i32) implement Loud {
    fn shown(self: Self) -> string {
        return "bell";
    }

    fn loud(self: Self) -> string {
        return "BELL";
    }
}

fn kind(v: unknown) -> string {
    val a = if (v is AShown) "a" else "-";
    val b = if (v is BShown) "b" else "-";
    val l = if (v is Loud) "loud" else "-";
    return a + " " + b + " " + l;
}

fn label(v: unknown) -> string {
    return case v {
        BShown { k ->
            "b"
        }
        AShown { k ->
            "a"
        }
        _ {
            "other"
        }
    };
}

pub fn runCase() -> void {
    print(kind(Ping(n: 1)));
    print(kind(Pong(n: 1)));
    print(kind(Echo(n: 1)));
    print(kind(Bell(n: 1)));
    print(kind(1));
    print(label(Ping(n: 1)), label(Pong(n: 1)), label(Echo(n: 1)), label(Bell(n: 1)), label(1));
}

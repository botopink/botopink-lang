//// Decision 334 — a host is the runtime a wasm build binds to, so `host:` is
//// `External.Wasm`'s alone. Written on `External.Node` it is a switch nothing
//// reads, refused at the annotation.

import {compiler, io.terminal.print} from "std";

#[compiler.external(.JavaScript("Math.floor($0)", host: .Wasi))]
declare fn floorOf(x: f64) -> f64;

pub fn main() -> void {
    print(floorOf(2.5));
}

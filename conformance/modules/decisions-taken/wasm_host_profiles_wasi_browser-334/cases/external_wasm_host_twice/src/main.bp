//// Decision 334 — one wasm binding per host. Two `host: .Wasi` bindings on
//// one `declare fn` would leave the compiler reading one and dropping the
//// other; the second is refused at its annotation.

import {compiler, io.terminal.print} from "std";

#[compiler.external(
    .JavaScript("Math.floor($0)"),
    .Wasm(op: "f64.floor", host: .Wasi),
    .Wasm(op: "f64.ceil", host: .Wasi),
)]
declare fn roundOf(x: f64) -> f64;

pub fn main() -> void {
    print(roundOf(2.5));
}

import {code, compiler} from "std";

pub type Text(value: string)

pub type Box(tag: string, kids: Text[])

pub fn box(syntax t: string) -> anyvalue {
    val tag = compiler.text(t).split(" ")[0] ?? "div";
    val h = compiler.holes(t);
    return code @`Box(tag: ${tag}, kids: [Text(value: ${h[0]!}), Text(value: ${h[1]!})])`;
}

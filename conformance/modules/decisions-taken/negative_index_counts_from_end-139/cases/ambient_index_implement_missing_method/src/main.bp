//// Decision 539 (6), decision 63 — an inline `implement` of an ambient behavior is checked
//// against its declaration in `primitives.bp`: `Index<K, V>` requires `at`, and a type that
//// names it without one is refused at the type.

import {io.terminal.print} from "std";

type Registry(names: string[]) implement Index<string, i32> {
    pub fn find(self: Self, key: string) -> i32 {
        return self.names.indexOf(key);
    }
}

pub fn main() {
    print(Registry(names: ["ana", "bo"]).find("bo"));
}

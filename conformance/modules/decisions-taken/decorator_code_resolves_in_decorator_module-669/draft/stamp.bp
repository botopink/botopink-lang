//// The decorator's module: the member it adds names `Clock` and `stampOf`,
//// which resolve here, where the member is written.

import {compiler} from "std";

pub type Clock(tick: i32)

fn stampOf(c: Clock) -> string {
    return "t" + c.tick.toString();
}

pub fn stamped(syntax decl: unknown) -> void {
    compiler.addMember<fn(i32) -> string>("stampAt", { tick -> stampOf(Clock(tick: tick)) });
}

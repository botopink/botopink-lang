//// Decision 751 — (a), as built: `Call(callee: …, args: …)`, `Node` a closed union alias, the vocabulary the parser has, `compiler.ast`'s argument checked in the reply.

import {io.terminal} from "std";
import {comptime.build.doubledInRange};

pub fn main() -> void {
    val base = 3;
    terminal.print(doubledInRange(base));
    terminal.print(doubledInRange(base + 4));
    terminal.print(doubledInRange(-1));
}

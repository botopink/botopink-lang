//// Decisions 431 (2), 489, 490 — a binding that writes `result: true` answers
//// `Result<T, HostError>`: a value is `Ok(v)`, and every way the host fails is
//// `Error(HostError(message, "host", name, detail))`. On commonJS a sync
//// binding runs in a `try`/`catch` and a `Async` one's rejection is caught;
//// on erlang and beam the call runs in a `try … catch Class:Reason`, and a
//// host that answers `{error, R}` is an `Error` too. `name` is the same on
//// every target: a JavaScript `Error` and an erlang `error` raise are
//// `HostErrorName.Error`, any other thrown value and an erlang `throw` are
//// `HostErrorName.Throw`. `message` is the host's text: `e.message` (else
//// `String(e)`), the erlang reason by `~tp` — an atom here, so both read alike.
//// `detail`, the stack, is not printed: a backend may leave it empty.
////
//// wasm has no host that raises: a wasm binding is an opcode, a private fn
//// (`fn:`, where `result:` is refused, decision 491) or a WASI adapter, and
//// none of today's adapters fails. Each binding here is a private fn on wasm
//// that answers the value the other hosts answer.

import {failure, failure.HostError, compiler, io.terminal.print} from "std";

#[compiler.external(
    .JavaScript("""(($0 >= 0) ? $0 * 2 : (() => { throw new Error("negative"); })())""", result: true),
    .Erlang("""(case $0 >= 0 of true -> $0 * 2; false -> erlang:error(negative) end)""", result: true),
    .Wasm(body: doubleBody),
)]
declare fn double(n: i32) -> Result<i32, HostError>;

#[compiler.external(
    .JavaScript("""(($0 > 0) ? $0 : (() => { throw "refused"; })())""", result: true),
    .Erlang("""(case $0 > 0 of true -> $0; false -> throw(refused) end)""", result: true),
    .Wasm(body: thrownBody),
)]
declare fn thrown(n: i32) -> Result<i32, HostError>;

#[compiler.external(
    .JavaScript("""(($0 > 0) ? $0 + 1 : (() => { throw new Error("refused"); })())""", result: true),
    .Erlang("""(case $0 > 0 of true -> {ok, $0 + 1}; false -> {error, refused} end)""", result: true),
    .Wasm(body: answeredBody),
)]
declare fn answered(n: i32) -> Result<i32, HostError>;

#[compiler.external(
    .JavaScript("""(($0 > 0) ? Promise.resolve($0 * 3) : Promise.reject(new Error("late")))""", result: true),
    .Erlang("""(case $0 > 0 of true -> $0 * 3; false -> erlang:error(late) end)""", result: true),
    .Wasm(body: laterBody),
)]
declare fn later(n: i32) -> Async<Result<i32, HostError>>;

fn hostError(message: string, name: failure.HostErrorName) -> HostError {
    return HostError(message: message, kind: "host", name: name, detail: null);
}

fn doubleBody(n: i32) -> Result<i32, HostError> {
    if (n < 0) throw hostError("negative", failure.HostErrorName.Error);
    return n * 2;
}

fn thrownBody(n: i32) -> Result<i32, HostError> {
    if (n <= 0) throw hostError("refused", failure.HostErrorName.Throw);
    return n;
}

fn answeredBody(n: i32) -> Result<i32, HostError> {
    if (n <= 0) throw hostError("refused", failure.HostErrorName.Error);
    return n + 1;
}

async fn laterBody(n: i32) -> Async<Result<i32, HostError>> {
    if (n <= 0) throw hostError("late", failure.HostErrorName.Error);
    return n * 3;
}

fn show(r: Result<i32, HostError>) -> void {
    case r {
        Ok(v) -> print("ok", v);
        Error(e) -> print("error", e.message, e.kind, e.name);
    }
}

async fn run() -> Async<void> {
    show(double(21));
    show(double(-1));
    show(thrown(5));
    show(thrown(0));
    show(answered(1));
    show(answered(0));
    show(await later(2));
    show(await later(0));
    val a = try double(-4) catch 7;
    val b = try await later(-1) catch 100;
    print(a + b);
}

pub async fn main() -> Async<void> {
    await run();
}

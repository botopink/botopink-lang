//// Decisions 431 (2), 488, 490 — `result: true` on a host binding says the
//// host call can fail, and the backend answers every way it fails as
//// `Error(HostError(…))`. The declared return must then be
//// `Result<…, HostError>` or `Async<Result<…, HostError>>` with std's
//// `failure.HostError`, so the flag has one reading: a binding that writes it
//// and returns a plain value is refused at the annotation.

import {compiler, io.terminal.print} from "std";

#[compiler.external(.JavaScript("JSON.parse($0)", result: true), .Erlang("json:decode($0)", result: true))]
declare fn jsParse(s: string) -> i32;

pub fn main() -> void {
    print(jsParse("1"));
}

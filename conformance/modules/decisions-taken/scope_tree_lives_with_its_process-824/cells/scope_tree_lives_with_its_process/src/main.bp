//// Decision 824 — on erlang and beam a root's tree is one entry of the
//// process dictionary of the process that made it: one open root, one
//// `{bp_scope, _}` entry, gone at `close()`. A scope crosses a process only
//// as `scope.detach()` — a fresh root over its contexts, which the other
//// process reads —; read there undetached it fails `scope-foreign`.

import {context.run, context.Scope, async, compiler, failure.attemptTask, io.terminal.print} from "std";

type View(text: string)

#[compiler.external(
    .JavaScript("""0"""),
    .Erlang("""length([K || {{bp_scope, _} = K, _} <- erlang:get()])"""),
)]
declare fn scopeEntries() -> i32;

component fn Page() -> Component<View> {
    return View(text: "page");
}

pub async fn main() -> Async<void> {
    val root = Scope.root();
    print(scopeEntries());
    val detached = root.detach();
    val crossed = await async.runAll([{ -> run(Page(), detached) }]);
    print(crossed.map({ v -> v.text }).join(","));
    val foreign = await attemptTask({ -> async.runAll([{ -> run(Page(), root) }]) });
    case foreign {
        Ok(vs) -> print(vs.map({ v -> v.text }).join(","));
        Error(f) -> print(f.message);
    }
    root.close();
    detached.close();
    print(scopeEntries());
}

//// Decision 238 — a `wasi:` adapter's signature is checked against the
//// declaration at the annotation, on every target: `.RandomF64` takes no
//// parameter and answers an `f64`, so a declaration taking an `i32` is
//// refused on erlang, beam and commonJS too, whose own bindings would run
//// it. Only a wasm build read the binding before.

import {compiler, io.terminal.print} from "std";

#[compiler.external(.JavaScript("Math.abs($0)"), .Erlang("erlang:abs($0)"), .Wasm(wasi: .RandomF64))]
pub declare fn draw(seed: i32) -> f64;

pub fn main() {
    print(draw(1) >= 0.0);
}

//// Decision 541 (2) — a `case` arm that yields is a scope of the enclosing
//// generator, so a `return` in it ends that generator: nothing after the
//// `case` is emitted.

import {io.terminal.print} from "std";

iter fn items(n: i32) -> Iter<i32> {
    yield 0;
    case n {
        0 {
            yield 1;
            return;
        }
        _ {
            yield 2;
        }
    }
    yield 9;
}

pub fn main() -> void {
    for (items(0)) { v ->
        print(v);
    }
    print("--");
    for (items(1)) { v ->
        print(v);
    }
}

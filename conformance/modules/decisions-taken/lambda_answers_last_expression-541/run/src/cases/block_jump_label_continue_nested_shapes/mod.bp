//// Decision 541 (2) — a labelled `continue` under an in-frame `while` inside
//// the named loop, and one inner loop continuing two enclosing labels.

import {io.terminal.print} from "std";

fn whileUnderLabel(xs: i32[]) -> i32 {
    var s = 0;
    for :outer (xs) { x ->
        var j = 0;
        while (j < 3) {
            j = j + 1;
            if (j == 2) continue :outer;
            s = s + x * 10 + j;
        }
        s = s + 1000;
    }
    return s;
}

fn twoLabels(xs: i32[], ys: i32[], zs: i32[]) -> i32 {
    var n = 0;
    for :a (xs) { x ->
        for :b (ys) { y ->
            for (zs) { z ->
                if (z == 2) continue :b;
                if (y == 2) continue :a;
                n = n + 1;
            }
            n = n + 100;
        }
        n = n + 10000;
    }
    return n;
}

pub fn runCase() {
    print(whileUnderLabel([1, 2, 3]));
    print(twoLabels([1, 2], [1, 2], [1, 2, 3]));
}

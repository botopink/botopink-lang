//// Decision 541 (2) — a labelled `break :outer` in a `case` arm's block, or
//// in a plain block, reaches the named outer loop: the block is no closure.

import {io.terminal.print} from "std";

fn firstPair(xs: i32[], ys: i32[]) -> i32 {
    var found = 0;
    for :outer x in xs {
        for y in ys {
            case x + y {
                5 {
                    found = x * 10 + y;
                    break :outer;
                }
                _ {}
            }
        }
    }
    return found;
}

fn sumBeforeTwo(xs: i32[], ys: i32[]) -> i32 {
    var s = 0;
    for :outer x in xs {
        for y in ys {
            { if (y == 2) break :outer }
            s = s + x * y;
        }
    }
    return s;
}

pub fn runCase() -> void {
    print(firstPair([1, 2, 3], [1, 2, 3]));
    print(sumBeforeTwo([1, 2], [1, 2, 3]));
}

//// Decision 541 (2) — a labelled `continue :outer` from a nested loop's body,
//// or from a `case` arm's block, starts the named outer loop's next round.

import {io.terminal.print} from "std";

fn sumSkippingRows(xs: i32[], ys: i32[]) -> i32 {
    var s = 0;
    for :outer x in xs {
        for y in ys {
            if (y == x + 1) continue :outer;
            s = s + x * 10 + y;
        }
        s = s + 1000;
    }
    return s;
}

fn countUntilFive(xs: i32[], ys: i32[]) -> i32 {
    var n = 0;
    for :outer x in xs {
        for y in ys {
            case x + y {
                5 {
                    continue :outer;
                }
                _ {}
            }
            n = n + 1;
        }
    }
    return n;
}

pub fn runCase() -> void {
    print(sumSkippingRows([1, 2, 3], [1, 2, 3]));
    print(countUntilFive([1, 2, 3], [1, 2, 3]));
}

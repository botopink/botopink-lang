//// Decision 541 (4) — a block `{ … }` as the last statement of a function body
//// is its tail: the function answers the block's value.

import {io.terminal.print} from "std";

fn answer() -> i32 {
    { 41 + 1 }
}

fn greeting(loud: bool) -> string {
    val base = "hello";
    {
        val suffix = if (loud) "!" else ".";
        base + suffix
    }
}

pub fn main() -> void {
    print(answer());
    print(greeting(true));
    print(greeting(false));
}

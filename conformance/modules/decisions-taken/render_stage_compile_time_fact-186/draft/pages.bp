//// Two pages: one reaches a `#[serverOnly]` hook, one reaches none.

import {comptime.stages.serverOnly, comptime.stages.page};

type View(text: string)

#[serverOnly]
component fn searchParams() -> Component<string> {
    return "q=botopink";
}

#[page]
pub component fn Home() -> Component<View> {
    return View(text: "home");
}

#[page]
pub component fn Search() -> Component<View> {
    val q = use searchParams();
    return View(text: "search " + q);
}

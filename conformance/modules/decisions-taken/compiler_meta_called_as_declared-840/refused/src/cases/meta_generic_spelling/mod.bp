//// `compiler.meta` takes the type as its second argument; `compiler.meta<Entity>(decl)`
//// is no spelling (decision 840) — it is the ordinary missing-argument refusal.

import {compiler} from "std";

pub type Entity(table: string)

pub fn describe(syntax q: string) -> string {
    val decl = compiler.lookup(q, compiler.text(q)) ?? compiler.fail("not in scope", at: q);
    val e = compiler.meta<Entity>(decl) ?? compiler.fail("no entity", at: q);
    return compiler.build("\"" + e.table + "\"");
}

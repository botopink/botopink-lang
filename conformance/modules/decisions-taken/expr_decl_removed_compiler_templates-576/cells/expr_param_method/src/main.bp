//// Decision 576 (2) — a `syntax` parameter is the expression written, opaque
//// in the body: it is read through the compiler, `compiler.text(e)`, and a
//// method called on it, `message.text()`, is refused at the call
//// (`expr-param-method`).

import {io.terminal.print} from "std";

fn shout(syntax message: string) -> string {
    return message.text();
}

pub fn main() -> void {
    print(shout @`x`);
}

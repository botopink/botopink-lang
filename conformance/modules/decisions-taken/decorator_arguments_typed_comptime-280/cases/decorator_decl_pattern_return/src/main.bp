//// Decision 280 (2), example 4 — the pattern names the return type too: a
//// `#[page]` that answers a `string` where the pattern asks for a `View` is
//// refused at the annotation.

import {compiler, io.terminal.print} from "std";

type View(html: string)

type Route<P>(params: P)

fn page<P>(
    syntax decl: fn(route: Route<P>) -> View,
    comptime seg: string,
) {
    compiler.setMeta(Page(seg: seg));
}

#[page("blog")]
fn blog(route: Route<string>) -> string {
    return route.params;
}

pub fn main() {
    print(blog(Route(params: "x")));
}

// What `#[page]` records.
type Page(seg: string)

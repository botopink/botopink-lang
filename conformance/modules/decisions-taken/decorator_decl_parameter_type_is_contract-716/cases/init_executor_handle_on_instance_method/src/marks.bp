//// The decorator: its executor registers the annotated declaration itself,
//// an INSTANCE method (`self` its first declared parameter) handed as a
//// value — 144 B-147.

import {registry.add};
import {registry.Entry};
import {compiler} from "std";

pub fn registered(syntax decl: fn(self: unknown, req: string) -> string) -> void {
    val name = compiler.name(decl)!;
    compiler.init({ -> add(Entry(name: name, call: decl)) });
}

//// Decision 716 — `syntax decl: fn() -> string` is the contract every
//// declaration `#[module]` annotates meets: `home` fits, `count`, a
//// `fn() -> i32`, does not and is refused at its annotation, naming both
//// types; nothing is refused inside the executor.

pub mod marks;
pub mod registry;
import {marks.module};
import {registry.all};
import {io.terminal.print} from "std";

#[module("singleton")]
pub fn home() -> string {
    return "home";
}

#[module("scoped")]
fn count() -> i32 {
    return 1;
}

pub fn main() -> void {
    for (all()) { m ->
        print(m.name + " " + m.make());
    }
    print(count());
}

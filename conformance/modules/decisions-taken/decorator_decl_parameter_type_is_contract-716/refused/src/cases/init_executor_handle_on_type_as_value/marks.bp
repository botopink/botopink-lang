//// The decorator: its executor registers the annotated declaration itself.

import {cases.init_executor_handle_on_type_as_value.registry.add};
import {cases.init_executor_handle_on_type_as_value.registry.Entry};
import {compiler} from "std";

pub fn registered(syntax decl: fn() -> string) {
    val name = compiler.name(decl)!;
    compiler.init({ -> add(Entry(name: name, make: decl)) });
}

//// Decision 716 (3) — a member reads the handle: `decl` is the annotated
//// type as code, typed by `syntax decl: Titled`, so `decl.title()` in the
//// member is `Signup.title()`.

import {compiler, io.terminal.print} from "std";

pub behavior Titled {
    fn title() -> string;
}

fn named(syntax decl: Titled) {
    compiler.addMember("typeName", fn() -> string {
        return decl.title();
    });
}

#[named]
pub type Signup(password: string, confirm: string) implement Titled {
    fn title() -> string {
        return "Signup";
    }
}

pub fn runCase() {
    print(Signup.typeName());
}

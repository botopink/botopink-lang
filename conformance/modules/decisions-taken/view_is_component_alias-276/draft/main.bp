//// Decision 276 — jhonstart declares `pub type View = @Component<Element>;` (354) in `element.bp` — a type alias (decision 110), the same

import {context.run, io.terminal.print} from "std";

pub type Element(text: string)

pub type View = Component<Element>;

component fn Card(title: string) -> View {
    return Element(text: "card " + title);
}

component fn Badge(label: string) -> Component<Element> {
    return Element(text: "badge " + label);
}

fn both(first: View, second: Component<Element>) -> View[] {
    return [first, second];
}

async fn run() -> Async<void> {
    for (both(Badge("new"), Card("home"))) { c ->
        val tree = await run(c);
        print(tree.text);
    }
}

pub fn main() -> void {
    run();
}

//// Decision 103 of 1.0.10-beta (question 97 (b)) — `Iter<T>` is the one
//// wrapper with no error channel, and decision 95 leaves it out of the chain on
//// purpose. So a `#[@generator]` body may not `try`: the refusal names
//// `Iter<Result<T, E>>`, the generator that has a channel. Its sibling
//// `throw` is refused the same way (`reject/throw_in_generator.bp`).

import {io.terminal.print} from "std";

fn parse(n: i32) -> Result<i32, string> { return n; }

iter fn counted(n: i32) -> Iter<i32> {
    val v = try parse(n);
    yield v;
}

pub fn main() -> void { print(1); }

//// Decision 122 of 1.0.10-beta (front 24, § Cells "Iterators"; guide.md § 5.6
//// `h`) — `Iter` is synchronous: `await` does not exist in it, and the
//// refusal suggests `AsyncIter`. `iter-await`, at the `await`.

import {io.terminal.print} from "std";

async fn fetchCount(n: i32) -> Async<i32> {
    return n;
}

iter fn h() -> Iter<i32> {
    yield await fetchCount(1);
}

pub fn main() -> void {
    for (h()) { x ->
        print(x);
    }
}

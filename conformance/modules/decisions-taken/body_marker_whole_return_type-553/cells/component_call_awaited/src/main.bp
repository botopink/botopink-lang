//// Decision 791 (1) — a call of a component only makes its lambda, in a
//// component body too: `view(child: Element)` takes the `Element` a resolved
//// `Title()` answers, never the call itself, and `slot.view` is a component
//// lambda called through a record field.

import {io.terminal.print} from "std";

pub type Element(tag: string, kids: Element[]) implement Renderable

fn text(s: string) -> Element {
    return Element(tag: s, kids: []);
}

pub component fn Title() -> Component<Element> {
    return text("title");
}

pub component fn Wrap(child: Element) -> Component<Element> {
    return Element(tag: "wrap", kids: [child]);
}

pub type Slot(view: fn(child: Element) -> Component<Element>)

pub component fn Page(slot: Slot) -> Component<Element> {
    val direct = await Title();
    val view = slot.view;
    val title = await Title();
    val wrapped = await view(title);
    return Element(tag: "page", kids: [direct, wrapped]);
}

fn render(e: Element) -> string {
    var out = e.tag;
    for (e.kids) { k ->
        out = out + "," + render(k);
    }
    return out;
}

pub async fn main() -> Async<void> {
    val page = await Page(Slot(view: { c -> Wrap(c) }));
    print(render(page));
}

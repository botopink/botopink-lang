//// Decisions 104, 118 and 128 — a component is CALLED, and called inside a
//// component body with the same base it renders within that render: the call
//// answers its `T` (the context owner), not the `Component<T>` wrapper.
//// `div([title(), Counter()])` used to red "expected Element, got Component"
//// with no location. A hook is still `use`d.

import {io.terminal.print} from "std";

pub type Element(tag: string, kids: Element[]) implement Renderable

fn div(children: Element[]) -> Element {
    return Element(tag: "div", kids: children);
}

fn text(s: string) -> Element {
    return Element(tag: s, kids: []);
}

pub component fn Counter() -> Component<Element> {
    return text("counter");
}

pub component fn Page() -> Component<Element> {
    return div([text("title"), Counter()]);
}

fn render(e: Element) -> string {
    var out = e.tag;
    for (e.kids) { k ->
        out = out + "," + render(k);
    }
    return out;
}

pub async fn main() -> Async<void> {
    val page = await Page();
    print(render(page));
}

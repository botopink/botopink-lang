//// Front 19 of 1.0.10-beta (C-27), decision 88 — `use f(x)` activates the hook
//// `f(x)`; decisions 102/104 (front 21) — and decision 128 — a hook
//// is `fn … -> Component<T>` with any `T`, a component the same wrapper
//// with `T: @Renderable`, and every caller runs a component from the root,
//// `c.run(RenderScope.root())`, and awaits that run (commonJS emits every
//// `#[@use]` body as an `async function`; erlang, wasm and beam are eager and
//// `await` is the identity). So `run` runs each component in turn and the
//// values print in the same order on every target.
//// A `use` inside a nested closure is refused (`reject/use_in_closure.bp`). The
//// owner type is declared here (no library).

import {context.RenderScope, io.terminal.print} from "std";

type Element(count: i32) implement Renderable

type State(value: i32)

component fn state(initial: i32) -> Component<State> {
    return State(value: initial);
}

component fn pair(a: i32, b: i32) -> Component<#(i32, i32)> {
    return #(a, b);
}

component fn optimistic(
    base: i32,
    f: fn(current: i32, action: i32) -> i32,
) -> Component<#(i32, fn(action: i32) -> i32)> {
    val push: fn(i32) -> i32 = { action -> f(base, action) };
    return #(base, push);
}

component fn effect(cb: fn() -> i32) -> Component<i32> {
    return cb();
}

component fn counter(start: i32) -> Component<State> {
    val s = use state(start * 2);
    return s;
}

component fn Widget(n: i32) -> Component<Element> {
    val c = use state(n);
    return Element(count: c.value + 1);
}

component fn Fields() -> Component<Element> {
    val { value } = use state(5);
    return Element(count: value);
}

component fn Composed() -> Component<Element> {
    val k = use counter(10);
    return Element(count: k.value);
}

component fn Positional() -> Component<Element> {
    val #(x, y) = use pair(3, 4);
    return Element(count: x + y);
}

component fn Effectful() -> Component<Element> {
    use effect({ ->
        return 9;
    });
    val c = use state(1);
    return Element(count: c.value);
}

component fn Liked() -> Component<Element> {
    val #(shown, push) = use optimistic(12, { c, a -> c + a });
    return Element(count: push(shown));
}

// No annotation: an ordinary function (question 92 (b)).
fn Loading() -> Element {
    return Element(count: 7);
}

async fn run() -> Async<i32> {
    val e0 = (await Widget(41).run(RenderScope.root())).value;
    print(e0.count);
    val e1 = (await Fields().run(RenderScope.root())).value;
    print(e1.count);
    val e2 = (await Composed().run(RenderScope.root())).value;
    print(e2.count);
    val e3 = (await Positional().run(RenderScope.root())).value;
    print(e3.count);
    val e4 = (await Effectful().run(RenderScope.root())).value;
    print(e4.count);
    print(Loading().count);
    val e5 = (await Liked().run(RenderScope.root())).value;
    print(e5.count);
    return 0;
}

pub fn main() {
    run();
}

//// Decision 553 (1) — a body that compiles specially carries a marker before
//// `fn`: `iter` (`yield`), `async` (`await`), `async iter` (`yield` and
//// `await`), `component` (`use`, `await`), the return type the wrapper the
//// marker names. On a declaration and a type's method the marked body
//// answers what the unmarked one answers.

import {context.RenderScope, context.createContext, context.provide, context.context, io.terminal.print} from "std";

pub val prefixContext = comptime createContext("");

type View(text: string) implement Renderable

iter fn upTo(n: i32) -> Iter<i32> {
    var i = 0;
    while (i < n) {
        yield i;
        i = i + 1;
    }
}

pub async fn double(x: i32) -> Async<i32> {
    return x * 2;
}

async iter fn doubled(n: i32) -> AsyncIter<i32> {
    for x in upTo(n) {
        yield await double(x);
    }
}

component fn Label(text: string) -> Component<View> {
    val p = use context(prefixContext);
    return View(text: p + text);
}

component fn Page() -> Component<View> {
    use provide(createContext("> "));
    val v = use Label("page");
    return View(text: v.text);
}

type Grid(cells: i32[]) {
    iter fn each(self: Self) -> Iter<i32> {
        for c in self.cells {
            yield c * 10;
        }
    }

    async fn total(self: Self) -> Async<i32> {
        var acc = 0;
        for c in self.cells {
            acc = acc + await double(c);
        }
        return acc;
    }
}

pub async fn main() -> Async<void> {
    for x in upTo(3) {
        print(x);
    }
    print(await double(21));
    for await x in doubled(3) {
        print(x);
    }
    val page = (await Page().run(RenderScope.root())).value;
    print(page.text);
    val g = Grid(cells: [1, 2]);
    for c in g.each() {
        print(c);
    }
    print(await g.total());
}

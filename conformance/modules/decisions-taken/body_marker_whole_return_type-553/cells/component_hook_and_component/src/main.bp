//// Decisions 118, 120 and 128 of 1.0.10-beta (front 24, § Cells "Chain and
//// `use`", first line; guide.md § 4 and § 9, rows `#[@use] fn f() -> @Use<C, T>`,
//// `#[@use] fn f() -> Component<T>`, `#[@context]` and `-> Element` on a
//// component that uses a hook) — one wrapper, `Component<T>`, with the base
//// always written. A HOOK returns any `T` (`state`: `i32`, `label`: `string`);
//// `counter` is a hook that composes a hook with `use` and awaits a Async
//// (`Component ⊃ Async`); `Widget` is a COMPONENT (its `T` implements
//// `@Renderable`) holding `use` and `await` in one body, and `main`
//// runs it from the root, `run(Widget(…))` (decision 388:
//// the call only makes its lambda; 791 (4): no `await` of a component).
////
//// Printed from inside `Widget`: commonJS lowers every `Component` return to an
//// `async function` (decision 120) and hands `main` a Promise.

import {context.run, io.terminal.print} from "std";

type Element(count: i32)

component fn state(initial: i32) -> Component<i32> {
    return initial;
}

component fn label() -> Component<string> {
    return "clicks";
}

async fn answer(n: i32) -> Async<i32> {
    return n;
}

component fn counter(start: i32) -> Component<i32> {
    val s = use state(start);
    val v = await answer(1);
    return s + v;
}

component fn Widget(n: i32) -> Component<Element> {
    val name = use label();
    val c = use counter(n);
    val v = await answer(10);
    print(name + ": " + (c + v).toString());
    return Element(count: c + v);
}

// Decision 388 — a call only makes the component's lambda: `main` awaits
// it, which runs it over a root of its own (`await run(c)`, decision 825).
pub async fn main() -> Async<void> {
    await run(Widget(1));
}

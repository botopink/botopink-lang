//// Decisions 121 and 128 of 1.0.10-beta (front 24, § Cells "Chain and `use`",
//// second line; guide.md § 4.4 `tenant`) — `Component<Result<T, E>>`: a
//// hook whose `T` is a `Result` may `try await` (the fallible channel is read
//// off the return, apart from the level). `tenant` propagates a success and
//// `tenantFor("")` a failure; the component `Handler` is not a `Result`, so it
//// reads both with `case`. Printed from inside `Handler` (commonJS: an
//// `async function`, decision 120).

import {context.run, io.terminal.print} from "std";

type RequestScope(id: string)

component fn requestId() -> Component<string> {
    return "r-7";
}

async fn byRequest(id: string) -> Async<Result<string, string>> {
    if (id == "") throw "no request";
    return "tenant-of-" + id;
}

component fn tenant() -> Component<Result<string, string>> {
    val id = use requestId();
    return try await byRequest(id);
}

component fn tenantFor(id: string) -> Component<Result<string, string>> {
    val known = use requestId();
    return try await byRequest(id);
}

fn show(r: Result<string, string>) -> void {
    case r {
        Ok(v) -> print(v);
        Error(e) -> print("error " + e);
    }
}

component fn Handler() -> Component<RequestScope> {
    val t = use tenant();
    show(t);
    val u = use tenantFor("");
    show(u);
    return RequestScope(id: "r-7");
}

// Decision 388 — a call only makes the component's lambda: `main` awaits
// it, which runs it over a root of its own (`await run(c)`, decision 825).
pub async fn main() -> Async<void> {
    await run(Handler());
}

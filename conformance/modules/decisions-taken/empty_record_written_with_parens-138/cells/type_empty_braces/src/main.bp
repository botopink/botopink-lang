//// 1.0.10-beta decision 138 — the empty record is `type Marker()`; the
//// brace-only spelling `type Marker {}` is refused at the `{`, with the fix-it
//// naming `type Marker()` (decision 67: one spelling).

import {io.terminal.print} from "std";

pub type Marker {}

pub fn main() -> void {
    print(1);
}

//// Decision 621 — in a cell of `Implementation` only the `template` is
//// positional; every other field is written by its label (`result:`, and
//// `inline:` on `.Erlang`), in any order. A bare `true` or `false` after the
//// template is refused at the argument, naming the label its value fits.

import {compiler, io.terminal.print} from "std";

#[compiler.external(.JavaScript("Math.max($0, $1)", true))]
declare fn biggest(a: i32, b: i32) -> i32;

pub fn main() {
    print(biggest(1, 2));
}

//// Decisions 388 and 121 — a bare `try` in a `Component<Result<…>>` body
//// leaves the body early with the error, and the component's lambda still
//// answers it as the body's result: `load("")` is `Error("empty")` read by
//// `Page`, `load("x")` the value. `load` reads a context before its `try`,
//// so it runs with the scope `Page` received — the one `Root` provided.

import {context.run, context.createContext, context.provide, context.context, io.terminal.print} from "std";

type View(text: string)

pub val unitContext = comptime createContext("");

fn parse(s: string) -> Result<i32, string> {
    if (s == "") throw "empty";
    return 7;
}

component fn load(s: string) -> Component<Result<string, string>> {
    val unit = use context(unitContext);
    val n = try parse(s);
    return (n + 1).toString() + unit;
}

component fn Page(s: string) -> Component<View> {
    val r = use load(s);
    val text = case r {
        Ok(v) -> v;
        Error(e) -> "error " + e;
    };
    return View(text: text);
}

component fn Root(s: string) -> Component<View> {
    use provide(createContext("kg"));
    val p = use Page(s);
    return View(text: p.text);
}

pub async fn main() -> Async<void> {
    val a = await run(Root("x"));
    print(a.text);
    val b = await run(Root(""));
    print(b.text);
}

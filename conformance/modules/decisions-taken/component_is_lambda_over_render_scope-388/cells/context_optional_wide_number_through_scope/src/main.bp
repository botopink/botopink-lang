//// 144 B-25 (proposed by its Conformance step; decisions 354, 388, 504) — an
//// optional wide number crosses the render scope: a `?f64` and a `?i64`
//// provided by `Root`, once with a value and once `null`, are read below it
//// with `use context` and narrowed there — each one the number it was, or
//// absent, on every target. A context is named by its value's type (379),
//// so each optional travels in a type of its own.

import {context.run, context.createContext, context.provide, context.context, io.terminal.print} from "std";

type View(text: string)

type Rate(value: ?f64)

type Total(value: ?i64)

pub val rateContext = createContext(Rate(value: null));

pub val totalContext = createContext(Total(value: null));

component fn Label() -> Component<View> {
    val r = (use context(rateContext)).value;
    val t = (use context(totalContext)).value;
    val rate = if (r != null) (r * 2.0).toString() else "no rate";
    val total = if (t != null) (t + 1).toString() else "no total";
    return View(text: rate + " " + total);
}

component fn Root(rate: ?f64, total: ?i64) -> Component<View> {
    use provide(createContext(Rate(value: rate)));
    use provide(createContext(Total(value: total)));
    val l = use Label();
    return View(text: l.text);
}

pub async fn main() -> Async<void> {
    val big: i64 = 9000000000;
    val some = await run(Root(1.25, big));
    print(some.text);
    val none = await run(Root(null, null));
    print(none.text);
}

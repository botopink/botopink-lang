//// Decision 388 (1) — a component at run time is a lambda over a
//// `RenderScope`: the call `Card(item)` runs nothing (`made` prints before
//// any `ran`), so `itens.map(Card)` answers lambdas and generic code needs
//// nothing of a component (`twice` keeps two of them). `Lista` places the
//// lambdas in its tree, and the tree's runner (`render`) runs them with the
//// scope `Lista`'s run answered — the one its `use provide` made — so every
//// card reads `Lista`'s prefix, after `Lista`'s own body ended.

import {context.createContext, context.provide, context.context, context.RenderScope, io.terminal.print} from "std";

type Item(name: string)

type View(text: string, kids: Component<View>[]) implement Renderable

pub val prefixContext = comptime createContext("");

component fn Card(item: Item) -> Component<View> {
    val p = use context(prefixContext);
    print("ran " + item.name);
    return View(text: p + item.name, kids: []);
}

component fn Lista(itens: Item[]) -> Component<View> {
    use provide(createContext("#"));
    val cards = itens.map(Card);
    print("lista made " + cards.length.toString());
    return View(text: "lista", kids: cards);
}

fn twice<T>(x: T) -> T[] {
    return [x, x];
}

// Run `c` with `scope`, then each child with the scope `c`'s run answered.
async fn render(c: Component<View>, scope: RenderScope) -> Async<string> {
    val r = await c.run(scope);
    var out = r.value.text;
    for k in r.value.kids {
        val inner = await render(k, r.scope);
        out = out + " " + inner;
    }
    return out;
}

pub async fn main() -> Async<void> {
    val c = Card(Item(name: "x"));
    val cs = twice(c);
    print("made " + cs.length.toString());
    print(
        await render(
            Lista([Item(name: "a"), Item(name: "b")]),
            RenderScope.root(),
        ),
    );
}

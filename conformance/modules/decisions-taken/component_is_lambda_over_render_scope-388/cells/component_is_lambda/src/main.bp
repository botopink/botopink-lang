//// Decision 388 (1) — a component at run time is a function over a `Scope`
//// and a `Place`: the call `Card(item)` runs nothing (`made` prints before
//// any `ran`), so `itens.map(Card)` answers components and generic code needs
//// nothing of a component (`twice` keeps two of them). `Lista` resolves the
//// cards inside its own body, after its `use provide` (decision 908: `use
//// all`), so every card reads `Lista`'s prefix.

import {context.all, context.createContext, context.provide, context.context, context.run, io.terminal.print} from "std";

type Item(name: string)

type View(text: string)

pub val prefixContext = comptime createContext("");

component fn Card(item: Item) -> Component<View> {
    val p = use context(prefixContext);
    print("ran " + item.name);
    return View(text: p + item.name);
}

component fn Lista(itens: Item[]) -> Component<View> {
    use provide(createContext("#"));
    val cards = itens.map(Card);
    print("lista made " + cards.length.toString());
    val shown = use all(cards);
    return View(text: "lista " + shown.map({ v -> v.text }).join(" "));
}

fn twice<T>(x: T) -> T[] {
    return [x, x];
}

pub async fn main() -> Async<void> {
    val c = Card(Item(name: "x"));
    val cs = twice(c);
    print("made " + cs.length.toString());
    print((await run(Lista([Item(name: "a"), Item(name: "b")]))).text);
}

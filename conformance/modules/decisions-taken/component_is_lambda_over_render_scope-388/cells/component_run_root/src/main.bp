//// Decision 388 (2), (4) — a component is resolved inside the body whose
//// cell holds its contexts (decision 908): `Shell` provides `dark`, and the
//// `Mode` it `use`s and the one it resolves by hand over its own cell
//// (`resolve(Mode(), scope, Place.none())` in a `{ scope -> … }` lambda) both
//// read it. Outside every body the root is run with `run(c)` (791 (4): no
//// `await c`).

import {context.run, context.resolve, context.Place, context.createContext, context.provide, context.context, io.terminal.print} from "std";

type View(text: string)

type Shown(text: string, first: string, second: string)

pub val modeContext = comptime createContext("");

component fn Mode() -> Component<View> {
    val m = use context(modeContext);
    return View(text: "mode " + m);
}

fn textOf(r: View | Async<View>) -> string {
    if (r is View) return r.text;
    return "async";
}

component fn Shell() -> Component<Shown> {
    use provide(createContext("dark"));
    val m = use Mode();
    val byHand: Component<string> = { scope -> textOf(resolve(Mode(), scope, Place.none())) };
    val again = use byHand;
    return Shown(text: "shell", first: m.text, second: again);
}

pub async fn main() -> Async<void> {
    val r = await run(Shell());
    print(r.text);
    print(r.first);
    print(r.second);
    val v = await run(Shell());
    print(v.text);
}

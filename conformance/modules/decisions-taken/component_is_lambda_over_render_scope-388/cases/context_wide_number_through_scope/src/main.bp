//// Decisions 354, 379 and 388 — a value of any type crosses the render scope:
//// an `f64` and an `i64` provided by `Root` are read below it with `use
//// context(rateContext)` / `use context(totalContext)`,
//// and the hooks `rate` and `total` render an `f64` and an `i64` that `Label`
//// reads with `use` — each one the number it was, on every target.

import {context.run, context.createContext, context.provide, context.context, io.terminal.print} from "std";

type View(text: string)

pub val rateContext = comptime createContext(0.0);

pub val totalContext = createContext(0l);

component fn rate() -> Component<f64> {
    val r = use context(rateContext);
    return r * 2.0;
}

component fn total() -> Component<i64> {
    val t = use context(totalContext);
    return t + 1;
}

component fn Label() -> Component<View> {
    val r = use rate();
    val t = use total();
    return View(text: r.toString() + " " + t.toString());
}

component fn Root() -> Component<View> {
    val big: i64 = 9000000000;
    use provide(createContext(1.25));
    use provide(createContext(big));
    val l = use Label();
    return View(text: l.text);
}

pub async fn main() -> Async<void> {
    val v = await run(Root());
    print(v.text);
}

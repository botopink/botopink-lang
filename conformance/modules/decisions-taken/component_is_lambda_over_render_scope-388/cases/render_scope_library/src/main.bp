//// Decision 388 (3) — the scope travels explicitly: a component is resolved
//// inside the body whose cell holds its contexts (decision 908). `Root`
//// provides `light`; the `Label` it `use`s reads it, and the `Page`s it
//// resolves with `use all` read it above them. `Page` provides `dark` and
//// resolves its two `Label`s by hand over its own cell: both read `dark`. A
//// value kept for later (a `Suspense` fill, a retry) runs with the scope it
//// kept: `Page` hands the host a thunk `{ -> resolve(l, scope, Place.none())
//// }` — `hostNow` calls it at once, `hostStash` keeps the last one and `main`
//// runs it twice after the render has returned. Nothing is captured.

import {context.all, context.run, context.resolve, context.Place, context.Scope, context.createContext, context.provide, context.context, compiler, io.terminal.print} from "std";

type Theme(mode: string)

type View(text: string)

pub val themeContext = comptime createContext(Theme(mode: "default"));

#[compiler.external(.JavaScript("""($0)()"""), .Erlang("""($0)()"""))]
declare fn hostNow(f: fn() -> View | Async<View>) -> View | Async<View>;

#[compiler.external(
    .JavaScript("""(globalThis.__bpScopeStash = $0, undefined)"""),
    .Erlang("""persistent_term:put(bp_scope_stash, $0)"""),
)]
declare fn hostStash(f: fn() -> View | Async<View>) -> void;

#[compiler.external(
    .JavaScript("""globalThis.__bpScopeStash"""),
    .Erlang("""persistent_term:get(bp_scope_stash)"""),
)]
declare fn hostStashed() -> fn() -> View | Async<View>;

fn textOf(r: View | Async<View>) -> string {
    if (r is View) return r.text;
    return "async";
}

component fn Label(prefix: string) -> Component<View> {
    val t = use context(themeContext);
    return View(text: prefix + t.mode);
}

component fn Page(title: string) -> Component<View> {
    val above = use context(themeContext);
    use provide(createContext(Theme(mode: "dark")));
    val labels = ["a:", "b:"].map(Label);
    val kids: Component<string> = { scope ->
        labels
            .map({ l ->
                hostStash({ -> resolve(l, scope, Place.none()) });
                textOf(hostNow({ -> resolve(l, scope, Place.none()) }))
            })
            .join(" ")
    };
    val shown = use kids;
    return View(text: title + "(" + above.mode + ") " + shown);
}

component fn Root() -> Component<View> {
    use provide(createContext(Theme(mode: "light")));
    val own = use Label("root:");
    val pages = use all(["page"].map(Page));
    return View(text: own.text + " " + pages.map({ v -> v.text }).join(" "));
}

pub async fn main() -> Async<void> {
    val root = Scope.root();
    print((await run(Root(), root)).text);
    val later = hostStashed();
    val first = textOf(later());
    val second = textOf(later());
    print(first + " " + second);
    root.close();
}

//// Decisions 809 (8), 811 — a `Scope` is opaque: made only by
//// `Scope.root()`, a cell's `childAt` and `detach`; its constructor written
//// anywhere else is refused at the call (`opaque-construction`).

import {context.Scope} from "std";

pub fn main() -> void {
    val s = Scope(scopeStore: null, scopeCell: 0, scopeOwner: null);
}

//// Decision 722 — A context is read through a context value the reader imports — `use context(themeContext)`, never a bare type name — answering the nearest context of that type provided above, else the default the handle carries; the handle is imported as any name, so the default is found through the import graph and nothing is searched

import {io.terminal} from "std";
import {context.context, context.createContext, context.provide, context.RenderScope} from "std";
import {theme.themeContext, theme.Theme};

type Element(text: string, child: ?Component<Element>) implement Renderable

component fn Card() -> Component<Element> {
    val t = use context(themeContext);
    return Element(text: "card " + t.primary, child: null);
}

component fn Dark() -> Component<Element> {
    val dark = comptime createContext(Theme(primary: "#111827", radius: 0));
    use provide(dark);
    return Element(text: "dark", child: Card());
}

fn render(c: Component<Element>, scope: RenderScope) -> string {
    val r = c.run(scope);
    val child = r.value.child;
    if (child == null) return r.value.text;
    return r.value.text + " > " + render(child!, r.scope);
}

pub fn main() -> void {
    terminal.print(render(Card(), RenderScope.root()));
    terminal.print(render(Dark(), RenderScope.root()));
}

//// Decision 574 — a lambda marked `component` passed where a parameter
//// expects `fn(name: string) -> Component<View>` (147) is a `component fn`:
//// `List` makes one component per name and resolves them inside its own body,
//// after its `use provide` (decision 908: `use all`), so every item reads
//// `List`'s `>`. The `mark` the lambda captures reaches its body, and a
//// `return` leaves it with its value.

import {context.all, context.run, context.createContext, context.provide, context.context, io.terminal.print} from "std";

type View(text: string)

pub val prefixContext = comptime createContext("");

component fn List(names: string[], item: fn(name: string) -> Component<View>) -> Component<View> {
    use provide(createContext(">"));
    val items = use all(names.map(item));
    return View(text: "list " + items.map({ v -> v.text }).join(" "));
}

pub async fn main() -> Async<void> {
    val mark = "*";
    val page = List(["a", "", "b"], { component name ->
        val p = use context(prefixContext);
        if (name == "") return View(text: p + "empty");
        View(text: p + name + mark)
    });
    print((await run(page)).text);
}

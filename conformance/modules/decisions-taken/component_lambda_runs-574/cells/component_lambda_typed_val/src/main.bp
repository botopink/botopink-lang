//// Decision 574 — a lambda marked `component`, bound to a `val` typed by
//// the function type it is written for (147), is a `component fn`: calling
//// it only makes the component (`made` prints before any `ran`), and the
//// component runs where it is resolved — at a root of its own (`a` reads
//// the declared default), and by a `use` inside `Shell`'s body, after its
//// `use provide` (`b` reads `Shell`'s `#`, decision 908). Its parameter and the
//// `suffix` it captures reach the body. The body answers its last
//// expression.

import {context.run, context.createContext, context.provide, context.context, io.terminal.print} from "std";

type View(text: string)

pub val prefixContext = comptime createContext("");

component fn Shell(inner: Component<View>) -> Component<View> {
    use provide(createContext("#"));
    val v = use inner;
    return v;
}

pub async fn main() -> Async<void> {
    val suffix = "!";
    val Card: fn(name: string) -> Component<View> = { component name ->
        val p = use context(prefixContext);
        print("ran " + name);
        View(text: p + name + suffix)
    };
    val c = Card("a");
    print("made");
    val v = await run(c);
    print(v.text);
    val r = await run(Shell(Card("b")));
    print(r.text);
}

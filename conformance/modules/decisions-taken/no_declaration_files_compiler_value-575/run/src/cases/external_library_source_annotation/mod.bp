//// Decision 575 (6) — a library writes its own source annotation the way std's
//// `external` is written: a decorator that hands `compiler.implement` an
//// `Implementation`. `#[bif("lists")]` binds the erlang BIF of the module named
//// by its argument; the other targets name their own.

import {compiler, io.terminal.print} from "std";

fn bif(syntax decl: unknown, comptime module: string) {
    compiler.implement(Implementation.Erlang(module + ":reverse($0)"));
}

#[bif("lists")]
#[compiler.external(.JavaScript("[...$0].reverse()"), .Wasm(body: reverseBody))]
declare fn backwards(xs: i32[]) -> i32[];

fn reverseBody(xs: i32[]) -> i32[] {
    return xs.reverse();
}

pub fn runCase() {
    print(backwards([1, 2, 3]));
}

//// Decision 575 (5) — the type argument of a `comptime t: type<T>` binds
//// `T`: here `T` is already `i32` from the declaration pattern `fn() -> T`,
//// so the type argument `string` is refused where it is written.

import {compiler, io.terminal.print} from "std";

pub type Provides(name: string)

fn provides<T>(syntax decl: fn() -> T, comptime t: type<T>) -> void {
    compiler.setMeta(Provides(name: compiler.name(decl)!));
}

#[provides(string)]
fn count() -> i32 {
    return 1;
}

pub fn main() -> void {
    print(count());
}

//// Decision 426 (2) — a template answering `Component<Styled>` refuses
//// built code of a `Component<Other>` function: the bound compares the
//// types as written (`template-build-outside-bound`).

import {compiler, io.terminal.print} from "std";

type Styled(text: string)

type Other(text: string)

component fn mk() -> Component<Other> {
    return Other(text: "other");
}

component fn view(syntax q: string) -> Component<Styled> {
    return compiler.build("mk()");
}

pub component fn Page() -> Component<Styled> {
    return view @`a`;
}

pub async fn main() -> Async<void> {
    val page = await Page();
    print(page.text);
}

//// Decisions 578 (2), 719 — a function with a `syntax` expression parameter
//// is expanded at its call and its build body returns code: a run-time
//// return type is refused at the declaration (`template-signature`).

import {compiler} from "std";
import {io.terminal.print} from "std";

pub fn length(syntax value: string[]) -> i32 {
    return compiler.text(value).length;
}

pub fn main() -> void {
    print(length(["a", "b"]));
}

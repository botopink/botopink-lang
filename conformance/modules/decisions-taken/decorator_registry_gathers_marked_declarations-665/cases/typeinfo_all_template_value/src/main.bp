//// Decision 353 — a template body reads the program's catalogue at build,
//// where a declaration of the program is no value: `value` is refused at the
//// read (`name`, `module`, `meta` and `returnTypeName` are answered).

import {compiler, io.terminal.print} from "std";

pub fn mark(syntax decl: unknown) -> void {
    compiler.setMeta(Mark(name: compiler.name(decl)!));
}

pub fn first(syntax e: string) -> string {
    val all = @TypeInfo.all(with: mark);
    val v = all.map({ d -> d.value });
    return compiler.text(e) + v.length.toString();
}

#[mark]
pub fn job() -> i32 {
    return 1;
}

pub fn main() -> void {
    print(first @`x`);
}

// What `#[mark]` records.
pub type Mark(name: string)

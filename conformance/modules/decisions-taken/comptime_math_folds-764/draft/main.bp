//// Decision 764 — (a): math's `op:`-only host functions — `sqrt`, `floor`, `abs`, `trunc`, `minF`, `maxF` — gain a `std:` cell each in std-wasm beside their opcode, so the comptime runtime answers them and they fold at build.

import {io.terminal, math} from "std";

pub fn main() -> void {
    // Each of the six has a `std:` cell beside its opcode, so the comptime
    // runtime answers it: computed at build, the same bits as at run time.
    val root = comptime math.sqrt(16.0);
    val down = comptime math.floor(2.7);
    val size = comptime math.abs(-3.5);
    val cut = comptime math.trunc(-2.7);
    val low = comptime math.minF(1.5, 2.5);
    val high = comptime math.maxF(1.5, 2.5);
    terminal.print("${root} ${down} ${size} ${cut} ${low} ${high}");
    // The same calls at run time answer the same values.
    val x = 16.0;
    terminal.print(root == math.sqrt(x));
}

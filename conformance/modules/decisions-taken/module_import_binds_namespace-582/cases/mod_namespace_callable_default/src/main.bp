//// conformance/docs.md § Imports — the namespace `mod double;` binds is the one
//// `import {double};` binds elsewhere (decision 337), so written as a value it is
//// the module's `pub default` too (decision 582).

import {io.terminal.print} from "std";

mod double;

pub fn main() -> void {
    print(double(4));
    val f = double;
    print(f(5));
    print(double.twice(3));
}

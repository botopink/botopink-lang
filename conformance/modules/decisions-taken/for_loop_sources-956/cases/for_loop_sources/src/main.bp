//// Decision 956 — the collection loop is 105's: the sources after `for`, the
//// body a block opening with one parameter per source. One source is written
//// bare or in parentheses, one loop either way; `for await` walks an
//// `AsyncIter`; a source may be `try r`, the `Ok` value walked and an `Error`
//// propagated. Several sources, in parentheses, walk together, one item of each
//// per round, ending with the shortest; an open range `0...` never ends the
//// loop and serves as the index. The body is a loop body: `break`, `continue`,
//// a label after the keyword, a `return` leaving the enclosing function.

import {io.terminal.print} from "std";

iter fn tens() -> Iter<i32> {
    yield 10;
    yield 20;
    yield 30;
}

async iter fn countdown(n: i32) -> AsyncIter<i32> {
    var i = n;
    while (i > 0) {
        yield i;
        i = i - 1;
    }
}

type Grid(cells: i32[]) {
    fn iter(self: Self) -> Iter<i32> {
        return iter for self.cells { c ->
            yield c;
        };
    }
}

fn items(n: i32) -> Result<i32[], string> {
    if (n < 0) throw "negative";
    return [n, n + 1];
}

fn sum(n: i32) -> Result<i32, string> {
    var total = 0;
    for try items(n) { x ->
        total = total + x;
    }
    return total;
}

// `return` from the walk of three sources leaves the function.
fn firstOver(names: string[], limit: i32) -> string {
    for (names, tens(), 0...) { name, ten, i ->
        if (ten > limit) return name + "@" + i.toString();
    }
    return "none";
}

async fn run() -> Async<void> {
    for await countdown(2) { x ->
        print("await bare " + x.toString());
    }
    for await (countdown(1)) { x ->
        print("await parenthesised " + x.toString());
    }
}

pub fn main() -> void {
    val xs = [1, 2, 3];
    for xs { x ->
        print("bare " + x.toString());
    }
    for (xs) { x ->
        print("parenthesised " + x.toString());
    }
    for 1...3 { i ->
        print("range " + i.toString());
    }
    for tens() { t ->
        print("iter " + t.toString());
    }
    val g = Grid(cells: [4, 5]);
    var total = 0;
    for g.iter() { c ->
        total = total + c;
    }
    print("grid " + total.toString());
    print("try " + sum(1).unwrapOr(-1).toString());
    print("try " + sum(-1).unwrapOr(-1).toString());

    // Two sources, the shorter ending the loop.
    for (["a", "b", "c", "d"], tens()) { s, t ->
        print(s + t.toString());
    }
    for (tens(), ["p", "q"]) { t, s ->
        print(s + t.toString());
    }
    for (xs, 5..7) { x, r ->
        print("range pair " + x.toString() + " " + r.toString());
    }
    // Three sources and the open range as the index.
    for (["x", "y", "z"], tens(), 0...) { s, t, i ->
        print(i.toString() + ": " + s + " " + t.toString());
    }
    for (0..., g.iter()) { i, item ->
        total = total + i * item;
    }
    print("indexed " + total.toString());

    // The body is a loop body.
    for :outer (["m", "n", "o", "p"], 0...) { s, i ->
        if (s == "n") continue :outer;
        if (s == "p") break :outer;
        print("body " + s + i.toString());
    }
    for 0... { i ->
        if (i == 2) break;
        print("open " + i.toString());
    }
    print(firstOver(["u", "v", "w"], 15));
    print(firstOver(["u"], 15));
    run();
}

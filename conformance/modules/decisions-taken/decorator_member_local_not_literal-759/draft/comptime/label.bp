import {compiler} from "std";

pub type Label(text: string)

pub fn label(syntax decl: unknown, comptime text: string) -> void {
    val shown = "[" + text + "]";
    val record = Label(text: text);
    compiler.addMember("shown", fn() -> string {
        return shown;
    });
    compiler.addMember("label", fn() -> string {
        return record.text;
    });
}

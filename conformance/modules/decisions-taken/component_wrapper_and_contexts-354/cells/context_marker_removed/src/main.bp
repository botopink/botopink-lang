//// Decision 354 (1) — the owner marker `@Context<C>` left the language, and the
//// name `Context` is std's context object (804 (2) took `Renderable` out too).
//// Refused where it is written; the hint drops it from the `implement` clause.

import {io.terminal.print} from "std";

type Element(count: i32) implement @Context<Element>

pub fn main() -> void {
    print(Element(count: 1).count);
}

//// Decision 354 (1) — the owner marker `@Context<C>` left the language: a
//// component's `R` implements `@Renderable`, and the name `Context` is std's
//// context object. Refused where it is written, naming the marker to write.

import {io.terminal.print} from "std";

type Element(count: i32) implement @Context<Element>

pub fn main() -> void {
    print(Element(count: 1).count);
}

//// Decision 354 (3) — a template function's body (`-> @Expr<…>`) runs at
//// compile time when a call is expanded, with no render tree: `use` there is
//// refused.

import {context.createContext, context.provide, context.context, io.terminal.print} from "std";

type Theme(mode: string)

type Element(text: string)

pub val themeContext = comptime createContext(Theme(mode: "default"));

fn shout(syntax q: string) -> string {
    val t = use context(themeContext);
    return q;
}

pub fn main() -> void {
    print("unreached");
}

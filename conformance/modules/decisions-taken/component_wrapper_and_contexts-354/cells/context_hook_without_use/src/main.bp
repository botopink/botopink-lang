//// Decision 354 (2) — `provide` and `context` are hooks: `use`d, never
//// called for their value. A bare call is refused at the call.

import {context.createContext, context.provide, context.context} from "std";

type Theme(mode: string)

type Element(text: string)

pub val themeContext = comptime createContext(Theme(mode: "default"));

component fn Label() -> Component<Element> {
    val t = context(themeContext);
    return Element(text: "");
}

pub fn main() -> void {
    Label();
}

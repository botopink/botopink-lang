//// Question `14s8-e` (a), 01-compiler/14 step 8 — a `comptime` that calls a
//// component reading a context reaches a `use` with no render tree around
//// it (decision 354 (3)): nothing provides `themeContext`. Refused at the
//// `comptime`, naming the `use` and the function holding it; the run used
//// to stop at whatever the provider's absence broke first.

import {context.createContext, context.provide, context.context, io.terminal.print} from "std";

type Theme(mode: string)

type Element(text: string) implement Renderable

pub val themeContext = comptime createContext(Theme(mode: "default"));

fn label() -> Component<Element> {
    val t = use context(themeContext);
    return Element(text: t.mode);
}

pub fn main() {
    val pre = comptime label();
    print(pre.text);
}

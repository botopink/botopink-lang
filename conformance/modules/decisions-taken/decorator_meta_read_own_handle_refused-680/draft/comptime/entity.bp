import {compiler, io.terminal.print} from "std";

pub type Entity(table: string)

pub fn entity(syntax decl: unknown, comptime table: string) -> void {
    compiler.setMeta(Entity(table: table));
}

pub fn register(syntax decl: unknown) -> void {
    compiler.init({ ->
        print("registered " + (compiler.meta<Entity>(decl)?.table ?? "none"));
    });
}

pub fn peek(syntax decl: unknown) -> void {
    val seen = compiler.meta<Entity>(decl);
    compiler.setMeta(Entity(table: (seen?.table ?? "none") + "-seen"));
}

//// One decorator sets the meta, the other adds it: the pair is refused.

import {compiler} from "std";

pub type Entity(table: string)

pub fn entity(syntax decl: unknown, comptime table: string) -> void {
    compiler.setMeta(Entity(table: table));
}

pub fn alias(syntax decl: unknown, comptime table: string) -> void {
    compiler.addMeta(Entity(table: table));
}

//// Decision 989 (1), (2) — `run()` answers the text the loaded package printed: `Ok(text)` with
//// what its body and its `main` wrote, none of it on the program's own output; `Async` of that
//// answer when the loaded `main` is `async`, awaited; and `RunFailure.output` with what was
//// written before a crash (`.Abort`) or before `main` returned `Error` (`.Failed`). Each text
//// is printed between brackets, so its last line break shows.

import {async, compiler, compiler.RunFailure, io.terminal.print} from "std";

fn show(answer: Result<string, RunFailure>) -> void {
    case answer {
        Ok(text) -> print("ok [" + text + "]");
        Error(r) -> case r.kind {
            .Abort -> print("abort " + r.message + " [" + r.output + "]");
            .Failed -> print("failed " + r.message + " [" + r.output + "]");
        };
    }
}

// Expanded where the block calls it (decision 788): its load and its `compiler.init`
// are the block's.
fn runCase(comptime name: string) -> void {
    val loaded = comptime compiler.load("packages/" + name);
    case loaded {
        Ok(m) -> compiler.init({ ->
            print("== " + name);
            val answer = m.run();
            show(answer);
        });
        Error(refused) -> compiler.init({ -> print("refused " + refused.module.path()) });
    }
}

comptime {
    runCase("fine");
    runCase("crash");
    runCase("err");
    // `later`'s `main` is `async`: its `run()` answers an `Async`, awaited in the
    // task the init body starts.
    val later = comptime compiler.load("packages/later");
    case later {
        Ok(m) -> compiler.init({ ->
            print("== later");
            val awaited = async {
                show(await m.run());
            };
        });
        Error(refused) -> compiler.init({ -> print("refused " + refused.module.path()) });
    }
}

// The program's own output: its `main` prints once the task the last init
// body started has settled.
pub async fn main() -> Async<void> {
    await async.delay(10, 0);
    print("main");
}

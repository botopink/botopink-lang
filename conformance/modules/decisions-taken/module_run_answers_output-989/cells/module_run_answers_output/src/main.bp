//// Decision 989 (1), (2) — `run()` answers the text the loaded package printed: `Ok(text)` with
//// what its body and its `main` wrote, none of it on the program's own output; `Async` of that
//// answer when the loaded `main` is `async`, awaited; and `RunFailure.output` with what was
//// written before a crash (`.Abort`) or before `main` returned `Error` (`.Failed`). Each text
//// is printed between brackets, so its last line break shows.

import {compiler, compiler.RunFailure, io.terminal.print} from "std";

fn show(answer: Result<string, RunFailure>) -> void {
    case answer {
        Ok(text) -> print("ok [" + text + "]");
        Error(r) -> case r.kind {
            .Abort -> print("abort " + r.message + " [" + r.output + "]");
            .Refused -> print("refused " + r.message);
            .Excluded -> print("excluded " + r.message);
            .Failed -> print("failed " + r.message + " [" + r.output + "]");
        };
    }
}

// Decision 998 (5) — one helper for every case, expanded at each run-time call in
// `main`: the loaded `main`'s kind read at build, an `async` one's `run()`
// awaited by `main`'s own `async` body.
fn runCase(comptime name: string) -> void {
    val loaded = try comptime compiler.load("packages/" + name) catch { r ->
        compiler.init({ -> print("refused packages/" + name); });
        return;
    };
    if (comptime loaded.mainAsync()) {
        compiler.init({ async ->
            print("== " + name);
            show(await loaded.run());
        });
    } else {
        compiler.init({ ->
            print("== " + name);
            show(loaded.run());
        });
    }
}

// The program's own output: each case in order, then `main`'s line.
pub async fn main() -> Async<void> {
    runCase("fine");
    runCase("crash");
    runCase("err");
    // `later`'s `main` is `async`: its `run()` answers an `Async`, awaited here.
    runCase("later");
    print("main");
}

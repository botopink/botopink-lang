//// Decision 359 — a spread is an expression like any construction: it is a
//// field's value in another constructor, the source of another spread, an
//// element of an array, a lambda's and a function's result; its source may
//// be a field path (`equipe.lider`) or a spread itself. Each builds a new
//// record, its sources unchanged.

import {io.terminal.print} from "std";

type Pessoa(nome: string, idade: i32)

type Equipe(lider: Pessoa, vice: Pessoa, titulo: string)

fn renomear(p: Pessoa, nome: string) -> Pessoa {
    return Pessoa(..p, nome: nome);
}

fn aplicar(p: Pessoa, f: fn(Pessoa) -> Pessoa) -> Pessoa {
    return f(p);
}

pub fn main() -> void {
    val ana = Pessoa(nome: "Ana", idade: 30);
    // A field's value in another constructor, spread or labelled.
    val equipe = Equipe(lider: Pessoa(..ana, idade: 31), vice: ana, titulo: "A");
    print(equipe);
    val outra = Equipe(..equipe, vice: Pessoa(..equipe.lider, nome: "Bia"));
    print(outra);
    // A field path as the source, and a spread as the source of a spread.
    print(Pessoa(..outra.vice, idade: 40));
    print(Pessoa(..Pessoa(..ana, nome: "Caio"), idade: 50));
    // An array element, a lambda's result, a function's result.
    val ps = [Pessoa(..ana, nome: "Duda"), Pessoa(..ana, idade: 1)];
    ps.forEach({ p -> print(p) });
    print(aplicar(ana, { p -> Pessoa(..p, idade: p.idade + 1) }));
    print(renomear(ana, "Edu"));
    print(ana);
    print(equipe.lider);
}

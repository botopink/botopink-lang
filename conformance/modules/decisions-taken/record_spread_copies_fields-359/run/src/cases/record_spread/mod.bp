//// Decision 359 — a spread copies a record's fields: `...src` at the start of
//// an argument of a record's constructor. The arguments apply left to right,
//// the later winning; `src` is the record's own type or a type derived from it
//// by `Type.pick`, `Type.omit` or `Type.merge` (307); a field no spread and no
//// label supplies takes its default. The spread builds a new record, `src`
//// evaluated once and unchanged.

import {types.Type, io.terminal.print} from "std";

type Pessoa(nome: string, email: string, telefone: string, idade: i32 = 30)

type Extra(nota: string)

val Contato = Type.pick(Pessoa, .email, .telefone);

val SemNome = Type.omit(Pessoa, .nome);

val Ficha = Type.merge(Pessoa, Extra);

type Box<T>(value: T, tag: string)

fn fonte() -> Pessoa {
    print("fonte");
    return Pessoa(nome: "Rui", email: "rui@a", telefone: "1", idade: 40);
}

pub fn runCase() -> void {
    val old = Pessoa(nome: "Bia", email: "bia@a", telefone: "2", idade: 20);
    // A new record; the source unchanged.
    val ana = Pessoa(..old, nome: "Ana");
    print(ana);
    print(old);
    // Several spreads and labels mix, left to right, the later winning.
    val contato = Contato(email: "c@a", telefone: "3");
    print(Pessoa(..old, ..contato, nome: "Caio"));
    print(Pessoa(..contato, ..old));
    print(Pessoa(nome: "Zé", ..old));
    // A derived source supplies its fields; the rest are labelled or default.
    print(Pessoa(..contato, nome: "Duda"));
    val semNome = SemNome(email: "s@a", telefone: "4", idade: 50);
    print(Pessoa(..semNome, nome: "Edu"));
    val ficha = Ficha(nome: "Fê", email: "f@a", telefone: "5", idade: 60, nota: "ok");
    print(Pessoa(..ficha, idade: 61));
    // Any expression is a source, evaluated once.
    print(Pessoa(..fonte(), email: "novo@a"));
    val p = Pessoa(..fonte(), nome: "Gil");
    print(p.nome);
    print(p.idade);
    // A trailing comma, and a generic record.
    val b = Box(value: 3, tag: "t");
    val b2 = Box(
        ..b,
        value: 4,
    );
    print(b2.value);
    print(b2.tag);
}

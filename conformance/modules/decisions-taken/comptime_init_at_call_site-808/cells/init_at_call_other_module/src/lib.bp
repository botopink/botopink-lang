//// Decision 808 (1), (2) — a `pub` function whose every parameter is
//// `comptime` writes `compiler.init`: it type-checks here and leaves the
//// program; this module's run-time `go` expands it at its call.

import {compiler, io.terminal.print} from "std";

pub fn check(comptime name: string) -> void {
    compiler.init({ -> print("case " + name) });
}

pub fn go() -> void {
    print("go");
    check("from lib");
}

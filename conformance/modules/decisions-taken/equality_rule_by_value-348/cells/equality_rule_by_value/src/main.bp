//// Decision 348 — 210 and 211 are the rule for `==`: records, tuples, lists
//// and enum variants compare by value, recursively; a method named `equals`
//// has no role. A tuple literal stands as `==`'s left operand like any other
//// operand.

import {io.terminal.print} from "std";

type Point(x: i32, y: i32) {
    pub fn equals(self: Self, other: Point) -> bool {
        return true;
    }
}

type Shape {
    Circle(radius: f64),
    Square(side: f64),
}

pub fn main() -> void {
    val a = Point(x: 1, y: 2);
    val b = Point(x: 1, y: 2);
    val c = Point(x: 5, y: 2);
    print(a == b);
    print(a == c);
    print(a.equals(c));
    print(#(1, [a, b]) == #(1, [Point(x: 1, y: 2), Point(x: 1, y: 2)]));
    print(#(1, [a, b]) == #(1, [a, c]));
    #(1, "x") == #(1, "x");
    print(Shape.Circle(radius: 1.0) == Shape.Circle(radius: 1.0));
    print(Shape.Circle(radius: 1.0) != Shape.Square(side: 1.0));
}

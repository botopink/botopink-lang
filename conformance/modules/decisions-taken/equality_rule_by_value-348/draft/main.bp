//// Decision 348 — 210 and 211 are the rule for `==`.

import {io.terminal.print} from "std";

type Point(x: i32, y: i32) {
    pub fn equals(self: Self, other: Point) -> bool {
        return true;
    }

    pub fn sameRow(self: Self, other: Point) -> bool {
        return self.y == other.y;
    }
}

type Shape {
    Circle(radius: f64),
    Square(side: f64),
}

pub fn main() -> void {
    val a = Point(x: 1, y: 2);
    val b = Point(x: 1, y: 2);
    val c = Point(x: 5, y: 2);
    print(a == b);
    print(a == c);
    print(a.equals(c));
    print(a.sameRow(c));
    val left = #(1, [a, b]);
    val right = #(1, [Point(x: 1, y: 2), Point(x: 1, y: 2)]);
    print(left == right);
    print(Shape.Circle(radius: 1.0) == Shape.Circle(radius: 1.0));
    print(Shape.Circle(radius: 1.0) != Shape.Square(side: 1.0));
    print([0.0] == [-0.0]);
}

//// Decisions 266, 331 (01-checker step 21) — a `comptime` with a call and a
//// loop runs on the comptime runtime (BEAM for erlang and beam, WAT for
//// commonJS and wasm), never on the target, and its value is written into
//// the program: `comptime two()` emits `2`, the block below emits `6`. The
//// parent binary lowered both as run-time code: erlang refused the block
//// (`variable 'D@4' is unbound`), commonJS read `d` before it was bound and
//// wasm had no lowering for `comptimeExpr`.

import {io.terminal.print} from "std";

fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

fn two() -> i32 {
    return 2;
}

pub fn runCase() -> void {
    val a = comptime two();
    print(a);
    val d = comptime {
        var d = 0;
        for b in [1, 2, 3] {
            d = add(d, b);
        }
        d
    };
    print(d);
    val words = comptime {
        var out: string[] = [];
        for w in ["a", "bc", "def"] {
            out.push(w + w.length().toString());
        }
        out
    };
    print(words);
}

//// Decision 506 (1) — `io.process.spawn(cmd, args)` starts a child without a shell and answers its
//// `Child` (or a `ProcessError` of the module) without waiting: `wait()` answers the exit status
//// (`128 + n` for a child ended by signal `n`, as a shell reports it), `kill(s)` sends it a signal and is
//// `NoSuchProcess` once it has ended. The child's output is the parent's. A missing binary is
//// `NotFound`, a directory or a file that is not executable `PermissionDenied`. The same on commonJS,
//// erlang and beam.

import {io.process, io.fs, io.terminal.print} from "std";

fn failure(e: process.ProcessError) -> string {
    return case e {
        process.ProcessError.NotFound(command) -> "NotFound " + command;
        process.ProcessError.PermissionDenied(command) -> "PermissionDenied "
            + command;
        process.ProcessError.NoSuchProcess(pid) -> "NoSuchProcess";
        process.ProcessError.Unsupported(message) -> "Unsupported";
        process.ProcessError.Other(message) -> "Other";
    };
}

fn refusal(r: Result<process.Child, process.ProcessError>) -> string {
    return case r {
        Ok(_) -> "started";
        Error(e) -> failure(e);
    };
}

fn killed(r: Result<void, process.ProcessError>) -> string {
    return case r {
        Ok(_) -> "signalled";
        Error(e) -> failure(e);
    };
}

async fn childScenario() -> Async<void> {
    val first = process.spawn("sh", ["-c", "echo the child speaks; exit 3"]);
    case first {
        Ok(c) {
            print("pid is positive " + (c.pid > 0).toString());
            val code = await c.wait();
            print("exit " + code.toString());
            val again = await c.wait();
            print("exit again " + again.toString());
        }
        Error(e) -> print(failure(e));
    }

    val sleeper = process.spawn("sleep", ["30"]);
    case sleeper {
        Ok(c) {
            print(killed(c.kill(process.Signal.Term)));
            val code = await c.wait();
            print("exit " + code.toString());
            print(killed(c.kill(process.Signal.Term)));
        }
        Error(e) -> print(failure(e));
    }
}

async fn scenario() -> Async<void> {
    print(refusal(process.spawn("definitely-not-a-binary-bp-std", [])));
    print(refusal(process.spawn("/", [])));
    fs.writeText("not-executable.txt", "plain text");
    print(refusal(process.spawn("./not-executable.txt", [])));
    fs.rm("not-executable.txt");
    await childScenario();
}

pub fn main() {
    scenario();
}

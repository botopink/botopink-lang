import {compiler} from "std";
import {io.clock.Duration} from "std";

// Everything a page configures is an argument of `#[page]`, recorded as typed meta.
pub type PageSettings(route: string, revalidateMillis: ?i64, dynamicParams: bool)

pub fn page(
    syntax decl: unknown,
    comptime route: string,
    comptime revalidate: ?Duration = null,
    comptime dynamicParams: bool = true,
) -> void {
    compiler.setMeta(PageSettings(route: route, revalidateMillis: revalidate?.millis, dynamicParams: dynamicParams));
}

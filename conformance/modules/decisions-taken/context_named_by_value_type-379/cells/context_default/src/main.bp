//// Decisions 378 (3), 379 (3) — a read answers the nearest context of its
//// type provided above, else the type's declared default: `Label` rendered
//// by `main`, outside every provider, reads `Theme`'s default; rendered by
//// `Dark`, it reads the provided one. `context-unbound` is gone.

import {context.run, context.createContext, context.provide, context.context, io.terminal.print} from "std";

type Theme(mode: string)

type Element(text: string)

pub val themeContext = comptime createContext(Theme(mode: "light"));

component fn Label() -> Component<Element> {
    val t = use context(themeContext);
    return Element(text: t.mode);
}

component fn Dark() -> Component<Element> {
    use provide(createContext(Theme(mode: "dark")));
    val l = use Label();
    return Element(text: l.text);
}

component fn Again() -> Component<Element> {
    use provide(themeContext);
    val l = use Label();
    return Element(text: l.text);
}

pub async fn main() -> Async<void> {
    print("before");
    val l = await run(Label());
    print(l.text);
    val d = await run(Dark());
    print(d.text);
    val a = await run(Again());
    print(a.text);
}

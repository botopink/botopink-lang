//// Decision 379 — an enum's default is declared as a record's is:
//// `comptime createContext(Mode.Light)` declares `Mode`'s default, read
//// outside every provider, and `Dark` provides `Mode.Dark` below it.

import {context.run, context.createContext, context.provide, context.context, io.terminal.print} from "std";

type View(text: string) implement Renderable

type Mode {
    Light,
    Dark,
}

pub val modeContext = comptime createContext(Mode.Light);

fn name(m: Mode) -> string {
    return case m {
        .Light -> "light";
        .Dark -> "dark";
    };
}

component fn Label() -> Component<View> {
    val m = use context(modeContext);
    return View(text: name(m));
}

component fn Dark() -> Component<View> {
    use provide(createContext(Mode.Dark));
    val l = use Label();
    return View(text: l.text);
}

pub async fn main() -> Async<void> {
    val l = await run(Label());
    print(l.text);
    val d = await run(Dark());
    print(d.text);
}

//// Decision 639 — (a): a module declaring a type named like a literal's type — `i32`, `i64`, `u32`, `u64`, `f32`, `f64`, `bool`, `string`, `bigint` — is refused at the name, `primitive-type-redeclared`; 606 (1)'s shadowing does not reach them.

import {io.terminal} from "std";

// Shadowing a prelude name is legal: this module's own `Result`.
type Result(ok: bool)

// A literal's type cannot be redeclared: refused at the name,
// `primitive-type-redeclared`.
type i32(value: i64)

pub fn main() -> void {
    val x: i32 = 1;
    terminal.print(x);
    terminal.print(Result(ok: true).ok);
}

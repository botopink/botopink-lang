//// Decisions 568, 1031 (2) — a `bool[]` bound to a type parameter stays an array of bools: a
//// generic record's field holding one prints `true` / `false`, never the words a bool is held as.

import {io.terminal.print} from "std";

type Box<T>(value: T)

pub fn main() -> void {
    print(Box(value: [true, false]));
    val flags: bool[] = [false, false, true];
    print(Box(value: flags));
}

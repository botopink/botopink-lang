//// Decisions 568, 1031 (2) — `==` over generic records holding `bool[]`s compares the arrays by
//// their elements.

import {io.terminal.print} from "std";

type Box<T>(value: T)

pub fn main() -> void {
    print(Box(value: [true]) == Box(value: [true]));
    print(Box(value: [true]) == Box(value: [false]));
    print(Box(value: [true, false]) == Box(value: [true]));
    print(Box(value: [1, 0]) == Box(value: [1, 0]));
}

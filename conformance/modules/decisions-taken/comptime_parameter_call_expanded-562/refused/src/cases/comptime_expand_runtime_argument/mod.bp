//// Decision 562 — a function whose every parameter is `comptime` meets
//// `comptime` values and constants alone: a field of a run-time variable
//// passed to it is `comptime-arg-not-known` at the variable (417).

import {compiler, io.terminal.print} from "std";

#[compiler.external(
    .JavaScript("""console.log($0)"""),
    .Erlang("""io:format("~ts~n", [$0])"""),
    .Wasm(body: sayBody),
)]
declare fn say(line: string) -> void;

fn sayBody(line: string) -> void {
    print(line);
}

type Box(n: i32)

fn banner(comptime rows: i32) -> void {
    for row in 0..rows {
        say("row " + row.toString());
    }
}

pub fn main() -> void {
    var box = Box(n: 2);
    box = Box(n: box.n + 1);
    banner(box.n);
}

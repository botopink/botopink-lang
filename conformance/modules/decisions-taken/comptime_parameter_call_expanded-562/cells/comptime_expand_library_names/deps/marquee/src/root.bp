//// A library whose `marquee` takes only `comptime` parameters, so each call
//// is expanded where it is written (decision 562). Its body names what only
//// this module holds: the type `Label`, the private function `shout` and the
//// std namespace `path`, none of which the caller imports.

import {path, io.terminal.print} from "std";

type Label(text: string)

fn shout(label: Label) -> string {
    return label.text.toUpper();
}

pub fn marquee(comptime title: string) -> void {
    val label: Label = Label(text: title);
    print(shout(label));
    print(path.relative("/" + label.text, "/" + label.text + "/docs"));
}

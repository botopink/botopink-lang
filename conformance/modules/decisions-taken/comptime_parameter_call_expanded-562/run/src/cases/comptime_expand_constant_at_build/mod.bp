//// Decision 562 — a constant of the module (a `val` whose value reads no
//// run-time variable) is build data: `VERBOSE` decides the condition and
//// `PREFIX` is written into each emitted `say` while the call is expanded.

import {compiler, io.terminal.print} from "std";

#[compiler.external(
    .JavaScript("""console.log($0)"""),
    .Erlang("""io:format("~ts~n", [$0])"""),
    .Wasm(body: sayBody),
)]
declare fn say(line: string) -> void;

fn sayBody(line: string) -> void {
    print(line);
}

val VERBOSE = false;

val PREFIX = "> ";

fn show(comptime lines: string[]) -> void {
    for line in lines {
        if (VERBOSE) say("verbose: " + line) else say(PREFIX + line);
    }
}

pub fn runCase() -> void {
    show(["a", "b"]);
}

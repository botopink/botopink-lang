//// Decisions 331, 434 (5) — a `Result`'s methods run at build as they do
//// when the program runs: `unwrapOr`, `isOk`, `isError`, `map` and
//// `flatMap`, under a `comptime` and in a function it reaches — whose own
//// `return` / `throw` make its `Result` — each compared with the run time.

import {io.terminal.print} from "std";

fn measure(text: string) -> Result<i32, string> {
    if (text == "nope") throw "no text";
    return text.length();
}

fn half(n: i32) -> Result<i32, string> {
    if (n % 2 != 0) throw "odd";
    return n / 2;
}

fn summary(text: string) -> string {
    val r = measure(text);
    val doubled = r.map({ n -> n * 2 }).unwrapOr(0);
    val halved = r.flatMap({ n -> half(n) }).unwrapOr(-1);
    return r.isOk().toString()
        + " "
        + r.isError().toString()
        + " "
        + doubled.toString()
        + " "
        + halved.toString();
}

pub fn main() -> void {
    print(comptime "7".parseInt().unwrapOr(0l));
    print(comptime "x".parseInt().unwrapOr(0l));
    val a = comptime summary("abcd");
    print(a);
    print(a == summary("abcd"));
    val b = comptime summary("nope");
    print(b);
    print(b == summary("nope"));
}

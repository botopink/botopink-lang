//// Decision 346 — `Bytes` is an immutable byte sequence on the four targets: an Erlang binary
//// on erlang and beam, a `Uint8Array` on commonJS, a buffer in wasm memory. Text crosses in
//// with `Bytes.fromUtf8(s)` and out with `b.toUtf8()`, an `Error` on bytes that are not UTF-8;
//// `length`, `slice` (and `b[a..e]`), `concat` and `==` count and compare bytes. A host cell
//// takes and answers `Bytes` as its target holds it. The parent binary knew no `Bytes`.

import {compiler, io.terminal.print} from "std";

#[compiler.external(
    .JavaScript("""Uint8Array.from($0).reverse()"""),
    .Erlang("""list_to_binary(lists:reverse(binary_to_list($0)))"""),
    .Wasm(body: reversedBody),
)]
declare fn reversed(b: bytes) -> bytes;

fn reversedBody(b: bytes) -> bytes {
    var out = b.slice(0, 0);
    var i = b.length();
    while (i > 0) {
        out = out.concat(b.slice(i - 1, i));
        i = i - 1;
    }
    return out;
}

fn show(b: bytes) -> string {
    return case b.toUtf8() {
        Ok(s) -> "text " + s;
        Error(e) -> "error " + e;
    };
}

pub fn main() -> void {
    val hello = bytes.fromUtf8("héllo");
    print(hello.length());
    print(show(hello));
    print(show(reversed(bytes.fromUtf8("abc"))));
    print(show(reversed(bytes.fromUtf8("é"))));
    print(show(hello.slice(1, 2)));
    print(show(hello.slice(1, 3)));
    val joined = bytes.fromUtf8("ab").concat(bytes.fromUtf8("cd"));
    print(joined.length());
    print(show(joined.slice(1)));
    print(show(joined.slice(-1)));
    print(show(joined.slice(-3, -1)));
    print(show(joined.slice(3, 1)));
    print(show(joined.slice(1, 99)));
    print(show(joined[1..3]));
    print(show(joined[2..]));
    print(joined == bytes.fromUtf8("abcd"));
    print(joined != bytes.fromUtf8("abcd"));
    print(joined == hello);
    print(bytes.fromUtf8("").length());
    print(show(reversed(reversed(hello))));
    print(reversed(hello) == hello);
}

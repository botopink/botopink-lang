//// Decision 723 — `use provide(ctx)` takes a context value alone — there is no `(ctx, value)` form; a component that provides another value makes a context of the same type in its body, `val c = comptime createContext(Theme(…));` (a build value) or `val c = use memo({ -> createContext(Theme(…)) });` (run time, memoised with the component), then `use provide(c)`; `use context(ctx)` answers the nearest context of `ctx`'s type provided above, else `ctx`'s own default.

import {context.createContext, context.provide, context.context, context.memo, io.terminal.print} from "std";

type Theme(cls: string)

type View(text: string) implement Renderable

pub val themeContext = comptime createContext(Theme(cls: "plain"));

component fn Card() -> Component<View> {
    val t = use context(themeContext);
    return View(text: t.cls);
}

component fn Dark() -> Component<View> {
    val c = comptime createContext(Theme(cls: "dark"));
    use provide(c);
    val v = await Card();
    return View(text: v.text);
}

component fn Live(cls: string) -> Component<View> {
    val c = use memo({ -> createContext(Theme(cls: cls)) });
    use provide(c);
    val v = await Card();
    return View(text: v.text);
}

component fn Plain() -> Component<View> {
    use provide(themeContext);
    val v = await Card();
    return View(text: v.text);
}

pub async fn main() -> Async<void> {
    print((await Card()).text);
    print((await Dark()).text);
    print((await Live("live")).text);
    print((await Plain()).text);
}

//// Decisions 722, 723 — a context is read through a context value the
//// reader imports: `Label` imports `themeContext` and reads `use
//// context(themeContext)`, a `Theme`. It answers the nearest context of
//// `Theme`, the handle's type, provided above — `Dark` provides one made by
//// `createContext` — else the handle's own default, `light`. Nothing is
//// searched: the default is the value the reader names.

pub mod theme;

import {theme.Theme, theme.themeContext};
import {context.createContext, context.provide, context.context, io.terminal.print} from "std";

type Element(text: string) implement Renderable

component fn Label() -> Component<Element> {
    val t = use context(themeContext);
    return Element(text: t.mode);
}

component fn Dark() -> Component<Element> {
    use provide(createContext(Theme(mode: "dark")));
    val l = await Label();
    return Element(text: l.text);
}

pub async fn main() -> Async<void> {
    val l = await Label();
    print(l.text);
    val d = await Dark();
    print(d.text);
}

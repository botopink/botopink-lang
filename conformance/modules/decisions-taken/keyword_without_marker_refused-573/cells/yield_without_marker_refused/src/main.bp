//// Decisions 553 (4), 573 — `yield` is admitted by a body's marker, never by
//// its return type: `evens` returns `Iter<i32>` and carries no marker, so its
//// `yield` is `yield-without-iter`, at the `yield`, the hint naming
//// `iter fn`.

import {io.terminal.print} from "std";

fn evens(xs: i32[]) -> Iter<i32> {
    for x in xs {
        if (x % 2 == 0) yield x;
    }
}

pub fn main() -> void {
    for x in evens([1, 2, 3, 4]) {
        print(x);
    }
}

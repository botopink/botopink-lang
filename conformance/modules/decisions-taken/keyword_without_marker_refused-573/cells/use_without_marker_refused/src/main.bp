//// Decisions 553 (4), 573 — `use` is admitted by a body's marker, never by
//// its return type: `Badge` returns `Component<View>` and carries no marker,
//// so its `use` is `use-without-component`, at the `use`, naming
//// `component fn`.

import {context.run, context.createContext, context.context, io.terminal.print} from "std";

type View(text: string)

pub val prefixContext = comptime createContext(">");

fn Badge() -> Component<View> {
    val p = use context(prefixContext);
    return View(text: p + "badge");
}

pub async fn main() -> Async<void> {
    val r = await run(Badge());
    print(r.text);
}

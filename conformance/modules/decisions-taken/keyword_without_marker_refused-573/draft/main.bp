//// Decision 573 — The keyword without its marker is refused under the marker's name, renamed now

import {io.terminal.print} from "std";

async fn fetchCount() -> Async<i32> {
    return 3;
}

// `await` without the `async` marker.
async fn total() -> Async<i32> {
    val n = await fetchCount();
    return Async.resolve(n + 1);
}

pub async fn main() -> Async<void> {
    print(await total());
}

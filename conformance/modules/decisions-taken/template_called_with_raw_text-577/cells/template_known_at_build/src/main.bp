//// Decision 577 (1), (5) — a template parses the `${…}` holes of its text
//// itself and splices each expression into the code it builds, typed where
//// the call stands.

import {compiler, io.terminal.print} from "std";

fn quoted(text: string) -> string {
    return "\"" + text + "\"";
}

// The text's `${…}` holes are the template's own syntax (decision 577 (1)):
// the code `"" + "<text>" + (<hole>) + …`, each hole's expression
// spliced as written and typed where the call stands (14s8-a (e)).
fn spliced(text: string) -> string {
    var code = "\"\"";
    var first = true;
    for (text.split("\${")) { piece ->
        if (first) {
            code = code + " + " + quoted(piece);
            first = false;
        } else {
            val close = piece.indexOf("}");
            code = code
                + " + ("
                + piece.slice(0, close)
                + ") + "
                + quoted(piece.slice(close + 1));
        }
    }
    return code;
}

pub fn shout(syntax q: string) -> string {
    return compiler.build("(" + spliced(compiler.text(q)) + ").toUpper()");
}

pub val name = "world";

pub val fixed = shout @`hello ${name}`; // "HELLO WORLD"

fn greet(who: string) -> string {
    return shout @`hello ${who}`; // computed when it runs
}

pub fn main() -> void {
    print(fixed); // HELLO WORLD
    print(greet("bob")); // HELLO BOB
}

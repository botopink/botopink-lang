//// Decision 311 — the template annotation `#[f @`…`]`: the template call
//// `f @`…`` written as an annotation. `query` is a template function whose
//// second parameter receives the annotated declaration (question s29-a); the
//// text is captured unevaluated, as at a call site, and its `${…}` holes are
//// the template's own syntax (decision 577 (1)): it reads each one's
//// expression from `compiler.text(q)`. What the template records goes where
//// a decorator's does: typed meta of the method, read by the owner's
//// decorator on `decl.methods` (`m.meta(Query)`, question s29-b: a method's
//// decorators run before its owner's), and typed meta of a function, read by
//// `compiler.typeInfo(f).meta(Query)`. A template annotation sits beside a
//// decorator, and its text may span lines. `decl.params` is a method's own
//// parameter list.

import {compiler, io.terminal.print} from "std";

pub type Query(sql: string, params: string[])

fn query(syntax q: string, syntax decl: unknown) -> string {
    var text = "";
    var params: string[] = [];
    var first = true;
    // The text's `${…}` holes are the template's own syntax (decision 577
    // (1)): each one's expression is a parameter.
    for (compiler.text(q).split("\${")) { piece ->
        if (first) {
            text = piece;
            first = false;
        } else {
            val close = piece.indexOf("}");
            params.push(piece.slice(0, close));
            text = text
                + "$"
                + params.length.toString()
                + piece.slice(close + 1);
        }
    }
    val declared = compiler
        .params(decl)
        .map({ p -> p.name + ": " + p.typeName })
        .join(", ");
    if (params.length == 0)
        compiler.fail(
            "a query of `"
                + compiler.name(decl)!
                + "("
                + declared
                + ")` binds no parameter",
            at: decl,
        );
    val sql = text
        .split("\n")
        .map({ l -> l.trim() })
        .filter({ l -> l.length > 0 })
        .join(" ");
    compiler.setMeta(Query(sql: sql, params: params));
    return compiler.build("\"\"");
}

fn repository(syntax decl: unknown) -> void {
    var lines: string[] = [];
    for (compiler.methods(decl)) { m ->
        val found = m.meta(Query);
        if (found != null) {
            val names = m.params.map({ p -> p.name }).join(", ");
            val audit = m.meta(Audit);
            val mark = if (audit != null)
                " (audit " + audit.level.toString() + ")"
            else
                "";
            lines.push(
                m.name
                    + "("
                    + names
                    + "): "
                    + found.sql
                    + " <- "
                    + found.params.join(", ")
                    + mark,
            );
        }
    }
    compiler.setMeta(Repository(statements: lines));
}

pub type Audit(level: i32)

fn audited(syntax decl: unknown, comptime level: i32) -> void {
    compiler.setMeta(Audit(level: level));
}

#[repository]
behavior Users {
    #[query @`select * from users where id = ${id} limit 1`]
    fn find(self: Self, id: i32) -> string;

    #[audited(2)]
    #[query @`
        select * from users
         where name = ${name}
           and age > ${minAge}
    `]
    fn byName(self: Self, name: string, minAge: i32) -> string;

    fn count(self: Self) -> i32;
}

#[query @`delete from sessions where user = ${user}`]
fn logout(user: string) -> string {
    return user + " out";
}

pub fn main() -> void {
    val statements: string[] = comptime compiler
        .typeInfo(Users)
        .meta(Repository)?.statements ?? [];
    print(statements.join(" | "));
    val m = comptime compiler.typeInfo(logout).meta(Query);
    print(m!.sql + " <- " + m!.params.join(", "));
    print(logout("ana"));
}

// What `#[repository]` records: one statement per method that carries a query.
type Repository(statements: string[])

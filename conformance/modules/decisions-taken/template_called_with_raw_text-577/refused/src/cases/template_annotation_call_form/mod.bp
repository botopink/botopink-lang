//// Decisions 311, 577 (3) — `#[f(…)]` naming a template function is
//// `syntax-call-outside-syntax` at the annotation, naming the template form
//// `#[f @`…`]`.

import {compiler, io.terminal.print} from "std";

type Query(sql: string)

fn sql(syntax q: string, syntax decl: unknown) -> string {
    compiler.setMeta(Query(sql: compiler.text(q)));
    return compiler.build("\"\"");
}

#[sql("select 1")]
fn one() -> i32 {
    return 1;
}

pub fn main() -> void {
    print(one().toString());
}

//// Decisions 577 (2), (3), 578 (1) — a template is called with its text in
//// three places: `` name @`…` ``, `` recv.name @`…` `` for a template method
//// (its `syntax self: R` receiver first), and the annotation `` #[name @`…`] ``,
//// whose second `syntax` parameter is the annotated declaration.

import {code, compiler, io.terminal.print} from "std";

pub type Query(sql: string)

fn sql(syntax q: string, syntax decl: unknown) -> string {
    compiler.setMeta(Query(sql: compiler.text(q)));
    return "";
}

#[sql @`select * from users`]
fn find() -> i32 {
    return 1;
}

pub type Num(n: i32)

// The number the text writes, read at build.
fn digits(text: string) -> i32 {
    var n = 0;
    var i = 0;
    while (i < text.length()) {
        n = n * 10 + text.charCodeAt(i) - 48;
        i = i + 1;
    }
    return n;
}

fn plus(syntax self: Num, syntax q: string) -> anyvalue {
    val more = digits(compiler.text(q));
    return code @`Num(n: ${self}.n + ${more})`;
}

pub fn runCase() {
    print(comptime compiler.typeInfo(find).meta(Query)?.sql ?? "none");
    val a = Num(n: 1);
    val b = a.plus @`41`;
    print(b.n);
}

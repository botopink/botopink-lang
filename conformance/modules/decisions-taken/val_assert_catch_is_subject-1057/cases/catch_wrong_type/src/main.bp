//// Decision 1057 (2) — after `catch` the value stands for the subject, so it has the subject's type:
//// `-1` where a `Shape` is the subject is refused `assert-catch-type`, located at the value.

import {io.terminal.print} from "std";

type Shape { Circle(radius: i32), Rect(width: i32, height: i32) }

fn radiusOf(s: Shape) -> i32 {
    val assert Circle(r) = s catch -1;
    return r;
}

pub fn main() -> void {
    print(radiusOf(Shape.Circle(3)));
}

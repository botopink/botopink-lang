//// Decision 789 (4) — the conformance module's `runCase(comptime name)`, expanded where it is
//// called: the case's load is answered at build, so its `try … catch` takes a branch at build —
//// on `Error` the handler's statements run and the `return` ends the expansion; on `Ok` the
//// `Module` is bound and the expansion goes on to the init that runs it.

import {compiler, compiler.RunFailure, io.terminal.print} from "std";

// Decision 989 (1) — `run()` answers what the loaded package printed: each line of it is
// printed here, then, on a failure, the failure.
fn show(answer: Result<string, RunFailure>) -> void {
    case answer {
        Ok(text) -> shown(text);
        Error(f) {
            shown(f.output);
            print("abort " + f.message);
        }
    }
}

fn shown(text: string) -> void {
    if (text != "") print(text.trimEnd());
}

fn runCase(comptime name: string) -> void {
    print("== " + name + " comptime");
    val loaded = try comptime compiler.load("packages/" + name) catch { r ->
        compiler.init({ ->
            print("== " + name);
            for (r.diagnostics) { d ->
                print("refused error: " + d.message);
                print("at "
                    + d.file
                    + ":"
                    + d.line.toString()
                    + ":"
                    + d.column.toString());
            }
        });
        return;
    };
    compiler.init({ ->
        print("== " + name);
        show(loaded.run());
    });
}

comptime {
    runCase("fine");
    runCase("broken");
}

pub fn main() -> void {}

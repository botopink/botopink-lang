//// Decisions 755, 816, 818 (1) — `use memo({ -> make })` is std's
//// `hooks.memo<T>(make: fn() -> T) -> Component<T>`: each `use memo` takes a
//// child cell of the body's cell at its place, and its slot is that cell's —
//// filled on the cell's first render, read while the cell stands. `a` run
//// twice over one root makes its label and its count once; `b`, made by
//// another call, stands at another place and makes its own.

import {context.run, context.Scope, hooks.memo, io.terminal.print} from "std";

type Element(text: string)

component fn Page(name: string) -> Component<Element> {
    val label = use memo({ ->
        print("label " + name);
        "page " + name
    });
    val count = use memo({ ->
        print("count " + name);
        name.length + 1
    });
    return Element(text: label + " " + count.toString());
}

pub async fn main() -> Async<void> {
    val root = Scope.root();
    defer root.close();
    val a = Page("a");
    val b = Page("bb");
    val first = await run(a, root);
    print(first.text);
    val again = await run(a, root);
    print(again.text);
    val other = await run(b, root);
    print(other.text);
    val last = await run(a, root);
    print(last.text);
}

//// Decision 561 — types named between backticks: a record with a method, an
//// enum with a unit and a payload variant named so too, constructed, matched
//// and printed as written.

import {io.terminal.print} from "std";

type `my point`(x: i32, y: i32) {
    fn `sum of`(self: Self) -> i32 {
        return self.x + self.y;
    }
}

type `Shape kind` {
    `Round one`(radius: i32),
    `no shape`,
}

fn area(s: `Shape kind`) -> i32 {
    return case s {
        `Shape kind`.`Round one`(radius: r) -> r * 3;
        `Shape kind`.`no shape` -> 0;
    };
}

pub fn main() -> void {
    val p: `my point` = `my point`(x: 3, y: 4);
    print(p.`sum of`());
    print(p);
    print(area(`Shape kind`.`Round one`(radius: 2)));
    print(area(`Shape kind`.`no shape`));
    print(`Shape kind`.`Round one`(radius: 5));
}

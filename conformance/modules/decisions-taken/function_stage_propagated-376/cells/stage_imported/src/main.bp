//// Reads what `#[stage]` recorded on the declarations of `pages`, the cell's
//// subject: a decorator that reads `.hooks` runs after its module's bodies,
//// so its typed meta is read from another module (`typeinfo-meta-hooks-pending`).

pub mod pages;
pub mod ui;

import {pages.usaPad, pages.usaAgora, pages.usaLabel, pages.Staged};
import {compiler, io.terminal.print} from "std";

pub fn main() -> void {
    show(comptime compiler.typeInfo(usaPad).meta(Staged));
    show(comptime compiler.typeInfo(usaAgora).meta(Staged));
    show(comptime compiler.typeInfo(usaLabel).meta(Staged));
    print(usaPad());
}

fn show(staged: ?Staged) -> void {
    if (staged) {
        s ->
        print(s.name + ": " + s.stages.join(" "));
    }
}

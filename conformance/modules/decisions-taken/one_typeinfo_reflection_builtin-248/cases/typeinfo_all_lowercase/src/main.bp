//// Decision 248 — `@typeinfo.all(…)` is refused where it is written, naming
//// `@TypeInfo.all`.

import {io.terminal.print} from "std";

fn route(syntax decl: unknown) -> void {}

#[route]
pub fn home() -> string { return "home"; }

pub fn main() -> void {
    val all = @typeinfo.all(with: route);
    print(all.length);
}

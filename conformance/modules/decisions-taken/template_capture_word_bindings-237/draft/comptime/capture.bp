//// A template over its text's captured bindings.

import {compiler} from "std";

pub fn deps(syntax q: string) -> string {
    var names: string[] = [];
    for d in compiler.bindings(q) {
        names.push(compiler.name(d)!);
    }
    val text = "[" + names.join(", ") + "]";
    return text;
}

import {compiler} from "std";

pub type Marks(nodes: string[])

pub fn marks(syntax decl: unknown) -> void {
    var nodes: string[] = [];
    for n in compiler.hooks(decl) {
        val mark = if (n.async) "async" else "direct";
        nodes.push(compiler.name(n.function)! + ": " + mark);
    }
    compiler.setMeta(Marks(nodes: nodes));
}

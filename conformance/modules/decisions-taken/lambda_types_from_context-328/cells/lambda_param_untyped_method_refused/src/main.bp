//// Decision 583 (amends 328) — a lambda no position, annotation or call types
//// is refused `lambda-untyped` at the lambda, before its body is read: the
//// method its parameter calls no longer reds as `cannot infer the type of n`.

import {io.terminal.print} from "std";

pub fn main() {
    val describe = { n -> "n=" + n.toString() };
    print("never called");
}

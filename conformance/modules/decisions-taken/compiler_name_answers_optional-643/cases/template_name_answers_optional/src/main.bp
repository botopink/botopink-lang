//// Decision 643 — `compiler.name(e)` answers a `?string` in every body that
//// runs at build, a template's included: the name the call site's text is
//// written as — a path's last segment (642) —, `null` when it has none. It
//// is no `compiler.text(e)`: `1 + 2` has a text and no name.

import {compiler, io.terminal.print} from "std";

fn named(syntax q: string) -> string {
    return compiler.name(q) ?? "none";
}

fn last(syntax q: string) -> string {
    return compiler.name(q)!;
}

pub fn main() -> void {
    print(named @`count`);
    print(named @`user.email`);
    print(named @`1 + 2`);
    print(last @`a.b.c`);
}

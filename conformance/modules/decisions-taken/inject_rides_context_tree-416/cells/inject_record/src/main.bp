//// Decision 416 (1) — `use inject(Deps)` builds the record `Deps` from the
//// contexts of its fields' types: each field the nearest context of its type
//// provided above (`Clock` in `Root`), else that type's declared default
//// (`Greeter`), else the field's own default (`retries`).

import {context.run, context.createContext, context.provide, context.context, context.inject, io.terminal.print} from "std";

type View(text: string)

type Clock(now: string)

type Greeter(word: string)

type Deps(clock: Clock, greeter: Greeter, retries: i32 = 3)

pub val clockContext = comptime createContext(Clock(now: "never"));

pub val greeterContext = comptime createContext(Greeter(word: "hello"));

component fn Page() -> Component<View> {
    val deps = use inject(Deps);
    return View(text: deps.greeter.word
        + " at "
        + deps.clock.now
        + " x"
        + deps.retries.toString());
}

component fn Root() -> Component<View> {
    use provide(createContext(Clock(now: "noon")));
    val p = use Page();
    return View(text: p.text);
}

pub async fn main() -> Async<void> {
    val outside = await run(Page());
    print(outside.text);
    val inside = await run(Root());
    print(inside.text);
}

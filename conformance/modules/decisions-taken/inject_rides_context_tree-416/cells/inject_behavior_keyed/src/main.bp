//// Decision 416 (2) — `createContext(value, Behavior)` keys a context by the
//// behavior its value implements: `MissingRepository` declares
//// `Repository`'s default, `Root` provides a `MemoryRepository` as a
//// `Repository`, and both `use context(repoContext)` and an `inject` field
//// typed `Repository` read it.

import {context.RenderScope, context.createContext, context.provide, context.context, context.inject, io.terminal.print} from "std";

type View(text: string) implement Renderable

behavior Repository {
    fn fetch(self: Self, id: i32) -> string;
}

type MissingRepository() implement Repository {
    fn fetch(self: Self, id: i32) -> string {
        return "missing";
    }
}

type MemoryRepository(prefix: string) implement Repository {
    fn fetch(self: Self, id: i32) -> string {
        return self.prefix + id.toString();
    }
}

type Deps(repo: Repository)

pub val repoContext = createContext(MissingRepository(), Repository);

component fn Lookup() -> Component<View> {
    val r = use context(repoContext);
    val deps = use inject(Deps);
    return View(text: r.fetch(1) + " " + deps.repo.fetch(2));
}

component fn Root() -> Component<View> {
    use provide(createContext(MemoryRepository(prefix: "row-"), Repository));
    val l = use Lookup();
    return View(text: l.text);
}

pub async fn main() -> Async<void> {
    val outside = (await Lookup().run(RenderScope.root())).value;
    print(outside.text);
    val inside = (await Root().run(RenderScope.root())).value;
    print(inside.text);
}

//// Decision 416 (2) — `createContext(value, B)` takes a value whose type
//// implements `B` through a behavior that `extends` `B` (`CachedRepository
//// implement Cached`, `Cached extends Repository`), as a parameter typed `B`
//// does; it is read back with `use context(repoContext)`.

import {context.run, context.createContext, context.provide, context.context, io.terminal.print} from "std";

type View(text: string)

behavior Repository {
    fn fetch(self: Self, id: i32) -> string;
}

behavior Cached extends Repository {
    fn hits(self: Self) -> i32;
}

type CachedRepository(prefix: string) implement Cached {
    fn fetch(self: Self, id: i32) -> string {
        return self.prefix + id.toString();
    }
    fn hits(self: Self) -> i32 {
        return 3;
    }
}

type Memory(tag: string) implement Cached {
    fn fetch(self: Self, id: i32) -> string {
        return self.tag + "#" + id.toString();
    }
    fn hits(self: Self) -> i32 {
        return 0;
    }
}

pub val repoContext = createContext(CachedRepository(prefix: "cached-"), Repository);

component fn Lookup() -> Component<View> {
    val r = use context(repoContext);
    return View(text: r.fetch(1));
}

component fn Root() -> Component<View> {
    use provide(createContext(Memory(tag: "mem"), Repository));
    val l = use Lookup();
    return View(text: l.text);
}

pub async fn main() -> Async<void> {
    val outside = await run(Lookup());
    print(outside.text);
    val inside = await run(Root());
    print(inside.text);
}

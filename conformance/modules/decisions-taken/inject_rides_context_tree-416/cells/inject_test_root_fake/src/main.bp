//// Decision 416 (3) — providing stays one context per dependency, so a
//// test's root swaps one: `FakeRoot` provides a fake `Mailer` above the same
//// `Signup` the application renders, and `inject` reads the fake.

import {context.createContext, context.provide, context.context, context.inject, io.terminal.print} from "std";

type View(text: string) implement Renderable

behavior Mailer {
    fn send(self: Self, to: string) -> string;
}

type SmtpMailer() implement Mailer {
    fn send(self: Self, to: string) -> string {
        return "smtp:" + to;
    }
}

type FakeMailer(log: string) implement Mailer {
    fn send(self: Self, to: string) -> string {
        return self.log + to;
    }
}

type Services(mailer: Mailer)

pub val mailerContext = createContext(SmtpMailer(), Mailer);

component fn Signup(email: string) -> Component<View> {
    val s = use inject(Services);
    return View(text: s.mailer.send(email));
}

component fn FakeRoot() -> Component<View> {
    use provide(createContext(FakeMailer(log: "fake:"), Mailer));
    val v = await Signup("a@b.c");
    return View(text: v.text);
}

pub async fn main() -> Async<void> {
    val real = await Signup("x@y.z");
    print(real.text);
    val fake = await FakeRoot();
    print(fake.text);
}

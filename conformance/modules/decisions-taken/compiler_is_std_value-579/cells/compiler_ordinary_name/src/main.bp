//// Decision 579 (2) — without the import `compiler` is an ordinary name: a
//// field, a parameter of another function and a local, each read as any
//// other.

import {io.terminal.print} from "std";

pub type Tool(compiler: string)

fn describe(compiler: string) -> string {
    return "built by " + compiler;
}

pub fn main() -> void {
    val compiler = "zig";
    val tool = Tool(compiler: compiler);
    print(describe(tool.compiler) + ", " + compiler.toUpper());
}

//// Decision 540 (2) — the whole-file shortcuts and the directory functions answer `Result<…,
//// FsError>` and do the same on every target: `writeBytes` / `readBytes` keep every byte (a zero,
//// a byte past 0x7f), `writeText` truncates and `appendText` adds, `copy` leaves the source, `rm`
//// removes a file, `removeTree` a tree (and a path that is not there is `Ok`), `mkdirRecursive`
//// makes the parents and is `Ok` on a directory that is there, and `stat` answers a file's size
//// and a directory's kind.

import {io.fs, encoding, io.terminal.print} from "std";

fn hex(path: string) -> string {
    return encoding.hexEncodeBytes(fs
        .readBytes(path)
        .unwrapOr(Bytes.fromUtf8("?")));
}

pub fn main() -> void {
    fs.removeTree("shortcuts");
    print(fs.mkdirRecursive("shortcuts/a/b").isOk());
    print(fs.mkdirRecursive("shortcuts/a/b").isOk());

    val raw = encoding.hexDecodeBytes("00ff80c3").unwrapOr(Bytes.fromUtf8("?"));
    print(fs.writeBytes("shortcuts/raw.bin", raw).unwrapOr(-1));
    print(hex("shortcuts/raw.bin"));

    fs.writeText("shortcuts/note.txt", "first");
    fs.appendText("shortcuts/note.txt", " second");
    fs.appendText("shortcuts/made-by-append.txt", "new");
    print(fs.readText("shortcuts/note.txt").unwrapOr("?"));
    print(fs.readText("shortcuts/made-by-append.txt").unwrapOr("?"));
    fs.writeText("shortcuts/note.txt", "again");
    print(fs.readText("shortcuts/note.txt").unwrapOr("?"));

    print(fs.copy("shortcuts/note.txt", "shortcuts/a/copy.txt").isOk());
    print(fs.readText("shortcuts/a/copy.txt").unwrapOr("?"));
    print(fs.exists("shortcuts/note.txt"));

    val info = fs
        .stat("shortcuts/note.txt")
        .unwrapOr(fs.FileStat(size: -1l, mtime: 0l, isDir: true));
    print(info.size);
    print(info.isDir);
    print(fs.stat("shortcuts/a").unwrapOr(info).isDir);

    print(fs.list("shortcuts/a").unwrapOr([]).length);
    print(fs.rm("shortcuts/a/copy.txt").isOk());
    print(fs.exists("shortcuts/a/copy.txt"));
    print(fs.walk("shortcuts").unwrapOr([]).join(","));
    print(fs.glob("*.txt", "shortcuts").unwrapOr([]).join(","));

    print(fs.removeTree("shortcuts").isOk());
    print(fs.exists("shortcuts"));
    print(fs.removeTree("shortcuts").isOk());
}

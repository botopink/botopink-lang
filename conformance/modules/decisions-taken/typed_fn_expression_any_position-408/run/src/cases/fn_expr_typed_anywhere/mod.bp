//// Decision 408 — the typed function expression `fn(x: T, …) -> R { … }` is
//// legal in every position: a `val`, a `var`, an argument, a return. Where the
//// position has a type the written types are checked against it; with none,
//// the written types are the function's.

import {io.terminal.print} from "std";

fn twice(f: fn(x: i32) -> i32, v: i32) -> i32 {
    return f(f(v));
}

fn adder(n: i32) -> fn(x: i32) -> i32 {
    return fn(x: i32) -> i32 {
        return x + n;
    };
}

pub fn runCase() -> void {
    val inc = fn(x: i32) -> i32 {
        return x + 1;
    };
    print(inc(1));
    var step = fn(x: i32) -> i32 {
        return x - 1;
    };
    print(step(10));
    step = fn(x: i32) -> i32 {
        return x - 2;
    };
    print(step(10));
    val words = [1, 2, 3].map(fn(n: i32) -> string {
        return "n" + n.toString();
    });
    print(words.join(","));
    print(twice(fn(x: i32) -> i32 {
        return x * 3;
    }, 2));
    print(adder(5)(1));
    val g: fn(x: i32) -> i32 = fn(x: i32) -> i32 {
        return x + 100;
    };
    print(g(1));
    val say = fn(s: string) -> void {
        print(s);
    };
    say("hi");
}

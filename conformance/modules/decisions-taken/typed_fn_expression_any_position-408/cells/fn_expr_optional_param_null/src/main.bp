//// Decision 408 — a typed function expression bound to a `val` with no type
//// of its own takes its written parameter types: a parameter written as an
//// optional (`?Holder[]`, `?fn(i32) -> i32`) takes `null` as it takes a value,
//// on every target.

import {io.terminal.print} from "std";

type Holder(name: string)

pub fn main() -> void {
    val one = fn(h: ?Holder[]) -> i32 {
        return 1;
    };
    print(one(null));
    val two = fn(f: ?fn(i32) -> i32) -> i32 {
        if (f == null) return 0;
        return 2;
    };
    print(two(null));
    val three = fn(h: ?Holder[]) -> i32 {
        if (h == null) return 0;
        return 3;
    };
    print(three([Holder(name: "a")]));
}

//// Decision 277 — a cycle is an edge back to a listed node: `A` renders `B`
//// and `B` renders `A` — two nodes, `B`'s call goes back to `A`, no third.

import {compiler} from "std";

type Element(text: string) implement Renderable

// Renders `decl.hooks` into one meta string `main` prints: each node as
// `fn(uses: […], calls: […])`, a `use` over a function value as `null`.
fn graph(syntax decl: unknown) -> void {
    var nodes: string[] = [];
    compiler
        .hooks(decl)
        .forEach({ n ->
            var uses: string[] = [];
            n.uses.forEach({ u ->
                val h = u.hook;
                uses.push(if (h == null) "null" else h.name + "@" + u.at)
            });
            var calls: string[] = [];
            n.calls.forEach({ c ->
                val k = c.callee;
                val name = if (k == null) "null" else k.name;
                calls.push(name + "@" + c.at)
            });
            nodes.push(
                n.function.name
                    + "(uses: ["
                    + uses.join(", ")
                    + "], calls: ["
                    + calls.join(", ")
                    + "])",
            )
        });
    compiler.setMeta(Graph(nodes: nodes));
}

component fn B(depth: i32) -> Component<Element> {
    if (depth == 0) return Element(text: "b");
    val a = A(depth - 1);
    return Element(text: "a");
}

#[graph]
pub component fn A(depth: i32) -> Component<Element> {
    val b = B(depth);
    return Element(text: "b");
}

// What `#[graph]` records: one rendered node per entry of `decl.hooks`.
pub type Graph(nodes: string[])

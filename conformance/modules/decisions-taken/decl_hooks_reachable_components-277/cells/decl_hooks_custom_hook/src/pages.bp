//// Decision 277 — a hook written in botopink has a node of its own: `Page`
//// `use`s `user`, and `user` `use`s `session` — three nodes, each holding
//// only the `use` written in it.

import {compiler} from "std";

type Element(text: string) implement Renderable

// Renders `decl.hooks` into one meta string `main` prints: each node as
// `fn(uses: […], calls: […])`, a `use` over a function value as `null`.
fn graph(syntax decl: unknown) {
    var nodes: string[] = [];
    compiler
        .hooks(decl)
        .forEach({ n ->
            var uses: string[] = [];
            n.uses.forEach({ u ->
                val h = u.hook;
                uses.push(if (h == null) "null" else h.name + "@" + u.at)
            });
            var calls: string[] = [];
            n.calls.forEach({ c ->
                val k = c.callee;
                val name = if (k == null) "null" else k.name;
                calls.push(name + "@" + c.at)
            });
            nodes.push(
                n.function.name
                    + "(uses: ["
                    + uses.join(", ")
                    + "], calls: ["
                    + calls.join(", ")
                    + "])",
            )
        });
    compiler.setMeta(Graph(nodes: nodes));
}

fn session() -> Component<string> {
    return "alice";
}

fn user() -> Component<string> {
    val s = use session();
    return "user " + s;
}

#[graph]
pub fn Page() -> Component<Element> {
    val u = use user();
    return Element(text: u);
}

// What `#[graph]` records: one rendered node per entry of `decl.hooks`.
pub type Graph(nodes: string[])

//// Decision 410 — `use` is refused as the right operand of `&&`, `||` and `??`

import {context.run, io.terminal} from "std";

type Element(text: string)

component fn flag() -> Component<bool> {
    return true;
}

component fn Banner(ready: bool) -> Component<Element> {
    val shown = use flag();
    val both = ready && use flag();
    return Element(text: if (shown && both) "on" else "off");
}

pub async fn main() -> Async<void> {
    terminal.print((await run(Banner(true))).text);
}

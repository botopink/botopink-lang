//// Decision 310 — two same-named TYPES of two modules, each imported under an
//// alias, are two types: each alias names its own type in every type and
//// value position, and every backend tells them apart by module. Each prints
//// as declared, constructs its own fields, answers its own method, `is` tells
//// them apart, and a function of each module takes and answers its own.

pub mod a;
pub mod b;
import {cases.import_two_types_one_name.a.p.Policy as APolicy, cases.import_two_types_one_name.a.p.defaultPolicy, cases.import_two_types_one_name.a.p.msOf};
import {cases.import_two_types_one_name.b.p.Policy as BPolicy, cases.import_two_types_one_name.b.p.nameOf};
import {io.terminal.print} from "std";

fn twice(p: APolicy) -> i32 {
    return p.ms * 2;
}

fn shout(p: BPolicy) -> string {
    return p.name + "!";
}

fn kind(v: unknown) -> string {
    if (v is APolicy) return "a";
    if (v is BPolicy) return "b";
    return "other";
}

pub fn runCase() -> void {
    val x = APolicy(ms: 5);
    val y: BPolicy = BPolicy(name: "n");
    print(x);
    print(y);
    print(x.ms);
    print(y.name);
    print(twice(x));
    print(shout(y));
    print(x.describe());
    print(y.describe());
    print(kind(x));
    print(kind(y));
    print(msOf(defaultPolicy()));
    print(nameOf(y));
}

//// Decision 310 — std's `collections.Dict` and another module's `Dict`, each
//// imported under an alias, are two types: `D` is std's dictionary, `KitDict`
//// is `kit`'s record, `kit`'s `fresh() -> Dict` answers a `KitDict` here, it
//// prints as declared, and `is` tests for it.

pub mod kit;
import {collections.Dict as D, io.terminal.print} from "std";
import {cases.import_std_type_beside_aliased_type.kit.Dict as KitDict, cases.import_std_type_beside_aliased_type.kit.fresh};

fn ms(d: KitDict) -> i32 {
    return d.initialMs;
}

fn kind(v: unknown) -> string {
    if (v is KitDict) return "kit";
    return "other";
}

pub fn runCase() -> void {
    val d: D<string, i32> = D.empty().insert("k", 7);
    print(d.size());
    print(ms(KitDict(initialMs: 5)));
    print(ms(fresh()));
    print(KitDict(initialMs: 2));
    print(kind(fresh()));
    print(kind(7));
}

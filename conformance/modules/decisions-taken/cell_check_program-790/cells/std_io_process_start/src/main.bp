//// Decision 790 (1), 798 (6) — `io.process.start(cmd, args, cwd, env)` starts a child without a shell,
//// in `cwd` and with `env` (`NAME=value` entries) added to the parent's environment, and answers its
//// `Captured`; `wait()` answers an `Exit` holding the status, and stdout and stderr apart. A missing
//// binary is `NotFound`. commonJS alone: the other targets refuse the call.

import {io.process, io.fs, io.terminal.print} from "std";

fn failure(e: process.ProcessError) -> string {
    return case e {
        process.ProcessError.NotFound(command) -> "NotFound " + command;
        process.ProcessError.PermissionDenied(command) -> "PermissionDenied "
            + command;
        process.ProcessError.NoSuchProcess(pid) -> "NoSuchProcess";
        process.ProcessError.Unsupported(message) -> "Unsupported";
        process.ProcessError.Other(message) -> "Other";
    };
}

async fn scenario() -> Async<void> {
    fs.mkdir("start-cwd");
    val script = "process.stdout.write('out:' + require('path').basename(process.cwd()) + ':' + process.env.BP_START_VAR); process.stderr.write('err'); process.exit(4)";
    val started = process.start("node", ["-e", script], "start-cwd", ["BP_START_VAR=a=b"]);
    case started {
        Ok(c) {
            print("pid is positive " + (c.pid > 0).toString());
            val r = await c.wait();
            print("status " + r.status.toString());
            print("stdout " + r.stdout);
            print("stderr " + r.stderr);
            val again = await c.wait();
            print("again " + again.status.toString());
            print(case c.kill(process.Signal.Term) {
                Ok(_) -> "signalled";
                Error(e) -> failure(e);
            });
        }
        Error(e) -> print(failure(e));
    }
    fs.rm("start-cwd");
    val missing = process.start("definitely-not-a-binary-bp-std", [], null, []);
    case missing {
        Ok(_) -> print("started");
        Error(e) -> print(failure(e));
    }
}

pub fn main() -> void {
    scenario();
}

//// Decision 790 (1), 798 (6) — `io.process.start` works on commonJS alone (an erlang port folds stderr into
//// stdout, and `Captured` keeps the two apart): on erlang and beam it answers `Error(Unsupported)`, on wasm
//// the call is refused at the call (`std-unsupported-on-target`, decision 518 (4)); importing `io.process`
//// stays fine everywhere.

import {io.process, io.terminal.print} from "std";

pub fn main() -> void {
    print("imported");
    val r = process.start("node", ["-v"], null, []);
    print(case r {
        Ok(_) -> "started";
        Error(process.ProcessError.Unsupported(_)) -> "Unsupported";
        Error(_) -> "other";
    });
}

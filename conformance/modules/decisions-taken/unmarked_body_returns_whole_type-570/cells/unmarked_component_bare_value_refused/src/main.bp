//// Decision 570 — without a marker a body returns the whole type: `Badge`
//// returns `Component<View>` and carries no `component`, so `return View(…)`
//// gives a `View` where a `Component<View>` is expected — a type mismatch at
//// the value, its hint naming `component fn`.

import {context.run, io.terminal.print} from "std";

type View(text: string)

fn Badge() -> Component<View> {
    return View(text: "badge");
}

pub async fn main() -> Async<void> {
    val r = await run(Badge());
    print(r.text);
}

//// Decision 523 — a task is composed by an `async { … }` block, itself a
//// `Async` (decision 375), which leaves through `return`: `safe` recovers a failing
//// task with `try await … catch`, `doubled` maps a task's value, and `chained`
//// binds one task into another. Every
//// composition reads the same on every target.

import {io.terminal.print} from "std";

fn load(n: i32) -> Async<Result<i32, string>> {
    if (n < 0) throw "negative " + n.toString();
    return n;
}

fn show(label: string, n: i32) {
    print(label + " " + n.toString());
}

fn run() -> Async<void> {
    val safeGood = async {
        val v = try await load(5) catch 0;
        return v;
    };
    val safeBad = async {
        val v = try await load(-1) catch 0;
        return v;
    };
    show("safe good", await safeGood);
    show("safe bad", await safeBad);

    val t = load(10);
    val doubled = async {
        val v = try await t catch 0;
        return v * 2;
    };
    show("doubled", await doubled);

    val chained = async {
        val first = try await load(3);
        val second = try await load(first + 1);
        return second * 10;
    };
    val chainedValue = try await chained catch 0;
    show("chained", chainedValue);
}

pub fn main() {
    run();
}

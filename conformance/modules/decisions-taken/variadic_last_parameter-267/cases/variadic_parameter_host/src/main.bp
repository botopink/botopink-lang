//// Decision 267 — a `declare fn` bound to a host function takes a variadic
//// like any function: commonJS hands the host its arguments one by one (a rest
//// parameter — `Math.max(3, 9, 4)`), erlang and beam one list
//// (`lists:max([3, 9, 4])`).
////
//// wasm has no host, so it refuses the program where the host function is
//// first called (its `on wasm` section).

import {compiler, io.terminal.print} from "std";

#[compiler.external(.JavaScript("Math.max($args)"), .Erlang("lists:max($0)"))]
pub declare fn largest(..values: i32[]) -> i32;

pub fn main() -> void {
    print(largest(3, 9, 4));
    print(largest(7));
}

import {compiler} from "std";

pub type Graph(lines: string[])

pub fn graph(syntax decl: unknown) -> void {
    var lines: string[] = [];
    for n in compiler.hooks(decl) {
        val owner = compiler.name(n.function)!;
        for u in n.uses {
            val ctx = u.context;
            val read = if (ctx == null) "-" else compiler.name(ctx)!;
            lines.push(owner + " uses " + read);
        }
    }
    compiler.setMeta(Graph(lines: lines));
}

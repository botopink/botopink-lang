//// Decision 667 — `v is T` with `T` a type parameter is refused; a type to test against travels as a `comptime t: type<T>` parameter, and `v is t` is the concrete type's test in the function specialised for it.

import {io.terminal.print} from "std";

type Users(id: i32)

type Orders(id: i32)

type Registry(entries: unknown[]) {
    // The way out: the type travels as a `comptime` token.
    pub fn get<T>(self: Self, comptime t: type<T>) -> ?T {
        for (self.entries) { e ->
            if (e is t) return e;
        }
        return null;
    }
}

// Refused: `T` is erased at run time.
fn firstOf<T>(xs: unknown[], fallback: T) -> T {
    for (xs) { x ->
        if (x is T) return x;
    }
    return fallback;
}

pub fn main() -> void {
    val r = Registry(entries: [Orders(id: 7), Users(id: 1)]);
    print(r.get(Users)?.id ?? 0);
    print(firstOf([Orders(id: 7)], Users(id: 0)).id);
}

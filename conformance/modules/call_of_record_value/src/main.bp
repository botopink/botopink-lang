//// `language-gaps.md` row 32 — a call whose callee is a record VALUE (not
//// its constructor, not a function) is `callee-not-a-function` at the call,
//// naming the value's type; the constructor `G(a: "x")` and a function-typed
//// field `h.f(2)` still check (`modules/call_of_imported_record_value` is the
//// same through an import).

type G(a: string)

type H(f: fn(x: i32) -> i32)

pub fn main() {
    val h = H(f: { x -> x + 1 });
    @print(h.f(2));
    val g = G(a: "x");
    @print(g().a);
}

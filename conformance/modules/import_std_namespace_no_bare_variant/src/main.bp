//// A namespace import brings no bare name of its module: `failure`'s enum
//// `HostErrorName` declares a variant `Error`, and after `import {failure}`
//// a bare `Error` is still what it is without the import — no name in an
//// expression (decision 208), never the variant. The variant is
//// `failure.HostErrorName.Error`.

import {failure} from "std";

fn parse() -> @Result<i32, string> {
    val e = Error("bad");
    return 1;
}

pub fn main() {
    @print(parse().isOk());
}

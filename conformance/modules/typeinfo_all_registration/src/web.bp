//// The framework: `#[route(path)]` marks a page function and records its
//// path; `#[component]` gives a type the member its catalogue calls.

import {compiler.DeclKind} from "std";

pub fn route(expr decl: unknown, comptime path: string) {
    compiler.setMeta(Route(path: path));
    if (compiler.kind(decl) != DeclKind.Fn)
        compiler.fail("#[route] must annotate a function", at: decl);
}

pub fn component(expr decl: unknown) {
    compiler.addMember(
        "pub fn describe() -> string { return \"component "
            + compiler.name(decl)!
            + "\"; }",
    );
}

pub fn unused(expr decl: unknown) {
    compiler.setMeta(Unused(marked: true));
}

// What `#[route]` records.
pub type Route(path: string)

// What `#[unused]` records.
pub type Unused(marked: bool)

//// The markup's unfold target: answers the literal's length.

import {bpp} from "std";

#[bpp.html]
pub default fn markup(expr t: string) -> i32 {
    val root = CustomNode(
        kind: "markup",
        span: Span(0, 0, 1),
        label: "",
        ref: null,
        children: [],
    );
    compiler.custom(root);
    return compiler.build(compiler.text(t).length().toString());
}

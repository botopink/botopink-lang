//// Decisions 577 (2), (3), 578 (1) — a template is called with its text in
//// three places: `` name @`…` ``, `` recv.name @`…` `` for a template method
//// (its `expr self: R` receiver first), and the annotation `` #[name @`…`] ``,
//// whose second `expr` parameter is the annotated declaration.

import {compiler} from "std";

pub type Query(sql: string)

fn sql(expr q: string, expr decl: unknown) -> string {
    compiler.setMeta(Query(sql: compiler.text(q)));
    return "";
}

#[sql @`select * from users`]
fn find() -> i32 {
    return 1;
}

pub type Num(n: i32)

fn plus(expr self: Num, expr q: string) -> anyvalue {
    return compiler.build("Num(n: "
        + compiler.text(self)
        + ".n + "
        + compiler.text(q)
        + ")");
}

pub fn main() {
    @print(@typeInfo(find).meta(Query)?.sql ?? "none");
    val a = Num(n: 1);
    val b = a.plus @`41`;
    @print(b.n);
}

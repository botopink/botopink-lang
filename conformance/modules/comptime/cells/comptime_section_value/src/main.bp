import {io.terminal.print} from "std";

type Tok {
    Pad {
        All {
            4,
            8,
        }
    }
    Bold,
}

fn first(ts: Tok[]) -> Tok {
    return ts[0] ?? .Bold;
}

fn main() -> void {
    val t: Tok = comptime first(
        [.Pad.All.8, .Bold],
    ); // written as Tok.Pad.All.8
    print(t == Tok.Pad.All.8); // true
}

//// `toString()` on a tuple answers the text `terminal.print` writes for it, on every target:
//// `#(1, 2)`, its string elements quoted, a nested tuple inside.

import {io.terminal.print} from "std";

pub fn main() -> void {
    val pair = #(1, 2);
    print(pair.toString());
    val mixed = #("a", true, 2.5);
    print(mixed.toString());
    val nested = #(1, #("x", 2));
    print(nested.toString());
    print("pair: " + pair.toString());
}

//// A statement `v.push(x)` on a `var` rebinds the `var` to a new array: a
//// `val` that read the array earlier keeps the array of its moment. A module
//// `var` and a local `var`, on every target.

import {io.terminal.print} from "std";

var xs: string[] = [];

fn add(s: string) -> void {
    xs.push(s);
}

fn all() -> string[] {
    return xs;
}

pub fn main() -> void {
    add("a");
    val before = all();
    add("b");
    print(before);
    print(all());
    var ys = [1];
    val snap = ys;
    ys.push(2);
    print(snap);
    print(ys);
}

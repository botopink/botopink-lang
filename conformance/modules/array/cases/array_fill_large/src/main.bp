//// `Array.fill` over a receiver of a thousand elements and over nine
//// thousand: `Array.repeat` builds its result by doubling, so the result
//// costs its own length in memory. A per-element spread recursion exhausted
//// wasm's page (`01-compiler/05-wasm` rows).

import {io.terminal.print} from "std";

pub fn main() -> void {
    val a = [1, 2, 3, 4, 5, 6, 7, 8];
    val b = a.append(a).append(a.append(a));
    val c = b.append(b).append(b.append(b));
    val d = c.append(c).append(c.append(c));
    val e = d.append(d);
    val f = e.fill(0);
    print(f.length);
    val g = f
        .append(f)
        .append(f)
        .append(f)
        .append(f)
        .append(f)
        .append(f)
        .append(f)
        .append(f);
    val h = g.fill("q");
    print(h.length);
    print(h.at(9215));
}

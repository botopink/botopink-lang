//// `Array.range(start, stop)` is the integers of `[start, stop)`, empty when
//// `stop <= start`; `Array.repeat(value, times)` is `times` copies of
//// `value`, empty for `times <= 0`. std builds both by doubling, so a long
//// result costs its own length. A range of one element recursed forever on
//// erlang and beam (half of one is none), and wasm resolved neither call:
//// their `External.Node` template hid the body the other targets run.

import {io.terminal.print} from "std";

pub fn runCase() -> void {
    print(array.range(0, 3));
    print(array.range(2, 3));
    print(array.range(5, 5));
    print(array.range(4, 1));
    print(array.range(-2, 5));
    val b = array.range(0, 5000);
    print(b.length);
    print(b[4999]);
    print(array.repeat("x", 3));
    print(array.repeat(7, 0));
    print(array.repeat(true, 2));
    print(array.repeat(2.5, 2));
    print(array.repeat(1, 1000).length);
}

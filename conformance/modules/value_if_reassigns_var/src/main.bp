//// A `val` bound to an `if` whose branches reassign an outer `var`: the
//// reassignment is the program's, whichever branch ran, `else if` chains and
//// an `if` without `else` included.

import {io.terminal.print} from "std";

fn pick(n: i32) -> i32 {
    var f = "a";
    val r = if (n == 0) {
        f = "b";
        1;
    } else if (n == 1) {
        f = "c";
        2;
    } else {
        f = "d";
        3;
    };
    print(f);
    print(r);
    return r;
}

fn one(c: bool) -> i32 {
    var f = "a";
    val r = if (c) {
        f = "b";
        1;
    } else 0;
    print(f);
    return r;
}

fn main() {
    one(true);
    one(false);
    pick(0);
    pick(1);
    pick(2);
}

fn route(comptime decl: @Decl, comptime path: @Expr<string>) {
    decl.setMeta(Route(path: path.value));
}

#[route("/about")]
pub fn about() -> string {
    return "about us";
}

fn main() {
    for (@TypeInfo.all(with: route)) { r ->
        for (r.metaAll(Route)) { m ->
            @print(r.name + " " + m.path); // about /about
        }
    }
}

// What `#[route]` records.
type Route(path: string)

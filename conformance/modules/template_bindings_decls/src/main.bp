//// Decision 415 (2) — `q.bindings()` lists, as `@Decl` handles (question
//// B-18-b, as built), every declaration a word of the literal names where the
//// call stands: here a type, a function and an imported type under its alias
//// (the declaration's own name and module); a word nothing declares names
//// none.

mod models;
import {models.User as Person};

type City(name: string)

fn helper(n: i32) -> i32 {
    return n;
}

fn named(comptime q: @Expr<string>) -> @Expr<string> {
    val all = q.bindings();
    var text = all.length.toString();
    for (["City", "User", "helper"]) { want ->
        for (all) { d ->
            if (d.name == want) text = text + " " + d.name + "@" + d.module;
        }
    }
    return q.build("\"" + text + "\"");
}

pub fn main() {
    @print(named "City helper Person Nobody");
}

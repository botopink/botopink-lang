//// Decision 587 — the labels of a variant constructor name its fields, so the
//// order they are written in does not matter: a call with the labels
//// reordered answers the value of the call in declaration order.

import {io.terminal.print} from "std";

pub type Shape {
    Circle(radius: i32, filled: bool = false, name: string = "circle"),
    Rect(width: i32, height: i32),
}

fn describe(s: Shape) -> string {
    return case s {
        Circle(radius, filled, name) -> name
            + " "
            + radius.toString()
            + " "
            + filled.toString();
        Rect(width, height) -> width.toString() + "x" + height.toString();
    };
}

pub fn main() {
    print(describe(Shape.Circle(radius: 3, filled: true, name: "a")));
    print(describe(Shape.Circle(name: "a", filled: true, radius: 3)));
    print(describe(Shape.Circle(filled: true, radius: 3)));
    print(describe(Shape.Rect(height: 2, width: 5)));
}

import {compiler, io.terminal.print} from "std";

#[compiler.external(
    .JavaScript("""String($0.length)"""),
    .Erlang("""integer_to_binary(string:length($0))"""),
    .Wasm("std:hash.contentHash"),
)]
pub declare fn contentHash(value: string) -> string;

pub fn main() -> void {
    print(contentHash("a"));
}

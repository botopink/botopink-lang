//// A component body that loops over a list, awaits a component per item and
//// accumulates into a `var` declared before the loop — the shape of styled's
//// `spliced`. The `for` body is a lambda that closes over `out` and `k`; every
//// target answers the joined text.

import {io.terminal.print} from "std";

pub type Piece(text: string) implement Renderable

fn piece(s: string) -> Piece {
    return Piece(text: s);
}

pub fn Item(s: string) -> Component<Piece> {
    return piece(s);
}

fn joined(texts: string[], parts: string[]) -> Component<string> {
    var out = texts.at(0) ?? "";
    var k = 0;
    for (parts) { s ->
        val p = await Item(s);
        out = out + p.text + texts.at(k + 1) ?? "";
        k = k + 1;
    }
    return out;
}

pub fn main() -> Async<void> {
    val s = await joined(["<", "|", "|", ">"], ["a", "b", "c"]);
    print(s);
}

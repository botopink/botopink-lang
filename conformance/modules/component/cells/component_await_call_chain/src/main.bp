//// `await m.make()` in a component body, `make` a record field holding a component
//// lambda and `m` the answer of a call: the component runs and the await answers its
//// service, as it does when the call is bound to a typed `val` first.

import {io.terminal.print} from "std";

type Service(name: string)

type Module(name: string, make: fn() -> Component<Service>)

component fn Card() -> Component<Service> {
    return Service(name: "card");
}

fn moduleNamed(name: string) -> Module {
    return Module(name: name, make: { -> Card() });
}

component fn Bound(name: string) -> Component<Service> {
    val c: Component<Service> = moduleNamed(name).make();
    val s = await c;
    return Service(name: s.name + "!");
}

component fn Direct(name: string) -> Component<Service> {
    val s = await moduleNamed(name).make();
    return Service(name: s.name + "!");
}

pub async fn main() -> Async<void> {
    val b = await Bound("card");
    print(b.name);
    val d = await Direct("card");
    print(d.name);
}

//// `fs.walk` answers paths relative to its root, and the same paths however
//// the root is spelled — a plain name, a trailing slash, a `.` or a `..`
//// segment, a leading `./`, an absolute path. The erlang template used to cut
//// the root off each full path by its written length, while the host had
//// normalised the path it was cutting: a root ending in `/.` (what
//// `path.join([dir, "."])` answers) lost the first two characters of every
//// path — `app/layout.bp` came back `p/layout.bp`. It builds each relative
//// path from the names it walks now. A dangling link under the root is an `Error`
//// naming the link by its relative path, the same text on every target
//// (decision 178) — the last two lines, again under two spellings of the root.
//// Refused on wasm (`.wasm.expect`): std's `io/fs` and `io/process` host cells have no wasm
//// binding.

import {io.fs, path} from "std";
import {io.process as host} from "std";

// A symbolic link `link` -> `target`: std has no public cell that makes one.
#[@external(
    .Node("""require('fs').symlinkSync($0, $1)"""),
    .Erlang("""(fun(__T, __L) -> ok = file:make_symlink(__T, __L), ok end)($0, $1)"""),
)]
declare fn linkTo(target: string, link: string) -> void;

fn walked(root: string) -> string {
    return case fs.walk(root) {
        Ok(found) -> found.join(",");
        Error(e) -> ["error", refusal(e)].join(" ");
    };
}

// The message of an `Other` (a dangling link is one, decision 178), else the variant's name.
fn refusal(e: fs.FsError) -> string {
    return case e {
        fs.FsError.Other(path, message) -> message;
        fs.FsError.NotFound(path) -> "NotFound";
        fs.FsError.PermissionDenied(path) -> "PermissionDenied";
        fs.FsError.IsDirectory(path) -> "IsDirectory";
        fs.FsError.NotDirectory(path) -> "NotDirectory";
        fs.FsError.AlreadyExists(path) -> "AlreadyExists";
        fs.FsError.InvalidUtf8(path, offset) -> "InvalidUtf8";
    };
}

pub fn main() {
    fs.mkdir("walkroot");
    fs.mkdir("walkroot/app");
    fs.mkdir("walkroot/app/blog");
    fs.writeText("walkroot/root.bp", "root");
    fs.writeText("walkroot/app/layout.bp", "layout");
    fs.writeText("walkroot/app/blog/page.bp", "page");
    @print(walked("walkroot"));
    @print(walked("walkroot/"));
    @print(walked("walkroot/."));
    @print(walked(path.join(["walkroot", "."])));
    @print(walked("./walkroot"));
    @print(walked("walkroot/app/.."));
    @print(walked(path.join([host.cwd(), "walkroot"])));
    @print(walked(path.join([host.cwd(), "walkroot", "."])));
    @print(walked("walkroot/app/."));
    linkTo("missing.bp", "walkroot/app/gone.bp");
    @print(walked("walkroot"));
    @print(walked("walkroot/app/."));
}

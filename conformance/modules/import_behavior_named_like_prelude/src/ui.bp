//// Behaviors named like prelude declarations — `Component` (a prelude
//// behavior and the bare variant `DeclKind.Component`) and `Field` (a
//// prelude type) — and a decorator whose `@Decl` names one of them.

import {compiler} from "std";

pub behavior Component {
    fn render(self: Self) -> string;
}

pub behavior Field {
    fn column(self: Self) -> string;
}

pub fn widget(expr decl: Component) {
    compiler.setMeta(Widget(kind: "widget"));
}

// What `#[widget]` records.
type Widget(kind: string)

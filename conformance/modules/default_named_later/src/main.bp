//// 01-compiler/01-checker step 25 (decision 289) — `pub default <name>;`
//// makes an existing function of the module its default: it keeps its name in
//// its module (a recursive call) and is imported by the module path
//// (`import {m.tree};` binds `tree`, an alias another name). The parent binary
//// refused `pub default Tree;` (`fn` expected).

pub mod m;
import {m.tree};
import {m.tree as Tree};

pub fn main() {
    @print(tree(2));
    @print(Tree(0));
}

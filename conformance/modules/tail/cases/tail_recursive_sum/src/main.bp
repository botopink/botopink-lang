//// The numeric fixture of `modules/compiler-cli/tests/backend_exec.sh` (front C
//// C2), a cell since 144 B-29 step H: a pure-arithmetic program answers the same
//// number on every target. `sumTo` is tail-recursive — the recursive call is in
//// tail position, with no arithmetic applied to its result — so it is also the
//// BEAM deep-tail-recursion (`call_only`) scenario.

import {io.terminal.print} from "std";

fn sumTo(n: i32, acc: i32) -> i32 {
    if (n == 0) return acc;
    return sumTo(n - 1, acc + n);
}

pub fn main() -> void {
    print(sumTo(0, 0));
    print(sumTo(1, 0));
    print(sumTo(10, 0));
}

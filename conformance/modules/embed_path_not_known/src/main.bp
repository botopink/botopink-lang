//// Decision 519 — `@embed` is a `Build` builtin: its path is known at build. A path the
//// program computes when it runs — here a parameter — is refused at the argument.

import {io.terminal.print} from "std";

fn load(path: string) -> Asset {
    return @embed(path);
}

pub fn main() {
    print(load("assets/x.txt").size);
}

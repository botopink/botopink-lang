//// Decision 316 — a wrapper is the program's code, as a member function is
//// (370 (2)): it reads the decorator's `@Expr` parameters, spliced, and the
//// names of the decorator's module. A local of the decorator's body exists
//// only while the program compiles: the wrapper reading it is refused at the
//// read.

fn labelled(comptime decl: @Decl<fn(..) -> string>) {
    val label = decl.name;
    decl.wrapWith({ call -> label + ": " + call.run() });
}

#[labelled]
pub fn posts() -> string {
    return "posts";
}

pub fn main() {
    @print(posts());
}

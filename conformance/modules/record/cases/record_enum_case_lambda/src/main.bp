//// The records fixture of `modules/compiler-cli/tests/backend_exec.sh` (front C
//// C2), a cell since 144 B-29 step H: a record, an enum dispatched by `case`
//// and a captured lambda answer alike on every target.

import {io.terminal.print} from "std";

type Shape { Circle, Square, Triangle }

type Box(w: i32, h: i32)

fn sides(s: Shape) -> i32 {
    return case s {
        Circle -> 0;
        Square -> 4;
        Triangle -> 3;
    };
}

fn area(b: Box) -> i32 {
    val twice: fn(i32) -> i32 = { x -> x * 1 };
    return twice(b.w * b.h);
}

pub fn main() -> void {
    print(sides(Shape.Circle));
    print(sides(Shape.Square));
    print(sides(Shape.Triangle));
    print(area(Box(w: 2, h: 3)));
}

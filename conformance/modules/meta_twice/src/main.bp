//// Decision 298 — `decl.setMeta(v)` stores one value of its type per
//// declaration: a second `Entity` on `City` is refused at the annotation
//// whose decorator recorded it.

type Entity(table: string)

fn entity(expr decl: unknown, comptime table: string) {
    compiler.setMeta(Entity(table: table));
}

#[entity("cities")]
#[entity("towns")]
type City(name: string)

pub fn main() {
    @print(@typeInfo(City).meta(Entity)?.table ?? "none");
}

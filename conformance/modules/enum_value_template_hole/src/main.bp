//// A template hole writes an enum's value as `@print` writes it: a unit variant and a payload
//// variant name their enum, built in place, bound by a `val`, passed as a parameter, answered by
//// a call, the enum declared here or imported; `string + value` writes the same text. commonJS
//// wrote `[object Object]`, erlang and beam the variant's atom or tuple, wasm the ordinal or the
//// cell's address.

mod modes;

import {modes.Mode};

type Target {
    Top,
    Bottom,
}

type Shape {
    Dot,
    Circle(radius: i32),
    Named(label: string),
}

fn pick(top: bool) -> Target {
    if (top) return Target.Top;
    return Target.Bottom;
}

fn describe(t: Target, s: Shape) -> string {
    return "t=${t} s=${s}";
}

pub fn main() {
    val t = Target.Top;
    @print("${t}");
    @print("at ${Target.Bottom}!");
    val c = Shape.Circle(radius: 2);
    @print("${c}");
    @print("shape ${Shape.Named(label: "é")} and ${Shape.Dot}");
    @print(describe(Target.Bottom, Shape.Named(label: "x")));
    @print("picked ${pick(true)}");
    val m = Mode.Slow(n: 3);
    @print("mode ${m} ${Mode.Fast}");
    @print("plus " + t + " " + c);
    val s: string = "${c}";
    @print(s.length());
}

//// Decision 386 — a decorator reached through a namespace import runs,
//// whatever module declares it: `import {markers} from "web";` registers
//// `markers`'s decorators under `markers.<name>`, so `#[markers.tag]` runs
//// `tag` (its meta read back), and `markers.serverOnly` is a `Decorator`
//// value — `same(markers.serverOnly)` is true for `#[markers.serverOnly]`.

import {markers} from "web";
import {compiler, io.terminal.print} from "std";

type Found(names: string)

fn find(syntax decl: unknown) {
    var out: string[] = [];
    compiler
        .annotations(decl)
        .forEach({ a ->
            if (a.decorator.same(markers.serverOnly)) out.push(a.name)
        });
    compiler.setMeta(Found(names: out.join(" ")));
}

#[markers.tag]
fn Tagged() -> string {
    return "t";
}

#[find]
#[markers.serverOnly]
fn Marked() -> string {
    return "m";
}

#[find]
#[markers.tag]
fn NotMarked() -> string {
    return "n";
}

pub fn main() {
    print(comptime compiler.typeInfo(Tagged).meta(markers.Tag)?.label ?? "none");
    print(comptime compiler.typeInfo(Marked).meta(Found)?.names ?? "none");
    print(comptime compiler.typeInfo(NotMarked).meta(Found)?.names ?? "none");
    print(comptime compiler.typeInfo(NotMarked).meta(markers.Tag)?.label ?? "none");
    print(Tagged() + Marked() + NotMarked());
}

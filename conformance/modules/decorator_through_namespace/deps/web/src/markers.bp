//// `web/markers` — `tag` records a typed meta value on the declaration it
//// annotates; `serverOnly` is a marker that reads nothing.

import {compiler} from "std";

pub type Tag(label: string)

pub fn tag(syntax decl: unknown) {
    compiler.setMeta(Tag(label: "tagged " + compiler.name(decl)));
}

pub fn serverOnly(syntax decl: unknown) {
    val _n = compiler.name(decl);
}

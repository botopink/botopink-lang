//// Decision 8 §4.1 × §4.2 — `is` tests the value, not where it came from:
//// every form that may follow `is`, each asked of the same ten values held in
//// `unknown` — an integer, an integral float, a fractional float, a number out
//// of `i8`'s range, a string, a bool, a record, an enum variant with a
//// payload, a tuple and a generic record — one mark per value (`T` holds, `.`
//// does not); a tuple type tests its arity and each element by value; then
//// §4.1's conversion inside `if (a is i32)`. One answer on four targets (C-07's
//// erlang tail, `test/is_truth_table`'s `run/` twin). wasm refused the program
//// (`cannot box this value as unknown`, then no run-time test for a tuple type).

type Point(x: i32, y: i32)

type Box<T>(item: T)

type Shape { Dot, Circle(r: i32) }

fn values() -> unknown[] {
    val int: unknown = 1;
    val integral: unknown = 2.0;
    val fraction: unknown = 2.5;
    val wide: unknown = 300;
    val text: unknown = "s";
    val flag: unknown = true;
    val point: unknown = Point(x: 1, y: 2);
    val shape: unknown = Shape.Circle(r: 3);
    val pair: unknown = #(1, "a");
    val box: unknown = Box(item: 1);
    return [int, integral, fraction, wide, text, flag, point, shape, pair, box];
}

fn marks(holds: bool[]) -> string {
    var text = "";
    for (holds) { h ->
        val mark = if (h) "T" else ".";
        text = text + mark;
    }
    return text;
}

pub fn main() {
    @print(marks(values().map({ v -> v is i32 })));
    @print(marks(values().map({ v -> v is i8 })));
    @print(marks(values().map({ v -> v is u8 })));
    @print(marks(values().map({ v -> v is f64 })));
    @print(marks(values().map({ v -> v is string })));
    @print(marks(values().map({ v -> v is bool })));
    @print(marks(values().map({ v -> v is Point })));
    @print(marks(values().map({ v -> v is Shape })));
    @print(marks(values().map({ v -> v is Box<unknown> })));
    @print(marks(values().map({ v -> v is #(i32, string) })));
    val wrong: unknown = #(1, 2);
    val longer: unknown = #(1, "a", 2);
    val floaty: unknown = #(2.0, "a");
    val nested: unknown = #(Point(x: 1, y: 2), true);
    @print(
        wrong is #(i32, string),
        longer is #(i32, string),
        floaty is #(i32, string),
    );
    @print(
        nested is #(Point, bool),
        nested is #(Shape, bool),
        floaty is #(f64, unknown),
    );
    val a: unknown = 2.0;
    var got = 0;
    if (a is i32) got = a + 1;
    @print(got);
}

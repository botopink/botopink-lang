//// Decision 561 — `not-found.bpp`, whose name is no identifier, is imported
//// by its backtick name under an alias: `` import {pages.`not-found` as
//// NotFound}; `` binds the file's default function as `NotFound`.

pub mod pages;
import {pages.`not-found` as NotFound, pages.`not-found`.Props};

pub fn main() {
    @print(NotFound(Props(path: "/missing")));
}

//// Decision 409 — a tail is the function's value at compile time too: `comptime
//// square(3)` and `comptime label(2)` evaluate bodies that end in a tail, one
//// after an early `return`.

import {io.terminal.print} from "std";

fn square(x: i32) -> i32 { x * x }

fn label(n: i32) -> string {
    if (n == 0) return "none";
    "n" + n.toString()
}

val nine = comptime square(3);

val tag = comptime label(2);

pub fn main() {
    print(nine);
    print(tag);
    print(square(4));
}

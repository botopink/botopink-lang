//// A type and a template method over it, in one module.

import {compiler} from "std";

pub type Memory(prefix: string) {
    pub fn fetch(self: Self, key: string) -> string {
        return self.prefix + key;
    }
}

pub fn read(expr self: Memory, expr q: string) -> string {
    return compiler.build(compiler.text(self)
        + ".fetch(\""
        + compiler.text(q)
        + "\")");
}

import {compiler, io.terminal.print} from "std";

fn serverOnly(syntax decl: unknown) -> void {
    val _n = compiler.name(decl)!;
}

// Refuses a function marked `serverOnly`, however the mark is spelled.
fn clientOnly(syntax decl: unknown) -> void {
    compiler
        .annotations(decl)
        .forEach({ a ->
            if (a.decorator.same(serverOnly))
                compiler.fail("`"
                    + compiler.name(decl)!
                    + "` runs on the server", at: decl)
        });
}

#[clientOnly]
fn Widget() -> string {
    return "w";
}

pub fn runCase() -> void {
    print(Widget()); // w
}

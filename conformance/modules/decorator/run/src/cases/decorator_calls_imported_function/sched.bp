//// A decorator whose body calls functions its module IMPORTS — directly
//// (`shout`) and through a local helper (`describe` calls `count`).

import {cases.decorator_calls_imported_function.text.shout, cases.decorator_calls_imported_function.text.count};
import {compiler} from "std";

fn describe(expr: string) -> string {
    return if (count(expr) == 5) "every minute" else "custom";
}

pub fn scheduled(syntax decl: unknown, comptime cron: string) -> void {
    @emit(
        "pub fn schedule() -> string { return \""
            + shout(compiler.name(decl)!)
            + " runs "
            + describe(cron)
            + "\"; }",
    );
}

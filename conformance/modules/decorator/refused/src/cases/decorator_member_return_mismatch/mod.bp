//// A member a decorator wrote is type-checked like a hand-written method: a body
//// returning the wrong type is refused, located at the annotation.

import {compiler, io.terminal.print} from "std";

fn maker(syntax decl: unknown) -> void {
    compiler.addMember("pub fn code(self: Self) -> i32 { return \"nope\"; }");
}

#[maker]
pub type City(name: string)

pub fn main() -> void {
    print(City(name: "a").code());
}

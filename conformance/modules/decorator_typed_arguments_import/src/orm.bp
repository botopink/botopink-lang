import {types.Type} from "std";

pub type Order { Asc, Desc }

pub fn index<T>(
    comptime decl: @Decl<T>,
    comptime ..fields: @Expr<Type.Field<T>[]>,
) {
    decl.setMeta(Index(columns: fields.value.map({ f -> f.name })));
}

pub fn sorted<T>(
    comptime decl: @Decl<T>,
    comptime by: @Expr<Type.Field<T>>,
    comptime order: @Expr<Order> = .Asc,
) {
    val dir = if (order.value == Order.Desc) " desc" else " asc";
    decl.setMeta(Sorted(sort: by.value.name + dir));
}

// What `#[index]` records.
pub type Index(columns: string[])

// What `#[sorted]` records.
pub type Sorted(sort: string)

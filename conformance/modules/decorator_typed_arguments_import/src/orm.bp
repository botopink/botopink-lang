import {types.Type, compiler} from "std";

pub type Order { Asc, Desc }

pub fn index<T>(
    syntax decl: T,
    comptime ..fields: Type.Field<T>[],
) {
    compiler.setMeta(Index(columns: fields.map({ f -> f.name })));
}

pub fn sorted<T>(
    syntax decl: T,
    comptime by: Type.Field<T>,
    comptime order: Order = .Asc,
) {
    val dir = if (order == Order.Desc) " desc" else " asc";
    compiler.setMeta(Sorted(sort: by.name + dir));
}

// What `#[index]` records.
pub type Index(columns: string[])

// What `#[sorted]` records.
pub type Sorted(sort: string)

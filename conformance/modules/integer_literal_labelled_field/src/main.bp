//// An integer literal takes the integer type its position asks for — a `val
//// x: i64`, an `i64` parameter, an arithmetic operand — and a LABELLED
//// argument is such a position: the label names its parameter or field.
//// A complete labelled call planned no fill, so its arguments read no
//// expectation and `Event(name: "a", ts: 0)` was `type mismatch: expected
//// i64, got i32` on every target, whichever order the labels came in (rakun
//// front 05: "an `i64` field cannot be given a value at all").

type Event(name: string, ts: i64)

type Span(until: i64, from0: i64)

fn width(lo: i32, hi: i64) -> i64 {
    return hi - 1000;
}

pub fn main() {
    val e = Event(name: "a", ts: 0);
    @print(e.ts);
    val s = Span(from0: 5, until: 9);
    @print(s.until - s.from0);
    @print(width(hi: 4000, lo: 1));
}

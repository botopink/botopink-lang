//// A module-level `val` may read an earlier one, including through a method
//// call: `val a = Box(...); val b = double(a.get())`. The first is bound before
//// the second reads it, so both print their values on every target (the erlang
//// emission left `a` unbound in `b`'s initialiser, which OTP refuses).

import {io.terminal.print} from "std";

type Box(n: i32) {
    fn get(self: Self) -> i32 {
        return self.n;
    }
}

fn double(x: i32) -> i32 {
    return x * 2;
}

val a = Box(n: 21);

val b = double(a.get());

val _c = Box(n: 5);

val _d = double(_c.get());

pub fn main() -> void {
    print(_c.get());
    print(_d);
    print(a.get());
    print(b);
}

pub mod registry;
pub mod component;
import {registry.registered, registry.register, registry.unregisterLast};
import {component.componentName};
import {io.terminal.print} from "std";

pub fn main() -> void {
    print(componentName());
    print(registered());
    register("second");
    print(registered());
    print(unregisterLast());
    print(registered());
}

import {io.terminal.print} from "std";

async fn fetchPage(n: i32) -> Async<Result<i32[], string>> {
    if (n > 9) throw "no page " + n.toString();
    return [n, n + 1];
}

async iter fn pages(count: i32) -> AsyncIter<Result<i32[], string>> {
    var page = 0;
    while (page < count) {
        val rows = try await fetchPage(page); // failed: emits Error(e) and ends
        yield rows; // emits Ok(rows)
        page = page + 1;
    }
}

async fn countRows() -> Async<Result<i32, string>> {
    var n = 0;
    for await batch in pages(3) {
        val rows = try batch; // `n + (try batch).length` is refused
        n = n + rows.length;
    }
    return n;
}

pub async fn main() -> Async<void> {
    val rows = await countRows();
    print(rows.unwrapOr(-1)); // 6
}

//// Decision 376 — every function has a stage, read as `HookNode.stage`:
//// `Build` when it reads what exists only while the program compiles (a
//// `comptime` parameter's `.value` in a function that also takes a run-time
//// one: a function whose every parameter is `comptime` is expanded at its
//// call site instead, and `titulo` is `Any`, decision 562), `Run` when it
//// reaches a host function with an effect (std's clock), `Any` otherwise —
//// std's `math` is a pure primitive, declared `Any`. A call gives the caller the
//// callee's stage (`Any + Build = Build`, `Any + Run = Run`), and a
//// `comptime` in a body is computed at build and gives it none.

import {io.clock, math} from "std";

fn stage(expr decl: unknown) {
    var out: string[] = [];
    compiler
        .hooks(decl)
        .forEach({ n ->
            val s = if (n.stage == Stage.Build)
                "Build"
            else if (n.stage == Stage.Run)
                "Run"
            else
                "Any";
            out.push(s)
        });
    compiler.setMeta(Staged(name: compiler.name(decl)!, stages: out));
}

#[stage]
pub fn padAll(n: i32) -> string {
    return "padding: " + (n * 4).toString() + "px;";
}

#[stage]
pub fn agora() -> i64 {
    return clock.nowMillis();
}

#[stage]
pub fn campos(comptime names: string, open: string) -> string {
    return open + names + "]";
}

#[stage]
pub fn titulo(comptime t: string) -> string {
    return t + "!";
}

#[stage]
pub fn cabecalho() -> string {
    val n = comptime campos("title,body", "[");
    return n + agora().toString();
}

#[stage]
pub fn twice(n: i32) -> string {
    return padAll(n) + padAll(n);
}

#[stage]
pub fn nomes() -> string {
    return campos("a,b", "[");
}

#[stage]
pub fn raiz() -> f64 {
    return math.sqrt(16.0);
}

#[stage]
pub fn depois() -> i64 {
    return agora() + 1;
}

// What `#[stage]` records: the function's name and the stage of each node of
// its `decl.hooks`.
pub type Staged(name: string, stages: string[])

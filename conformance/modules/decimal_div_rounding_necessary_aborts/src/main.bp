//// 144 B-24, decision 332 (2) — `Rounding.Unnecessary` asserts the quotient fits the scale:
//// `1 / 3` at scale 2 does not, and the division aborts (Java's `ArithmeticException:
//// Rounding necessary`), on every target.

import {decimal.Decimal, decimal.Rounding, io.terminal.print} from "std";

pub fn main() {
    val one = Decimal(unscaled: 1n, scale: 0);
    val three = Decimal(unscaled: 3n, scale: 0);
    print("before");
    print(one.div(three, 2, Rounding.Unnecessary).toString());
    print("after");
}

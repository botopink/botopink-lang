//// Reads what `#[graph]` recorded on the declarations of `pages`, the cell's
//// subject: a decorator that reads `.hooks` runs after its module's bodies,
//// so its typed meta is read from another module (`typeinfo-meta-hooks-pending`).

pub mod pages;

import {pages.Page, pages.Ring, pages.Feed, pages.Graph};
import {compiler, io.terminal.print} from "std";

pub fn main() {
    val pageNodes: string[] = comptime compiler.typeInfo(Page).meta(Graph)?.nodes ?? [];
    print(pageNodes.join(", "));
    val ringNodes: string[] = comptime compiler.typeInfo(Ring).meta(Graph)?.nodes ?? [];
    print(ringNodes.join(", "));
    val feedNodes: string[] = comptime compiler.typeInfo(Feed).meta(Graph)?.nodes ?? [];
    print(feedNodes.join(", "));
}

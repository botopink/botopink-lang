//// Decision 432 — a lambda bound without an annotation and answering an
//// `async { }` block that throws still has the type `fn(i32) -> @Task<@Result<…>>`:
//// awaited, it reads back as `Error(e)` carrying the thrown text, the same as
//// when the binding is annotated.

import {io.terminal.print} from "std";

fn show(r: Result<i32, string>) {
    case r {
        Ok(v) -> print("ok", v);
        Error(e) -> print("error", e);
    }
}

fn run() -> Task<void> {
    val failing = { n ->
        async {
            throw "inner";
        }
    };
    show(await failing(1));
    val r = await failing(2);
    case r {
        Ok(v) -> print("ok", v);
        Error(e) -> print("again", e);
    }
    val maybe = { n ->
        async {
            if (n < 0) throw "negative";
            return n * 2;
        }
    };
    show(await maybe(4));
    show(await maybe(-4));
}

pub fn main() {
    run();
}

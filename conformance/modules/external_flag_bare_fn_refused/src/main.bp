//// Decision 621 — in a cell of `Implementation` only the `template` is
//// positional. A function named second, unlabelled, is refused at the
//// argument, naming the label to write: `body:`.

fn reverseBody(xs: i32[]) -> i32[] {
    return xs.reverse();
}

#[@external(.Erlang("lists:reverse($0)", reverseBody), .JavaScript("[...$0].reverse()"))]
declare fn backwards(xs: i32[]) -> i32[];

pub fn main() {
    @print(backwards([1, 2, 3]));
}

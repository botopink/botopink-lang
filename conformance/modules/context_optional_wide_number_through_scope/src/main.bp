//// 144 B-25 (proposed by its Conformance step; decisions 354, 388, 504) — an
//// optional wide number crosses the render scope: a `?f64` and a `?i64`
//// provided by `Root`, once with a value and once `null`, are read below it
//// with `use context` and narrowed there — each one the number it was, or
//// absent, on every target.

import {context.Context, context.provide, context.context} from "std";

type View(text: string) implement @Renderable

pub val RateContext = Context<?f64>();

pub val TotalContext = Context<?i64>();

fn Label() -> @Component<View> {
    val r = use context(RateContext);
    val t = use context(TotalContext);
    val rate = if (r != null) (r * 2.0).toString() else "no rate";
    val total = if (t != null) (t + 1).toString() else "no total";
    return View(text: rate + " " + total);
}

fn Root(rate: ?f64, total: ?i64) -> @Component<View> {
    use provide(RateContext, rate);
    use provide(TotalContext, total);
    val l = Label();
    return View(text: l.text);
}

pub fn main() -> @Task<void> {
    val big: i64 = 9000000000;
    val some = await Root(1.25, big);
    @print(some.text);
    val none = await Root(null, null);
    @print(none.text);
}

//// Decision 575 (4), the tree rule — an executor `compiler.compile` hands on
//// is code the program runs; `compiler` exists only while it compiles, so a
//// `compiler` read inside the executor is refused there
//// (`expr-captures-build`).

fn registered(expr decl: unknown) {
    compiler.compile({ -> @print(compiler.name(decl)!) });
}

#[registered]
pub fn home() -> string {
    return "home";
}

pub fn main() {
    @print(home());
}

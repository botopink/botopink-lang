//// An entity whose meta record is private to this module.

type Entity(table: string)

pub behavior Model {
    fn make() -> Self;
}

pub fn entity(expr decl: Model, comptime table: string) {
    compiler.setMeta(Entity(table: table));
}

#[entity("cities")]
pub type City(name: string) implement Model {
    fn make() -> Self {
        return City(name: "city");
    }
}

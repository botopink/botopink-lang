//// Decision 415 (2) — the declaration `q.lookup` answers is read-only:
//// `wrapWith` on it, as `setMeta`, is refused at the call
//// (`template-lookup-decl-write`) — only a decorator wraps the function it
//// annotates (decision 316).

fn posts() -> string {
    return "posts";
}

fn wrapping(expr q: string) -> string {
    val decl = compiler.lookup(q, compiler.text(q)) ?? compiler.fail("not in scope", at: q);
    compiler.wrapWith({ call -> call.run() });
    return compiler.build("\"" + compiler.name(decl)! + "\"");
}

pub fn main() {
    @print(wrapping @`posts`);
}

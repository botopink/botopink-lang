//// A template function that runs a tag's annotation (decision 302).

// Gives the annotated declaration a member — a type's channel, not a tag's.
pub fn withMember<T>(expr decl: T) {
    compiler.addMember("extra", fn(self: T) -> i32 {
        return 1;
    });
}

pub fn markup(expr q: string) -> string {
    val text = compiler.text(q);
    val tag = compiler.tagDecl(DeclKind.Element, "div", []);
    val d = compiler.annotate(tag, Span(start: text.indexOf("#[")
        + 2, end: text.indexOf("]>"), line: 1));
    return compiler.name(d)!;
}

//// Decision 316 — a wrapped function keeps its identity for its callers: a
//// call written in its own module, the function taken as a value and called
//// later, and its own recursive call each run the wrapper; the original body
//// is reached only through `call.run()`.

var hits: i32 = 0;

fn noteHit() {
    hits = hits + 1;
}

fn counted(comptime decl: @Decl<fn(..) -> i32>) {
    decl.wrapWith({ call ->
        noteHit();
        call.run()
    });
}

#[counted]
fn twice(n: i32) -> i32 {
    return n * 2;
}

#[counted]
fn sumTo(n: i32) -> i32 {
    if (n == 0) return 0;
    return n + sumTo(n - 1);
}

fn apply(f: fn(n: i32) -> i32, n: i32) -> i32 {
    return f(n);
}

pub fn main() {
    @print(twice(2));
    @print(hits);
    val f = twice;
    @print(f(5));
    @print(apply(twice, 7));
    @print(hits);
    @print(sumTo(3));
    @print(hits);
}

//// Decisions 105 and 122 — a generator whose item is a `@Result` runs one step
//// per item like any other: a print before and after the first `yield` comes
//// out between the items, whether the body yields a `@Result` as is, yields a
//// `U` through a `try` that fails, or ends with a `throw` (an `iter fn` and an
//// `iter loop`).

import {io.terminal.print} from "std";

fn check(n: i32) -> Result<i32, string> {
    if (n < 0) throw "negative " + n.toString();
    return n;
}

iter fn parsed() -> Iterator<Result<i32, string>> {
    print("parsed before");
    yield check(1);
    print("parsed after");
    yield check(-2);
}

iter fn sugared(xs: i32[]) -> Iterator<Result<i32, string>> {
    for (xs) { x ->
        print("sugared " + x.toString());
        val v = try check(x);
        yield v;
    }
}

iter fn thrown(xs: i32[]) -> Iterator<Result<i32, string>> {
    for (xs) { x ->
        print("thrown before " + x.toString());
        if (x < 0) throw "stop at " + x.toString();
        yield x;
        print("thrown after " + x.toString());
    }
}

fn show(r: Result<i32, string>) {
    case r {
        Ok(v) -> print(v);
        Error(e) -> print("error: " + e);
    }
}

pub fn main() {
    for (parsed()) { r ->
        show(r);
    }
    for (sugared([1, -2, 3])) { r ->
        show(r);
    }
    for (thrown([1, -2, 3])) { r ->
        show(r);
    }
    val looped = iter loop {
        print("loop before");
        yield 1;
        print("loop after");
        throw "loop end";
    };
    for (looped) { r ->
        show(r);
    }
}

//// Decision 601 — A value of an enum section prints as the leaf's whole path, as written, on every target.

import {io.terminal.print} from "std";

type Token {
    Color {
        White,
        Black,
    }
    Layout {
        Break {
            After,
            Before,
        }
    }
    After,
}

pub fn main() -> void {
    print(Token.Color.White);
    print(Token.Layout.Break.After);
    print(Token.After);
    val picked: Token = .Color.Black;
    print("picked " + picked);
    print("in a hole: ${picked}");
    print([Token.Color.White, Token.Layout.Break.Before]);
}

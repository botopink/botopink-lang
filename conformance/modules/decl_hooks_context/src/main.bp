//// Reads what `#[contexts]` recorded on the declarations of `pages`, the cell's
//// subject: a decorator that reads `.hooks` runs after its module's bodies,
//// so its typed meta is read from another module (`typeinfo-meta-hooks-pending`).

pub mod pages;

import {pages.App, pages.ContextUses};
import {compiler, io.terminal.print} from "std";

pub fn main() {
    val uses: string[] = comptime compiler.typeInfo(App).meta(ContextUses)?.uses ?? [];
    print(uses.join(" | "));
}

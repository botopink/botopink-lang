//// Decision 613 — inside an executor `decl` is the annotated declaration
//// spliced as code: on a type it is the type in expression position, so
//// `decl.make()` is `Users.make()`, its static method called when the init
//// list runs.

pub mod marks;
pub mod registry;
import {marks.service};
import {registry.all};

#[service]
pub type Users() {
    pub fn make() -> string {
        return "users made";
    }
}

pub fn main() {
    for (all()) { e ->
        @print(e);
    }
}

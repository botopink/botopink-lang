//// Decision 409 — a method's last expression written without `;` is its
//// value, as a free function's is: `fn area(self: Self) -> i32 { self.w *
//// self.h }`, an associated function and a generic type's method alike.

type Rect(w: i32, h: i32) {
    fn area(self: Self) -> i32 { self.w * self.h }

    fn square(side: i32) -> Rect { Rect(w: side, h: side) }

    fn describe(self: Self) -> string {
        val kind = if (self.w == self.h) "square" else "rect";
        kind + " " + self.area().toString()
    }
}

type Box<T>(value: T) {
    fn get(self: Self<T>) -> T { self.value }
}

pub fn main() {
    @print(Rect(w: 2, h: 3).area());
    @print(Rect.square(4).area());
    @print(Rect(w: 2, h: 2).describe());
    @print(Box(value: "x").get());
}

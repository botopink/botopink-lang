//// Decisions 378, 379, question B-17-g's reading — a read finds its type's
//// declared default in the type's own module: `Label` reads `Theme`, whose
//// default `theme` declares, without importing the declaration.

pub mod theme;

import {theme.Theme};
import {context.createContext, context.provide, context.context, io.terminal.print} from "std";

type Element(text: string) implement Renderable

fn Label() -> Component<Element> {
    val t = use context(Theme);
    return Element(text: t.mode);
}

fn Dark() -> Component<Element> {
    use provide(createContext(Theme(mode: "dark")));
    val l = Label();
    return Element(text: l.text);
}

pub fn main() -> Task<void> {
    val l = await Label();
    print(l.text);
    val d = await Dark();
    print(d.text);
}

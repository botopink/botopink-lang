//// Decision 561 — a function named between backticks, a keyword included
//// (`` `if` ``): declared, called, called recursively and passed as a value;
//// `` `double` `` is the function `double`.

fn `add one`(n: i32) -> i32 {
    return n + 1;
}

fn `if`(c: bool) -> string {
    return if (c) "yes" else "no";
}

fn `count-down`(n: i32) -> i32 {
    return if (n == 0) 0 else 1 + `count-down`(n - 1);
}

fn double(n: i32) -> i32 {
    return n * 2;
}

fn apply(f: fn(i32) -> i32, n: i32) -> i32 {
    return f(n);
}

pub fn main() {
    @print(`add one`(41));
    @print(`if`(true));
    @print(`count-down`(3));
    @print(double(4));
    @print(apply(`add one`, 9));
}

//// Decision 425 — a template call expands wherever an expression may stand:
//// in a `case` arm.

import {compiler} from "std";

fn twice(expr q: string) -> string {
    return compiler.build("\"" + compiler.text(q) + compiler.text(q) + "\"");
}

fn label(n: i32) -> string {
    return case n {
        1 -> twice @`gh`;
        _ -> "other";
    };
}

pub fn main() {
    @print(label(1));
    @print(label(2));
    val k = case label(1) {
        "ghgh" -> twice @`ok`;
        _ -> "no";
    };
    @print(k);
}

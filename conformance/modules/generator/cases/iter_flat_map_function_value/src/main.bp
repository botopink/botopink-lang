//// Decisions 105, 596 — `flatMap` takes a bare function value as it takes a
//// lambda: `counted().flatMap(twice)` hands each item of the source to the
//// top-level generator function `twice` and walks what it answers, lazily.

import {io.terminal.print} from "std";

iter fn counted() -> Iter<i32> {
    defer print("closed");
    print("before");
    yield 1;
    print("after");
    yield 2;
    print("last");
    yield 3;
}

iter fn twice(n: i32) -> Iter<i32> {
    print("twice " + n);
    yield n;
    yield n * 10;
}

pub fn main() -> void {
    print(counted().flatMap(twice).take(3).toArray());
}

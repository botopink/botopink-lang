//// Decisions 105, 539 (3) — a `return` out of a `for` over a generator closes
//// it as leaving by the loop's end does: the defer pending where the body
//// rests runs before the function answers, after the iteration's own defers.

import {io.terminal.print} from "std";

iter fn counted() -> Iter<i32> {
    defer print("closed");
    print("before");
    yield 1;
    print("after");
    yield 2;
}

fn firstFrom(n: i32) -> i32 {
    for x in counted() {
        if (x >= n) return x;
    }
    return 0;
}

fn firstWithDefer() -> i32 {
    for x in counted() {
        defer print("iteration");
        return x;
    }
    return 0;
}

pub fn runCase() -> void {
    print(firstFrom(1));
    print(firstFrom(2));
    print(firstWithDefer());
}

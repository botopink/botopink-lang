//// Decision 354 (2) — a hook of std's `context` module is not a value: bound,
//// passed or returned it would escape the `use` that lowers it. Refused at
//// the name.

import {context.Context, context.provide, context.context} from "std";

type Theme(mode: string)

type Element(text: string) implement @Renderable

pub val ThemeContext = Context<Theme>();

pub fn main() {
    val read = context;
    @print("unreached");
}

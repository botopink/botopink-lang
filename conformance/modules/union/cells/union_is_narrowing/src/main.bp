import {io.terminal.print} from "std";

fn describe(x: i32 | string) -> string {
    if (x is i32) return "an integer";
    return "a string";
}

fn read(raw: unknown) -> string {
    if (raw is string) return raw;
    return "not a string";
}

pub fn main() -> void {
    print(describe(1)); // an integer
    print(describe("a")); // a string
    print(read("text")); // text
    print(read(7)); // not a string
}

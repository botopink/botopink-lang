//// Decision 579 (2) — `compiler` is std's value, bound by its import; a
//// file that names it without `import {compiler} from "std";` gets the
//// ordinary unbound-name error, at the name.

import {io.terminal.print} from "std";

fn mark(syntax decl: unknown) {
    compiler.fail("marked", at: decl);
}

#[mark]
pub type City(name: string)

pub fn main() {
    print(City(name: "a").name);
}

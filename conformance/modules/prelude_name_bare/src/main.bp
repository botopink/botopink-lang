//// Decision 606 (1) — the prelude's types and behaviors are written bare, with no import:
//// `Result`, `Task`, `Iterator`, `Component` and the marker `Renderable`, in a return, a
//// parameter, an `implement` clause and as a type argument of another.

import {io.terminal.print} from "std";

type Badge(label: string) implement Renderable

fn parse(s: string) -> Result<i32, string> {
    if (s == "1") return 1;
    throw "not one: " + s;
}

fn later(n: i32) -> Task<i32> {
    return n * 2;
}

fn upTo(n: i32) -> Iterator<i32> {
    var i = 0;
    while (i < n) {
        yield i;
        i = i + 1;
    }
}

fn joined(it: Iterator<i32>) -> string {
    var acc = "";
    for (it) { x ->
        if (acc == "") acc = x.toString() else acc = acc + " " + x.toString();
    }
    return acc;
}

fn Card(text: string) -> Component<Badge> {
    print("card " + text);
    return Badge(label: text);
}

pub fn main() -> Task<void> {
    print(parse("1"), parse("2"));
    print(await later(21));
    print(joined(upTo(4)));
    await Card("hi");
}

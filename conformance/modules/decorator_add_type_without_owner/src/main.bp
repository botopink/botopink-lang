//// Decision 216 (3) — an associated type belongs to a type: a function's
//// decorator has no owner to give one to, and is refused at the annotation.

import {compiler, io.terminal.print} from "std";

fn helper(syntax decl: unknown) {
    compiler.addType("Extra", compiler.buildType("(id: i32)"));
}

#[helper]
fn work() -> i32 {
    return 2;
}

pub fn main() {
    print(work());
}

//// Decision 584 (1) — `{ async iter n -> … }` is a lambda whose body may
//// `yield` and `await`, answering a `AsyncIter`, typed by the function type it
//// is written for (147): an annotated `val`, and the trailing form,
//// `drain(3) { async iter n -> … }`.

import {io.terminal.print} from "std";

fn double(x: i32) -> Async<i32> {
    return x * 2;
}

fn drain(n: i32, f: fn(n: i32) -> AsyncIter<i32>) -> Async<i32> {
    var acc = 0;
    for await (f(n)) { x ->
        acc = acc + x;
    }
    return acc;
}

pub fn main() -> Async<void> {
    val ticks: fn(n: i32) -> AsyncIter<i32> = { async iter n ->
        yield await double(n);
        yield await double(n + 1);
    };
    for await (ticks(1)) { x ->
        print(x);
    }
    val total = drain(3) { async iter n ->
        yield n;
        yield await double(n);
    };
    print(await total);
}

//// Decision 235 — a `with:` list names each decorator once: `service`
//// listed twice is `typeinfo-all-arguments` where the query is written.

import {compiler, io.terminal.print} from "std";

fn service(syntax decl: unknown) {
    compiler.setMeta(Service(role: "service"));
}

#[service]
pub fn mailer() -> string {
    return "mailer";
}

pub fn main() {
    print(@TypeInfo.all(with: [service, service]).length);
}

// What `#[service]` records.
type Service(role: string)

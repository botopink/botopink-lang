//// Decision 340 — the increment written out, `counts.insert(k, (counts.at(k)
//// ?? 0) + n)`, is not recognised as a `bump`: it stays the recompose refusal
//// (decision 40, rule 5(b)), and `counts = counts.bump(k, n)` is the one
//// atomic per-row increment.

import {collections.Dict} from "std";

#[@BeamMemory.Ets(keyed: true)]
var counts: Dict<string, i32> = Dict.empty();

fn add(k: string, n: i32) {
    counts = counts.insert(k, (counts.at(k) ?? 0) + n);
}

pub fn main() {
    add("a", 1);
    @print(counts.at("a"));
}

//// Decision 330 (5) — `x!` inside a lambda's body is checked when the lambda
//// runs: a present value is the value, a `null` aborts naming the expression
//// and where it is written in the lambda, after what was printed before it,
//// on every target.

import {io.terminal.print} from "std";

fn find(key: string) -> ?string {
    return if (key == "a") "found" else null;
}

pub fn main() {
    val lengths = ["a", "a"].map({ k -> find(k)!.length() });
    print(lengths.length());
    print(lengths.at(1) ?? -1);
    val get: fn(string) -> string = { k -> find(k)! };
    print(get("a"));
    print(get("b"));
    print("unreachable");
}

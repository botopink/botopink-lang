//// Decision 280, example 1 (`01-checker/examples/decorator-arguments-280.md`)
//// — `#[check]` on a type and on a function. Every parameter is `comptime`;
//// `@Decl<T>` binds `T` to the annotated declaration, so `rule` is checked
//// as an `fn(v: Account) -> bool` and `at` as a field of `Account` (`.confirm`,
//// `Type.Field<T>` of decision 308); `code` takes a variant written as
//// declared. The body reads the field key's `name` and the variant as values,
//// each `x.value` of its `comptime x: @Expr<T>` (decision 364); `rule` is an
//// `@Expr` of a function, which has no `.value` — the function form is told
//// apart by the declaration's kind (question `s35-b`).

import {types.Type, compiler.DeclKind, compiler} from "std";

pub type Code { Custom, Required, TooShort, Mismatch }

fn check<T>(
    syntax decl: T,
    comptime message: string,
    comptime rule: ?fn(v: T) -> bool = null,
    comptime at: ?Type.Field<T> = null,
    comptime code: Code = .Custom,
) {
    if (compiler.kind(decl) == DeclKind.Fn) {
        if (compiler.returnType(decl) != "bool")
            compiler.fail("#[check] without `rule` annotates an `fn(x) -> bool`", at: decl);
        compiler.addMeta(Check(at: "rule", message: message, kind: "rule"));
        return;
    }
    val key = at?.name ?? "type";
    val kind = if (code == Code.Mismatch) "mismatch" else "custom";
    compiler.addMeta(Check(at: key, message: message, kind: kind));
}

#[check("passwords differ", passwordsMatch, at: .confirm)]
#[check("handle taken", handleFree, at: .handle, code: .Mismatch)]
pub type Account(handle: string, password: string, confirm: string)

fn passwordsMatch(a: Account) -> bool {
    return a.password == a.confirm;
}

fn handleFree(a: Account) -> bool {
    return a.handle != "admin";
}

#[check("the password holds the handle")]
fn passwordNotHandle(a: Account) -> bool {
    return !a.password.contains(a.handle);
}

pub fn main() {
    for (@typeInfo(Account).metaAll(Check)) { c ->
        @print(c.message + " (" + c.kind + ")");
    }
    @print(@typeInfo(passwordNotHandle).meta(Check)?.message ?? "none");
    val a = Account(handle: "ana", password: "abc", confirm: "abd");
    @print(passwordsMatch(a));
    @print(handleFree(a));
    @print(passwordNotHandle(a));
}

// What `#[check]` records, once per annotation: the field it is `at` (`"type"`
// for none, `"rule"` on a function), the message and the code's kind.
type Check(at: string, message: string, kind: string)

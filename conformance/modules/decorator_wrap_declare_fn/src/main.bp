//// Decision 316 — `decl.wrapWith(f)` wraps a function's body: a `declare fn`
//// has none, so wrapping one is refused at the annotation.

fn counted(expr decl: fn(..) -> i32) {
    compiler.wrapWith({ call -> call.run() });
}

type Clock() {
    #[counted]
    declare fn now(self: Self) -> i32;
}

pub fn main() {
    @print(Clock().now());
}

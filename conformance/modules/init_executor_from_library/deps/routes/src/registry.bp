//// A library's decorator: `#[route("/path")]` compiles the registration of
//// the annotated function into the program's init list. The executor calls
//// `remember`, private to this module: its names resolve here (decision 384).

import {compiler} from "std";

var table: string[] = [];

fn remember(path: string, name: string) {
    table.push(path + " -> " + name);
}

pub fn routes() -> string[] {
    return table;
}

pub fn route(syntax decl: unknown, comptime path: string) {
    val name = compiler.name(decl);
    compiler.init({ -> remember(path, name) });
}

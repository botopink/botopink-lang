//// Decision 355 as decision 577 (5) amends it — `quote` splices the hole
//// `boom` into the code it builds; it never reads the hole's value, and
//// `boom`'s panic raises when the program runs.

pub fn crash(s: string) -> string {
    @panic("crash: " + s);
    return s;
}

pub fn raising(expr t: string) -> string {
    return compiler.build("crash(\"" + compiler.text(t) + "\")");
}

fn quoted(text: string) -> string {
    return "\"" + text + "\"";
}

// The text's `${…}` holes are the template's own syntax (decision 577 (1)):
// the code `"" + "<text>" + (<hole>) + …`, each hole's expression
// spliced as written and typed where the call stands (14s8-a (e)).
fn spliced(text: string) -> string {
    var code = "\"\"";
    var first = true;
    for (text.split("\${")) { piece ->
        if (first) {
            code = code + " + " + quoted(piece);
            first = false;
        } else {
            val close = piece.indexOf("}");
            code = code
                + " + ("
                + piece.slice(0, close)
                + ") + "
                + quoted(piece.slice(close + 1));
        }
    }
    return code;
}

pub fn quote(expr t: string) -> string {
    return compiler.build(spliced(compiler.text(t)));
}

pub val boom = raising @`x`;

pub val read = quote @`${boom}`;

pub fn main() {
    @print(read);
}

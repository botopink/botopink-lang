//// Decisions 431 (2), 487, 488, 490 — `result: true` is accepted on a binding
//// whose return is `@Result<…, HostError>` or `@Task<@Result<…, HostError>>`,
//// std's `failure.HostError` named as a leaf or through its module; the flag
//// is labelled and sits anywhere among the arguments, beside `inline:`. No
//// binding is called: what the cell claims is that the program checks.

import {failure, failure.HostError, compiler, io.terminal.print} from "std";

#[compiler.external(.JavaScript("JSON.parse($0)", result: true), .Erlang("json:decode($0)", result: true))]
declare fn jsParse(s: string) -> Result<i32, HostError>;

#[compiler.external(.JavaScript("Promise.resolve($0)", result: true), .Erlang("$0", inline: true, result: true))]
declare fn later(n: i32) -> Task<Result<i32, failure.HostError>>;

#[compiler.external(.JavaScript("Math.abs($0)", result: false), .Erlang("abs($0)", result: false))]
declare fn magnitude(n: i32) -> i32;

pub fn main() {
    print("checked");
}

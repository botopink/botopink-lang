//// A decorator body's lambda holding many locals runs on the comptime
//// runtime: 120 `val`s per field of a three-field record, then their joined
//// length, on every target (144 B-10, decision 430). It was `wasm3: [trap]
//// stack overflow` on a two-field record (`#[validated]`'s parse half).

fn wide(comptime decl: @Decl) {
    var out: string[] = [];
    decl.fields.forEach({ f ->
        val v0 = f.name + "0" + f.typeName;
        val v1 = f.name + "1" + f.typeName;
        val v2 = f.name + "2" + f.typeName;
        val v3 = f.name + "3" + f.typeName;

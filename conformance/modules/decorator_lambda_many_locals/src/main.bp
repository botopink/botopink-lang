        val v104 = f.name + "104" + f.typeName;
        val v105 = f.name + "105" + f.typeName;
        val v106 = f.name + "106" + f.typeName;
        val v107 = f.name + "107" + f.typeName;
        val v108 = f.name + "108" + f.typeName;

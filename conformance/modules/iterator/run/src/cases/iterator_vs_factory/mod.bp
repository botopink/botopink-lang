import {io.terminal.print} from "std";

fn evens(xs: i32[]) -> Iterator<i32> {
    // an iterator: it yields
    for (xs) { x ->
        if (x % 2 == 0) yield x;
    }
}

fn evensOf(xs: i32[]) -> Iterator<i32> {
    // a factory: it returns one
    return iter for (xs) { x ->
        if (x % 2 == 0) yield x;
    };
}

pub fn runCase() {
    for (evens([1, 2, 3, 4])) { x ->
        print(x);
    } // 2, 4
    for (evensOf([5, 6, 7, 8])) { x ->
        print(x);
    } // 6, 8
}

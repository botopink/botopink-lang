import {io.terminal.print} from "std";

fn port(n: i32) -> Result<i32, string> {
    if (n <= 0) throw "not a port: " + n.toString();
    return n;
}

iter fn ports(xs: i32[]) -> Iter<Result<i32, string>> {
    for x in xs {
        yield try port(x);
    } // a failed `try` emits Error(e) and ends
}

// stop at the first error: an explicit try, under a Result return
fn sumPorts(xs: i32[]) -> Result<i32, string> {
    var total = 0;
    for r in ports(xs) {
        val p = try r; // the explicit try: an Error rises from here
        total = total + p;
    }
    return total;
}

// carry on past the error: a case, in any function
fn printPorts(xs: i32[]) -> void {
    for r in ports(xs) {
        case r {
            Ok(p) -> print(p);
            Error(e) -> print("error: " + e);
        }
    }
}

pub fn runCase() -> void {
    printPorts([80, 0, 443]); // 80, then error: not a port: 0
    print(sumPorts([80, 443]).unwrapOr(-1)); // 523
    print(sumPorts([80, 0, 443]).unwrapOr(-1)); // -1
}

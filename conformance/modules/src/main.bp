pub async fn main() -> Async<void> {
    var red = 0;
    for runs { r ->
        val v = await r();
        if (v.startsWith("FAIL ")) red = red + 1;
        print(v);
    }
    print("modules: "
        + runs.length.toString()
        + " checked — "
        + (runs.length - red).toString()
        + " passed, "
        + red.toString()
        + " failed");
}

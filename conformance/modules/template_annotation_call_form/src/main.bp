//// Decisions 311, 577 (3) — `#[f(…)]` naming a template function is
//// `expr-call-outside-expr` at the annotation, naming the template form
//// `#[f @`…`]`.

type Query(sql: string)

fn sql(expr q: string, expr decl: unknown) -> string {
    compiler.setMeta(Query(sql: compiler.text(q)));
    return compiler.build("\"\"");
}

#[sql("select 1")]
fn one() -> i32 {
    return 1;
}

pub fn main() {
    @print(one().toString());
}

//// Decision 356 — a `val` owns no type: `decl.addType` from a decorator on a
//// `val` is refused at the annotation, as on a function.

import {compiler} from "std";

fn helper(syntax decl: unknown) {
    compiler.addType("Columns", compiler.buildType("(id: string)"));
}

#[helper]
pub val limit = 2;

pub fn main() {
    @print(limit);
}

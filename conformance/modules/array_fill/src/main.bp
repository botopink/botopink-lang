//// `Array.fill(v)` is `Array.repeat(v, xs.length)`: one `v` per element of
//// the receiver, whatever the receiver holds — an integer, a string, a bool,
//// a float, and nothing for an empty receiver. wasm trapped
//// (`01-compiler/05-wasm` step 1).

pub fn main() {
    @print([1, 2].fill(0));
    @print([1, 2, 3].fill("z"));
    @print(["a"].fill(true));
    @print([1, 2].fill(2.5));
    val f = [7, 8, 9].fill(1);
    @print(f.at(2));
    @print(f.length);
    val none: i32[] = [];
    @print(none.fill(4));
}

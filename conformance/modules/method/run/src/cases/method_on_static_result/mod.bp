//// `run(m.make(), scope)`: `make` is a record field holding a component
//// lambda, the call answers a component, and std's `run` resolves it over the
//// scope a record holds, on every target (a `.run/2` that does not exist was
//// emitted on erlang). `run` answers an `Async`, read by `await` (decisions
//// 523, 822; B-162).

import {context.run, context.Scope, io.terminal.print} from "std";

type View(text: string)

type Module(name: string, make: fn() -> Component<View>)

type Mount(root: Scope) {
    pub async fn mount(self: Self, m: Module) -> Async<string> {
        val c: Component<View> = m.make();
        val a = await run(c, self.root);
        val b = await run(m.make(), self.root);
        return a.text + "/" + b.text;
    }
}

component fn Card() -> Component<View> {
    return View(text: "card");
}

pub async fn runCase() -> Async<void> {
    val m = Module(name: "card", make: { -> Card() });
    print(await Mount(root: Scope.root()).mount(m));
}

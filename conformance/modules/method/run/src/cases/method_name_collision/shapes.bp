//// Two records declaring a method of the SAME name at the same arity, whose
//// bodies read a DIFFERENT field position, and two fns answering one each
//// through a generic return — which is where the value loses the type
//// inference could have placed it.

pub type Query<T>(
    items: array<T>,
) {
    pub fn toArray(self: Self<T>) -> array<T> {
        return self.items;
    }
}

pub type Grouping<K, V>(
    key: K,
    items: array<V>,
) {
    pub fn toArray(self: Self<K, V>) -> array<V> {
        return self.items;
    }
}

pub fn queryOf<T>(xs: array<T>) -> Query<T> {
    return Query(items: xs);
}

pub fn groupOf<K, V>(k: K, xs: array<V>) -> Grouping<K, V> {
    return Grouping(key: k, items: xs);
}

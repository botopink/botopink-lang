mod cases;

pub async fn main() -> Async<void> {
    cases.method_behavior_parameter_implementer.runCase();
    cases.method_default_argument.runCase();
    cases.method_name_collision.runCase();
    cases.method_named_like_module_fn.runCase();
    cases.method_on_number_literal.runCase();
    await cases.method_on_static_result.runCase();
    cases.method_on_unimported_type.runCase();
}

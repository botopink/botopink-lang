//// Decision 355 as decision 577 (5) amends it — `rule` parses the `${…}`
//// holes of its text itself and splices each expression (`textOf(<hole>)`)
//// into the `Rule` it builds: a literal, a `val`, another expansion, a
//// `comptime` value, a parameter and a call alike.

pub type Rule(text: string)

pub fn textOf(v: string | Rule) -> string {
    if (v is Rule) return v.text;
    if (v is string) return v;
    return "";
}

fn quoted(text: string) -> string {
    return "\"" + text + "\"";
}

// The text's `${…}` holes are the template's own syntax (decision 577 (1)):
// the code `"" + "<text>" + textOf(<hole>) + …`, each hole's expression
// spliced as written and typed where the call stands (14s8-a (e)).
fn spliced(text: string) -> string {
    var code = "\"\"";
    var first = true;
    for (text.split("\${")) { piece ->
        if (first) {
            code = code + " + " + quoted(piece);
            first = false;
        } else {
            val close = piece.indexOf("}");
            code = code
                + " + textOf("
                + piece.slice(0, close)
                + ") + "
                + quoted(piece.slice(close + 1));
        }
    }
    return code;
}

pub fn rule(expr t: string) -> Rule {
    return compiler.build("Rule(text: " + spliced(compiler.text(t)) + ")");
}

fn shout(s: string) -> string {
    return s.toUpper();
}

pub val red = "red";

pub val tab = rule @`tab-size: 4;`;

pub val literal = rule @`color: ${"blue"};`;

pub val named = rule @`color: ${red};`;

pub val expansion = rule @`${tab} color: ${red};`;

pub val nested = rule @`${expansion} margin: 0;`;

pub val folded = rule @`font: ${comptime shout("mono")};`;

fn badge(c: string) -> Rule {
    return rule @`color: ${c};`;
}

pub val called = rule @`${badge("green")} margin: 0;`;

fn show(r: Rule) {
    @print(r.text);
}

pub fn main() {
    show(tab);
    show(literal);
    show(named);
    show(expansion);
    show(nested);
    show(folded);
    show(badge("green"));
    show(called);
}

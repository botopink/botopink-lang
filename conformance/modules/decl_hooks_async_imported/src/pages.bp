//// Decision 375 — `HookNode.async` across modules: each reached function
//// of `ui` enters with the mark its own module published. `Page` `use`s
//// `ui`'s synchronous `session` through an alias and renders `ui.Avatar`
//// through the namespace — every node `sync`. `Wall` renders `ui.Posts`,
//// which awaits: `Posts` is `async`, and so is `Wall`, which writes no
//// `await`.

import {ui};

import {ui.session as currentUser, ui.Element};
import {compiler} from "std";

fn graph(syntax decl: unknown) {
    var nodes: string[] = [];
    compiler
        .hooks(decl)
        .forEach({ n ->
            val mark = if (n.async) "async" else "sync";
            nodes.push(n.function.module + "." + n.function.name + ": " + mark)
        });
    compiler.setMeta(Graph(nodes: nodes));
}

#[graph]
pub fn Page() -> Component<Element> {
    val who = use currentUser();
    val a = ui.Avatar();
    return Element(text: who + " " + a.text);
}

#[graph]
pub fn Wall() -> Component<Element> {
    val p = ui.Posts();
    return Element(text: p.text);
}

// What `#[graph]` records: one rendered node per entry of `decl.hooks`.
pub type Graph(nodes: string[])

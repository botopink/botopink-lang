//// 144 B-22 — a record prints as its type's name and its fields, whatever the fields are named: a
//// field called `tag`, of a plain or a generic record, is a field like any other, and a variant of
//// an enum still prints as `Enum.Variant(…)`. commonJS printed `Box.t(value: 1, tag: "t")`.

import {io.terminal.print} from "std";

type Box<T>(value: T, tag: string)

type Label(tag: string, size: i32)

type Shape {
    Circle(radius: i32),
    Dot,
}

pub fn main() {
    print(Box(value: 1, tag: "t"));
    print(Box(value: "s", tag: "u"));
    print(Label(tag: "big", size: 3));
    print([Label(tag: "a", size: 1)]);
    print(Shape.Circle(radius: 2));
    print(Shape.Dot);
}

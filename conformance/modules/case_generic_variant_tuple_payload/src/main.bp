type Maybe<T> {
    Some(value: T),
    None,
}

fn sumPair(m: Maybe<#(i32, i32)>) -> i32 {
    return case m {
        .Some(#(a, b)) {
            a + b;
        }
        .None {
            -1;
        }
    };
}

pub fn main() {
    @print(sumPair(Maybe.Some(value: #(2, 3))));
    @print(sumPair(Maybe.None));
}

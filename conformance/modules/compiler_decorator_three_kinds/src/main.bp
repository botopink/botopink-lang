//// Decisions 575 (3), (4) — a decorator's parameters arrive three ways. Its
//// first `syntax` is the annotated declaration (`decl`, read through
//// `compiler.name`); `comptime label: string` holds the value at build
//// (`label.toUpper()`); `syntax rule: fn(v: T) -> bool` holds the expression
//// written, read at build as the annotation wrote it (`compiler.text(rule)`)
//// and spliced into the member the program runs. In the member, `label` and
//// the body's `val shown` are spliced as literals (the tree rule).

import {compiler} from "std";

pub type Violation(message: string)

pub type Mark(text: string)

fn check<T>(syntax decl: T, comptime label: string, syntax rule: fn(v: T) -> bool) {
    val shown = label + " (" + compiler.text(rule) + ")";
    compiler.addMember("validate", fn(self: T) -> Violation[] {
        if (rule(self)) return [];
        return [Violation(message: label), Violation(message: shown)];
    });
    compiler.setMeta(Mark(text: label.toUpper()
        + " "
        + compiler.name(decl)
        + " "
        + compiler.text(rule)));
}

fn positive(a: Account) -> bool {
    return a.balance >= 0;
}

#[check("negative balance", positive)]
pub type Account(balance: i32)

pub fn main() {
    @print(@typeInfo(Account).meta(Mark)?.text ?? "none");
    @print(Account(balance: 5).validate().length);
    Account(balance: -1).validate().forEach({ v -> @print(v.message) });
}

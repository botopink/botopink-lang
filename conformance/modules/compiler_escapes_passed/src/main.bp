//// Decision 579 (3) — `compiler` is the compiler of its point, read only
//// through its members: passed as an argument it is refused at the name
//// (`compiler-escapes`).

import {compiler} from "std";

fn report(at: unknown) {}

fn mark(syntax decl: unknown) {
    report(compiler);
}

#[mark]
pub type City(name: string)

pub fn main() {
    @print(City(name: "a").name);
}

//// Decisions 352, 354 — a component computed at render that reads the
//// sheet's context with no `use provide(…)` above it (front 119 step 1:
//// `styled "color: ${c};"` rendered outside a render) is `context-unbound` at
//// run time, naming the context. What prints before it stands.

import {context.Context, context.provide, context.context} from "std";

type Rule(name: string, text: string) implement @Renderable

type SheetWriter(layer: string, add: fn(layer: string, rule: Rule))

pub val SheetContext = Context<SheetWriter>();

fn computed(name: string) -> @Component<Rule> {
    val sheet = use context(SheetContext);
    val out = Rule(name: name, text: name);
    sheet.add(sheet.layer, out);
    return out;
}

pub fn main() -> @Task<void> {
    @print("before");
    val r = await computed("badge");
    @print(r.name);
}

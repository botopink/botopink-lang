//// A template function that reads one typed meta back by `d.meta(T)`
//// (decision 302).

pub type Hydrate(level: i32, note: string)

// An annotation without arguments: records what the tag offers — `attr`
// answers `null` for an attribute the tag does not have, `component` is
// `null` on an element.
pub fn hydrated(comptime decl: @Decl) {
    val id = decl.attr("id") ?? "no id";
    val comp = decl.component?.name ?? "no component";
    decl.setMeta(Hydrate(level: 1, note: id + ", " + comp));
}

pub fn markup(comptime q: @Expr<string>) -> @Expr<string> {
    val text = q.text();
    val name = text.slice(1, text.indexOf(" "));
    val tag = q.tagDecl(DeclKind.Element, name, []);
    val d = q.annotate(tag, Span(start: text.indexOf("#[")
        + 2, end: text.indexOf("]>"), line: 1));
    val h = d.meta(Hydrate);
    if (h == null) return @expr("none");
    return @expr(d.name + " " + h.level.toString() + " " + h.note);
}

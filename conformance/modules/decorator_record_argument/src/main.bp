//// Decision 280 (2) — a record argument whose type is tied to the annotated
//// function: `Cache<T>` must be the cache of what the function returns.

import {compiler, io.terminal.print} from "std";

type Product(name: string)

type Cache<T>(name: string)

fn cacheable<A, T>(
    syntax decl: fn(a: A) -> T,
    comptime cache: Cache<T>,
) {
    compiler.setMeta(Cacheable(cache: cache.name));
}

val products = Cache<Product[]>("products");

#[cacheable(products)]
fn byCategory(c: string) -> Product[] {
    return [Product(name: c)];
}

pub fn main() {
    print(comptime compiler.typeInfo(byCategory).meta(Cacheable)?.cache ?? "none");
    print(byCategory("tea")[0]?.name ?? "none");
}

// What `#[cacheable]` records.
type Cacheable(cache: string)

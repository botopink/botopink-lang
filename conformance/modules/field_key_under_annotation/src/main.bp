//// Decision 308 — a field key (`.title`) resolves against the record its
//// `Type.Field<T>` names. A generic constructor's `T` is pinned by the
//// position's written type as by the call's own type arguments:
//// `val t: Sort<Book> = Sort(by: .title)` is `Sort<Book>(by: .title)`.

import {types.Type, io.terminal.print} from "std";

type Book(title: string, pages: i32)

type Sort<T>(by: Type.Field<T>)

fn keyOf(s: Sort<Book>) -> string {
    return s.by.name;
}

pub fn main() {
    val written: Sort<Book> = Sort(by: .title);
    val applied = Sort<Book>(by: .pages);
    print(written.by.name);
    print(applied.by.name);
    print(keyOf(written));
}

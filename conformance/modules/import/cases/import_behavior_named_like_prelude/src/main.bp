//// `import {ui.Component, ui.Field, ui.widget};` — each imported name is the
//// behavior `ui` declares, in an `implement` clause, a parameter and the
//// decorator's `@Decl<Component>`, never the prelude's declaration of it.

mod ui;

import {ui.Component, ui.Field, ui.widget};
import {io.terminal.print} from "std";

#[widget]
pub type Card(title: string) implement Component, Field {
    fn render(self: Self) -> string {
        return "<" + self.title + ">";
    }

    fn column(self: Self) -> string {
        return "title";
    }
}

fn show(c: Component) -> string {
    return c.render();
}

fn columnOf(f: Field) -> string {
    return f.column();
}

pub fn main() -> void {
    val card = Card(title: "hi");
    print(show(card));
    print(columnOf(card));
}

//// An imported function whose name is capitalised is that function, called
//// with labelled arguments or positional ones — never a constructor. beam
//// built `Make(n: 4)` as the label-keyed record `#{n => 4}` (`03-beam`).

pub mod util;
import {cases.import_capitalised_fn.util.Make, cases.import_capitalised_fn.util.Scale};
import {io.terminal.print} from "std";

pub fn runCase() -> void {
    print(Make(n: 4));
    print(Make(5));
    print(Scale(x: 2, by: 10));
}

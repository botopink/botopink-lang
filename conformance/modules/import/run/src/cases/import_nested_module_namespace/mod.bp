//// conformance/docs.md § Imports — an item whose whole path names a module binds a
//// namespace, a nested one too: `import {cases.import_nested_module_namespace.store.cache};` in a sibling of
//// `store` binds `cache` (`store/mod.bp` declares `pub mod cache;`).

import {io.terminal.print} from "std";

mod store;
mod report;

pub fn runCase() {
    print(report.summary());
}

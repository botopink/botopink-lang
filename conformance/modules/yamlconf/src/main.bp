// yamlconf — using the config template (expr-templates showcase; botopink-lang's
// `examples/yamlconf` until 144 B-29 step H made it a cell).

mod yamlconf;
import {yamlconf.conf};

val cfg = conf @`server:
  host: "0.0.0.0"
debug: true`;

fn main() {
    @print(cfg.server.port + 1); // ok: i32 — structure revealed at expansion
    @print(cfg.debug); // ok: bool
}

//// `v.pop()` on a `var` answers the last item and rebinds the `var` to the
//// shrunk array: a `val` that read the array before keeps the array of its
//// moment, on every target.

pub fn main() {
    var ys = [1, 2];
    val snap = ys;
    val last = ys.pop();
    @print(snap);
    @print(last);
    @print(ys);
}

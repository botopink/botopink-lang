//// Decision 376 (2) — a `comptime` inside a `Run` function is computed at
//// build into a constant, so the build-only call under it and the clock
//// read beside it are legal together: `cabecalho` is `Run`.

import {io.clock} from "std";

fn campos(comptime names: @Expr<string>) -> string {
    return "[" + names.value + "]";
}

fn cabecalho() -> string {
    val n = comptime campos("title,body");
    val agora = clock.nowMillis();
    val suffix = if (agora > 0) " (now)" else " (never)";
    return n + suffix;
}

fn campos2() -> string {
    val n = comptime {
        val fs = campos("x,y,z");
        break fs + "|";
    };
    val ok = if (clock.nowMillis() > 0) "ok" else "no";
    return n + " " + ok;
}

pub fn main() {
    @print(cabecalho());
    @print(campos2());
}

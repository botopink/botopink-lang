//// Decision 676 — the target rule holds through the whole graph: `outer`
//// declares every target, as this program does, and depends on `inner`,
//// which declares `commonJS` and `erlang` alone; `outer`'s manifest is
//// refused at `inner`'s line, naming `beam` and `wasm`.

import {wrap} from "outer";
import {io.terminal.print} from "std";

pub fn main() {
    print(wrap());
}

//// 144 B-23 (proposed by its Conformance step) — a template declared in
//// another module whose body raises is refused at the call that expanded it,
//// and the message names the call that raised in the template's own file
//// (`src/tpl.bp:3:5`), as a decorator's body does. The parent binary named no
//// file: the location sat in another module's source.

pub mod tpl;
import {cases.template_raise_names_body_file.tpl.shout};
import {io.terminal.print} from "std";

pub fn main() -> void {
    print(shout @`hi`);
}

//// A 64-bit integer — `u64`, `i64`, `u32` — is a tuple element like any
//// other on every target: built, printed, read by index, destructured,
//// bound by a `case` and a `for`, returned, passed, compared, and nested.
//// wasm refused the element ("would narrow this `i64` value to an `i32`
//// slot"); its slot now holds the value's 8-byte cell, as a record field
//// does.

fn swap(t: #(i64, u32)) -> #(u32, i64) {
    val #(a, b) = t;
    return #(b, a);
}

fn first(t: #(u64, string)) -> u64 {
    return t.0;
}

fn pair(n: u64) -> #(u64, bool) {
    return #(n, true);
}

pub fn main() {
    val top: u64 = 18446744073709551615;
    val three: u64 = 3;
    val neg: i64 = -9007199254740991;
    val wide: u32 = 4000000000;
    val t: #(u64, bool) = #(top, false);
    @print(t);
    @print(t.0);
    val #(n, flag) = t;
    @print(n, flag);
    val loose = #(top, "x");
    @print(loose.0.toString());
    val s = swap(#(neg, wide));
    @print(s);
    @print(s.0 + 1);
    @print(s.1 - 1);
    @print(first(#(top, "q")));
    val rows: Array<#(u64, string)> = [#(top, "a"), #(three, "b")];
    @print(rows);
    for (rows) { r ->
        @print(r.1, r.0);
    }
    @print(rows.map({ r -> r.0.toString() }));
    case #(three, "c") {
        #(k, name) -> @print(name, k);
    }
    @print(#(#(top, three), "nested"));
    @print(pair(top) == #(top, true));
    @print(pair(5) == #(5, true));
    @print(pair(5) != #(6, true));
    @print(s == #(wide, neg));
}

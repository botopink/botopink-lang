//// `use` in a plain fn — decision 104: only a `#[@use]` body activates a hook,
//// and the refusal names the annotation.

import {io.terminal.print} from "std";

type Element(count: i32)
component fn state(initial: i32) -> Component<i32> { return initial; }

fn label() -> string {
    val c = use state(0);
    return "n";
}

pub fn main() -> void { print(label()); }

//// A package that does not declare `Declared` — the compiler's record — reads its fields off the
//// entries the program hands it: directly, through a function, inside `map` and inside `for`.

// Passes a value through the host. It has no wasm binding, which keeps this cell off wasm: the
// wasm backend cannot yet place a field of a record the module does not declare.
#[@External.Node("""$0""")]
#[@External.Erlang("""$0""")]
declare fn through(s: string) -> string;

pub fn mark(comptime decl: @Decl) {
    decl.setMeta("k", decl.name);
}

fn nameOf(d: Declared<unknown>) -> string {
    return through(d.name);
}

pub fn show(all: Declared<unknown>[]) {
    @print(all.map({ d -> d.name }).join(","));
    @print(all.map({ d -> nameOf(d) }).join(","));
    for (all) { d ->
        @print(d.module
            + " "
            + d.name
            + " "
            + d.meta.map({ x -> x.key + "=" + x.value }).join(","));
    }
}

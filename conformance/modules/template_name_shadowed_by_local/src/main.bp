//// Decision 425 and the scope rule — the nearest binding wins: a parameter or
//// a local named like a template function is the value called there, and the
//// template stays the name's everywhere else.

import {compiler} from "std";

fn shout(syntax q: string) -> string {
    return compiler.build("\"template " + compiler.text(q) + "\"");
}

fn run(shout: fn(string) -> string) -> string {
    return shout @`x`;
}

pub fn main() {
    @print(shout @`before`);
    @print(run({ s -> "param " + s }));
    val shout: fn(string) -> string = { s -> "local " + s };
    @print(shout @`a`);
    @print(shout @`b`);
}

//// Decision 799 (3) — a lowercase `behavior string { … }` is a behavior named like a literal's type, refused at the
//// name as `primitive-type-redeclared` (639); a program adds members to `string` through a contract of its own.

import {io.terminal.print} from "std";

behavior string {
    default fn tailShout(self: Self) -> string {
        return self + "!";
    }
}

pub fn main() -> void {
    print("a+b".tailShout());
}

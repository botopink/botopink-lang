//// Decision 364 (2) — every `comptime` parameter is `comptime x: @Expr<T>`,
//// and `x.value` answers the argument's value at build when it is known and
//// `T` is data: a string, a number, a `bool`, a variant, a record, a field
//// key, an array. The same `.value` reads an ordinary function's `comptime`
//// parameter (the call specialised) and a template's literal without holes.

import {types.Type, compiler} from "std";

pub type Level { Low, High }

pub type Limits(min: i32, max: i32)

fn mark<T>(
    expr decl: T,
    comptime label: string,
    comptime weight: f64,
    comptime loud: bool,
    comptime level: Level,
    comptime limits: Limits,
    comptime key: Type.Field<T>,
    comptime tags: string[],
) {
    val shown = if (loud) label.toUpper() else label;
    val lvl = if (level == Level.High) "high" else "low";
    compiler.setMeta(
        Mark(
            shown: shown,
            weight: weight,
            level: lvl,
            min: limits.min,
            max: limits.max,
            key: key.name,
            tags: tags,
        ),
    );
}

#[mark("city", 2.5, true, .High, Limits(min: 1, max: 9), .name, ["a", "b"])]
pub type City(code: string, name: string)

fn scale(comptime n: i32, x: i32) -> i32 {
    return x * n;
}

fn shout(expr q: string) -> string {
    val loud = compiler.text(q).toUpper() + "!";
    return loud;
}

pub fn main() {
    val mark = @typeInfo(City).meta(Mark);
    if (mark) {
        m ->
        @print(
            m.shown
                + " "
                + m.weight.toString()
                + " "
                + m.level
                + " "
                + m.min.toString()
                + ".."
                + m.max.toString()
                + " "
                + m.key
                + " "
                + m.tags.join("+"),
        );
    }
    @print(scale(3, 7));
    @print(scale(5, 2));
    @print(shout @`hello`);
}

// What `#[mark]` records: each argument's value as the body read it.
type Mark(
    shown: string,
    weight: f64,
    level: string,
    min: i32,
    max: i32,
    key: string,
    tags: string[],
)

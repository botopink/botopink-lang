//// Decisions 434, 341, 452 — a host function a decorator reaches runs at
//// comptime on the wasm runtime, for every target, by one of two cells: its
//// `compiler.external(.Wasm)(std: "…")` cell (std-wasm) or its `compiler.external(.Wasm)(fn: …)`
//// cell. `bang` has neither — `compiler.external(.JavaScript)` never serves, there is no Node
//// at comptime — so the call is refused when the package is compiled, naming
//// the function and both cells, whatever the build's target.

import {compiler, io.terminal.print} from "std";

#[compiler.external(.JavaScript("""($0 + "!")"""))]
declare fn bang(value: string) -> string;

fn sized(syntax decl: unknown) {
    @emit("pub fn summary() -> string { return \""
        + bang(compiler.name(decl))
        + "\"; }");
}

#[sized]
type Point(x: i32, y: i32)

pub fn main() {
    print(summary());
}

//// Decision 581 (2) — inside a `compiler.compile` executor the decorator's
//// `syntax decl` handle is the annotated declaration itself as a run-time
//// value, with its declared type: `make: decl` is checked against `make`'s
//// `fn() -> string` for each annotated declaration, and `main` calls it. The
//// `comptime` parameter `lifecycle` and the body's `val name` enter the
//// executor as literals (575 (4)).

pub mod marks;
pub mod registry;
import {marks.module};
import {registry.all};

#[module("singleton")]
pub fn home() -> string {
    return "home";
}

#[module("scoped")]
fn about() -> string {
    return "about " + home();
}

pub fn main() {
    for (all()) { m ->
        @print(m.name + " " + m.lifecycle + " " + m.make());
    }
}

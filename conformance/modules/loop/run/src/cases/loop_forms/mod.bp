import {io.terminal.print} from "std";

pub fn runCase() -> void {
    val xs = [1, 2, 3];

    for item in xs {
        print(item);
    }

    for i in 1...3 {
        print(i);
    }

    var n = 0;
    while (n < 3) {
        n = n + 1;
    }

    loop {
        n = n - 1;
        if (n == 0) break;
    }
}

//// Decision 105 — `a..b` is exclusive, `a...b` inclusive (decision 53's
//// pattern token as a value). `for (1..4)` visits 1 2 3; `for (1...4)` visits
//// 1 2 3 4; an empty range runs no iteration.

import {io.terminal.print} from "std";

pub fn runCase() -> void {
    for i in 1..4 {
        print(i);
    }
    for i in 1...4 {
        print(i);
    }
    var n = 0;
    for i in 3...2 {
        n = n + 1;
    }
    print(n);
}

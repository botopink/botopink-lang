//// Decision 205 — a `case` arm's binder that reuses a name the function
//// already bound (here the parameter `s`) is `binding-redeclared` at the
//// arm: the `n` inside a `case` gets another name.

type Shape {
    Circle(radius: i32),
    Square(side: i32),
}

fn area(s: Shape) -> i32 {
    return case s {
        Circle(r) -> 3 * r * r;
        Square(s) -> s * s;
    };
}

pub fn main() {
    @print(area(Shape.Square(side: 3)));
}

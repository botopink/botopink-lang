//// An alias whose body names `Request` and `Out`, which THIS module imports.

import {cases.behavior_across_modules.web.Request, cases.behavior_across_modules.web.Out};

pub type PageRenderer = fn(req: Request, out: Out) -> string;

pub fn render(renderer: PageRenderer, req: Request) -> string {
    return renderer(req, Out(tag: "out"));
}

//// A method called on a `behavior` no type of the program implements is
//// answered by a value the host builds. The wasm backend has nothing to call
//// when the `declare fn` that builds the value carries no
//// `#[compiler.external(.Wasm(…))]` cell, and says so: the missing host binding is the
//// refusal, not an unresolved call.

import {compiler, io.terminal.print} from "std";

behavior Greeter {
    val tag: string;

    fn greet(self: Self, who: string) -> string;
}

#[compiler.external(
    .JavaScript("({ tag: $0, greet: function (who) { return this.tag + ', ' + who; } })"),
    .Erlang("#{tag => $0, greet => fun(Self, Who) -> iolist_to_binary([maps:get(tag, Self), $,, 32, Who]) end}"),
)]
declare fn makeGreeter(tag: string) -> Greeter;

fn shout(g: Greeter) -> string {
    return g.greet("world");
}

fn greeter() -> Greeter {
    return makeGreeter("hey");
}

pub fn main() -> void {
    print(shout(greeter()));
}

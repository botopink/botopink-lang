//// The style section's unfold target: a hook answering the section's
//// length, and refusing a `!` in it at the `!`. The code it builds calls
//// `sized`, which the `.bpp` header imports.

import {bpp} from "std";

pub fn sized(size: i32) -> @Component<i32> {
    return size;
}

#[bpp.style]
pub fn css(comptime t: @Expr<string>) -> @ExprCustom<@Component<i32>> {
    val text = t.text();
    val at = text.indexOf("!");
    if (at >= 0) t.failAt(Span(at, at + 1, 1), "css: `!` is not a rule");
    val root = CustomNode(
        kind: "css",
        span: Span(0, 0, 1),
        label: "",
        ref: null,
        children: [],
    );
    return t.custom(root, t.build("sized(" + text.length().toString() + ")"));
}

//// Decision 547 (ii) — under `beamMemory(.Ets)`, a write that recomputes the
//// value from what it just read (`hits * 2 + 1`) is atomic on the BEAM, a
//// compare-and-swap retried when another process wrote between: `3`. It used to
//// be refused, the increment alone being atomic.

import {io.terminal.print} from "std";

#[compiler.beamMemory(.Ets)]
var hits: i32 = 1;

pub fn main() -> void {
    hits = hits * 2 + 1;
    print(hits);
}

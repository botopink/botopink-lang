type Box<T>(value: T) {
    pub fn get(self: Self<T>) -> T {
        return self.value;
    }
    pub fn map<U>(self: Self<T>, f: fn(x: T) -> U) -> Self<U> {
        return Box(value: f(self.value));
    }
}

fn main() {
    val b: Box<string> = Box(value: 1).map({ x -> "one" });
    @print(b.get());
}

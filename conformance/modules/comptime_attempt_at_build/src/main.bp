//// Decisions 518, 543 — std's `failure.attempt` answers at build as in a wasm
//// program: a `comptime` body that calls it gets `Ok` of the thunk's value,
//// or `Error(Failure(message, "panic"))` for the abort the thunk raised — the
//// same text on every target. It was refused at build while the comptime
//// engine (wasm3) had no exception handling.

import {failure, failure.Failure} from "std";

fn explode() -> i32 {
    @panic("the body exploded");
}

fn describe(r: @Result<i32, Failure>) -> string {
    case r {
        Ok(v) -> return "Ok " + v.toString();
        Error(f) -> return "Error " + f.kind + ": " + f.message;
    }
}

pub fn main() {
    val caught = comptime describe(failure.attempt({ -> explode() }));
    val answered = comptime describe(failure.attempt({ -> 6 * 7 }));
    @print(caught);
    @print(answered);
}

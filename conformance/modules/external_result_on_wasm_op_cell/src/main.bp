//// Decision 491 — an `op:` cell is a wasm instruction, not a host call that
//// can fail, so `result:` beside `op:` is refused at the annotation.

#[@external(
    .Wasm(op: "f64.floor", result: true),
    .Node("Math.floor($0)"),
    .Erlang("float(floor($0))"),
)]
declare fn floor(x: f64) -> f64;

pub fn main() {
    @print(floor(2.5));
}

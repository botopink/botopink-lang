//// Decision 541 (2) — a bare `break` in a block `{ … }` or in a `case` arm's
//// block leaves the enclosing loop: the block is no closure.

fn firstBig(xs: i32[]) -> i32 {
    var found = 0;
    for (xs) { x ->
        {
            if (x > 2) {
                found = x;
                break;
            }
        }
    }
    return found;
}

fn sumUntilThree(xs: i32[]) -> i32 {
    var s = 0;
    var i = 0;
    while (i < xs.length) {
        val x = xs[i]!;
        i = i + 1;
        case x {
            3 { break; }
            _ { s = s + x; }
        }
    }
    return s;
}

pub fn main() {
    @print(firstBig([1, 2, 3, 4]));
    @print(sumUntilThree([1, 2, 3, 4, 5]));
}

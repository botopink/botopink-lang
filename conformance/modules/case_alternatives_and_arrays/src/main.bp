type Color { Red, Green, Blue }

fn warm(c: Color) -> bool {
    return case c {
        Red | Green -> true;
        Blue -> false;
    };
}

fn size(items: i32[]) -> string {
    return case items {
        [] -> "empty";
        [x] -> "one";
        [first, ..rest] -> "many";
    };
}

pub fn main() {
    @print(warm(Color.Red)); // true
    @print(warm(Color.Blue)); // false
    @print(size([])); // empty
    @print(size([1])); // one
    @print(size([1, 2, 3])); // many
}

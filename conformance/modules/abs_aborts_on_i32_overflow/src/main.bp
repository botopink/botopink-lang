//// Decision 496 — `abs` is declared per width: the lowest `i32` has no positive
//// counterpart in `i32`, so `lowest().abs()` aborts naming `abs` on `i32`.

import {io.terminal.print} from "std";

fn lowest() -> i32 {
    return -2147483647 - 1;
}

pub fn main() -> void {
    print((-5).abs());
    print(lowest().abs());
    print("unreachable");
}

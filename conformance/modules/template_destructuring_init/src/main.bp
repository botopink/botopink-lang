//// Decision 425 — a template call expands wherever an expression may stand:
//// as a destructuring initializer.

fn pair(expr q: string) -> #(i32, string) {
    return compiler.build(
        "#("
            + compiler.text(q).length.toString()
            + ", \""
            + compiler.text(q)
            + "\")",
    );
}

fn twice(expr q: string) -> string {
    return compiler.build("\"" + compiler.text(q) + compiler.text(q) + "\"");
}

pub fn main() {
    val #(n, text) = pair @`abc`;
    @print(n.toString() + " " + text + " " + twice @`z`);
}

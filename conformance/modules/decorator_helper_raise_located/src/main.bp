//// Decision 451 (3), 144 B-48 — a decorator body that calls a function of
//// its own module, which raises, is refused at the call that raised: the
//// `@panic` inside `requireShort`, the innermost of this module's calls the
//// raise leaves — not the helper's call in the body, not the annotation
//// `#[short]` that ran the body.

fn requireShort(name: string) -> string {
    if (name.length() > 3) @panic("too long: " + name);
    return name;
}

fn short(comptime decl: @Decl) {
    val n = requireShort(decl.name);
    @emit("pub fn tag() -> string { return \"" + n + "\"; }");
}

#[short]
type Point(x: i32, y: i32)

pub fn main() {
    @print(tag());
}

//// Decision 371 — `Decorator.same(other)` takes a `Decorator`: a decorator's
//// name or a `DeclAnnotation.decorator`. A string spelling the name is no
//// decorator — the comparison is by declaration, never by the name — and is
//// refused at the argument.

import {compiler} from "std";

fn serverOnly(syntax decl: unknown) {
    val _n = compiler.name(decl);
}

fn check(syntax decl: unknown) {
    compiler
        .annotations(decl)
        .forEach({ a ->
            if (a.decorator.same("serverOnly"))
                compiler.fail("server only", at: decl)
        });
}

#[check]
#[serverOnly]
fn Page() -> string {
    return "p";
}

pub fn main() {
    @print(Page());
}

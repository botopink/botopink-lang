//// 144 B-25 (proposed by its Conformance step; decisions 504, 121) — a
//// component whose body keeps a `try … catch` and then awaits a task the host
//// answers (`delay`) is a state machine through it: `load("x")` parses, waits
//// on the host and answers its value once the task settles; `load("")` takes
//// the `catch` value and waits the same way — the `catch` never leaves early.

import {async.delay} from "std";

type View(text: string) implement @Renderable

fn parse(s: string) -> @Result<i32, string> {
    if (s == "") throw "empty";
    return 7;
}

fn load(s: string) -> @Component<string> {
    val n = try parse(s) catch 1;
    val v = await delay(5, n * 2);
    return "loaded " + v.toString();
}

fn Page(s: string) -> @Component<View> {
    val r = use load(s);
    return View(text: r);
}

pub fn main() -> @Task<void> {
    val a = await Page("x");
    @print(a.text);
    val b = await Page("");
    @print(b.text);
}

//// Decision 567 — one decorator on two declarations where only one of its
//// members fails to type-check: one error, at the annotation of the one that
//// failed.

fn maker<T>(comptime decl: @Decl<T>) {
    if (decl.name == "Town")
        decl.addMember("code", fn(self: T) -> i32 {
            return self.nope;
        })
    else
        decl.addMember("code", fn(self: T) -> i32 {
            return 1;
        });
}

#[maker]
pub type City(name: string)

#[maker]
pub type Town(name: string)

pub fn main() {
    @print(City(name: "a").code());
}

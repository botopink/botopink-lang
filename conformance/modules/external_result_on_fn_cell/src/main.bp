//// Decision 491 — `result:` belongs to a host call that can fail. An `fn:`
//// cell binds a botopink function, which fails only through its own
//// `@Result`, so `result:` beside `fn:` is refused at the annotation.

fn absBody(x: i32) -> i32 {
    return if (x < 0) -x else x;
}

#[@External.Node(fn: absBody, result: true), @External.Erlang(fn: absBody), @External.Wasm(fn: absBody)]
declare fn magnitude(x: i32) -> i32;

pub fn main() {
    @print(magnitude(-3));
}

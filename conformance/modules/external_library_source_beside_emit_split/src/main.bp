//// Decision 575 (6) — a library's `compiler.implement` survives the module's
//// re-analysis when the text a decorator emits cannot be read on its own: the
//// two `@emit` calls make one declaration, so the module is re-analysed on its
//// source with the text spliced in, and `#[bif]` keeps its implementation.

import {compiler, io.terminal.print} from "std";

fn bif(syntax decl: unknown, comptime module: string) {
    compiler.implement(Implementation.Erlang(module + ":reverse($0)"));
}

fn greeting(syntax decl: unknown) {
    @emit("pub fn greeted() -> string {");
    @emit("return \"hi\"; }");
}

#[greeting]
fn anchor() {}

#[bif("lists")]
#[compiler.external(.JavaScript("[...$0].reverse()"), .Wasm(body: reverseBody))]
declare fn backwards(xs: i32[]) -> i32[];

fn reverseBody(xs: i32[]) -> i32[] {
    return xs.reverse();
}

pub fn main() {
    print(greeted());
    print(backwards([1, 2, 3]));
}

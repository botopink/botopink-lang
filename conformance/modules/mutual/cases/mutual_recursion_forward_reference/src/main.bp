//// The fixture of `modules/compiler-cli/tests/mutual_recursion.sh`, a cell since
//// 144 B-29 step H: `main` calls `isEven`, declared after it (a forward
//// reference), and `isEven` / `isOdd` call each other. Each has a bare-`if` base
//// case followed by the recursive tail call, so a backend that ends the function
//// in an else-less `if` statement's false branch answers wrongly.

import {io.terminal.print} from "std";

pub fn main() -> void {
    print(isEven(10));
    print(isOdd(10));
    print(isEven(7));
    print(isOdd(7));
}

fn isEven(n: i32) -> bool {
    if (n == 0) return true;
    return isOdd(n - 1);
}

fn isOdd(n: i32) -> bool {
    if (n == 0) return false;
    return isEven(n - 1);
}

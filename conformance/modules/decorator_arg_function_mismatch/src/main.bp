//// Decision 280 (1), (2), example 1 — `rule` is an `fn(v: T) -> bool` with
//// `T` the annotated type: a function over another type is refused at the
//// argument, both types spelled.

import {types.Type, compiler, io.terminal.print} from "std";

pub type Code { Custom, Mismatch }

fn check<T>(
    syntax decl: T,
    comptime message: string,
    comptime rule: ?fn(v: T) -> bool = null,
    comptime at: ?Type.Field<T> = null,
    comptime code: Code = .Custom,
) {
    compiler.setMeta(Check(message: message));
}

type Order(total: i32)

fn orderTotal(o: Order) -> bool {
    return o.total > 0;
}

#[check("no total", orderTotal)]
type Account(password: string, confirm: string)

pub fn main() {
    print("unreached");
}

// What `#[check]` records.
type Check(message: string)

//// Decision 105 — `yield :label` names the generator scope it feeds (a fn's
//// signature label, an annotated loop's), never a plain loop: a loop has no
//// array to feed any more.

import {io.terminal.print} from "std";

iter fn doubled(xs: i32[]) -> Iter<i32> :out {
    for :inner (xs) { x ->
        yield :inner x * 2;
    }
}

pub fn main() -> void {
    print(1);
}

//// Decision 216 (4) — the query is written with its labels:
//// `@TypeInfo.all(with: d)` or `@TypeInfo.all(with: d, member: "m")`.

fn tagged(expr decl: unknown) {
    compiler.setMeta(Tagged(tag: compiler.name(decl)!));
}

pub fn main() {
    @print(@TypeInfo.all(tagged).length);
}

// What `#[tagged]` records.
type Tagged(tag: string)

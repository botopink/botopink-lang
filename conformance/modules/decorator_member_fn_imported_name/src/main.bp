//// Decision 384 — a member a decorator of another module writes resolves
//// each name where it was written: `Violation` and the private
//// `defaultMessage` in `rules`, the rule `passwordsMatch` here, where the
//// annotation wrote it. The user imports nothing beyond `check`, and this
//// module's own `defaultMessage` is never captured (a same-named TYPE is
//// `decorator_member_type_same_name`, decision 310's gap).

pub mod rules;
import {rules.check};

fn defaultMessage(field: string) -> string {
    return "user " + field;
}

fn passwordsMatch(a: Signup) -> bool {
    return a.password == a.confirm;
}

#[check(passwordsMatch)]
pub type Signup(password: string, confirm: string)

pub fn main() {
    val vs = Signup(password: "a", confirm: "b").validate();
    @print(vs.length);
    for (vs) { v ->
        @print(v.field + ": " + v.message);
    }
    @print(Signup(password: "a", confirm: "a").validate().length);
    @print(defaultMessage("x"));
}

//// Decision 95 — the chain grants downwards, never upwards. `@ResultGenerator`
//// implements `@Result`, so a `#[@resultGenerator]` body answers `try`; it does not
//// implement `@Future`, so `await` is one level above it and is refused,
//// located, naming the level it would need (decision 67 — no flag).

fn fetch(n: i32) -> @Task<i32> { return n; }

fn bad(n: i32) -> @Iterator<i32> {
    val w = await fetch(n);
    yield w;
}

pub fn main() { @print(1); }

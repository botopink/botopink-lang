//// Decision 316 — `decl.wrapWith(f)` wraps the call of a function or a
//// method: from a decorator on a `type` it is refused at the annotation (a
//// type has no call to wrap).

import {compiler} from "std";

fn traced(expr decl: unknown) {
    compiler.wrapWith({ call -> call.run() });
}

#[traced]
pub type City(name: string)

pub fn main() {
    @print(City(name: "Recife").name);
}

//// Decisions 370 (1), 576 (12) — a meta record's field is written `T`: it
//// holds a tree when an `expr` fills it, and a value otherwise. A literal
//// written in the decorator's body fills a `string` field as any value does.

import {compiler} from "std";

pub type Check(message: string)

fn check(expr decl: unknown) {
    compiler.addMeta(Check(message: "fixed"));
}

#[check]
type Signup(handle: string)

pub fn main() {
    @print(@typeInfo(Signup).metaAll(Check).length);
}

//// 1.0.10-beta `00 · 15-language-surface` step 3 — there is no character
//// literal; `'a'` is written `"a"`. The lexer scans `'…'` as one token so the
//// parser refuses it by name (it used to be an unnamed lexer error).

import {io.terminal.print} from "std";

pub fn main() -> void {
    val c = 'a';
    print(c);
}

//// `x != null || x.v` — the right operand of `||` runs only where the left one
//// FAILED, which is where `x` is `null`: nothing narrows it, and the read is
//// the optional-member error.

import {io.terminal.print} from "std";

type Node(v: i32)

fn f(x: ?Node) -> bool {
    return x != null || x.v > 0;
}

pub fn main() -> void {
    print(f(null));
}

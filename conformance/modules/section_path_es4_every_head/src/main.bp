//// ES4 with nothing to choose by: two enums carry a section `Color`, neither
//// has the path, and no type is expected. The refusal names both, sorted,
//// instead of whichever the type table's walk met first.

type Token  { Color { Red { 100, 500 } } }
type Border { Color { Blue { 100 } } }

pub fn main() {
    val a = .Color.Green.100;
    @print(0);
}

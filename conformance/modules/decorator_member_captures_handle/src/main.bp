//// Decision 370 (2) — the `@Decl` handle exists only while the program
//// compiles: a member function reading it is refused at the read.

import {compiler} from "std";

fn named(syntax decl: unknown) {
    compiler.addMember("typeName", fn() -> string {
        return compiler.name(decl)!;
    });
}

#[named]
pub type Signup(password: string, confirm: string)

pub fn main() {
    @print(Signup.typeName());
}

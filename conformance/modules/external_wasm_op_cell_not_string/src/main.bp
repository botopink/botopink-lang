//// Decision 481 — `op:` names a wasm opcode by its text, a string: a bare name
//// is refused at the argument, on every target, naming the string form.

#[@external(.JavaScript("Math.floor($0)"), .Erlang("math:floor($0)"), .Wasm(op: floor))]
pub declare fn floorOf(x: f64) -> f64;

pub fn main() {
    @print(floorOf(2.7));
}

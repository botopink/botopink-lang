import {types.Type, compiler} from "std";

type Level { Low, High }

fn index<T>(
    expr decl: T,
    comptime ..fields: Type.Field<T>[],
) {
    compiler.setMeta(Index(columns: fields.map({ f -> f.name })));
}

fn mark(
    expr decl: unknown,
    comptime sizes: i32[],
    comptime level: Level = .Low,
) {
    compiler.setMeta(
        Mark(
            sizes: sizes.length,
            level: if (level == Level.High) "high" else "low",
        ),
    );
}

#[index(.state, .name)]
#[mark([1, 2], level: .High)]
type City(code: string, name: string, state: string)

fn main() {
    val columns: string[] = @typeInfo(City).meta(Index)?.columns ?? [];
    @print(columns.join(",")); // state,name
    @print(@typeInfo(City).meta(Mark)?.sizes ?? 0); // 2
    @print(@typeInfo(City).meta(Mark)?.level ?? "none"); // high
}

// What `#[index]` records.
type Index(columns: string[])

// What `#[mark]` records.
type Mark(sizes: i32, level: string)

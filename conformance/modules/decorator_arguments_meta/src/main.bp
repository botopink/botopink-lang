import {types.Type} from "std";

type Level { Low, High }

fn index<T>(
    comptime decl: @Decl<T>,
    comptime ..fields: @Expr<Type.Field<T>[]>,
) {
    decl.setMeta(Index(columns: fields.value.map({ f -> f.name })));
}

fn mark(
    comptime decl: @Decl,
    comptime sizes: @Expr<i32[]>,
    comptime level: @Expr<Level> = .Low,
) {
    decl.setMeta(
        Mark(
            sizes: sizes.value.length,
            level: if (level.value == Level.High) "high" else "low",
        ),
    );
}

#[index(.state, .name)]
#[mark([1, 2], level: .High)]
type City(code: string, name: string, state: string)

fn main() {
    val columns: string[] = @typeInfo(City).meta(Index)?.columns ?? [];
    @print(columns.join(",")); // state,name
    @print(@typeInfo(City).meta(Mark)?.sizes ?? 0); // 2
    @print(@typeInfo(City).meta(Mark)?.level ?? "none"); // high
}

// What `#[index]` records.
type Index(columns: string[])

// What `#[mark]` records.
type Mark(sizes: i32, level: string)

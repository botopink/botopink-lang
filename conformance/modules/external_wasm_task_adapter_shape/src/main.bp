//// Decision 393 — an adapter answering `@Task<T>` is checked by shape at the
//// annotation: `wasi: .Delay` is `(i32, T) -> @Task<T>` over one type parameter,
//// and a declaration of another shape is refused there on every target
//// (decision 238: the binding is read whatever the build's target), though
//// the other targets bind their own templates.

#[@External.Node("""((__ms, __v) => new Promise((__r) => setTimeout(() => __r(__v), __ms)))($0, $1)""")]
#[@External.Erlang("""(fun(__M, __V) -> timer:sleep(__M), __V end)($0, $1)""")]
#[@External.Wasm(wasi: .Delay)]
declare fn later(millis: i32, value: string) -> @Task<string>;

fn run() -> @Task<void> {
    @print(await later(1, "done"));
}

pub fn main() {
    run();
}

//// Decision 216 (3) — an associated type is named like a type: one
//// identifier starting with an upper-case letter (`City.Columns`), refused
//// at the annotation otherwise.

import {compiler} from "std";

fn entity(syntax decl: unknown) {
    compiler.addType("columns", compiler.buildType("(id: string)"));
}

#[entity]
type City(id: i32)

pub fn main() {
    @print(City(id: 1).id);
}

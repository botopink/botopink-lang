//// An annotation `#[name]` whose `name` resolves to a namespace — a module of
//// the package — used to be dropped without a word. `check` is a module: the
//// annotation is refused where it is written, naming that it is a namespace.

pub mod check;

#[check]
pub fn run() -> i32 {
    return 1;
}

pub fn main() {
    @print(run());
}

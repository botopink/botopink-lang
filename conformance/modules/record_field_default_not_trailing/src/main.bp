//// Decision 244 — a default is trailing everywhere. A record's field without a
//// default after one with a default is refused at that field, as a free
//// `fn`'s parameter is (`fn-param-default-trailing-only`).

type Port(number: i32 = 80, host: string)

pub fn main() {
    @print(Port(host: "a").number);
}

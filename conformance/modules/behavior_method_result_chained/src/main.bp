//// A method called on a value typed by a behavior answers the type the
//// behavior declares, so a primitive method chained on its result lowers as
//// that primitive's: inference typed the call as a fresh variable, and
//// commonJS emitted `x.name().length()` as a call of JavaScript's `length`
//// PROPERTY (`length is not a function`), wasm found no lowering for
//// `toUpper` / `toString` and trapped. A mismatch against the declared type is
//// now a type error where it passed.

behavior Named {
    fn name(self: Self) -> string;
    fn size(self: Self) -> i32;
}

type Dog(n: string) implement Named {
    fn name(self: Self) -> string {
        return self.n;
    }

    fn size(self: Self) -> i32 {
        return 3;
    }
}

fn show(x: Named) {
    @print(x.name().length());
    @print(x.name().toUpper());
    @print(x.size().toString());
    @print(x.size() + 1);
}

pub fn main() {
    show(Dog(n: "rex"));
}

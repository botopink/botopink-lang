//// An `f64` reaching a generic body as its type parameter is written as text
//// with its decimal part on every target (decision 521): in a template hole,
//// beside a string in a `+`, through `@print` and `toString()`, inside an
//// array of the type parameter, read off a record's field at the call, and
//// handed on to another generic function. commonJS has one number type and a
//// generic body one JavaScript function, so the call hands that body the
//// shape of the type it binds; before it, `show(4.0)` answered `4` there.

type Pt(x: f64)

fn show<T>(x: T) -> string {
    return "${x}";
}

fn printIt<T>(x: T) {
    @print(x);
}

fn plus<T>(x: T) -> string {
    return "v=" + x;
}

fn describe<T>(x: T) -> string {
    return x.toString();
}

fn twice<T>(x: T) -> string {
    val xs: T[] = [x, x];
    @print(xs);
    return "${xs}";
}

fn handOn<T>(x: T) -> string {
    return show(x);
}

pub fn main() {
    @print(show(4.0));
    printIt(4.0);
    @print(plus(4.0));
    @print(describe(4.0));
    @print(twice(4.0));
    val p = Pt(x: 1.0);
    @print(show(p.x));
    @print(handOn(4.0));
    @print(show(4));
    @print(plus("s"));
}

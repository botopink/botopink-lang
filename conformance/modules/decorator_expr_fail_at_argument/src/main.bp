//// Decision 364 (3) — `x.fail("…")` in a decorator reports at `x`'s
//// argument, not at the annotation: the upper bound below the lower one is
//// refused at the `1`.

import {compiler} from "std";

fn sizeBetween(expr decl: unknown, comptime min: i32, comptime max: i32) {
    if (min > max) compiler.fail("the upper bound is below the lower one", at: max);
}

type Form(
    #[sizeBetween(5, 1)] name: string,
)

pub fn main() {
    @print("unreached");
}

//// Decisions 359, 37, 529 (3) — `Name(..src, f: v)`, the one spelling of a
//// record's spread, builds a new record with the labelled fields replaced and
//// the rest read from the source, whatever order the labels are written in
//// (question B-14-a as built).

import {io.terminal.print} from "std";

type Pessoa(nome: string, idade: i32)

pub fn main() {
    val ana = Pessoa(nome: "Ana", idade: 3);
    val a = Pessoa(..ana, nome: "Bia");
    val b = Pessoa(..ana, idade: 3, nome: "Bia");
    print(a);
    print(b);
    print(a == b);
}

import {compiler} from "std";

type Element(text: string) implement Renderable

fn graph(syntax decl: unknown) -> void {
    var names: string[] = [];
    compiler
        .hooks(decl)
        .forEach(
            { n -> names.push(n.function.name + "/" + n.uses.length.toString()) },
        );
    compiler.setMeta(Graph(nodes: names));
}

component fn session() -> Component<string> {
    return "alice";
}

component fn user() -> Component<string> {
    val s = use session();
    return "user " + s;
}

#[graph]
pub component fn Page() -> Component<Element> {
    val u = use user();
    return Element(text: u);
}

// What `#[graph]` records: one rendered node per entry of `decl.hooks`.
pub type Graph(nodes: string[])

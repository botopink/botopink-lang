//// A statement `case` arm whose block ends in a `for` runs that arm only — on
//// commonJS it fell into the next arm, running both (front 121's gap).

import {io.terminal.print} from "std";

type Node {
    Many(vs: i32[]),
    One(v: i32),
}

fn flatten(ns: Node[]) -> i32[] {
    var out: i32[] = [];
    for n in ns {
        case n {
            Many(vs) {
                val items: i32[] = vs;
                for k in items {
                    out.push(k);
                }
            }
            _ {
                out.push(0 - 1);
            }
        }
    }
    return out;
}

fn tagged(n: i32) -> string[] {
    var out: string[] = [];
    case n {
        1 {
            out.push("one");
            for k in [1, 2] {
                out.push(k.toString());
            }
        }
        2 {
            for k in [3] {
                out.push(k.toString());
            }
        }
        _ {
            out.push("other");
        }
    }
    return out;
}

pub fn runCase() -> void {
    print(flatten([Node.Many(vs: [1, 2]), Node.One(v: 5), Node.Many(vs: [])]));
    print(tagged(1));
    print(tagged(2));
    print(tagged(3));
}

import {io.terminal.print} from "std";

fn bucket(n: i32) -> string {
    return case n {
        1...9 {
            "digit"
        }
        _ when (n < 0) {
            "negative"
        }
        _ {
            "other"
        }
    };
}

pub fn main() -> void {
    print(bucket(5)); // digit
    print(bucket(-1)); // negative
    print(bucket(42)); // other
}

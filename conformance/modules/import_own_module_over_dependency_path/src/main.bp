//// The boundary of `import_sibling_path_beside_std_name`. A source is read as
//// a full module path first, and only then as a path below a package's root:
//// `from "app/page"` in the project is the project's own `app/page`, although
//// the dependency `site` has a module of the same relative path
//// (`site/app/page`) declaring `title` too. Read both ways at once, the two
//// would tie and the import that names its module by its full path would be
//// refused as `ambiguous-import-use`.

pub mod app;

import {app.page.title};
import {other} from "site";

pub fn main() {
    @print(title());
    @print(other());
}

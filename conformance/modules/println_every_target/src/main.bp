//// `@println` ends its line on every target, as `@print` does: one argument,
//// several arguments separated by a space, and an expression. The wasm
//// backend had no lowering for it (`144 B-35`).

import {io.terminal.print} from "std";

pub fn main() {
    print("hello");
    print("a", 1, true);
    print(2 * 21);
    print(2.5);
}

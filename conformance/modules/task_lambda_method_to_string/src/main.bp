//// A lambda a method answers types its parameter from the method's declared
//// return type, so `n.toString()` inside it resolves — as it does in a lambda
//// bound inside a function.

type Worker(id: i32) {
    fn lazyStart(self: Self) -> fn(n: i32) -> @Task<@Result<i32, string>> {
        return { n ->
            async {
                if (n < 0) throw "negative " + n.toString();
                return n + 10;
            }
        };
    }
}

fn show(r: @Result<i32, string>) {
    case r {
        Ok(v) -> @print("ok", v);
        Error(e) -> @print("error", e);
    }
}

fn run() -> @Task<void> {
    val w = Worker(id: 10);
    val later = w.lazyStart();
    show(await later(2));
    show(await later(-2));
}

pub fn main() {
    run();
}

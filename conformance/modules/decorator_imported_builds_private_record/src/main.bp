//// A decorator imported from another module whose body builds a record
//// private to its module runs where it annotates: the evaluator reaches the
//// record through the decorator's own module, not through what it exports
//// (144 B-19). The meta it recorded is read here, typed and by key.

pub mod orm;
import {orm.entity, orm.Entity};

#[entity("cities")]
type City(name: string)

pub fn main() {
    @print(@typeInfo(City).meta(Entity)?.table ?? "none");
    @print(@typeInfo(City).meta.entity.table);
}

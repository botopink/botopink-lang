//// An unsigned integer compares, divides and takes a remainder as the
//// unsigned value it holds — a `u32` above 2^31 and a `u64` above 2^63 are
//// greater than a small one, not negative — on every target. wasm read
//// both with the signed opcodes (`i32.gt_s`, `i32.div_s`, `i64.lt_s`) and
//// answered at exit 0 as if the high bit were a sign. (`u64`'s `%` is
//// `codegen/tests/wat.zig`'s: commonJS refuses it at run time, `04-js`'s row.)

fn bigger(a: u32, b: u32) -> u32 {
    if (a > b) return a;
    return b;
}

pub fn main() {
    val a: u32 = 3000000000;
    val b: u32 = 7;
    @print(a > b);
    @print(a < b);
    @print(a >= b);
    @print(b <= a);
    @print(a / b);
    @print(a % b);
    @print(bigger(b, a));
    val w: u64 = 10000000000000000000;
    val v: u64 = 3000000000000000000;
    @print(w > v);
    @print(v < w);
    @print(w / v);
}

//// The `run/` twin of `test/program_primitive_behavior_extends_std.bp`, so
//// wasm and beam run it too (`botopink test` runs neither): a program's own
//// contract implemented for `string` (decision 799) and its own
//// `behavior Number` extend std's members — their default fns call std's
//// members on `self` (the contract declares the ones it calls, and `string`'s
//// own members meet them), typed as the primitive, and std's members still
//// answer beside them. wasm trapped on every program-declared default fn of a
//// primitive (`prim method not lowered on wasm`); it calls a copy of the
//// default with `Self` written as the receiver's primitive.

import {io.terminal.print} from "std";

behavior Shout {
    fn slice(self: Self, start: i32, end: ?i32 = null) -> string;

    fn length(self: Self) -> i32;

    default fn tailShout(self: Self) -> string {
        val tail = self.slice(1);
        return if (tail.startsWith("+")) tail.toUpper() else tail;
    }

    default fn twiceLen(self: Self) -> i32 {
        return self.length() * 2;
    }
}

StringShout implement Shout for string {};

behavior Number {
    default fn clampTo(self: Self, lo: Self, hi: Self) -> Self {
        return self.max(lo).min(hi);
    }
}

pub fn runCase() -> void {
    print("a+b".tailShout());
    print("ab".tailShout());
    print("abc".twiceLen());
    val word = "x+yz";
    print(word.tailShout().length());
    print("x".startsWith("x"));
    print("ab".slice(1));
    val n: i32 = 50;
    print(n.clampTo(0, 10));
    print(3.clampTo(5, 9));
}

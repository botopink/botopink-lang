//// Decision 308 — a `case` over a `Type.Field<T>` is exhaustive over `T`'s
//// fields: one without an arm for `.servings` (and no `_`) is refused at the
//// `case`, naming it.

import {types.Type} from "std";

type Recipe(title: string, description: ?string, servings: i32)

val RecipeKey = Type.keys(Recipe);

fn describe(r: Recipe, key: RecipeKey) -> string {
    return case key {
        .title -> r.title;
        .description -> r.description ?? "-";
    };
}

pub fn main() {
    @print(describe(Recipe(title: "a", description: null, servings: 1), .title));
}

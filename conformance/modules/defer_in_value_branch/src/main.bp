//// Decision 539 (1) — a `defer` is built wherever a block is: in an `if`
//// branch that answers a value, in a `case` arm that answers one, and in
//// a lambda a higher-order function runs.

import {io.terminal.print} from "std";

fn pick(c: bool) -> i32 {
    val r = if (c) {
        defer print("then closed");
        10;
    } else {
        defer print("else closed");
        20;
    };
    return r + 1;
}

fn arm(n: i32) -> i32 {
    val r = case n {
        0 {
            defer print("zero closed");
            100
        }
        _ {
            defer print("other closed");
            200
        }
    };
    return r;
}

pub fn main() {
    print(pick(true).toString());
    print(pick(false).toString());
    print(arm(0).toString());
    print(arm(1).toString());
    val xs = [1, 2].map({ x ->
        defer print("lambda " + x.toString());
        x * 2
    });
    print(xs.length.toString());
}

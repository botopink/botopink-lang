//// Decisions 298, 302 — inside an annotation `decl.meta(T)` is refused
//// (question B-15-c, as built): a declaration's or a tag's meta is read by
//// the code that consumes it, after every annotation ran — a template body
//// over the `@Decl` `q.annotate` answered, `@typeInfo(X).meta(T)` — so
//// annotations do not depend on their written order. `checked` reads the
//// meta `level` recorded before it on the same tag: refused at the read.

pub type Level(n: i32)

pub fn level(comptime decl: @Decl, comptime n: @Expr<i32>) {
    decl.setMeta(Level(n: n.value));
}

// Reads the meta the earlier annotation recorded on the same tag.
pub fn checked(comptime decl: @Decl) {
    if (decl.meta(Level) == null) decl.fail("no level");
}

pub fn markup(comptime q: @Expr<string>) -> @Expr<string> {
    val text = q.text();
    val firstStart = text.indexOf("#[") + 2;
    val firstEnd = text.indexOf("]");
    val rest = text.slice(firstEnd + 1, text.length);
    val secondStart = firstEnd + 1 + rest.indexOf("#[") + 2;
    val secondEnd = firstEnd + 1 + rest.indexOf("]");
    val tag = q.tagDecl(DeclKind.Element, "div", []);
    val once = q.annotate(tag, Span(start: firstStart, end: firstEnd, line: 1));
    val twice = q.annotate(once, Span(start: secondStart, end: secondEnd, line: 1));
    return @expr(twice.meta(Level)?.n ?? 0);
}

pub fn main() {
    @print(markup "<div #[level(2)] #[checked]>hi</div>");
}

//// The library half of `decl_hooks_imported`: a marker decorator, a hook it
//// annotates and a component that reads the hook. Its nodes are published
//// when this module's analysis ends and read by the importer's decorator.

pub type Element(text: string) implement @Renderable

// A marker: it reads nothing, and a decorator that reads `decl.hooks` finds
// it among a hook's annotations.
pub fn tracked(comptime decl: @Decl) {
    val _n = decl.name;
}

#[tracked]
pub fn session() -> @Component<string> {
    return "alice";
}

pub fn Avatar() -> @Component<Element> {
    val s = use session();
    return Element(text: "avatar " + s);
}

//// A template function that builds a call of the function its literal
//// names, each `key=value` pair a labelled argument — the shape a markup
//// template's `<Greeting name="Partner" />` lowers to.

pub fn tag(comptime q: @Expr<string>) -> @Expr<string> {
    var text = "";
    for (q.parts()) { p ->
        if (p.kind != "Interp") text = text + p.text;
    }
    val words = text.split(" ");
    var args: string[] = [];
    for (words.slice(1, words.length)) { w ->
        val kv = w.split("=");
        args.push(kv.slice(0, 1).join("")
            + ": \""
            + kv.slice(1, 2).join("")
            + "\"");
    }
    return q.build(words.slice(0, 1).join("") + "(" + args.join(", ") + ")");
}

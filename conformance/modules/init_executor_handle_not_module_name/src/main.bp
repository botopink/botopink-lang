//// Decision 613 — the splice names the annotated declaration, never what
//// its bare name resolves to in the module: the method `Users.make` is
//// registered, not the module's own `fn make` beside it.

pub mod marks;
pub mod registry;
import {marks.registered};
import {registry.all};

pub fn make() -> string {
    return "module make";
}

pub type Users() {
    #[registered]
    pub fn make() -> string {
        return "users made";
    }
}

pub fn main() {
    for (all()) { e ->
        @print(e.name + " " + e.make());
    }
    @print(make());
}

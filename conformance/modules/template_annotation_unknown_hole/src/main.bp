//// Decision 311 — a `${…}` hole of a template annotation resolves in the
//// annotated declaration's scope: on a method, its parameters by name and
//// type. A name the method does not declare is the ordinary unbound-name
//// error at the hole.

type Query(sql: string)

fn sql(expr q: string, expr decl: unknown) -> string {
    compiler.addMember(
        "pub fn "
            + compiler.name(decl)!
            + "Text() -> string { return \""
            + compiler.text(q)
            + "\"; }",
    );
    return compiler.build("\"\"");
}

type Users(n: i32) {
    #[sql @`select * from users where id = ${userId}`]
    pub fn find(self: Self, id: i32) -> i32 {
        return id + self.n;
    }
}

pub fn main() {
    @print(Users(n: 1).find(2).toString());
}

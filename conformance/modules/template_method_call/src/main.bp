//// Decisions 311 (3), 397 (3), 415 (1) — a template method: a function whose
//// first parameter is `comptime self: @Expr<R>` and whose second is
//// `comptime q: @Expr<…>`, called `value.method "…"` / `value.method """…"""`
//// as `f "…"` is. The literal is captured unevaluated; `self` is the call
//// site's code for the receiver (`self.text()`), so the code the template
//// builds runs on the receiver where the call stands.

mod store;
import {store.Store, store.read};

behavior Named {
    fn name(self: Self) -> string;
}

type Greeter(who: string) implement Named {
    fn name(self: Self) -> string {
        return self.who;
    }

    pub fn greet(self: Self, word: string) -> string {
        return word + ", " + self.who;
    }
}

fn shout(comptime self: @Expr<Greeter>, comptime q: @Expr<string>) -> @Expr<string> {
    return q.build(self.text() + ".greet(\"" + q.text().toUpper() + "\")");
}

fn tag(comptime self: @Expr<Named>, comptime q: @Expr<string>) -> @Expr<string> {
    return q.build("\"[" + q.text() + "] \" + " + self.text() + ".name()");
}

type Room(host: Greeter) {
    pub fn open(self: Self) -> string {
        return self.host.shout "welcome";
    }
}

type Memory(prefix: string) implement Store<string> {
    fn fetch(self: Self, key: string) -> @Result<string, string> {
        if (key == "") throw "empty key";
        return self.prefix + key;
    }
}

type Report(db: Memory) {
    pub fn title(self: Self) -> @Result<string, string> {
        return self.db.read "title";
    }
}

pub fn main() {
    val g = Greeter(who: "Ana");
    @print(g.shout "hello");
    @print(g.tag """vip""");
    @print(Room(host: Greeter(who: "Bia")).open());
    @print(g.tag "guest");
    val mem = Memory(prefix: "m:");
    @print(try mem.read "a" catch "none");
    @print(try Report(db: mem).title() catch "none");
    @print(try mem.read "" catch "none");
}

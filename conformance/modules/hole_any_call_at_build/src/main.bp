//// Decisions 355, 380 as decision 577 (5) amends them — `rule` parses the
//// `${…}` holes of its text itself and splices each expression into the
//// `Rule` it builds: a call of an `Any` function, a `val` and a parameter
//// alike. `stamp` reads std's clock (`Run`) and `loud` prints.

import {io.clock} from "std";

pub type Rule(text: string)

pub fn textOf(v: string | Rule) -> string {
    if (v is Rule) return v.text;
    if (v is string) return v;
    return "";
}

fn quoted(text: string) -> string {
    return "\"" + text + "\"";
}

// The text's `${…}` holes are the template's own syntax (decision 577 (1)):
// the code `"" + "<text>" + textOf(<hole>) + …`, each hole's expression
// spliced as written and typed where the call stands (14s8-a (e)).
fn spliced(text: string) -> string {
    var code = "\"\"";
    var first = true;
    for (text.split("\${")) { piece ->
        if (first) {
            code = code + " + " + quoted(piece);
            first = false;
        } else {
            val close = piece.indexOf("}");
            code = code
                + " + textOf("
                + piece.slice(0, close)
                + ") + "
                + quoted(piece.slice(close + 1));
        }
    }
    return code;
}

pub fn rule(expr t: string) -> Rule {
    return compiler.build("Rule(text: " + spliced(compiler.text(t)) + ")");
}

pub val ESPACO = 2;

fn unit() -> i32 {
    return 4;
}

fn padAll(n: i32) -> string {
    return "padding: " + (n * unit()).toString() + "px;";
}

fn stamp(n: i32) -> string {
    return if (clock.nowMillis() > 0) "t" + n.toString() else "never";
}

fn loud(n: i32) -> string {
    @print("loud");
    return n.toString();
}

pub val literal = rule @`${padAll(2)}`;

pub val named = rule @`${padAll(ESPACO)}`;

pub val p = padAll(ESPACO * 2);

pub val throughVal = rule @`${p} margin: 0;`;

pub val ran = rule @`${stamp(1)}`;

pub val printed = rule @`${loud(3)}`;

fn param(n: i32) -> Rule {
    return rule @`${padAll(n)}`;
}

fn show(r: Rule) {
    @print(r.text);
}

pub fn main() {
    show(literal);
    show(named);
    show(throughVal);
    show(param(1));
    show(ran);
    show(printed);
}

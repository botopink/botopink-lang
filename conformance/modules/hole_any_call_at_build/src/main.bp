//// Decisions 355, 380 — a call of an `Any` function (376) whose arguments
//// are known at build is known at build, in a hole and in a `val`'s
//// initializer: `rule` writes the text into the code (`at: "build"`) for
//// `${padAll(2)}`, `${padAll(ESPACO)}` and `${p}` (`p = padAll(ESPACO * 2)`),
//// and leaves `${padAll(n)}`, `n` a parameter, to the program
//// (`at: "render"`). `stamp` reads std's clock (`Run`) and `loud` prints:
//// neither is computed at build.

import {io.clock} from "std";

pub type Rule(text: string, at: string)

// What a hole puts in the text, read twice by the template: as a string and
// as a `Rule`.
fn buildText(v: string, r: Rule) -> string {
    if (v is string) return v;
    return r.text;
}

pub fn textOf(v: string | Rule) -> string {
    if (v is Rule) return v.text;
    if (v is string) return v;
    return "";
}

fn quoted(text: string) -> string {
    return "\"" + text + "\"";
}

pub fn rule(expr t: string) -> Rule {
    var built = "";
    var computed = "\"\"";
    var known = true;
    for (compiler.parts(t)) { part ->
        if (part.kind == "Interp") {
            if (part.known)
                built = built + buildText(part.value, part.value)
            else
                known = false;
            computed = computed + " + textOf(" + part.code + ")";
        } else {
            built = built + part.text;
            computed = computed + " + " + quoted(part.text);
        }
    }
    if (known)
        return compiler.build("Rule(text: "
            + quoted(built)
            + ", at: \"build\")");
    return compiler.build("Rule(text: " + computed + ", at: \"render\")");
}

pub val ESPACO = 2;

fn unit() -> i32 {
    return 4;
}

fn padAll(n: i32) -> string {
    return "padding: " + (n * unit()).toString() + "px;";
}

fn stamp(n: i32) -> string {
    return if (clock.nowMillis() > 0) "t" + n.toString() else "never";
}

fn loud(n: i32) -> string {
    @print("loud");
    return n.toString();
}

pub val literal = rule @`${padAll(2)}`;

pub val named = rule @`${padAll(ESPACO)}`;

pub val p = padAll(ESPACO * 2);

pub val throughVal = rule @`${p} margin: 0;`;

pub val ran = rule @`${stamp(1)}`;

pub val printed = rule @`${loud(3)}`;

fn param(n: i32) -> Rule {
    return rule @`${padAll(n)}`;
}

fn show(r: Rule) {
    @print(r.at + " " + r.text);
}

pub fn main() {
    show(literal);
    show(named);
    show(throughVal);
    show(param(1));
    show(ran);
    show(printed);
}

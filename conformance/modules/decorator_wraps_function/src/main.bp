//// Decision 316 — a decorator wraps the function it annotates:
//// `decl.wrapWith({ call -> … })`. The wrapper receives the call — its
//// arguments, `call.args`, and the original body, `call.run()` — and answers
//// the function's return type. The function keeps its name and signature; a
//// call of it, here or in an importer, runs the wrapper.
////
//// A counting wrapper (`#[counted]`, on a function and on a method), a cache
//// wrapper (`#[cached]`: the body runs once per argument) and two composed
//// (`#[tagged("*")] #[tagged("-")]`, the first written outermost).

pub mod wraps;
pub mod shop;
import {wraps.countedHits};
import {shop.post, shop.postLoads, shop.greet, shop.title, shop.Shelf};

pub fn main() {
    @print(greet("ana"));
    @print(greet("bia"));
    @print(countedHits());
    @print(Shelf(label: "books").describe(3));
    @print(countedHits());

    @print(post(1));
    @print(post(2));
    @print(post(1));
    @print(postLoads());

    @print(title());
}

//// The wrapping decorators live in a module of their own: a wrapper reads
//// its decorator's parameters, spliced, and the names of this module — the
//// store `cacheThrough` keeps — wherever the wrapped function is declared.

var hits: i32 = 0;
var keys: i32[] = [];
var values: string[] = [];

/// How many times a `#[counted]` function ran.
pub fn countedHits() -> i32 {
    return hits;
}

fn noteHit() {
    hits = hits + 1;
}

/// Counts every call of the function it annotates, whatever its parameters.
pub fn counted(comptime decl: @Decl<fn(..) -> string>) {
    decl.wrapWith({ call ->
        noteHit();
        call.run()
    });
}

fn cacheThrough(key: i32, body: fn() -> string) -> string {
    val at = keys.indexOf(key);
    if (at >= 0) return "cached " + values[at];
    val fresh = body();
    keys.push(key);
    values.push(fresh);
    return fresh;
}

/// Runs the body once per argument; a later call with the same argument
/// answers what the first one stored.
pub fn cached(comptime decl: @Decl<fn(id: i32) -> string>) {
    decl.wrapWith({ call -> cacheThrough(call.args[0], { -> call.run() }) });
}

/// Puts the answer between two marks.
pub fn tagged(comptime decl: @Decl<fn(..) -> string>, comptime mark: @Expr<string>) {
    decl.wrapWith({ call -> mark + call.run() + mark });
}

//// Decision 355 as decision 577 (5) amends it — an imported template splices
//// each hole of its text: one naming a `val` ANOTHER module exports and one
//// naming a parameter alike.

pub mod rules;
import {rules.rule, rules.tab, rules.red};

pub val code = rule @`${tab} color: ${red};`;

fn badge(c: string) -> string {
    return rule @`${red} ${c}`;
}

pub fn main() {
    @print(tab);
    @print(code);
    @print(badge("green"));
}

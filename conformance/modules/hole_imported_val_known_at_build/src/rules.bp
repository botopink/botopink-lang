//// A template that parses the holes of its text and splices them, and the
//// `val`s it exports: a literal and an expansion.

fn quoted(text: string) -> string {
    return "\"" + text + "\"";
}

// The text's `${…}` holes are the template's own syntax (decision 577 (1)):
// the code `"" + "<text>" + (<hole>) + …`, each hole's expression
// spliced as written and typed where the call stands (14s8-a (e)).
fn spliced(text: string) -> string {
    var code = "\"\"";
    var first = true;
    for (text.split("\${")) { piece ->
        if (first) {
            code = code + " + " + quoted(piece);
            first = false;
        } else {
            val close = piece.indexOf("}");
            code = code
                + " + ("
                + piece.slice(0, close)
                + ") + "
                + quoted(piece.slice(close + 1));
        }
    }
    return code;
}

pub fn rule(expr t: string) -> string {
    return compiler.build(spliced(compiler.text(t)));
}

pub val red = "red";

pub val tab = rule @`tab-size: 4;`;

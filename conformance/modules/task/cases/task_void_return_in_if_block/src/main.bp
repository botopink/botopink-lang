//// A bare `return;` inside an `if` block of a `Async<void>` body leaves the
//// function: nothing after the block runs. The same one level deeper, and
//// in the `else` branch.
////
//// The erlang gap this pins (`00 · 02-erlang`): the statements after the
//// block still ran, so `early(true)` printed `after`.

import {io.terminal.print} from "std";

async fn early(stop: bool) -> Async<void> {
    if (stop) return;
    print("after");
}

async fn deeper(a: bool, b: bool) -> Async<void> {
    if (a) {
        if (b) return;
        print("a, not b");
    } else {
        print("not a");
        return;
    }
    print("end of deeper");
}

async fn run() -> Async<void> {
    await early(true);
    print("--");
    await early(false);
    print("--");
    await deeper(true, true);
    print("--");
    await deeper(true, false);
    print("--");
    await deeper(false, true);
}

pub async fn main() -> Async<void> {
    await run();
}

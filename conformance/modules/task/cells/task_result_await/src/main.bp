import {io.terminal.print} from "std";

type User(id: i32, name: string)

async fn fetchUser(id: i32) -> Async<Result<User, string>> {
    if (id <= 0)
        throw "no user " + id.toString(); // legal: the value is a Result
    return User(id: id, name: "ana"); // a Async holding Ok(…)
}

async fn greetingFor(id: i32) -> Async<Result<string, string>> {
    val u = try await fetchUser(
        id,
    ); // await answers the Result; try propagates it
    return "Hello, " + u.name;
}

async fn greetingOrGuest(id: i32) -> Async<string> {
    val u = try await fetchUser(id) catch User(id: 0, name: "guest");
    return "Hello, " + u.name; // no Result in the return: handled here
}

async fn describeUser(id: i32) -> Async<string> {
    val r = await fetchUser(id); // the Result itself
    return case r {
        Ok(u) -> u.name;
        Error(e) -> "error: " + e;
    };
}

pub async fn main() -> Async<void> {
    val g = await greetingFor(1);
    print(g.unwrapOr("none")); // Hello, ana
    print(await greetingOrGuest(0)); // Hello, guest
    print(await describeUser(1)); // ana
    print(await describeUser(0)); // error: no user 0
}

//// `String.charCodeAt(i)` answers the code point at code-point index `i` —
//// `-1` outside the string — for a string that is not ASCII. wasm read the
//// BYTE at byte offset `i` (`"héllo".charCodeAt(1)` was `195`, the first byte
//// of `é`, where commonJS, erlang and beam answered `233`). Characters of the
//// Basic Multilingual Plane only: past it Node's `codePointAt` indexes UTF-16
//// units.

pub fn main() {
    val s = "héllo";
    @print(s.charCodeAt(1));
    @print(s.charCodeAt(4));
    @print(s.charCodeAt(5));
    val jp = "日本語";
    @print(jp.charCodeAt(0));
    @print(jp.charCodeAt(2));
    @print(jp.charCodeAt(3));
    @print("A".charCodeAt(0));
}

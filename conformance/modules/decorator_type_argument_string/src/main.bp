//// Decisions 280 (1), 281, example 3 — a type is passed as itself, never by
//// its name as a string: `"MailSender"` against `comptime t: type` is refused
//// at the argument.

import {compiler} from "std";

pub behavior MailSender {
    fn send(self: Self, to: string) -> string;
}

fn conditionalOnMissingBean(expr decl: unknown, comptime t: anytype) {
    compiler.setMeta(MissingBean(bean: compiler.name(decl)!));
}

#[conditionalOnMissingBean("MailSender")]
fn consoleMail() -> string {
    return "console";
}

pub fn main() {
    @print(consoleMail());
}

// What `#[conditionalOnMissingBean]` records.
type MissingBean(bean: string)

//// A std decorator is reached through its module: the code it emits names
//// the module's functions through the handle its annotation is written with
//// (`#[mocks.mock]` emits `mocks.invoke(…)`), and a leaf import leaves it none.

import {testing.mocks.mock, io.terminal.print} from "std";

pub fn main() -> void {
    print(0);
}

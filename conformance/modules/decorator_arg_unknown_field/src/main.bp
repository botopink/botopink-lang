//// Decisions 280 (3), 308, example 1 — `.name` against `Type.Field<T>` names
//// a field of the `T` that `@Decl<T>` bound: a field the type does not
//// declare is refused at the `.name`.

import {types.Type, compiler, io.terminal.print} from "std";

pub type Code { Custom, Mismatch }

fn check<T>(
    syntax decl: T,
    comptime message: string,
    comptime rule: ?fn(v: T) -> bool = null,
    comptime at: ?Type.Field<T> = null,
    comptime code: Code = .Custom,
) {
    compiler.setMeta(Check(message: message));
}

fn passwordsMatch(a: Account) -> bool {
    return a.password == a.confirm;
}

#[check("passwords differ", passwordsMatch, at: .confrim)]
type Account(password: string, confirm: string)

pub fn main() {
    print("unreached");
}

// What `#[check]` records.
type Check(message: string)

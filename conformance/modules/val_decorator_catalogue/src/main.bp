//// Decision 356 — a decorator on a module-level `val` runs over a `@Decl` of
//// kind `DeclKind.Val`: `name`, `returnType` the declared type as written
//// (`""` when none), and `setMeta` records meta read back by
//// `@typeInfo(<val>)`. The `val` is an entry of `@TypeInfo.all`, with its
//// declared type as `returnTypeName`. On the parent binary the decorator was
//// dropped silently (`DeclKind.Val` did not exist).

import {compiler.DeclKind, compiler, io.terminal.print} from "std";

fn setting(syntax decl: unknown, comptime key: string) {
    if (compiler.kind(decl) != DeclKind.Val)
        compiler.fail("#[setting] annotates a val", at: decl);
    compiler.setMeta(Setting(key: key, declared: compiler.returnType(decl)));
}

#[setting("port")]
pub val port: i32 = 8080;

#[setting("host")]
pub val host = "localhost";

pub fn main() {
    print(comptime compiler.typeInfo(port).meta(Setting)?.key ?? "none");
    print(comptime compiler.typeInfo(port).meta(Setting)?.declared ?? "none");
    print("[" + (comptime compiler.typeInfo(host).meta(Setting)?.declared ?? "none") + "]");
    val all = @TypeInfo.all(with: setting);
    print(all.length);
    all.forEach({ d -> print(d.name + " " + d.returnTypeName) });
    print(port + 1);
}

// What `#[setting]` records: its key and the `val`'s declared type.
type Setting(key: string, declared: string)

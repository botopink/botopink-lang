//// `x?.m()`, `x!.m()` and `(x ?? d).m()` where `m` is a method of an enum a
//// SIBLING module declares and no module imports by name: only `find` is
//// imported, its `?Val` answer carries the type, and the call reaches the
//// type's own module on every target.

pub mod values;
import {cases.optional_enum_method_sibling.values.find};
import {io.terminal.print} from "std";

pub fn runCase() -> void {
    val b = find(1);
    print(b?.str() ?? "none");
    print(find(2)?.plus(2) ?? 0);
    print(find(3)?.str() ?? "none");
    print(b!.str());
    print((find(3) ?? b!).str());
}

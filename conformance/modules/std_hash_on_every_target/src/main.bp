//// `std/hash` on all four targets (decision 238, `01-compiler/05-wasm` step
//// 5): on wasm every cell is bound with `fn:` to a private body in exact
//// arithmetic, answering what Node's `crypto` answers — the digests, the MACs,
//// PBKDF2, the constant-time compare and the content hashes in one program,
//// since the wasm heap grows (decision 261). `contentHash` folds code points
//// on every target (decision 260): a character above U+FFFF is one code point.

import {hash} from "std";

pub fn main() {
    @print(hash.sha256("abc"));
    @print(hash.sha512("abc"));
    @print(hash.md5("héllo €"));
    @print(
        hash.sha1Base64(
            "dGhlIHNhbXBsZSBub25jZQ==258EAFA5-E914-47DA-95CA-C5AB0DC85B11",
        ),
    );
    @print(hash.sha256Base64Url("hello world"));
    @print(hash.strongHash(""));
    @print(
        hash.hmacSha256("key", "The quick brown fox jumps over the lazy dog"),
    );
    @print(hash.hmacSha256Base64Url("secret", "header.payload"));
    @print(hash.pbkdf2Sha256("pässwörd", "salt", 2, 40));
    @print(hash.pbkdf2Sha256("password", "salt", 9, 32));
    @print(hash.equalsConstantTime("abcd", "abcd"));
    @print(hash.equalsConstantTime("abcd", "abce"));
    @print(hash.equalsConstantTime("abc", "abcd"));
    @print(hash.contentHash("héllo €"));
    @print(hash.contentHash("🎉"));
    @print(hash.contentHash("a🎉b"));
    @print(hash.cacheKey(["user:1", "profile"]));
    @print(hash.strongCacheKey(["user", "1:profile"]));
    @print(hash.etag("<p>hi</p>"));
    @print(hash.weakEtag("<p>hi</p>"));
    @print(hash.matches("<p>hi</p>", "*"));
    @print(hash.fingerprint("app.js", "body{}"));
}

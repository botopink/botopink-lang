//// A host module whose name is also the basename of a module of the build —
//// `src/sidecars/text.erl` beside `src/text.bp` — is shipped and called. The
//// erlang atom of the botopink module is `erlang_sidecar_named_like_a_module@text` (decision
//// 109), so the two never meet.
////
//// The gap this pins (`00 · 10-cli-residuals`, `language-gaps.md`'s sidecar
//// row): the shipper skipped every qualifier matching an emitted module's
//// BASENAME, so `text.erl` was never shipped and `text:shout/1` died `undef`.
////
//// commonJS and wasm refuse an `compiler.external(.Erlang)`-only function
//// (`commonJS.expect`, `wasm.expect`); beam ships and loads `text.erl` the
//// way `modules/erlang_host_sidecar_shipped` does.

pub mod text;
import {text.greet};
import {compiler, io.terminal.print} from "std";

#[compiler.external(.Erlang("text:shout($0)"))]
declare fn shout(s: string) -> string;

pub fn main() -> void {
    print(shout(greet("sidecar")));
}

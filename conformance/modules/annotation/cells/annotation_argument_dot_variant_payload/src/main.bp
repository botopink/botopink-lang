//// An annotation argument whose parameter is an enum may be a dotted variant
//// with a payload: `#[kit.m(lifecycle: .Lazy(afterMs: 5))]`, the enum being the
//// parameter's declared type.

import {kit} from "lib";
import {kit.Mark} from "lib";
import {io.terminal.print, compiler} from "std";

#[kit.m(lifecycle: .Lazy(afterMs: 5))]
pub fn first() -> i32 {
    return 1;
}

pub fn main() -> void {
    print(comptime compiler.typeInfo(first).meta(Mark)?.lifecycle ?? "none");
}

//// A misspelled memory annotation is refused at the annotation:
//// `compiler.beamMemroy` names no member of `compiler` (decisions 663, 774 —
//// `#[compiler.beamMemory(…)]` is the one spelling), so the `var` is never
//// left in the default mode with nothing said.

import {io.terminal.print, compiler} from "std";

#[compiler.beamMemroy(.Ets)]
var hits: i32 = 0;

pub fn main() {
    print(hits);
}

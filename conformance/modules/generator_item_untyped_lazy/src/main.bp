//// Decision 105 — an `iter loop` whose item is read off a `for` binder (no
//// annotation names it) runs one step per item like any other: a print before
//// and after the first `yield` comes out between the items.

pub fn main() {
    val words = iter loop {
        for (["a", "b"]) { s ->
            @print("before " + s);
            yield s;
            @print("after " + s);
        }
        break;
    };
    for (words) { w ->
        @print(w);
    }
}

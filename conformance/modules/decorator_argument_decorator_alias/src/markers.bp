//// Two markers and a decorator that takes one of them by name.

pub fn email(expr decl: unknown) {
    val _n = compiler.name(decl)!;
}

pub fn lowercased(expr decl: unknown) {
    val _n = compiler.name(decl)!;
}

pub fn each(expr decl: unknown, comptime marker: Decorator) {
    val which = if (marker.same(email))
        "email"
    else if (marker.same(lowercased))
        "lowercased"
    else
        "other";
    compiler.addMember("pub fn "
        + compiler.name(decl)!
        + "Each() -> string { return \""
        + which
        + "\"; }");
}

pub fn all(expr decl: unknown, comptime markers: Decorator[]) {
    val n = markers.filter({ m -> m.same(email) || m.same(lowercased) }).length;
    compiler.addMember("pub fn "
        + compiler.name(decl)!
        + "All() -> i32 { return "
        + n.toString()
        + "; }");
}

//// 144 B-22 row "`Point(x: 0, ..)` in a `case`" — a constructor pattern with a
//// literal field and `..` answered `null` on commonJS. A pin: the row no
//// longer reproduces, the cell guards it on every target.

type Point(x: i32, y: i32)

fn describe(p: Point) -> string {
    return case p {
        Point(x: 0, ..) -> "on the y axis";
        Point(y: 0, ..) -> "on the x axis";
        _ -> "elsewhere";
    };
}

pub fn main() {
    @print(describe(Point(x: 0, y: 5)));
    @print(describe(Point(x: 4, y: 0)));
    @print(describe(Point(x: 1, y: 1)));
}

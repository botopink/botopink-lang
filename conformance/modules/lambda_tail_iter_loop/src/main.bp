//// An unmarked lambda whose tail expression is an `iter loop { … }` answers
//// that generator, as a function whose last statement is the block does.

fn walk(f: fn() -> @Iterator<i32>) {
    for (f()) { x ->
        @print(x);
    }
}

pub fn main() {
    walk({ ->
        iter loop {
            yield 1;
            yield 2;
            yield 3;
            break;
        }
    });
}

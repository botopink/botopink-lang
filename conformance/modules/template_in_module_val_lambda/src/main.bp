//// Decision 425 — a template call expands wherever an expression may
//// stand: in a lambda a module-level `val` holds too.

import {compiler} from "std";

fn shout(syntax q: string) -> string {
    return compiler.build("\"template " + compiler.text(q) + "\"");
}

val g = { -> shout @`x` };

pub fn main() {
    @print(g());
}

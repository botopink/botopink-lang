//// `language-gaps.md`'s former row 28 — a lambda literal is a `case` arm's
//// value: `Mark(suffix) { { item -> mark(item, suffix) }; }` is the lambda, not
//// a block, and the value the `case` answers is applied after it. beam ran the
//// lambda as a statement, the arm answered `ok`, and the call was `{badfun, ok}`;
//// every target now prints the applied value.

type Mode {
    Mark(suffix: string),
    Same,
}

fn mark(x: string, suffix: string) -> string {
    return x + suffix;
}

fn pick(m: Mode) -> fn(item: string) -> string {
    val g = case m {
        Mark(suffix) {
            { item -> mark(item, suffix) };
        }
        Same {
            { item -> item };
        }
    };
    return g;
}

pub fn main() {
    @print(pick(Mode.Mark(suffix: "?"))("a"));
    @print(pick(Mode.Same)("b"));
}

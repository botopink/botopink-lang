//// Decision 525 — a block that returns on some paths: its `return` leaves
//// the enclosing function, and its tail is its value on the path that runs
//// off its end. `@block` refused the same body as `block-tail-value`.

fn pick(c: bool) -> i32 {
    val a = {
        if (c) return 3;
        4
    };
    return a * 10;
}

pub fn main() {
    @print(pick(true));
    @print(pick(false));
}

//// Decision 575 (3), 580 — the executor `compiler.init` takes is run-time
//// code, spliced into the program's init list: a host function it calls (here
//// one with an `.Erlang` and a `.Node` cell and no `.Wasm` cell) is a run-time
//// call, never reached at build, so it asks for no comptime cell.

import {compiler} from "std";

#[@external(.Erlang("erlang:system_time()"), .Node("Date.now()"))]
declare fn hostTime() -> i64;

fn reg(name: string) -> i32 {
    val _t = hostTime();
    @print(name);
    return 0;
}

fn registered(syntax decl: unknown) {
    val name = compiler.name(decl);
    compiler.init({ -> reg(name); });
}

#[registered]
pub fn home() -> string {
    return "home";
}

pub fn main() {
    @print(home());
}

//// Decision 575 (3) — `compiler.compile` is an output: it compiles code
//// beside the annotated declaration, and only a decorator has one. A
//// function whose first parameter is no `expr` is refused at the output
//// (`compiler-output-outside-decorator`).

import {compiler} from "std";

fn setup(comptime text: string) {
    compiler.compile({ -> @print(text) });
}

pub fn main() {
    setup("x");
}

import {failure, failure.Failure, io.terminal.print, failure.panic} from "std";

fn boom() -> i32 {
    defer print("released");
    panic("kaboom");
}

fn show(r: Result<i32, Failure>) -> void {
    case r {
        Ok(v) -> print("Ok " + v.toString());
        Error(f) -> print("Error " + f.kind + ": " + f.message);
    }
}

pub fn runCase() -> void {
    show(failure.attempt({ -> boom() }));
}

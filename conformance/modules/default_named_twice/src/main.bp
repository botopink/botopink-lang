//// 01-compiler/01-checker step 25 (decision 289) — `default` is written once
//// per function: `pub default fn render` already is the module's default, so
//// `pub default render;` is `default-twice` at the name.

pub default fn render() -> string {
    return "x";
}

pub default render;

pub fn main() {
    @print(render());
}

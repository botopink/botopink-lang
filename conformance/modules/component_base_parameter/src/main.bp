//// Decision 354 (1) — one wrapper, `@Component<R>`: the base parameter of
//// decision 128 is gone. `@Component<C, R>` is a type-arity error naming
//// `@Component<R>`, located on the base the codemod drops.

type Element(count: i32) implement @Renderable

fn Widget() -> @Component<Element, Element> {
    return Element(count: 1);
}

pub fn main() {
    Widget();
}

//// A member a decorator adds is written as if by hand, so a record update in
//// its body — `Point(..self, y: 0)`,
//// `Point(..v, z: z)` — copies every field it does not name, on
//// every target (144 B-10, decision 430).

fn flatten(comptime decl: @Decl) {
    decl.addMember(
        "pub fn flat(self: Self) -> " + decl.name + " { return " + decl.name + "(..self, y: 0); }",
    );
    decl.addMember(
        "pub fn rebuilt(v: " + decl.name + ", z: i32) -> " + decl.name + " { val __w = " + decl.name + "(..v, z: z); return __w; }",
    );
}

#[flatten]
type Point(x: i32, y: i32, z: i32)

pub fn main() {
    @print(Point(x: 1, y: 2, z: 3).flat());
    @print(Point.rebuilt(Point(x: 1, y: 2, z: 3), 9));
}

import {compiler} from "std";

fn serverOnly(syntax decl: unknown) {
    val _n = compiler.name(decl);
}

// Refuses a function marked `serverOnly`, however the mark is spelled.
fn clientOnly(syntax decl: unknown) {
    compiler
        .annotations(decl)
        .forEach({ a ->
            if (a.decorator.same(serverOnly))
                compiler.fail("`"
                    + compiler.name(decl)
                    + "` runs on the server", at: decl)
        });
}

#[clientOnly]
fn Widget() -> string {
    return "w";
}

pub fn main() {
    @print(Widget()); // w
}

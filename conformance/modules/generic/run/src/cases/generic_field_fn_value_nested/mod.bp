//// A function stored in a generic record's field answers what the function
//// answers when it is called through an untyped local the field was read
//// into (the scalar and string half is `generic_field_fn_value`): an array,
//// a record, an optional, a function in a record that is itself a generic
//// record's field (`Box(value: Box(value: hi))`), and one of two type
//// parameters (`Pair<A, B>`). wasm printed the array's and the string's
//// address.

import {io.terminal.print} from "std";

type Box<T>(value: T)

type Pair<A, B>(left: A, right: B)

type P(x: i32)

fn mk(n: i32) -> P {
    return P(x: n);
}

fn arr(n: i32) -> i32[] {
    return [n, n];
}

fn words(s: string) -> string[] {
    return [s, s + "!"];
}

fn opt(n: i32) -> ?string {
    if (n > 0) return "y";
    return null;
}

fn hi() -> string {
    return "hi";
}

pub fn runCase() {
    val b = Box(value: mk);
    val fb = b.value;
    print(fb(4));
    val c = Box(value: arr);
    val fc = c.value;
    print(fc(5));
    val w = Box(value: words);
    val fw = w.value;
    print(fw("a"));
    val d = Box(value: opt);
    val fd = d.value;
    print(fd(1) ?? "n");
    print(fd(0) ?? "n");
    val p = Pair(left: hi, right: mk);
    val fl = p.left;
    val fr = p.right;
    print(fl());
    print(fr(1));
    val bb = Box(value: Box(value: hi));
    val inner = bb.value;
    val fi = inner.value;
    print(fi());
    print(bb.value.value());
}

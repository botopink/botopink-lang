//// An integer `/` or `%` by zero aborts on every target: wasm traps, erlang
//// and beam raise `badarith`, and commonJS — whose `7 / 0` is `Infinity` and
//// `7 % 0` `NaN` — throws `integer division by zero`.

fn rem(a: i32, b: i32) -> i32 {
    return a % b;
}

fn div(a: i32, b: i32) -> i32 {
    return a / b;
}

pub fn main() {
    @print(rem(7, 2));
    @print(div(7, 2));
    @print(div(7, 0));
    @print("unreachable");
}

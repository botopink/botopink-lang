//// A behavior's bodied `default fn` that answers `Async<T>` and awaits, adopted by a
//// type that implements the behavior without declaring it, is an async method of that
//// type: called on a typed value and awaited. commonJS emitted the adopted body as a
//// plain function, which Node refuses ("await is only valid in async functions").

import {io.terminal.print} from "std";

fn fetch(n: i32) -> Task<i32> {
    return n * 10;
}

behavior Loader {
    fn base(self: Self) -> i32;

    default fn load(self: Self) -> Task<i32> {
        val v = await fetch(self.base());
        return v + 1;
    }
}

type Box(n: i32) implement Loader {
    fn base(self: Self) -> i32 {
        return self.n;
    }
}

pub fn main() -> Task<void> {
    val r = await Box(n: 4).load();
    print(r); // 41
}

//// Decision 415 (3), by decision 372's pattern — a decorator that reads
//// `.hooks` runs after its module's bodies, so the meta it records on a
//// declaration of this module is not there yet when a template call of the
//// module reads it through `q.lookup`: the read is refused at the call's
//// literal (`typeinfo-meta-hooks-pending`), as `@typeInfo(X).meta(T)` is.

import {compiler} from "std";

type Count(uses: i32)

fn graph(syntax decl: unknown) {
    compiler.setMeta(Count(uses: compiler.hooks(decl).length));
}

#[graph]
fn page() -> string {
    return "page";
}

fn uses(syntax q: string) -> i32 {
    val decl = compiler.lookup(q, compiler.text(q)) ?? compiler.fail("`" + compiler.text(q) + "` is not in scope", at: q);
    val c = compiler.meta<Count>(decl) ?? compiler.fail("`" + compiler.text(q) + "` records no count", at: q);
    return compiler.build(c.uses.toString());
}

pub fn main() {
    @print(page());
    @print(uses @`page`);
}

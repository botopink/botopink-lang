//// Decisions 379 (3), 416 (2) — a read of a behavior with no declared
//// default is refused at build, at the read, naming the remedy a behavior
//// takes: `createContext(value, Repository)`, a value of a type that
//// implements it — a behavior has no constructor to call.

import {context.createContext, context.provide, context.context, io.terminal.print} from "std";

behavior Repository {
    fn find(self: Self, id: i32) -> string;
}

type View(text: string) implement Renderable

fn Page() -> Component<View> {
    val r = use context(Repository);
    return View(text: r.find(1));
}

pub fn main() -> Task<void> {
    val p = await Page();
    print(p.text);
}

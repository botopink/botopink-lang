//// What one case answered, as data, and the reading of a whole module's answers against its
//// `snapshot/main.snap` (decision 989 (5), (9)).

import {records.Snap, records.Refusal};
import {sections.Section, sections.SnapFile, sections.same, sections.find, sections.answeringTarget, sections.headerOf};
import {records.parseBody, records.renderBody, records.candidate};

/// One case's observed answer: its records and, for an abort, the text its stderr held.
pub type Observed(name: string, snap: Snap, stderr: string = "")

/// A refused load's diagnostic as the `refused` / `at` / `label` / `from` records of 475, 485, 532:
/// the whole `error…` line as `botopink build` prints it — `error[<code>]: ` when the diagnostic
/// carries a code its message does not already start with, `error: ` otherwise —, its location when it
/// points somewhere, the label beside the caret, the `called from` frames innermost first.
pub fn refusalOf(code: string, message: string, file: string, line: i32, column: i32, label: ?string, frames: string[]) -> Refusal {
    val head = if (code == "" || message.startsWith(code + ":"))
        "error: " + message
    else
        "error[" + code + "]: " + message;
    val at: ?string = if (file == "")
        null
    else
        file + ":" + line.toString() + ":" + column.toString();
    return Refusal(message: head, at: at, label: label, frames: frames);
}

/// The answer of a case whose load refused: the build lines first (decision 904), then the refusals.
pub fn refusedAnswer(name: string, buildText: string, refusals: Refusal[]) -> Observed {
    return Observed(name: name, snap: Snap(refusals: refusals, build: linesOf(buildText)));
}

/// The answer of a case that ran: the build lines, then what it printed, `abort` when the run failed.
pub fn ranAnswer(name: string, buildText: string, printed: string, failed: bool, failure: string) -> Observed {
    return Observed(name: name, snap: Snap(build: linesOf(buildText), stdout: printed, abort: failed), stderr: failure);
}

/// A build text's lines, each without its newline (`""` has none).
pub fn linesOf(text: string) -> string[] {
    if (text == "") return [];
    val body = if (text.endsWith("\n"))
        text.slice(0, text.length - 1)
    else
        text;
    return body.split("\n");
}

/// The cases whose observed answer on `target` is not the accepted one, in module order.
pub fn reds(file: SnapFile, observed: Observed[], target: string) -> string[] {
    var out: string[] = [];
    for (observed) { o ->
        if (!same(file, o.name, target, o.snap, o.stderr)) out.push(o.name);
    }
    return out;
}

fn observedOf(observed: Observed[], name: string) -> ?Observed {
    for (observed) { o ->
        if (o.name == name) return o;
    }
    return null;
}

fn candidateBody(file: SnapFile, o: Observed, target: string) -> string {
    val accepted = find(file, o.name, target);
    var kept: ?Snap = null;
    if (accepted) {
        a ->
        kept = try parseBody(a.body) catch null;
    }
    return renderBody(candidate(kept, o.snap, o.stderr));
}

fn kept(file: SnapFile, observed: Observed[], target: string, s: Section) -> string {
    val o = observedOf(observed, s.name);
    if (o == null) return "";
    val ob = o;
    val chosen = answeringTarget(file, s.name, target);
    val head = headerOf(s.name, s.target) + "\n";
    if (s.target == chosen && !same(file, s.name, target, ob.snap, ob.stderr))
        return head + candidateBody(file, ob, target);
    return head + s.body;
}

fn appended(file: SnapFile, o: Observed) -> string {
    if (file.sections.any({ s -> s.name == o.name })) return "";
    return headerOf(o.name, null)
        + "\n"
        + renderBody(candidate(null, o.snap, o.stderr));
}

/// The module's whole candidate file for a run on `target`: the file's sections in its order, every
/// unchanged section byte for byte; a case whose answer differs gets the candidate in the section it
/// answered on `target` (its departure there, else its plain section); a case the file does not
/// have is appended as a plain section; a section of a case the module no longer has is dropped.
pub fn assemble(file: SnapFile, observed: Observed[], target: string) -> string {
    val old = file.sections.map({ s -> kept(file, observed, target, s) });
    val fresh = observed.map({ o -> appended(file, o) });
    return "botopink-cell 2\n" + old.join("") + fresh.join("");
}

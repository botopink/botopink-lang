//// The language features decision 989 builds in parallel, in one place: each function below is the
//// one spot a landing of its piece changes, and until then it refuses by name (never a silent stub).
//// See `../docs.md` for which function waits on what.

import {failure.panic, compiler.Diagnostic, compiler.Module, compiler.RunFailure} from "std";

/// The target the program runs on: `commonJS`, `erlang`, `beam` or `wasm`. Waits on 989 (7), piece 3:
/// `io.os.target()`. It becomes `return os.target();`.
pub fn target() -> string {
    panic("needs 989 (7): io.os.target()");
}

/// The `called from` frames of a refusal, innermost first (989 (4), piece 4: `Diagnostic.from`).
pub fn frames(d: Diagnostic) -> string[] {
    return d.`from`;
}

/// What the loaded package's build bodies printed, before its refusals (decision 904; 989 (4),
/// piece 4: `Module.buildOutput()`).
pub fn buildOutput(m: Module) -> string {
    return m.buildOutput();
}

/// What a run printed, and why it failed. `m.run()` is written in the `compiler.init` body itself
/// (`run-outside-init`), so the adapter takes its answer. Waits on 989 (1), piece 2: `Module.run()`
/// answering `Result<string, RunFailure>`, with `RunFailure.output`. The parameter becomes
/// `Result<string, compiler.RunFailure>`; `Ok(text)` is `(text, false, "")`, `Error(f)` is
/// `(f.output, true, f.message)`.
pub type Ran(printed: string, failed: bool, failure: string)

pub fn ranOf(r: Result<void, RunFailure>) -> Ran {
    panic("needs 989 (1): run() answering the printed text");
}

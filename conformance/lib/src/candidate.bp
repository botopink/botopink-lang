//// The `.new` of a run (decision 989 (6)): `snapshot/main.snap.new` holds the module's whole
//// candidate file. The program never accepts a candidate — it never writes `snapshot/main.snap`
//// (decision 67).

import {io.fs.writeText} from "std";
import {records.diff};
import {sections.SnapFile, sections.parseFile, sections.renderFile, sections.HEADER};
import {observe.Observed, observe.assemble, observe.reds};

/// Where the candidate goes, beside the accepted file.
pub val CANDIDATE_PATH: string = "snapshot/main.snap.new";

/// The accepted file's path.
pub val ACCEPTED_PATH: string = "snapshot/main.snap";

/// `text` written to the file at `path`, through `io.fs` on every target (decision 992: wasm's
/// `io.fs` is the other targets'). `Error` when the file cannot be written.
pub fn deliver(path: string, text: string) -> Result<void, string> {
    val written = try writeText(path, text) catch { e ->
        throw "cannot write " + path + ": ${e}";
    };
    return;
}

/// The whole check of a module: its observed answers against the accepted file's text. `Ok` when
/// every case is green; else the candidate is delivered (a candidate when the text differs) and the
/// `Error` names the red cases and the candidate.
pub fn finish(accepted: string, observed: Observed[], target: string) -> Result<void, string> {
    val file = try parseFile(accepted) catch { m ->
        throw "snapshot/main.snap line " + m.line.toString() + ": " + m.reason;
    };
    val red = reds(file, observed, target);
    val text = assemble(file, observed, target);
    if (red.length == 0 && text == renderFile(file)) return;
    // The verdict names the red cases whether or not the candidate could be written.
    val written = case deliver(CANDIDATE_PATH, text) {
        Ok(_) -> "";
        Error(m) -> "\n" + m;
    };
    throw red.length.toString()
        + " red on "
        + target
        + ": "
        + red.join(", ")
        + "\n"
        + diff(renderFile(file), text)
        + written;
}

//// The `.new` of a run (decision 989 (6)): `snapshot/main.snap.new` holds the module's whole
//// candidate file. The program never accepts a candidate — it never writes `snapshot/main.snap`
//// (decision 67).

import {io.fs.writeText} from "std";
import {records.diff};
import {sections.SnapFile, sections.parseFile, sections.renderFile, sections.HEADER};
import {observe.Observed, observe.assemble, observe.reds};

/// Where the candidate goes, beside the accepted file, relative to the module's package.
pub val CANDIDATE_PATH: string = "snapshot/main.snap.new";

/// The candidate's path from the process's directory (decision 1003): under the module's `root`
/// — `(comptime compiler.src()).root`, the directory a loading package loaded it from — when it
/// is not `""`, so a module run by the conformance root writes beside its own snapshot.
pub fn candidatePath(root: string) -> string {
    return if (root == "") CANDIDATE_PATH else root + "/" + CANDIDATE_PATH;
}

/// The accepted file's path.
pub val ACCEPTED_PATH: string = "snapshot/main.snap";

/// `text` written to the file at `path`, through `io.fs` on every target (decision 992: wasm's
/// `io.fs` is the other targets'). `Error` when the file cannot be written.
pub fn deliver(path: string, text: string) -> Result<void, string> {
    // A `case`, not `try … catch { e -> … }`: wasm's GC lowering takes no catch binder yet.
    case writeText(path, text) {
        Ok(_) -> return;
        // The path alone: `e.message()` crashes on commonJS and `${e}` does not build on wasm's
        // GC lowering (B-170).
        Error(_) -> throw "cannot write " + path;
    }
}

/// The accepted file parsed, or the line it is malformed at. Each arm answers for itself — wasm's
/// GC lowering takes no `catch` binder, nor a `case` whose arm throws as its value.
fn acceptedFile(accepted: string) -> Result<SnapFile, string> {
    case parseFile(accepted) {
        Ok(f) { return f; }
        Error(m) { throw "snapshot/main.snap line " + m.line.toString() + ": " + m.reason; }
    }
}

/// The whole check of a module: its observed answers against the accepted file's text. `Ok` when
/// every case is green; else the candidate is delivered (a candidate when the text differs) at
/// `candidatePath(root)` and the `Error` names the red cases and the candidate.
pub fn finish(accepted: string, observed: Observed[], target: string, root: string = "") -> Result<void, string> {
    val file = try acceptedFile(accepted);
    val red = reds(file, observed, target);
    val text = assemble(file, observed, target);
    if (red.length == 0 && text == renderFile(file)) return;
    // The verdict names the red cases whether or not the candidate could be written.
    val written = case deliver(candidatePath(root), text) {
        Ok(_) -> "";
        Error(m) -> "\n" + m;
    };
    throw red.length.toString()
        + " red on "
        + target
        + ": "
        + red.join(", ")
        + "\n"
        + diff(renderFile(file), text)
        + written;
}

//// The `.new` of decisions 989 (6), 992: written through `io.fs` on every target, and the whole
//// check's verdict.

import {io.fs.readText, io.fs.mkdirRecursive} from "std";
import {candidate.deliver, candidate.finish, candidate.CANDIDATE_PATH, candidate.candidatePath};
import {observe.Observed, observe.ranAnswer};

test "the candidate's path is beside the accepted file" {
    assert CANDIDATE_PATH == "snapshot/main.snap.new";
}

test "a loaded module's candidate is under its root (decision 1003)" {
    assert candidatePath("") == "snapshot/main.snap.new";
    assert candidatePath("modules/array") == "modules/array/snapshot/main.snap.new";
}

fn verdictOf(r: Result<void, string>) -> string {
    return case r {
        Ok(_) -> "ok";
        Error(m) -> m;
    };
}

test "a green module needs no candidate and a red one reports its cases" {
    val accepted = "botopink-cell 2\n== a\nout 1\n== b\nout 2\n";
    val green = [ranAnswer("a", "", "1\n", false, ""), ranAnswer("b", "", "2\n", false, "")];
    assert verdictOf(finish(accepted, green, "wasm")) == "ok";
    val red = [ranAnswer("a", "", "1\n", false, ""), ranAnswer("b", "", "3\n", false, "")];
    val verdict = finish(accepted, red, "wasm");
    assert verdictOf(verdict).startsWith("1 red on wasm: b");
}

test "deliver writes the candidate file" {
    val dir = ".botopinkbuild/tmp/candidate";
    val made = try mkdirRecursive(dir) catch { e ->
        return;
    };
    val path = dir + "/main.snap.new";
    val sent = try deliver(path, "botopink-cell 2\n== a\nout 1\n") catch { e ->
        return;
    };
    val back = try readText(path) catch { e ->
        "unreadable"
    };
    assert back == "botopink-cell 2\n== a\nout 1\n";
}

//// What one target answered (`cell.zig`'s `Answer`): each module with a non-empty answer, by its
//// snapshot name, in the order the answer named them, and the program's stderr (ANSI stripped)
//// when it ran.

import {records.Snap};

/// One module's answer, by its snapshot name (`src/shapes/circle.bp` → `shapes/circle`).
pub type ModuleSnap(name: string, snap: Snap)

pub type Answer(modules: ModuleSnap[] = [], stderr: string = "")

/// The answer of `name` in `modules`, or null.
pub fn find(modules: ModuleSnap[], name: string) -> ?Snap {
    for (modules) { m ->
        if (m.name == name) return m.snap;
    }
    return null;
}

/// `modules` with `name` answering `snap`: in place when it is there, else last.
pub fn put(modules: ModuleSnap[], name: string, snap: Snap) -> ModuleSnap[] {
    var out: ModuleSnap[] = [];
    var placed = false;
    for (modules) { m ->
        if (m.name == name) {
            out.push(ModuleSnap(name: name, snap: snap));
            placed = true;
        } else out.push(m);
    }
    if (!placed) out.push(ModuleSnap(name: name, snap: snap));
    return out;
}

/// The names of `modules`, in order.
pub fn names(modules: ModuleSnap[]) -> string[] {
    return modules.map({ m -> m.name });
}

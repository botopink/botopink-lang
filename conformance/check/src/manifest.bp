//// A cell's manifest as `cell check` reads it (decisions 475 (1), 512, 770): its `"targets"` — or its
//// workspace's when it writes none —, whether it writes them, and the workspace it is a member of
//// (its directory is the cache root every cell of the workspace shares, decision 509 (4)).
//// The workspace is found as `manifest.workspaceOf` finds it: the nearest ancestor whose
//// `botopink.json` declares `"workspaces"`, when one of its entries lists the cell — an entry's `*`
//// stands for one directory name.

import {json, json.Json} from "std";
import {host.readText};

/// Every target, in `cell.zig`'s `ALL_TARGETS` order.
pub val ALL: string[] = ["commonJS", "erlang", "beam", "wasm"];

fn isTarget(name: string) -> bool {
    return ALL.contains(name);
}

fn objectOf(text: string) -> ?Json {
    return case json.decode(text) {
        Ok(v) -> if (v.isObject()) v else null;
        Error(_) -> null;
    };
}

fn isArray(v: Json) -> bool {
    return case v {
        Json.Arr(items: _) -> true;
        _ -> false;
    };
}

fn isString(v: Json) -> bool {
    return case v {
        Json.Str(value: _) -> true;
        _ -> false;
    };
}

fn dirname(path: string) -> string {
    val cut = path.lastIndexOf("/");
    return if (cut <= 0) "/" else path.slice(0, cut);
}

/// The workspace `cell` (absolute) is a member of: its directory and its manifest, or null.
pub type Workspace(dir: string, text: string, manifest: Json)

fn listsMember(ws: Workspace, cell: string) -> bool {
    if (!cell.startsWith(ws.dir + "/")) return false;
    val rel = cell.slice(ws.dir.length + 1).split("/");
    for ((ws.manifest.field("workspaces") ?? Json.Null).items()) { entry ->
        val glob = entry.str().split("/").filter({ s -> s != "" && s != "." });
        if (glob.length == rel.length) {
            var i = 0;
            var all = true;
            while (i < glob.length) {
                val g = glob.at(i) ?? "";
                if (g != "*" && g != (rel.at(i) ?? "")) all = false;
                i = i + 1;
            }
            if (all) return true;
        }
    }
    return false;
}

pub fn workspaceOf(cell: string) -> ?Workspace {
    var d = dirname(cell);
    while (true) {
        val text = readText(d + "/botopink.json") ?? "";
        if (text.contains("\"workspaces\"")) {
            val m = objectOf(text);
            if (m) {
                o ->
                if (isArray(o.field("workspaces") ?? Json.Null)) {
                    val ws = Workspace(dir: d, text: text, manifest: o);
                    return if (listsMember(ws, cell)) ws else null;
                }
            }
        }
        if (d == "/") return null;
        d = dirname(d);
    }
    return null;
}

/// Whether `manifest.expand` takes every entry of the workspace: every child of a directory, every
/// child of the workspace's, the cases of every module (of the workspace or of a directory), or a
/// literal directory (a doc comment never holds the two characters that close a JS comment). A workspace with another entry does not expand, and a
/// member's lookup tiers then hold no `.botopinkbuild/deps/` of the workspace root
/// (`manifest.depsRoots`).
pub fn expands(ws: Workspace) -> bool {
    return (ws.manifest.field("workspaces") ?? Json.Null)
        .items()
        .all({ entry -> supportedEntry(entry.str()) });
}

fn supportedEntry(g: string) -> bool {
    if (g.indexOf("*") < 0 || g == "*" || g == "*/cases/*") return true;
    if (g.endsWith("/*/cases/*"))
        return g.slice(0, g.length - "/*/cases/*".length).indexOf("*") < 0;
    if (g.endsWith("/*")) return g.slice(0, g.length - 2).indexOf("*") < 0;
    return false;
}

/// The cache root of the cell's dependencies: its workspace's directory, else its own.
pub fn cacheRootOf(cell: string) -> string {
    val ws = workspaceOf(cell);
    if (ws) {
        w ->
        return w.dir;
    }
    return cell;
}

/// Whether the cell's own manifest writes `"targets"`.
pub fn writesTargets(cell: string) -> bool {
    val m = objectOf(readText(cell + "/botopink.json") ?? "");
    if (m) {
        o ->
        return o.field("targets") != null;
    }
    return false;
}

/// The cell's `"targets"` (else its workspace's, else every target), in `ALL` order; `Error(why)`
/// when the narrowing is malformed — not an array of target names, an unknown one, one named twice,
/// none, or all four. A manifest that is not JSON is the build's to refuse: every target.
pub fn readTargets(cell: string) -> Result<string[], string> {
    val m = objectOf(readText(cell + "/botopink.json") ?? "");
    var field: ?Json = null;
    if (m) {
        o ->
        field = o.field("targets");
        if (field == null) {
            val ws = workspaceOf(cell);
            if (ws) {
                w ->
                field = w.manifest.field("targets");
            }
        }
    } else return ALL;
    val value = field ?? Json.Null;
    if (field == null) return ALL;
    if (!isArray(value)) throw "is not an array of target names";
    var list: string[] = [];
    for (value.items()) { item ->
        if (!isString(item)) throw "is not an array of target names";
        val name = item.str();
        if (!isTarget(name))
            throw "unknown target `"
                + name
                + "` (commonJS, erlang, beam, wasm)";
        if (list.contains(name)) throw "`" + name + "` is named twice";
        list = list.append([name]);
    }
    if (list.length == 0) throw "names no target";
    if (list.length == ALL.length)
        throw "names every target, so it narrows nothing — delete the field";
    return ALL.filter({ t -> list.contains(t) });
}

/// The `"src"` directory of the cell's manifest (`src` when it names none), as `ProjectConfig.srcDir`
/// reads it: its trailing `/` dropped, `.` for the project root.
pub fn srcDirOf(cell: string) -> string {
    val m = objectOf(readText(cell + "/botopink.json") ?? "");
    var src = "src/";
    if (m) {
        o ->
        val f = o.field("src");
        if (f) {
            v ->
            if (isString(v)) src = v.str();
        }
    }
    while (src.endsWith("/")) {
        src = src.slice(0, src.length - 1);
    }
    if (src.startsWith("./") && src.length > 2) src = src.slice(2);
    return if (src == "") "." else src;
}

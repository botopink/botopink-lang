//// The scratch copy of a cell — the port of `cell.zig`'s `Scratch.open` / `close`: everything of the
//// cell but `snapshot/`, `docs.md` and hidden entries, under `<home>/.botopinkbuild/tmp/check-<64
//// random bits>/` of the directory the command started in (the root every scratch directory of the
//// CLI and the compiler shares, which `zig build clean-tmp` reaps at a 1-day TTL). A program that
//// writes into its working directory finds on every target the directory it would find alone; the
//// package's builds and runs work in the copy (decision 838 (4): a `.bpr` is built and run from the
//// directory of the project that wrote it).
////
//// A cell that is a member of a workspace (every `conformance/modules/` is one, decision 512 (5)) is
//// copied into a workspace of its own whose manifest is the cell's workspace's — its `path`
//// dependencies made absolute against the workspace's directory — and whose one member is the cell
//// at its path under the workspace root, so the cell inherits what it inherits in place and no
//// sibling is read. The copy's `path` dependencies that leave the cell are made absolute against
//// the cell's own directory, a link to a directory outside the cell stays a link (B-132), and the
//// copy's `BOTOPINK_LIB_ROOTS` carries the command's roots, the cell's `.botopinkbuild/deps/` tiers
//// and the walk-up from the cell (`cellEnv`), which the copy could reach none of by itself.

import {manifest.workspaceOf, manifest.expands, manifest.Workspace};
import {host.makeDirs, host.removeTree, host.randomHex, host.isDir, host.exists, host.childNames, host.readText, host.writeText, host.resolve, host.realPath, host.isLink, host.symLink, host.copyFile, host.envVar};

/// A scratch copy: its root (removed at `close`), the copy of the cell (`root`, or
/// `<root>/<member path>` for a workspace member), the copy's manifest text, and the environment
/// its builds and runs are given (`NAME=value` entries).
pub type Scratch(root: string, dir: string, manifest: string, env: string[])

fn dirname(path: string) -> string {
    val cut = path.lastIndexOf("/");
    return if (cut <= 0) "/" else path.slice(0, cut);
}

fn basename(path: string) -> string {
    return path.slice(path.lastIndexOf("/") + 1);
}

fn trimSlashes(s: string) -> string {
    var t = s;
    while (t.startsWith("/")) {
        t = t.slice(1);
    }
    while (t.endsWith("/")) {
        t = t.slice(0, t.length - 1);
    }
    return t;
}

/// The cell's path relative to the workspace directory (`a/b` for `<ws>/a/b`); its basename when
/// it does not lie under it.
pub fn memberPath(wsDir: string, cell: string) -> string {
    var base = wsDir;
    while (base.length > 1 && base.endsWith("/")) {
        base = base.slice(0, base.length - 1);
    }
    if (cell.length > base.length + 1 && cell.startsWith(base + "/"))
        return trimSlashes(cell.slice(base.length + 1));
    return basename(cell);
}

/// The workspace manifest `text` with its `"workspaces"` array replaced by the one literal entry
/// `member`.
pub fn soleMember(text: string, member: string) -> string {
    val key = text.indexOf("\"workspaces\"");
    if (key < 0) return text;
    val open = indexFrom(text, "[", key);
    if (open < 0) return text;
    val close = indexFrom(text, "]", open);
    if (close < 0) return text;
    return text.slice(0, open) + "[\"" + member + "\"]" + text.slice(close + 1);
}

fn indexFrom(text: string, sub: string, start: i32) -> i32 {
    val at = text.slice(start).indexOf(sub);
    return if (at < 0) -1 else at + start;
}

fn isSpace(c: string) -> bool {
    return c == " " || c == "\t" || c == "\n" || c == "\r";
}

/// `text` (a manifest) with every relative `"path": "…"` dependency made absolute against
/// `cellDir`, nothing else touched; with `keepInside`, a path that stays inside the cell is the
/// copy's own and stays as written.
pub fn absolutizePathDeps(text: string, cellDir: string, keepInside: bool) -> string {
    var out = "";
    var i = 0;
    while (true) {
        val k = indexFrom(text, "\"path\"", i);
        if (k < 0) break;
        var j = k + "\"path\"".length;
        while (j < text.length && isSpace(text.slice(j, j + 1))) {
            j = j + 1;
        }
        if (j >= text.length || text.slice(j, j + 1) != ":") {
            out = out + text.slice(i, j);
            i = j;
            continue;
        }
        j = j + 1;
        while (j < text.length && isSpace(text.slice(j, j + 1))) {
            j = j + 1;
        }
        if (j >= text.length || text.slice(j, j + 1) != "\"") {
            out = out + text.slice(i, j);
            i = j;
            continue;
        }
        val start = j + 1;
        val end = indexFrom(text, "\"", start);
        if (end < 0) break;
        val value = text.slice(start, end);
        out = out + text.slice(i, start);
        if (value == "" || value.startsWith("/") || value.contains("\\"))
            out = out + value
        else {
            val resolved = resolve([cellDir, value]);
            val base = resolve([cellDir]);
            val inside = resolved.length > base.length
                && resolved.startsWith(base + "/");
            val written = if (inside && keepInside) value else resolved;
            out = out + written;
        }
        i = end;
    }
    return out + text.slice(i);
}

/// The real path `src` links to when `src` is a symbolic link to a directory outside `cellReal`.
fn outsideLinkTarget(src: string, cellReal: string) -> ?string {
    if (!isLink(src)) return null;
    val real = realPath(src);
    if (real) {
        r ->
        val inside = r.length > cellReal.length && r.startsWith(cellReal + "/");
        return if (inside) null else r;
    }
    return null;
}

/// Copy `from` into `to`: at the top level `snapshot/` and `docs.md` stay behind, hidden entries at
/// every level.
fn copyTree(source: string, to: string, top: bool, cellReal: string) -> void {
    for (childNames(source, "all")) { name ->
        val skip = name.startsWith(".")
            || (top && (name == "snapshot" || name == "docs.md"));
        if (!skip) {
            val src = source + "/" + name;
            val dst = to + "/" + name;
            if (isDir(src)) {
                val target = outsideLinkTarget(src, cellReal);
                if (target) {
                    t ->
                    symLink(t, dst);
                } else {
                    makeDirs(dst);
                    copyTree(src, dst, false, cellReal);
                }
            } else copyFile(src, dst);
        }
    }
}

/// The lookup roots of `cell`'s builds (decision 483): the command's `BOTOPINK_LIB_ROOTS` (relative
/// ones against `home`), the cell's `.botopinkbuild/deps/` (and its workspace's), then the walk-up
/// from the cell — `libs.rootsFrom`: each ancestor's workspace, `repository/botopink-lang/libs`,
/// `repository` and `libs`, up to the checkout that holds `repository/`.
fn libRoots(home: string, cell: string, ws: ?Workspace) -> string[] {
    var roots: string[] = [];
    val env = envVar("BOTOPINK_LIB_ROOTS");
    if (env) {
        value ->
        for (value.split(":")) { e ->
            if (e != "")
                roots.push(if (e.startsWith("/")) e else resolve([home, e]));
        }
    }
    val own = cell + "/.botopinkbuild/deps";
    roots.push(own);
    if (ws) {
        w ->
        val wsDeps = w.dir + "/.botopinkbuild/deps";
        if (expands(w) && resolve([wsDeps]) != resolve([own]))
            roots.push(wsDeps);
    }
    var walked: string[] = [];
    var d = cell;
    while (true) {
        val text = readText(d + "/botopink.json") ?? "";
        if (text.contains("\"workspaces\"") && isWorkspaceManifest(text))
            walked = addIfDir(walked, d);
        walked = addIfDir(walked, d + "/repository/botopink-lang/libs");
        walked = addIfDir(walked, d + "/repository");
        walked = addIfDir(walked, d + "/libs");
        if (isDir(d + "/repository")) break;
        val parent = dirname(d);
        if (parent == d) break;
        d = parent;
    }
    return roots.append(walked);
}

fn isWorkspaceManifest(text: string) -> bool {
    return workspaceFieldIsArray(text);
}

#[compiler.external(.JavaScript("""(() => { try { const __v = JSON.parse($0); return __v !== null && typeof __v === 'object' && !Array.isArray(__v) && Array.isArray(__v.workspaces); } catch (__e) { return false; } })()"""))]
declare fn workspaceFieldIsArray(text: string) -> bool;

fn addIfDir(roots: string[], path: string) -> string[] {
    if (!isDir(path) || roots.contains(path)) return roots;
    return roots.append([path]);
}

/// A fresh copy of `cell` (absolute) under `home`.
pub fn open(home: string, cell: string) -> Scratch {
    val root = home + "/.botopinkbuild/tmp/check-" + randomHex();
    val ws = workspaceOf(cell);
    var dir = root;
    if (ws) {
        w ->
        dir = root + "/" + memberPath(w.dir, cell);
    }
    makeDirs(dir);
    if (ws) {
        w ->
        writeText(root
            + "/botopink.json", soleMember(absolutizePathDeps(w.text, w.dir, false), memberPath(w.dir, cell)));
    }
    copyTree(cell, dir, true, realPath(cell) ?? cell);
    val manifestPath = dir + "/botopink.json";
    val original = readText(manifestPath) ?? "";
    val text = absolutizePathDeps(original, cell, true);
    if (text != original) writeText(manifestPath, text);
    val roots = libRoots(home, cell, ws);
    return Scratch(root: root, dir: dir, manifest: text, env: ["BOTOPINK_LIB_ROOTS="
        + roots.join(":")]);
}

pub fn close(s: Scratch) -> void {
    removeTree(s.root);
}

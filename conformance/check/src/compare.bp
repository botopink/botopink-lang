//// The accepted snapshots of a cell and their comparison with what each target answered — the port of
//// `cell.zig`'s `readAccepted` and `compare`, line for line (decisions 67, 457, 475): a departure
//// under `snapshot/targets/<t>/` replaces `output/` for its module on its target, a mismatch writes
//// a `<file>.snap.new` candidate beside the accepted file and prints its line diff, and an accepted
//// `.snap` is never written.

import {records.Snap, records.parse, records.render, records.matches, records.candidate, records.diff, records.HEADER, records.NEW_SUFFIX};
import {answer.Answer, answer.find};
import {host.childNames, host.isDir, host.readText, host.writeText, host.deleteFile, host.sortStrings, host.trimEndOf};

/// One accepted `.snap`: its module key, where it is and what it says.
pub type SnapFile(key: string, path: string, text: string, snap: Snap)

/// A departure directory's files.
pub type TargetFiles(target: string, files: SnapFile[])

pub type Accepted(output: SnapFile[] = [], targets: TargetFiles[] = [], count: i32 = 0)

/// `path` relative to `home` when it lies under it.
pub fn rel(home: string, path: string) -> string {
    if (path.startsWith(home + "/") && path.length > home.length + 1)
        return path.slice(home.length + 1);
    return path;
}

fn fileOf(files: SnapFile[], key: string) -> ?SnapFile {
    for (files) { f ->
        if (f.key == key) return f;
    }
    return null;
}

fn putFile(files: SnapFile[], f: SnapFile) -> SnapFile[] {
    var out: SnapFile[] = [];
    var placed = false;
    for (files) { g ->
        if (g.key == f.key) {
            out.push(f);
            placed = true;
        } else out.push(g);
    }
    if (!placed) out.push(f);
    return out;
}

fn targetFiles(acc: Accepted, t: string) -> SnapFile[] {
    for (acc.targets) { tf ->
        if (tf.target == t) return tf.files;
    }
    return [];
}

/// Delete every `*.snap.new` under `dir`: the candidates are this run's output.
pub fn removeCandidates(dir: string) -> void {
    for (childNames(dir, "all")) { name ->
        val p = dir + "/" + name;
        if (isDir(p))
            removeCandidates(p)
        else if (name.endsWith(".snap" + NEW_SUFFIX))
            deleteFile(p);
    }
}

fn readSnaps(home: string, dir: string, prefix: string, into: SnapFile[]) -> Result<SnapFile[], string> {
    var files = into;
    for (childNames(dir, "all")) { name ->
        val p = dir + "/" + name;
        val key = if (prefix == "") name else prefix + "/" + name;
        if (isDir(p)) files = try readSnaps(home, p, key, files) else {
            if (!name.endsWith(".snap")) throw rel(home, p) + ": not a .snap";
            val text = readText(p) ?? "";
            val parsed = parse(text);
            case parsed {
                Ok(s) -> files = putFile(files, SnapFile(key: key.slice(0, key.length
                    - ".snap".length), path: p, text: text, snap: s));
                Error(bad) -> throw rel(home, p)
                    + ":"
                    + bad.line.toString()
                    + ": "
                    + bad.reason;
            }
        }
    }
    return files;
}

val TARGETS: string[] = ["commonJS", "erlang", "beam", "wasm"];

/// Read `snapshot/`: `output/**.snap` and `targets/<t>/**.snap`, each parsed. Anything else there,
/// a departure for a target the cell does not run, or a malformed `.snap` refuses the cell.
pub fn readAccepted(home: string, cell: string, declared: string[]) -> Result<Accepted, string> {
    var output: SnapFile[] = [];
    var targets: TargetFiles[] = [];
    val dir = cell + "/snapshot";
    for (childNames(dir, "all")) { name ->
        val p = dir + "/" + name;
        if (name == "output" && isDir(p))
            output = try readSnaps(home, p, "", output)
        else if (name == "targets" && isDir(p))
            for (childNames(p, "all")) { tname ->
                val tp = p + "/" + tname;
                if (!TARGETS.contains(tname))
                    throw rel(home, tp)
                        + ": not a target (commonJS, erlang, beam, wasm)";
                if (!declared.contains(tname) || !isDir(tp))
                    throw rel(home, tp)
                        + ": a departure for a target the cell does not run";
                targets = targets.append([TargetFiles(target: tname, files: try readSnaps(home, tp, "", []))]);
            }
        else
            throw rel(home, p)
                + ": snapshot/ holds output/ and targets/<target>/ only";
    }
    var count = output.length;
    for (targets) { tf ->
        count = count + tf.files.length;
    }
    return Accepted(output: output, targets: targets, count: count);
}

// ── compare and write candidates ──────────────────────────────────────────────

fn emptySnap() -> Snap {
    return Snap();
}

fn snapOf(f: ?SnapFile) -> Snap {
    if (f) {
        x ->
        return x.snap;
    }
    return Snap();
}

fn acceptedOf(f: ?SnapFile) -> ?Snap {
    if (f) {
        x ->
        return x.snap;
    }
    return null;
}

fn textOf(f: ?SnapFile) -> string {
    if (f) {
        x ->
        return x.text;
    }
    return "";
}

/// One group of targets (by index into `declared`) that answer one candidate text.
type Group(text: string, members: i32[])

fn addToGroup(groups: Group[], text: string, i: i32) -> Group[] {
    var out: Group[] = [];
    var placed = false;
    for (groups) { g ->
        if (g.text == text) {
            out.push(Group(text: text, members: g.members.append([i])));
            placed = true;
        } else out.push(g);
    }
    if (!placed) out.push(Group(text: text, members: [i]));
    return out;
}

fn targetList(declared: string[], idx: i32[]) -> string {
    return idx.map({ i -> declared.at(i) ?? "" }).join(" ");
}

fn reportCandidate(home: string, on: string, module: string, path: string, before: string, after: string, why: string) -> string {
    var out = "  "
        + module
        + " on "
        + on
        + ": "
        + why
        + "\n    candidate "
        + rel(home, path)
        + "\n";
    for (trimEndOf(diff(before, after), "\n").split("\n")) { l ->
        out = out + "      " + l + "\n";
    }
    return out;
}

fn writeOutputCandidate(home: string, cell: string, module: string, on: string, text: string, before: string, why: string) -> string {
    val path = cell + "/snapshot/output/" + module + ".snap" + NEW_SUFFIX;
    writeText(path, text);
    return reportCandidate(home, on, module, path, before, text, why);
}

fn writeCandidate(home: string, cell: string, t: string, module: string, text: string, before: string, why: string) -> string {
    val path = cell
        + "/snapshot/targets/"
        + t
        + "/"
        + module
        + ".snap"
        + NEW_SUFFIX;
    writeText(path, text);
    return reportCandidate(home, t, module, path, before, text, why);
}

/// Compare every module's answer on every declared target with the accepted `.snap` it reads
/// (`targets/<t>/` where the target departs, else `output/`, else empty), and write a candidate
/// where they differ — or, for a new cell (no `.snap` at all), for every module that answers and for
/// `main`. Null when every target answers its snapshots; else the cell's FAIL section.
pub fn compare(home: string, cell: string, declared: string[], acc: Accepted, observed: Answer[]) -> ?string {
    val newCell = acc.count == 0;
    var report = "";

    // Every module any target answered or any snapshot names.
    var names: string[] = [];
    if (newCell) names = ["main"];
    var ti = 0;
    while (ti < declared.length) {
        val t = declared.at(ti) ?? "";
        for ((observed.at(ti) ?? Answer()).modules) { m ->
            if (!names.contains(m.name)) names = names.append([m.name]);
        }
        for (targetFiles(acc, t)) { f ->
            if (!names.contains(f.key)) names = names.append([f.key]);
        }
        ti = ti + 1;
    }
    for (acc.output) { f ->
        if (!names.contains(f.key)) names = names.append([f.key]);
    }
    val sorted = sortStrings(names);

    val n = declared.length;
    for (sorted) { m ->
        var ok: bool[] = [];
        var cand: string[] = [];
        var eff: array<?SnapFile> = [];
        var own: bool[] = [];
        var allOk = true;
        var i = 0;
        while (i < n) {
            val t = declared.at(i) ?? "";
            val ans = observed.at(i) ?? Answer();
            val targetFile = fileOf(targetFiles(acc, t), m);
            own.push(targetFile != null);
            val e = targetFile ?? fileOf(acc.output, m);
            eff.push(e);
            val got = find(ans.modules, m) ?? emptySnap();
            val want = snapOf(e);
            val held = matches(want, got, ans.stderr);
            ok.push(held);
            val accepted = acceptedOf(e);
            cand.push(render(candidate(accepted, got, ans.stderr)));
            if (!held) allOk = false;
            i = i + 1;
        }
        if (allOk && !newCell) continue;

        // A target with a departure of its own that no longer holds: its candidate goes beside
        // that departure.
        i = 0;
        while (i < n) {
            if ((own.at(i) ?? false) && !(ok.at(i) ?? false)) {
                val before = textOf(eff.at(i) ?? null);
                report = report
                    + writeCandidate(home, cell, declared.at(i) ?? "", m, cand.at(i) ?? "", before, "does not answer its accepted departure");
            }
            i = i + 1;
        }

        // The targets that read `output/`.
        var onOutput: i32[] = [];
        var anyFailed = false;
        var anyHeld = false;
        i = 0;
        while (i < n) {
            if (!(own.at(i) ?? false)) {
                onOutput.push(i);
                if (ok.at(i) ?? false) anyHeld = true else anyFailed = true;
            }
            i = i + 1;
        }
        if (!newCell && !anyFailed) continue;
        val outFile = fileOf(acc.output, m);
        val outputText = textOf(outFile);

        if (!newCell && outFile != null && anyHeld) {
            // `output/` holds on some targets: the others depart from it.
            for (onOutput) { k ->
                if (!(ok.at(k) ?? false))
                    report = report
                        + writeCandidate(home, cell, declared.at(k) ?? "", m, cand.at(k) ?? "", outputText, "departs from the accepted output — a departure to review");
            }
            continue;
        }

        // No target holds `output/` (or there is none yet): the answer is the one the targets agree
        // on, or the majority's; else a person chooses.
        var groups: Group[] = [];
        for (onOutput) { k ->
            groups = addToGroup(groups, cand.at(k) ?? "", k);
        }
        if (groups.length == 0) continue;
        var best = 0;
        var gi = 0;
        while (gi < groups.length) {
            if ((groups.at(gi) ?? Group(text: "", members: [])).members.length
                > (groups.at(best) ?? Group(text: "", members: [])).members.length)
                best = gi;
            gi = gi + 1;
        }
        val bestGroup = groups.at(best) ?? Group(text: "", members: []);
        val majority = bestGroup.members;
        val majorityText = bestGroup.text;
        if (groups.length == 1 || majority.length * 2 > onOutput.length) {
            val empty = majorityText == HEADER + "\n";
            if (!empty || outFile != null || m == "main") {
                val agreed = if (outFile == null)
                    "the answer every target gives"
                else
                    "every target answers otherwise";
                val why = if (groups.length == 1)
                    agreed
                else
                    "the majority's answer";
                val on = targetList(declared, if (groups.length == 1)
                    onOutput
                else
                    majority);
                report = report
                    + writeOutputCandidate(home, cell, m, on, majorityText, outputText, why);
            }
            gi = 0;
            while (gi < groups.length) {
                if (gi != best)
                    for ((groups.at(gi) ?? Group(text: "", members: [])).members) { k ->
                        report = report
                            + writeCandidate(home, cell, declared.at(k) ?? "", m, cand.at(k) ?? "", majorityText, "departs from the majority — a departure to review");
                    }
                gi = gi + 1;
            }
        } else for (onOutput) { k ->
            report = report
                + writeCandidate(home, cell, declared.at(k) ?? "", m, cand.at(k) ?? "", outputText, "no majority — a person chooses which answer is the language's (snapshot/output/) and which targets depart");
        }
    }

    if (report == "") return null;
    val tail = if (newCell)
        " — a new cell: no accepted snapshot yet, candidates written"
    else
        "";
    return "FAIL " + rel(home, cell) + tail + "\n" + report;
}

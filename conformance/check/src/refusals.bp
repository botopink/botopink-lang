//// The refusals in what a `botopink` command printed, read back as records — the port of
//// `modules/compiler-cli/src/cli/refusals.zig`. `botopink build --json` answers a build's refusals
//// as events; this reads the few a `run` prints before its program starts (the entry module that
//// declares no `fn main`), and an audit's first error line.

import {records.Snap, records.Refusal};
import {answer.ModuleSnap, answer.find, answer.put};
import {host.trimEndOf, host.trimStartOf};

/// A line that opens a refusal.
pub fn isErrorLine(line: string) -> bool {
    return line.startsWith("error:") || line.startsWith("error[");
}

/// `error: N module(s) failed to compile: …` — the build's summary, which names modules, not a
/// refusal.
pub fn isSummary(line: string) -> bool {
    return line.contains(" module(s) failed to compile: ");
}

/// The first refusal line of `text`, or null.
pub fn firstErrorLine(text: string) -> ?string {
    for (text.split("\n")) { raw ->
        val line = trimEndOf(raw, " \r");
        if (isErrorLine(line) && !isSummary(line)) return line;
    }
    return null;
}

fn withAt(r: Refusal, at: string) -> Refusal {
    return Refusal(message: r.message, at: at, label: r.label, frames: r.frames);
}

fn withLabel(r: Refusal, label: string) -> Refusal {
    return Refusal(message: r.message, at: r.at, label: label, frames: r.frames);
}

fn withFrame(r: Refusal, frame: string) -> Refusal {
    return Refusal(message: r.message, at: r.at, label: r.label, frames: r.frames.append([frame]));
}

fn replaceLast(rs: Refusal[], r: Refusal) -> Refusal[] {
    return rs.slice(0, rs.length - 1).append([r]);
}

/// The refusals in `text` by module: each `error…` line (the summary aside), the first
/// `--> <file>:<line>:<col>` under it, the caret's label and the `= called from` lines, filed under
/// the module that file is; an unlocated refusal is `main`'s.
pub fn refusalsOf(text: string) -> ModuleSnap[] {
    var flat: Refusal[] = [];
    var open = false;
    var caretRead = false;
    for (text.split("\n")) { raw ->
        val line = trimEndOf(raw, " \r");
        val t = trimStartOf(line, " ");
        val last = flat.at(flat.length - 1) ?? Refusal(message: "");
        if (isErrorLine(line)) {
            open = !isSummary(line);
            caretRead = false;
            if (open) flat.push(Refusal(message: line));
        } else if (line.startsWith("warning"))
            open = false
        else if (open && t.startsWith("= called from "))
            flat = replaceLast(flat, withFrame(last, t.slice("= called from ".length)))
        else if (open && last.at == null) {
            if (t.startsWith("--> "))
                flat = replaceLast(flat, withAt(last, t.slice("--> ".length)));
        } else if (open && !caretRead) {
            val l = caretLabel(line);
            if (l) {
                label ->
                caretRead = true;
                if (label.length > 0)
                    flat = replaceLast(flat, withLabel(last, label));
            }
        }
    }
    var out: ModuleSnap[] = [];
    for (flat) { r ->
        val module = moduleOfOptional(r.at);
        val before = find(out, module) ?? Snap();
        out = put(out, module, Snap(refusals: before.refusals.append([r])));
    }
    return out;
}

fn onlyOf(text: string, chars: string) -> bool {
    return trimStartOf(text, chars) == "";
}

/// The text beside the caret of a source-snippet line (`  |   ^^^ the label`): "" when the carets
/// stand alone, null when the line is no caret line.
fn caretLabel(line: string) -> ?string {
    val bar = line.indexOf("|");
    if (bar < 0) return null;
    if (!onlyOf(line.slice(0, bar), " 0123456789")) return null;
    val after = trimStartOf(line.slice(bar + 1), " ");
    if (!after.startsWith("^")) return null;
    val rest = trimStartOf(after, "^");
    return trimEndOf(trimStartOf(rest, " "), " ");
}

fn isDigits(text: string) -> bool {
    return text.length > 0 && onlyOf(text, "0123456789");
}

fn moduleOfOptional(at: ?string) -> string {
    if (at) {
        a ->
        return moduleOf(a);
    }
    return "main";
}

/// `src/shapes/circle.bp:3:7` → `shapes/circle`.
pub fn moduleOf(at: string) -> string {
    var path = at;
    var k = 0;
    while (k < 2) {
        val c = path.lastIndexOf(":");
        if (c >= 0 && isDigits(path.slice(c + 1))) path = path.slice(0, c);
        k = k + 1;
    }
    if (path.startsWith("src/")) path = path.slice("src/".length);
    if (path.endsWith(".bp")) path = path.slice(0, path.length - ".bp".length);
    return path;
}

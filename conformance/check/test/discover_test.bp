//// The tests of `cell.zig`'s `discover`, ported onto `discover.bp`, over a tree made in the test
//// run's own scratch directory (`BOTOPINK_TEST_TMPDIR`); and the program's own package is never a
//// cell.

import {discover.discover, discover.isTheProgram};
import {host.makeDirs, host.writeText, host.removeTree, host.envVar};

fn scratchRoot(name: string) -> string {
    val root = (envVar("BOTOPINK_TEST_TMPDIR") ?? ".botopinkbuild/tmp")
        + "/"
        + name;
    removeTree(root);
    return root;
}

test "discover finds the cells of a directory and never a nested package under deps/" {
    val root = scratchRoot("discover") + "/modules";
    makeDirs(root + "/one/src");
    makeDirs(root + "/one/deps/pkg/src");
    writeText(root + "/one/deps/pkg/botopink.json", "{ \"name\": \"pkg\" }");
    makeDirs(root + "/modules/one/deps/pkg/src");
    val found = discover(root);
    assert found.cells.length == 1;
    assert (found.cells.at(0) ?? "") == root + "/one";
    assert found.refused.length == 0;
}

test "discover finds the cases of a module, and refuses src/ beside cases/ and a case that is no cell (decision 765)" {
    val root = scratchRoot("discover-cases") + "/modules";
    makeDirs(root + "/m/cases/b/src");
    makeDirs(root + "/m/cases/a/src");
    makeDirs(root + "/plain/src");
    val found = discover(root);
    assert found.cells.length == 3;
    assert (found.cells.at(0) ?? "") == root + "/m/cases/a";
    assert (found.cells.at(1) ?? "") == root + "/m/cases/b";
    assert found.refused.length == 0;
    makeDirs(root + "/m/src");
    makeDirs(root + "/other/cases/stray");
    val again = discover(root);
    assert again.refused.length == 2;
    assert (again.refused.at(0) ?? "").contains("m holds both cases/ and src/");
    assert (again.refused.at(1) ?? "").contains("other/cases/stray is no cell");
}

test "the program's own package is no cell" {
    val root = scratchRoot("discover-program");
    makeDirs(root + "/conformance/check/src");
    makeDirs(root + "/conformance/modules/one/src");
    val found = discover(root + "/conformance");
    assert found.cells.length == 1;
    assert (found.cells.at(0) ?? "") == root + "/conformance/modules/one";
    assert isTheProgram(root + "/conformance/check");
}

//// The tests of `refusals.zig`, ported one for one onto `refusals.bp`.

import {refusals.refusalsOf, refusals.moduleOf, refusals.firstErrorLine};
import {answer.find};
import {records.Snap, records.Refusal};
import {host.stripAnsi};

fn refusalAt(snap: ?Snap, i: i32) -> Refusal {
    return (snap ?? Snap()).refusals.at(i) ?? Refusal(message: "none");
}

test "refusalsOf files each located refusal under its module and skips the summary" {
    val text = "  Compiling 2 module(s)...\nwarning: `out` is born with no element type\n --> src/main.bp:2:9\n\nerror[namespace-type-self]: a namespace type has no value\n --> src/main.bp:7:15\n  |\n7 |     fn double(self: Self) -> i32 { return 2; }\n  |               ^^^^\n\nerror: `f` has no implementation for the wasm backend\n  --> src/shapes/circle.bp:21:12\n\nerror: dependency 'x' was not found under any library root\nerror: 2 module(s) failed to compile: main, shapes/circle\n";
    val got = refusalsOf(text);
    assert got.length == 2;
    val main = find(got, "main");
    assert (main ?? Snap()).refusals.length == 2;
    assert refusalAt(main, 0).message
        == "error[namespace-type-self]: a namespace type has no value";
    assert refusalAt(main, 0).at == "src/main.bp:7:15";
    assert refusalAt(main, 1).message
        == "error: dependency 'x' was not found under any library root";
    assert refusalAt(main, 1).at == null;
    assert refusalAt(find(got, "shapes/circle"), 0).at
        == "src/shapes/circle.bp:21:12";
}

test "refusalsOf reads the label beside the caret, and none when the caret stands alone" {
    val text = "error[case-bare-name-arm]: a name alone is not a pattern\n --> src/main.bp:7:9\n  |\n7 |         n { \"other\" }\n  |         ^ use _ { n -> … } to bind the matched value\n  |\n  = hint: An arm names a type.\n\nerror[x]: bare caret\n --> src/main.bp:9:1\n  |\n9 | foo\n  | ^^^\n";
    val main = find(refusalsOf(text), "main");
    assert refusalAt(main, 0).label
        == "use _ { n -> … } to bind the matched value";
    assert refusalAt(main, 1).label == null;
}

test "refusalsOf reads the called-from lines of a raise at build under the refusal (decision 532)" {
    val text = "error: {error,{panic,<<\"boom\">>}}\n --> src/deco.bp:3:5\n  |\n3 |     panic(\"boom\");\n  |     ^\n  |\n  = hint: the decorator's body raised\n  = called from src/main.bp:9:3\n  = called from src/main.bp:12:1\n";
    val got = refusalsOf(text);
    assert find(got, "main") == null;
    val deco = refusalAt(find(got, "deco"), 0);
    assert deco.at == "src/deco.bp:3:5";
    assert deco.frames.length == 2;
    assert (deco.frames.at(0) ?? "") == "src/main.bp:9:3";
    assert (deco.frames.at(1) ?? "") == "src/main.bp:12:1";
}

test "moduleOf reads the module off a location" {
    assert moduleOf("src/main.bp:7:15") == "main";
    assert moduleOf("src/shapes/circle.bp:3:1") == "shapes/circle";
    assert moduleOf("lib/util.bp:1:1") == "lib/util";
}

test "stripAnsi drops colour sequences only" {
    val esc = string.fromCodepoint(27);
    assert stripAnsi(esc + "[1m" + esc + "[31merror" + esc + "[0m: x [1]")
        == "error: x [1]";
}

test "firstErrorLine skips the summary and answers the first refusal" {
    assert firstErrorLine("Compiling\nerror: 1 module(s) failed to compile: main\nerror[x]: y  \n")
        == "error[x]: y";
    assert firstErrorLine("no error here\n") == null;
}

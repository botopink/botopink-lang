//// The tests of `cell.zig`'s scratch helpers, ported one for one onto `scratch.bp`.

import {scratch.absolutizePathDeps, scratch.soleMember, scratch.memberPath};

test "absolutizePathDeps resolves a relative path against the cell, leaving the rest" {
    val text = "{ \"name\": \"c\", \"dependencies\": { \"k\": { \"path\": \"../../lib/k\" }, \"z\": { \"path\": \"/abs/z\" } } }";
    assert absolutizePathDeps(text, "/w/cells/modules/c", true)
        == "{ \"name\": \"c\", \"dependencies\": { \"k\": { \"path\": \"/w/cells/lib/k\" }, \"z\": { \"path\": \"/abs/z\" } } }";
}

test "absolutizePathDeps keeps a path inside the cell as written, so columns and locations hold" {
    val text = "{ \"dependencies\": { \"m\": { \"path\": \"deps/m\" } }, \"bpp\": \"m\" }";
    assert absolutizePathDeps(text, "/w/cells/modules/c", true) == text;
    assert absolutizePathDeps(text, "/w/cells/modules/c", false)
        == "{ \"dependencies\": { \"m\": { \"path\": \"/w/cells/modules/c/deps/m\" } }, \"bpp\": \"m\" }";
}

test "soleMember lists the cell alone, the rest of the manifest as written" {
    val text = "{ \"name\": \"w\", \"workspaces\": [\"a/x/*\", \"b/y/*\"], \"targets\": [\"erlang\"] }";
    assert soleMember(text, "b/y/c")
        == "{ \"name\": \"w\", \"workspaces\": [\"b/y/c\"], \"targets\": [\"erlang\"] }";
}

test "memberPath keeps the cell's path under the workspace root" {
    assert memberPath("/w/modules", "/w/modules/c") == "c";
    assert memberPath("/w/modules/", "/w/modules/group/c") == "group/c";
    assert memberPath("/w/other", "/w/modules/c") == "c";
}
